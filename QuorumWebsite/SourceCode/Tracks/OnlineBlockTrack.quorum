use Libraries.Web.Page.QuorumPage
use Libraries.Containers.Array

/*
    The Quorum Blocks Online track: a banner, then the course's lessons in
    order, each with its name (linked to it) and a line on what it
    teaches.
*/
class OnlineBlockTrack is QuorumPage
    // Each lesson's name, address and description, in the course's order.
    Array<text> names
    Array<text> addresses
    Array<text> descriptions

    on create
        SetLocation("lessons/quorumBlocksOnline.html")
    end

    // Adds the next lesson to the list.
    action AddLesson(text name, text address, text lessonDescription)
        names:Add(name)
        addresses:Add(address)
        descriptions:Add(lessonDescription)
    end

    action Setup
        SetWebPageTitle("Practice Online with Blocks - Quorum Programming Language")
        SetDescription("A 26-hour professional development workshop on the Quorum programming language for Block-based programming.")

        Banner("Quorum Blocks Online Programming Track", "A professional development workshop involving Block-based programming in Computer Science using Quorum", "media/userInterface/quorumAssets/BlocksOnline.png", "An image showing block language blocks in various sizes")

        Section("About the Course")
        LessonList()
        integer i = 0
        repeat while i < names:GetSize()
            LessonEntry(names:Get(i), addresses:Get(i), descriptions:Get(i))
            i = i + 1
        end
    end
end
