use Libraries.Web.Page.QuorumPage
use Libraries.Web.Series.PageSeries
use Libraries.Containers.Array

/*
    The Quorum Platformer and Puzzle Track page: a banner, then "About the
    Course" and a card for each unit (design B, plan 13 phase 5): its name,
    linked to its first lesson, its description, and what its lessons teach.
*/
class GameTemplateTrack is QuorumPage
    // The track's units, in order, from the builder.
    Array<PageSeries> units = undefined

    on create
        SetLocation("lessons/gameTemplates.html")
    end

    action SetTrackSeries(Array<PageSeries> trackUnits)
        units = trackUnits
    end

    action Setup
        SetWebPageTitle("Learn through Platform and Puzzle Games - Quorum Programming Language")
        Banner("Quorum Platformer and Puzzle Track", "A track for school aged children to learn programming through games", "media/userInterface/quorumAssets/SkyHopper.png", "An image showing a platformer game called SkyHopper")
        Section("About the Course")
        integer i = 0
        repeat while i < units:GetSize()
            PageSeries unit = units:Get(i)
            UnitCard(unit:GetName(), unit)
            i = i + 1
        end
    end
end
