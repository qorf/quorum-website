use Libraries.Web.Page.QuorumPage
use Libraries.Web.Series.PageSeries
use Libraries.Containers.Array

/*
    The Block-based Programming - Quorum Programming Language page: a
    banner, then "About the Course" and a card for each unit (design B, plan
    13 phase 5): its name, linked to its first lesson, its description, and
    what its lessons teach.
*/
class BlockTrack is QuorumPage
    // The track's units, in order, from the builder.
    Array<PageSeries> units = undefined

    on create
        SetLocation("lessons/quorumBlocks.html")
    end

    action SetTrackSeries(Array<PageSeries> trackUnits)
        units = trackUnits
    end

    action Setup
        SetWebPageTitle("Block-based Programming - Quorum Programming Language")
        Banner("Quorum Blocks Programming Track", "A professional development workshop involving Block-based programming in Computer Science using Quorum", "media/userInterface/quorumAssets/Blocks.png", "An image showing block language blocks in various sizes")
        Section("About the Course")
        integer i = 0
        repeat while i < units:GetSize()
            PageSeries unit = units:Get(i)
            UnitCard(unit:GetName(), unit)
            i = i + 1
        end
    end
end
