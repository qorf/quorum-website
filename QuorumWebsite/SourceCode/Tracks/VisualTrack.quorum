use Libraries.Web.Page.QuorumPage
use Libraries.Web.Series.PageSeries
use Libraries.Containers.Array

/*
    The Visual Track page: its title, then a card for each unit (design B,
    plan 13 phase 5): its name, linked to its first lesson, its description,
    and what its lessons teach.
*/
class VisualTrack is QuorumPage
    // The track's units, in order, from the builder.
    Array<PageSeries> units = undefined

    on create
        SetLocation("lessons/visual.html")
    end

    action SetTrackSeries(Array<PageSeries> trackUnits)
        units = trackUnits
    end

    action Setup
        SetWebPageTitle("Visual Track - Quorum Programming Language")
        Title("Visual Track")
        integer i = 0
        repeat while i < units:GetSize()
            PageSeries unit = units:Get(i)
            UnitCard(unit:GetName(), unit)
            i = i + 1
        end
    end
end
