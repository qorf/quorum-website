use Libraries.Web.Page.QuorumPage
use Libraries.Web.Series.PageSeries
use Libraries.Containers.Array

/*
    The Technical Accessibility - Quorum Programming Language page: a
    banner, then "About the Course" and a card for each unit (design B, plan
    13 phase 5): its name, linked to its first lesson, its description, and
    what its lessons teach.
*/
class AccessibilityTrack is QuorumPage
    // The track's units, in order, from the builder.
    Array<PageSeries> units = undefined

    on create
        SetLocation("lessons/accessibility.html")
    end

    action SetTrackSeries(Array<PageSeries> trackUnits)
        units = trackUnits
    end

    action Setup
        SetWebPageTitle("Technical Accessibility - Quorum Programming Language")
        Banner("Technical Accessibility Track", "A professional development workshop for learning technical accessibility", "media/userInterface/quorumAssets/BlocksOnline.png", "An image showing ...")
        Section("About the Course")
        integer i = 0
        repeat while i < units:GetSize()
            PageSeries unit = units:Get(i)
            UnitCard(unit:GetName(), unit)
            i = i + 1
        end
    end
end
