use Libraries.Web.Page.QuorumPage

/*
    Tutorial: Commenting Code.
    Converted from the old Lesson page by plan 13's generator: the same
    words, now without Tailwind.
*/
class CommentsTutorial is QuorumPage

    on create
        SetLocation("tutorials/language/comments.html")
        // The name lists and links use, and the series and track it belongs
        // to: its section and picture.
        SetShortTitle("Comments")
        SetSectionName("Quorum Basics")
        SetCardImage("/media/basics/comments.png")
        // For search engines and link previews, and what lists of pages say.
        SetDescription("Learn about how write notes or comments when using Quorum programming language.")
        SetSummary("how to make notes and documentation to help us understand the code")
    end

    action Setup
        SetWebPageTitle("Notes and comments - Quorum Programming Language")
        Title("Tutorial: Commenting Code")
        Paragraph("How to write notes to remind ourselves of what code does.")
        Comments()
        EndOfLineComments()
        MultilineComments()
        UsesOfComments()
    end

    private action Comments
        Section("Comments")
        Paragraph("Since computer code can be esoteric, programmers sometimes write notes to help sort out what a piece of code does. We do this using comments in two ways: an 1) end-of-line comment and a 2) multiline comment.")
    end

    private action EndOfLineComments
        Section("End-of-line comments")
        Paragraph("An end-of-line comment tells the computer to ignore any text after the comment indicator. We can also put an end-of-line comment on its own line. For an end-of-line comment, we start with two forward slashes, like so:")
        CodeExample("// This is a comment.")
        Paragraph("Anything after the slashes will be ignored by the compiler.")
    end

    private action MultilineComments
        Section("Multiline Comments")
        Paragraph("A multiline comment can include many lines. To insert a multiline comment, we start with a forward slash and an asterisk and end with an asterisk and a forward slash. Here is an example:")
        CodeExample("/* This is
 a comment. */")
        Paragraph("Quorum will ignore any text between the beginning of the comment and the end of the comment, even if it spans multiple lines.")
    end

    private action UsesOfComments
        Section("Uses of Comments")
        Paragraph("In addition to explaining code, comments can serve other purposes. One such purpose is temporarily turning off code for testing. For instance, suppose we wrote the following code:")
        CodeExample("class Main
   action Main
       integer i = 15
       integer j = 25
       integer k = 35
       output i 
       output j 
       output k 
   end
end")
        Paragraph("Here is an example of commenting out a few lines of code:")
        CodeExample("class Main
   action Main
       integer i = 15
       //integer j = 25
       //integer k = 35
       output i
   end
end")
        Paragraph("or with a multiline comment:")
        CodeExample("class Main
   action Main
       integer i = 15
       /*integer j = 25
       integer k = 35*/
       output i
   end
end")
        Paragraph("This way, the compiler won't see the code but it will still be in our file. Below is a development environment where we can try out comments. Now, these comments will obviously not do anything, but the point is to try them out to practice how it works.")
        CodeEditorWithCode("Activity: Try comments", "//Try the above code blocks."):HideDisplay()
    end
end
