use Libraries.Web.Page.QuorumPage

/*
    Tutorial: Quorum Coding Conventions.
    Converted from the old Lesson page by plan 13's generator: the same
    words, now without Tailwind.
*/
class CodingGuidelinesTutorial is QuorumPage
    // A double quote, for code and words that hold one.
    text dq = ""

    on create
        SetLocation("tutorials/language/codingGuidelines.html")
        // The name lists and links use, and the series and track it belongs
        // to: its section and picture.
        SetShortTitle("Coding Guidelines")
        SetSectionName("Quorum Basics")
        SetCardImage("/media/CodingGuidelines.png")
        // For search engines and link previews, and what lists of pages say.
        SetDescription("Learn about common conventions for writing code in the Quorum programming language.")
        SetSummary("some basic conventions that we can follow while coding.")
    end

    action Setup
        dq = dq:GetDoubleQuote()
        SetWebPageTitle("Coding Coding Conventions - Quorum Programming Language")
        Title("Tutorial: Quorum Coding Conventions")
        Paragraph("While not required, this page provides standard conventions for writing Quorum code.")
        ConventionsForNamingClassesActionsAndParameters()
        NamingAndLayoutConventions()
        CommentsAndDocumentation()
    end

    private action ConventionsForNamingClassesActionsAndParameters
        Section("Conventions for naming classes, actions, and parameters")
        Paragraph("We recommend the following conventions for naming classes, actions, and parameters in Quorum:")
        Paragraph("Do's")
        BulletList()
        ListItem("Do use short and meaningful names")
        ListItem("Do use names that are common in English")
        ListItem("Do use names that best represent what it is your class, action, or parameter does or is")
        ListItem("Do use the most obvious name you can think of for your libraries (a thesaurus is helpful).")
        Paragraph("Do not's")
        BulletList()
        ListItem("Do not use acronyms (e.g., awk, sed, ascii, io)")
        ListItem("Do not use shortened names (e.g. use AbsoluteValue instead of Abs, or CharacterToInteger instead of atoi)")
        ListItem("Do not use single letters for parameter names (e.g., use index instead of i)")
        ListItem("Do not use computer science or technical jargon (e.g., virtual void abs() = 0;, BTree, or LinkedList)")
        ListItem("Do not make names excessively verbose (e.g., ThisActionIsReallyAwesomeButHardToType())")
        ListItem("Do not give your libraries arbitrary names (e.g., call your library MailServer instead of BobsGem)")
    end

    private action NamingAndLayoutConventions
        Section("Naming and Layout Conventions")
        Paragraph("In Quorum, there are a few conventions for class, action and variable naming that we recommend following in your code.")
        Subsection("Class Names")
        Paragraph("Class names in Quorum should be in the pascal case format, e.g., PascalCase, with the P and C capitalized.")
        Subsection("Action Names")
        Paragraph("Action names in Quorum should also be in the pascal case format, e.g., PascalCase, with the P and C capitalized. In addition, actions that do not have any parameters do not require parentheses. By convention, leave out any syntax that is not required.")
        Subsection("Variable Names")
        Paragraph("Variable names in Quorum should follow the camel case format, e.g., camelCase, with the first c lowercase and the second C capitalized.")
        Subsection("Indentation")
        Paragraph("The Quorum compiler does not pay attention to whitespace in code. However, we ask that you use consistent indentation. Consistent indentation:")
        CodeExample("class Main
    action Main
        output " + dq + "hello world." + dq + "
    end
end")
        Paragraph("Inconsistent indentation:")
        CodeExample("class Main
action Main
output " + dq + "hello world." + dq + "
    end
end")
        CodeEditorWithCode("Activity: Try indentation", "//Try the above code blocks"):HideDisplay()
    end

    private action CommentsAndDocumentation
        Section("Comments and Documentation")
        Paragraph("In Quorum, there are two types of comments: single line and multi-line comments. For single line comments, we recommend a space after the beginning two forward slashes, like so: Good single-line comment:")
        CodeExample("// Output a message to the user.
output " + dq + "hello world." + dq)
        Paragraph("Multi-line comments should be formatted such that the beginning forward star and ending star forward are on their own lines, like so:")
        CodeExample("/*
the main entry point to the program
*/
action Main
end")
        Paragraph("However, if on only one line, as a single line comment is sufficient:")
        CodeExample("/* May as well use a single line comment */
action Main
end")
        CodeEditorWithCode("Activity: Try comments and documentation", "//Try the above code blocks"):HideDisplay()
        Subsection("Documentation")
        Paragraph("Please fully document each action and class in Quorum standard library files. In each case, please be sure to include at least one example, in all case, of code to execute that action or use that class. Here is an example comment from the array class:")
        CodeExample("/*
The Array class is a data structure that stores items in contiguous memory. An
item is typically stored and accessed through an index or location. This location
always starts at 0, this means the first item in the array is at location 0, the
second is at location 1, etc. The default maximum size is set to 10, but can be
changed by using the SetSize(value) method or the array will automatically
make itself large when the space is needed (note: it is possible to turn the 
resizing off with the SetAutoResize(false) method).

Attribute: Example

use Libraries.Containers.Array
class Main
   action Main
      //make the array
      Array myArray
      //add a value
      myArray:Add(12)
      //get it back
      integer value = myArray:Get(0)
   end
end
*/")
    end
end
