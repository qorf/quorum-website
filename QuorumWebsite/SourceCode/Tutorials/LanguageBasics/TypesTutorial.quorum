use Libraries.Web.Page.QuorumPage

/*
    Tutorial: Types and Variables.
    Converted from the old Lesson page by plan 13's generator: the same
    words, now without Tailwind.
*/
class TypesTutorial is QuorumPage
    // A double quote, for code and words that hold one.
    text dq = ""

    on create
        SetLocation("tutorials/language/types.html")
        // The name lists and links use, and the series and track it belongs
        // to: its section and picture.
        SetShortTitle("Types and Variables")
        SetSectionName("Quorum Basics")
        SetCardImage("/media/basics/variables.png")
        // For search engines and link previews, and what lists of pages say.
        SetDescription("Learn more about types like integer and text using the Quorum programming language.")
        SetSummary("how to use primitive data types")
    end

    action Setup
        dq = dq:GetDoubleQuote()
        SetWebPageTitle("Types and Variables - Quorum Programming Language")
        Title("Tutorial: Types and Variables")
        Paragraph("How to store various kinds of items in memory.")
        PrimitiveTypesInQuorum()
        TypeConversion()
        VariableNames()
    end

    private action PrimitiveTypesInQuorum
        Section("Primitive Types in Quorum")
        Paragraph("When programming a computer, we often say that a variable has a type. For example, suppose that I have a variable with the name "):DoubleQuote():Text("a"):DoubleQuote():Text(". It could be the case that this variable is a number, like 4.2, or it could be some text that we have written for a book, like, "):DoubleQuote():Text("It was the best of times."):DoubleQuote():Text(" In Quorum, there are several types, and if those types are not enough, we can define our own. In this section, we go over the various types allowed in the Quorum programming language.")
        Subsection("integer")
        Paragraph("An integer is a number, either positive, negative, or zero, that does not have a decimal point. You can create an integer in Quorum by declaring it as follows:")
        CodeExample("integer a = 10
output a")
        Paragraph("This would create a variable, named "):DoubleQuote():Text("a"):DoubleQuote():Text(", that has the value of 10. Similarly, while we can use the word "):DoubleQuote():Text("integer"):DoubleQuote():Text(" before the variable named "):DoubleQuote():Text("a"):DoubleQuote():Text(", we can also optionally leave that off, like so:")
        CodeExample("a = 10
output a")
        CodeEditorWithCode("Activity: Try integers", "//Try the above code blocks."):HideDisplay()
        Subsection("number")
        Paragraph("A number is similar to an integer, except that it allows decimal points. For example:")
        CodeExample("number a = 10.4
output a")
        Paragraph("Like before, the type annotation in this case is optional. We can either tell Quorum it is a number directly or we can allow Quorum to figure this out on its own. Either way, once Quorum has detected what a variable is defined as, it is fixed to that type to help prevent accidental mistakes. Like before, we can leave the type annotation off as so:")
        CodeExample("a = 10.4
output a")
        CodeEditorWithCode("Activity: Try numbers", "//Try the above code blocks."):HideDisplay()
        Subsection("boolean")
        Paragraph("The type of boolean has only two possible values, true and false. We can create a boolean as follows:")
        CodeExample("boolean a = true
output a")
        Paragraph("To use a boolean, we can either create it directly, like above, using the keywords "):DoubleQuote():Text("true"):DoubleQuote():Text(" or "):DoubleQuote():Text("false"):DoubleQuote():Text(". Alternatively, booleans come up regularly in computers when we compare different values. For example, suppose we had two integers, a and b, and we wanted to see whether a was "):DoubleQuote():Text("bigger"):DoubleQuote():Text(" than b. We could do this using the following code:")
        CodeExample("integer a = 5
integer b = 6
boolean answer = a > b
c = answer //Quorum can figure out the type, if you prefer
output c")
        CodeEditorWithCode("Activity: Try booleans", "//Try the above code blocks."):HideDisplay()
        Subsection("text")
        Paragraph("The text type is designed to let you use normal written text in your computer program. You can type any phrase, from a phrase to a page in a book. You can create a variable of type text as follows:")
        CodeExample("text a = " + dq + "Hello, World!" + dq + "
output a")
        CodeEditorWithCode("Activity: Try text", "//Try the above code blocks."):HideDisplay()
    end

    private action TypeConversion
        Section("Type conversion")
        Paragraph("Sometimes you need to convert one type to another. This is called converting types, or more commonly, type casting. Suppose, for example, that you had text like so:")
        CodeExample("text someText = " + dq + "4.2" + dq + "
output someText")
        Paragraph("This text has the value of 4.2, which looks like a number would, but how would you convert it? In Quorum, you do this using the cast action:")
        CodeExample("text someText = " + dq + "4.2" + dq + "
number someNumber = cast(number, someText)
output someNumber")
        Paragraph("The word cast here indicates to the computer that you are requesting that the value of "):DoubleQuote():Text("someText"):DoubleQuote():Text(" be converted into an actual number. Keep in mind that we can pass invalid values here, like "):DoubleQuote():Text("stuff"):DoubleQuote():Text(" that is not a valid number. In these cases, our program alert us to the fact that there is an error on the system. We can learn more about errors on theIn these cases, our program alert us to the fact that there is an error on the system. We can learn more about errors on the "):Link("errors", "/tutorials/language/errors.html"):Text(" page.You can learn more about casting on the "):Link("type casting page", "/tutorials/language/casting.html"):Text(".")
        CodeEditorWithCode("Activity: Try Type Conversion", "//Try the above code blocks."):HideDisplay()
    end

    private action VariableNames
        Section("Variable names")
        Paragraph("While you can create variables of many types, the names have a few rules. First, variables can start with a letter or underscore, but generally letters are good practice. Past the first letter, you can use letters, numbers, or underscores, with the exception of the final character. The final one cannot be an underscore, which is because the programming language uses that character behind the scenes in special ways. For example, any of the following names would be allowed:")
        CodeExample("integer sally = 5
integer billy_likes_sally = 10
integer billy_likes_sally2 = 15
output sally
output billy_likes_sally
output billy_likes_sally2")
        Paragraph("However, none of the following names are allowed:")
        CodeExample("integer 5sally = 5 //a number cannot be the first character
integer sally_ = 10 //an underscore cannot be the final character
integer sall&&%%^$*#(y //not all characters are allowed to be used in names")
        CodeEditorWithCode("Activity: Try Variable Naming", "//Try the above code blocks."):HideDisplay()
    end
end
