use Libraries.Web.Page.QuorumPage

/*
    Tutorial: Features and Hotkeys in Quorum Studio.
    Converted from the old Lesson page by plan 13's generator: the same
    words, now without Tailwind.
*/
class Hotkeys is QuorumPage

    on create
        SetLocation("tutorials/language/hotkeys.html")
        // The name lists and links use, and the series and track it belongs
        // to: its section and picture.
        SetShortTitle("Quorum Studio Features and Hotkeys")
        SetSectionName("Quorum Basics")
        // For search engines and link previews, and what lists of pages say.
        SetDescription("Learn about how to use hotkeys inside of Quorum Studio.")
        SetSummary("how to use hotkeys inside of Quorum Studio")
    end

    action Setup
        SetWebPageTitle("Hotkeys in Quorum Studio - Quorum Programming Language")
        Title("Tutorial: Features and Hotkeys in Quorum Studio")
        Paragraph("What can this thing do?")
        FeaturesAndHotkeysInQuorumStudio()
    end

    private action FeaturesAndHotkeysInQuorumStudio
        Section("Features and Hotkeys in Quorum Studio")
        Paragraph("Development Environments often have many helpful features available that help us interact with code online, edit our documents, or run the source code or scenes we are creating. In this tutorial, we will go over the major features available and the hotkeys we can use to access them from the keyboard. Not every user needs all of these features, but knowing they exist is helpful in learning what is possible inside of a computer programming environment. This document covers only the default settings.")
        Subsection("File Menu (ALT + F)")
        Paragraph("The file menu helps us in creating, opening, and closing a Quorum project in Quorum Studio.")
        Table("File Menu Options")
        TableHeader():Cell("Name"):Cell("Key"):Cell("Description")
        TableRow():Cell("New Project"):Cell("CTRL + N (PC), CMD + N (Mac)"):Cell("Create a new project")
        TableRow():Cell("Open Project"):Cell("CTRL + O (PC), CMD + O (Mac)"):Cell("Open an existing project")
        TableRow():Cell("Close Project"):Cell("CTRL + W (PC), CMD + W (Mac)"):Cell("Closes the project highlighted in the project tree")
        TableRow():Cell("New File"):Cell("CTRL + SHIFT + N (PC), CMD + SHIFT + N (Mac)"):Cell("Creates a new file in the selected folder.")
        TableRow():Cell("Save"):Cell("CTRL + S (PC), CMD + S (Mac)"):Cell("Saves a file or scene")
        TableRow():Cell("Save All"):Cell("CTRL + SHIFT + S (PC), CMD + SHIFT + S (Mac)"):Cell("Saves all open files")
        TableRow():Cell("Exit"):Cell("CTRL + Q (PC), CMD + Q (Mac)"):Cell("Quits Quorum Studio")
        Subsection("Edit Menu (ALT + E)")
        Paragraph("The edit menu helps us in using the text editor, including undoing and redoing edits in our program. It also includes a way to access properties for our projects, which can change how Quorum creates our software. For example, we can open the properties window, ask Quorum to automatically fix certain kinds of errors in our code, or turn on code completion, which is a pop-up menu that shows us information about the code we are writing. Common hotkeys we may want to memorize are for hint usage, ALT + ENTER, undo/redo keys like CTRL or CMD + C/Z, and those for code completion, CTRL + SPACE. Each of these is useful for learning to code and working in practice.")
        Table("Edit Menu Options")
        TableHeader():Cell("Name"):Cell("Key"):Cell("Description")
        TableRow():Cell("Undo"):Cell("CTRL + Z (PC), CMD + Z (Mac)"):Cell("Undo the previous event")
        TableRow():Cell("Redo"):Cell("CTRL + Y (PC), CMD + Y (Mac)"):Cell("Redo the previous event")
        TableRow():Cell("Cut"):Cell("CTRL + X (PC), CMD + X (Mac)"):Cell("Cut the item")
        TableRow():Cell("Copy"):Cell("CTRL + C (PC), CMD + C (Mac)"):Cell("Copy the item")
        TableRow():Cell("Paste"):Cell("CTRL + V (PC), CMD + V (Mac)"):Cell("Paste the item")
        TableRow():Cell("Delete"):Cell("DELETE"):Cell("Delete the selection")
        TableRow():Cell("Select All"):Cell("CTRL + A (PC), CMD + A (Mac)"):Cell("Select all items for this component")
        TableRow():Cell("Find"):Cell("CTRL + F (PC), CMD + F (Mac)"):Cell("Open the Find Dialog")
        TableRow():Cell("Replace"):Cell("CTRL + H (PC), CMD + H (Mac)"):Cell("Open the Replace Dialog")
        TableRow():Cell("Comment"):Cell("CTRL + / (PC), CMD + / (Mac)"):Cell("Comment or uncomment a selection of lines")
        TableRow():Cell("Do Hint"):Cell("ALT + ENTER"):Cell("Automatically pick the top hint for this source line")
        TableRow():Cell("Code Completion"):Cell("CTRL + SPACE"):Cell("Open the Code Completion menu in the editor")
        TableRow():Cell("Edit Properties"):Cell("CTRL + P (PC), CMD + P (Mac)"):Cell("Pull up the properties window for a project")
        Subsection("View Menu (ALT + V)")
        Paragraph("The view menu has largely two features. The first is zoom, which scales up the environment while trying to keep it readable. Second, there are two accessibility keys, one to ask the system to summarize the current state of the component we are in and another, where am I, that tries to give location information about a component. Not all components have these keys hooked up, but they can provide context and information specifically to screen reader users.")
        Table("View Menu Options")
        TableHeader():Cell("Name"):Cell("Key"):Cell("Description")
        TableRow():Cell("Zoom In"):Cell("CTRL + = (PC), CMD + = (Mac)"):Cell("Make everything larger")
        TableRow():Cell("Zoom Out"):Cell("CTRL + - (PC), CMD + - (Mac)"):Cell("Make everything smaller")
        Subsection("Navigate Menu (ALT + N)")
        Paragraph("This menu provides access to navigating around in specifically the text editor. Notably, there are several keys that help us logically navigate source code. These include keys to jump to the next action, keys to jump to or back to the next or previous scope, keys to move to the end or beginning of the file, and keys to move to the next status message in the gutter. This menu also gives us access to a Go To dialog, which lets us jump to a line of code, and a jump to feature that we can use on specific lines of code to logically jump to a library in Quorum Source.")
        Table("Navigate Menu Options")
        TableHeader():Cell("Name"):Cell("Key"):Cell("Description")
        TableRow():Cell("Go to Line"):Cell("CTRL + G (PC), CMD + G (Mac)"):Cell("Go to a line in the source editor")
        TableRow():Cell("Previous Action"):Cell("CTRL + PAGE_UP (PC), CTRL + PAGE_UP (Mac)"):Cell("Goes to the previous action in the source")
        TableRow():Cell("Next Action"):Cell("CTRL + PAGE_DOWN (PC), CTRL + PAGE_DOWN (Mac)"):Cell("Goes to the next action in the source")
        TableRow():Cell("Previous Scope"):Cell("CTRL + [ (PC), CTRL + CMD + LEFT (Mac)"):Cell("Goes to the previous scope")
        TableRow():Cell("Next Scope"):Cell("CTRL + ] (PC), CTRL + CMD + RIGHT (Mac)"):Cell("Goes to the next scope")
        TableRow():Cell("Jump to Selected"):Cell("CTRL + J (PC), CMD + J (Mac)"):Cell("Navigate to Declaration")
        TableRow():Cell("Start of File"):Cell("CTRL + HOME (PC), CMD + UP (Mac)"):Cell("Goes to the start of a file")
        TableRow():Cell("End of File"):Cell("CTRL + END (PC), CMD + DOWN (Mac)"):Cell("Goes to the end of a file")
        TableRow():Cell("Previous Status"):Cell("SHIFT + CONTROL + UP (PC), SHIFT + CTRL + CMD + UP (Mac)"):Cell("Goes to the previous edit status location")
        TableRow():Cell("Next Status"):Cell("SHIFT + CONTROL + DOWN (PC), SHIFT + CTRL + CMD + DOWN (Mac)"):Cell("Goes to the next edit status location")
        Subsection("Run Menu (ALT + R)")
        Paragraph("The run menu contains hotkeys for running, debugging, and building Quorum code. Generally, building and running code is so common that these keys may be worth memorizing. Besides running and debugging, there are keys included here to send code to an android device and to change where a program starts running from.")
        Table("Run Menu Options")
        TableHeader():Cell("Name"):Cell("Key"):Cell("Description")
        TableRow():Cell("Build"):Cell("CONTROL + B (PC), CMD + B (Mac)"):Cell("Builds the current project")
        TableRow():Cell("Clean and Build"):Cell("CONTROL + SHIFT + B (PC), CMD + SHIFT + B (Mac)"):Cell("Cleans then Builds the current project")
        TableRow():Cell("Clean"):Cell("F5"):Cell("Removes all build files from the current project")
        TableRow():Cell("Run"):Cell("CONTROL + R (PC), CMD + R (Mac)"):Cell("Runs the current project")
        TableRow():Cell("Debug"):Cell("CONTROL + D (PC), CMD + D (Mac)"):Cell("Debugs the current project")
        TableRow():Cell("Stop Debugging"):Cell("CONTROL + E (PC), CMD + E (Mac)"):Cell("Stops the debugger if it is running")
        TableRow():Cell("Pause"):Cell("CONTROL + F7 (PC), CMD + F7 (Mac)"):Cell("Pauses the debugger")
        TableRow():Cell("Continue"):Cell("CONTROL + F8 (PC), CMD + F8 (Mac)"):Cell("Continues in the debugger")
        TableRow():Cell("Step Over"):Cell("CONTROL + F9 (PC), CMD + F9 (Mac)"):Cell("Steps over a line of code")
        TableRow():Cell("Step Into"):Cell("CONTROL + F10 (PC), CMD + F10 (Mac)"):Cell("Steps into a line of code")
        TableRow():Cell("Step Out"):Cell("CONTROL + F11 (PC), CMD + F11 (Mac)"):Cell("Steps out of a scope")
        TableRow():Cell("Run to Cursor"):Cell("CONTROL + F12 (PC), CMD + F12 (Mac)"):Cell("Run the debugger to the cursor")
        TableRow():Cell("Toggle Breakpoint"):Cell("CONTROL + K (PC), CMD + K (Mac)"):Cell("Toggle a breakpoint on this line")
        TableRow():Cell("Send to Android"):Cell("CONTROL + SHIFT + A (PC), CMD + SHIFT + A (Mac)"):Cell("Send a program to Android")
        TableRow():Cell("Send to iOS"):Cell("CMD + SHIFT + I (Mac)"):Cell("Send a program to iOS")
        TableRow():Cell("Set Program Start"):Cell("CONTROL + T (PC), CMD + T (Mac)"):Cell("Set the start of a program")
        Subsection("Team Menu (ALT + T)")
        Paragraph("The team menu allows projects versioned under the Git version control system to be used directly from within Quorum Studio. By default, each hotkey allows us to query for information, which is placed into Quorum's console. For example, we can request the status of our current version, commit code to our local system, pull code from a server on github.com or bitbucket.com, or push our code to the remote system. We strongly encourage any group doing team projects to adopt these features and use them. Other version control systems, like mercurial, subversion, or others are not supported.")
        Table("Team Menu Options")
        TableHeader():Cell("Name"):Cell("Key"):Cell("Description")
        TableRow():Cell("Clone"):Cell("CONTROL + SHIFT + O (PC), CMD + SHIFT + O (Mac)"):Cell("Pull up the clone dialog")
        TableRow():Cell("Pull"):Cell("CONTROL + SHIFT + L (PC), CMD + SHIFT + L (Mac)"):Cell("Get files from a remote server")
        TableRow():Cell("Status"):Cell("CONTROL + SHIFT + S (PC), CMD + SHIFT + S (Mac)"):Cell("Check the status of local files")
        TableRow():Cell("Add"):Cell("CONTROL + SHIFT + D (PC), CMD + SHIFT + D (Mac)"):Cell("Add an individual file")
        TableRow():Cell("Add Project Files"):Cell("CONTROL + SHIFT + A (PC), CMD + SHIFT + A (Mac)"):Cell("Add all source files")
        TableRow():Cell("Commit"):Cell("CONTROL + SHIFT + C (PC), CMD + SHIFT + C (Mac)"):Cell("Commit local files to the repository")
        TableRow():Cell("Push"):Cell("CONTROL + SHIFT + P (PC), CMD + SHIFT + P (Mac)"):Cell("Send files to remote server")
        Subsection("Window Menu (ALT + W)")
        Paragraph("The windows menu provides hotkeys for navigating around the windows of Quorum Studio with the keyboard. Two common keys to know are F6 and SHIFT + F6, which move to the next window in a sequence of windows. Besides these, we recommend knowing at least the keys to move between the tree (CTRL + 0 on PC or CMD + 0 on Mac) and the project tree (CTRL + 1 on PC or CMD + 1 on Mac).")
        Table("Window Menu Options")
        TableHeader():Cell("Name"):Cell("Key"):Cell("Description")
        TableRow():Cell("Next Focus"):Cell("F6"):Cell("Moves the focus to the next window")
        TableRow():Cell("Previous Focus"):Cell("SHIFT + F6"):Cell("Moves the focus to the previous window")
        TableRow():Cell("Projects"):Cell("CONTROL + 1 (PC), CMD + 1 (Mac)"):Cell("Move to the project window")
        TableRow():Cell("Editor"):Cell("CONTROL + 2 (PC), CMD + 2 (Mac)"):Cell("Move to the currently selected text editor")
        TableRow():Cell("Console"):Cell("CONTROL + 3 (PC), CMD + 3 (Mac)"):Cell("Move to the console")
        TableRow():Cell("Errors"):Cell("CONTROL + 4 (PC), CMD + 4 (Mac)"):Cell("Move to the compiler error tab")
        TableRow():Cell("Variables"):Cell("CONTROL + 5 (PC), CMD + 5 (Mac)"):Cell("Move to the variables tab for the debugger")
        TableRow():Cell("Breakpoints"):Cell("CONTROL + 6 (PC), CMD + 6 (Mac)"):Cell("Move to a list of all breakpoints")
        TableRow():Cell("Call Stack"):Cell("CONTROL + 7 (PC), CMD + 7 (Mac)"):Cell("Move to the call stack for a program running in the debugger")
        TableRow():Cell("Search Results"):Cell("CONTROL + 8 (PC), CMD + 8 (Mac)"):Cell("Move to the search results tab for find/replace")
        Subsection("Help Menu (ALT + H)")
        Paragraph("The help menu does not have any hotkeys, but contains two options, an about window that says the version number for Quorum Studio and the Check for Updates item. Check for updates, for Quorum Studio version 2.0 or higher, will automatically update itself to the next version.")
        Table("Help Menu Options")
        TableHeader():Cell("Name"):Cell("Key"):Cell("Description")
        TableRow():Cell("About"):Cell("None"):Cell("Pulls up the about dialog.")
    end
end
