use Libraries.Web.Page.QuorumPage

/*
    Tutorial: Operators.
    Converted from the old Lesson page by plan 13's generator: the same
    words, now without Tailwind.
*/
class OperatorsTutorial is QuorumPage
    // A double quote, for code and words that hold one.
    text dq = ""

    on create
        SetLocation("tutorials/language/operators.html")
        // The name lists and links use, and the series and track it belongs
        // to: its section and picture.
        SetShortTitle("Operators")
        SetSectionName("Quorum Basics")
        SetCardImage("/media/basics/operators.png")
        // For search engines and link previews, and what lists of pages say.
        SetDescription("Learn how to use core operators (e.g., +, -, *, /, mod, =, not=, <, , <=, >, >=) in the Quorum programming language.")
        SetSummary("how to apply mathematical operators to types")
    end

    action Setup
        dq = dq:GetDoubleQuote()
        SetWebPageTitle("Operators - Quorum Programming Language")
        Title("Tutorial: Operators")
        Paragraph("How to use +, -, *, /, and other operators with various types.")
        WhatAreOperators()
        IntegerAndNumberTypes()
        BooleanTypes()
        TextTypes()
    end

    private action WhatAreOperators
        Section("What are Operators?")
        Paragraph("In computer science, we often want to ask the computer to do certain mathematical operations. For example, we may want the computer to compare a set of numbers to see if they are equal or we may want to add, subtract, multiply, or divide numbers. In this section, we discuss this concept, operators, including which how they work in the Quorum programming language.")
    end

    private action IntegerAndNumberTypes
        Section("integer and number types")
        Paragraph("Integers are those numbers, positive or negative, without decimal points, while numbers are any numbers, including those with decimal points. Both integers and numbers have the same operators defined.")
        Subsection("Plus")
        Paragraph("The plus operator adds together numbers and concatenates, or puts together text. The following code would give the variable a the value of 10 and the variable b the value of "):DoubleQuote():Text("firefox."):DoubleQuote():Text(":")
        CodeExample("integer a = 5 + 5
text b = " + dq + "fire" + dq + " + " + dq + "fox" + dq + "
output a
output b")
        CodeEditorWithCode("Activity: Try Plus", "//Try above code"):HideDisplay()
        Subsection("Minus")
        Paragraph("The minus operator subtracts numbers. The following code would give the variable a the value of 0:")
        CodeExample("integer a = 5 - 5
output a")
        CodeEditorWithCode("Activity: Try Minus", "//Try above code"):HideDisplay()
        Subsection("Times")
        Paragraph("The plus (star) operator multiples together numbers. The following code would give the variable a the value of 25:")
        CodeExample("integer a = 5 * 5
output a")
        CodeEditorWithCode("Activity: Try Times", "//Try above code"):HideDisplay()
        Subsection("Divide")
        Paragraph("The divide (forward slash) operator divides numbers. The following code would give the variable a the value of 1:")
        CodeExample("integer a = 5 / 5
output a")
        CodeEditorWithCode("Activity: Try Divide", "//Try above code"):HideDisplay()
        Subsection("Modulus")
        Paragraph("The modulus (mod) operator returns the remainder in an integer division. The following code would give the variable a the value of 0:")
        CodeExample("integer a = 5 mod 5
output a")
        CodeEditorWithCode("Activity: Try Modulus", "//Try above code"):HideDisplay()
        Subsection("Less than")
        Paragraph("The less than operator tests to see if the number to the left of the symbol is smaller than the number on the right. The following code would give the variable a the value of true:")
        CodeExample("boolean a = 5 < 6
output a")
        CodeEditorWithCode("Activity: Try Less Than", "//Try above code"):HideDisplay()
        Subsection("Less than or equal to")
        Paragraph("The less than operator tests to see if the number to the left of the symbol is smaller than or equal to the number on the right. The following code would give the variable a the value of true:")
        CodeExample("boolean a = 5 <= 6
output a")
        CodeEditorWithCode("Activity: Try Less Than or Equals", "//Try above code"):HideDisplay()
        Subsection("Greater than")
        Paragraph("The greater than operator tests to see if the number to the left of the symbol is bigger than the number on the right. The following code would give the variable a the value of false:")
        CodeExample("boolean a = 5 > 6
output a")
        CodeEditorWithCode("Activity: Try Greater Than", "//Try above code"):HideDisplay()
        Subsection("Greater than or equal to")
        Paragraph("The the greater than or equal to operator tests to see if the number to the left of the symbol is bigger or equal to the number on the right. The following code would give the variable a the value of false:")
        CodeExample("boolean a = 5 >= 6
output a")
        CodeEditorWithCode("Activity: Try Greater Than or Equals", "//Try above code"):HideDisplay()
    end

    private action BooleanTypes
        Section("boolean types")
        Paragraph("Boolean types are those that have only two values: true and false. Because they only allow two possible values, only equals and not equals can be used.")
        Subsection("Equals")
        Paragraph("The equals sign determines whether two values are the same The following code would give the variable a the value of true:")
        CodeExample("boolean a = true = true
output a")
        CodeEditorWithCode("Activity: Try Equals", "//Try above code"):HideDisplay()
        Subsection("Not Equals")
        Paragraph("The not equals (not=) sign determines whether two values are not the same. The following code would give the variable a the value of false:")
        CodeExample("boolean a = true not= true
output a")
        CodeEditorWithCode("Activity: Try Not Equals", "//Try above code"):HideDisplay()
        Subsection("And")
        Paragraph("The 'and' keyword combines boolean expressions and is true if both the left and right hand side is true. Otherwise, it gives false. The following code would give us the value of true for a and false for b:")
        CodeExample("boolean a = true and true
output a
boolean b = true and false
output b")
        CodeEditorWithCode("Activity: Try using and", "//Try above code"):HideDisplay()
        Subsection("Or")
        Paragraph("The 'or' keyword combines boolean expressions and is true if both the left or right hand side is true. If both are false, it gives false. The following code would give us the value of true for a and false for b:")
        CodeExample("boolean a = false or true
output a
boolean b = false or false
output b")
        CodeEditorWithCode("Activity: Try using or", "//Try above code"):HideDisplay()
    end

    private action TextTypes
        Section("text types")
        Paragraph("The text type allows you to type a list of characters that the computer can process. Strings have only one operation that is allowed on them, the plus operator, which adds two strings together. This is called concatenation. The following code would give the variable 'combined' the value of "):DoubleQuote():Text("Hello, World!."):DoubleQuote()
        CodeExample("text a = " + dq + "Hello, " + dq + "
text b = " + dq + " world!" + dq + "
text combined = a + b
output combined")
        Subsection("Concatenate")
        Paragraph("Text values can also be combined with other types, like integers, numbers, or booleans using the same operator, plus. For example, we could create an integer and add it to a text field. The following code would give the variable a the value of "):DoubleQuote():Text("My favorite number is 5."):DoubleQuote()
        CodeExample("text a = " + dq + " My favorite number is " + dq + " + 5
output a")
        CodeEditorWithCode("Activity: Try Concatenate", "//Try above code"):HideDisplay()
    end
end
