use Libraries.Web.Page.QuorumPage

/*
    Tutorial: Embedding Quorum Online.
    Converted from the old Lesson page by plan 13's generator: the same
    words, now without Tailwind.
*/
class EmbedTutorial is QuorumPage
    // A double quote, for code and words that hold one.
    text dq = ""

    on create
        SetLocation("tutorials/language/embedTutorial.html")
        // The name lists and links use, and the series and track it belongs
        // to: its section and picture.
        SetShortTitle("Embedding Quorum Online")
        // For search engines and link previews, and what lists of pages say.
        SetDescription("Learn more about how to add Quorum to your own website with embedding.")
        SetSummary("how to embed quorum")
    end

    action Setup
        dq = dq:GetDoubleQuote()
        SetWebPageTitle("Embed Quorum - Quorum Programming Language")
        Title("Tutorial: Embedding Quorum Online")
        Paragraph("How to start embedding Quorum into your own website.")
        EmbeddingQuorumOnTheWeb()
        MakingTheWebpage()
    end

    private action EmbeddingQuorumOnTheWeb
        Section("Embedding Quorum on the Web")
        Paragraph("On this page, we discuss how to embed the online Quorum Integrated Development Environment (IDE) and formatted Quorum source code. The Quorum Language website has online IDEs all over the site to allow users to run Quorum code in the browser and this feature can be made available on other websites through the use of the provided embedding scripts. The embed scripts and styles also allow for injecting Quorum source code examples that have similar highlighting as would be found in Quorum Studio. Here we will make a small example web page that embeds Quorum.")
    end

    private action MakingTheWebpage
        Section("Making the Webpage")
        Paragraph("To show how to embed Quorum this page we will walk through making a basic HTML page that will link to the embed scripts and add Quorum examples and an IDE. In order to embed Quorum onto your own website you need to make changes to an HTML page and use Javascript. How to use those technologies will not be taught here so this page will assume you have previous knowledge of how to use these.")
        Paragraph("To start off we will have a blank html document that will have nothing in it but a header that says, Embed Quorum on My Own Page! The code for that will look like this:")
        CodeExample("<!DOCTYPE html>
<html xml:lang= " + dq + "en" + dq + " lang= " + dq + "en" + dq + " >
   <head >
      <title >My Page</title>
      <meta charset= " + dq + "UTF-8" + dq + " >
      <meta content= " + dq + "width=device-width, initial-scale=1" + dq + " name= " + dq + "viewport" + dq + " >
   </head>
   <body >
      <main id=" + dq + "main" + dq + " tabindex=" + dq + "-1" + dq + " role = " + dq + "main" + dq + ">
            <h1>Embed Quorum on My Own Page!</h1>

      </main>
   </body>
</html>", "")
        Paragraph("Starting with this simple page we will add a script and link a stylesheet in the head of the document like so:")
        CodeExample("<head>
      <title >My Page</title>
      <meta charset= " + dq + "UTF-8" + dq + " >
      <meta content= " + dq + "width=device-width, initial-scale=1" + dq + " name= " + dq + "viewport" + dq + " >
      <script src= " + dq + "https://quorumlanguage.com/embed/embed-quorum.js" + dq + "  type=" + dq + "text/javascript" + dq + "></script>
      <link rel= " + dq + "stylesheet" + dq + " type= " + dq + "text/css" + dq + " href= " + dq + "https://quorumlanguage.com/embed/embed-quorum.css" + dq + " >
</head>", "")
        Paragraph("The important thing to note here is that there are links to files that live on the Quorum servers. These two files are "):DoubleQuote():Text("https://quorumlanguage.com/embed/embed-quorum.js"):DoubleQuote():Text(" and "):DoubleQuote():Text("https://quorumlanguage.com/embed/embed-quorum.css."):DoubleQuote():Text(" The javascript file adds two functions that can be used to inject Quorum examples and environments. The styling sheets will format the injected objects to make sure they render.")
        Paragraph("Now we will go to the body of the document and add script objects that will inject a code example.")
        CodeExample("<script> 
    //get where you want to make a code example and add it.
    var body = document.getElementById(" + dq + "main" + dq + ");
    InjectQuorumCodeExample(body, " + dq + "MyExample" + dq + ", " + dq + "output \" + dq + "Hello, World!\" + dq + dq + ")
</script>", "")
        Paragraph("This script object has code in it that grabs a container on the page and adds a Quorum example to it. The function named InjectQuorumCodeExample has 3 parameters: the container to add to, the name of the example to give as an id, and the code to put in the example. The name is so that the name of the object does not conflict with anything else on the page. With that script a code example will appear on the screen with line numbers and highlighting and will appear as the one below:")
        CodeExample("output " + dq + "Hello, World" + dq)
        Paragraph("Now you have Quorum embedding on your own page! To add more examples you can simply add more in that script object or call that function in your page however you like. Now you can also inject a Quorum environment that will allow you to type, compile, and run Quorum Code. An example of how to do this will be below. It is similar to how you would inject an example but now the function to call is InjectQuorumEnvironment.")
        CodeExample("<script> 
    //get where you want to make a quorum environment and add it.
    var body = document.getElementById(" + dq + "main" + dq + ");
    InjectQuorumEnvironment(body, " + dq + "frontPage" + dq + ", " + dq + "output 5" + dq + ");
</script>", "")
        Paragraph("Loading and viewing the page now will have the heading "):DoubleQuote():Text("Embed Quorum on My Own Page!"):DoubleQuote():Text(" with a Quorum example and environment below it. The IDE is very similar to the one can be found all over the site, but it will be missing features that involve saving and loading the IDE from projects saved under an account.")
        Paragraph("That is all that is needed to embed Quorum on a website. Now you can add Quorum examples and environments wherever you want on your own site.")
        Paragraph("If you had trouble getting your page to work the completed example is below.")
        CodeExample("<!DOCTYPE html>
<html xml:lang= " + dq + "en" + dq + " lang= " + dq + "en" + dq + " >
<head>
      <title >My Page</title>
      <meta charset= " + dq + "UTF-8" + dq + " >
      <meta content= " + dq + "width=device-width, initial-scale=1" + dq + " name= " + dq + "viewport" + dq + " >
      <script src= " + dq + "https://quorumlanguage.com/embed/embed-quorum.js" + dq + "  type=" + dq + "text/javascript" + dq + "></script>
      <link rel= " + dq + "stylesheet" + dq + " type= " + dq + "text/css" + dq + " href= " + dq + "https://quorumlanguage.com/embed/embed-quorum.css" + dq + " >
</head>
<body>
   <main id=" + dq + "main" + dq + " tabindex=" + dq + "-1" + dq + " role = " + dq + "main" + dq + ">
      <h1>Embed Quorum on My Own Page!</h1>
      <script> 
         //get where you want to make a code example and add it.
         var body = document.getElementById(" + dq + "main" + dq + ");
         InjectQuorumCodeExample(body, " + dq + "MyExample" + dq + ", " + dq + "output \" + dq + "Hello, World!\" + dq + dq + ")
      </script>
      <script> 
         //get where you want to make a quorum environment and add it.
         var body = document.getElementById(" + dq + "main" + dq + ");
         InjectQuorumEnvironment(body, " + dq + "frontPage" + dq + ", " + dq + "output 5" + dq + ");
      </script>
   </main>
</body>
</html>", "")
    end
end
