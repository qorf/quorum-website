use Libraries.Web.Page.QuorumPage

/*
    Tutorial: Databases.
    Converted from the old Lesson page by plan 13's generator: the same
    words, now without Tailwind.
*/
class DatabasesEmpty is QuorumPage
    // A double quote, for code and words that hold one.
    text dq = ""

    on create
        SetLocation("tutorials/databases/emptyDatabase.html")
        // The name lists and links use, and the series and track it belongs
        // to: its section and picture.
        SetShortTitle("Emptying a Database Table")
        SetSectionName("Databases")
        // For search engines and link previews, and what lists of pages say.
        SetDescription("Learn about emptying a database table on Quorum Language.")
        SetSummary("how to empty a database table")
    end

    action Setup
        dq = dq:GetDoubleQuote()
        SetWebPageTitle("Emptying a Database Table - Quorum Programming Lanugage")
        Title("Tutorial: Databases")
        Paragraph("This tutorial shows us how to empty all the data from a database table")
        EmptyingATable()
    end

    private action EmptyingATable
        Section("Emptying a Table")
        Paragraph("Along with deleting rows, say that we wish to delete all our data in our table. This action could be necessary if we input a lot of wrong data into the table, have a table full of redundant data, or we would no longer need to work with this table. Although conserving data is important, having a much more manageable database is prioritized.")
        Paragraph("For this tutorial, we will be learning how to empty all our data in a data table. Seeing that we have modified our "):DoubleQuote():Text("grocerylist"):DoubleQuote():Text(" table so much, we now decide that we would like to start fresh and remove all our data inside that table.")
        Paragraph("This is a rather simple tutorial as we have no need for any additional objects or actions. We will again start off with connecting our database. Once we connect our database, we will want to call the action EmptyTable(text tableName) using our Database object. EmptyTable() takes in one parameter, a string, which will be the table name we wish to empty. In our case, we will want to pass in "):DoubleQuote():Text("grocerylist"):DoubleQuote():Text(" as the parameter. We can verify if our table has been emptied by converting our table into a DataFrame and outputting our frame. "):Link("To learn more about DataFrames, we can reference this tutorial.", "https://quorumlanguage.com/tutorials/SavingAndLoading/IntroDataFrames.html")
        CodeExample("database:EmptyTable(" + dq + "grocerylist" + dq + ")")
        Table("Empty Actions")
        TableHeader():Cell("Action"):Cell("Description"):Cell("Usage")
        TableRow():Cell("databaseObject:EmptyTable(text tableName)"):Cell("This action removes all rows in a table. The table will still appear in the database but all rows of data will be gone"):Cell("database:EmptyTable(" + dq + "MovieList" + dq + ")")
        Paragraph("Congrats! We have learned how to empty a database table. The entire program can be viewed below.")
        CodeExample("use Libraries.Data.Database.Database
use Libraries.Compute.Statistics.DataFrame

Database database

database:Connect(" + dq + "localhost" + dq + ", " + dq + "myfirstdatabase" + dq + ", " + dq + "root" + dq + ", " + dq + "password" + dq + ")

database:EmptyTable(" + dq + "grocerylist" + dq + ")

DataFrame frame

frame = database:FindAsDataFrame(" + dq + "grocerylist" + dq + ")

output frame:ToText()")
    end
end
