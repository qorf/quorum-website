use Libraries.Web.Page.QuorumPage

/*
    Tutorial: Databases.
    Converted from the old Lesson page by plan 13's generator: the same
    words, now without Tailwind.
*/
class DatabasesInnerJoins is QuorumPage
    // A double quote, for code and words that hold one.
    text dq = ""

    on create
        SetLocation("tutorials/databases/InnerJoins.html")
        // The name lists and links use, and the series and track it belongs
        // to: its section and picture.
        SetShortTitle("Inner Joins")
        SetSectionName("Databases")
        // For search engines and link previews, and what lists of pages say.
        SetDescription("Learn about inner joins on a database table on Quorum Language.")
        SetSummary("how to create a inner join on a database table")
    end

    action Setup
        dq = dq:GetDoubleQuote()
        SetWebPageTitle("Inner Joins - Quorum Programming Lanugage")
        Title("Tutorial: Databases")
        Paragraph("This tutorial shows us how to create a Inner join")
        InnerJoins()
    end

    private action InnerJoins
        Section("Inner Joins")
        Paragraph("Recall that with an inner join, it creates a new result table by combining column values of two tables (table1 and table2) based upon the join-predicate. The query compares each row of table1 with each row of table2 to find all pairs of rows which satisfy the join-predicate. We saw this with our earlier example of customerID's where it created a new table of all the related values from two separate tables.")
        Paragraph("In this tutorial we will be finding a inner joins between two tables. We are also creating and inserting data from scratch. In this tutorial, there will be a total of 5 separate programs that all lead into creating our two types of joins: creating our tables, adding data into table 1, adding data into table 2, and creating inner join. "):Link("For the table creation, we will be referencing methods on a tutorial on how to create database tables.", "tutorials/databases/databaseTable.html"):Text(" "):Link("For the data insertion, we will be referring to methods on a tutorial on how to insert data.", "tutorials/databases/insertingDataDatabases.html"):Text(" Regardless, for each tutorial, we will want to connect our Database into Quorum Studio before we proceed into any work. In the first part of this tutorial we will be creating our tables.")
        Paragraph("We will be wanting to create two tables: one table called "):DoubleQuote():Text("amazon_wishlist"):DoubleQuote():Text(" and the other table called "):DoubleQuote():Text("customer_wishlist"):DoubleQuote():Text(" and we will follow a very similar pattern to our "):DoubleQuote():Text("Orders"):DoubleQuote():Text(" and "):DoubleQuote():Text("Customers"):DoubleQuote():Text(" example. We will first be creating two CreateTable objects: newTable and newTable1. We will first start to build our first table, "):DoubleQuote():Text("amazon_wishlist"):DoubleQuote():Text(" using the actions SetTable(text table name), AddIntegerColum(text columnName), and AddTextColumn(text columnName, int charLimit). The columns and the data types will be as follows:")
        Table("Amazon Wishlist")
        TableHeader():Cell("OrderID"):Cell("CustomerID"):Cell("OrderItem"):Cell("OrderCost"):Cell("OrderQuantity")
        TableRow():Cell("Data Type: integer"):Cell("Data Type: integer"):Cell("Data Type: text"):Cell("Data Type: integer"):Cell("Data Type: integer")
        Paragraph("Once we have created all our columns, we will now want to pass in our newTable object into an action called CreateTable(CreateTable objectName) using our database object.")
        CodeExample("CreateTable newTable
    newTable:SetTable(" + dq + "amazon_wishlist" + dq + ")
    newTable:AddIntegerColumn(" + dq + "orderID" + dq + ")
    newTable:AddIntegerColumn(" + dq + "customerID" + dq + ")
    newTable:AddTextColumn(" + dq + "orderItem" + dq + ", 500)
    newTable:AddIntegerColumn(" + dq + "orderCost" + dq + ")
    newTable:AddIntegerColumn(" + dq + "orderQuantity" + dq + ")
    database:CreateTable(newTable)")
        Paragraph("We will want to follow this same process for the other table, "):DoubleQuote():Text("customer_list"):DoubleQuote():Text(" where the columns and data types will be as follows:")
        Table("Customer List")
        TableHeader():Cell("CustomerNum"):Cell("CustomerID"):Cell("CustomerName"):Cell("Country"):Cell("City"):Cell("ZipCode")
        TableRow():Cell("DataType: integer"):Cell("DataType: integer"):Cell("DataType: string / text"):Cell("DataType: string / text"):Cell("DataType: string / text"):Cell("DataType: integer")
        Paragraph("The full code will be below:")
        CodeExample("use Libraries.Data.Database.Database
    use Libraries.Data.Database.CreateTable

    Database database
    database:Connect(" + dq + "localhost" + dq + ", " + dq + "myfirstdatabase" + dq + ", " + dq + "root" + dq + ", " + dq + "password" + dq + ")

    // create first table
    CreateTable newTable
    newTable:SetTable(" + dq + "amazon_wishlist" + dq + ")
    newTable:AddIntegerColumn(" + dq + "orderID" + dq + ")
    newTable:AddIntegerColumn(" + dq + "customerID" + dq + ")
    newTable:AddTextColumn(" + dq + "orderItem" + dq + ", 500)
    newTable:AddIntegerColumn(" + dq + "orderCost" + dq + ")
    newTable:AddIntegerColumn(" + dq + "orderQuantity" + dq + ")
    database:CreateTable(newTable)

    CreateTable newTable1
    newTable1:SetTable(" + dq + "customer_list" + dq + ")
   newTable1:AddIntegerColumn(" + dq + "customerNum" + dq + ")
    newTable1:AddIntegerColumn(" + dq + "customerID" + dq + ")
    newTable1:AddTextColumn(" + dq + "customerName" + dq + ", 500)
    newTable1:AddTextColumn(" + dq + "Country" + dq + ", 500)
    newTable1:AddTextColumn(" + dq + "City" + dq + ", 500)
    newTable1:AddIntegerColumn(" + dq + "Zipcode')
    database:CreateTable(newTable1)")
        Paragraph("Next, we will want to enter data inside our tables. We will have two separate programs to insert data into our "):DoubleQuote():Text("customer_list"):DoubleQuote():Text(" table and then our "):DoubleQuote():Text("amazon_wishlist"):DoubleQuote():Text(" table. Let's go ahead and define our Insert object named "):DoubleQuote():Text("insert."):DoubleQuote():Text(" We will be using this object to access the actions SetTable(), ToText(), Empty() and Add().")
        Paragraph("To insert data, we will need to make sure we select our table using SetTable(text tableName); let's do this with "):DoubleQuote():Text("amazon_wishlist"):DoubleQuote():Text(" first and insert this string as our parameter. Then we will want to use the action Add(text columnName, dataType dataValue) with our insert object to enter in appropriate data on the columns.")
        Paragraph("Recall that our columns are: orderID, customerID, orderItem, orderCost, and orderQuantity. For example, say that we want to add an entry for "):DoubleQuote():Text("orderName,"):DoubleQuote():Text(" we will need to call the action Add() with our Insert object and insert "):DoubleQuote():Text("orderName"):DoubleQuote():Text(" in the first parameter and an item we see off of Amazon on inside the second parameter. Below is a code snippet of adding one complete row onto our table:")
        CodeExample("// add first entry
  insert:Add(" + dq + "orderID" + dq + ", 1)
  insert:Add(" + dq + "customerID" + dq + ", 101)
  insert:Add(" + dq + "orderItem" + dq + ", " + dq + "Laundry Rack" + dq + ")
  insert:Add(" + dq + "orderCost" + dq + ", 22)
  insert:Add(" + dq + "orderQuantity" + dq + ", 2)
 // will only insert 1 query at a time
  database:Insert(insert)
  rowsAffected = rowsAffected + 1
    output insert:ToText()")
        Paragraph("It is important that once we add one record, we must immediately call the action Empty() which will clear out our object so we can add multiple records inside of one program. Optionally, to confirm our insert, we can also call the action ToText() that outputs the SQL notation of insertion. Now that we know how to insert a row, we can populate the table for "):DoubleQuote():Text("amazon_wishlist"):DoubleQuote():Text(" as well as "):DoubleQuote():Text("customer_list."):DoubleQuote():Text(" Below are the two sets of code for inserting both tables, amazon_wishlist and customer_list.")
        CodeExample("use Libraries.Data.Database.Database
use Libraries.Data.Database.Insert

Database database
database:Connect(" + dq + "localhost" + dq + ", " + dq + "myfirstdatabase" + dq + ", " + dq + "root" + dq + ", " + dq + "password" + dq + ")

  Insert insert
  insert:SetTable(" + dq + "amazon_wishlist" + dq + ")
 // keep a running sum on how many rows we add 
 integer rowsAffected = 0
   
  // add first entry
  insert:Add(" + dq + "orderID" + dq + ", 1)
  insert:Add(" + dq + "customerID" + dq + ", 101)
  insert:Add(" + dq + "orderItem" + dq + ", " + dq + "Laundry Rack" + dq + ")
  insert:Add(" + dq + "orderCost" + dq + ", 22)
  insert:Add(" + dq + "orderQuantity" + dq + ", 2)
 // will only insert 1 query at a time
  database:Insert(insert)
  rowsAffected = rowsAffected + 1
    output insert:ToText()

/* clears out info from previous insert
   we need to call this because it only inserts one
   at a time, we can insert multiple queries at 
   the same time with this method
*/
  insert:Empty()
   insert:Add(" + dq + "orderID" + dq + ", 2)
  insert:Add(" + dq + "customerID" + dq + ", 102)
  insert:Add(" + dq + "orderItem" + dq + ", " + dq + "Blackout Curtain" + dq + ")
  insert:Add(" + dq + "orderCost" + dq + ", 11)
  insert:Add(" + dq + "orderQuantity" + dq + ", 1)
  database:Insert(insert)
  output insert:ToText()

   rowsAffected = rowsAffected + 1

  insert:Empty()
   insert:Add(" + dq + "orderID" + dq + ", 3)
  insert:Add(" + dq + "customerID" + dq + ", 103)
  insert:Add(" + dq + "orderItem" + dq + ", " + dq + "Shadow Box Frame" + dq + ")
  insert:Add(" + dq + "orderCost" + dq + ", 18)
  insert:Add(" + dq + "orderQuantity" + dq + ", 5)
  database:Insert(insert)
output insert:ToText()

  rowsAffected = rowsAffected + 1

  insert:Empty()
 insert:Add(" + dq + "orderID" + dq + ", 4)
  insert:Add(" + dq + "customerID" + dq + ", 104)
  insert:Add(" + dq + "orderItem" + dq + ", " + dq + "Decorative Throw Pillows" + dq + ")
  insert:Add(" + dq + "orderCost" + dq + ", 32)
  insert:Add(" + dq + "orderQuantity" + dq + ", 2)

  database:Insert(insert)
  rowsAffected = rowsAffected + 1
output insert:ToText()

insert:Empty()
  insert:Add(" + dq + "orderID" + dq + ", 5)
  insert:Add(" + dq + "customerID" + dq + ", 105)
  insert:Add(" + dq + "orderItem" + dq + ", " + dq + "Small Table Lamp" + dq + ")
  insert:Add(" + dq + "orderCost" + dq + ", 12)
  insert:Add(" + dq + "orderQuantity" + dq + ", 3)

  database:Insert(insert)
  rowsAffected = rowsAffected + 1
output insert:ToText()


insert:Empty()
  insert:Add(" + dq + "orderID" + dq + ", 6)
  insert:Add(" + dq + "customerID" + dq + ", 106)
  insert:Add(" + dq + "orderItem" + dq + ", " + dq + "Dove Beauty Bar" + dq + ")
  insert:Add(" + dq + "orderCost" + dq + ", 23)
  insert:Add(" + dq + "orderQuantity" + dq + ", 10)

  database:Insert(insert)
  rowsAffected = rowsAffected + 1
output insert:ToText()


output " + dq + "Inserted " + dq + " + rowsAffected + " + dq + " row(s)" + dq)
        CodeExample("use Libraries.Data.Database.Database
use Libraries.Data.Database.Insert  

Database database
database:Connect(" + dq + "localhost" + dq + ", " + dq + "myfirstdatabase" + dq + ", " + dq + "root" + dq + ", " + dq + "password" + dq + ")

  Insert insert
  insert:SetTable(" + dq + "customer_list" + dq + ")
 // keep a running sum on how many rows we add 
 integer rowsAffected = 0
   
  // add first entry
  insert:Add(" + dq + "customerNum" + dq + ", 1)
  insert:Add(" + dq + "customerID" + dq + ", 99)
  insert:Add(" + dq + "customerName" + dq + ", " + dq + "Bob Ross" + dq + ")
  insert:Add(" + dq + "Country" + dq + ", " + dq + "US" + dq + ")
  insert:Add(" + dq + "City" + dq + ", " + dq + "Orlando" + dq + ")
  insert:Add(" + dq + "Zipcode" + dq + ", 32801)
 // will only insert 1 query at a time
  database:Insert(insert)
  rowsAffected = rowsAffected + 1
    output insert:ToText()
insert:Empty()

insert:Add(" + dq + "customerNum" + dq + ", 2)
  insert:Add(" + dq + "customerID" + dq + ", 100)
  insert:Add(" + dq + "customerName" + dq + ", " + dq + "Elmo" + dq + ")
  insert:Add(" + dq + "Country" + dq + ", " + dq + "US" + dq + ")
