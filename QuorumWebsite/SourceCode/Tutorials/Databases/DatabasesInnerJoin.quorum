  insert:Add(" + dq + "Zipcode" + dq + ", 10128)
 // will only insert 1 query at a time
  database:Insert(insert)
  rowsAffected = rowsAffected + 1
    output insert:ToText()
insert:Empty()

insert:Add(" + dq + "customerNum" + dq + ", 3)
  insert:Add(" + dq + "customerID" + dq + ", 101)
  insert:Add(" + dq + "customerName" + dq + ", " + dq + "Harry Styles" + dq + ")
  insert:Add(" + dq + "Country" + dq + ", " + dq + "UK" + dq + ")
  insert:Add(" + dq + "City" + dq + ", " + dq + "London" + dq + ")
