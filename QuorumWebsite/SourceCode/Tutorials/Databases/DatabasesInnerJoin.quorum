 // will only insert 1 query at a time
  database:Insert(insert)
  rowsAffected = rowsAffected + 1
    output insert:ToText()
insert:Empty()

insert:Add(" + dq + "customerNum" + dq + ", 4)
  insert:Add(" + dq + "customerID" + dq + ", 102)
  insert:Add(" + dq + "customerName" + dq + ", " + dq + "Anya Forger" + dq + ")
  insert:Add(" + dq + "Country" + dq + ", " + dq + "Germany" + dq + ")
  insert:Add(" + dq + "City" + dq + ", " + dq + "Berlin" + dq + ")
  insert:Add(" + dq + "Zipcode" + dq + ", 10115)
 // will only insert 1 query at a time
  database:Insert(insert)
  rowsAffected = rowsAffected + 1
    output insert:ToText()
insert:Empty()

insert:Add(" + dq + "customerNum" + dq + ", 5)
  insert:Add(" + dq + "customerID" + dq + ", 103)
  insert:Add(" + dq + "customerName" + dq + ", " + dq + "Steven Universe" + dq + ")
  insert:Add(" + dq + "Country" + dq + ", " + dq + "US" + dq + ")
  insert:Add(" + dq + "City" + dq + ", " + dq + "Beach City" + dq + ")
  insert:Add(" + dq + "Zipcode" + dq + ", 44608)
 // will only insert 1 query at a time
  database:Insert(insert)
  rowsAffected = rowsAffected + 1
    output insert:ToText()
insert:Empty()

insert:Add(" + dq + "customerNum" + dq + ", 6)
  insert:Add(" + dq + "customerID" + dq + ", 104)
  insert:Add(" + dq + "customerName" + dq + ", " + dq + "Chihiro Ogino" + dq + ")
  insert:Add(" + dq + "Country" + dq + ", " + dq + "Japan" + dq + ")
  insert:Add(" + dq + "City" + dq + ", " + dq + "Tokyo" + dq + ")
  insert:Add(" + dq + "Zipcode" + dq + ", 1000004)
 // will only insert 1 query at a time
  database:Insert(insert)
  rowsAffected = rowsAffected + 1
    output insert:ToText()
insert:Empty()

  output " + dq + "Inserted " + dq + " + rowsAffected + " + dq + " row(s)" + dq)
        Paragraph("Lastly, we are going to create an inner join of our two tables. To do this, we will be calling the action, FindInnerJoin(text tableName, text joinedTable, text jointCondition) and then saving our result into a QueryResult object. For the first two parameters, we will want to insert our two table names, "):DoubleQuote():Text("amazon_wishlist"):DoubleQuote():Text(" and "):DoubleQuote():Text("customer_list"):DoubleQuote():Text(" but for our third parameter, we will need to find a corresponding column that will essentially map the two tables together.")
        Paragraph("As we made our tables in the beginning, notice that both tables contain the column "):DoubleQuote():Text("customerID"):DoubleQuote():Text("; we will be using this column in our jointCondition. Our condition is formatted to be table1:column = table2:column. Therefore, our actual joint condition will be: "):DoubleQuote():Text("amazon_wishlist:customerID = customer_list:customerID"):DoubleQuote():Text(" inside the 3rd parameter. Let's also go ahead and print the results of our QueryResult item inside a repeat while loop.")
        CodeExample("QueryResult result = database:FindInnerJoin(" + dq + "amazon_wishlist" + dq + ", " + dq + "customer_list" + dq + ", " + dq + "amazon_wishlist:customerID = customer_list:customerID" + dq + ")")
        Paragraph("Congratulations! We have created an inner join! We can view the entire code below.")
        CodeExample("use Libraries.Data.Database.Database
use Libraries.Data.Database.CreateTable
use Libraries.Data.Database.QueryResult
 
   Database database
    database:Connect(" + dq + "localhost" + dq + ", " + dq + "myfirstdatabase" + dq + ", " + dq + "root" + dq + ", " + dq + "password" + dq + ")

    QueryResult result = database:FindInnerJoin(" + dq + "amazon_wishlist" + dq + ", " + dq + "customer_list" + dq + ", " + dq + "amazon_wishlist:customerID = customer_list:customerID" + dq + ")
    repeat while result:HasNext()
        result:Next()
        output " + dq + "CustomerName: " + dq + " + result:GetText(" + dq + "customerName" + dq + ")
        output " + dq + "orderItem: " + dq + " + result:GetText(" + dq + "orderItem" + dq + ")

        output " + dq + " " + dq + "
    end")
    end
end
