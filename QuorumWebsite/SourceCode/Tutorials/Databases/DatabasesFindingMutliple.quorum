use Libraries.Web.Page.QuorumPage

/*
    Tutorial: Databases.
    Converted from the old Lesson page by plan 13's generator: the same
    words, now without Tailwind.
*/
class DatabasesFindMulti is QuorumPage
    // A double quote, for code and words that hold one.
    text dq = ""

    on create
        SetLocation("tutorials/databases/multiColumnDatabases.html")
        // The name lists and links use, and the series and track it belongs
        // to: its section and picture.
        SetShortTitle("Finding Muliple Columns")
        SetSectionName("Databases")
        // For search engines and link previews, and what lists of pages say.
        SetDescription("Learn about finding multiple columns of data in Quorum.")
        SetSummary("how to find and summarize mutliple columns of data")
    end

    action Setup
        dq = dq:GetDoubleQuote()
        SetWebPageTitle("Finding Multiple Columns- Quorum Programming Lanugage")
        Title("Tutorial: Databases")
        Paragraph("This tutorial shows us how to find data within multiple columns")
        FindingMultipleColumns()
    end

    private action FindingMultipleColumns
        Section("Finding Multiple Columns")
        Paragraph("While finding a single column is useful to a general trend of data, it would be tedious looking at entries column by column. In Quorum, we can use another method of finding that works just like SQL's SELECT command, and can find multiple columns at the same time. For this tutorial, we will be learning about how to find multiple columns and use our Find object to narrow down a single record.")
        Paragraph("We will want to connect our database once again as well as create a Find object. To do this, we would create a new object called QueryResult, that allows us to use "):Link("helper actions", "https://quorumlanguage.com/Libraries/Data/Database/Find.html"):Text(" to filter out data. Let's call this Find object "):DoubleQuote():Text("query."):DoubleQuote()
        CodeExample("use Libraries.Data.Database.Database
use Libraries.Data.Database.Find
use Libraries.Data.Database.QueryResult
use Libraries.Data.Database.QueryMetaData

    
    Database database
    database:Connect(" + dq + "localhost" + dq + ", " + dq + "myfirstdatabase" + dq + ", " + dq + "root" + dq + ", " + dq + "password" + dq + ")

    Find query")
        Paragraph("With our Find object, we will be using the actions: SetTable(text tableName), AddColumn(textColumn name), AddColumnFromTable(text columnName, text tableName), AddSum(text columnName), AddCount(text columnName), and AddMaximum(text columnName). With our Database object we will also be calling the Find(Find objectName) to perform the action onto our database.")
        Table("Finding Actions")
        TableHeader():Cell("Action / Object"):Cell("Description"):Cell("Usage")
        TableRow():Cell("Find objectName"):Cell("The Find query represents the SELECT command of the SQL (Structured Query Language) language. This query allows for accessing data in the database. This query also allows operations to be performed on the data before returning it, such as Sum, Maximum, or Count."):Cell("Find query")
        TableRow():Cell("findObject:SetTable(text tableName)"):Cell("This action sets the table of the query. Most queries run against a single table and this action is used to set which table the query will affect or search."):Cell("query:SetTable(" + dq + "VideoGamesList" + dq + ")")
        TableRow():Cell("findObject:AddColumn(text columnName)"):Cell("This action adds a column target. The column targets will be the columns in a database table to fetch data from."):Cell("query:AddColumn(" + dq + "GameGenre" + dq + ")")
        TableRow():Cell("findObject:AddColumnFromTable(text columnName, text tableName)"):Cell("This action adds a column target. The column targets will be the columns in a database table to fetch data from. The exact table the column is from can be added in the case the name might be ambiguous when using joins."):Cell("query:AddColumnFromTable( " + dq + "GameName" + dq + ", " + dq + "videoGames_list" + dq + ")")
        TableRow():Cell("findObject:AddSum(text columnName)"):Cell("Add a column where, instead of displaying it, we sum its values."):Cell("query:AddSum(" + dq + "GamePopularity" + dq + ")")
        TableRow():Cell("findObject:AddCount(text columnName)"):Cell("Add a column where, instead of displaying it, we count the number of rows that match with the specified criteria."):Cell("query:AddCount(" + dq + "GameDifficulty" + dq + ")")
        TableRow():Cell("findObject:AddMaximum(text columnName)"):Cell("Add a column where, instead of displaying it, we find the maximum value."):Cell("query:AddMaximum(" + dq + "GamePrice" + dq + ")")
        TableRow():Cell("databaseObject:Find(Find objectName)"):Cell("This takes a Find query object and builds a query to send to the database. A Find query is used to grab data from the database. When interacting with a database a Find is usually the most common type of query to use."):Cell("database:Find(query)")
        Paragraph("Now, we want to load in the database table we have been working on, "):DoubleQuote():Text("grocerylist"):DoubleQuote():Text(" into the object by passing the string, "):DoubleQuote():Text("grocerylist"):DoubleQuote():Text(" into the SetTable() action. Currently it has connected our database with our object, but we need to add column targets which our Find object will be a container holding our data. We will be wanting to add all our columns into "):DoubleQuote():Text("query"):DoubleQuote():Text(" such as FoodName, FoodID, FoodCalories, FoodQuantity, and FoodCost but we will be using two different actions to add a column. While AddColumn() is our default action to add a column into our object, we also have AddColumnFromTable() that takes in our column name and table name that overall provides more clarity in what table we are grabbing from in the case we will be using joins. We will be discussing more about joins in a later section. Both functions get the job done, therefore it is a matter of preference and context of what we are working on using our database.")
        CodeExample("query:SetTable(" + dq + "grocerylist" + dq + ")
    query:AddColumn(" + dq + "FoodName" + dq + ")
    query:AddColumn(" + dq + "FoodID" + dq + ")
    query:AddColumn(" + dq + "FoodCalories" + dq + ")
    query:AddColumn(" + dq + "FoodQuantity" + dq + ")
    query:AddColumnFromTable(" + dq + "FoodCost" + dq + ", " + dq + "grocerylist" + dq + ")")
        Paragraph("Within our Find object, we have access to more "):DoubleQuote():Text("filtering"):DoubleQuote():Text(" actions that allow us as programmers to make summaries and various conclusions about our data. What this means is that we'll be able to find entries such as the maximum or minimum of a column, count the total number of entries from a whole column, or even calculate the sum of a column. We'll be grabbing some of these central tendencies from our table and work on the actions: AddSum(), AddCount(), and AddMaximum(). Regarding all of these functions, they take a text parameter which would be the column name and find the value we would be looking for; it is important to note that to use these numerical based actions, we must use columns that contain numbers such as integers, decimals, doubles, etc. and they are not mixed or are string-based columns.")
        Paragraph("Using AddSum(), we want to know exactly how many items we bought in our grocerylist, so let us pass in the column "):DoubleQuote():Text("FoodQuantity"):DoubleQuote():Text(" to sum up all the items. Similar to AddSum() we will also be using AddCount(), we want to know how many unique items we bought in our grocerylist, so let's pass in the column "):DoubleQuote():Text("FoodName"):DoubleQuote():Text(" to count all the items inside our data table. Finally, we want to know how much was the most calorie dense item in our grocerylist, so let's pass in the column "):DoubleQuote():Text("FoodCalories"):DoubleQuote():Text(" into our action, AddMaximum(). Now that we are satisfied with our finds let's actually get these results saved using our QueryResult object.")
        Paragraph("First, we will want to create our QueryResult which we can name it "):DoubleQuote():Text("results."):DoubleQuote():Text(" This object can hold our queries from our database similar to how we found data in a single column. We will be calling the Find() using our database object, but instead of inserting a column name as the parameter, we will be passing in our Find object, "):DoubleQuote():Text("query"):DoubleQuote():Text(" which allows us to have more specific query results. We will be saving all of this information into the "):DoubleQuote():Text("results"):DoubleQuote():Text(" object.")
        Paragraph("Our query is loaded onto our object, but now, we want to iterate through the list and output its contents. To do this, we would use a loop as well as our QueryResult actions. In Quorum Studio, loops are controlled by a repeat; we'll we using a repeat-while loop where the syntax is:")
        CodeExample("repeat while CONDITION
// stuff
end")
        Paragraph("In this case, our condition will be results:HasNext() which tests if there is any content left inside our query; it returns true when there are items to be iterated through and false when there is no more content inside our query. Inside our repeat-while loop, we will call result:Next() which actually iterates through the query and then we will output the "):DoubleQuote():Text("FoodID"):DoubleQuote():Text(" column using results:GetText(text columnName) and pass in "):DoubleQuote():Text("FoodID"):DoubleQuote():Text(" as the parameter. We will be continuing to add the rest of the columns using our GetText()/GetIntger() actions with "):DoubleQuote():Text("results."):DoubleQuote():Text(" Note: When outputting our columns, we want to make sure we are using the correct actions: GetText() to output text-based columns and GetInteger() to output any numerical columns.")
        CodeExample(" repeat while results:HasNext()
     results:Next()
     output " + dq + "foodID: " + dq + " + results:GetNumber(" + dq + "FoodID" + dq + ")
     output " + dq + "foodName: " + dq + " + results:GetText(" + dq + "FoodName" + dq + ")
     output " + dq + "foodCost: " + dq + " + results:GetInteger(" + dq + "FoodCost" + dq + ")
     output " + dq + "foodCalories: " + dq + " + results:GetNumber(" + dq + "FoodCalories" + dq + ")
     output " + dq + "foodQuantity: " + dq + " + results:GetNumber(" + dq + "FoodQuantity" + dq + ")
    end")
        Paragraph("Congrats! We finally know how to find data within multiple columns. To view the entire code, it will be displayed below.")
        CodeExample("use Libraries.Data.Database.Database
use Libraries.Data.Database.Find
use Libraries.Data.Database.QueryResult
use Libraries.Data.Database.QueryMetaData

    
    Database database
    database:Connect(" + dq + "localhost" + dq + ", " + dq + "myfirstdatabase" + dq + ", " + dq + "root" + dq + ", " + dq + "password" + dq + ")

    Find query
    query:SetTable(" + dq + "grocerylist" + dq + ")

    query:AddColumn(" + dq + "FoodName" + dq + ")
    query:AddColumn(" + dq + "FoodID" + dq + ")
    query:AddColumn(" + dq + "FoodCalories" + dq + ")
    query:AddColumn(" + dq + "FoodQuantity" + dq + ")
    query:AddColumnFromTable(" + dq + "FoodCost" + dq + ", " + dq + "grocerylist" + dq + ")

    query:AddSum(" + dq + "FoodQuantity" + dq + ")

    query:AddCount(" + dq + "FoodID" + dq + ")

    query:AddMaximum(" + dq + "FoodCalories" + dq + ")

    QueryResult results = database:Find(query)

    repeat while results:HasNext()
     results:Next()
     output " + dq + "foodID: " + dq + " + results:GetNumber(" + dq + "FoodID" + dq + ")
     output " + dq + "foodName: " + dq + " + results:GetText(" + dq + "FoodName" + dq + ")
     output " + dq + "foodCost: " + dq + " + results:GetInteger(" + dq + "FoodCost" + dq + ")
     output " + dq + "foodCalories: " + dq + " + results:GetNumber(" + dq + "FoodCalories" + dq + ")
     output " + dq + "foodQuantity: " + dq + " + results:GetNumber(" + dq + "FoodQuantity" + dq + ")
    end")
    end
end
