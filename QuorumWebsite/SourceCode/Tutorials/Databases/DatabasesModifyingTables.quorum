use Libraries.Web.Page.QuorumPage

/*
    Tutorial: Databases.
    Converted from the old Lesson page by plan 13's generator: the same
    words, now without Tailwind.
*/
class DatabaseModifyingTables is QuorumPage
    // A double quote, for code and words that hold one.
    text dq = ""

    on create
        SetLocation("tutorials/databases/databaseModifyTables.html")
        // The name lists and links use, and the series and track it belongs
        // to: its section and picture.
        SetShortTitle("Modifying a Table")
        SetSectionName("Databases")
        // For search engines and link previews, and what lists of pages say.
        SetDescription("Learn about modifying a database table on Quorum Language.")
        SetSummary("how to modify database tables by alterning columns")
    end

    action Setup
        dq = dq:GetDoubleQuote()
        SetWebPageTitle("Modifying a Table - Quorum Programming Lanugage")
        Title("Tutorial: Databases")
        Paragraph("This tutorial shows us how to modify our table in our database")
        ModifyingTables()
    end

    private action ModifyingTables
        Section("Modifying Tables")
        Paragraph("In a database system, we often break up what we want to store into a series of tables. The reasons are numerous, but largely come down to taking less storage or retrieving data more quickly. An example might be making online purchases. In such a case, one table might have a user's card information and another would have transactions. It would be easier to separate the two because if a user changes credit card information previous purchases would not have to get updated information since it is in its own separate category.")
        Table("Before Updating (Single Table)")
        TableHeader():Cell("User ID"):Cell("Name"):Cell("Card Number"):Cell("Date of Purchase"):Cell("Vendor"):Cell("TransactionID")
        TableRow():Cell("1"):Cell("Steven Universe"):Cell("67891"):Cell("8/24/2022"):Cell("Steam"):Cell("1")
        TableRow():Cell("2"):Cell("Steven Universe"):Cell("67891"):Cell("8/24/2022"):Cell("Uniqlo"):Cell("2")
        TableRow():Cell("3"):Cell("Steven Universe"):Cell("67891"):Cell("8/25/2022"):Cell("Target"):Cell("3")
        Table("After Updating (Single Table)")
        TableHeader():Cell("User ID"):Cell("Name"):Cell("Card Number"):Cell("Date of Purchase"):Cell("Vendor"):Cell("TransactionID")
        TableRow():Cell("1"):Cell("Steven Universe"):Cell("12345"):Cell("8/24/2022"):Cell("Steam"):Cell("1")
        TableRow():Cell("2"):Cell("Steven Universe"):Cell("12345"):Cell("8/24/2022"):Cell("Uniqlo"):Cell("2")
        TableRow():Cell("3"):Cell("Steven Universe"):Cell("12345"):Cell("8/25/2022"):Cell("Target"):Cell("3")
        Table("Before Updating (Multiple Tables)")
        TableHeader():Cell("UserID"):Cell("Name"):Cell("Card Number")
        TableRow():Cell("1"):Cell("Steven Universe"):Cell("67891")
        Table("After Updating (Multiple Tables)")
        TableHeader():Cell("TransactionID"):Cell("Date of Purchase"):Cell("Vendor")
        TableRow():Cell("1"):Cell("8/24/2022"):Cell("Steam")
        TableRow():Cell("2"):Cell("8/24/2022"):Cell("Uniqlo")
        TableRow():Cell("3"):Cell("8/24/2022"):Cell("Target")
        Table("Before Updating (Multiple Tables)")
        TableHeader():Cell("UserID"):Cell("Name"):Cell("Card Number")
        TableRow():Cell("1"):Cell("Steven Universe"):Cell("67891")
        Table("After Updating (Multiple Tables)")
        TableHeader():Cell("TransactionID"):Cell("Date of Purchase"):Cell("Vendor")
        TableRow():Cell("1"):Cell("8/24/2022"):Cell("Steam")
        TableRow():Cell("2"):Cell("8/24/2022"):Cell("Uniqlo")
        TableRow():Cell("3"):Cell("8/24/2022"):Cell("Target")
        Paragraph("As shown by our tables, if we have multiple tables, we can spend less time trying to update a larger table. We can have simple tables and update a smaller one which gives less overhead.")
        Paragraph("Say that we have created a new table, but we accidentally forgot to add a column or may have made a typo in our table name. Instead of deleting that table and creating a new one, we can modify the table. To do this, we would create a new object called EditTable, that allows us to use helper actions to edit the existing table inside of our database.")
        Paragraph("With our EditTable object, we are now able to change the name of our table, remove columns, edit column data types, filter our data, and "):Link("many more other actions to use", "https://quorumlanguage.com/Libraries/Data/Database/EditTable.html#AlterAutoIncrement:integer"):Text("For this example, we are going to create another empty table, which we can do in a separate file or use SQL commands in order to modify our table using Quorum actions. Below is some sample code on creating an empty table and it is important that this table exists before using the EditTable object.")
        CodeExample(" CreateTable newTable
    newTable:SetTable(" + dq + "newtable" + dq + ")
    newTable:AddIntegerColumn(" + dq + "tableID" + dq + ")
    newTable:AddIntegerColumn(" + dq + "tableText" + dq + ")
    newTable:AddIntegerColumn(" + dq + "tableText2" + dq + ")
    database:CreateTable(newTable)")
        Paragraph("We will be learning how to edit the name of our table, change a column's data type, remove a column, and establish an autoincrement on our table. A note on auto increment is that typically when adding new queries, we would have to manually log in the ID. However, if we edit our table, we can increment a value automatically.")
        Paragraph("To have access to these actions, we will need to create the EditTable object, which we can name 'edit.'")
        CodeExample("use Libraries.Data.Database.Database
    use Libraries.Data.Database.EditTable
    use Libraries.Data.Database.CreateTable

    Database database
    database:Connect(" + dq + "localhost" + dq + ", " + dq + "myfirstdatabase" + dq + ", " + dq + "root" + dq + ", " + dq + "coolPasseword" + dq + ")

    EditTable edit")
        Paragraph("Using edit we will be using the actions: SetTable(text tableName), AlterAutoIncrement(int newStart), renameTable(text newName), ModifyColumn(text columnName, text dataType), AddColumn(text columnName, text dataType), DropColumn(text columnName), and EditTable(EditTable objectName).")
        Table("EditTable Actions")
        TableHeader():Cell("Action / Object"):Cell("Structure"):Cell("Functionality")
        TableRow():Cell("EditTable query"):Cell("The EditTable query represents the ALTER TABLE command of the SQL (Structured Query Language) language. This query allows for table manipulations by adding, dropping, or modifying columns."):Cell("EditTable edit")
        TableRow():Cell("AddColumn(text column, text dataType)"):Cell("Adds objects that have been remapped to a single table for reference in actions called when building the query to text."):Cell("edit:AddColumn(" + dq + "newColumn" + dq + "," + dq + "integer" + dq + ")")
        TableRow():Cell("AlterAutoIncrement(integer newStart)"):Cell("This action allows the auto increment value to be changed."):Cell("edit:AlterAutoIncrement(1)")
        TableRow():Cell("DropColumn(text column)"):Cell("This action drops a column from a table."):Cell("edit:DropColumn(" + dq + "tableText2" + dq + ")")
        TableRow():Cell("RenameTable(text newName)"):Cell("This action renames a table in the database."):Cell("edit:RenameTable(" + dq + "superNewTable" + dq + ")")
        TableRow():Cell("SetTable(text table)"):Cell("This action sets the table of the query."):Cell("edit:SetTable(" + dq + "newtable" + dq + ")")
        TableRow():Cell("ModifyColumn(text column, text dataType)"):Cell("This action allows the type of a column to be changed."):Cell("edit:ModifyColumn(" + dq + "tableText" + dq + "," + dq + "string" + dq + ")")
        TableRow():Cell("databaseObject:EditTable(EditTable object)"):Cell("This action allows the modified changed to be committed and reflected upon the database."):Cell("database:EditTable(edit)")
        Paragraph("With our object created, let's first get the table we are modifying using SetTable() and let's pass in "):DoubleQuote():Text("newTable"):DoubleQuote():Text(" which is the table object we previously made. Because we do not want to manually change the IDs of each entry, lets also use AlterAutoIncrement and pass in the value of 1 so it automatically starts to change the IDs as soon as we start adding entries. Next, the current name "):DoubleQuote():Text("newtable"):DoubleQuote():Text(" does not seem that descriptive in terms of the changes we have reflected so far, so now we will want to change the table name using RenameTable(); let's rename our table "):DoubleQuote():Text("supernewtable"):DoubleQuote():Text(" and pass that string as the parameter to RenameTable.")
        Paragraph("edit:SetTable("):DoubleQuote():Text("newtable"):DoubleQuote():Text(") edit:AlterAutoIncrement(1) edit:RenameTable("):DoubleQuote():Text("superNewTable"):DoubleQuote():Text(")")
        Paragraph("Next, suppose we want to edit the columns of this "):DoubleQuote():Text("supernewtable"):DoubleQuote():Text(" such as modifying an existing column, removing a column, and adding a new column. To modify a column, we will be using ModifyColumn and pass in two parameters, the column name and the new data type we can convert this column to accept. For this, let's pass in the value "):DoubleQuote():Text("tableText"):DoubleQuote():Text(" as the first parameter and "):DoubleQuote():Text("string"):DoubleQuote():Text(" as the second parameter.")
        Paragraph("Originally "):DoubleQuote():Text("tableText"):DoubleQuote():Text(" was an integer column but it is now a text column. Additional actions we can take on "):DoubleQuote():Text("newtable"):DoubleQuote():Text(" would lead us to know how to modify an existing column, remove a column, and add a new column. To add a column, we will be using the AddColumn(columnName, datatype) and pass in two parameters, the column name and the data type. For this let's pass in the value "):DoubleQuote():Text("newColumn"):DoubleQuote():Text(" as the first parameter and "):DoubleQuote():Text("integer"):DoubleQuote():Text(" as the second parameter.")
        CodeExample("edit:ModifyColumn(" + dq + "tableText" + dq + "," + dq + "string" + dq + ")
 edit:AddColumn(" + dq + "newColumn" + dq + "," + dq + "integer" + dq + ")
 edit:DropColumn(" + dq + "tableText2" + dq + ")")
        Paragraph("To reflect our modifications, we will need to call our database object and pass in the EditTable object using the EditTable() action.")
        CodeExample("database:EditTable(edit)")
        Paragraph("Below is the full code of altering a table in our database.")
        CodeExample("/* equivalent to alter table*/
/* changing table labels */
/* changing the datatypes */

    use Libraries.Data.Database.Database
    use Libraries.Data.Database.EditTable
    use Libraries.Data.Database.CreateTable

    Database database
    database:Connect(" + dq + "localhost" + dq + ", " + dq + "myfirstdatabase" + dq + ", " + dq + "root" + dq + ", " + dq + "password" + dq + ")

    EditTable edit
    edit:SetTable(" + dq + "newtable" + dq + ")
    edit:AlterAutoIncrement(1)
    edit:RenameTable(" + dq + "superNewTable" + dq + ")
    edit:ModifyColumn(" + dq + "tableText" + dq + "," + dq + "string" + dq + ")
    edit:AddColumn(" + dq + "newColumn" + dq + "," + dq + "integer" + dq + ")
    edit:DropColumn(" + dq + "tableText2" + dq + ")
    database:EditTable(edit)")
    end
end
