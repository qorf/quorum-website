use Libraries.Web.Page.QuorumPage

/*
    Tutorial: Databases.
    Converted from the old Lesson page by plan 13's generator: the same
    words, now without Tailwind.
*/
class DatabasesJoins is QuorumPage
    // A double quote, for code and words that hold one.
    text dq = ""

    on create
        SetLocation("tutorials/databases/introToJoins.html")
        // The name lists and links use, and the series and track it belongs
        // to: its section and picture.
        SetShortTitle("Introduction to Joins")
        SetSectionName("Databases")
        // For search engines and link previews, and what lists of pages say.
        SetDescription("Learn about database JOINS on Quorum Language.")
        SetSummary("understanding JOINS in a database and the different typess of joins")
    end

    action Setup
        dq = dq:GetDoubleQuote()
        SetWebPageTitle("Introduction to Joins - Quorum Programming Lanugage")
        Title("Tutorial: Databases")
        Paragraph("This tutorial introduces the concept of joins in a database")
        WhatAreJoins()
        TypesOfJoins()
        TableOfJoinsInQuorum()
    end

    private action WhatAreJoins
        Section("What are Joins?")
        Paragraph("Throughout our tutorials, we have briefly mentioned the concept of Joins but have never gone too in-depth on this topic. Joins may be one of the more difficult topics in databases, but they are nonetheless helpful with finding relationships between our database tables. In SQL, a JOIN clause simply combines rows from two or more tables, based on a related column between them. We can do the same thing using Quorum.")
        Paragraph("Let us introduce the concept of joins with two example tables: TicketOrders and Customer.")
        Table("Ticket Transactions")
        TableHeader():Cell("TickOrderID"):Cell("CustomerID"):Cell("TicketQuantity"):Cell("TicketOrderDate")
        TableRow():Cell("8086"):Cell("24"):Cell("4"):Cell("2022-09-17")
        TableRow():Cell("8087"):Cell("25"):Cell("1"):Cell("2022-09-20")
        TableRow():Cell("8088"):Cell("26"):Cell("2"):Cell("2022-09-22")
        TableRow():Cell("8089"):Cell("27"):Cell("7"):Cell("2022-09-22")
        Table("Customer Information")
        TableHeader():Cell("CustomerID"):Cell("CustomerName"):Cell("ContactName"):Cell("Country")
        TableRow():Cell("22"):Cell("Harry Styles"):Cell("Olivia Wilde"):Cell("UK")
        TableRow():Cell("23"):Cell("Taylor Swift"):Cell("Jake Gyllenhaal"):Cell("US")
        TableRow():Cell("24"):Cell("Kanye West"):Cell("Kim Kardashian"):Cell("US")
        TableRow():Cell("25"):Cell("Justin Bieber"):Cell("Selena Gomez"):Cell("CA")
        Paragraph("We notice that these two tables have a relational column, "):DoubleQuote():Text("CustomerID."):DoubleQuote():Text(" Inside of TicketOrders, the "):DoubleQuote():Text("CustomerID"):DoubleQuote():Text(" refers to the "):DoubleQuote():Text("CustomerID"):DoubleQuote():Text(" inside of Customers. This type of join is considered an inner join and we can actually combine these two tables together using "):DoubleQuote():Text("CustomerID"):DoubleQuote():Text(" as our joining factor. Now, let us say we do combine these two tables with OrderID, CustomerName, and TicketQuantity our table would look like this table below:")
        Table("Joined Table of Ticket Transactions and Customer Info")
        TableHeader():Cell("OrderID"):Cell("CustomerName"):Cell("TicketQuantity")
        TableRow():Cell("8084"):Cell("Harry Styles"):Cell("2")
        TableRow():Cell("8085"):Cell("Taylor Swift"):Cell("3")
        TableRow():Cell("8086"):Cell("Kanye West"):Cell("4")
        TableRow():Cell("8087"):Cell("Justin Bieber"):Cell("1")
    end

    private action TypesOfJoins
        Section("Types of Joins")
        Paragraph("As our main example went over the concept of an inner join, there are a total of five types of joins: INNER, LEFT, RIGHT, FULL, and CROSS JOINS. We will describe all these joins along with its equivalent action using Quorum language using a table below [1].")
        Table("Types of Joins")
        TableHeader():Cell("Type pf Join"):Cell("Join Description")
        TableRow():Cell("Inner Join"):Cell("The INNER JOIN keyword selects all rows from both the tables as long as the condition is satisfied. This keyword will create the result-set by combining all rows from both the tables where the condition satisfies i.e value of the common field will be the same.")
        TableRow():Cell("Left Join"):Cell("This join returns all the rows of the table on the left side of the join and matches rows for the table on the right side of the join. For the rows for which there is no matching row on the right side, the result-set will contain null. LEFT JOIN is also known as LEFT OUTER JOIN.")
        TableRow():Cell("Right Join"):Cell("RIGHT JOIN is similar to LEFT JOIN. This join returns all the rows of the table on the right side of the join and matching rows for the table on the left side of the join. For the rows for which there is no matching row on the left side, the result-set will contain null. RIGHT JOIN is also known as RIGHT OUTER JOIN.")
        TableRow():Cell("Cross Join"):Cell("The SQL CROSS JOIN produces a result set which is the number of rows in the first table multiplied by the number of rows in the second table if no WHERE clause is used along with CROSS JOIN.This kind of result is called as Cartesian Product.")
        TableRow():Cell("Full Join"):Cell("FULL JOIN creates the result-set by combining results of both LEFT JOIN and RIGHT JOIN. The result-set will contain all the rows from both tables. For the rows for which there is no matching, the result-set will contain NULL values.")
    end

    private action TableOfJoinsInQuorum
        Section("Table of Joins in Quorum")
        Paragraph("At the moment, Quorum Studio supports 4 out of the 5 types of joins. This table shows variants of the joins including the default joins as well as using a filter with a join. To find more variants of the Inner, Left, Right, and Cross joins we can "):Link("reference the main Database library", "https://quorumlanguage.com/Libraries/Data/Database/Database.html#EmptyTable:text"):Text(". All joins in Quorum will return a "):Link("QueryResult object", "https://quorumlanguage.com/Libraries/Data/Database/QueryResult.html"):Text(" which will be our combined table.")
        Table("Joins in Quorum")
        TableHeader():Cell("Action"):Cell("Description"):Cell("Usage")
        TableRow():Cell("databaseObject:FindInnerJoin(text tableName, text joinedTable, text joinCondition)"):Cell("This action runs a Find query using a join. A Find query with a join will check the rows of multiple tables and the type of join determines what columns will appear in the final result set. An Inner Join compares every row from the first table to every row on the second table. If the values from the rows satisfy the condition then a new row is added containing the combined columns from both tables."):Cell("QueryResult result = database:FindInnerJoin(" + dq + "Orders" + dq + ", " + dq + "Customers" + dq + ", " + dq + "Orders:CustomerID = Customers:CustomerID" + dq + ")")
        TableRow():Cell("databaseObject:FindInnerJoin(text tableName, text joinedTable, text joinCondition, text filter)"):Cell("This action runs a Find query using a join. A Find query with a join will check the rows of multiple tables and the type of join determines what columns will appear in the final result set. An Inner Join compares every row from the first table to every row on the second table. If the values from the rows satisfy the condition then a new row is added containing the combined columns from both tables. This inner join also uses a filter to narrow down results for the new table."):Cell("QueryResult result = database:FindInnerJoin(" + dq + "Orders" + dq + ", " + dq + "Customers" + dq + ", " + dq + "Orders:CustomerID = Customers:CustomerID" + dq + ", " + dq + "OrderNumber = 55" + dq + ")")
        TableRow():Cell("databaseObject:FindCrossJoin(text tableName, text joinedTable)"):Cell("This action runs a Find query using a join. A Find query with a join will check the rows of multiple tables and the type of join determines what columns will appear in the final result set. A Cross Join is different from the other joins in that there is no join condition. A Cross Join will return the Cartesian product of rows from the two tables. In other words, every row from the first table will be combined with every row from the second table and that will be returned."):Cell("QueryResult result = database:FindCrossJoin(" + dq + "Products" + dq + ", " + dq + "Stores" + dq + ")")
        TableRow():Cell("databaseObject:FindCrossJoin(text tableName, text joinedTable, text filter)"):Cell("This action runs a Find query using a join. A Find query with a join will check the rows of multiple tables and the type of join determines what columns will appear in the final result set. A Cross Join is different from the other joins in that there is no join condition. A Cross Join will return the Cartesian product of rows from the two tables. In other words, every row from the first table will be combined with every row from the second table and that will be returned. This cross join also uses a filter to narrow down results for the new table."):Cell("QueryResult result = database:FindCrossJoin(" + dq + "Products" + dq + ", " + dq + "Stores" + dq + ", " + dq + "price >= 4.99" + dq + ")")
        TableRow():Cell("databaseObject:FindLeftJoin(text tableName, text joinedTable, text joinCondition)"):Cell("This action runs a Find query using a join. A Find query with a join will check the rows of multiple tables and the type of join determines what columns will appear in the final result set. A Left Join compares every row from the first table to every row on the second table. If the values from the rows satisfy the condition then a new row is added containing the combined columns from both tables. But if the condition fails then a new row is still added containing all the rows from the first table."):Cell("QueryResult result = database:FindLeftJoin(" + dq + "Orders" + dq + ", " + dq + "Customers" + dq + ", " + dq + "Orders:CustomerID = Customers:CustomerID" + dq + ")")
        TableRow():Cell("databaseObject:FindLeftJoin(text tableName, text joinedTable, text joinCondition, text filter)"):Cell("This action runs a Find query using a join. A Find query with a join will check the rows of multiple tables and the type of join determines what columns will appear in the final result set. A Left Join compares every row from the first table to every row on the second table. If the values from the rows satisfy the condition then a new row is added containing the combined columns from both tables. But if the condition fails then a new row is still added containing all the rows from the first table. This left join also uses a filter to narrow down results for the new table."):Cell("QueryResult result = database:FindLeftJoin(" + dq + "Orders" + dq + ", " + dq + "Customers" + dq + ", " + dq + "Orders:CustomerID = Customers:CustomerID" + dq + ", " + dq + "OrderNumber = 55" + dq + ")")
        TableRow():Cell("databaseObject:FindRightJoin(text tableName, text joinedTable, text joinCondition)"):Cell("This action runs a Find query using a join. A Find query with a join will check the rows of multiple tables and the type of join determines what columns will appear in the final result set. A Right Join compares every row from the first table to every row on the second table. If the values from the rows satisfy the condition then a new row is added containing the combined columns from both tables. But if the condition fails then a new row is still added containing all the rows from the second table."):Cell("QueryResult result = database:FindRightJoin(" + dq + "Orders" + dq + ", " + dq + "Customers" + dq + ", " + dq + "Orders:CustomerID = Customers:CustomerID" + dq + ")")
        TableRow():Cell("databaseObject:FindRightJoin(text tableName, text joinedTable, text joinCondition, text filter)"):Cell("This action runs a Find query using a join. A Find query with a join will check the rows of multiple tables and the type of join determines what columns will appear in the final result set. A Right Join compares every row from the first table to every row on the second table. If the values from the rows satisfy the condition then a new row is added containing the combined columns from both tables. But if the condition fails then a new row is still added containing all the rows from the second table. This right join also uses a filter to narrow down results for the new table."):Cell("QueryResult result = database:FindRightJoin(" + dq + "Orders" + dq + ", " + dq + "Customers" + dq + ", " + dq + "Orders:CustomerID = Customers:CustomerID" + dq + ", " + dq + "OrderNumber = 55" + dq + ")")
        Paragraph():Strong("References:")
        Paragraph("[1]: Geeks4Geeks, SQL / Join (Inner, Left, Right and Full Joins) "):Link("https://www.geeksforgeeks.org/sql-join-set-1-inner-left-right-and-full-joins/", "https://www.geeksforgeeks.org/sql-join-set-1-inner-left-right-and-full-joins/ "):Text(" "):Text(".")
    end
end
