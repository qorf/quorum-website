use Libraries.Web.Page.QuorumPage

/*
    Tutorial: Connecting Databases with Quorum.
    Converted from the old Lesson page by plan 13's generator: the same
    words, now without Tailwind.
*/
class ConnectDatabaseQuorum is QuorumPage
    // A double quote, for code and words that hold one.
    text dq = ""

    on create
        SetLocation("tutorials/databases/connectdatabase.html")
        // The name lists and links use, and the series and track it belongs
        // to: its section and picture.
        SetShortTitle("Connecting Our Database")
        SetSectionName("Databases")
        // For search engines and link previews, and what lists of pages say.
        SetDescription("Learn about connecting our database to Quorum.")
        SetSummary("how to connect a database inside of quorum studio")
    end

    action Setup
        dq = dq:GetDoubleQuote()
        SetWebPageTitle("Connecting Databases with Quorum - Quorum Programming Language")
        Title("Tutorial: Connecting Databases with Quorum")
        Paragraph("This tutorial shows us how to connect our database inside of Quorum Studio")
        ConnectingOurDatabaseWithQuorum()
    end

    private action ConnectingOurDatabaseWithQuorum
        Section("Connecting Our Database with Quorum")
        Paragraph("So far, using the MySQL command line, we have successfully created a database inside our database. We can finally start to connect the database we have created inside of Quorum Studio! Note that for these series of tutorials, we will need to work externally using MySQL and Quorum Studio. Online IDEs currently do not support a database feature. We need to make sure that we have both software running for the connection to work.")
        Paragraph("Now, we will be referencing the Database library and using the Connect(text location, text database, text username, text password) action in order for Quorum to find our database in our system. Using databases is an advanced topic in computer science, typically taught at the junior or senior level in an undergraduate college sequence. As such, keep in mind that for those just starting programming, we recommend starting with the programming tutorials, not this one, to get started.")
        Paragraph("To be able to use this function, we would need to create a database object. Similar to many objects, we initiate it like a variable where we have our object name. For this tutorial, let us call our database object database. The code then looks like so:")
        CodeExample("use Libraries.Data.Database.Database

Database database")
        Paragraph("Below we have a table of how the actions and objects we use to connect our database.")
        Table("Connection Actions")
        TableHeader():Cell("Action / Object"):Cell("Description"):Cell("Usage")
        TableRow():Cell("Database databaseName"):Cell("The database object used to create and modify our database"):Cell("Database database")
        TableRow():Cell("Connect(text location, text database, text username, text password)"):Cell("This action attempts to create a connection to a database using the given parameters. The following are what each parameter is required: text location: The location of the database. A common location is " + dq + "localhost." + dq + " text database: The name of the database text username: The name of the user text password: The password for the user"):Cell("databaseName:Connect(" + dq + "localhost" + dq + ", " + dq + "myDatabase" + dq + "," + dq + "root" + dq + "," + dq + "awesomePassword1234" + dq + ")")
        Paragraph("Now that we have our database object created, we can use the Connect action to login to our database. For this step, parameters may differ on user and password name, but we should have the same database name, myfirstdatabase and location, localhost.")
        CodeExample("database:Connect(" + dq + "localhost" + dq + ", " + dq + "myfirstdatabase" + dq + ", " + dq + "root" + dq + ", " + dq + "CoolPassword1234" + dq + ")")
        Paragraph("If we want to confirm that our database is connected, we can confirm calling the action IsConnected() with our object which will return true if it is connected. Below is the full code of connecting our database.")
        CodeExample("use Libraries.Data.Database.Database

Database database
database:Connect(" + dq + "localhost" + dq + ", " + dq + "myfirstdatabase" + dq + ", " + dq + "root" + dq + ", " + dq + "CoolPassword1234" + dq + ")

output database:IsConnected()")
    end
end
