use Libraries.Web.Page.QuorumPage

/*
    Tutorial: Databases.
    Converted from the old Lesson page by plan 13's generator: the same
    words, now without Tailwind.
*/
class DatabasesViews is QuorumPage
    // A double quote, for code and words that hold one.
    text dq = ""

    on create
        SetLocation("tutorials/databases/Views.html")
        // The name lists and links use, and the series and track it belongs
        // to: its section and picture.
        SetShortTitle("Views")
        SetSectionName("Databases")
        // For search engines and link previews, and what lists of pages say.
        SetDescription("Learn about views through database tables on Quorum Language.")
        SetSummary("how to create a view from a database table")
    end

    action Setup
        dq = dq:GetDoubleQuote()
        SetWebPageTitle("Creating a View - Quorum Programming Lanugage")
        Title("Tutorial: Databases")
        Paragraph("This tutorial introduces views and how to create them with a database table")
        IntroductionToViews()
    end

    private action IntroductionToViews
        Section("Introduction to Views")
        Paragraph("In SQL and in Quorum, views are virtual tables. What this means is that it also contains rows and columns like a real table, but we get to choose the specific rows of certain tables to be in a view. The purpose of using a view versus using the entire table is to provide simplicity to the user. Data tables can get very extensive so fast, therefore if we want to only examine a section of a table, we can simply create a view.")
        Paragraph("For this tutorial, we will be learning how to create a view on our "):DoubleQuote():Text("likes"):DoubleQuote():Text(" table. We will want to connect our database once again as well as create a Find object and a CreateView object. For our Find object, we can reference this tutorial on how we can Find data. Our CreateView object is something completely new where we can use "):Link("helper actions", "https://quorumlanguage.com/Libraries/Data/Database/CreateView.html"):Text(" to create our view. Let's go ahead and name our Find and CreateView objects simply "):DoubleQuote():Text("find"):DoubleQuote():Text(" and "):DoubleQuote():Text("view."):DoubleQuote()
        Paragraph("We will be connecting our table using our Find object first. To get our "):DoubleQuote():Text("likes"):DoubleQuote():Text(" table, we will be using the action SetTable(text tableName) and insert "):DoubleQuote():Text("likes"):DoubleQuote():Text(" as our parameter. Next, we will be adding our column tables so that our Find object can hold them like a container using the action AddColumn(text columnName). We will add our two columns, "):DoubleQuote():Text("id"):DoubleQuote():Text(" and "):DoubleQuote():Text("likes"):DoubleQuote():Text(" since our table is fairly small.")
        CodeExample("Find find
    find:SetTable(" + dq + "likes" + dq + ")
    find:AddColumn(" + dq + "id" + dq + ")
    find:AddColumn(" + dq + "likes" + dq + ")")
        Paragraph("Now that we have a container that holds our table, we can create a view. We will be using two actions from the CreateView object: SetQuery(Find objectName) and SetName(text viewName) that allows us to make a view from our Find object. With our CreateView object, to send it back to the database, we will also be using the action CreateView(CreateView objectName).")
        Table("Views Helper Actions")
        TableHeader():Cell("Object / Action"):Cell("Description"):Cell("Usage")
        TableRow():Cell("CreateView objectName"):Cell("The CreateView class is a query that allows creating a table that lives on the database composed of the results of a Find query. Once the view is created it can be accessed as if it was another database table. Although you can not insert, update, or delete from a view."):Cell("CreateView view")
        TableRow():Cell("viewObjectName:SetQuery(Find findObject)"):Cell("This action is used to set the Find query of the view."):Cell("view:SetQuery(find)")
        TableRow():Cell("viewObject:SetName(text viewTableName)"):Cell("This action is used to set the name of the view."):Cell("view:SetName(" + dq + "grocery_view" + dq + ")")
        TableRow():Cell("databaseObject:CreateView(CreateView objectName)"):Cell("This action takes a CreateView query and sends it to the database."):Cell("database:CreateView(view)")
        Paragraph("Using the action, SetQuery() on our "):DoubleQuote():Text("view"):DoubleQuote():Text(" object, we will pass in the Find object that contains our table. Now, our "):DoubleQuote():Text("view"):DoubleQuote():Text(" is created, but like any table, we must name it which we can do using SetName(). Let's go ahead and name our table "):DoubleQuote():Text("likes_query"):DoubleQuote():Text(" With our view all set up, we will go back to our database object and use the action CreateView() that will send back our table into the database. This action will take in the "):DoubleQuote():Text("view"):DoubleQuote():Text(" object we have just set up.")
        CodeExample("view:SetQuery(find)
    view:SetName(" + dq + "likes_query" + dq + ")
     database:CreateView(view)")
        Paragraph("Congratulations! We are able to create a view from any table within our database. The entire program can be viewed below:")
        CodeExample("use Libraries.Data.Database.Database
    use Libraries.Data.Database.Find
use Libraries.Data.Database.CreateView

    Database database
    database:Connect(" + dq + "localhost" + dq + ", " + dq + "myfirstdatabase" + dq + ", " + dq + "root" + dq + ", " + dq + "password" + dq + ")

    Find find
    find:SetTable(" + dq + "likes" + dq + ")
    find:AddColumn(" + dq + "id" + dq + ")
    find:AddColumn(" + dq + "likes" + dq + ")

    CreateView view
    view:SetQuery(find)
    view:SetName(" + dq + "likes_query" + dq + ")

    database:CreateView(view)")
    end
end
