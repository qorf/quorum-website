  insert:Empty()
  insert:Add(" + dq + "id" + dq + ", 2)
  insert:Add(" + dq + "customerName" + dq + ", " + dq + "tony stark" + dq + ")
  // will only insert 1 query at a time
  database:Insert(insert)
  rowsAffected = rowsAffected + 1
  output insert:ToText()

  insert:Empty()
   insert:Add(" + dq + "id" + dq + ", 3)
  insert:Add(" + dq + "customerName" + dq + ", " + dq + "joe goldberg" + dq + ")
  // will only insert 1 query at a time
  database:Insert(insert)
  rowsAffected = rowsAffected + 1
  output insert:ToText()

  insert:Empty()
  insert:Add(" + dq + "id" + dq + ", 4)
  insert:Add(" + dq + "customerName" + dq + ", " + dq + "barack obama" + dq + ")
  // will only insert 1 query at a time
  database:Insert(insert)
  rowsAffected = rowsAffected + 1
