  insert:Empty()
   insert:Add(" + dq + "id" + dq + ", 7)
  insert:Add(" + dq + "customerName" + dq + ", " + dq + "taylor swift" + dq + ")
  // will only insert 1 query at a time
  database:Insert(insert)
  rowsAffected = rowsAffected + 1
  output insert:ToText()

   insert:Empty()
  insert:Add(" + dq + "id" + dq + ", 8)
  insert:Add(" + dq + "customerName" + dq + ", " + dq + "kanye west" + dq + ")
  // will only insert 1 query at a time
