use Libraries.Web.Page.QuorumPage

/*
    Tutorial: Databases.
    Converted from the old Lesson page by plan 13's generator: the same
    words, now without Tailwind.
*/
class DatabasesLeftRightJoins is QuorumPage
    // A double quote, for code and words that hold one.
    text dq = ""

    on create
        SetLocation("tutorials/databases/LRJoins.html")
        // The name lists and links use, and the series and track it belongs
        // to: its section and picture.
        SetShortTitle("Left and Right Joins")
        SetSectionName("Databases")
        // For search engines and link previews, and what lists of pages say.
        SetDescription("Learn about left and right joins on a database table on Quorum Language.")
        SetSummary("how to create a left and right join on a database table")
    end

    action Setup
        dq = dq:GetDoubleQuote()
        SetWebPageTitle("Left and Right Joins - Quorum Programming Lanugage")
        Title("Tutorial: Databases")
        Paragraph("This tutorial shows us how to create a left and right join")
        LeftAndRightJoins()
        LeftJoin()
        RightJoin()
    end

    private action LeftAndRightJoins
        Section("Left and Right Joins")
        Paragraph("Left joins returns all records from the left table (table1), and the matching records from the right table (table2). Likewise, right join returns all records from the right table (table2), and the matching records from the left table (table1). From both joins if there are 0 records from the left side or right side (depending on what join we take), there is no match.")
        Paragraph("For example, say we have entries for ID's on one table labeled 1-6 and then another table for ID entries 4-10; the entries for 7-10, will not actually have a match if we call for a right join. What it will do is output all matching data with rows 4, 5, and 6 but within rows 7-10, we may see some NULL values because they did not exist in our first table.")
        Paragraph("In this tutorial we will be finding a left and right join between two tables. We are also creating and inserting data from scratch. In this tutorial, there will be a total of 5 separate programs that all lead into creating our two types of joins: creating our tables, adding data into table 1, adding data into table 2, and creating the left and right join. "):Link("For the table creation, we will be referencing methods on a tutorial on how to create database tables.", "/tutorials/databases/databaseTable.html"):Text(" "):Link("For the data insertion, we will be referring to methods on a tutorial on how to insert data.", "/tutorials/databases/insertingDataDatabases.html"):Text(" Regardless, for each tutorial, we will want to connect our Database into Quorum Studio before we proceed into any work. In the first part of this tutorial we will be creating our tables.")
        Paragraph("We will be wanting to create two tables: one table called "):DoubleQuote():Text("likes"):DoubleQuote():Text(" and the other table called "):DoubleQuote():Text("users"):DoubleQuote():Text(" and we will follow a very similar pattern to "):Link("this website that visualizes left and right joins", "https://joins.spathon.com"):Text(". We will first be creating two CreateTable objects: newTable and newTable1. We will first start to build our first table, "):DoubleQuote():Text("likes"):DoubleQuote():Text(" using the actions SetTable(text table name), AddIntegerColum(text columnName), and AddTextColumn(text columnName, int charLimit). The columns and the data types will be as follows:")
        Table("Data Types of Likes Tables")
        TableHeader():Cell("ID"):Cell("Likes")
        TableRow():Cell("Data Type: integer"):Cell("Data Type: text / string")
        Paragraph("Once we have created all our columns, we will now want to pass in our newTable object into an action called CreateTable(CreateTable objectName) using our database object.")
        CodeExample("// create first table
    CreateTable newTable
    newTable:SetTable(" + dq + "likes" + dq + ")
    newTable:AddIntegerColumn(" + dq + "id" + dq + ")
    newTable:AddTextColumn(" + dq + "likes" + dq + ",500)
    database:CreateTable(newTable)   ")
        Paragraph("We will want to follow this same process for the other table, "):DoubleQuote():Text("users"):DoubleQuote():Text(" where the columns and data types will be as follows:")
        Table("Data Types of User Tables")
        TableHeader():Cell("ID"):Cell("CustomerName")
        TableRow():Cell("Data Type: integer"):Cell("Data Type: text / string")
        Paragraph("The full code will be below:")
        CodeExample("use Libraries.Data.Database.Database
    use Libraries.Data.Database.CreateTable

    Database database
    database:Connect(" + dq + "localhost" + dq + ", " + dq + "myfirstdatabase" + dq + ", " + dq + "root" + dq + ", " + dq + "password" + dq + ")

    // create first table
    CreateTable newTable
    newTable:SetTable(" + dq + "likes" + dq + ")
    newTable:AddIntegerColumn(" + dq + "id" + dq + ")
    newTable:AddTextColumn(" + dq + "likes" + dq + ",500)
    database:CreateTable(newTable)

    CreateTable newTable1
    newTable1:SetTable(" + dq + "users" + dq + ")
    newTable1:AddIntegerColumn(" + dq + "id" + dq + ")
    newTable1:AddTextColumn(" + dq + "customerName" + dq + ",500)
    database:CreateTable(newTable1)")
        Paragraph("Next, we will want to enter data inside our tables. We will have two separate programs to insert data into our "):DoubleQuote():Text("likes"):DoubleQuote():Text(" table and then our "):DoubleQuote():Text("users"):DoubleQuote():Text(" table. Let us go ahead and define our Insert object named "):DoubleQuote():Text("insert."):DoubleQuote():Text(" We will be using this object to access the actions SetTable(), ToText(), Empty() and Add().")
        Paragraph("To insert data, we will need to make sure we select our table using SetTable(text tableName); do this with "):DoubleQuote():Text("users"):DoubleQuote():Text(" first and insert this string as our parameter. Then we will want to use the action Add(text columnName, dataType dataValue) with our insert object to enter in appropriate data on the columns. Recall that our columns are: id and customerName. For example, say that we want to add an entry for "):DoubleQuote():Text("likes,"):DoubleQuote():Text(" we will need to call the action Add() with our Insert object and insert "):DoubleQuote():Text("likes"):DoubleQuote():Text(" in the first parameter and an activity or object people enjoy. Below is a code snippet of adding one complete row onto our table:")
        CodeExample("// add first entry
  insert:Add(" + dq + "id" + dq + ", 1)
  insert:Add(" + dq + "likes" + dq + ", " + dq + "ducks" + dq + ")
  // will only insert 1 query at a time
  database:Insert(insert)
  rowsAffected = rowsAffected + 1
  output insert:ToText()")
        Paragraph("It is important that once we add one record, we must immediately call the action Empty() which will clear out our object so we can add multiple records inside of one program. Optionally, to confirm our insert, we can also call the action ToText() that outputs the SQL notation of insertion. Now that we know how to insert a row, we can populate the table for "):DoubleQuote():Text("likes"):DoubleQuote():Text(" as well as "):DoubleQuote():Text("users."):DoubleQuote():Text(" Below are the two sets of code for inserting both tables, likes and users.")
        CodeExample("use Libraries.Data.Database.Database
use Libraries.Data.Database.Insert

Database database
database:Connect(" + dq + "localhost" + dq + ", " + dq + "myfirstdatabase" + dq + ", " + dq + "root" + dq + ", " + dq + "password" + dq + ")

  Insert insert
  insert:SetTable(" + dq + "likes" + dq + ")
  // keep a running sum on how many rows we add 
  integer rowsAffected = 0
   
  // add first entry
  insert:Add(" + dq + "id" + dq + ", 1)
  insert:Add(" + dq + "likes" + dq + ", " + dq + "ducks" + dq + ")
  // will only insert 1 query at a time
  database:Insert(insert)
  rowsAffected = rowsAffected + 1
  output insert:ToText()

  insert:Empty()
  insert:Add(" + dq + "id" + dq + ", 2)
  insert:Add(" + dq + "likes" + dq + ", " + dq + "computers" + dq + ")
  // will only insert 1 query at a time
  database:Insert(insert)
  rowsAffected = rowsAffected + 1
  output insert:ToText()

  insert:Empty()
  insert:Add(" + dq + "id" + dq + ", 3)
  insert:Add(" + dq + "likes" + dq + ", " + dq + "anime" + dq + ")
  // will only insert 1 query at a time
  database:Insert(insert)
  rowsAffected = rowsAffected + 1
  output insert:ToText()

  insert:Empty()
  insert:Add(" + dq + "id" + dq + ", 4)
  insert:Add(" + dq + "likes" + dq + ", " + dq + "butter" + dq + ")
  // will only insert 1 query at a time
  database:Insert(insert)
  rowsAffected = rowsAffected + 1
  output insert:ToText()

  insert:Empty()
  insert:Add(" + dq + "id" + dq + ", 5)
  insert:Add(" + dq + "likes" + dq + ", " + dq + "kpop" + dq + ")
  // will only insert 1 query at a time
  database:Insert(insert)
  rowsAffected = rowsAffected + 1
  output insert:ToText()

  insert:Empty()
  insert:Add(" + dq + "id" + dq + ", 6)
  insert:Add(" + dq + "likes" + dq + ", " + dq + "hiking" + dq + ")
  // will only insert 1 query at a time
  database:Insert(insert)
  rowsAffected = rowsAffected + 1
  output insert:ToText()

  insert:Empty()
  insert:Add(" + dq + "id" + dq + ", 1)
  insert:Add(" + dq + "likes" + dq + ", " + dq + "coding" + dq + ")
  // will only insert 1 query at a time
  database:Insert(insert)
  rowsAffected = rowsAffected + 1
  output insert:ToText()

   insert:Empty()
  insert:Add(" + dq + "id" + dq + ", 2)
  insert:Add(" + dq + "likes" + dq + ", " + dq + "mayo" + dq + ")
  // will only insert 1 query at a time
  database:Insert(insert)
  rowsAffected = rowsAffected + 1
  output insert:ToText()

 ")
        CodeExample("use Libraries.Data.Database.Database
use Libraries.Data.Database.Insert

Database database
database:Connect(" + dq + "localhost" + dq + ", " + dq + "myfirstdatabase" + dq + ", " + dq + "root" + dq + ", " + dq + "password" + dq + ")

  Insert insert
  insert:SetTable(" + dq + "users" + dq + ")
  // keep a running sum on how many rows we add 
  integer rowsAffected = 0
   insert:Empty()
   
  // add first entry
  insert:Add(" + dq + "id" + dq + ", 1)
  insert:Add(" + dq + "customerName" + dq + ", " + dq + "peter parker" + dq + ")
  // will only insert 1 query at a time
  database:Insert(insert)
  rowsAffected = rowsAffected + 1
