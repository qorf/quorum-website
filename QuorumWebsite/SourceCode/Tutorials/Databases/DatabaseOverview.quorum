use Libraries.Web.Page.QuorumPage

/*
    Tutorial: Databases.
    Converted from the old Lesson page by plan 13's generator: the same
    words, now without Tailwind.
*/
class DatabaseOverview is QuorumPage

    on create
        SetLocation("tutorials/databases/overview.html")
        // The name lists and links use, and the series and track it belongs
        // to: its section and picture.
        SetShortTitle("Databases Overview")
        SetSectionName("Databases")
        // For search engines and link previews, and what lists of pages say.
        SetDescription("Learn about Database Overview on Quorum Language.")
        SetSummary("overview on databases and table structure")
    end

    action Setup
        SetWebPageTitle("Databases Overview - Quorum Programming Lanugage")
        Title("Tutorial: Databases")
        Paragraph("This tutorial introduces what databases are and their basic structures")
        DatabasesOverview()
        DatabaseTableStructure()
    end

    private action DatabasesOverview
        Section("Databases Overview")
        Paragraph("Data is all around us, from Amazon history purchases to student grades contained inside a gradebook. What to do with all this data depends on context, but all data requires storage. Most websites today use databases, including video streaming, social media, e-commerce, finances, and many others.")
        Subsection("What is a Database?")
        Paragraph("A database is a collection of data stored electronically within a computer system. Within a database, they are typically stored in rows and columns to make processing, managing, updating, and organizing efficient. As mentioned before, most databases use SQL to write and query data. To query data is to take an action on a database such as SELECT, INSERT, UPDATE, or DELETE. Quorum does not use SQL syntax for databases. There are many different types of databases, but for our purposes we will mostly be working with a relational database. Here are brief descriptions of the many different types of databases organizations use [1]:")
        Table("Types of Databases")
        TableHeader():Cell("Database Type"):Cell("Structure"):Cell("Functionality")
        TableRow():Cell("Relational"):Cell("Tables with columns and rows"):Cell("Provides the most efficient and flexible way to access structured information")
        TableRow():Cell("Object-Oriented"):Cell("In the form of objects"):Cell("Database for object-oriented programming")
        TableRow():Cell("Distributed"):Cell("Two or more files located in different machines"):Cell("To store data on multiple computers in the same location or scattered on different networks")
        TableRow():Cell("Data warehouse"):Cell("Central repository for data"):Cell("Fast query and analysis")
        TableRow():Cell("NoSQL"):Cell("Allows unstructured and semistructured data to be stored and manipulated"):Cell("Databases for more complex web applications")
        TableRow():Cell("Graph"):Cell("Entities and relationships between entities"):Cell("tailored to very specific scientific, financial, or other functions")
        TableRow():Cell("Open Sourced"):Cell("Same as SQL / NoSQL database"):Cell("Source code is open sourced")
        TableRow():Cell("Cloud"):Cell("collection of data, either structured or unstructured, that resides on a private, public, or hybrid cloud computing platform"):Cell("traditional and database as a service (DBaaS). With DBaaS, administrative tasks and maintenance are performed by a service provider")
        TableRow():Cell("Multimodel"):Cell("Various structures"):Cell("combine different types of database models into a single, integrated back end")
        TableRow():Cell("JSON / Document"):Cell("JSON formats"):Cell("storing, retrieving, and managing document-oriented information")
        TableRow():Cell("Self-Driving"):Cell("ML Models"):Cell("automate database tuning, security, backups, updates, and other routine management tasks")
        Paragraph("In order to run our database, we will need to use database software to help assist in creating, editing, and maintaining our records. Such software allows users to manage and access data easily. In the current version, Quorum supports only MySQL, an open source database implementation. It was designed and optimized for web applications and can run on any platform.")
    end

    private action DatabaseTableStructure
        Section("Database Table Structure")
        Paragraph("Our database structure will be similar to what we see on Google Sheets and Microsoft Excel: a table of rows and columns. The rows of a table represent entities or events in some application domain. The columns of a table represent row attributes. Let's go through an example of our relational database structure. Let us have a model of a group of information regarding students, classes, and professors. Each box is represented by a table:")
        Table("Student Tables")
        TableHeader():Cell("StudentID"):Cell("LastName"):Cell("FirstName"):Cell("Phone"):Cell("GPA")
        TableRow():Cell("68765707"):Cell("Doe"):Cell("Jane"):Cell("7024933451"):Cell("3.8")
        TableRow():Cell("47587465"):Cell("Doe"):Cell("John"):Cell("7256731912"):Cell("4.0")
        TableRow():Cell("68764700"):Cell("Vader"):Cell("Darth"):Cell("7024318418"):Cell("3.8")
        Table("Course Tables")
        TableHeader():Cell("CourseID"):Cell("Title"):Cell("Semester"):Cell("Units"):Cell("Location"):Cell("Time"):Cell("InstructorID")
        TableRow():Cell("55461"):Cell("CS 420"):Cell("FA 2021"):Cell("3"):Cell("MOP 203"):Cell("1:00 PM"):Cell("23452")
        TableRow():Cell("52551"):Cell("MUS 115"):Cell("SP 2022"):Cell("3"):Cell("TYB 455"):Cell("2:30 PM"):Cell("31341")
        TableRow():Cell("64513"):Cell("HIST 202"):Cell("FA 2022"):Cell("3"):Cell("RCC 110"):Cell("8:30 AM"):Cell("31313")
        Table("Instructor Tables")
        TableHeader():Cell("InstructorID"):Cell("LastName"):Cell("FirstName"):Cell("Rank"):Cell("Department")
        TableRow():Cell("23452"):Cell("Montana"):Cell("Hannah"):Cell("AP"):Cell("MUS")
        TableRow():Cell("31341"):Cell("Sparrow"):Cell("Jack"):Cell("AP"):Cell("HIST")
        TableRow():Cell("31313"):Cell("Possible"):Cell("Kim"):Cell("AP"):Cell("CS")
        Paragraph("These tables contain unique values like student ID, instructor ID, and course ID and we refer to these as keys. The keys in one table can refer to a row in another table such as matching the Instructor key inside of Courses to Instructor ID key inside of Instructor. These so-called "):DoubleQuote():Text("foreign keys"):DoubleQuote():Text(" are a common way of tracking data between tables. Note that Quorum only currently supports relational databases.")
        Subsection("References")
        Paragraph("[1]: Oracle, What is a Database? "):Link("https://www.oracle.com/database/what-is-database", "https://www.oracle.com/database/what-is-database"):Text(".")
    end
end
