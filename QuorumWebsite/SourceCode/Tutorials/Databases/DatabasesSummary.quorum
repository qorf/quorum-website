use Libraries.Web.Page.QuorumPage

/*
    Tutorial: Databases.
    Converted from the old Lesson page by plan 13's generator: the same
    words, now without Tailwind.
*/
class DatabasesSummary is QuorumPage
    // A double quote, for code and words that hold one.
    text dq = ""

    on create
        SetLocation("tutorials/databases/summarizingDatabases.html")
        // The name lists and links use, and the series and track it belongs
        // to: its section and picture.
        SetShortTitle("Interpreting Summarized Data Tables")
        SetSectionName("Databases")
        // For search engines and link previews, and what lists of pages say.
        SetDescription("Learn about interpreting summarized data with database tables on Quorum Language.")
        SetSummary("going beyond database tables and summarizing the data")
    end

    action Setup
        dq = dq:GetDoubleQuote()
        SetWebPageTitle("Interpreting Summarized Data- Quorum Programming Lanugage")
        Title("Tutorial: Databases")
        Paragraph("This tutorial shows us how to transform our database tables into meanful summarized data")
        InterpretingSummarizedData()
    end

    private action InterpretingSummarizedData
        Section("Interpreting Summarized Data")
        Paragraph("Databases contain massive amounts of data which can be utilized in the world of Data Science. This could be using tables to measure central tendency, transform our data, or even create a visual representation of a table inside of our database. Recall that the DataFrames object is a container we heavily use for data manipulation and data representation. Because we can easily convert database tables as DataFrames in Quorum Studios, the functionality of a database has become so versatile. We will be able to draw conclusions from our database tables using summary statistics.")
        CodeExample("DataFrame frame")
        Paragraph("For this tutorial, we will be measuring the mean, median, variance, and standard deviation of our "):DoubleQuote():Text("grocerylist"):DoubleQuote():Text(" table inside of our database. We will want to connect our database once again as well as create a DataFrame object. To learn more about how to convert our tables into a DataFrame we can use the following tutorial on converting a data table to a DataFrame.")
        Paragraph("Assuming that our "):DoubleQuote():Text("grocerylist"):DoubleQuote():Text(" table is now a DataFrame, we will be using the "):DoubleQuote():Text("frame"):DoubleQuote():Text(" object for the rest of the tutorial and find the Mean(), Median(), StandardDeviation(), and Variance(). The other actions we will be using with our "):DoubleQuote():Text("frame"):DoubleQuote():Text(" are AddSelectedColumn(integer columnNumber) and EmptySelectedColumns().")
        Paragraph("Let us show an example of how to find the mean because the other measures also follow this same format. We first want to select the column we are going to measure. Recall that the columns in our "):DoubleQuote():Text("grocerylist"):DoubleQuote():Text(" table are: FoodID, FoodName, FoodCost, FoodCalories, and FoodQuanity as well as know that our first column, FoodID column is at element 0 in our "):DoubleQuote():Text("frame."):DoubleQuote()
        Paragraph("Using our frame, we will select the "):DoubleQuote():Text("FoodCost"):DoubleQuote():Text(" column which is also column 2 inside the frame using the action AddSelectedColumn(integer columnNumber). Then, we will properly format our data and call the Mean() action with our frame. After calling Mean(), we will need to empty our DataFrame using the action EmptySelectedColumns(). We do this because we can only measure one central tendency at a time and it also helps use different columns for calculations. This same process should be followed for Median(), Variance(), and StandardDeviation().")
        CodeExample("frame:AddSelectedColumn(2)
output " + dq + " " + dq + "
output " + dq + "Mean of the FoodCost:" + dq + "
output frame:Mean()
frame:EmptySelectedColumns()")
        Paragraph("Now that we have our data measures, we can describe our data in a more presentable way versus showing a data table. Data tables are great for holding massive amounts of data, but they are difficult to represent without showing any sort of quantitative measure. To learn more about Data Science and how to use DataFrames in a more complex manner, we can reference the Introduction to Data Science learning track.")
        Paragraph("We can view our entire program below.")
        CodeExample("use Libraries.Data.Database.Database
use Libraries.Compute.Statistics.DataFrame

Database database
database:Connect(" + dq + "localhost" + dq + ", " + dq + "myfirstdatabase" + dq + ", " + dq + "root" + dq + ", " + dq + "password" + dq + ")

output database:IsConnected()

DataFrame frame

frame = database:FindAsDataFrame(" + dq + "grocerylist" + dq + ")

output frame:ToText()

frame:AddSelectedColumn(2)
output " + dq + " " + dq + "
output " + dq + "Mean of the FoodCost:" + dq + "
output frame:Mean()
frame:EmptySelectedColumns()

frame:AddSelectedColumn(3)
output " + dq + " " + dq + "
output " + dq + "Median of the FoodCalories:" + dq + "
output frame:Median()
frame:EmptySelectedColumns()

frame:AddSelectedColumn(4)
output " + dq + " " + dq + "
output " + dq + "Standard of the FoodQuantity:" + dq + "
output frame:StandardDeviation()
frame:EmptySelectedColumns()

frame:AddSelectedColumn(4)
output " + dq + " " + dq + "
output " + dq + "Variance of the FoodQuantity:" + dq + "
output frame:Variance()")
    end
end
