use Libraries.Web.Page.QuorumPage

/*
    Tutorial: Databases.
    Converted from the old Lesson page by plan 13's generator: the same
    words, now without Tailwind.
*/
class DatabaseInsertingData is QuorumPage
    // A double quote, for code and words that hold one.
    text dq = ""

    on create
        SetLocation("tutorials/databases/insertingDataDatabases.html")
        // The name lists and links use, and the series and track it belongs
        // to: its section and picture.
        SetShortTitle("Inserting Data into a Database Table")
        SetSectionName("Databases")
        // For search engines and link previews, and what lists of pages say.
        SetDescription("Learn about MySQL setup on Quorum Language.")
        SetSummary("how to insert data into a database table")
    end

    action Setup
        dq = dq:GetDoubleQuote()
        SetWebPageTitle("Populating Our Table With Data - Quorum Programming Lanugage")
        Title("Tutorial: Databases")
        Paragraph("This tutorial shows us how insert data onto our database")
        InsertingNewRecordsInOurTable()
    end

    private action InsertingNewRecordsInOurTable
        Section("Inserting New Records in Our Table")
        Paragraph("At this point, we have tables set up to add onto our database. Being able to insert data is one of the most important aspects about databases because a database is meant to hold massive amounts of unique information. To add a new record is similar to adding a new piece of data on a spreadsheet; we want to make sure our data is correctly contained in the correct data column. Here we have a table for student grades and GPA as follows:")
        Table("GPA Example")
        TableHeader():Cell("StudentID"):Cell("FirstName"):Cell("LastName"):Cell("Grade"):Cell("GPA")
        TableRow():Cell("1"):Cell("Damian"):Cell("Desmond"):Cell("A"):Cell("4.0")
        TableRow():Cell("2"):Cell("Anya"):Cell("Forger"):Cell("A"):Cell("3.8")
        Paragraph("We want to make sure data types are in the right column so GPA would be a decimal column while first name should be a string column and so fourth. For this tutorial, we will be going back into our grocery list, "):DoubleQuote():Text("grocerylist"):DoubleQuote():Text(" table and insert information regarding food. Recall the columns of out table:")
        Table("Grocery List")
        TableHeader():Cell("FoodID"):Cell("FoodName"):Cell("FoodCost"):Cell("FoodCalories"):Cell("FoodQuantity")
        TableRow():Cell("DataType: integer"):Cell("DataType: string"):Cell("DataType: number (double)"):Cell("DataType: integer"):Cell("DataType: integer")
        Paragraph("We will want to connect our database once again as well as create an Insert object. To do this, we would create a new object called Insert, that allows us to use "):Link("helper actions", "https://quorumlanguage.com/Libraries/Data/Database/Insert.html"):Text(" to delete the existing table inside of our database.")
        Paragraph("use Libraries.Data.Database.Database use Libraries.Data.Database.Insert Database database database:Connect("):DoubleQuote():Text("localhost"):DoubleQuote():Text(", "):DoubleQuote():Text("myfirstdatabase"):DoubleQuote():Text(", "):DoubleQuote():Text("root"):DoubleQuote():Text(", "):DoubleQuote():Text("password"):DoubleQuote():Text(") Insert insert")
        Table("Inserting Data Actions")
        TableHeader():Cell("Action / Object"):Cell("Description"):Cell("Usage")
        TableRow():Cell("Insert objectName"):Cell("The Insert query represents the INSERT INTO command of the SQL (Structured Query Language) language. This query allows for data manipulation by inserting new rows into a table."):Cell("Insert insert")
        TableRow():Cell("iObject:Add(text columnName, dataType value)"):Cell("Add a column target along with the value that will be associated with it."):Cell("insert:Add(" + dq + "cost" + dq + ", 4.50) insert:Add(" + dq + "firstName" + dq + ", " + dq + "Daniel" + dq + ") insert:Add(" + dq + "daysOff" + dq + ", 14)")
        TableRow():Cell("iObject:SetTable(text tableName)"):Cell("This action sets the table of the query."):Cell("insert:SetTable(" + dq + "superCoolTable" + dq + ")")
        TableRow():Cell("iObject:Empty()"):Cell("Removes all columns and values associated with them from the query"):Cell("insert:Empty()")
        TableRow():Cell("dbObject:Insert:(Insert objectName)"):Cell("This takes an Insert query and sends it to the database and returns the result. An Insert allows for adding more rows to a table and if the insert was successful the database will return the number of rows affected. For more information and how to do an insert look into the documentation of the Insert query class."):Cell("database:Insert(insert)")
        Paragraph("What we want to do first is select the table we want to insert data using SetTable() and pass in the "):DoubleQuote():Text("grocerylist"):DoubleQuote():Text(" table. Once that is complete, all inserts will go into that table and we'll want to add 5 entries of data per row: FoodID, FoodName, FoodCost, FoodCalories, FoodQuantity.")
        Paragraph("What we want to do first is use SetTable() on our 'insert' object which allows us to select a specific table inside our database. For example, SetTable() takes in one parameter, the table title and in this case we will be passing in "):DoubleQuote():Text("grocerylist"):DoubleQuote():Text(" into the action. Then, if we want, we can keep a running sum to see how many rows will be affected in total; we can call this integer value "):DoubleQuote():Text("rowsAffected"):DoubleQuote():Text(" and initialize it as 0.")
        Paragraph("Next, what we will be wanting to do is add in values using Add(); the action add requires two parameters: the column name and the data type value associated with the column. For example, say that we have a column called "):DoubleQuote():Text("firstName,"):DoubleQuote():Text(" we would want to pass "):DoubleQuote():Text("firstName"):DoubleQuote():Text(" in the first parameter and because names are strings, we will insert "):DoubleQuote():Text("Bob"):DoubleQuote():Text(" as the second parameter. In our grocerylist table, let's insert 1 for FoodId, Chicken Breast for FoodName, 2.99 for FoodCost, 120 for FoodCalories, and 2 for FoodQuantity using the Add() action.")
        CodeExample("insert:Add(" + dq + "FoodID" + dq + ", 1)
 insert:Add(" + dq + "FoodName" + dq + ", " + dq + "Chicken Breast" + dq + ")
 insert:Add(" + dq + "FoodCost" + dq + ", 2.99)
 insert:Add(" + dq + "FoodCalories" + dq + ", 120)
 insert:Add(" + dq + "FoodQuantity" + dq + ", 2)")
        CodeExample("database:Insert(insert)
 rowsAffected = rowsAffected + 1
 insert:Empty()")
        Paragraph("We have our data loaded inside this insert object, but it is not actually in our database yet. Using our database object, like previous actions, we will now call in the Insert() action and pass in 'insert' within the parameter. This will update our table in our database in real time and it is also worth noting that Insert() will return either 0 or 1 where 0 means it did not add the row into the database and 1 meaning it has successfully added the row into the database. Now, we want to increment the counter, rowsAffected and then empty our insert object using the action Empty(). It is necessary that before we add another record, we have to Empty() the object or else we will have compilation errors.")
        Paragraph("Congrats! Now, we can finally multiple entries of data into our table! We can view the entire code below.")
        CodeExample("use Libraries.Data.Database.Database
use Libraries.Data.Database.Insert

Database database
database:Connect(" + dq + "localhost" + dq + ", " + dq + "myfirstdatabase" + dq + ", " + dq + "root" + dq + ", " + dq + "password" + dq + ")

  Insert insert
  insert:SetTable(" + dq + "grocerylist" + dq + ")
 // keep a running sum on how many rows we add 
 integer rowsAffected = 0
   
  // add first entry
  insert:Add(" + dq + "FoodID" + dq + ", 1)
  insert:Add(" + dq + "FoodName" + dq + ", " + dq + "Chicken Breast" + dq + ")
  insert:Add(" + dq + "FoodCost" + dq + ", 2.99)
  insert:Add(" + dq + "FoodCalories" + dq + ", 120)
  insert:Add(" + dq + "FoodQuantity" + dq + ", 2)
 // will only insert 1 query at a time
  database:Insert(insert)
  rowsAffected = rowsAffected + 1
    output insert:ToText()

/* clears out info from previous insert
   we need to call this because it only inserts one
   at a time, we can insert multiple queries at 
   the same time with this method
*/
  insert:Empty()
  insert:Add(" + dq + "FoodID" + dq + ", 2)
  insert:Add(" + dq + "FoodName" + dq + ", " + dq + "Italian Sausage" + dq + ")
  insert:Add(" + dq + "FoodCost" + dq + ", 3.99)
  insert:Add(" + dq + "FoodCalories" + dq + ", 250)
  insert:Add(" + dq + "FoodQuantity" + dq + ", 5)
  database:Insert(insert)
  output insert:ToText()

   rowsAffected = rowsAffected + 1

  insert:Empty()
  insert:Add(" + dq + "FoodID" + dq + ", 3)
  insert:Add(" + dq + "FoodName" + dq + ", " + dq + "Mango" + dq + ")
  insert:Add(" + dq + "FoodCost" + dq + ", 0.99)
  insert:Add(" + dq + "FoodCalories" + dq + ", 60)
  insert:Add(" + dq + "FoodQuantity" + dq + ", 2)
  database:Insert(insert)
output insert:ToText()

  rowsAffected = rowsAffected + 1

  insert:Empty()
  insert:Add(" + dq + "FoodID" + dq + ", 4)
  insert:Add(" + dq + "FoodName" + dq + ", " + dq + "Orange Cutie" + dq + ")
  insert:Add(" + dq + "FoodCost" + dq + ", 0.45)
  insert:Add(" + dq + "FoodCalories" + dq + ", 40)
  insert:Add(" + dq + "FoodQuantity" + dq + ", 5)

  database:Insert(insert)
  rowsAffected = rowsAffected + 1
output insert:ToText()

insert:Empty()
  insert:Add(" + dq + "FoodID" + dq + ", 5)
  insert:Add(" + dq + "FoodName" + dq + ", " + dq + "Banana" + dq + ")
  insert:Add(" + dq + "FoodCost" + dq + ", 0.30)
  insert:Add(" + dq + "FoodCalories" + dq + ", 110)
  insert:Add(" + dq + "FoodQuantity" + dq + ", 7)

  database:Insert(insert)
  rowsAffected = rowsAffected + 1
output insert:ToText()

  output " + dq + "Inserted " + dq + " + rowsAffected + " + dq + " row(s)" + dq)
    end
end
