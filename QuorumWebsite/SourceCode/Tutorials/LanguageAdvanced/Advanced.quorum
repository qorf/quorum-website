use Libraries.Web.Page.QuorumPage

/*
    Advanced Quorum: the advanced language tutorials, as a grid of picture
    cards (plan 13 phase 5B; the old page's picture links, whose old
    styles no longer existed).
*/
class Advanced is QuorumPage
    on create
        SetLocation("advanced.html")
        // The name lists and links use, and its picture.
        SetShortTitle("Advanced Quorum")
        SetCardImage("/media/basics/autoboxing.png")
        // For search engines and link previews, and what lists of pages say.
        SetSummary("advanced topics for Quorum")
    end

    action Setup
        SetWebPageTitle("Advanced use of Primitives - Quorum Programming Language")
        Title("Advanced Quorum")
        Paragraph("These pages provide more advanced material on the Quorum programming language")
        // Each picture is decoration: the card's name says what it is.
        CourseCards()
        CourseCard("Using Libraries", "/tutorials/language/usingLibraries.html", "media/UsingLibraries.png", "", "")
        CourseCard("Inheritance", "/tutorials/language/inheritance.html", "media/basics/inheritance.png", "", "")
        CourseCard("Generics", "/tutorials/language/generics.html", "media/basics/generics.png", "", "")
        CourseCard("Auto-boxing", "/tutorials/language/autoboxing.html", "media/basics/autoboxing.png", "", "")
        CourseCard("Arrays", "/tutorials/language/arrays.html", "media/Arrays.png", "", "")
        CourseCard("Containers", "/tutorials/language/containers.html", "media/Containers.png", "", "")
        CourseCard("Error Handling", "/tutorials/language/errors.html", "media/basics/errors.png", "", "")
        CourseCard("Plugins", "/tutorials/language/plugins.html", "media/Plugins.png", "", "")
    end
end
