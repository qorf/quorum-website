use Libraries.Web.Page.QuorumPage

/*
    Tutorial: Arrays.
    Converted from the old Lesson page by plan 13's generator: the same
    words, now without Tailwind.
*/
class ArraysTutorial is QuorumPage
    // A double quote, for code and words that hold one.
    text dq = ""

    on create
        SetLocation("tutorials/language/arrays.html")
        // The name lists and links use, and the series and track it belongs
        // to: its section and picture.
        SetShortTitle("Arrays")
        SetSectionName("Libraries and Structures")
        SetCardImage("/media/basics/Arrays.png")
        // For search engines and link previews, and what lists of pages say.
        SetDescription("Learn about using arrays for storing data in memory with the Quorum programming language.")
        SetSummary("how to use arrays")
    end

    action Setup
        dq = dq:GetDoubleQuote()
        SetWebPageTitle("Arrays - Quorum Programming Language")
        Title("Tutorial: Arrays")
        Paragraph("Storing Information in memory")
        UsingArraysInQuorum()
        AddingToAnArray()
        GettingItemsFromAnArray()
        RemovingItemsFromAnArray()
        IteratingOverAnArray()
    end

    private action UsingArraysInQuorum
        Section("Using Arrays in Quorum")
        Paragraph("Like many programming languages, Quorum has a variety of support classes for storing information in memory. In Quorum, these are generally called containers and in this tutorial, we will discuss how to use arrays.")
    end

    private action AddingToAnArray
        Section("Adding to an Array")
        Paragraph("We can add to an array using code like the following:")
        CodeExample("//like with arrays, this code represents a template, an array that is filled only with integers
use Libraries.Containers.Array
Array<integer> array

//put a value in the second slot in the array, which is named 1
array:Add(5)
output " + dq + "We added an item to the array." + dq)
        Paragraph("Quorum does not allow us to add types to a templated value unless it matches exactly the type specified in the generic. So, for example, the following would be a compiler error:")
        CodeExample("use Libraries.Containers.Array
Array<integer> array

//since we have declared this array to use integers, we cannot put in a number type (with a decimal point)
array:Add(5.0)")
        CodeEditorWithCode("Activity: Try adding elements to an array", "//Try adding integers to an array"):HideDisplay()
    end

    private action GettingItemsFromAnArray
        Section("Getting Items From an Array")
        Paragraph("Once we have added values to an array, we can obtain them individually using the Get action, like so:")
        CodeExample("use Libraries.Containers.Array
Array<integer> myList

//add two values to the array, 12 and 13
myList:Add(12)
myList:Add(13)

//this line returns the first integer, 12
integer value = myList:Get(0)
output value")
        CodeEditorWithCode("Activity: Try getting elements from an array", "//Try getting integers the integers back"):HideDisplay()
    end

    private action RemovingItemsFromAnArray
        Section("Removing Items From an Array")
        Paragraph("Similarly to getting, we can remove items from an array. If we want to remove just the first version of a value (values are not guaranteed to be unique), then we can call Remove. If we want to remove all instances of an item, we can call RemoveAll. If an item is found, we are returned a boolean saying that the removal was successful.")
        CodeExample("use Libraries.Containers.Array
Array<integer> myList
myList:Add(43)
myList:Add(13)
myList:Add(43)

//RemoveAll(43) would remove all 43s
boolean removed = myList:Remove(43)
output removed")
        CodeEditorWithCode("Activity: Try removing elements from an array", "//Try removing integers we have added"):HideDisplay()
    end

    private action IteratingOverAnArray
        Section("Iterating Over an Array")
        Paragraph("Finally, we often want to traverse over all elements in an array. To do this, we can use the Iterator class and ask it for each element, one at a time. The following example shows us how we might do this:")
        CodeExample("use Libraries.Containers.Array
use Libraries.Containers.Iterator
class Main
   action Main
       Array<integer> array
        //add 3 items: 5, 10, and 15
       array:Add(5)
       array:Add(10)
       array:Add(15)

       //create an iterator to traverse our array
       Iterator<integer> it = array:GetIterator()
       //Keep iterating if more elements exist
       repeat while it:HasNext()
           //get the next item.
           integer value = it:Next()
           output value
       end
   end
end")
        CodeEditorWithCode("Activity: Try iterating over the data structure", "//Try iterating over the data structure"):HideDisplay()
    end
end
