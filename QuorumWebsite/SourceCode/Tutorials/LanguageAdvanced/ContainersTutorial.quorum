use Libraries.Web.Page.QuorumPage

/*
    Tutorial: Containers.
    Converted from the old Lesson page by plan 13's generator: the same
    words, now without Tailwind.
*/
class ContainersTutorial is QuorumPage
    // A double quote, for code and words that hold one.
    text dq = ""

    on create
        SetLocation("tutorials/language/containers.html")
        // The name lists and links use, and the series and track it belongs
        // to: its section and picture.
        SetShortTitle("Containers")
        SetSectionName("Libraries and Structures")
        SetCardImage("/media/Containers.png")
        // For search engines and link previews, and what lists of pages say.
        SetDescription("Learn about containers other than arrays (e.g., linked lists, hash tables) in the Quorum programming language.")
        SetSummary("how to use containers")
    end

    action Setup
        dq = dq:GetDoubleQuote()
        SetWebPageTitle("Using other Containers - Quorum Programming Language")
        Title("Tutorial: Containers")
        Paragraph("Storing Information in memory")
        UsingContainersInQuorum()
        AddingToAList()
        GettingElementsFromAList()
        RemovingItemsFromAList()
        IteratingOverAList()
        AdditionalResourcesForQuorumContainers()
    end

    private action UsingContainersInQuorum
        Section("Using Containers in Quorum")
        Paragraph("Like many programming languages, Quorum has a variety of support classes for storing information in memory. In Quorum, these are generally called containers. In other tutorials, we have learned how to use the "):Link("Array", "/tutorials/language/arrays.html"):Text(" class. In this tutorial, we will discuss one more container, the List. This tutorial is intended as a high level overview of the most basic operations. The full documentation can be found at the "):Link("List page", "/libraries/Containers/List.html"):Text(". Besides arrays and lists, Quorum has a variety of other data structures, including a "):Link("Hashtable", "/libraries/Containers/HashTable.php"):Text(", "):Link("Queue", "/libraries/Containers/Queue.html"):Text(", "):Link("Stack", "/libraries/Containers/Stack.html"):Text(", and "):Link("Table", "/libraries/Containers/Table.html"):Text(". In this tutorial, while we discuss lists, the other data structures are comparable.")
    end

    private action AddingToAList
        Section("Adding to a List")
        Paragraph("We can add to a list using code like the following:")
        CodeExample("//like with arrays, this code represents a template, a list that is filled only with integers
use Libraries.Containers.List
List<integer> list

//put a value in the second slot in the array, which is named 1
list:Add(5)
output " + dq + "We added an item to the list." + dq)
        Paragraph("Quorum does not allow us to add types to a templated value unless it matches exactly the type specified in the generic. So, for example, the following would be a compiler error:")
        CodeExample("use Libraries.Containers.List
List<integer> list

//since we have declared this list to use integers, we cannot put in a number type (with a decimal point)
list:Add(5.0)")
        CodeEditorWithCode("Activity: Try adding elements to a list", "//Try adding integers into a list"):HideDisplay()
    end

    private action GettingElementsFromAList
        Section("Getting Elements From a List")
        Paragraph("Once we have added values to a list, we can obtain them individually using the Get action, like so:")
        CodeExample("use Libraries.Containers.List
List<integer> myList

//add two values to the list, 12 and 13
myList:Add(12)
myList:Add(13)

//this line returns the first integer, 12
integer value = myList:Get(0)
output value")
        CodeEditorWithCode("Activity: Try getting elements from a list", "//Try getting the integers back"):HideDisplay()
    end

    private action RemovingItemsFromAList
        Section("Removing Items From a List")
        Paragraph("Similarly to getting, we can remove items from a list. If we want to remove just the first version of a value (values are not guaranteed to be unique), then we can call Remove. If we want to remove all instances of an item, we can call RemoveAll. If an item is found, we are returned a boolean saying that the removal was successful.")
        CodeExample("use Libraries.Containers.List
List<integer> myList
myList:Add(43)
myList:Add(13)
myList:Add(43)

//RemoveAll(43) would remove all 43s
boolean removed = myList:Remove(43)
output removed")
        CodeEditorWithCode("Activity: Try removing elements from a list", "//Try removing integers we have added"):HideDisplay()
    end

    private action IteratingOverAList
        Section("Iterating Over a List")
        Paragraph("Finally, we often want to traverse over all elements in a list. To do this, we can use the Iterator class and ask it for each element, one at a time. The following example shows us how we might do this:")
        CodeExample("use Libraries.Containers.List
use Libraries.Containers.Iterator
class Main
   action Main
       List<integer> list
        //add 3 items: 5, 10, and 15
       list:Add(5)
       list:Add(10)
       list:Add(15)

       //create an iterator to traverse our list
       Iterator<integer> it = list:GetIterator()
       //Keep iterating if more elements exist
       repeat while it:HasNext()
           //get the next item.
           integer value = it:Next()
           output value
       end
   end
end")
        CodeEditorWithCode("Activity: Try Iterating", "//Try iterating over the data structure"):HideDisplay()
    end

    private action AdditionalResourcesForQuorumContainers
        Section("Additional Resources for Quorum Containers")
        BulletList()
        ListItem():Link("Linked List Wikipedia Page", "https://en.wikipedia.org/wiki/Linked_list")
        ListItem():Link("Quorum List Source Code", "https://github.com/qorf/quorum-language/blob/main/Quorum/Library/Standard/Libraries/Containers/List.quorum")
        ListItem():Link("Hashtable Wikipedia Page", "https://en.wikipedia.org/wiki/Hash_table")
        ListItem():Link("Quorum Hashtable Source Code", "https://github.com/qorf/quorum-language/blob/main/Quorum/Library/Standard/Libraries/Containers/HashTable.quorum")
        ListItem():Link("Queue Wikipedia Page", "https://en.wikipedia.org/wiki/Queue_(abstract_data_type)")
        ListItem():Link("Quorum Queue Source Code", "https://github.com/qorf/quorum-language/blob/main/Quorum/Library/Standard/Libraries/Containers/Queue.quorum")
        ListItem():Link("Stack Wikipedia Page", "https://en.wikipedia.org/wiki/Stack_(abstract_data_type)")
        ListItem():Link("Quorum Stack Source Code", "https://github.com/qorf/quorum-language/blob/main/Quorum/Library/Standard/Libraries/Containers/Stack.quorum")
        ListItem():Link("Quorum Table Source Code", "https://github.com/qorf/quorum-language/blob/main/Quorum/Library/Standard/Libraries/Containers/Table.quorum")
    end
end
