use Libraries.Web.Page.QuorumPage

/*
    Tutorial: Using the Screen of the LEGO™ Robot.
    Converted from the old Lesson page by plan 13's generator: the same
    words, now without Tailwind.
*/
class LegoScreenTutorial is QuorumPage
    // A double quote, for code and words that hold one.
    text dq = ""

    on create
        SetLocation("tutorials/robots/legoScreen.html")
        // The name lists and links use, and the series and track it belongs
        // to: its section and picture.
        SetShortTitle("Screen")
        SetSectionName("LEGO™ Robots")
        SetCardImage("/media/robots/screen.png")
        // For search engines and link previews, and what lists of pages say.
        SetDescription("Learn how code the screen on a LEGO Mindstorms robot with the Quorum programming language.")
        SetSummary("how to use lego robots screen")
    end

    action Setup
        dq = dq:GetDoubleQuote()
        SetWebPageTitle("LEGO Screen - Quorum Programming Language")
        Title("Tutorial: Using the Screen of the LEGO™ Robot")
        Paragraph("This tutorial helps explain how the LCD screen is used in Quorum.")
        UsingTheScreenOfTheLEGORobot()
        PropertiesOfTheScreen()
        OutputtingTextOntoTheScreen()
        DrawingLinesAndShapesOnTheScreen()
        ScrollingUpTheScreen()
        AdditionalInformation()
    end

    private action UsingTheScreenOfTheLEGORobot
        Section("Using the Screen of the LEGO™ Robot")
        Paragraph("In this tutorial, we will discuss how the Screen class can be used to draw shapes or put text on the robot's screen. Specifically, we will cover:")
        BulletList()
        ListItem("Properties of the Screen")
        ListItem("Outputting Text onto the Screen")
        ListItem("Drawing Lines and Shapes on the Screen")
        ListItem("Scrolling up the screen")
    end

    private action PropertiesOfTheScreen
        Section("Properties of the Screen")
        Paragraph("The screen makes up the top portion of the brick and is used to display text or shapes. The screen is composed of pixels, which is just a fancy way of saying the screen is made up of tiny squares that can change color, and in the screen's case they can only be black or blank. The width of the screen has 178 pixels (ranging from 0 to 177) and these pixels all lie along the x-axis. The height of the screen is 128 pixels tall (ranging from 0 to 127) and these pixels all lie on the y-axis. Although all screen actions work by drawing or removing color from one or more pixels, it is more the focus when drawing shapes, so we will go into more detail about the pixels later.")
    end

    private action OutputtingTextOntoTheScreen
        Section("Outputting Text onto the Screen")
        Paragraph("The Screen class provides actions for three different types of text: "):Strong("normal"):Text(", "):Strong("large"):Text(", and "):Strong("inverted"):Text(". Text is output to one of eight text lines on the screen (referred to as lines 0 through 7, where 0 is the top line) and each line is 16 pixels tall. For example, the code "):Code("screen:Output(" + dq + "Hello" + dq + ", 3)"):Text(" will print the normal text "):DoubleQuote():Text("Hello"):DoubleQuote():Text(" to line 3. Normal text is the basis for all of the other styles, and so the previous code segment does not specify a style in the action name. By contrast, if we want to print the same message in a large font, we would use the code "):Code("screen:OutputLarge(" + dq + "Hello" + dq + ", 3)"):Text(" instead. Large font takes up two lines of text (the line specified and the one below it) and can fit less information on screen, but it is much easier to see. Inverted text is the same size as normal text, but the difference is that all of the pixels used for the text are inverted, meaning the blank pixels become black and vice versa, making it look like the text has been cut out from a solid black bar. To use the previous example again, inverted text actions will look like "):Code("screen:OuputInvertedColor(" + dq + "Hello" + dq + ", 3)"):Text(".")
        Subsection("Format")
        Paragraph("For the three types of text, Quorum has a few formatting actions to help position our text on the screen:")
        BulletList()
        ListItem():Code("Output(text message, integer line)")
        ListItem():Code("Output(text message, integer line, integer indent)")
        ListItem():Code("OutputCenter(text message, integer line)")
        Paragraph("We have been using the first action in the previous examples where we would just tell the program the message to display and what line it should be on. This causes the text to start on the left side of the screen, but what if we want the text indented or centered? That is where the other actions can be used. One thing that should be pointed out here is that all letters take up the same amount of space, 8 pixels wide with the normal font, and the indentation parameter is specified in terms of these spaces, meaning an indentation of 1 shifts the text over by one letter's space. Each type of font (normal, inverted, large) has this set of actions for formatting text. For example, to center a large text message on lines 3 and 4, code such as "):Code("screen:OutputCenterLarge(" + dq + "Hello" + dq + ", 3)"):Text(" will do the trick.")
    end

    private action DrawingLinesAndShapesOnTheScreen
        Section("Drawing Lines and Shapes on the Screen")
        Paragraph("Through Qurourm, we can draw lines, rectangles, circles, and ellipses on the screen. Drawing these will require a point along the x-axis (width of the screen) and a point along the y-axis (height of the screen) to determine the position of the line or shape. For the shapes, there are actions to draw outlines of shapes or full shapes, and actions to erase outlines of shapes or full shapes.")
        Subsection("Lines")
        Paragraph("To draw lines, we use the action "):Code("DrawLine(integer xStart, integer yStart, integer xEnd, integer yEnd)"):Text(". The "):Code("xStart"):Text(" and "):Code("yStart"):Text(" parameters are used to determine the starting point of the line, while the "):Code("xEnd"):Text(" and "):Code("yEnd"):Text(" parameters determine the ending point of the line. Thus, to make a diagonal line that goes across theentire screen, we could use the code "):Code("screen:DrawLine(0, 0, 177, 127)"):Text(".")
        Subsection("Rectangles")
        Paragraph("Rectangles have the following actions:")
        BulletList()
        ListItem():Code("DrawRectangleOutline(integer xBottomLeft, integer yBottomLeft, integer width, integer height)")
        ListItem():Code("EraseRectangleOutline(integer xStart, integer yStart, integer width, integer height)")
        ListItem():Code("DrawRectangleFull(integer xStart, integer yStart, integer width, integer height)")
        ListItem():Code("EraseRectangleFull(integer xStart, integer yStart, integer width, integer height)")
        Paragraph("To draw or erase any rectangle, we need to indicate the starting point for the rectangle, which is the lower-left corner of it, and then specify where it should end, which will be the top-right corner.")
        Subsection("Circles")
        Paragraph("Circles have the following actions:")
        BulletList()
        ListItem():Code("DrawCircleOutline(integer x, integer y, integer radius)")
        ListItem():Code("EraseCircleOutline(integer x, integer y, integer radius)")
        ListItem():Code("DrawCircleFull(integer x, integer y, integer radius)")
        ListItem():Code("EraseCircleFull(integer x, integer y, integer radius)")
        Paragraph("To draw or erase a circle, we need to specify the center pixel of the circle and then tell the program how far out from that point the circle should be in every direction, also known as the radius of the circle.")
        Subsection("Ellipses")
        Paragraph("Ellipses have the following actions:")
        BulletList()
        ListItem():Code("DrawEllipseOutline(integer x, integer y, integer width, integer height)")
        ListItem():Code("EraseEllipseOutline(integer x, integer y, integer width, integer height)")
        ListItem():Code("DrawEllipseFull(integer x, integer y, integer width, integer height)")
        ListItem():Code("EraseEllipseFull(integer x, integer y, integer width, integer height)")
        Paragraph("Drawing an ellipse, or an oval, is similar to a circle in that we need to specify the center of the ellipse, but then we need to tell the program the maximum width of the ellipse and the maximum height for it as well.")
    end

    private action ScrollingUpTheScreen
        Section("Scrolling Up the Screen")
        Paragraph("For times when we are going to be using more than the 8 text lines available, such as updating information constantly, it may be useful to only push the oldest information off screen first. In this case, we can use the different types of scroll actions to move everything on the screen up. The scroll actions are as follows:")
        BulletList()
        ListItem():Code("ScrollUp()")
        ListItem():Code("ScrollUp(text message)")
        ListItem():Code("ScrollUp(integer lines)")
        Paragraph("The first action, ScrollUp()ScrollUp(text message)ScrollUp(integer lines) moves everything, including text and shapes, on the screen up one text line. If we already know what we want to put on the new line we just made room for, we can use the action to place our text for us after scrolling up. The last action, is used to scroll up more than just line, which can be particularyly useful if we are using large text, since it displays over two text lines.")
    end

    private action AdditionalInformation
        Section("Additional Information")
        BulletList()
        ListItem("To clear everything on the screen, use the Clear() action on a Screen object.")
        ListItem("For documentation on the Screen class, see "):Link("here", "/Libraries/Robots/Lego/Screen.html"):Text(".")
    end
end
