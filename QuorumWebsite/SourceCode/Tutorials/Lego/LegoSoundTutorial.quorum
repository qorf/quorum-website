use Libraries.Web.Page.QuorumPage

/*
    Tutorial: Using Sounds with LEGO™ Robots.
    Converted from the old Lesson page by plan 13's generator: the same
    words, now without Tailwind.
*/
class LegoSoundTutorial is QuorumPage
    // A double quote, for code and words that hold one.
    text dq = ""

    on create
        SetLocation("tutorial/robots/legoSound.html")
        // The name lists and links use, and the series and track it belongs
        // to: its section and picture.
        SetShortTitle("Sound")
        SetSectionName("LEGO™ Robots")
        SetCardImage("/media/games/microphone.gif")
        // For search engines and link previews, and what lists of pages say.
        SetDescription("Learn how code MIDI sounds on a LEGO Mindstorms robot with the Quorum programming language.")
        SetSummary("how to use sounds with lego robots")
    end

    action Setup
        dq = dq:GetDoubleQuote()
        SetWebPageTitle("LEGO Sound - Quorum Programming Language")
        Title("Tutorial: Using Sounds with LEGO™ Robots")
        Paragraph("This tutorial helps explain the use of sounds with LEGO™ Robots.")
        UsingSoundsWithLEGORobotsInQuorum()
        GeneralInformationAboutSounds()
        PlayingTones()
        PlayingPreDefinedBeeps()
        PlayingAudioClips()
        AdditionalInformation()
    end

    private action UsingSoundsWithLEGORobotsInQuorum
        Section("Using Sounds with LEGO™ Robots in Quorum")
        Paragraph("In this tutorial, we will talk about the different ways a robot can produce sound. In particular, we will discuss:")
        BulletList()
        ListItem("Gerenal information about sounds")
        ListItem("Playing Tones")
        ListItem("Playing Pre-defined Beeps")
        ListItem("Playing Audio Clips")
        CodeExample("use Libraries.Robots.Lego.Sound

Sound sound
sound:PlayTone(440, 200)     //plays a tone corresponding to 440 Hz for 200 milliseconds")
    end

    private action GeneralInformationAboutSounds
        Section("General Information About Sounds")
        Paragraph("The brick has a single speaker on its side, which all sounds are played out of. Quorum has two actions that are used for controlling the volume of the sounds:")
        Paragraph():Code("GetVolume"):Text(" and "):Code("SetVolume"):Text(". Volume levels are represented as percentages of the maximum volume, and thus the range that volume actions work with is between 0 and 100.")
        Paragraph("With the Sound class, we are able to play tones, pre-defined beeps, and even audio clips. These sounds can be used to indicate that a robot is doing something, has reached a certain part in the program, or to simply get the attention of others.")
    end

    private action PlayingTones
        Section("Playing Tones")
        Paragraph("Tones are sounds played at a certain frequency, measured in hertz (Hz). For humans, the audible range for these tones is from around 20 Hz to 20,000 Hz where lower frequencies generate lower pitch sounds and higher frequencies generate higher pitch sounds. An example of how to play a tone in a program is as follows:")
        Paragraph("From the comment in the example, we can see that the "):Code("PlayTone"):Text(" action takes two parameters: the frequency of the tone we want to play and the amount of time, in milliseconds, that we want it to play for.")
    end

    private action PlayingPreDefinedBeeps
        Section("Playing Pre-Defined Beeps")
        Paragraph("Quorum has a set of actions to play different types of beeps. The different actions are as follows:")
        BulletList()
        ListItem("Beep")
        ListItem("BeepTwice")
        ListItem("BeepSequenceUp")
        ListItem("BeepSequenceDown")
        ListItem("Buzz")
        Paragraph("The "):Code("Beep"):Text(" and "):Code("BeepTwice"):Text(" actions do what you might think: beep and beep twice, respectively. The "):Code("BeepSequenceUp"):Text(" plays four tones in quick succession, with each tone being a higher frequency than the last. On the other hand, "):Code("BeepSequenceDown"):Text(" plays the same tones in reverse. The "):Code("buzz"):Text(" action plays a lower frequency tone than any of the others for a short amount of time.")
    end

    private action PlayingAudioClips
        Section("Playing Audio Clips")
        Paragraph("Custom audio clips can be played through the Sound class's "):Code("PlayAudio"):Text(" action. The types of sound files that can be played are limited to .wav files and must be in mono format (as opposed to stereo). The easiest way to put a sound on the robot is to physically pull the SD-card out of the robot and place it into a card reader in the computer. If your computer does not have an SD card reader, you may need to purchase one.")
        Paragraph("On the SD card, there are two partitions, or structures for storing files, one being named FAT32 and the other named EXT4. In our case, the EXT4 partition is where Quorum programs live. We want to transfer our files into the same folder as the Quorum files, which is in the folder /home/lejos/programs. In order to read EXT4, you need to either use Linux or a program to allow you to read that partition format. More information on that can be found at the links below for Mac or PC:")
        BulletList()
        Paragraph("Once you have the file on the robot, the following code will allow the robot to play it:")
        CodeExample("use Libraries.Robots.Lego.Sound
use Libraries.System.File

File audioFile
Sound sound

audioFile:SetPath(" + dq + "sound.wav" + dq + ")
sound:PlayAudio(audioFile)")
    end

    private action AdditionalInformation
        Section("Additional Information")
        Paragraph("For more information on the Sound class, see the "):Link("Sound class documentation", "/Libraries/Robots/Lego/Sound.html"):Text(".")
    end
end
