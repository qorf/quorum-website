use Libraries.Web.Page.QuorumPage

/*
    Tutorial: Getting Started with LEGO™ Robots.
    Converted from the old Lesson page by plan 13's generator: the same
    words, now without Tailwind.
*/
class LegoGettingStartedTutorial is QuorumPage

    on create
        SetLocation("tutorial/robots/legoGettingStarted.html")
        // The name lists and links use, and the series and track it belongs
        // to: its section and picture.
        SetShortTitle("LEGO™ Mindstorms")
        SetSectionName("LEGO™ Robots")
        SetCardImage("/media/robots/robotsStarted.png")
        // For search engines and link previews, and what lists of pages say.
        SetDescription("Learn how to get a LEGO Mindstorms robot prepared to work with the Quorum programming language.")
        SetSummary("how to works with lego robots")
    end

    action Setup
        SetWebPageTitle("Getting Started with LEGO Mindstorms - Quorum Programming Language")
        Title("Tutorial: Getting Started with LEGO™ Robots")
        Paragraph("This tutorial helps us set up our robot and start writing programs for it.")
        AnIntroductionToRobotsInQuorum()
        SettingUpTheRobotForToRunQuorumPrograms()
        MakingARobotProjectInQuorumStudio()
        RunningAProgramOnTheRobot()
        DriverInstallationProblemsOnWindows()
    end

    private action AnIntroductionToRobotsInQuorum
        Section("An Introduction to Robots in Quorum")
        Paragraph("In this tutorial, we will focus on setting up a LEGO™ EV3 Mindstorms robot to run Quorum programs, as well as discuss the fundamentals behind using Quorum to write programs for the robot. Specifically, we will cover:")
        BulletList()
        ListItem("Installing software on the robot that enables it to run Quorum programs using "):Link("lejOS", "http://www.lejos.org/"):Text(" "):Link("firmware.", "https://en.wikipedia.org/wiki/Firmware")
        ListItem("Making a robot project in "):Link("Quorum Studio", "/download.html")
        ListItem("Running a program on the robot.")
    end

    private action SettingUpTheRobotForToRunQuorumPrograms
        Section("Setting up the robot for to run Quorum programs")
        Paragraph("Before we can run a Quorum program on a LEGO™ robot, we have to install a special kind of software called a "):DoubleQuote():Text("firmware."):DoubleQuote():Text(" To accomplish this, we need to use the robot's expansion slot, which accepts a "):Link("microSD", "https://en.wikipedia.org/wiki/Secure_Digital#Micro"):Text(" card (just like many digital cameras and phones). Not all microSD cards are supported. We need one with the following characteristics: 1) must be between 2 and 32 GB of storage, 2) must not be a SDXC type card, 3) must be formatted with the "):Link("FAT32 format", "https://en.wikipedia.org/wiki/File_Allocation_Table"):Text(" (you can use this official SD card "):Link("formatting program", "https://www.sdcard.org/downloads/formatter_4/"):Text(" to accomplish this. There are many cards we can buy, but we have generally had luck with "):Link("this card from Kingston", "https://www.amazon.com/gp/product/B00200K1TS/ref=oh_aui_detailpage_o04_s01?ie=UTF8&psc=1")
        Paragraph("The next step is to install the lejOS firmware on the compatible formatted microSD card. Download the lejOS install files by pushing the button below and then extract the contents onto the SD card."):Text(" "):Link("Download the LEGO™ Robotics Installation Kit for Quorum, version 1.3", "https://sourceforge.net/projects/quorum/files/Quorum%206.0/Robots%201.3.zip/download"):Text(" "):Text("Make sure that the contents of the zip file are directly on the SD card and not in a folder. It should contain the following items (or similar ones) directly:")
        BulletList()
        ListItem("lejos (folder)")
        ListItem("System Volume Information (folder)")
        ListItem("boot.scr")
        ListItem("ejre-8u1-linux-arm-15_may_2015.tar.gz")
        ListItem("hostname")
        ListItem("lejosimage.bz2")
        ListItem("netaddress")
        ListItem("rootfs.cpio.gz")
        ListItem("setup.scr")
        ListItem("ulmage")
        ListItem("version")
        Paragraph("The SD card's contents should look similar after the files are extracted:")
        Image("media/robots/lejOS Install Files.jpg", "This is an image of the lejOS Install Files")
        Paragraph("With the files on the SD card, we can now install the lejOS firmware on the LEGO EV3 brick, which is the central part of the robot that everything connects to. To do this, we need to locate the slot on the side of the brick labeled "):DoubleQuote():Text("SD"):DoubleQuote():Text(" and insert the card, as shown here:")
        Image("media/robots/bricksdslot.jpg", "This is an image of the brick's SD card slot.")
        Paragraph("After the card is inserted, we turn on the robot by holding down the center button found on the front side of the brick, as shown here:")
        Image("media/robots/brickmiddlebutton.jpg", "This is an image of the brick's middle button")
        Paragraph("In about a second, the LED light surrounding the robot's buttons should display a red light, indicating that the robot is starting up, as shown here:")
        Image("media/robots/brick_led.png", "This is an image of the brick led")
        Paragraph("After this occurs, we let go of the button and the robot should start installing the lejOS firmware automatically. Typically, this process takes a few minutes. When the installation finishes, the robot will play a three tone piano jingle. The robot is now ready to run Quorum programs. We can explore the menu on the brick and change settings at this point. The left, right, up, and down keys navigate through menus, while the center button is used to select an option, and the escape button (top left) goes back. Next, we will learn about making Quorum Robot projects.")
    end

    private action MakingARobotProjectInQuorumStudio
        Section("Making a Robot Project in Quorum Studio")
        Paragraph("Using Quorum Studio, we can create a Quorum program from a template designed for a robot. Installation help can be found on the "):Link("getting started page", "/tutorials/language/gettingStarted.html"):Text(". To create a robot project, choose New Project from the File menu, select LEGO from the categories section on the left and "):DoubleQuote():Text("then choose either of the projects below it. When this is done navigate to and press ok or hit return.")
        Image("media/studio/LegoNewProject.png", "This is an image of the new project window with a LEGO project highlighted.")
        Paragraph("We now have a project loaded for constructing LEGOs and below is a screen shot of what our application will look like now once we open the source file. Many tutorials for Quorum go over the code for running various applications, like robots, but in this one we are not going to discuss code. Instead, we are going to move to running our application.")
        Image("media/studio/LegoSource.png", "This is a picture of our source editor open in the LEGO project.")
        Paragraph("This program will cause the robot to play different sounds depending on whether the left or right button of the brick are pressed, or if no button is pressed. Additionally, the program will end if the escape button is pressed. In the next part of this tutorial, we will run this program on the robot.")
    end

    private action RunningAProgramOnTheRobot
        Section("Running a Program on the Robot")
        Paragraph("In order to transfer a program from the computer to the robot, we need to take the following steps:")
        BulletList()
        ListItem("Be sure the robot is turned on.")
        ListItem("Connect the robot to the computer.")
        ListItem("Press the build button in Quorum Studio (or press COMMAND + B or CTRL + B) to send the program to the robot.")
        ListItem("On the robot, navigate to the main menu and select "):DoubleQuote():Text("Programs"):DoubleQuote():Text(".")
        ListItem("Select and run the program "):DoubleQuote():Text("Default.jar"):DoubleQuote():Text(".")
        Image("media/robots/lejOSui1.jpg", "The LEGO brick's main menu is shown. The current selection is ")
        Paragraph("The robot should perform the instructions in the program. The LEGO brick's screen displays three different files: QuorumStandardLibrary.jar, QuorumStandardPlugins.jar, and Default.jar, in that order. These files are needed to run Quorum programs on the robot. Do not delete or change these files. If you do not see all of them , rebuild your project and they should be automatically transferred.")
        Paragraph("Finally, there are a number of additional ideas about running a robot it is good to be aware of. First, A running program can be stopped at any time by pressing the center and down buttons on the brick at the same time. Second, to turn off the robot, press the escape button on the home menu and confirm the shut down by pressing the right button and then the center button. Third, we can change a Quorum project's type at any time, by adjusting its project properties. For example, we can change the name generated from Default to something of our own choosing. Finally, for a complete list of actions available for the robot, please refer to the "):Link("documentation for all Quorum libraries and search for the package Libraries.Robots.Lego.", "/libraries.html")
    end

    private action DriverInstallationProblemsOnWindows
        Section("Driver Installation Problems on Windows")
        Paragraph("Note: If your LEGO robot connects normally to your computer, skip this section. You do not need it.")
        Paragraph("In testing, we have noticed that some Windows machines have difficulties installing the appropriate software for the LEGO robots (called "):DoubleQuote():Text("drivers"):DoubleQuote():Text("). We did not write this software, nor do we control Windows' approach for installing drivers, but in the unlikely case that your computer does not appear to connect to the LEGO robot, we have found that these steps seem to resolve it:")
        BulletList()
        ListItem("Go to the device manager (in the control panel)")
        ListItem("While the EV3 is on, find it in the device manager. It should be located under the "):DoubleQuote():Text("Network adapters"):DoubleQuote():Text(" submenu, listed as "):DoubleQuote():Text("USB Ethernet/RNDIS Gadget"):DoubleQuote():Text(" or something similar. In some cases, it has a number at the end (e.g., #2 at the end)")
        ListItem("Right click or use the keyboard on the device and select "):DoubleQuote():Text("Update Driver Software..."):DoubleQuote()
        ListItem("Select the option to browse your computer for the driver manually")
        ListItem("Select the option to pick from a list of device drivers on your computer")
        ListItem("Click or use the keyboard to get to "):DoubleQuote():Text("Have Disk..."):DoubleQuote():Text(" to open a window where you can point Windows to a specific driver")
        ListItem("Click or use the keyboard to select "):DoubleQuote():Text("Browse..."):DoubleQuote():Text(" and navigate to C:\Windows\System32\DriverStore\FileRepository\"):DoubleQuote():Text("rndis folder with a possibly unique name"):DoubleQuote():Text(". This folder has a very unintuitive name starting with the phrase "):DoubleQuote():Text("rndis"):DoubleQuote():Text(" For example, on one machine, it was called rndis.inf_amd64_1fb2b40d582448a7 during our testing. Once you have found it (the hard part), select or click "):DoubleQuote():Text("Open"):DoubleQuote()
        ListItem("Then click or select OK to close the "):DoubleQuote():Text("Install from Disk"):DoubleQuote():Text(" window")
        ListItem("At this point, this should take us back to the main window and only one driver should be listed. Click Next and it will install the driver.")
        Paragraph("If, for whatever reason, your school has difficulty with getting your LEGO robot up and running, we highly encourage you to send a message to the "):Link("Quorum Google Group", "https://groups.google.com/forum/#!forum/quorum-language"):Text(" and ask for help.")
    end
end
