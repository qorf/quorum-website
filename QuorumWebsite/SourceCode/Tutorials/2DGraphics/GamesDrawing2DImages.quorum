use Libraries.Web.Page.QuorumPage

/*
    Drawing Images.
    Converted from the old Lesson page by plan 13's generator: the same
    words, now without Tailwind.
*/
class GamesDrawing2DImages is QuorumPage
    // A double quote, for code and words that hold one.
    text dq = ""

    on create
        SetLocation("tutorials/games/drawing2DImages.html")
        // The name lists and links use, and the series and track it belongs
        // to: its section and picture.
        SetShortTitle("Drawing Images in 2D")
        SetSectionName("2D Graphics")
        SetCardImage("/media/games/Drawing2D.png")
        // For search engines and link previews, and what lists of pages say.
        SetDescription("Learn about how to draw to the screen in 2D using the Quorum programming language.")
        SetSummary("how to draw 2D images")
    end

    action Setup
        dq = dq:GetDoubleQuote()
        SetWebPageTitle("Drawing Images in 2D - Quorum Programming Language")
        Title("Drawing Images")
        Paragraph("This tutorial tells you how to draw images on the screen in 2 dimensions with Quorum")
        Part2DImageDrawing()
        TryItYourself()
    end

    private action Part2DImageDrawing
        Section("2D Image Drawing")
        Paragraph("In addition to shapes, we can also display pre-made images on the screen. This is useful if we want to use external programs like "):Link("Photoshop", "http://www.photoshop.com"):Text(" or "):Link("Gimp", "http://www.gimp.org"):Text(" (a free alternative) to make images ahead of time or if we want to use digital photos we've taken. Similarly, there is a large amount of free art on the Internet that can be used for commercial or non-commercial purposes (under the creative commons license, for example).")
        Paragraph("Quorum can load such images in two ways, by using: 1) a Drawable directly, or 2) an ImageSheet (a set of combined images). First let us discuss using a Drawable to load images.")
        Paragraph("To load an image we take the same approach we used before by creating a drawable object first:")
        CodeExample("Drawable logo")
        Paragraph("Then we can load an image file stored on our hard drive by calling the Load method of the Drawable class. For this example, we will load the logo for the Quorum Hour of Code:")
        Image("media/games/hourofcode.png", "This is an image of the Hour of code Quorum logo")
        Paragraph("This image is licensed under Creative Commons, so please feel free to download and use it for your own purposes. To load this image, we first need to make a copy of it and place it in the directory of our project. It does not matter where in our project we place it, but for this example we made a new folder named "):DoubleQuote():Text("assets"):DoubleQuote():Text(" in the main project directory:")
        Paragraph("To load the image into our "):DoubleQuote():Text("logo"):DoubleQuote():Text(" drawable object, in our CreateGame action we simply call the Load method of the Drawable class with the path and filename of the file in our project and then call the Add action. (Notice that the path of the file is relative to the root of our main project directory.):")
        CodeExample("logo:Load(" + dq + "assets\hourofcode.png" + dq + ")
Add(logo)")
        Paragraph("So the whole game code looks like this:")
        CodeExample("use Libraries.Game.Game
use Libraries.Game.Graphics.Drawable

class Main is Game
    Drawable logo

    action Main
        StartGame()
    end

    action CreateGame
        logo:Load(" + dq + "assets\hourofcode.png" + dq + ")
        Add(logo)
    end

    action Update(number seconds)
    end
end")
        Paragraph("...and when we Run the program (F6) we get a game window that looks something like this:")
        Image("media/games/displayImage.png", "This is an image of the display image when you run")
        Paragraph("Alternatively, we could use a file class to load the image file into the Drawable. In that case, our code would look like this:")
        CodeExample("use Libraries.Game.Game
use Libraries.Game.Graphics.Drawable
use Libraries.System.File

class Main is Game
    Drawable logo

    action Main
        StartGame()
    end

    action CreateGame
        File file
        file:SetPath(" + dq + "assets\hourofcode.png" + dq + ")
        logo:Load(file)
        Add(logo)
    end

    action Update(number seconds)
    end
end")
        Image("media/games/assets.jpg", "This is an image of the assets in the main project directory")
    end

    private action TryItYourself
        Section("Try it Yourself!")
        Paragraph("Press the blue run button to execute the code in the code editor. Press the red stop button to end the program. Your program will work when the console outputs "):DoubleQuote():Text("Build Successful!"):DoubleQuote()
        CodeEditorFromProject("Draw an image", "Main.quorum", "examples/Games/Drawing2DImages/Main.quorum")
    end
end
