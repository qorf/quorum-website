use Libraries.Web.Page.QuorumPage

/*
    Learn About Calculating the Interquartile Range.
    Converted from the old Lesson page by plan 13's generator: the same
    words, now without Tailwind.
*/
class SummaryIQR is QuorumPage
    // A double quote, for code and words that hold one.
    text dq = ""

    on create
        SetLocation("tutorials/Summarizing/iqr.html")
        // The name lists and links use, and the series and track it belongs
        // to: its section and picture.
        SetShortTitle("Interquartile Range")
        SetSectionName("Descriptive Statistics")
        // For search engines and link previews, and what lists of pages say.
        SetDescription("Learn about interquartile range in the Quorum programming language.")
        SetSummary("calculating the interquartile range")
    end

    action Setup
        dq = dq:GetDoubleQuote()
        SetWebPageTitle("Descriptive Statistics - Quorum Programming Language")
        Title("Learn About Calculating the Interquartile Range")
        Paragraph("This tutorial describes how to calculate the interquartile range")
        CalculatingTheInterquartileRange()
        TryItYourself()
    end

    private action CalculatingTheInterquartileRange
        Section("Calculating the Interquartile Range")
        Paragraph("In data science, the Interquartile Range (IQR) is a measure of variability, based on dividing a data set into quartiles. Specifically, IQR will describe the spread of the middle half of the distribution. For example, say we have a box plot of four quartiles, the IQR would calculate the two middle quartiles, notably Q1 through Q3. The interquartile range provides us a spread between regions of the data.")
        MathFromProject("examples/MathXML/IQR.xml")
        Paragraph("The Interquartile Range is calculated by using a helper action within the DataFrame's class. We will calculate the Interquartile Range (IQR) for the 'Area' column. To do this, we will use our 'frame' object and call the function InterQuartileRange (). In this case we will be calculating the IQR of the area of dry bean classifications. Here is a brief description on how InterQuartileRange() works.")
        Table("IQR Function")
        TableHeader():Cell("Function"):Cell("Description"):Cell("Usage")
        TableRow():Cell("frame:InterQuartileRange()"):Cell("This action sorts the following selected column and calculates the IQR of the column. Note that it can only calculate the IQR of one column at a time."):Cell("frame:InterQuartileRange()")
        Paragraph("Here are other functions that we use in the example:")
        Table("Helper Functions for IQR")
        TableHeader():Cell("Function"):Cell("Description"):Cell("Usage")
        TableRow():Cell("InterQuartileRange range = frame:InterQuartileRange()"):Cell("Initializes the IQR class named range to the frame we created earlier"):Cell("InterQuartileRange range")
        TableRow():Cell("range:GetMinimum()"):Cell("Returns the minimum value that is not an outlier, that is inside the IQR range"):Cell("output " + dq + "Minimum: " + dq + " + range:GetMinimum()")
        TableRow():Cell("range:GetMaximum()"):Cell("Returns the maximum value that is not an outlier, that is inside the IQR range"):Cell("output " + dq + "Maximum: " + dq + " + range:GetMaximum()")
        TableRow():Cell("range:GetInterQuartileRange()"):Cell("Returns the range of the IQR calculated from a given dataset"):Cell("output " + dq + "Range: " + dq + " + range:GetInterQuartileRange()")
        Paragraph("Here is some code on how to calculate the IQR:")
        CodeExample("//We need the DataFrame class to load in files for Data Science operations.
use Libraries.Compute.Statistics.DataFrame
//This is the calculation for the arithmetic mean
use Libraries.Compute.Statistics.Calculations.InterQuartileRange

//Create a DataFrame, which is essentially a table that understands 
//more information about the data that is being loaded.
//Using the default loader is enough for our purposes
DataFrame frame
frame:Load(" + dq + "../Data/Miscellaneous/DryBeans.csv" + dq + ")

    //Tell the frame we want the first column selected
    frame:AddSelectedColumn(0)

InterQuartileRange range = frame:InterQuartileRange()
output " + dq + "Minimum: " + dq + " + range:GetMinimum()
output " + dq + "Maximum: " + dq + " + range:GetMaximum()
output " + dq + "Range: " + dq + " + range:GetInterQuartileRange()")
    end

    private action TryItYourself
        Section("Try it Yourself!")
        Paragraph("Press the blue run button to execute the code in the code editor. Press the red stop button to end the program. Your program will work when the console outputs "):DoubleQuote():Text("Build Successful!"):DoubleQuote()
        CodeEditorWithCode("Calculate the IQR", "//We need the DataFrame class to load in files for Data Science operations.
use Libraries.Compute.Statistics.DataFrame
//This is the calculation for the arithmetic mean
use Libraries.Compute.Statistics.Calculations.InterQuartileRange

//Create a DataFrame, which is essentially a table that understands 
//more information about the data that is being loaded.
//Using the default loader is enough for our purposes
DataFrame frame
frame:Load(" + dq + "data/DryBeans.csv" + dq + ")

//Tell the frame we want the first column selected
frame:AddSelectedColumn(0)

InterQuartileRange range = frame:InterQuartileRange()
output " + dq + "Minimum: " + dq + " + range:GetMinimum()
output " + dq + "Maximum: " + dq + " + range:GetMaximum()
output " + dq + "Range: " + dq + " + range:GetInterQuartileRange()")
        Paragraph("Congrats! We have just learned how to calculate the Interquartile Range! To view the whole file, we can click "):Link("here", "https://github.com/qorf/curriculum/blob/main/Reference/DataScience/Summarizing/SourceCode/CalculateInterquartile.quorum"):Text(".")
    end
end
