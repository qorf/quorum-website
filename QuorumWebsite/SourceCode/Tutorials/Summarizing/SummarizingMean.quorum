use Libraries.Web.Page.QuorumPage

/*
    Learn About Calculating the Mean.
    Converted from the old Lesson page by plan 13's generator: the same
    words, now without Tailwind.
*/
class SummaryMean is QuorumPage
    // A double quote, for code and words that hold one.
    text dq = ""

    on create
        SetLocation("tutorials/Summarizing/mean.html")
        // The name lists and links use, and the series and track it belongs
        // to: its section and picture.
        SetShortTitle("Mean")
        SetSectionName("Descriptive Statistics")
        // For search engines and link previews, and what lists of pages say.
        SetDescription("Learn about mean in the Quorum programming language.")
        SetSummary("calculating the mean")
    end

    action Setup
        dq = dq:GetDoubleQuote()
        SetWebPageTitle("Descriptive Statistics - Quorum Programming Language")
        Title("Learn About Calculating the Mean")
        Paragraph("This tutorial describes how to calculate the mean")
        CalculatingTheMean()
        TryItYourself()
    end

    private action CalculatingTheMean
        Section("Calculating the Mean")
        Paragraph("In data science, the arithmetic mean is known as the average. It is the central value in a finite data set of numbers. We can calculate the mean by finding the sum of all values in a dataset and divide it by the number of values.")
        MathFromProject("examples/MathXML/Mean.xml")
        Paragraph("The arithmetic mean can be calculated in Quorum by using the helper action, Mean() within the DataFrame's class. To do this, we will use our 'frame' object and call the function Mean(). In this case we will be calculating the mean of the perimeter and the area of dry bean classifications. Here is a brief description on how Mean() works.")
        Table("Mean Function")
        TableHeader():Cell("Function"):Cell("Description"):Cell("Usage")
        TableRow():Cell("dataFrameObject:Mean()"):Cell("This action calculates the mean of the column selected from the frame. Note that it can only calculate the mean of one column at a time."):Cell("frame:Mean()")
        Paragraph("Here is some code on how to calculate the mean:")
        CodeExample("//We need the DataFrame class to load in files for Data Science operations.
use Libraries.Compute.Statistics.DataFrame

//Create a DataFrame, which is essentially a table that understands 
//more information about the data that is being loaded.
DataFrame frame

//This loads data relative to the project, so put the dryBeans file in the Data/Miscellaneous folder
frame:Load(" + dq + "../Data/Miscellaneous/DryBeans.csv" + dq + ")

//Tell the frame we want the first column selected
frame:AddSelectedColumn(0)
text someText = " + dq + "Mean of the first column (Area) of dry beans:" + dq + "
output someText
output frame:Mean()")
    end

    private action TryItYourself
        Section("Try it Yourself!")
        Paragraph("Press the blue run button to execute the code in the code editor. Press the red stop button to end the program. Your program will work when the console outputs "):DoubleQuote():Text("Build Successful!"):DoubleQuote()
        CodeEditorFromProject("Calculate the Mean", "Main.quorum", "examples/DataFrames/Mean.quorum")
        Paragraph("Congrats! We have just learned how to calulate the mean! To view the whole file, we can click "):Link("here", "https://github.com/qorf/curriculum/blob/main/Reference/DataScience/Summarizing/SourceCode/BeanMean.quorum"):Text(".")
    end
end
