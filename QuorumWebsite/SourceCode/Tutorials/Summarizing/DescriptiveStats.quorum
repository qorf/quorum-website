use Libraries.Web.Page.QuorumPage

/*
    Descriptive Statistics and the Accessibility Features.
    Converted from the old Lesson page by plan 13's generator: the same
    words, now without Tailwind.
*/
class DescriptiveStatistics is QuorumPage

    on create
        SetLocation("tutorials/Summarizing/descriptiveStatistics.html")
        // The name lists and links use, and the series and track it belongs
        // to: its section and picture.
        SetShortTitle("Descriptive Statistics and Accessibility")
        SetSectionName("Descriptive Statistics")
        // For search engines and link previews, and what lists of pages say.
        SetDescription("Learn about descriptive statistics in the Quorum programming language.")
        SetSummary("descriptive statisics and how to make them accessible")
    end

    action Setup
        SetWebPageTitle("Descriptive Statistics - Quorum Programming Language")
        Title("Descriptive Statistics and the Accessibility Features")
        Paragraph("This tutorial describes how Quorum is makes descriptive statistics more accessible with MathML and MathJax")
        AccessibilityInDescriptiveStatistics()
    end

    private action AccessibilityInDescriptiveStatistics
        Section("Accessibility in Descriptive Statistics")
        Paragraph("When we discuss the idea of summaries, one category that often comes up is called Descriptive Statistics. The idea is that these kinds of statistics do not directly test a hypothesis, or make a prediction, but instead they give us some kind of information. Many of these are taught at relatively young ages. In this section, we provide sample code on how to run each of these statistics. In each case, we will provide a brief description of what the statistic is and then how to run code to calculate it. Finally, because different manufacturers use the same name to describe different types of calculations, we provide the equation used for each calculation in MathML format.")
        Paragraph("One note on Accessibility. MathML is an accessible application we recommend for viewing the equations in this section. We especially recommend users of the NVDA screen reader to download Math Player 4. Math Player is optional and freely available at the following link:")
        Paragraph():Link("Accessible Math Player", "https://docs.wiris.com/mathplayer/en/mathplayer-user-manual.html")
    end
end
