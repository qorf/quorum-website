use Libraries.Web.Page.all
use Libraries.Containers.Array

class ScenePalette is Lesson
    text dq = ""
    dq = dq:GetDoubleQuote()
    text cr = ""
    cr = cr:GetCarriageReturn()

    action Setup
        //html header stuff
        SetWebPageTitle("Changing the Palette - Quorum Programming Language")
        AddDefaultHeaders()
        AddJsonPrism()

        //page header
        Array<Division> divs = InitializeTutorialPage()
        Division bodyDiv = divs:Get(1)
        Division onPageDiv = divs:Get(2)

        Header headDiv
        headDiv:SetClassAttribute("flex flex-col gap-y-2")
        AddHeading(headDiv, "Changing the Palette", 1)
        bodyDiv:Add(headDiv)

        bodyDiv:Add(AddOverview())
        bodyDiv:Add(AddWarmup())
        bodyDiv:Add(AddExplore())
        bodyDiv:Add(AddEngage())
        bodyDiv:Add(AddWrapup())

        Section nextLesson
        nextLesson:AddClassAttribute("flex flex-col gap-y-2")
        bodyDiv:Add(nextLesson)
        WriteNextTutorial(nextLesson)
        onPageDiv:Add(CreateHeadingTableOfContents())
    end

    action AddOverview returns Section
        Section section
        section:AddClassAttribute("flex flex-col gap-y-2")
        AddHeading(section, "Overview", 2)
        section:AddParagraph("The palette is the list of things that can be placed in a scene. Quorum Studio lets anyone 
add their own 2D images to it, give each one a name and a description, and set some default 
properties. Each set of images is a pair of files: a picture holding many small images, and a text 
file that describes them. This page explains that text file, field by field, and how to credit the 
artists whose images are used.")
        AddHeading(section, "Goals", 3)
        UnorderedList list1
        list1:AddClassAttribute("list-disc list-outside pl-8")
        list1:AddListItem("Explain how a tileset's image and its JSON file work together.")
        list1:AddListItem("Describe each field of a tileset file, and which ones are required.")
        list1:AddListItem("Add a tileset to the palette, with a source and license that credit its creator.")
        section:Add(list1)
        return section
    end

    action AddWarmup returns Section
        Section section
        section:AddClassAttribute("flex flex-col gap-y-2")
        AddHeading(section, "Warm up", 2)
        section:AddParagraph("Imagine a sheet of stickers with no labels, and a friend who can't see the sheet asks for " + dq + "the third one in the second row" + dq + ". What would you need to write down so anyone could find, name and describe every sticker on the 
sheet?")
        AddHeading(section, "Vocabulary", 3)
        section:AddParagraph("You will be learning about the following vocabulary words:")
        WebTable table1 = LoadWebTable("Vocabulary", "/html/media/scenes/Palette/Vocabulary.csv")
        section:Add(table1)
        AddHeading(section, "CSTA Standards", 3)
        Paragraph paragraph1
        paragraph1:AddText("The standards are from the ")
        AddLink(paragraph1, "CSTA K-12 Computer Science Standards (2026)", "https://csteachers.org/pk12standards/view/")
        paragraph1:AddText(".")
        section:Add(paragraph1)
        UnorderedList list2
        list2:AddClassAttribute("list-disc list-outside pl-8")
        ListItem item1
        AddBold(item1, "HS-DAT-DC-22")
        item1:AddText(": Create a data dictionary that describes the name, type, and allowable values for each attribute 
and the logical relationships between variables in a dataset.")
        list2:Add(item1)
        ListItem item2
        AddBold(item2, "HS-PRO-PD-14")
        item2:AddText(": Apply appropriate attribution of intellectual property when developing a computing technology.")
        list2:Add(item2)
        ListItem item3
        AddBold(item3, "S1-GMD-PP-08")
        item3:AddText(": Analyze the ethical implications of copyright and intellectual property in game development.")
        list2:Add(item3)
        section:Add(list2)
        return section
    end

    action AddExplore returns Section
        Section section
        section:AddClassAttribute("flex flex-col gap-y-2")
        AddHeading(section, "Explore", 2)
        AddExploreChangingThePalette(section)
        AddExploreWhereTilesetsLive(section)
        AddExploreFindingImagesAndGivingCredit(section)
        AddExploreATilesetFile(section)
        AddExploreTheFieldsForTheWholeTileset(section)
        AddExploreTheFieldsForEachTile(section)
        AddExploreMoreTilesFromTheSameImage(section)
        AddExploreWhatAScreenReaderUserHears(section)
        return section
    end

    action AddExploreChangingThePalette(Section section)
        AddHeading(section, "Changing the Palette", 3)
        section:AddParagraph("Quorum Studio allows adding images to the palette, setting some default properties on them, and 
giving them names and descriptions. These are special image sheets, loaded by Quorum's scene editor 
when Quorum Studio starts. There are defaults, but a project may need different graphics. To add 
them, files tell Quorum Studio what to show and how to label it.")
        section:AddParagraph("This page is about 2D images. 3D models are added in a different way, from a folder named 
Tilesets3D, and aren't covered here.")
    end

    action AddExploreWhereTilesetsLive(Section section)
        AddHeading(section, "Where Tilesets Live", 3)
        section:AddParagraph("Apart from the built-in items, such as the cube and the terrain, every item in the palette comes 
from a pair of files. In the folder where Quorum Studio is installed there is a folder named 
Resources, and in it a folder named Tilesets. Each pair there has:")
        UnorderedList list3
        list3:AddClassAttribute("list-disc list-outside pl-8")
        ListItem item4
        AddBold(item4, "a PNG file,")
        item4:AddText(" which holds a set of images on a grid;")
        list3:Add(item4)
        ListItem item5
        AddBold(item5, "a JSON file,")
        item5:AddText(" a text file that tells Quorum Studio which part of the image is each item, and how to name and 
describe it for screen readers.")
        list3:Add(item5)
        section:Add(list3)
        section:AddParagraph("Quorum Studio reads the Tilesets folder once, when it starts. After adding or changing a tileset, 
close and reopen Quorum Studio to see it in the palette. If a file has a mistake, such as a missing 
X or a number written as 1.0 instead of 1, the whole tileset is skipped with no message. If a 
tileset doesn't appear, check its file first.")
        Paragraph paragraph2
        AddBold(paragraph2, "The game needs the image too.")
        paragraph2:AddText(" A scene saves the path of each tile's image, such as ")
        AddCode(paragraph2, "Resources/Tilesets/Characters.png")
        paragraph2:AddText(", and the game loads it from the project's folder when it runs. A new scene project has its own 
Resources/Tilesets folder with copies of the default tilesets. Copy a new tileset's PNG into the 
project's Resources/Tilesets folder as well, or the game won't find it.")
        section:Add(paragraph2)
    end

    action AddExploreFindingImagesAndGivingCredit(Section section)
        AddHeading(section, "Finding Images, and Giving Credit", 3)
        Paragraph paragraph3
        paragraph3:AddText("There are many free tilesets online. The default images in Quorum Studio come from tilesets found on ")
        AddLink(paragraph3, "itch.io's free tilesets", "https://itch.io/game-assets/free/tag-tileset")
        paragraph3:AddText(". Tilesets you draw yourself can be added too.")
        section:Add(paragraph3)
        section:AddParagraph("Before using someone else's images, read their license. It says what you may do with them and 
whether you must credit the creator. The tileset file has a place to record both, so the credit 
travels with the images.")
    end

    action AddExploreATilesetFile(Section section)
        AddHeading(section, "A Tileset File", 3)
        section:AddParagraph("Once an image is chosen and saved to the Tilesets folder, its JSON file is written and saved there 
too. Here is part of the file for the characters in the default palette. Its image, Characters.png, 
is a grid of 24 by 24 pixel squares: a boy running across the top row and a girl across the bottom 
row.")
        AddJson(section, "/html/sources/tutorials/scenes/ScenePalette/Characters.json")
    end

    action AddExploreTheFieldsForTheWholeTileset(Section section)
        AddHeading(section, "The Fields for the Whole Tileset", 3)
        Paragraph paragraph4
        paragraph4:AddText("This is a regular JavaScript Object Notation (JSON) file. Names are case-sensitive: ")
        AddCode(paragraph4, dq + "X" + dq)
        paragraph4:AddText(" works, ")
        AddCode(paragraph4, dq + "x" + dq)
        paragraph4:AddText(" doesn't.")
        section:Add(paragraph4)
        WebTable table2 = LoadWebTable("The Fields for the Whole Tileset", "/html/media/scenes/Palette/TilesetFields.csv")
        section:Add(table2)
    end

    action AddExploreTheFieldsForEachTile(Section section)
        AddHeading(section, "The Fields for Each Tile", 3)
        Paragraph paragraph5
        paragraph5:AddText("Each tile has a label, such as ")
        AddCode(paragraph5, dq + "0" + dq)
        paragraph5:AddText(", followed by its fields in curly braces. The label only has to be different for each tile; Quorum 
Studio doesn't use it and it isn't shown. Counting up from 0 keeps the file tidy.")
        section:Add(paragraph5)
        WebTable table3 = LoadWebTable("The Fields for Each Tile", "/html/media/scenes/Palette/TileFields.csv")
        section:Add(table3)
    end

    action AddExploreMoreTilesFromTheSameImage(Section section)
        AddHeading(section, "More Tiles from the Same Image", 3)
        section:AddParagraph("When more images are used from the same PNG file, repeat a tile's fields, with a new label, for each 
one. Unlike in the scene editor, where items can go anywhere, the positions here are on a set grid. 
The size of a square is the Width and Height at the top of the file, and X and Y count squares, not 
pixels.")
        Paragraph paragraph6
        paragraph6:AddText("So in the file above, the next image to the right of the boy is at ")
        AddCode(paragraph6, dq + "X" + dq + ": 1")
        paragraph6:AddText(" and ")
        AddCode(paragraph6, dq + "Y" + dq + ": 0")
        paragraph6:AddText(", and the image below him, the girl, is at ")
        AddCode(paragraph6, dq + "X" + dq + ": 0")
        paragraph6:AddText(" and ")
        AddCode(paragraph6, dq + "Y" + dq + ": 1")
        paragraph6:AddText(".")
        section:Add(paragraph6)
    end

    action AddExploreWhatAScreenReaderUserHears(Section section)
        AddHeading(section, "What a Screen Reader User Hears", 3)
        section:AddParagraph("In the palette, the tree reads the tileset's Name, then the Category, then each tile's Name: " + dq + "Characters 2D" + dq + ", " + dq + "Boy" + dq + ", " + dq + "1: Boy" + dq + ". Placing a tile is announced as " + dq + "Placed 1: Boy" + dq + ". This is why clear names and descriptions matter: for someone using a screen reader, they are the 
image.")
        section:AddParagraph("Not every property a scene item can have can be set in a tileset file. What is supported may grow 
over time, based on what people ask for.")
    end

    action AddEngage returns Section
        Section section
        section:AddClassAttribute("flex flex-col gap-y-2")
        AddHeading(section, "Engage", 2)
        section:AddParagraph("For this final section, enjoy working on your terrain. See if you can give your level to a partner 
for feedback.")
        return section
    end

    action AddWrapup returns Section
        Section section
        section:AddClassAttribute("flex flex-col gap-y-2")
        AddHeading(section, "Wrap up", 2)
        section:AddParagraph("The JSON file is a small data dictionary: it says what each value means and which values are 
allowed. Which fields did the computer need, and which were there for people: players, screen reader 
users and the artist who made the images?")
        Paragraph paragraph7
        paragraph7:AddText("This is the last tutorial in the scene series. Back to the start: ")
        AddLink(paragraph7, "Introduction to Scene Editing", "/tutorials/Scenes/intro.html")
        paragraph7:AddText(".")
        section:Add(paragraph7)
        return section
    end

    private action AddBold(WebTag tag, text value)
        StrongText strong
        strong:AddText(value)
        tag:AddNestedTag(strong)
    end

    private action AddCode(WebTag tag, text value)
        CodeBlock code
        code:AddClassAttribute("break-words")
        code:AddText(value)
        tag:AddNestedTag(code)
    end

    private action AddLink(WebTag tag, text name, text address)
        Link link
        link:AddText(name)
        link:SetAddress(address)
        link:SetClassAttribute("underline text-quorum-blue-150")
        tag:AddNestedTag(link)
    end

    private action AddJson(Section section, text path)
        PreformattedText preformatted
        preformatted:AddClassAttribute("whitespace-pre-wrap break-words")
        preformatted:AddClassAttribute("language-json")
        CodeBlock code
        code:AddText(GetTextFromSource(path))
        preformatted:Add(code)
        section:Add(preformatted)
    end

    action GetMetaDescription returns text
        return "Learn about changing the Palette in Quorum Studio"
    end

    action GetSummaryName returns text
        return "Changing the Scene Palette"
    end

    action GetName returns text
        return "Changing the Palette"
    end

    action GetShortDescription returns text
        return "changing the scene Palette in Quorum Studio"
    end

    action GetLocation returns text
        return "tutorials/Scenes/palette.html"
    end

    action GetLinkName returns text
        return "Change the Palette"
    end

    action GetSectionName returns text
        return "Scene Editing"
    end
end
