package Lessons

use Libraries.Web.Page.all
use Libraries.Web.Page.Standards.ComputerScienceStandards2026
use Libraries.Web.Page.Standards.QuorumStandards

class SceneCreation is QuorumPage
    // The site's sets of standards, built once for every page.
    QuorumStandards standards

    on create
        SetLocation("tutorials/Scenes/create.html")
    end

    action Setup
        // For search engines and link previews.
        SetDescription("Learn to create a new scene project in Quorum Studio, and what its scene, terrain and material files hold.")

        Title("Create a Scene Project")

        Overview()
        WarmUp()
        Explore()
        Engage()
        WrapUp()
    end

    action Overview
        Section("Overview")
        Paragraph("This tutorial shows how to make a project with a scene in it. You will use the
New Project dialog, see what files Quorum Studio puts in a scene project, and look inside them. A scene is
not one file but a small family of files: the scene file itself, plus files for any terrain and materials
it uses. Knowing what each file holds makes it easier to understand, share and fix your scenes.")

        Subsection("Goals")
        Goals()
        ListItem("Create a 2D or 3D scene project from a template.")
        ListItem("Describe the folders and files in a scene project, including terrain and material files.")
        ListItem("Explain what a material is and what it is made of.")
    end

    action WarmUp
        Section("Warm up")
        Paragraph("When you start a new document in a word processor, it already has a page size,
fonts and margins. Why do programs give you a starting point like this, instead of a completely empty file?
What would a game need in its starting point?")

        Subsection("Vocabulary")
        Paragraph("You will be learning about the following vocabulary words:")
        Table("Vocabulary", "media/scenes/CreateScene/Vocabulary.csv")

        Subsection("CSTA Standards")
        ComputerScienceStandards2026 computerScience = standards:GetComputerScience2026()
        CoversStandard(computerScience, computerScience:SPECIALTY_1_SOFTWARE_DEVELOPMENT_DESIGN_AND_DEVELOPMENT_3)
        CoversStandard(computerScience, computerScience:HIGH_SCHOOL_DATA_COLLECTION_AND_PREPARATION_22)
        CoversStandard(computerScience, computerScience:SPECIALTY_2_SOFTWARE_DEVELOPMENT_DESIGN_AND_DEVELOPMENT_1)
        StandardsList(computerScience)
    end

    action Explore
        Section("Explore")
        NewProject()
        ProjectContents()
        SceneFile()
        TerrainFiles()
        Materials()
        MaterialFiles()
        OpeningTheScene()
    end

    private action NewProject
        Subsection("Creating a new project")
        Paragraph("To create a new scene project, either choose File, then New Project, or use
the keyboard.")
        Table("Keys for creating and opening a project", "media/scenes/CreateScene/Keys.csv")
        Paragraph("The New Project dialog appears. Its first page is a tree of templates, sorted
into groups: General, Games, Data Science, Sound and Other.")
        Image("media/scenes/CreateScene/SceneCreate1.png", "The New Project dialog, with 3D Scene chosen under Games and its description below.")

        Paragraph("Open Games, then choose either "):Strong("2D Scene"):Text(" or "):Strong("3D Scene"):Text(". This choice matters because Quorum loads the default assets for that kind of game
into your project. As you move through the tree, the dialog describes each template; for 3D Scene it says "):DoubleQuote():Output("A project to get started with using Scenes in 3D."):DoubleQuote()

        Paragraph("Choose "):Strong("Next"):Text(". The second page says which template you chose, for example "):DoubleQuote():Output("Selected Template: 3D Scene"):DoubleQuote():Text(". Type a name in "):Strong("Project Name"):Text(". You can change where the project is saved in "):Strong("Project Location"):Text(", or with "):Strong("Browse..."):Text(". Then choose "):Strong("Ok"):Text(". "):Strong("Back"):Text(" returns to the list of templates.")
        Image("media/scenes/CreateScene/SceneCreate2.png", "The second page of the New Project dialog, with the project name and location fields.")
    end

    private action ProjectContents
        Subsection("What is in a scene project")
        Paragraph("After the project is created, the Projects tab shows it, with several items
made for you:")
        BulletList()
        ListItem():Strong("Scenes"):Text(" holds the file "):Code("Scene.qs"):Text(", the Quorum scene file. It starts with two layers and no items.")
        ListItem():Strong("Resources"):Text(" holds the art for the palette:")
        NestedBulletList()
        ListItem("a 2D project has a "):Strong("Tilesets"):Text(" folder with 6 files: three PNG picture files and three JSON files that describe them;")
        ListItem("a 3D project has a "):Strong("Tilesets3D"):Text(" folder with eight kits of 3D models. Each kit is a JSON file and a folder of models,
with its license.")
        EndNestedList()
        ListItem():Strong("SourceCode"):Text(" holds "):Code("Main.quorum"):Text(". This file has the code that loads and runs the scene. In a 3D project it also
turns on 3D physics.")
    end

    private action SceneFile
        Subsection("Inside a scene file")
        Paragraph("A scene file is plain text in JSON, so you can open it in any text editor and read it.
Here is the start of a new 3D project's "):Code("Scene.qs"):Text(". It lists the scene's layers. Each layer has a name, a camera, its items and its lights:")
        JsonExampleFromFile("sources/tutorials/scenes/SceneFile.json")

        Paragraph("(Some details are left out here to keep it short.) Notice the camera's "):Strong("Position"):Text(", "):Code("[0.0, 3.0, -5.0]"):Text(": that's x, y and z. The camera starts 3 meters up and 5 meters back from the origin,
looking toward it.")

        Paragraph("As you add items in the scene editor and save, each one is added under "):Strong("Items"):Text(", with its kind, its name and its position.")
    end

    private action TerrainFiles
        Subsection("Terrain files")
        Paragraph("When you add a terrain to a 3D scene, Quorum Studio saves it in a folder of its own,
under "):Strong("Scenes/Terrains"):Text(". The first terrain goes in "):Code("Scenes/Terrains/Terrain1"):Text(", the next in "):Code("Terrain2"):Text(", and so on. A new project doesn't have this folder until you add a terrain.")

        Paragraph("A terrain's folder holds:")
        BulletList()
        ListItem():Code("terrain.json"):Text(": a short file describing the terrain, such as how many points each region has and how
far apart they are;")
        ListItem():Strong("one picture for each region"):Text(", such as "):Code("region_0_0.png"):Text(". A terrain is split into square pieces called regions, and each picture stores the
heights of one piece, with each pixel holding the height of one point of ground;")
        ListItem():Strong("a second picture for each painted region"):Text(", such as "):Code("region_0_0_splat.png"):Text(", called a "):Term("splat map"):Text(". It records which material shows where. It only appears once you paint that region.")

        Paragraph("The scene file doesn't copy any of this. It just names the terrain's folder.
Here is a real terrain entry from a scene file:")
        JsonExampleFromFile("sources/tutorials/scenes/TerrainEntry.json")

        Paragraph():Strong("File"):Text(" says where the terrain is. "):Strong("Collision"):Text(" and "):Strong("Friction"):Text(" say how it behaves in a running game. "):Link("Terrain in a Scene", "/tutorials/Scenes/terrain.html"):Text(" covers terrain in detail.")
    end

    private action Materials
        Subsection("What is a material?")
        Paragraph("When you look at a real surface, such as a stone wall or a lawn, you see more than a
color. You see bumps and cracks, shiny spots and dull ones, and dark shadows in the gaps. A "):Term("material"):Text(" describes all of this to the computer, so it can draw a surface that looks real from
any angle and in any light.")

        Paragraph("A material is made of pictures, called "):Term("maps"):Text(", and a few settings. A full set of maps for one surface is called a "):Term("texture set"):Text(":")

        BulletList()
        ListItem("the "):Term("color map"):Text(" is the surface's colors, like a photo of it taken in flat,
even light;")
        ListItem("the "):Term("normal map"):Text(" stores which way each tiny bit of the surface faces, so
bumps and cracks catch the light even though the surface is really flat;")
        ListItem("the "):Term("roughness map"):Text(" says which parts are rough and dull and which are
smooth and shiny;")
        ListItem("the "):Term("ambient occlusion map"):Text(" darkens the gaps and corners that light has
trouble reaching;")
        ListItem("the "):Term("height map"):Text(" says which parts stick up and which sink down. On
terrain, it helps two materials blend naturally where they meet: the higher one shows, so stones poke up
through grass instead of the two just fading into each other.")

        Paragraph("Along with the maps, a material has settings, such as its "):Strong("tile size"):Text(": how big one copy of the pictures is on the ground before it repeats. A simple
material can skip the maps and use just one picture, a plain "):Term("texture"):Text(".")

        Paragraph("Many free texture sets are available online, from sites such as Poly Haven and
ambientCG. Each comes as a folder of pictures, one for each map. Check each set's license before you use it.")
    end

    private action MaterialFiles
        Subsection("Material files")
        Paragraph("Quorum keeps each material in a small JSON file that names its pictures and
lists its settings. A material file sits in the same folder as the pictures it names. Here is one:")
        JsonExampleFromFile("sources/tutorials/scenes/Material.json")

        Paragraph("A terrain can have up to four materials, called "):Term("layers"):Text(", such as grass, rock, sand and dirt, and you paint where each one shows. Quorum
Studio keeps a terrain's list of layers in another JSON file, in "):Strong("Scenes/Materials"):Text(", named after the terrain's folder, such as "):Code("Scenes/Materials/Terrain1.json"):Text(". Like the Terrains folder, Materials doesn't exist until you give a terrain its first
material. "):Link("Terrain Materials and Painting", "/tutorials/Scenes/terrainMaterials.html"):Text(" shows how.")

        Paragraph("Putting it together, a 3D scene project with a painted terrain looks like this:")
        CodeExampleFromFile("sources/tutorials/scenes/ProjectFolders.txt", "")
        Paragraph("The material files for each layer sit wherever their texture pictures are.")
    end

    private action OpeningTheScene
        Subsection("Opening the scene")
        Paragraph("To open the scene, go to the Projects tab (Ctrl+1, or Cmd+1 on a Mac), open the Scenes
folder, and choose "):Code("Scene.qs"):Text(". The scene opens in the editor. Two more tabs, "):Strong("Scene"):Text(" and "):Strong("Palette"):Text(", sit beside the Projects tab. The next tutorial explains them. You can move between
these tabs with the keys in the table above, or click them with the mouse.")

        Paragraph("A scene is made of layers. A new scene has two: "):Strong("Default Layer3D"):Text(" and "):Strong("Default Layer2D"):Text(". Quorum uses layers so different parts of a game can be drawn on top of each other.
For example, a game could have a 3D world with a 2D layer on top showing health or magic. You know, use the
force, Harry.")

        Paragraph("To choose which layer you are working in, go to the Scene tab. Each layer is at
the top of its own branch of the tree. Choose the layer's name, such as Default Layer3D, and press Enter, or
double-click it. The editor switches to that layer.")
    end

    action Engage
        Section("Engage")
        Paragraph("The goal of this activity is to explore how a scene is stored on the computer: to find
every file a scene uses, open each one, and explain what it holds. Work with a partner. Together, create a
new "):Strong("3D Scene"):Text(" project and open its scene. Before changing anything, open "):Code("Scene.qs"):Text(" in a plain text editor, such as Notepad on Windows or TextEdit on a Mac, and save a copy
of it somewhere else. Then, back in Quorum Studio, add one item from the palette, such as a cube, and add a
terrain from the Basic 3D group. Save the scene.")

        Paragraph("Now go looking. Open "):Code("Scene.qs"):Text(" again and compare it with your saved copy: find the new entries for your cube and your
terrain, and the coordinates that say where the cube is. Then use your computer's file browser to open the
project folder, find "):Code("Scenes/Terrains/Terrain1"):Text(", and open "):Code("terrain.json"):Text(". Count the region pictures and check that the count matches what "):Code("terrain.json"):Text(" lists. Finally, write a short data dictionary for the terrain's entry in "):Code("Scene.qs"):Text(": for each field (Class, Name, Description, File, Physics Enabled, Collision and
Friction), write its name, its type (text, number or true/false), and what values you think it allows.
Compare your dictionary with another pair's. Where you disagree, look for evidence in the files or in Quorum
Studio's Properties panel to settle it.")
    end

    action WrapUp
        Section("Wrap up")
        Paragraph("Templates give every scene project the same starting point: a scene file, the
art for the palette, and code that loads the scene. As you build, the project grows: terrains add a folder of
heights each, and materials add small files that point at pictures. Why do you think Quorum stores a scene as
many small files, instead of one big file?")
    end
end
