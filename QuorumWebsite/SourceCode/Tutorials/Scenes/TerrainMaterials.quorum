use Libraries.Web.Page.all
use Libraries.Containers.Array

class TerrainMaterials is Lesson
    text dq = ""
    dq = dq:GetDoubleQuote()
    text cr = ""
    cr = cr:GetCarriageReturn()

    action Setup
        //html header stuff
        SetWebPageTitle("Terrain Materials and Painting - Quorum Programming Language")
        AddDefaultHeaders()
        AddJsonPrism()

        //page header
        Array<Division> divs = InitializeTutorialPage()
        Division bodyDiv = divs:Get(1)
        Division onPageDiv = divs:Get(2)

        Header headDiv
        headDiv:SetClassAttribute("flex flex-col gap-y-2")
        AddHeading(headDiv, "Terrain Materials and Painting", 1)
        bodyDiv:Add(headDiv)

        bodyDiv:Add(AddOverview())
        bodyDiv:Add(AddWarmup())
        bodyDiv:Add(AddExplore())
        bodyDiv:Add(AddEngage())
        bodyDiv:Add(AddWrapup())

        Section nextLesson
        nextLesson:AddClassAttribute("flex flex-col gap-y-2")
        bodyDiv:Add(nextLesson)
        WriteNextTutorial(nextLesson)
        onPageDiv:Add(CreateHeadingTableOfContents())
    end

    action AddOverview returns Section
        Section section
        section:AddClassAttribute("flex flex-col gap-y-2")
        AddHeading(section, "Overview", 2)
        Paragraph paragraph1
        paragraph1:AddText("A new terrain in Quorum Studio is plain gray ground. Real ground is grass,
rock, dirt, sand or snow, often all in one place. In this tutorial you give a
terrain ")
        AddBold(paragraph1, "materials")
        paragraph1:AddText(": descriptions of how a surface looks, made from a set
of images. A terrain can have up to four materials, called ")
        AddBold(paragraph1, "layers")
        paragraph1:AddText(", and
you ")
        AddBold(paragraph1, "paint")
        paragraph1:AddText(" them onto the ground with a brush, the way you would paint a
picture. Along the way you will see how the painting is stored, in images
called splat maps, where to find free materials, and why the people who
made them get a say in how they are used.")
        section:Add(paragraph1)

        AddHeading(section, "Goals", 3)
        section:AddParagraph("You have the following goals for this lesson:")
        UnorderedList list1
        list1:AddClassAttribute("list-disc list-outside pl-8")
        list1:AddListItem("Explain what a material is and what its images do.")
        list1:AddListItem("Explain what a splat map is and how it stores painting.")
        list1:AddListItem("Download free CC0 materials, add them to a terrain as layers, and paint
them onto the ground.")
        list1:AddListItem("Give credit for the textures you use, and know what their licenses allow.")
        section:Add(list1)
        return section
    end

    action AddWarmup returns Section
        Section section
        section:AddClassAttribute("flex flex-col gap-y-2")
        AddHeading(section, "Warm up", 2)
        section:AddParagraph("List everything that makes real ground look the way it does: its color, its
bumps, how shiny or dull it is, whether it is wet. Which of these could a
computer fake with a picture? Which would need more than one picture?")

        AddHeading(section, "Vocabulary", 3)
        section:AddParagraph("You will be learning about the following vocabulary words:")
        WebTable table1 = LoadWebTable("Vocabulary", "/html/media/scenes/Terrain/Materials/Vocabulary.csv")
        section:Add(table1)

        AddHeading(section, "CSTA Standards", 3)
        Paragraph standardsParagraph
        standardsParagraph:AddText("This lesson covers the following standards, from the ")
        AddLink(standardsParagraph, "2026 CSTA K–12 Computer Science Standards", "https://csteachers.org/pk12standards/view/")
        standardsParagraph:AddText(":")
        section:Add(standardsParagraph)

        UnorderedList standards
        standards:AddClassAttribute("list-disc list-outside pl-8")
        AddStandard(standards, "HS-PRO-PD-14", "Apply appropriate attribution of intellectual property when developing a computing technology.")
        AddStandard(standards, "S1-GMD-PP-08", "Analyze the ethical implications of copyright and intellectual property in game development.")
        AddStandard(standards, "S1-GMD-AR-07", "Examine the key architectural features of computing hardware and their implications for game development.")
        AddStandard(standards, "MS-DAT-DC-21", "Evaluate how different levels of precision and granularity in data collection affect accuracy, storage, and analysis.")
        AddStandard(standards, "MS-DAT-DC-22", "Explain how data and its associated metadata can be used to answer questions.")
        section:Add(standards)
        return section
    end

    action AddExplore returns Section
        Section section
        section:AddClassAttribute("flex flex-col gap-y-2")
        AddHeading(section, "Explore", 2)
        Paragraph paragraph1
        paragraph1:AddText("Painting a terrain works much like painting a picture, except that the
paint is made of materials. You choose up to four materials, such as grass,
dirt, rock and gravel, and brush them onto the ground wherever you want
them. Quorum Studio doesn't change the terrain's shape when you paint.
Instead, it keeps a second set of images, one for each region of the
ground, called ")
        AddBold(paragraph1, "splat maps")
        paragraph1:AddText(", that record how much of each material shows
at every point. When the terrain is drawn, each point mixes its materials in
the amounts its splat map says. This tutorial explains each part in turn:
materials, splat maps, where to get materials, adding them as layers, and
painting.")
        section:Add(paragraph1)
        AddMaterials(section)
        AddSplatMaps(section)
        AddWhereGetMaterials(section)
        AddTexturesCostMemory(section)
        AddAddingMaterialsTerrain(section)
        AddDetailsMaterial(section)
        AddPainting(section)
        AddFiles(section)
        AddLicensesGivingCredit(section)
        return section
    end

    action AddMaterials(Section section)
        AddHeading(section, "Materials", 3)
        Paragraph paragraph2
        paragraph2:AddText("A ")
        AddBold(paragraph2, "material")
        paragraph2:AddText(" describes how a surface looks. A simple material is one
image, a ")
        AddBold(paragraph2, "plain texture")
        paragraph2:AddText(", that gives the ground its color. Real ground has
more than color, though: bumps, cracks, shiny wet spots and dull dry ones.
So most materials use a ")
        AddBold(paragraph2, "texture set")
        paragraph2:AddText(": several images of the same
surface, made to work together.")
        section:Add(paragraph2)
        UnorderedList list1
        list1:AddClassAttribute("list-disc list-outside pl-8")
        ListItem item1
        item1:AddText("The ")
        AddBold(item1, "color map")
        item1:AddText(" is the surface's colors, like a photo of it taken in
flat, even light.")
        list1:Add(item1)
        ListItem item2
        item2:AddText("The ")
        AddBold(item2, "normal map")
        item2:AddText(" stores which way each tiny bit of the surface faces,
so bumps and cracks catch the light even though the ground is really
flat.")
        list1:Add(item2)
        ListItem item3
        item3:AddText("The ")
        AddBold(item3, "roughness map")
        item3:AddText(" says which parts are rough and dull and which are
smooth and shiny.")
        list1:Add(item3)
        ListItem item4
        item4:AddText("The ")
        AddBold(item4, "ambient occlusion map")
        item4:AddText(" darkens the gaps and corners that light has
trouble reaching.")
        list1:Add(item4)
        ListItem item5
        item5:AddText("The ")
        AddBold(item5, "height map")
        item5:AddText(" says which parts stick up and which sink down. On a
terrain, it helps two materials blend where they meet: the higher one
shows, so stones poke up through grass instead of the two just fading
into each other.")
        list1:Add(item5)
        section:Add(list1)
        Paragraph paragraph3
        paragraph3:AddText("A material also has settings, such as its ")
        AddBold(paragraph3, "tile size")
        paragraph3:AddText(": how many meters of
ground one copy of the images covers before it repeats. Quorum Studio keeps
each material in a small JSON file beside its images, which names the
images and lists the settings. ")
        AddLink(paragraph3, "Creating a Scene", "/tutorials/Scenes/create.html")
        paragraph3:AddText("
shows what one looks like.")
        section:Add(paragraph3)
    end

    action AddSplatMaps(Section section)
        AddHeading(section, "Splat maps", 3)
        Paragraph paragraph4
        paragraph4:AddText("A terrain is split into square regions (see
")
        AddLink(paragraph4, "Terrain in a Scene", "/tutorials/Scenes/terrain.html")
        paragraph4:AddText("). Each region you
paint gets its own ")
        AddBold(paragraph4, "splat map")
        paragraph4:AddText(", an image saved beside the region's
heights, named like ")
        AddCode(paragraph4, "region_0_0_splat.png")
        paragraph4:AddText(". Each pixel of a splat map
matches one point on the ground. An image pixel has four numbers: red,
green, blue and alpha (how see-through it is). A splat map uses those four
numbers to store how much of layers 1, 2, 3 and 4 show at that point. A
pixel that is all red shows only layer 1; half red and half green shows an
even mix of layers 1 and 2.")
        section:Add(paragraph4)
        section:AddParagraph("This is why a terrain can have at most four layers: a pixel has only four
numbers. It is also why the order of the layers matters. The splat map
remembers " + dq + "layer 2 here" + dq + ", not " + dq + "rock here" + dq + ", so if you swap two layers, the
painting stays where it was but shows the other material. A region you
haven't painted has no splat map at all, which saves space: it simply shows
layer 1 everywhere.")
    end

    action AddWhereGetMaterials(Section section)
        AddHeading(section, "Where to get materials", 3)
        section:AddParagraph("Many websites give texture sets away for free. Two that Quorum Studio
knows especially well are:")
        UnorderedList list2
        list2:AddClassAttribute("list-disc list-outside pl-8")
        ListItem item6
        AddBold(item6, "ambientCG")
        item6:AddText(" (ambientcg.com). Its sets are named like ")
        AddCode(item6, "Ground037_1K-PNG")
        item6:AddText(",
and the images inside end in ")
        AddCode(item6, "_Color")
        item6:AddText(", ")
        AddCode(item6, "_NormalGL")
        item6:AddText(", ")
        AddCode(item6, "_Roughness")
        item6:AddText(",
")
        AddCode(item6, "_AmbientOcclusion")
        item6:AddText(" and ")
        AddCode(item6, "_Displacement")
        item6:AddText(".")
        list2:Add(item6)
        ListItem item7
        AddBold(item7, "Poly Haven")
        item7:AddText(" (polyhaven.com). Its sets are named like ")
        AddCode(item7, "rock_wall")
        item7:AddText(", and
the images end in ")
        AddCode(item7, "_diff_1k")
        item7:AddText(", ")
        AddCode(item7, "_nor_gl_1k")
        item7:AddText(", ")
        AddCode(item7, "_rough_1k")
        item7:AddText(", ")
        AddCode(item7, "_ao_1k")
        item7:AddText(" and
")
        AddCode(item7, "_disp_1k")
        item7:AddText(".")
        list2:Add(item7)
        section:Add(list2)
        Paragraph paragraph5
        paragraph5:AddText("Other free libraries work too, such as ")
        AddBold(paragraph5, "ShareTextures")
        paragraph5:AddText("
(sharetextures.com), ")
        AddBold(paragraph5, "cgbookcase")
        paragraph5:AddText(" (cgbookcase.com) and ")
        AddBold(paragraph5, "3D Textures")
        paragraph5:AddText("
(3dtextures.me). Their color maps often end in ")
        AddCode(paragraph5, "_BaseColor")
        paragraph5:AddText(" or ")
        AddCode(paragraph5, "_Albedo")
        paragraph5:AddText(",
which Quorum Studio also recognizes, along with ")
        AddCode(paragraph5, "_Diffuse")
        paragraph5:AddText(". Every texture on
these five sites is offered under the ")
        AddBold(paragraph5, "CC0")
        paragraph5:AddText(" license, which means you can
use it in any project, even one you sell, without asking. Licenses can
change, though, so check the license on the page you download from, and
keep a note of where each texture came from for your game's credits.")
        section:Add(paragraph5)
        Paragraph paragraph6
        AddBold(paragraph6, "Download PNG or JPG images,")
        paragraph6:AddText(" not EXR: Quorum Studio reads ")
        AddCode(paragraph6, ".png")
        paragraph6:AddText(" and
")
        AddCode(paragraph6, ".jpg")
        paragraph6:AddText(" files. ")
        AddBold(paragraph6, "1K")
        paragraph6:AddText(" (1024 by 1024 pixels) is plenty for ground that
repeats. Unzip each set into its own folder inside a folder named
")
        AddCode(paragraph6, "Textures")
        paragraph6:AddText(" at the top of your project.")
        section:Add(paragraph6)
        section:AddParagraph("A plain image, such as a photo of grass you took yourself, works too, as a
plain texture.")
    end

    action AddTexturesCostMemory(Section section)
        AddHeading(section, "Textures cost memory", 3)
        section:AddParagraph("Each texture set is loaded into the graphics card's memory, and some
graphics cards have much less than others. A 1K set uses about ten megabytes;
a 4K set uses sixteen times as much. Four 4K sets on one terrain can be more
than a small laptop or a phone can handle. Choosing the smallest images
that look good is part of making a game run well on more computers.")
    end

    action AddAddingMaterialsTerrain(Section section)
        AddHeading(section, "Adding materials to a terrain", 3)
        Paragraph paragraph7
        paragraph7:AddText("Select the terrain, then move into the Properties panel with
")
        AddKey(paragraph7, "Ctrl+P")
        paragraph7:AddText(" (")
        AddKey(paragraph7, "Cmd+P")
        paragraph7:AddText(" on Mac). The panel's sections for a terrain are
Terrain, Materials, Brush, Generate and Physics. A new terrain's Materials
section says:")
        section:Add(paragraph7)
        section:AddParagraph(dq + "No materials. The ground is plain." + dq)
        Paragraph paragraph8
        paragraph8:AddText("Below that is the ")
        AddBold(paragraph8, "Add material...")
        paragraph8:AddText(" button.")
        section:Add(paragraph8)
        AddHeading(section, "Adding the first layer", 4)
        OrderedList list3
        list3:AddClassAttribute("list-decimal list-outside pl-8")
        ListItem item8
        item8:AddText("Activate ")
        AddBold(item8, "Add material...")
        item8:AddText(".")
        list3:Add(item8)
        ListItem item9
        item9:AddText("In the file chooser, choose a texture set's ")
        AddBold(item9, "color map")
        item9:AddText(", such as
")
        AddCode(item9, "Ground037_1K-PNG_Color.png")
        item9:AddText(" or ")
        AddCode(item9, "rock_wall_diff_1k.png")
        item9:AddText(". You can also
choose a plain image, or a material file (")
        AddCode(item9, ".json")
        item9:AddText(") you already have.")
        list3:Add(item9)
        ListItem item10
        item10:AddText("Quorum Studio guesses the set's other maps by their names, writes a material file
beside the images, and gives the terrain its first layer. You can change these later. It says what
it did, for example:")
        Paragraph paragraph9
        paragraph9:AddText(dq + "Added Ground037 as layer 1, tiles 3 units. It covers the whole ground.
Add another material to paint with. Found normal, roughness, ambient
occlusion and height maps." + dq)
        item10:Add(paragraph9)
        Paragraph paragraph10
        paragraph10:AddText("If a map was not found, it says so: " + dq + "No height map found." + dq + " That is fine.
A set works without some of its maps, and you can choose them later in
Details.")
        item10:Add(paragraph10)
        list3:Add(item10)
        section:Add(list3)
        section:AddParagraph("The first layer covers all of the ground. Each layer after it shows only
where you paint it.")
        AddHeading(section, "Layers", 4)
        Paragraph paragraph11
        paragraph11:AddText("A ")
        AddBold(paragraph11, "layer")
        paragraph11:AddText(" is one of the terrain's materials, in a numbered slot from 1 to 4. The layers are like paint pots: adding a material fills the next empty pot, and painting decides where on the ground each pot's paint goes. Layer
1 is special. It is the ground's starting color, so it covers everywhere
that hasn't been painted with something else. Every other layer shows only
where you paint it. The number of a layer matters because the splat maps
store painting by number, so choose your layers in an order that makes
sense, such as grass first and then the materials you'll add on top of it.")
        section:Add(paragraph11)
        section:AddParagraph("Add up to four layers the same way as the first. A new layer shows nowhere
until it is painted, and it becomes the layer the Paint tool paints next:")
        section:AddParagraph(dq + "Added rock_wall as layer 2, tiles 3 units. Paint it with the Paint tool." + dq)
        section:AddParagraph("A fifth is refused: " + dq + "This terrain has four materials, which is the most it
can have." + dq)
        AddHeading(section, "Each layer's row in the panel", 4)
        section:AddParagraph("Each layer has a row with:")
        UnorderedList list4
        list4:AddClassAttribute("list-disc list-outside pl-8")
        list4:AddListItem("its name, such as " + dq + "Layer 2: rock_wall" + dq + ";")
        list4:AddListItem("its file, such as " + dq + "File: rock_wall.json, a texture set" + dq + ";")
        ListItem item11
        AddBold(item11, "Tile size")
        item11:AddText(": how many meters of ground one copy of the texture covers.
A texture set starts at 3 and a plain texture at 4. Smaller numbers make
the pattern smaller and repeat more often; larger numbers stretch it;")
        list4:Add(item11)
        ListItem item12
        AddBold(item12, "Choose...")
        item12:AddText(": give this layer a different material. Where it was painted
stays the same;")
        list4:Add(item12)
        ListItem item13
        AddBold(item13, "Remove")
        item13:AddText(": take the layer away. Where it was painted, layer 1 shows
instead: " + dq + "rock_wall removed. Where it was painted, Ground037 shows." + dq + "
Removing the last layer makes the ground plain again;")
        list4:Add(item13)
        ListItem item14
        AddBold(item14, "Details...")
        item14:AddText(": see and change the material's images and values (below).")
        list4:Add(item14)
        section:Add(list4)
        Paragraph paragraph12
        paragraph12:AddText("Under the rows is ")
        AddBold(paragraph12, "Blend softness")
        paragraph12:AddText(", from 0.01 to 1: how softly texture set
layers fade into each other where they meet. Small numbers give sharp edges,
such as rocks poking through grass; larger numbers blend more gently.")
        section:Add(paragraph12)
        Paragraph paragraph13
        paragraph13:AddText("Adding, choosing and removing layers can be undone with ")
        AddKey(paragraph13, "Ctrl+Z")
        paragraph13:AddText(" (")
        AddKey(paragraph13, "Cmd+Z")
        paragraph13:AddText("
on Mac). Changes to the tile size and blend softness can't be undone yet.")
        section:Add(paragraph13)
    end

    action AddDetailsMaterial(Section section)
        AddHeading(section, "Details: what is inside a material", 3)
        Paragraph paragraph14
        paragraph14:AddText("Activate ")
        AddBold(paragraph14, "Details...")
        paragraph14:AddText(" on a layer. A group named " + dq + "Material details" + dq + ", with
the layer's number and name, opens under the rows. Only one layer's details
show at a time; ")
        AddBold(paragraph14, "Close details")
        paragraph14:AddText(" closes them.")
        section:Add(paragraph14)
        section:AddParagraph("It shows:")
        UnorderedList list5
        list5:AddClassAttribute("list-disc list-outside pl-8")
        ListItem item15
        AddBold(item15, "Name")
        item15:AddText(": a field. The layer's row uses this name.")
        list5:Add(item15)
        ListItem item16
        AddBold(item16, "File")
        item16:AddText(": where the material file is in the project.")
        list5:Add(item16)
        list5:AddListItem("Whether other layers use the same file, such as " + dq + "Also used by 2 other
layers in this scene. Changes here change it everywhere." + dq)
        ListItem item17
        AddBold(item17, "Kind")
        item17:AddText(": " + dq + "texture set" + dq + " or " + dq + "plain texture" + dq + ".")
        list5:Add(item17)
        ListItem item18
        AddBold(item18, "One line per map")
        item18:AddText(", each with ")
        AddBold(item18, "Choose...")
        item18:AddText(" and ")
        AddBold(item18, "Clear")
        item18:AddText(":")
        UnorderedList list6
        list6:AddClassAttribute("list-disc list-outside pl-8")
        list6:AddListItem("for a texture set: color, normal, roughness, ambient occlusion and
height maps;")
        list6:AddListItem("each line names its file, or says " + dq + "none" + dq + ".")
        item18:AddNestedTag(list6)
        list5:Add(item18)
        ListItem item19
        AddBold(item19, "Normal map convention")
        item19:AddText(": OpenGL or DirectX. Normal maps come in two
styles that store " + dq + "up" + dq + " in opposite ways. If the bumps on the ground look
lit from the wrong side, switch this. Files ending in ")
        AddCode(item19, "_NormalGL")
        item19:AddText(" or
")
        AddCode(item19, "_nor_gl")
        item19:AddText(" are OpenGL; ")
        AddCode(item19, "_NormalDX")
        item19:AddText(" and ")
        AddCode(item19, "_nor_dx")
        item19:AddText(" are DirectX.")
        list5:Add(item19)
        ListItem item20
        AddBold(item20, "Find maps by name")
        item20:AddText(": looks again in the color map's folder for any map
that is " + dq + "none" + dq + ".")
        list5:Add(item20)
        ListItem item21
        AddBold(item21, "Make plain")
        item21:AddText(": turns a texture set into a plain texture, keeping its
color map.")
        list5:Add(item21)
        ListItem item22
        AddBold(item22, "Roughness")
        item22:AddText(" and ")
        AddBold(item22, "Metallic")
        item22:AddText(", from 0 to 1. Roughness is only used when
there is no roughness map; if there is one, Quorum Studio says " + dq + "Not used: the
roughness map sets it." + dq)
        list5:Add(item22)
        section:Add(list5)
        section:AddParagraph("When you change a map, Quorum Studio repacks the set, which takes about a second,
and says so: " + dq + "Packing the texture set... Normal map is now
rock_wall_nor_gl_1k.png." + dq + " Every map in a set must be the same size. If it
isn't, Quorum Studio refuses and says both sizes, for example " + dq + "rock_wall_rough_2k.png
is 2048 by 2048, but the color map is 1024 by 1024. Maps in a set must be the
same size." + dq)
        Paragraph paragraph15
        paragraph15:AddText("A number field takes its new value when you leave it with ")
        AddKey(paragraph15, "Tab")
        paragraph15:AddText(" or click
somewhere else. (")
        AddKey(paragraph15, "Enter")
        paragraph15:AddText(" doesn't take the value yet.)")
        section:Add(paragraph15)
        section:AddParagraph("Every change in Details can be undone.")
    end

    action AddPainting(Section section)
        AddHeading(section, "Painting", 3)
        Paragraph paragraph16
        paragraph16:AddText("Painting is how you decide where each layer shows. You choose the ")
        AddBold(paragraph16, "Paint")
        paragraph16:AddText("
tool and a layer, and a circle called the ")
        AddBold(paragraph16, "brush")
        paragraph16:AddText(" appears on the ground.
Wherever you move the brush and paint, the chosen layer soaks in: a little
at first, and more the longer you paint, with the brush's middle painting
more than its edge. Under the hood, each stroke changes the splat maps of
the regions the brush touches. Painting needs ")
        AddBold(paragraph16, "two or more layers")
        paragraph16:AddText(",
because layer 1 is already everywhere. With only one, the Paint tool says
" + dq + "Paint needs two or more materials. Add them in the Materials section." + dq)
        section:Add(paragraph16)
        AddHeading(section, "Painting, step by step", 4)
        OrderedList list7
        list7:AddClassAttribute("list-decimal list-outside pl-8")
        ListItem item23
        item23:AddText("Select the terrain and press ")
        AddKey(item23, "Alt+6")
        item23:AddText(" (")
        AddKey(item23, "Option+6")
        item23:AddText(" on Mac) to choose the
Paint tool. A ring on the ground shows the brush.")
        list7:Add(item23)
        ListItem item24
        item24:AddText("Choose which layer to paint, in either of two ways:")
        UnorderedList list8
        list8:AddClassAttribute("list-disc list-outside pl-8")
        ListItem item25
        item25:AddText("in the Brush section, the ")
        AddBold(item25, "Paint layer")
        item25:AddText(" buttons, each named with its
layer, such as " + dq + "Layer 2, rock_wall" + dq + ";")
        list8:Add(item25)
        ListItem item26
        item26:AddText("press ")
        AddKey(item26, "Alt+L")
        item26:AddText(" (")
        AddKey(item26, "Option+L")
        item26:AddText(" on Mac) to move to the next layer.")
        list8:Add(item26)
        item24:AddNestedTag(list8)
        list7:Add(item24)
        ListItem item27
        item27:AddText("Move the brush with the mouse or the arrow keys. Change its size with
")
        AddKey(item27, "Alt+=")
        item27:AddText(" and ")
        AddKey(item27, "Alt+-")
        item27:AddText(", and how fast it paints with ")
        AddKey(item27, "Alt+]")
        item27:AddText(" and ")
        AddKey(item27, "Alt+[")
        item27:AddText(".")
        list7:Add(item27)
        ListItem item28
        item28:AddText("Hold ")
        AddKey(item28, "Space")
        item28:AddText(", or hold the left mouse button and drag, to paint. Let go to
finish the stroke.")
        list7:Add(item28)
        ListItem item29
        AddKey(item29, "Escape")
        item29:AddText(" during a stroke cancels it and puts the ground back. ")
        AddKey(item29, "Escape")
        item29:AddText("
again leaves the tool.")
        list7:Add(item29)
        section:Add(list7)
        Paragraph paragraph17
        paragraph17:AddText("Each stroke is one step for ")
        AddKey(paragraph17, "Ctrl+Z")
        paragraph17:AddText(" and ")
        AddKey(paragraph17, "Ctrl+Y")
        paragraph17:AddText(" (")
        AddKey(paragraph17, "Cmd+Z")
        paragraph17:AddText(" and ")
        AddKey(paragraph17, "Cmd+Y")
        paragraph17:AddText(" on
Mac). Saving the scene with ")
        AddKey(paragraph17, "Ctrl+S")
        paragraph17:AddText(" (")
        AddKey(paragraph17, "Cmd+S")
        paragraph17:AddText(") saves the painting.")
        section:Add(paragraph17)
        WebTable table1 = LoadWebTable("Keys for painting", "/html/media/scenes/Terrain/Materials/Keys.csv")
        section:Add(table1)
        section:AddParagraph("All of these keys can be changed in Quorum Studio's key map.")
        AddHeading(section, "Screen reader conventions", 4)
        section:AddParagraph("Quorum Studio tells a screen reader what the brush is doing as you work, so
you can paint without seeing the screen:")
        UnorderedList list9
        list9:AddClassAttribute("list-disc list-outside pl-8")
        ListItem item30
        AddBold(item30, "Choosing the tool")
        item30:AddText(" says the tool and where the brush is, such as
" + dq + "Paint tool. Paint brush at 0.0, 0.0, ground height 0.0, slope 0 degrees,
Ground037, size 5.0" + dq + ". The name at the end, here Ground037, is the layer
that shows most under the brush's middle.")
        list9:Add(item30)
        ListItem item31
        AddBold(item31, "Each press of an arrow key")
        item31:AddText(" moves the brush and says the height of the
ground under it, such as " + dq + "Height 1.2" + dq + ", or " + dq + "Off the ground" + dq + " if the brush
has moved past the terrain's edge.")
        list9:Add(item31)
        ListItem item32
        AddBold(item32, "Letting go of an arrow key")
        item32:AddText(" says the brush's full description again,
with its place, height, slope and the main layer under it. Moving the
brush across a painted area and listening for the layer name is how you
find where each layer is.")
        list9:Add(item32)
        ListItem item33
        AddBold(item33, "Choosing a layer")
        item33:AddText(" with ")
        AddKey(item33, "Alt+L")
        item33:AddText(" says it, such as " + dq + "Paint layer 2,
rock_wall" + dq + ".")
        list9:Add(item33)
        ListItem item34
        AddBold(item34, "Finishing a stroke")
        item34:AddText(" says what you did, such as " + dq + "Painted rock_wall.
Height 2.1" + dq + ". A canceled stroke says " + dq + "Stroke canceled" + dq + ".")
        list9:Add(item34)
        section:Add(list9)
    end

    action AddFiles(Section section)
        AddHeading(section, "The files", 3)
        Paragraph paragraph18
        paragraph18:AddText("Materials are saved as files in your project, so you can open and read them.
Every one is a plain ")
        AddCode(paragraph18, ".json")
        paragraph18:AddText(" text file, and its ")
        AddCode(paragraph18, dq + "Format" + dq)
        paragraph18:AddText(" says what kind of
file it is. Paths inside a file are written relative to that file's own
folder, so a texture set's folder can be copied to another project with its
material file inside it.")
        section:Add(paragraph18)
        AddPlainText(section, "/html/sources/tutorials/scenes/TerrainMaterials/ProjectFiles.txt")
        Paragraph paragraph19
        AddBold(paragraph19, "A material")
        paragraph19:AddText(" (one layer's look) is written beside its images:")
        section:Add(paragraph19)
        AddJson(section, "/html/sources/tutorials/scenes/TerrainMaterials/Material.json")
        Paragraph paragraph20
        paragraph20:AddText("A plain texture has ")
        AddCode(paragraph20, dq + "Texture" + dq)
        paragraph20:AddText(" instead of the maps.")
        section:Add(paragraph20)
        Paragraph paragraph21
        AddBold(paragraph21, "A terrain material")
        paragraph21:AddText(" (the whole ground's look) is in ")
        AddCode(paragraph21, "Scenes/Materials")
        paragraph21:AddText(",
named after the terrain's folder. It lists the layers in order, by their
material files:")
        section:Add(paragraph21)
        AddJson(section, "/html/sources/tutorials/scenes/TerrainMaterials/TerrainMaterial.json")
        Paragraph paragraph22
        AddBold(paragraph22, "The splat maps")
        paragraph22:AddText(" are the ")
        AddCode(paragraph22, "region_X_Z_splat.png")
        paragraph22:AddText(" images beside the
terrain's heights, one for each region you have painted (see " + dq + "Splat maps" + dq + "
above).")
        section:Add(paragraph22)
        section:AddParagraph("Saving never deletes files. If you remove a layer or a whole material, the
old files stay in the project until you delete them yourself.")
    end

    action AddLicensesGivingCredit(Section section)
        AddHeading(section, "Licenses and giving credit", 3)
        Paragraph paragraph23
        paragraph23:AddText("Every image was made by someone, and they decide how others may use it. That
decision is the image's ")
        AddBold(paragraph23, "license")
        paragraph23:AddText(". Before you use a texture, find its
license.")
        section:Add(paragraph23)
        UnorderedList list10
        list10:AddClassAttribute("list-disc list-outside pl-8")
        ListItem item35
        AddBold(item35, "AmbientCG")
        item35:AddText(" and ")
        AddBold(item35, "Poly Haven")
        item35:AddText(" share their textures under
")
        AddBold(item35, "CC0")
        item35:AddText(" (Creative Commons Zero). CC0 means the creator gave up their
rights: you can use, change and share the images, even in a game you
sell, without asking.")
        list10:Add(item35)
        ListItem item36
        AddBold(item36, "Other sites")
        item36:AddText(" may only allow personal use, or require you to credit
the creator, or forbid selling. Read the license on the page you
download from, and keep a copy of it with the textures.")
        list10:Add(item36)
        ListItem item37
        AddBold(item37, "An image you found with a web search")
        item37:AddText(" is usually not yours to use.
Being easy to download doesn't make it free to use.")
        list10:Add(item37)
        section:Add(list10)
        Paragraph paragraph24
        paragraph24:AddText("Even when credit isn't required, giving it is good practice. It tells
players where the art came from, thanks the people who made it, and lets
others find it. A simple way is a ")
        AddCode(paragraph24, "Credits.txt")
        paragraph24:AddText(" file in your project, and a
credits screen in your game:")
        section:Add(paragraph24)
        AddPlainText(section, "/html/sources/tutorials/scenes/TerrainMaterials/Credits.txt")
    end

    action AddEngage returns Section
        Section section
        section:AddClassAttribute("flex flex-col gap-y-2")
        AddHeading(section, "Engage", 2)
        section:AddParagraph("In this activity, you and a partner download free materials, add them to a
terrain, and paint a small landscape with the brush. The goal is to go
through the whole process a game artist uses: finding materials with a
license that allows your use, bringing them into a project, and painting
them where they belong. Here are four CC0 materials from ambientCG that
work well together:")
        UnorderedList list1
        list1:AddClassAttribute("list-disc list-outside pl-8")
        ListItem item1
        AddLink(item1, "Grass 001", "https://ambientcg.com/view?id=Grass001")
        item1:AddText(": short green grass,
for layer 1;")
        list1:Add(item1)
        ListItem item2
        AddLink(item2, "Ground 037", "https://ambientcg.com/view?id=Ground037")
        item2:AddText(": damp earth with
moss;")
        list1:Add(item2)
        ListItem item3
        AddLink(item3, "Rock 030", "https://ambientcg.com/view?id=Rock030")
        item3:AddText(": gray rock;")
        list1:Add(item3)
        ListItem item4
        AddLink(item4, "Gravel 022", "https://ambientcg.com/view?id=Gravel022")
        item4:AddText(": small gray
pebbles, good for a path.")
        list1:Add(item4)
        section:Add(list1)
        section:AddParagraph("Bring them into your project like this:")
        OrderedList list2
        list2:AddClassAttribute("list-decimal list-outside pl-8")
        ListItem item5
        item5:AddText("On each material's page, download the ")
        AddBold(item5, "1K-JPG")
        item5:AddText(" file, such as
")
        AddCode(item5, "Grass001_1K-JPG.zip")
        item5:AddText(". It is about 10 megabytes.")
        list2:Add(item5)
        ListItem item6
        item6:AddText("In your project's folder, make a folder named ")
        AddCode(item6, "Textures")
        item6:AddText(" if there isn't
one, and unzip each download into its own folder inside it, such as
")
        AddCode(item6, "Textures/Grass001_1K-JPG")
        item6:AddText(".")
        list2:Add(item6)
        ListItem item7
        item7:AddText("In Quorum Studio, select the terrain, press ")
        AddKey(item7, "Ctrl+P")
        item7:AddText(" (")
        AddKey(item7, "Cmd+P")
        item7:AddText(" on Mac)
to move into the Properties panel, and go to the Materials section.")
        list2:Add(item7)
        ListItem item8
        item8:AddText("Activate ")
        AddBold(item8, "Add material...")
        item8:AddText(" and choose the color map, the image whose
name ends in ")
        AddCode(item8, "_Color")
        item8:AddText(", such as ")
        AddCode(item8, "Grass001_1K-JPG_Color.jpg")
        item8:AddText(". Quorum Studio
finds the other images in the folder by their names.")
        list2:Add(item8)
        list2:AddListItem("Add the other three the same way, in the order above, so grass is layer
1.")
        section:Add(list2)
        Paragraph paragraph1
        paragraph1:AddText("Now paint. Together, sketch a plan for a small area: for example, a gravel
path running across the grass, a patch of earth around it, and a rocky spot
in one corner. One partner paints the path and the earth, and the other
paints the rock, using the Paint tool and ")
        AddKey(paragraph1, "Alt+L")
        paragraph1:AddText(" to switch layers. As you
paint, the partner who isn't painting checks the work against the plan,
either by watching or by moving the brush across the area and listening for
the layer under it. Save the scene, then write a ")
        AddCode(paragraph1, "Credits.txt")
        paragraph1:AddText(" in your
project that lists all four materials, their creator, ambientCG, their
addresses and their license, CC0.")
        section:Add(paragraph1)
        return section
    end

    action AddWrapup returns Section
        Section section
        section:AddClassAttribute("flex flex-col gap-y-2")
        AddHeading(section, "Wrap up", 2)
        UnorderedList list1
        list1:AddClassAttribute("list-disc list-outside pl-8")
        list1:AddListItem("A material is not a picture. It is a small file of settings that names
several pictures. Why do you think Quorum Studio keeps materials as separate
files instead of putting everything into the scene?")
        list1:AddListItem("A texture you can download for free is not always free to use. What
would you do if a texture you loved had a license that didn't allow your
game?")
        section:Add(list1)
        return section
    end

    private action AddStandard(UnorderedList list, text identifier, text standard)
        ListItem item
        AddBold(item, identifier)
        item:AddText(": " + standard)
        list:Add(item)
    end

    private action AddBold(WebTag tag, text value)
        StrongText strong
        strong:AddText(value)
        tag:AddNestedTag(strong)
    end

    private action AddCode(WebTag tag, text value)
        CodeBlock code
        code:AddClassAttribute("break-words")
        code:AddText(value)
        tag:AddNestedTag(code)
    end

    private action AddKey(WebTag tag, text value)
        KeyboardInput key
        key:AddText(value)
        tag:AddNestedTag(key)
    end

    private action AddLink(WebTag tag, text name, text address)
        Link link
        link:AddText(name)
        link:SetAddress(address)
        link:SetClassAttribute("underline text-quorum-blue-150")
        tag:AddNestedTag(link)
    end

    private action AddJson(Section section, text path)
        PreformattedText preformatted
        preformatted:AddClassAttribute("whitespace-pre-wrap break-words")
        preformatted:AddClassAttribute("language-json")
        CodeBlock code
        code:AddText(GetTextFromSource(path))
        preformatted:Add(code)
        section:Add(preformatted)
    end

    private action AddPlainText(Section section, text path)
        Preformatter plain
        plain:SetIsQuorumCode(false)
        plain:SetShowLineNumbers(false)
        section:Add(AllowWrapping(plain:GeneratePreformattedCode(GetTextFromSource(path))))
    end

    //wraps long lines, so code never scrolls sideways on a narrow screen (WCAG 1.4.10, reflow)
    private action AllowWrapping(PreformattedText code) returns PreformattedText
        code:AddClassAttribute("whitespace-pre-wrap break-words")
        return code
    end

    action GetMetaDescription returns text
        return "Learn to give a terrain materials in Quorum Studio, paint them onto the ground, and credit the textures you use."
    end

    action GetSummaryName returns text
        return "Terrain Materials and Painting"
    end

    action GetName returns text
        return "Terrain Materials and Painting"
    end

    action GetShortDescription returns text
        return "giving a terrain materials and painting them"
    end

    action GetLocation returns text
        return "tutorials/Scenes/terrainMaterials.html"
    end

    action GetLinkName returns text
        return "Terrain Materials and Painting"
    end

    action GetSectionName returns text
        return "Scene Editing"
    end
end
