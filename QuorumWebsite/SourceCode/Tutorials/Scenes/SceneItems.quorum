use Libraries.Web.Page.all
use Libraries.Containers.Array

class SceneItems is Lesson
    text dq = ""
    dq = dq:GetDoubleQuote()
    text cr = ""
    cr = cr:GetCarriageReturn()

    action Setup
        //html header stuff
        SetWebPageTitle("Add and Remove Items in a Scene - Quorum Programming Language")
        AddDefaultHeaders()

        //page header
        Array<Division> divs = InitializeTutorialPage()
        Division bodyDiv = divs:Get(1)
        Division onPageDiv = divs:Get(2)

        Header headDiv
        headDiv:SetClassAttribute("flex flex-col gap-y-2")
        AddHeading(headDiv, "Add and Remove Items in a Scene", 1)
        bodyDiv:Add(headDiv)

        bodyDiv:Add(AddOverview())
        bodyDiv:Add(AddWarmup())
        bodyDiv:Add(AddExplore())
        bodyDiv:Add(AddEngage())
        bodyDiv:Add(AddWrapup())

        Section nextLesson
        nextLesson:AddClassAttribute("flex flex-col gap-y-2")
        bodyDiv:Add(nextLesson)
        WriteNextTutorial(nextLesson)
        onPageDiv:Add(CreateHeadingTableOfContents())
    end

    action AddOverview returns Section
        Section section
        section:AddClassAttribute("flex flex-col gap-y-2")
        AddHeading(section, "Overview", 2)
        section:AddParagraph("One of the most common things we do in a scene editor is add and remove items. The
basic idea is simple: we choose an item in the Palette, on the left, and place it in the scene editor, on the
right, with the mouse or the keyboard. We can also move the camera so we can see exactly where things go. On
this page we start with cameras, which decide what we see, and then add and remove items, first in a 2D scene
and then in a 3D scene.")

        AddHeading(section, "Goals", 3)
        section:AddParagraph("You have the following goals for this lesson:")
        UnorderedList goals
        goals:AddClassAttribute("list-disc list-outside pl-8")
        goals:AddListItem("Understand what a camera is in computer graphics, and how orthographic and perspective cameras differ")
        goals:AddListItem("Add items to a 2D and a 3D scene from the Palette, with the keyboard or the mouse")
        goals:AddListItem("Select an item, including one of several items in the same spot")
        goals:AddListItem("Delete an item, and undo a change")
        section:Add(goals)
        return section
    end

    action AddWarmup returns Section
        Section section
        section:AddClassAttribute("flex flex-col gap-y-2")
        AddHeading(section, "Warm up", 2)
        section:AddParagraph("Think of a board game you know, like chess or checkers. If you had to tell someone
over the phone where to put every piece at the start, what would you say? How would you say where a piece goes,
and what would you do if two pieces were on the same square?")

        AddHeading(section, "Vocabulary", 3)
        section:AddParagraph("You will be learning about the following vocabulary words:")
        WebTable vocabularyTable = LoadWebTable("Vocabulary", "/html/media/scenes/AddRemoveItems/Vocabulary.csv")
        section:Add(vocabularyTable)

        AddHeading(section, "CSTA Standards", 3)
        Paragraph standardsParagraph
        standardsParagraph:AddText("This lesson covers the following standards, from the ")
        AddLink(standardsParagraph, "2026 CSTA K–12 Computer Science Standards", "https://csteachers.org/pk12standards/view/")
        standardsParagraph:AddText(":")
        section:Add(standardsParagraph)

        UnorderedList standards
        standards:AddClassAttribute("list-disc list-outside pl-8")
        AddStandard(standards, "S1-GMD-PP-09", "Develop a game project collaboratively within a diverse team.")
        AddStandard(standards, "S1-SWD-DD-03", "Use integrated development environment (IDE) features to streamline software development, including code editing, debugging, version control, and project management.")
        section:Add(standards)
        return section
    end

    action AddExplore returns Section
        Section section
        section:AddClassAttribute("flex flex-col gap-y-2")
        AddHeading(section, "Explore", 2)
        AddCameras(section)
        AddOrthographic(section)
        AddPerspective(section)
        Add2DScene(section)
        Add3DScene(section)
        AddSelecting(section)
        AddRemoving(section)
        return section
    end

    action AddCameras(Section section)
        AddHeading(section, "What is a camera?", 3)
        Paragraph intro
        intro:AddText("Before we add anything, it helps to know how a game decides what to show. A scene can be
much bigger than your screen, and it can have things all around it, in front, behind, above and below. The game
needs a way to pick which part to show. That's the job of the ")
        AddBold(intro, "camera")
        intro:AddText(".")
        section:Add(intro)
        section:AddParagraph("A camera in a game is not a real camera. It's more like a pair of eyes, or a window
you look through. It has a place where it is, and a direction it faces. Whatever is in front of it, and not too
far away, shows up on the screen. Anything outside its view, or behind it, doesn't show up at all, even though
it's still in the scene. If you want the player to see something, the camera has to be pointed at it.")
        Paragraph editorCamera
        editorCamera:AddText("Every layer in a Quorum scene has its own camera. The editor also has its own ")
        AddBold(editorCamera, "editor camera")
        editorCamera:AddText(", which you move around while you build. The game's camera can be somewhere else
entirely, so what you see while building isn't always what the player sees.")
        section:Add(editorCamera)
        section:AddParagraph("There are two kinds of camera: orthographic and perspective.")
    end

    action AddOrthographic(Section section)
        AddHeading(section, "Orthographic cameras", 3)
        Paragraph intro
        intro:AddText("An ")
        AddBold(intro, "orthographic")
        intro:AddText(" camera shows everything at the same size, no matter how near or far it is. Imagine
standing on a chair and looking straight down at a board game on the floor. Every square on the board looks the
same size, and the pieces don't get bigger or smaller as they move around. Maps, building plans and board games
all show the world this way.")
        section:Add(intro)
        section:AddParagraph("Because nothing shrinks with distance, an orthographic camera is a good fit for
flat, 2D games, where you want every tile and character to look the same everywhere on the screen. In Quorum,
every 2D layer uses an orthographic camera. In the editor, the grey outline you'll see in a 2D scene shows
exactly what this camera can see.")
    end

    action AddPerspective(Section section)
        AddHeading(section, "Perspective cameras", 3)
        Paragraph intro
        intro:AddText("A ")
        AddBold(intro, "perspective")
        intro:AddText(" camera works the way eyes do. Things close to it look big, and things far away look
small. Think of standing between railroad tracks: the rails seem to get closer together and meet far away, even
though they never really do. A tree right in front of you can look taller than a mountain in the distance.")
        section:Add(intro)
        Paragraph field
        field:AddText("This is what makes a 3D world feel deep and real, so 3D games use a perspective camera. In
Quorum, every 3D layer uses one. A perspective camera also has a ")
        AddBold(field, "field of view")
        field:AddText(": how wide it can see, like the difference between looking through a narrow paper tube and
looking with your whole eyes open. A wider field of view shows more of the world at once, but everything in it
looks smaller.")
        section:Add(field)
    end

    action Add2DScene(Section section)
        AddHeading(section, "Changing the 2D Scene", 3)
        section:AddParagraph("The first step to adding an item is selecting the Palette tab. By default, the
Palette contains a series of tiles, like water, stone, or transitions between these. We use the mouse, or the
arrow keys, to move up or down in the Palette like any tree.")
        section:AddParagraph("To add an item, whether it is a monster, a player, or a floor tile, we press Enter
on it in the Palette. This makes a preview of the item in the scene editor. We can move the preview with the
arrow keys, and press Enter again to place it. A screen reader says " + dq + "Placed" + dq + " and the item's
name, for example " + dq + "Placed Water" + dq + ". To leave a preview without placing it, press Escape. With
the mouse, we can drag an item from the Palette onto the scene instead.")
        section:AddParagraph("The example below shows a large grey grid with lines marking the grid spots. In the
bottom left corner of a grey square outline is a small blue square, which in this case is a water tile. The grey
outline shows what the 2D layer's orthographic camera sees, if it is not moved for the game.")
        AddZoomImage(section, "/media/scenes/AddRemoveItems/GridCursor.png", "A grid with one water tile at the bottom left corner of the camera's grey outline, at 0, 0.")
        section:AddParagraph("To describe this in text, the grey outline is 768 by 576 pixels. Each small square
is 32 by 32 pixels, so to find the number of squares in the grid we divide by 32 in each direction: 24 squares
across and 18 up. This also means the water tile takes up 1,024 pixels in the game, and the camera views
442,368 pixels by default. Put another way, each tile is much smaller than the space the camera sees, even
before zooming out.")
        section:AddParagraph("In the same way, we can use the arrow keys to add many tiles. Below is an example
with 12 water tiles in a 2 by 6 block, meaning 2 tiles wide and 6 tall. Running this game would show only the
tiles in the bottom left corner, with the camera pointed at the grey square with the sizes given above. Someone
playing the game would see a blue rectangle in the bottom left, and the rest would be the grey background.")
        AddZoomImage(section, "/media/scenes/AddRemoveItems/WaterTiles.png", "A block of water tiles, 2 wide and 6 tall, starting at 0, 0.")
        section:AddParagraph("Other items can be placed on a tile, such as a character or a monster. Use
Command+1 on Mac, or Control+1 on Windows, to go back to the project window. Focus returns to the Palette tab
where you left it. Then use the arrow keys and Enter, or drag and drop with the mouse. The following shows a
character and a red mouthed monster in the middle of the camera's view.")
        AddZoomImage(section, "/media/scenes/AddRemoveItems/Characters.png", "The water tiles, with a boy and a Red Mouth monster about a quarter of the way into the camera's view.")
    end

    action Add3DScene(Section section)
        AddHeading(section, "Changing the 3D Scene", 3)
        section:AddParagraph("Adding items to a 3D scene is much like adding them to a 2D scene. The main
difference is that 3D graphics use a third coordinate, z, for how far toward or away from us an item is. 3D
items are placed from the same Palette. By default it has a Basic 3D group with primitives such as cubes,
spheres and cylinders, and also lights, sounds and terrain, in addition to 3D shapes related to nature, space,
castles, or roads.")
        section:AddParagraph("While you build, you look through the editor's perspective camera. The mouse can
change how we look at a 3D scene in several ways:")
        UnorderedList mouse
        mouse:AddClassAttribute("list-disc list-outside pl-8")
        AddBoldItem(mouse, "", "Look around:", " hold the right mouse button and drag. The camera stays in place
but turns toward where you move the mouse. If you drag toward the right, the camera turns to the right.")
        AddBoldItem(mouse, "", "Orbit:", " hold the middle mouse button and drag. The camera circles around a
point in the distance, so you keep looking at that point from a new place.")
        AddBoldItem(mouse, "", "Pan:", " hold Shift and the middle mouse button, and drag.")
        AddBoldItem(mouse, "", "Zoom:", " use the scroll wheel to move in and out.")
        section:Add(mouse)

        Paragraph keyboard
        keyboard:AddText("With the keyboard, we change the camera by selecting it, with Option+F on Mac or Alt+F
on Windows, and then changing its distance, direction, zoom and field of view in the Properties panel. The ")
        AddLink(keyboard, "Navigation and Keys", "/tutorials/Scenes/navigate.html")
        keyboard:AddText(" page has the details.")
        section:Add(keyboard)

        section:AddParagraph("Past the camera, items are added the same way as in 2D: choose one in the Palette,
press Enter, move the preview, and press Enter to place it. The example below shows a cylinder in the middle of
the grid.")
        AddZoomImage(section, "/media/scenes/AddRemoveItems/3DGridCursor.png", "A cylinder on the 3D grid, at 0, 1, 0.")

        section:AddParagraph("While the preview or a selected item is in the 3D editor, the arrow keys move it:")
        UnorderedList arrows
        arrows:AddClassAttribute("list-disc list-outside pl-8")
        arrows:AddListItem("Left and Right move it along x;")
        arrows:AddListItem("Up and Down move it forward and backward, along z;")
        arrows:AddListItem("Command+Up and Command+Down on Mac, or Control+Up and Control+Down on Windows, move it up and down, along y.")
        section:Add(arrows)
        section:AddParagraph("When you let go of an arrow key, a screen reader says what else is in that spot and
the position, for example " + dq + "Cube, 3 1 0" + dq + ". Then press Enter to place the item.")
        AddZoomImage(section, "/media/scenes/AddRemoveItems/CylinderAndCube.png", "A cylinder at 0, 1, 0 and a cube at 3, 1, 0.")
        AddZoomImage(section, "/media/scenes/AddRemoveItems/SphereAndCube.png", "A sphere in the middle of the camera's view, with a cube to its right.")

        Paragraph terrain
        terrain:AddText("A terrain, the ground of a 3D world, is added from Basic 3D in the same way, but it
works a little differently: it always sits at the origin. See ")
        AddLink(terrain, "Terrain in a Scene", "/tutorials/Scenes/terrain.html")
        terrain:AddText(".")
        section:Add(terrain)
    end

    action AddSelecting(Section section)
        AddHeading(section, "Selecting Items", 3)
        section:AddParagraph("To go to the scene editor from elsewhere in Quorum Studio, press Command+2 on Mac,
or Control+2 on Windows. Then move the cursor with the arrow keys to the tile or item you want, and press Enter
to select what is there. With the mouse, click the item. You can also select an item from the scene tree.")
        section:AddParagraph("If there are several items in the same spot, press Tab and Shift+Tab to move
between them. A screen reader says each item's name and where it is in the list, for example " + dq
+ "Red Mouth, 1 of 2: 0, 0, 0" + dq + ".")
        section:AddParagraph("When an item is selected, its properties show in the Properties panel, on the
right side of the scene tab. Press Command+P on Mac, or Control+P on Windows, to move into the panel. Press
Escape or Enter there to come back to the scene. The image below shows a red mouthed monster when selected.")
        AddZoomImage(section, "/media/scenes/AddRemoveItems/DeleteMonster.png", "A selected Red Mouth monster at 0, 0, with its properties in the Properties panel on the right.")
        section:AddParagraph("If you have selected an item and decide not to change it, press Escape to leave the
selection.")
    end

    action AddRemoving(Section section)
        AddHeading(section, "Removing Items", 3)
        section:AddParagraph("Once we have selected the item we want, we press Delete to remove it. On Windows,
Delete or Backspace both work. On Mac, use the Delete key (or Forward Delete).")
        section:AddParagraph("Deleting an item in 3D is the same. You go to the item, press Tab if there is more
than one, and press Delete.")
        AddZoomImage(section, "/media/scenes/AddRemoveItems/Cube.png", "A single cube, a little to the right of the middle of the view.")
        section:AddParagraph("Made a mistake? Adding and deleting can be undone with Quorum Studio's Undo, and
redone with Redo. Changes typed into the Properties panel can't be undone yet, so check them before moving on.")
    end

    action AddEngage returns Section
        Section section
        section:AddClassAttribute("flex flex-col gap-y-2")
        AddHeading(section, "Engage", 2)

        Paragraph first
        first:AddText("In this activity, you and a partner build a small 3D scene together, taking turns, and say
out loud everything you do as you do it. The goal is to get comfortable adding, placing and removing items in
3D, with whichever you prefer of the keyboard or the mouse, and to practice explaining a scene in words. Don't
use terrain yet; you'll build your own ground instead. Partner A starts: open a new 3D scene, add a ")
        AddBold(first, "Cube")
        first:AddText(" from Basic 3D, and turn it into a flat floor. Select it, go to the Properties panel, and
set its scale to 10, 0.2 and 10, so it becomes a thin slab 10 meters on each side. Give it a color, such as
green for grass or gray for stone. Then add three or four items on the floor, such as shapes from Basic 3D,
models from one of the kits, and a Point Light. As you work, describe each step to your partner: which item you
chose, how you're moving it (which keys, or what you're doing with the mouse), and where it ends up, using
coordinates, such as " + dq + "a tree at 2, 0, 3, near the left edge" + dq + ".")
        section:Add(first)

        section:AddParagraph("Your partner listens without touching the computer, and sketches the scene from
above on paper, using only what they hear. Then switch. Partner B adds three or four more items while describing
their steps the same way, placing each one in relation to what's already there, such as " + dq + "a rock 2
meters to the right of the tree" + dq + ". Partner B also removes one of Partner A's items, saying which one and
how they found and selected it, and Partner A crosses it off the sketch. When you're done, compare both sketches
with the scene in Quorum Studio. Use Ctrl+Shift+1 on an item to hear its exact position. Where a sketch is
wrong, work out together which part of the description was missing or unclear.")
        return section
    end

    action AddWrapup returns Section
        Section section
        section:AddClassAttribute("flex flex-col gap-y-2")
        AddHeading(section, "Wrap up", 2)
        section:AddParagraph("Adding and removing items is the start of building any scene. Choosing a spot with
the cursor, selecting what is there, and pressing one key to place or remove it works the same way in 2D and 3D.
Next, we look at all of the keys the scene editor has for moving around, and for moving, turning and sizing
items.")
        return section
    end

    private action AddStandard(UnorderedList list, text identifier, text standard)
        ListItem item
        AddBold(item, identifier)
        item:AddText(": " + standard)
        list:Add(item)
    end

    private action AddBoldItem(UnorderedList list, text before, text bold, text after)
        ListItem item
        item:AddText(before)
        AddBold(item, bold)
        item:AddText(after)
        list:Add(item)
    end

    private action AddBold(WebTag tag, text value)
        StrongText strong
        strong:AddText(value)
        tag:AddNestedTag(strong)
    end

    private action AddLink(WebTag tag, text name, text address)
        Link link
        link:AddText(name)
        link:SetAddress(address)
        link:SetClassAttribute("underline text-quorum-blue-150")
        tag:AddNestedTag(link)
    end

    private action AddZoomImage(Section section, text path, text alt)
        Image image = section:AddImage(path, alt)
        image:AddAttribute("data-zoom", "")
    end

    action GetMetaDescription returns text
        return "Learn about cameras, and how to add, select and remove items in 2D and 3D scenes in Quorum Studio."
    end

    action GetSummaryName returns text
        return "Add and Remove Items in Scenes"
    end

    action GetName returns text
        return "Add and Remove Items in Scenes"
    end

    action GetShortDescription returns text
        return "adding and removing items in scenes in Quorum Studio"
    end

    action GetLocation returns text
        return "tutorials/Scenes/items.html"
    end

    action GetLinkName returns text
        return "Add and Remove Items"
    end

    action GetSectionName returns text
        return "Scene Editing"
    end
end
