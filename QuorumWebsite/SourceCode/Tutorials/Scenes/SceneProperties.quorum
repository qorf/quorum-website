use Libraries.Web.Page.all
use Libraries.Containers.Array

class SceneProperties is Lesson
    text dq = ""
    dq = dq:GetDoubleQuote()
    text cr = ""
    cr = cr:GetCarriageReturn()
    Preformatter preformatter //helper

    action Setup
        //html header stuff
        SetWebPageTitle("Properties and Physics - Quorum Programming Language")
        AddDefaultHeaders()

        //page header
        Array<Division> divs = InitializeTutorialPage()
        Division bodyDiv = divs:Get(1)
        Division onPageDiv = divs:Get(2)

        Header headDiv
        headDiv:SetClassAttribute("flex flex-col gap-y-2")
        AddHeading(headDiv, "Properties and Physics", 1)
        bodyDiv:Add(headDiv)

        bodyDiv:Add(AddOverview())
        bodyDiv:Add(AddWarmup())
        bodyDiv:Add(AddExplore())
        bodyDiv:Add(AddEngage())
        bodyDiv:Add(AddWrapup())

        Section nextLesson
        nextLesson:AddClassAttribute("flex flex-col gap-y-2")
        bodyDiv:Add(nextLesson)
        WriteNextTutorial(nextLesson)
        onPageDiv:Add(CreateHeadingTableOfContents())
    end

    action AddOverview returns Section
        Section section
        section:AddClassAttribute("flex flex-col gap-y-2")
        AddHeading(section, "Overview", 2)
        section:AddParagraph("Items on the screen are more than pictures. Behind the scenes, they have
properties like their position, their size, and more. This page is about what these properties are and how
we can change them in Quorum Studio's Properties panel to adjust our game, including the physics settings
that decide how items fall, slide and bounce. Let's learn about causing chaos with properties and physics.")

        AddHeading(section, "Goals", 3)
        section:AddParagraph("You have the following goals for this lesson:")
        UnorderedList goals
        goals:AddClassAttribute("list-disc list-outside pl-8")
        goals:AddListItem("Explain the basic ideas of physics: force, mass, gravity, friction and bounce, and where they come from")
        goals:AddListItem("Describe how Quorum runs physics, and the difference between Unmovable, Nonresponsive and Responsive items")
        goals:AddListItem("Find the Properties panel and move into and out of it with the keyboard")
        goals:AddListItem("Change physics properties and gravity, and predict how an item will behave")
        section:Add(goals)
        return section
    end

    action AddWarmup returns Section
        Section section
        section:AddClassAttribute("flex flex-col gap-y-2")
        AddHeading(section, "Warm up", 2)
        section:AddParagraph("Think of a ball, a brick and a balloon. Make a short list of the facts you would
need to write down about each one so that a computer could make it act like the real thing. Which facts are
about where it is, which are about how it looks, and which are about how it moves?")

        AddHeading(section, "Vocabulary", 3)
        section:AddParagraph("You will be learning about the following vocabulary words:")
        WebTable vocabularyTable = LoadWebTable("Vocabulary", "/html/media/scenes/Properties/Vocabulary.csv")
        section:Add(vocabularyTable)

        AddHeading(section, "CSTA Standards", 3)
        Paragraph standardsParagraph
        standardsParagraph:AddText("This lesson covers the following standards, from the ")
        AddLink(standardsParagraph, "2026 CSTA K–12 Computer Science Standards", "https://csteachers.org/pk12standards/view/")
        standardsParagraph:AddText(":")
        section:Add(standardsParagraph)

        UnorderedList standards
        standards:AddClassAttribute("list-disc list-outside pl-8")
        AddStandard(standards, "HS-DAT-DI-26", "Evaluate a data simulation or visualization to answer a data question, inform decision-making, and identify potential limitations.")
        AddStandard(standards, "HS-DAT-DC-24", "Evaluate different approaches to verifying consistency and compliance with expected data types, values, and ranges.")
        section:Add(standards)
        return section
    end

    action AddExplore returns Section
        Section section
        section:AddClassAttribute("flex flex-col gap-y-2")
        AddHeading(section, "Explore", 2)
        AddHowThingsMove(section)
        AddPhysicsInQuorum(section)
        AddChangingGravity(section)
        AddPropertiesPanel(section)
        AddWhatThePanelShows(section)
        AddObjectProperties(section)
        AddHavingFun(section)
        return section
    end

    action AddHowThingsMove(Section section)
        AddHeading(section, "Physics: how things move", 3)
        Paragraph intro
        intro:AddText("When you drop a ball, it falls. When you roll it across a carpet, it slows down and
stops. When it hits the floor, it bounces, but never quite as high as where it started. These everyday things
follow rules, and the study of those rules is called ")
        AddBold(intro, "physics")
        intro:AddText(".")
        section:Add(intro)

        Paragraph newton
        newton:AddText("Many of these rules were first written down by ")
        AddBold(newton, "Isaac Newton")
        newton:AddText(", an English scientist who lived from 1643 to 1727. In 1687 he published a book called
Philosophiæ Naturalis Principia Mathematica (Mathematical Principles of Natural Philosophy), commonly known as
the Principia. In it he explained how things move with three simple ideas, now called Newton's laws of motion:")
        section:Add(newton)

        OrderedList laws
        laws:AddClassAttribute("list-decimal list-outside pl-8")
        AddBoldOrderedItem(laws, "Things keep doing what they're doing.", " A ball sitting still stays still,
and a ball rolling keeps rolling in a straight line, unless a force pushes or pulls it. A rolling ball only
stops because something, like the carpet, is pushing back on it.")
        AddBoldOrderedItem(laws, "A bigger push makes a bigger change, and heavier things change less.", " Push
a toy car gently and it rolls slowly; push it hard and it speeds off. Push a real car just as hard and it
barely moves, because it has much more mass.")
        AddBoldOrderedItem(laws, "Every push gets pushed back.", " When you push on a wall, the wall pushes back
on you just as hard. That's why you can push yourself off a wall on roller skates.")
        section:Add(laws)

        Paragraph gravity
        gravity:AddText("Newton also explained ")
        AddBold(gravity, "gravity")
        gravity:AddText(": every object pulls on every other object. The Earth is so big that its pull is the
one we notice, and it pulls everything toward the ground.")
        section:Add(gravity)

        section:AddParagraph("A game's physics uses the same ideas. Each item can have a few physical properties:")
        UnorderedList properties
        properties:AddClassAttribute("list-disc list-outside pl-8")
        ListItem force
        AddBold(force, "Force")
        force:AddText(" is a push or a pull, measured in ")
        AddBold(force, "newtons")
        force:AddText(". Gravity is a force, and so is a kick, a jump, or wind.")
        properties:Add(force)
        AddBoldItem(properties, "", "Mass", " is how much stuff an item has, measured in kilograms. The more
mass, the harder it is to start the item moving, or to stop it. A surprising fact: without air in the way,
heavy and light things fall at the same speed, because gravity pulls harder on heavier things by just the
right amount.")
        AddBoldItem(properties, "", "Friction", " is how much an item resists sliding. Ice has very little
friction; sandpaper has a lot.")
        AddBoldItem(properties, "", "Restitution", " is how bouncy an item is. A lump of clay has almost none, a
rubber ball has a lot.")
        section:Add(properties)
    end

    action AddPhysicsInQuorum(Section section)
        AddHeading(section, "Physics in Quorum", 3)
        Paragraph intro
        intro:AddText("In Quorum, physics is turned on for each layer of a game, and then for each item. An
item takes part in physics only if its ")
        AddBold(intro, "Physics Enabled")
        intro:AddText(" box is checked. Each item with physics also has a ")
        AddBold(intro, "responsiveness")
        intro:AddText(", which says how physics treats it:")
        section:Add(intro)

        UnorderedList kinds
        kinds:AddClassAttribute("list-disc list-outside pl-8")
        AddBoldItem(kinds, "", "Unmovable", " items never move, no matter what hits them, but other items bump
into them. Floors, walls and the ground are unmovable. Items start out unmovable.")
        AddBoldItem(kinds, "", "Nonresponsive", " items can move, but forces don't push them. Your code sets how
fast they go, and gravity doesn't pull them. They push other items out of the way, but nothing pushes them
back. A moving platform or an elevator is a good example: it keeps to its path even when the player lands on it.")
        AddBoldItem(kinds, "", "Responsive", " items are pushed around by everything: gravity, forces, and
other items bumping into them. Balls, crates and players are usually responsive. Choosing Responsive gives an
item a mass of 1 kilogram if it had none.")
        section:Add(kinds)

        Paragraph steps
        steps:AddText("Physics doesn't run continuously, the way the real world does. Instead, Quorum moves
time forward in small steps, called ")
        AddBold(steps, "time steps")
        steps:AddText(", of 1/60 of a second, which is 60 steps every second. In each step, it works out every
force on each responsive item, updates how fast the item is going, moves it a little, and then checks whether
anything is now touching or overlapping. If two items have hit each other, it pushes them apart and makes them
bounce or slide.")
        section:Add(steps)

        section:AddParagraph("A few things follow from working in steps:")
        UnorderedList follows
        follows:AddClassAttribute("list-disc list-outside pl-8")
        follows:AddListItem("Your game draws its pictures in frames. Quorum runs at most one physics step per
frame, so if a game draws fewer than 60 frames a second, its physics runs in slow motion instead of jumping ahead.")
        follows:AddListItem("Items are drawn smoothly between their last two steps, so motion doesn't look jerky.")
        follows:AddListItem("A very small, very fast item can sometimes pass right through a thin wall, because
in one step it is in front of the wall and in the next it is already past it.")
        follows:AddListItem("When two items touch, Quorum uses the bouncier of their two restitutions, and
multiplies their two frictions together. So a ball with no bounce still bounces off a bouncy floor, and
anything slides on a floor with no friction.")
        section:Add(follows)
    end

    action AddChangingGravity(Section section)
        AddHeading(section, "Changing gravity", 3)
        Paragraph intro
        intro:AddText("Gravity in a Quorum game is not on until your code sets it. The ")
        AddCode(intro, "Main.quorum")
        intro:AddText(" file that comes with a 3D scene project turns on physics and sets gravity for you,
right after it loads the scene:")
        section:Add(intro)
        section:Add(AllowWrapping(preformatter:GeneratePreformattedCode(GetTextFromSource("/html/sources/tutorials/scenes/SceneProperties/Gravity.quorum"))))

        Paragraph numbers
        AddCode(numbers, "SetGravity3D")
        numbers:AddText(" takes three numbers, for x, y and z, in meters per second, every second. ")
        AddCode(numbers, "0, -10, 0")
        numbers:AddText(" means " + dq + "pull down along y" + dq + ". Real gravity on Earth is about 9.8, and
many games round it to 10. You can change these numbers to make a different world:")
        section:Add(numbers)

        UnorderedList worlds
        worlds:AddClassAttribute("list-disc list-outside pl-8")
        AddCodeItem(worlds, "SetGravity3D(0, -1.6, 0)", " is about the Moon's gravity, so things fall slowly
and jumps go high;")
        AddCodeItem(worlds, "SetGravity3D(0, -25, 0)", " is much stronger, so things fall fast and heavily;")
        AddCodeItem(worlds, "SetGravity3D(0, 10, 0)", " pulls up instead of down;")
        AddCodeItem(worlds, "SetGravity3D(5, -10, 0)", " pulls down and to the right, like a strong wind.")
        section:Add(worlds)

        Paragraph twoD
        twoD:AddText("A 2D game uses ")
        AddCode(twoD, "EnablePhysics2D(true)")
        twoD:AddText(" and ")
        AddCode(twoD, "SetGravity2D")
        twoD:AddText(", which takes two numbers, x and y. ")
        AddLink(twoD, "Running a Scene", "/tutorials/Scenes/running.html")
        twoD:AddText(" shows where this code goes.")
        section:Add(twoD)
    end

    action AddPropertiesPanel(Section section)
        AddHeading(section, "The Properties Panel", 3)
        section:AddParagraph("The Properties panel sits on the right side of every scene tab, next to the
scene. It always shows the properties of whatever is selected. When nothing is selected, it says " + dq
+ "Nothing selected" + dq + ". If its fields are taller than the tab, it scrolls. You can drag the bar between
the scene and the panel to make the panel wider or narrower.")
        section:AddParagraph("Consider an example. Suppose there is a Red Mouth monster at 0, 0 in the 2D editor.
If we select it, with the arrow keys and Enter or by clicking on it, its properties appear in the panel. We can
click on a field, or press Command+P on Mac or Control+P on Windows, to move into the panel. Then:")
        UnorderedList keys
        keys:AddClassAttribute("list-disc list-outside pl-8")
        keys:AddListItem("Tab and Shift+Tab move from field to field;")
        keys:AddListItem("type a new value into a field to change the item;")
        keys:AddListItem("Escape or Enter goes back to the scene, to the selected item.")
        section:Add(keys)
        section:AddParagraph("A screen reader reads each part of the panel as a named group, such as " + dq
+ "Object Properties" + dq + ", and reads each field with its name, such as " + dq + "X" + dq + " or " + dq
+ "Mass" + dq + ".")
        AddZoomImage(section, "/media/scenes/Properties/Properties.png", "The Properties panel beside a 2D scene, showing Basic Properties and Physics for a selected Red Mouth monster.")
    end

    action AddWhatThePanelShows(Section section)
        AddHeading(section, "What the Panel Shows", 3)
        section:AddParagraph("Different kinds of items have different properties, so the panel shows a
different section for each:")
        UnorderedList sections
        sections:AddClassAttribute("list-disc list-outside pl-8")
        AddBoldItem(sections, "", "Object Properties", ", for 2D items and for 3D shapes and models. It has
Basic Properties (name, position, scale, rotation, and for 3D items, color) and Physics.")
        AddBoldItem(sections, "", "Camera Properties", ", when the camera is selected (Alt+F, or Option+F on
Mac). In 3D: distance, direction (yaw and pitch), zoom and field of view. In 2D: position and zoom.")
        AddBoldItem(sections, "", "Point Light Properties", ": name, position, color and intensity.")
        AddBoldItem(sections, "", "Audio3D Properties", ": name, the sound file, position, volume and pitch,
and advanced settings such as how far away the sound can be heard and whether it loops.")
        ListItem terrain
        AddBold(terrain, "A terrain")
        terrain:AddText(" has several sections of its own: Terrain, Materials, Brush, Generate and Physics.
These are explained on the ")
        AddLink(terrain, "Terrain in a Scene", "/tutorials/Scenes/terrain.html")
        terrain:AddText(" page.")
        sections:Add(terrain)
        section:Add(sections)
        section:AddParagraph("The properties also show while you place a new item, before you press Enter, so
you can set them right away.")
    end

    action AddObjectProperties(Section section)
        AddHeading(section, "Object Properties", 3)
        section:AddParagraph("These properties let us change what an item does in a variety of ways. The
following table briefly describes them.")
        WebTable propertiesTable = LoadWebTable("Object Properties", "/html/media/scenes/Properties/Properties.csv")
        section:Add(propertiesTable)
        section:AddParagraph("Changes typed into the panel can't be undone yet with Undo, so it helps to write
down a value before changing it.")
    end

    action AddHavingFun(Section section)
        AddHeading(section, "Having Fun with Physics", 3)
        Paragraph fun
        fun:AddText("Getting the properties to work how you want for your game can be a fun and silly
adventure. Adjusting physics and watching items bounce around and cause chaos is part of it. As such, for
teachers and students alike, it is more than ok to have a bit of fun with them. The physics tutorials, such as ")
        AddLink(fun, "Mass and Friction in 3D", "/tutorials/physics/massandfriction3D.html")
        fun:AddText(", explain more about what these numbers do.")
        section:Add(fun)
    end

    action AddEngage returns Section
        Section section
        section:AddClassAttribute("flex flex-col gap-y-2")
        AddHeading(section, "Engage", 2)

        Paragraph first
        first:AddText("This activity is the first half of an experiment that you'll finish in the next
tutorial, ")
        AddLink(first, "Running a Scene", "/tutorials/Scenes/running.html")
        first:AddText(". In this half, you and a partner write ")
        AddBold(first, "hypotheses")
        first:AddText(": clear predictions about how a simple object will behave when you change its physics,
and why. The goal is to connect each physics property to what you expect to see, using what you learned on
this page. You won't run anything yet; in the next tutorial you'll test each hypothesis. Set up a 3D scene
with a ")
        AddBold(first, "floor")
        first:AddText(": a Cube with Physics Enabled, set to Unmovable, and scaled to 10, 0.2 and 10 in the
Properties panel. Add a ")
        AddBold(first, "ball")
        first:AddText(": a Sphere 3 meters above the floor, with Physics Enabled and set to Responsive. Save the
scene, so it's ready for the tests.")
        section:Add(first)

        section:AddParagraph("Now, for each change below, write a hypothesis in the form " + dq + "If we change
___, then the ball (or cube) will ___, because ___." + dq + " Keep your list somewhere safe; you'll need it
next time.")

        UnorderedList changes
        changes:AddClassAttribute("list-disc list-outside pl-8")
        AddBoldItem(changes, "", "Responsiveness:", " set the ball to Unmovable, then Nonresponsive, then
Responsive. Which ones fall?")
        AddBoldItem(changes, "", "Restitution:", " with the floor's restitution at 0, set the ball's to 0, then
0.5, then 1, then 1.5. How high does it bounce each time?")
        AddBoldItem(changes, "", "Mass:", " set the ball's mass to 1, then to 100. Does the heavier ball fall
faster, slower, or at the same speed?")
        AddBoldItem(changes, "", "Friction:", " tilt the floor by setting its pitch to 20 degrees, and replace
the ball with a cube. Set the cube's friction to 0, then 0.5, then 1. Does it slide, and how fast?")
        ListItem gravity
        AddBold(gravity, "Gravity:")
        gravity:AddText(" in ")
        AddCode(gravity, "Main.quorum")
        gravity:AddText(", ")
        AddCode(gravity, "SetGravity3D(0, -10, 0)")
        gravity:AddText(" becomes ")
        AddCode(gravity, "0, -1.6, 0")
        gravity:AddText(", then ")
        AddCode(gravity, "0, -25, 0")
        gravity:AddText(", then ")
        AddCode(gravity, "0, 10, 0")
        gravity:AddText(". How does the ball's fall change?")
        changes:Add(gravity)
        AddBoldItem(changes, "", "Physics Enabled:", " uncheck it on the floor. What happens to the ball?")
        AddBoldItem(changes, "", "A value that doesn't make sense:", " give the ball a negative mass or a
negative restitution. What will Quorum Studio and the game do?")
        section:Add(changes)

        section:AddParagraph("When your list is done, swap with another pair and read their hypotheses. Where
you disagree, talk about why, but don't change your own: a hypothesis that turns out wrong is just as useful
as one that turns out right. Then mark each of your hypotheses where you think the simulation might behave
differently from the real world.")
        return section
    end

    action AddWrapup returns Section
        Section section
        section:AddClassAttribute("flex flex-col gap-y-2")
        AddHeading(section, "Wrap up", 2)
        section:AddParagraph("Every item in a scene is really a set of data: a name, numbers for where it is and
how big it is, and settings for physics. The Properties panel lets us read and change that data directly, with
the mouse or the keyboard. Next, we run a scene and test the hypotheses you wrote today.")
        return section
    end

    private action AddStandard(UnorderedList list, text identifier, text standard)
        ListItem item
        AddBold(item, identifier)
        item:AddText(": " + standard)
        list:Add(item)
    end

    private action AddBoldItem(UnorderedList list, text before, text bold, text after)
        ListItem item
        item:AddText(before)
        AddBold(item, bold)
        item:AddText(after)
        list:Add(item)
    end

    private action AddBoldOrderedItem(OrderedList list, text bold, text after)
        ListItem item
        AddBold(item, bold)
        item:AddText(after)
        list:Add(item)
    end

    private action AddCodeItem(UnorderedList list, text code, text after)
        ListItem item
        AddCode(item, code)
        item:AddText(after)
        list:Add(item)
    end

    private action AddBold(WebTag tag, text value)
        StrongText strong
        strong:AddText(value)
        tag:AddNestedTag(strong)
    end

    private action AddCode(WebTag tag, text value)
        CodeBlock code
        code:AddClassAttribute("break-words")
        code:AddText(value)
        tag:AddNestedTag(code)
    end

    private action AddLink(WebTag tag, text name, text address)
        Link link
        link:AddText(name)
        link:SetAddress(address)
        link:SetClassAttribute("underline text-quorum-blue-150")
        tag:AddNestedTag(link)
    end

    private action AddZoomImage(Section section, text path, text alt)
        Image image = section:AddImage(path, alt)
        image:AddAttribute("data-zoom", "")
    end

    //wraps long lines, so code never scrolls sideways on a narrow screen (WCAG 1.4.10, reflow)
    private action AllowWrapping(PreformattedText code) returns PreformattedText
        code:AddClassAttribute("whitespace-pre-wrap break-words")
        return code
    end

    action GetMetaDescription returns text
        return "Learn about physics, the Properties panel, and causing chaos with properties and physics in Quorum Studio."
    end

    action GetSummaryName returns text
        return "Properties and Physics"
    end

    action GetName returns text
        return GetSummaryName()
    end

    action GetShortDescription returns text
        return "scene properties and physics"
    end

    action GetLocation returns text
        return "tutorials/Scenes/properties.html"
    end

    action GetLinkName returns text
        return "Properties and Physics"
    end

    action GetSectionName returns text
        return "Scene Editing"
    end
end
