package Lessons

use Libraries.Web.Page.all
use Libraries.Web.Page.Standards.ComputerScienceStandards2026
use Libraries.Web.Page.Standards.QuorumStandards

class SceneTerrainGenerate is QuorumPage
    // The site's sets of standards, built once for every page.
    QuorumStandards standards

    on create
        SetLocation("tutorials/Scenes/terrainGenerate.html")
    end

    action Setup
        // For search engines and link previews.
        SetDescription("Learn to generate terrain in Quorum Studio from presets and seeds, how pseudo-random numbers work, and how to change terrain with erosion, stamps and regions.")

        Title("Generating Terrain")

        Overview()
        WarmUp()
        Explore()
        Engage()
        WrapUp()
    end

    action Overview
        Section("Overview")
        Paragraph("Shaping every hill by hand takes a long time, especially in a large world. Many games instead "):Term("generate"):Text(" their landscapes: a program follows rules to make the ground, then a designer changes the parts that
matter. In this tutorial, you will generate whole landscapes in Quorum Studio from a preset and a
seed, learn how the computer makes "):Quoted("random"):Text(" numbers that can be repeated, wear the land down with erosion, press shapes such as hills and
craters into it, and make a terrain bigger by adding regions.")

        Subsection("Goals")
        Goals()
        ListItem("Generate terrain from a preset, a seed and a height")
        ListItem("Describe how each preset makes its kind of land")
        ListItem("Explain the difference between random and pseudo-random numbers, and why the same seed always gives
the same world")
        ListItem("Use erosion and stamps to change a terrain, and add and remove regions")
    end

    action WarmUp
        Section("Warm up")
        Paragraph("Suppose you rolled dice to decide the height of every square of a map, one roll per square. Would
the result look like real land? What would be wrong with it? What rules could you add so that it
looks more like hills, or mountains, or canyons?")

        Subsection("Vocabulary")
        Paragraph("You will be learning about the following vocabulary words:")
        Table("Vocabulary", "media/scenes/Terrain/Generating/Vocabulary.csv")

        Subsection("New Code to Learn")
        Paragraph("You will be using the following new pieces of code:")
        Table("New Code to Learn", "media/scenes/Terrain/Generating/Code.csv")

        Subsection("CSTA Standards")
        ComputerScienceStandards2026 computerScience = standards:GetComputerScience2026()
        CoversStandard(computerScience, computerScience:HIGH_SCHOOL_ALGORITHMIC_PROBLEM_SOLVING_4)
        CoversStandard(computerScience, computerScience:HIGH_SCHOOL_DATA_COLLECTION_AND_PREPARATION_21)
        CoversStandard(computerScience, computerScience:HIGH_SCHOOL_DATA_INVESTIGATION_26)
        CoversStandard(computerScience, computerScience:HIGH_SCHOOL_PROGRAM_DEVELOPMENT_13)
        CoversStandard(computerScience, computerScience:SPECIALTY_1_X_PLUS_COMPUTER_SCIENCE_X_PLUS_COMPUTER_SCIENCE_3)
        StandardsList(computerScience)
    end

    action Explore
        Section("Explore")
        Paragraph("The tools on this page are in the "):Strong("Generate"):Text(" section of the Properties panel, after the Brush section. Select the terrain, then press "):Keys("Cmd", "P"):Text(" on Mac or "):Keys("Ctrl", "P"):Text(" on Windows to move into the panel, and "):Key("Tab"):Text(" to reach the Generate section, or click in it with the mouse. Press "):Key("Escape"):Text(" to go back to the scene. The top of the section remakes the "):Strong("whole terrain"):Text(" at once; the "):Strong("At the brush"):Text(" part below it changes only the ground under the brush.")
        ExploreGeneratingAWholeTerrain()
        ExploreThePresets()
        ExploreRandomNumbersAndWhyTheSeedMatters()
        ExploreErosion()
        ExploreStamps()
        ExploreRegions()
    end

    private action ExploreGeneratingAWholeTerrain
        Subsection("Generating a whole terrain")
        Paragraph("Generating fills the whole terrain with new land, following one of five recipes called "):Term("presets"):Text(". Three settings decide what you get: the "):Term("preset"):Text(", the kind of land; the "):Term("seed"):Text(", a number that picks which of the many possible lands of that kind you get; and the "):Term("height"):Text(", the tallest the ground can be, in world units. Generating replaces every height on the terrain,
including anything you shaped by hand.")
        NumberedList()
        ListItem("In the Generate section, choose a "):Strong("Preset"):Text(": "):Strong("Rolling hills"):Text(", "):Strong("Mountains"):Text(", "):Strong("Plateaus"):Text(", "):Strong("Canyons"):Text(" or "):Strong("Flat"):Text(". With the keyboard, "):Key("Tab"):Text(" to the Preset group and use the arrow keys; with the mouse, click one.")
        ListItem("Type a "):Strong("Seed"):Text(", or press "):Strong("New seed"):Text(" to pick one at random, from 1 to 99999. It starts at 7.")
        ListItem("Type a "):Strong("Height"):Text(". It starts at 32.")
        ListItem("Press "):Strong("Generate"):Text(": "):Key("Tab"):Text(" to it and press "):Key("Space"):Text(" or "):Key("Enter"):Text(", or click it.")
        Paragraph("A large terrain can take a few seconds, and Quorum Studio may pause while it works. When it is done,
screen reader users might hear a phrase such as "):DoubleQuote():Output("Generated rolling hills, seed 7, heights 0.4 to 30.1."):DoubleQuote():Text(" The Terrain section's "):Quoted("Ground height"):Text(" line changes to match.")
    end

    private action ExploreThePresets
        Subsection("The presets")
        Paragraph("Every preset except Flat starts from "):Term("Perlin noise"):Text(", a formula invented by Ken Perlin in the 1983 when working on the movie Tron for making
natural-looking textures in films. Perlin noise turns a position on the ground into a value that
rises and falls smoothly, like gentle waves, and it uses the seed to decide where the waves go. Each
preset then uses that noise in its own way.")

        Subsubsection("Rolling hills")
        Paragraph("Rolling hills uses "):Term("fractal noise"):Text(": five layers, or "):Term("octaves"):Text(", of Perlin noise added together. The first octave makes the broad shape of the land, and each one
after it is smaller and finer, adding bumps on the bumps. Together they make soft, rounded hills of
many sizes, like farmland or a park.")

        Subsubsection("Mountains")
        Paragraph("Mountains uses "):Term("ridged noise"):Text(": the noise is folded at the middle of each wave, so every place it crosses the middle becomes a
sharp crest. Six octaves of it make crests on crests, which look like mountain ridges. The heights
are then pushed down, so the valleys between the mountains are wide and the peaks stand out above
them.")

        Subsubsection("Plateaus")
        Paragraph("Plateaus starts with the same fractal noise as rolling hills, then applies "):Term("terracing"):Text(": the heights are cut into five flat steps, with most of each step level and a steep rise up to the
next one. The result is flat-topped land with cliffs between the levels, like a mesa or a stepped
hillside.")

        Subsubsection("Canyons")
        Paragraph("Canyons uses "):Term("ridged multifractal noise"):Text(", the opposite of the mountains' ridged noise: instead of raising sharp crests out of low ground, it
cuts sharp valleys into high ground, with the land between them left smooth. The result looks like a
high plain with canyons carved into it.")

        Subsubsection("Flat")
        Paragraph("Flat sets every height to 0. It is a quick way to start over with a level terrain.")
    end

    private action ExploreRandomNumbersAndWhyTheSeedMatters
        Subsection("Random numbers and why the seed matters")
        Paragraph("A truly "):Term("random"):Text(" result, like a fair dice roll, can't be predicted. A computer, though, follows instructions exactly,
so it can't roll real dice. Instead, it uses a formula that makes a long string of numbers that "):Emphasis("look"):Text(" random: "):Term("pseudo-random numbers"):Text(". The formula has to start somewhere, and that starting point is the "):Term("seed"):Text(". Start from the same seed, and the formula makes exactly the same numbers, in the same order, every
time.")
        Paragraph("Quorum's "):Code("Random"):Text(" class is a pseudo-random number generator. This program rolls a six-sided die five times:")
        CodeExampleFromFile("sources/tutorials/scenes/SceneTerrainGenerate/Dice.quorum")
        Paragraph("Run it twice: the five rolls are the same both times, because the seed is 7 both times. Now delete
the "):Code("SetSeed"):Text(" line and run it twice more. Without a seed, "):Code("Random"):Text(" starts from the computer's clock, which is different every time, so the rolls change.")
        Paragraph("Terrain generation works the same way. The noise uses the seed to decide where its waves go, so the
result is "):Term("deterministic"):Text(": generate with the same preset, seed and height, and you get exactly the same land, every time, on
every computer. Change the seed, and you get a different land of the same kind. Games use this: a
seed is one small number, but it can stand for a whole world. Players can share a seed to play the
same map, and a game can make the same world again instead of storing every height.")
    end

    private action ExploreErosion
        Subsection("Erosion")
        Paragraph("Generated land can look too smooth or too even. Real ground is shaped by rain: water runs downhill,
picks up soil where it speeds up and drops it where it slows, carving channels and filling hollows.
Quorum Studio's erosion simulates this, following a method by Hans Theobald Beyer: it drops
thousands of imaginary raindrops onto the ground, one at a time, and lets each one run downhill,
picking up and dropping soil as it goes. Erosion moves ground around; it doesn't add or remove it.
It uses a pseudo-random generator, seeded with the terrain's seed, to decide where each drop lands,
so it is repeatable too.")
        BulletList()
        ListItem("To erode the whole terrain, press "):Strong("Erode whole terrain"):Text(" in the Generate section. For a new 128 by 128 terrain, it uses 2048 drops of rain, one for every
eight samples.")
        ListItem("To erode only part of it, choose any terrain tool, such as Raise with "):Keys("Alt", "1"):Text(" ("):Keys("Option", "1"):Text(" on Mac), move the brush over the area with the arrow keys or the mouse, and press "):Strong("Erode here"):Text(" in the "):Strong("At the brush"):Text(" part of the section.")
        Paragraph("Erode more than once for a more worn look. Erosion is a "):Term("simulation"):Text(": a simplified model of something real. Ask yourself what it leaves out. Real erosion takes
thousands of years and depends on rock, plants and weather.")
    end

    private action ExploreStamps
        Subsection("Stamps")
        Paragraph("A "):Term("stamp"):Text(" presses a whole shape into the ground at once, as big as the brush, instead of building it up stroke
by stroke. It is the quickest way to put one particular feature exactly where you want it: a
mountain in the middle of a plain, a crater, or a ridge along the edge of a valley. Stamps are in
the "):Strong("At the brush"):Text(" part of the Generate section, and they have these settings:")
        BulletList()
        ListItem():Strong("Stamp:"):Text(" the shape: "):Strong("Hill"):Text(", "):Strong("Mountain"):Text(", "):Strong("Mesa"):Text(" (a flat-topped hill), "):Strong("Crater"):Text(" or "):Strong("Ridge"):Text(".")
        ListItem():Strong("Stamp mode:"):Text(" how the shape meets the ground already there:")
        NestedBulletList()
        ListItem():Strong("Usual for the shape"):Text(", the default, adds a crater's shape onto the ground and raises the ground up to the other shapes;")
        ListItem():Strong("Add"):Text(" puts the shape on top of the ground;")
        ListItem():Strong("Subtract"):Text(" digs the shape into the ground;")
        ListItem():Strong("Raise to the shape"):Text(" lifts the ground up to the shape, and leaves ground that is already higher alone.")
        EndNestedList()
        ListItem():Strong("Stamp height:"):Text(" how tall the shape is, in world units. It starts at 15.")
        ListItem():Strong("Turn:"):Text(" how far to turn the shape, in degrees. This matters for a ridge.")

        Paragraph():Strong("With the keyboard:")
        NumberedList()
        ListItem("With the terrain selected, choose any terrain tool to place the brush, such as Raise with "):Keys("Alt", "1"):Text(" ("):Keys("Option", "1"):Text(" on Mac).")
        ListItem("Move the brush with the arrow keys to where the stamp should go, and size it with "):Keys("Alt", "="):Text(" and "):Keys("Alt", "-"):Text(" ("):Keys("Option", "="):Text(" and "):Keys("Option", "-"):Text(" on Mac).")
        ListItem("Press "):Keys("Ctrl", "P"):Text(" ("):Keys("Cmd", "P"):Text(" on Mac) to move into the Properties panel, and "):Key("Tab"):Text(" to the "):Strong("At the brush"):Text(" part of the Generate section.")
        ListItem("In the "):Strong("Stamp"):Text(" group, use the arrow keys to choose a shape, then "):Key("Tab"):Text(" to "):Strong("Stamp mode"):Text(" and choose one the same way.")
        ListItem():Key("Tab"):Text(" to "):Strong("Stamp height"):Text(" and "):Strong("Turn"):Text(", and type values if you want to change them.")
        ListItem():Key("Tab"):Text(" to "):Strong("Stamp here"):Text(" and press "):Key("Space"):Text(" or "):Key("Enter"):Text(".")
        ListItem("Press "):Key("Escape"):Text(" to go back to the scene.")

        Paragraph():Strong("With the mouse:")
        NumberedList()
        ListItem("With the terrain selected, choose any terrain tool, such as Raise, in the Brush section's Tool
group.")
        ListItem("Move the pointer over the ground to where the stamp should go; the brush follows it.")
        ListItem("In the Generate section, click a shape in the "):Strong("Stamp"):Text(" group and a mode in "):Strong("Stamp mode"):Text(", and type a "):Strong("Stamp height"):Text(" and "):Strong("Turn"):Text(" if you want.")
        ListItem("Move the brush back over the spot if needed, then click "):Strong("Stamp here"):Text(".")
    end

    private action ExploreRegions
        Subsection("Regions")
        Paragraph("A terrain is made of square regions, 64 by 64 units for a new terrain. Adding regions makes the
world bigger, and removing them makes it smaller. New regions are flat, at height 0, so generate
again to fill them with land. Regions sit on a fixed grid, from -16 to 15 along each side.")

        Paragraph():Strong("Adding a region with the keyboard:")
        NumberedList()
        ListItem("With the terrain selected, press "):Keys("Alt", "8"):Text(" ("):Keys("Option", "8"):Text(" on Mac) to choose "):Strong("Add region"):Text(".")
        ListItem("Move the brush with the arrow keys past the edge of the ground, to where the new region should be.")
        ListItem("Press "):Key("Space"):Text(".")

        Paragraph():Strong("Adding a region with the mouse:")
        NumberedList()
        ListItem("Choose "):Strong("Add region"):Text(" in the Brush section's Tool group.")
        ListItem("Move the pointer past the edge of the ground, to where the new region should be, and click.")

        Paragraph():Strong("Removing a region:"):Text(" choose "):Strong("Remove region"):Text(" with "):Keys("Alt", "9"):Text(" ("):Keys("Option", "9"):Text(" on Mac) or in the Tool group, move the brush over the region, and press "):Key("Space"):Text(" or click.")
        Paragraph():Strong("Growing on every side:"):Text(" in the Terrain section, press "):Strong("Grow by one region on every side"):Text(", with "):Key("Space"):Text(" or "):Key("Enter"):Text(" or a click, to add a ring of regions all the way around the terrain.")
        Paragraph("When you save, a removed region is left out of "):Code("terrain.json"):Text(", so it won't load again. Its image stays in the terrain's folder, unused: Quorum Studio never
deletes files from your project.")
    end

    action Engage
        Section("Engage")
        Paragraph("In this activity, you and a partner test whether "):Quoted("random"):Text(" worlds really are random, first in code and then with the terrain generator. The goal is to
understand what a seed does, and to compare a generated world before and after erosion. Start with
the dice program from this page: each of you runs it with "):Code("SetSeed(7)"):Text(" and writes down the five rolls, then compares lists. Then delete the "):Code("SetSeed"):Text(" line, run it again, and compare once more.")
        Paragraph("Next, each of you adds a new terrain to your own scene. In the Generate section, both choose "):Strong("Mountains"):Text(", set the seed to "):Strong("7"):Text(" and the height to "):Strong("32"):Text(", and press "):Strong("Generate"):Text(". Compare your two worlds: put the screens side by side, or choose Raise so the brush appears, move
it the same number of arrow-key steps from the middle on both computers, and compare the heights
reported. Then each of you presses "):Strong("New seed"):Text(", generates again, and compares once more. Finally, one partner presses "):Strong("Erode whole terrain"):Text(" three times, and you compare that terrain with the other at the same few points. Write down what you
noticed at each stage, then discuss:")
        BulletList()
        ListItem("Is a generated world random? What exactly did the seed make repeatable?")
        ListItem("Why would a game want the same world from the same seed? When would it want a new one?")
        ListItem("What does the erosion simulation get right about real land? What does it leave out?")
    end

    action WrapUp
        Section("Wrap up")
        Paragraph("Procedural generation turns a few settings (a preset, a seed and a height) into a whole landscape,
and the same settings always give the same land. Stamps and erosion then let you change parts of it,
and regions let the world grow. In your own games, which parts of a world would you generate by
rules, and which would you still make by hand? Why? In the next tutorial, "):Link("Terrain in a Game", "/tutorials/Scenes/terrainGames.html"):Text(", you will load your terrain in a game and walk or drive on it.")
    end
end
