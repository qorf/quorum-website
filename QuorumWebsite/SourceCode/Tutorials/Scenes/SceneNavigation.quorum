use Libraries.Web.Page.all
use Libraries.Containers.Array

class SceneNavigation is Lesson
    text dq = ""
    dq = dq:GetDoubleQuote()
    text cr = ""
    cr = cr:GetCarriageReturn()

    action Setup
        //html header stuff
        SetWebPageTitle("Mouse and Keyboard Controls - Quorum Programming Language")
        AddDefaultHeaders()

        //page header
        Array<Division> divs = InitializeTutorialPage()
        Division bodyDiv = divs:Get(1)
        Division onPageDiv = divs:Get(2)

        Header headDiv
        headDiv:SetClassAttribute("flex flex-col gap-y-2")
        AddHeading(headDiv, "Mouse and Keyboard Controls", 1)
        bodyDiv:Add(headDiv)

        bodyDiv:Add(AddOverview())
        bodyDiv:Add(AddWarmup())
        bodyDiv:Add(AddExplore())
        bodyDiv:Add(AddEngage())
        bodyDiv:Add(AddWrapup())

        Section nextLesson
        nextLesson:AddClassAttribute("flex flex-col gap-y-2")
        bodyDiv:Add(nextLesson)
        WriteNextTutorial(nextLesson)
        onPageDiv:Add(CreateHeadingTableOfContents())
    end

    action AddOverview returns Section
        Section section
        section:AddClassAttribute("flex flex-col gap-y-2")
        AddHeading(section, "Overview", 2)
        section:AddParagraph("Besides adding, removing, and setting properties on items, there is a series of
keys we can use to change a scene. The Properties panel can always be used, but there are also keys for moving,
scaling, and rotating items, and keys for the cursor, the grid, the camera and reports for screen readers. These
keys are documented here, so that a whole scene can be built with the keyboard alone.")

        AddHeading(section, "Goals", 3)
        section:AddParagraph("You have the following goals for this lesson:")
        UnorderedList goals
        goals:AddClassAttribute("list-disc list-outside pl-8")
        goals:AddListItem("Move, scale and rotate items in 2D and 3D scenes with the keyboard")
        goals:AddListItem("Use the cursor, grid, Properties panel and Find keys")
        goals:AddListItem("Use the report keys to check a scene without looking at it")
        goals:AddListItem("Know that the keys can be changed in Quorum Studio's key map")
        section:Add(goals)
        return section
    end

    action AddWarmup returns Section
        Section section
        section:AddClassAttribute("flex flex-col gap-y-2")
        AddHeading(section, "Warm up", 2)
        section:AddParagraph("Pick a room you know. Using only words like " + dq + "left" + dq + ", " + dq
+ "forward" + dq + ", " + dq + "turn" + dq + " and " + dq + "bigger" + dq + ", how would you guide a friend to
rearrange one piece of furniture? Which words did you need for 3D that you wouldn't need on a flat map?")

        AddHeading(section, "Vocabulary", 3)
        section:AddParagraph("You will be learning about the following vocabulary words:")
        WebTable vocabularyTable = LoadWebTable("Vocabulary", "/html/media/scenes/Navigation/Vocabulary.csv")
        section:Add(vocabularyTable)

        AddHeading(section, "CSTA Standards", 3)
        Paragraph standardsParagraph
        standardsParagraph:AddText("This lesson covers the following standards, from the ")
        AddLink(standardsParagraph, "2026 CSTA K–12 Computer Science Standards", "https://csteachers.org/pk12standards/view/")
        standardsParagraph:AddText(":")
        section:Add(standardsParagraph)

        UnorderedList standards
        standards:AddClassAttribute("list-disc list-outside pl-8")
        AddStandard(standards, "S1-SWD-DD-03", "Use integrated development environment (IDE) features to streamline software development, including code editing, debugging, version control, and project management.")
        AddStandard(standards, "S2-GMD-PX-04", "Evaluate game interactions using diverse input devices to enhance immersion and player experience.")
        AddStandard(standards, "S1-GMD-PX-05", "Create a user-friendly interface for a game, considering accessibility, usability, and aesthetics.")
        section:Add(standards)
        return section
    end

    action AddExplore returns Section
        Section section
        section:AddClassAttribute("flex flex-col gap-y-2")
        AddHeading(section, "Explore", 2)
        AddReadingTables(section)
        AddMoving(section)
        AddScaling(section)
        AddRotating(section)
        AddCursorAndGrid(section)
        AddEditor(section)
        AddCamera(section)
        AddAccessibility(section)
        AddTerrain(section)
        return section
    end

    action AddReadingTables(Section section)
        AddHeading(section, "How to Read the Tables", 3)
        section:AddParagraph("Each table gives the default keys on Windows, and on Mac. On a Mac, the key called
Alt is labeled Option. Most keys work on whatever has the focus: the cursor when nothing is selected, the
selected item, or a new item's preview before it is placed. The keys for the cursor are used when nothing is
selected; the same keys may do something else for a selected item.")
        Paragraph keyMap
        keyMap:AddText("Every key here can be changed. Quorum Studio keeps its keys in a key map file, ")
        AddCode(keyMap, "Configuration/KeyMap.json")
        keyMap:AddText(", and the scene editor reads its keys from it. If you change a key there, use your own key
instead of the one in the tables. You rarely, if ever, need to adjust this file.")
        section:Add(keyMap)
    end

    action AddMoving(Section section)
        AddHeading(section, "Moving", 3)
        section:AddParagraph("These keys move the cursor, the selected item, or a preview. When you let go of the
key, a screen reader says what else is in that spot and where it is, for example " + dq + "Water, 3 2" + dq
+ " in 2D or " + dq + "Cube, 3 1 0" + dq + " in 3D.")
        WebTable table = LoadWebTable("Keys for moving", "/html/media/scenes/Navigation/Moving.csv")
        section:Add(table)
    end

    action AddScaling(Section section)
        AddHeading(section, "Scaling", 3)
        section:AddParagraph("These keys change the size of the selected item or a preview. Each press changes
the size by about 10 percent, and a screen reader says what happened, such as " + dq + "Scaled up" + dq
+ " or " + dq + "Scaled X down" + dq + ". 2D items have no depth, so the depth keys are for 3D only.")
        WebTable table = LoadWebTable("Keys for scaling", "/html/media/scenes/Navigation/Scaling.csv")
        section:Add(table)
    end

    action AddRotating(Section section)
        AddHeading(section, "Rotating", 3)
        section:AddParagraph("These keys turn the selected item or a preview. In 2D, an item turns in one
direction or the other. In 3D, an item can yaw, pitch and roll.")
        WebTable table = LoadWebTable("Keys for rotating", "/html/media/scenes/Navigation/Rotating.csv")
        section:Add(table)
    end

    action AddCursorAndGrid(Section section)
        AddHeading(section, "Cursor and Grid", 3)
        WebTable table = LoadWebTable("Keys for the cursor and the grid", "/html/media/scenes/Navigation/CursorAndGrid.csv")
        section:Add(table)
        section:AddParagraph("A screen reader says " + dq + "Grid snapping enabled" + dq + " or " + dq
+ "Grid snapping disabled" + dq + ", and " + dq + "Grid size" + dq + " with the new size.")
    end

    action AddEditor(Section section)
        AddHeading(section, "Editor", 3)
        WebTable table = LoadWebTable("Keys for the editor", "/html/media/scenes/Navigation/Editor.csv")
        section:Add(table)
        Paragraph panel
        panel:AddText("The Properties panel is described on the ")
        AddLink(panel, "Properties", "/tutorials/Scenes/properties.html")
        panel:AddText(" page. In the panel, Tab and Shift+Tab move between its fields.")
        section:Add(panel)
    end

    action AddCamera(Section section)
        AddHeading(section, "Camera", 3)
        section:AddParagraph("The mouse moves the 3D camera:")
        UnorderedList mouse
        mouse:AddClassAttribute("list-disc list-outside pl-8")
        mouse:AddListItem("hold the right mouse button and drag to look around;")
        mouse:AddListItem("hold the middle mouse button and drag to orbit around a point;")
        mouse:AddListItem("hold Shift and the middle mouse button and drag to pan;")
        mouse:AddListItem("use the scroll wheel to zoom in and out.")
        section:Add(mouse)
        section:AddParagraph("With the keyboard, select the camera itself. Its settings then show in the
Properties panel: in 3D its distance, direction (yaw and pitch), zoom and field of view, and in 2D its position
and zoom. Move into the panel with Control+P or Command+P and type new values.")
        WebTable table = LoadWebTable("Keys for the camera", "/html/media/scenes/Navigation/Camera.csv")
        section:Add(table)
    end

    action AddAccessibility(Section section)
        AddHeading(section, "Accessibility", 3)
        section:AddParagraph("These keys report on the scene through a screen reader. They use Control and Shift
on every computer, including a Mac.")
        WebTable table = LoadWebTable("Keys for screen reader reports", "/html/media/scenes/Navigation/Accessibility.csv")
        section:Add(table)
        section:AddParagraph("For example, with nothing selected, Control+Shift+1 says " + dq + "Camera at 0, 5,
10" + dq + ", and Control+Shift+2 says " + dq + "Camera yaw is 0, pitch is -20" + dq + ". With an item selected,
Control+Shift+1 says its position, such as " + dq + "3, 1, 0" + dq + ".")
    end

    action AddTerrain(Section section)
        AddHeading(section, "Terrain", 3)
        Paragraph intro
        intro:AddText("These keys work when a terrain is selected. Choosing a tool turns the arrow keys into keys
that move the terrain's brush over the ground. Escape first cancels a stroke, then leaves the tool, and the
terrain stays selected. The ")
        AddLink(intro, "Shaping Terrain", "/tutorials/Scenes/terrainShape.html")
        intro:AddText(" page explains them.")
        section:Add(intro)
        WebTable table = LoadWebTable("Keys for the terrain editor", "/html/media/scenes/Navigation/Terrain.csv")
        section:Add(table)
    end

    action AddEngage returns Section
        Section section
        section:AddClassAttribute("flex flex-col gap-y-2")
        AddHeading(section, "Engage", 2)
        section:AddParagraph("In this activity, you and a partner practice the scene editor's keys by giving each
other building requests, and keep a journal of exactly how you carried out each one. The goal is to learn which
keys and mouse actions do what, and to notice which ones you reach for most. You'll need one computer between
you and a notebook or a document for your journal. Partner A starts by building a small 3D scene with three
shapes from Basic 3D, such as a cube, a sphere and a cylinder, placed in different spots. Then Partner A hands
over the keyboard and mouse.")
        section:AddParagraph("Partner B finds each shape: move the cursor to it, select it, and open the
Properties panel to read where it is. Say out loud which shape it is and its position. Then Partner A gives
three requests, one at a time, such as " + dq + "make the cube twice as wide" + dq + ", " + dq + "turn the
cylinder to the left" + dq + " or " + dq + "move the sphere up 2 meters" + dq + ". Partner B carries out each
request, with the keyboard, the mouse, or both. For every request, Partner B writes a journal entry: the
request, then each key pressed or mouse action used, in order (for example " + dq + "Enter, then Alt+D three
times" + dq + " or " + dq + "dragged with the middle mouse button to orbit, then clicked the sphere" + dq + "),
and whether it worked on the first try. Then swap roles, with a new scene. At the end, compare your journals:")
        UnorderedList questions
        questions:AddClassAttribute("list-disc list-outside pl-8")
        questions:AddListItem("Which keys or mouse actions did you each use most?")
        questions:AddListItem("Which request took the most steps, and could it have taken fewer?")
        questions:AddListItem("Which keys were easy to remember, and which would you change in the key map? Why?")
        section:Add(questions)
        return section
    end

    action AddWrapup returns Section
        Section section
        section:AddClassAttribute("flex flex-col gap-y-2")
        AddHeading(section, "Wrap up", 2)
        section:AddParagraph("Nearly everything in the scene editor can be done from the keyboard: moving,
scaling and turning items, using the grid, and checking a scene with spoken reports. Knowing a few of these keys
makes building a scene much faster, whether or not you use a mouse. Next, we look closely at the Properties
panel.")
        return section
    end

    private action AddStandard(UnorderedList list, text identifier, text standard)
        ListItem item
        AddBold(item, identifier)
        item:AddText(": " + standard)
        list:Add(item)
    end

    private action AddBold(WebTag tag, text value)
        StrongText strong
        strong:AddText(value)
        tag:AddNestedTag(strong)
    end

    private action AddCode(WebTag tag, text value)
        CodeBlock code
        code:AddClassAttribute("break-words")
        code:AddText(value)
        tag:AddNestedTag(code)
    end

    private action AddLink(WebTag tag, text name, text address)
        Link link
        link:AddText(name)
        link:SetAddress(address)
        link:SetClassAttribute("underline text-quorum-blue-150")
        tag:AddNestedTag(link)
    end

    action GetMetaDescription returns text
        return "Learn the mouse and keyboard controls of the scene editor in Quorum Studio."
    end

    action GetSummaryName returns text
        return "Introduction to navigation in the Scene Editor in Quorum Studio"
    end

    action GetName returns text
        return "Navigation and Keyboard shortcuts in Quorum Studio"
    end

    action GetShortDescription returns text
        return "scene navigation in Quorum Studio"
    end

    action GetLocation returns text
        return "tutorials/Scenes/navigate.html"
    end

    action GetLinkName returns text
        return "Navigate the Scene Editor"
    end

    action GetSectionName returns text
        return "Scene Editing"
    end
end
