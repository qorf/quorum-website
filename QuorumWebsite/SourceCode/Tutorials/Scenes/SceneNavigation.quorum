package Lessons

use Libraries.Web.Page.all
use Libraries.Web.Page.Standards.ComputerScienceStandards2026
use Libraries.Web.Page.Standards.QuorumStandards

class SceneNavigation is QuorumPage
    // The site's sets of standards, built once for every page.
    QuorumStandards standards

    on create
        SetLocation("tutorials/Scenes/navigate.html")
    end

    action Setup
        // For search engines and link previews.
        SetDescription("Learn the mouse and keyboard controls of the scene editor in Quorum Studio.")

        Title("Mouse and Keyboard Controls")

        Overview()
        WarmUp()
        Explore()
        Engage()
        WrapUp()
    end

    action Overview
        Section("Overview")
        Paragraph("Besides adding, removing, and setting properties on items, there is a series of
keys we can use to change a scene. The Properties panel can always be used, but there are also keys for moving,
scaling, and rotating items, and keys for the cursor, the grid, the camera and reports for screen readers. These
keys are documented here, so that a whole scene can be built with the keyboard alone.")

        Subsection("Goals")
        Goals()
        ListItem("Move, scale and rotate items in 2D and 3D scenes with the keyboard")
        ListItem("Use the cursor, grid, Properties panel and Find keys")
        ListItem("Use the report keys to check a scene without looking at it")
        ListItem("Know that the keys can be changed in Quorum Studio's key map")
    end

    action WarmUp
        Section("Warm up")
        Paragraph("Pick a room you know. Using only words like "):Quoted("left"):Text(", "):Quoted("forward"):Text(", "):Quoted("turn"):Text(" and "):Quoted("bigger"):Text(", how would you guide a friend to
rearrange one piece of furniture? Which words did you need for 3D that you wouldn't need on a flat map?")

        Subsection("Vocabulary")
        Paragraph("You will be learning about the following vocabulary words:")
        Table("Vocabulary", "media/scenes/Navigation/Vocabulary.csv")

        Subsection("CSTA Standards")
        ComputerScienceStandards2026 computerScience = standards:GetComputerScience2026()
        CoversStandard(computerScience, computerScience:SPECIALTY_1_SOFTWARE_DEVELOPMENT_DESIGN_AND_DEVELOPMENT_3)
        CoversStandard(computerScience, computerScience:SPECIALTY_2_GAME_DEVELOPMENT_PLAYER_EXPERIENCE_4)
        CoversStandard(computerScience, computerScience:SPECIALTY_1_GAME_DEVELOPMENT_PLAYER_EXPERIENCE_5)
        StandardsList(computerScience)
    end

    action Explore
        Section("Explore")
        ReadingTables()
        Moving()
        Scaling()
        Rotating()
        CursorAndGrid()
        Editor()
        Camera()
        Accessibility()
        Terrain()
    end

    private action ReadingTables
        Subsection("How to Read the Tables")
        Paragraph("Each table gives the default keys on Windows, and on Mac. On a Mac, the key called
Alt is labeled Option. Most keys work on whatever has the focus: the cursor when nothing is selected, the
selected item, or a new item's preview before it is placed. The keys for the cursor are used when nothing is
selected; the same keys may do something else for a selected item.")
        Paragraph("Every key here can be changed. Quorum Studio keeps its keys in a key map file, "):Code("Configuration/KeyMap.json"):Text(", and the scene editor reads its keys from it. If you change a key there, use your own key
instead of the one in the tables. You rarely, if ever, need to adjust this file.")
    end

    private action Moving
        Subsection("Moving")
        Paragraph("These keys move the cursor, the selected item, or a preview. When you let go of the
key, a screen reader says what else is in that spot and where it is, for example "):DoubleQuote():Output("Water, 3 2"):DoubleQuote():Text(" in 2D or "):DoubleQuote():Output("Cube, 3 1 0"):DoubleQuote():Text(" in 3D.")
        Table("Keys for moving", "media/scenes/Navigation/Moving.csv")
    end

    private action Scaling
        Subsection("Scaling")
        Paragraph("These keys change the size of the selected item or a preview. Each press changes
the size by about 10 percent, and a screen reader says what happened, such as "):DoubleQuote():Output("Scaled up"):DoubleQuote():Text(" or "):DoubleQuote():Output("Scaled X down"):DoubleQuote():Text(". 2D items have no depth, so the depth keys are for 3D only.")
        Table("Keys for scaling", "media/scenes/Navigation/Scaling.csv")
    end

    private action Rotating
        Subsection("Rotating")
        Paragraph("These keys turn the selected item or a preview. In 2D, an item turns in one
direction or the other. In 3D, an item can yaw, pitch and roll.")
        Table("Keys for rotating", "media/scenes/Navigation/Rotating.csv")
    end

    private action CursorAndGrid
        Subsection("Cursor and Grid")
        Table("Keys for the cursor and the grid", "media/scenes/Navigation/CursorAndGrid.csv")
        Paragraph("A screen reader says "):DoubleQuote():Output("Grid snapping enabled"):DoubleQuote():Text(" or "):DoubleQuote():Output("Grid snapping disabled"):DoubleQuote():Text(", and "):DoubleQuote():Output("Grid size"):DoubleQuote():Text(" with the new size.")
    end

    private action Editor
        Subsection("Editor")
        Table("Keys for the editor", "media/scenes/Navigation/Editor.csv")
        Paragraph("The Properties panel is described on the "):Link("Properties", "/tutorials/Scenes/properties.html"):Text(" page. In the panel, Tab and Shift+Tab move between its fields.")
    end

    private action Camera
        Subsection("Camera")
        Paragraph("The mouse moves the 3D camera:")
        BulletList()
        ListItem("hold the right mouse button and drag to look around;")
        ListItem("hold the middle mouse button and drag to orbit around a point;")
        ListItem("hold Shift and the middle mouse button and drag to pan;")
        ListItem("use the scroll wheel to zoom in and out.")
        Paragraph("With the keyboard, select the camera itself. Its settings then show in the
Properties panel: in 3D its distance, direction (yaw and pitch), zoom and field of view, and in 2D its position
and zoom. Move into the panel with Control+P or Command+P and type new values.")
        Table("Keys for the camera", "media/scenes/Navigation/Camera.csv")
    end

    private action Accessibility
        Subsection("Accessibility")
        Paragraph("These keys report on the scene through a screen reader. They use Control and Shift
on every computer, including a Mac.")
        Table("Keys for screen reader reports", "media/scenes/Navigation/Accessibility.csv")
        Paragraph("For example, with nothing selected, Control+Shift+1 says "):DoubleQuote():Output("Camera at 0, 5, 10"):DoubleQuote():Text(", and Control+Shift+2 says "):DoubleQuote():Output("Camera yaw is 0, pitch is -20"):DoubleQuote():Text(". With an item selected,
Control+Shift+1 says its position, such as "):DoubleQuote():Output("3, 1, 0"):DoubleQuote():Text(".")
    end

    private action Terrain
        Subsection("Terrain")
        Paragraph("These keys work when a terrain is selected. Choosing a tool turns the arrow keys into keys
that move the terrain's brush over the ground. Escape first cancels a stroke, then leaves the tool, and the
terrain stays selected. The "):Link("Shaping Terrain", "/tutorials/Scenes/terrainShape.html"):Text(" page explains them.")
        Table("Keys for the terrain editor", "media/scenes/Navigation/Terrain.csv")
    end

    action Engage
        Section("Engage")
        Paragraph("In this activity, you and a partner practice the scene editor's keys by giving each
other building requests, and keep a journal of exactly how you carried out each one. The goal is to learn which
keys and mouse actions do what, and to notice which ones you reach for most. You'll need one computer between
you and a notebook or a document for your journal. Partner A starts by building a small 3D scene with three
shapes from Basic 3D, such as a cube, a sphere and a cylinder, placed in different spots. Then Partner A hands
over the keyboard and mouse.")
        Paragraph("Partner B finds each shape: move the cursor to it, select it, and open the
Properties panel to read where it is. Say out loud which shape it is and its position. Then Partner A gives
three requests, one at a time, such as "):Quoted("make the cube twice as wide"):Text(", "):Quoted("turn the
cylinder to the left"):Text(" or "):Quoted("move the sphere up 2 meters"):Text(". Partner B carries out each
request, with the keyboard, the mouse, or both. For every request, Partner B writes a journal entry: the
request, then each key pressed or mouse action used, in order (for example "):Quoted("Enter, then Alt+D three
times"):Text(" or "):Quoted("dragged with the middle mouse button to orbit, then clicked the sphere"):Text("),
and whether it worked on the first try. Then swap roles, with a new scene. At the end, compare your journals:")
        BulletList()
        ListItem("Which keys or mouse actions did you each use most?")
        ListItem("Which request took the most steps, and could it have taken fewer?")
        ListItem("Which keys were easy to remember, and which would you change in the key map? Why?")
    end

    action WrapUp
        Section("Wrap up")
        Paragraph("Nearly everything in the scene editor can be done from the keyboard: moving,
scaling and turning items, using the grid, and checking a scene with spoken reports. Knowing a few of these keys
makes building a scene much faster, whether or not you use a mouse. Next, we look closely at the Properties
panel.")
    end
end
