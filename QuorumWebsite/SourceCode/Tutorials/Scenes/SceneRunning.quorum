use Libraries.Web.Page.all
use Libraries.Containers.Array

class SceneRunning is Lesson
    text dq = ""
    dq = dq:GetDoubleQuote()
    text cr = ""
    cr = cr:GetCarriageReturn()
    Preformatter preformatter //helper

    action Setup
        //html header stuff
        SetWebPageTitle("Running a Scene - Quorum Programming Language")
        AddDefaultHeaders()

        //page header
        Array<Division> divs = InitializeTutorialPage()
        Division bodyDiv = divs:Get(1)
        Division onPageDiv = divs:Get(2)

        Header headDiv
        headDiv:SetClassAttribute("flex flex-col gap-y-2")
        AddHeading(headDiv, "Running a Scene", 1)
        bodyDiv:Add(headDiv)

        bodyDiv:Add(AddOverview())
        bodyDiv:Add(AddWarmup())
        bodyDiv:Add(AddExplore())
        bodyDiv:Add(AddEngage())
        bodyDiv:Add(AddWrapup())

        Section nextLesson
        nextLesson:AddClassAttribute("flex flex-col gap-y-2")
        bodyDiv:Add(nextLesson)
        WriteNextTutorial(nextLesson)
        onPageDiv:Add(CreateHeadingTableOfContents())
    end

    action AddOverview returns Section
        Section section
        section:AddClassAttribute("flex flex-col gap-y-2")
        AddHeading(section, "Overview", 2)
        section:AddParagraph("A scene made in Quorum Studio is a picture of a game's world: where things are,
what they look like and what they are called. It doesn't do anything yet. This page starts with how Quorum
draws graphics at all, through one of three graphics systems: OpenGL, WebGL and Vulkan. It then shows how a
small program loads a scene and starts it in a game window, and what more that program needs for 3D physics
and terrain. Finally, you'll test the hypotheses about physics that you wrote in the last tutorial.")

        AddHeading(section, "Goals", 3)
        section:AddParagraph("You have the following goals for this lesson:")
        UnorderedList goals
        goals:AddClassAttribute("list-disc list-outside pl-8")
        goals:AddListItem("Describe what a graphics engine does, and how OpenGL, WebGL and Vulkan differ.")
        ListItem load
        load:AddText("Load a scene from a program with ")
        AddCode(load, "LoadScene")
        load:AddText(", using Vulkan.")
        goals:Add(load)
        goals:AddListItem("Run a scene from Quorum Studio, and set it up for 3D physics and terrain.")
        goals:AddListItem("Test hypotheses about physics, one change at a time, by sight, by sound and by timing, and record the results.")
        section:Add(goals)
        return section
    end

    action AddWarmup returns Section
        Section section
        section:AddClassAttribute("flex flex-col gap-y-2")
        AddHeading(section, "Warm up", 2)
        section:AddParagraph("Think of a stage set for a play before the actors arrive. The scenery is all in
place, but nothing happens. What has to be added before the play can start? Which parts of a game are like
the scenery, and which are like the actors and the script?")

        AddHeading(section, "Vocabulary", 3)
        section:AddParagraph("You will be learning about the following vocabulary words:")
        WebTable vocabularyTable = LoadWebTable("Vocabulary", "/html/media/scenes/Running/Vocabulary.csv")
        section:Add(vocabularyTable)

        AddHeading(section, "New Code to Learn", 3)
        section:AddParagraph("You will be using the following new pieces of code:")
        WebTable codeTable = LoadWebTable("New Code to Learn", "/html/media/scenes/Running/Code.csv")
        section:Add(codeTable)

        AddHeading(section, "CSTA Standards", 3)
        Paragraph standardsParagraph
        standardsParagraph:AddText("This lesson covers the following standards, from the ")
        AddLink(standardsParagraph, "2026 CSTA K–12 Computer Science Standards", "https://csteachers.org/pk12standards/view/")
        standardsParagraph:AddText(":")
        section:Add(standardsParagraph)

        UnorderedList standards
        standards:AddClassAttribute("list-disc list-outside pl-8")
        AddStandard(standards, "HS-DAT-DI-26", "Evaluate a data simulation or visualization to answer a data question, inform decision-making, and identify potential limitations.")
        AddStandard(standards, "MS-PRO-TR-19", "Use systematic strategies to test, refine, and document changes to a computing technology to meet the intended purpose.")
        AddStandard(standards, "HS-PRO-PD-13", "Use documentation, libraries, application programming interfaces (APIs), and other tools in program development.")
        section:Add(standards)
        return section
    end

    action AddExplore returns Section
        Section section
        section:AddClassAttribute("flex flex-col gap-y-2")
        AddHeading(section, "Explore", 2)
        AddGraphicsEngines(section)
        AddWhatVulkanAdds(section)
        AddMakeItReal(section)
        AddLoadingProgram(section)
        AddRunningTheScene(section)
        AddPhysicsAndGravity(section)
        AddHearingWhatHappens(section)
        AddScenesWithTerrain(section)
        return section
    end

    action AddGraphicsEngines(Section section)
        AddHeading(section, "How Quorum draws: graphics engines", 3)
        Paragraph intro
        intro:AddText("Everything you see in a game, from a cube to a mountain to a shadow, has to be drawn on
the screen, many times every second. The part of a game system that does this is called a ")
        AddBold(intro, "graphics engine")
        intro:AddText(". It takes everything in the scene, works out what the camera can see, and sends drawing
instructions to the computer's graphics hardware, often called the graphics card or GPU. Quorum's games have a
graphics engine built in, so you don't have to write those instructions yourself.")
        section:Add(intro)

        section:AddParagraph("Graphics hardware is made by many companies, so programs talk to it through
shared standards, a bit like how every country's power outlets need plugs that fit. Quorum's engine can use
three of them, under the hood:")
        UnorderedList engines
        engines:AddClassAttribute("list-disc list-outside pl-8")
        AddBoldItem(engines, "", "OpenGL", " came first. It was released in 1992 by Silicon Graphics, a company
that made powerful computers for 3D graphics, and it is now looked after by a group of companies called the
Khronos Group. For more than twenty years, it was the way most programs drew 3D graphics on Windows, Mac and
Linux. Quorum uses OpenGL unless you ask for something else.")
        AddBoldItem(engines, "", "WebGL", " brought OpenGL to the web. Released in 2011, also by the Khronos
Group, it lets a web page draw 3D graphics without installing anything. When a Quorum game runs inside a web
browser, it draws with WebGL.")
        AddBoldItem(engines, "", "Vulkan", " is the newest. The Khronos Group released it in 2016 as a modern
replacement for OpenGL. It is faster and gives programs much more control over the graphics hardware, which
makes newer effects possible. On a Mac, Vulkan runs on top of Apple's own graphics system through a translator
called MoltenVK.")
        section:Add(engines)

        Paragraph vulkan
        vulkan:AddText("Because Vulkan is the newest, Quorum's newest graphics features need it. To use
everything in the rest of these tutorials, turn Vulkan on in the program that runs your scene, with one line
before ")
        AddCode(vulkan, "StartGame()")
        vulkan:AddText(":")
        section:Add(vulkan)
        section:Add(AllowWrapping(preformatter:GeneratePreformattedCode(GetTextFromSource("/html/sources/tutorials/scenes/SceneRunning/UseVulkan.quorum"))))
        section:AddParagraph("If a computer can't run Vulkan, Quorum quietly falls back to OpenGL.")
    end

    action AddWhatVulkanAdds(Section section)
        AddHeading(section, "What Vulkan adds in Quorum", 3)
        section:AddParagraph("Turning on Vulkan gives your scenes features that OpenGL in Quorum doesn't have:")
        UnorderedList features
        features:AddClassAttribute("list-disc list-outside pl-8")
        AddBoldItem(features, "", "Terrain", ": the ground of a 3D world, with hills and valleys you shape in
the scene editor. A scene with a terrain won't load without Vulkan.")
        AddBoldItem(features, "", "Shadows", ": lights such as the sun can cast shadows, so objects look like
they're really sitting on the ground.")
        AddBoldItem(features, "", "Spotlights", ": cone-shaped lights, like a flashlight or a car's headlights.
Under OpenGL they aren't drawn at all.")
        AddBoldItem(features, "", "Realistic materials", ": surfaces made from texture sets, with bumps,
roughness and other details, such as the grass and rock on a terrain.")
        AddBoldItem(features, "", "Smoother edges", ": an option called multisampling that softens the jagged "
+ dq + "staircase" + dq + " edges on 3D shapes.")
        section:Add(features)
        section:AddParagraph("When Quorum Studio itself runs with Vulkan, its scene editor shows these features
while you build. Your game only shows them if its own program turns Vulkan on too.")
    end

    action AddMakeItReal(Section section)
        AddHeading(section, "Make it Real", 3)
        Paragraph real
        real:AddText("It's complete. The perfect scene. It's cool. It's clever. It's got monsters. They're
amazing! Publish it! Hold on. Scenes are cool, but static. Just because there are images in the application
does not mean the game is ready to be published on an app store. The application needs movement, game logic
and much more. Every item placed in a scene can be found and changed later in code; the next page, ")
        AddLink(real, "Manipulating a Running Scene", "/tutorials/Scenes/manipulate.html")
        real:AddText(", shows how.")
        section:Add(real)
        section:AddParagraph("The first step is to get the scene into a running program.")
    end

    action AddLoadingProgram(Section section)
        AddHeading(section, "A Program That Loads a Scene", 3)
        section:AddParagraph("To load a scene, use the following template:")
        section:Add(AllowWrapping(preformatter:GeneratePreformattedCode(GetTextFromSource("/html/sources/tutorials/scenes/Runner.quorum"))))

        Paragraph explain
        explain:AddText("This template looks like a normal game template, as described in the games tutorials.
The first difference is ")
        AddCode(explain, "UseVulkan(true)")
        explain:AddText(" in ")
        AddCode(explain, "Main")
        explain:AddText(", which turns on Vulkan before the game starts. The second is one action, ")
        AddCode(explain, "LoadScene")
        explain:AddText(". It reads a scene file, works out what is inside it, and adds each item, camera and
light to the game. The path is relative to the project's folder, so ")
        AddCode(explain, "Scenes/Scene.qs")
        explain:AddText(" is the scene file in the project's Scenes folder. If the scene has a different name,
change the path to match.")
        section:Add(explain)

        Paragraph studio
        studio:AddText("A new scene project in Quorum Studio already has a program like this in ")
        AddCode(studio, "SourceCode/Main.quorum")
        studio:AddText(". Quorum Studio's version makes a ")
        AddCode(studio, "File")
        studio:AddText(" and gives it the path first, then calls ")
        AddCode(studio, "LoadScene")
        studio:AddText(" with the file. Both do the same thing. Quorum Studio's version doesn't turn on Vulkan
yet, so add the ")
        AddCode(studio, "UseVulkan(true)")
        studio:AddText(" line to ")
        AddCode(studio, "Main")
        studio:AddText(" yourself. For this reason, running a new scene project straight away loads whatever
was placed in its scene and starts the game.")
        section:Add(studio)
    end

    action AddRunningTheScene(Section section)
        AddHeading(section, "Running the Scene", 3)
        section:AddParagraph("To run the scene, use any of these:")
        UnorderedList ways
        ways:AddClassAttribute("list-disc list-outside pl-8")
        ways:AddListItem("the green Run button on the toolbar;")
        ways:AddListItem("the Run menu, then Run;")
        ways:AddListItem("the keys for Run.")
        section:Add(ways)
        WebTable keysTable = LoadWebTable("Keys for running a project", "/html/media/scenes/Running/RunKeys.csv")
        section:Add(keysTable)
        section:AddParagraph("Quorum Studio builds the project, then the game window opens with the scene
loaded. The camera in the game starts where the scene's camera was saved, so the view matches the scene
editor's.")

        Paragraph focus
        AddBold(focus, "A note on focus:")
        focus:AddText(" in the scene editor itself, Cmd+R or Ctrl+R sets the selected item's scale back to 1.
If an item is selected and nothing runs, use the Run button or the Run menu instead.")
        section:Add(focus)
    end

    action AddPhysicsAndGravity(Section section)
        AddHeading(section, "3D Scenes: Physics and Gravity", 3)
        Paragraph intro
        intro:AddText("A 3D scene can be set up in the editor so items fall or roll, but the template above
doesn't turn physics on. Quorum Studio's 3D scene template adds two lines after ")
        AddCode(intro, "LoadScene")
        intro:AddText(":")
        section:Add(intro)
        section:Add(AllowWrapping(preformatter:GeneratePreformattedCode(GetTextFromSource("/html/sources/tutorials/scenes/SceneRunning/RunnerPhysics3D.quorum"))))

        Paragraph order
        AddBold(order, "Order matters.")
        order:AddText(" A scene file remembers whether physics was on in each layer, and the editor saves it
as off. Loading the scene sets it again, so ")
        AddCode(order, "EnablePhysics3D(true)")
        order:AddText(" goes after ")
        AddCode(order, "LoadScene")
        order:AddText(". Gravity starts at zero, so without ")
        AddCode(order, "SetGravity3D")
        order:AddText(" nothing falls.")
        section:Add(order)

        Paragraph items
        items:AddText("Physics only moves the items that ask for it. In the Properties panel, an item that
should fall needs Physics Enabled checked and Responsiveness set to Responsive. Ground that should hold things
up needs Physics Enabled and Unmovable. ")
        AddLink(items, "Properties", "/tutorials/Scenes/properties.html")
        items:AddText(" explains these, and ")
        AddLink(items, "Gravity in 3D", "/tutorials/physics/gravity3D.html")
        items:AddText(" explains gravity in code.")
        section:Add(items)
    end

    action AddHearingWhatHappens(Section section)
        AddHeading(section, "Hearing What Happens: A Beep on Every Bounce", 3)
        section:AddParagraph("Watching a ball fall only works if you can see the screen. A game can also tell
you what happened with sound, so anyone can follow along, including people who use a screen reader. The
program below plays a short high beep whenever two items start touching, such as the ball hitting the floor,
and a lower beep when they stop touching, such as the ball leaving the floor on a bounce:")
        section:Add(AllowWrapping(preformatter:GeneratePreformattedCode(GetTextFromSource("/html/sources/tutorials/scenes/SceneRunning/RunnerBeep.quorum"))))

        Paragraph explain
        AddCode(explain, "Main is Game, CollisionListener3D")
        explain:AddText(" means this game also listens for collisions, and ")
        AddCode(explain, "AddCollisionListener(me)")
        explain:AddText(" tells the 3D layer to send them to it. Each time two items with Physics Enabled start
touching, Quorum calls ")
        AddCode(explain, "BeginCollision")
        explain:AddText(", and each time they stop, ")
        AddCode(explain, "FinishCollision")
        explain:AddText(". ")
        AddCode(explain, "MakeBeep")
        explain:AddText(" builds each sound from numbers instead of loading a sound file: a tenth of a second
of a smooth wave, 880 times a second for the high beep and 440 for the low one.")
        section:Add(explain)

        section:AddParagraph("Listen to a bouncing ball and you'll hear high, low, high, low, with the gaps
between the beeps getting shorter as the bounces get smaller. No beeps at all means nothing touched. That
makes sound a useful way to test a physics scene.")
    end

    action AddScenesWithTerrain(Section section)
        AddHeading(section, "Scenes with Terrain", 3)
        Paragraph intro
        intro:AddText("A scene can have a terrain: the ground of a 3D world, with hills and valleys. Terrain
is drawn with Vulkan, and it is also solid ground for physics, so the program above, with ")
        AddCode(intro, "UseVulkan(true)")
        intro:AddText(" in ")
        AddCode(intro, "Main")
        intro:AddText(" and physics turned on after ")
        AddCode(intro, "LoadScene")
        intro:AddText(", is exactly what a scene with terrain needs.")
        section:Add(intro)

        Paragraph forget
        forget:AddText("If you forget ")
        AddCode(forget, "UseVulkan(true)")
        forget:AddText(", the program stops while loading the scene and says: " + dq + "This scene has a
terrain, and a terrain needs Vulkan for now." + dq + " The fix is to add that line to ")
        AddCode(forget, "Main")
        forget:AddText(" and run again.")
        section:Add(forget)

        Paragraph pages
        pages:AddText("Terrain has its own pages, starting with ")
        AddLink(pages, "Terrain in a Scene", "/tutorials/Scenes/terrain.html")
        pages:AddText(". Loading terrain in a game, and asking it questions, is in ")
        AddLink(pages, "Terrain in a Game", "/tutorials/Scenes/terrainGames.html")
        pages:AddText(".")
        section:Add(pages)
    end

    action AddEngage returns Section
        Section section
        section:AddClassAttribute("flex flex-col gap-y-2")
        AddHeading(section, "Engage", 2)

        Paragraph first
        first:AddText("This activity is the second half of the experiment you started in ")
        AddLink(first, "Properties", "/tutorials/Scenes/properties.html")
        first:AddText(". There, you and your partner wrote a ")
        AddBold(first, "hypothesis")
        first:AddText(" for each physics change: what you thought the ball or cube would do, and why. Now that
you can run a scene, it's time to ")
        AddBold(first, "test")
        first:AddText(" those hypotheses. The goal is to test each hypothesis fairly, one change at a time,
record what really happens, and decide whether the evidence supports it. Don't write new predictions: use the
list you already made. Get it out, and make a table with four columns: the change, your hypothesis, what
actually happened, and whether the result ")
        AddBold(first, "supports")
        first:AddText(" or ")
        AddBold(first, "doesn't support")
        first:AddText(" the hypothesis.")
        section:Add(first)

        Paragraph second
        second:AddText("Set up the same scene as before: an Unmovable floor (a Cube scaled to 10, 0.2 and 10)
and a Responsive Sphere 3 meters above it, both with Physics Enabled. Use the beeping program from " + dq
+ "Hearing What Happens" + dq + ", so every test can be heard as well as seen: a high beep when the ball
lands, and a low beep when it leaves the floor. Run it once without changing anything, so you know what normal
looks and sounds like. Then test your hypotheses one at a time, changing ")
        AddBold(second, "only one thing")
        second:AddText(" for each test and putting it back before the next:")
        section:Add(second)

        UnorderedList tests
        tests:AddClassAttribute("list-disc list-outside pl-8")
        AddBoldItem(tests, "", "Responsiveness:", " Unmovable, then Nonresponsive, then Responsive.")
        AddBoldItem(tests, "", "Restitution:", " 0, then 0.5, then 1, then 1.5, with the floor's at 0.")
        AddBoldItem(tests, "", "Mass:", " 1, then 100.")
        AddBoldItem(tests, "", "Friction:", " a cube on the floor tilted to 20 degrees, with friction 0, then
0.5, then 1.")
        ListItem gravity
        AddBold(gravity, "Gravity:")
        gravity:AddText(" ")
        AddCode(gravity, "0, -1.6, 0")
        gravity:AddText(", then ")
        AddCode(gravity, "0, -25, 0")
        gravity:AddText(", then ")
        AddCode(gravity, "0, 10, 0")
        gravity:AddText(".")
        tests:Add(gravity)
        AddBoldItem(tests, "", "Physics Enabled:", " turned off on the floor.")
        AddBoldItem(tests, "", "A value that doesn't make sense:", " a negative mass or restitution.")
        section:Add(tests)

        Paragraph third
        third:AddText("To measure instead of guessing, use a ")
        AddBold(third, "stopwatch")
        third:AddText(", such as the one on a phone; most phones' stopwatches can be used with a screen reader
too. Base each measurement on timing. One partner starts the stopwatch the moment the game window opens and
stops it at the first high beep: that's how long the ball took to fall. For bounces, use the lap button at each
high beep, and compare the times between beeps: a higher bounce takes longer to come back down, so longer gaps
mean bouncier. For the friction test, time how long the cube takes from landing until its last beep, when it
slides off the end of the floor. Run each test three times and use the middle time, since starting and
stopping a stopwatch by hand is never exact. If you hear no beep at all, that's a result too: write down that
nothing touched.")
        section:Add(third)

        section:AddParagraph("Write every time and sound in your table. When you're done, count how many
hypotheses the tests supported. For each one they didn't support, explain what you now think is going on.
Finally, choose one result where the simulation behaves differently from the real world, and explain whether
that's a mistake in your hypothesis or a limit of the simulation.")
        return section
    end

    action AddWrapup returns Section
        Section section
        section:AddClassAttribute("flex flex-col gap-y-2")
        AddHeading(section, "Wrap up", 2)
        section:AddParagraph("A scene is data: a file that says what is in the world and where. A program brings
it to life, and a graphics engine draws it, with Vulkan for the newest features. Testing your hypotheses one
change at a time is how scientists, and programmers, find out whether their ideas about a system are right.
Which of your results surprised you most, and what would you test next? So far the program only loads the
scene. What would a game need to know about the items in the scene to make one of them move when a key is
pressed?")
        return section
    end

    private action AddStandard(UnorderedList list, text identifier, text standard)
        ListItem item
        AddBold(item, identifier)
        item:AddText(": " + standard)
        list:Add(item)
    end

    private action AddBoldItem(UnorderedList list, text before, text bold, text after)
        ListItem item
        item:AddText(before)
        AddBold(item, bold)
        item:AddText(after)
        list:Add(item)
    end

    private action AddBold(WebTag tag, text value)
        StrongText strong
        strong:AddText(value)
        tag:AddNestedTag(strong)
    end

    private action AddCode(WebTag tag, text value)
        CodeBlock code
        code:AddClassAttribute("break-words")
        code:AddText(value)
        tag:AddNestedTag(code)
    end

    private action AddLink(WebTag tag, text name, text address)
        Link link
        link:AddText(name)
        link:SetAddress(address)
        link:SetClassAttribute("underline text-quorum-blue-150")
        tag:AddNestedTag(link)
    end

    //wraps long lines, so code never scrolls sideways on a narrow screen (WCAG 1.4.10, reflow)
    private action AllowWrapping(PreformattedText code) returns PreformattedText
        code:AddClassAttribute("whitespace-pre-wrap break-words")
        return code
    end

    action GetMetaDescription returns text
        return "Learn how Quorum draws graphics with OpenGL, WebGL and Vulkan, load and run a scene, and test physics hypotheses."
    end

    action GetSummaryName returns text
        return "Running a Scene"
    end

    action GetName returns text
        return GetSummaryName()
    end

    action GetShortDescription returns text
        return "running a scene in Quorum Studio"
    end

    action GetLocation returns text
        return "tutorials/Scenes/running.html"
    end

    action GetLinkName returns text
        return GetSummaryName()
    end

    action GetSectionName returns text
        return "Scene Editing"
    end
end
