package Lessons

use Libraries.Web.Page.all
use Libraries.Web.Page.Standards.ComputerScienceStandards2026
use Libraries.Web.Page.Standards.QuorumStandards

class SceneTerrainShape is QuorumPage
    // The site's sets of standards, built once for every page.
    QuorumStandards standards

    on create
        SetLocation("tutorials/Scenes/terrainShape.html")
    end

    action Setup
        // For search engines and link previews.
        SetDescription("Learn to shape a terrain in Quorum Studio with brush tools, using the keyboard or the mouse.")

        Title("Shaping Terrain")

        Overview()
        WarmUp()
        Explore()
        Engage()
        WrapUp()
    end

    action Overview
        Section("Overview")
        Paragraph("A flat terrain is a start, but games need hills to climb, valleys to hide
in, flat places to build on and ramps to drive up. In this tutorial, you
will shape a terrain by hand with a "):Term("brush"):Text(": a circle on the ground that
changes whatever is under it. Different "):Term("tools"):Text(" make the brush do
different things: raise the ground, lower it, smooth it, flatten it, or
shape it into a ramp. Everything can be done with the mouse or entirely
with the keyboard, and Quorum Studio describes the ground to screen reader
users as the brush moves, so the shape of the land can be explored without
seeing it.")

        Subsection("Goals")
        Goals()
        ListItem("Choose a terrain tool, and change the brush's size, strength and falloff")
        ListItem("Explain what a stroke is")
        ListItem("Shape the ground with Raise, Lower, Smooth, Flatten and Ramp, with the
keyboard or the mouse")
        ListItem("Follow the shape of the ground through Quorum Studio's spoken reports")
    end

    action WarmUp
        Section("Warm up")
        Paragraph("Imagine you can't see the screen. You have just made a hill somewhere on
the ground. How could you find out where it is, how high it is and how
steep its sides are? What would you want the computer to tell you, and how
often?")

        Subsection("Vocabulary")
        Paragraph("You will be learning about the following vocabulary words:")
        Table("Vocabulary", "media/scenes/Terrain/Shaping/Vocabulary.csv")

        Subsection("CSTA Standards")
        ComputerScienceStandards2026 computerScience = standards:GetComputerScience2026()
        CoversStandard(computerScience, computerScience:HIGH_SCHOOL_TESTING_AND_REFINING_20)
        CoversStandard(computerScience, computerScience:SPECIALTY_1_SOFTWARE_DEVELOPMENT_DESIGN_AND_DEVELOPMENT_3)
        CoversStandard(computerScience, computerScience:SPECIALTY_2_GAME_DEVELOPMENT_PLAYER_EXPERIENCE_4)
        StandardsList(computerScience)
    end

    action Explore
        Section("Explore")
        Paragraph("This tutorial uses the terrain from
"):Link("Terrain in a Scene", "/tutorials/Scenes/terrain.html"):Text(". Select it before you
start, from the scene tree, by clicking the ground or with the scene
cursor.")
        ChoosingTool()
        MovingBrush()
        SizeStrengthFalloff()
        MakingStroke()
        ShapingTools()
        OtherTools()
        Keys()
    end

    private action ChoosingTool
        Subsection("Choosing a tool")
        Paragraph("A terrain is shaped with "):Strong("tools"):Text(". Each tool makes the brush do one kind of
change, and only one tool is chosen at a time. With the terrain selected,
choose one in either of two ways:")
        BulletList()
        ListItem():Strong("With the keyboard:"):Text(" press "):Key("Alt"):Text(" and the tool's number (on Mac,
"):Key("Option"):Text(" and the number). The numbers are in the table below.")
        ListItem():Strong("In the Properties panel:"):Text(" the "):Strong("Brush"):Text(" section has a "):Strong("Tool"):Text(" group
listing every tool.")
        Table("Terrain Tools", "media/scenes/Terrain/Shaping/Tools.csv")
        Paragraph("A ring appears on the ground: that is the brush. The first time, it starts
in the middle of the terrain. Screen reader users might hear a phrase such
as:")
        Paragraph():DoubleQuote():Output("Raise tool. Raise brush at 0.0, 0.0, ground height 0.0, slope 0 degrees,
size 5.0"):DoubleQuote()
        Paragraph("To stop using the tool, press "):Key("Escape"):Text(", or choose "):Strong("No tool"):Text(" in the Brush
section. Screen reader users might hear "):DoubleQuote():Output("No tool. The arrow keys move the
selection again."):DoubleQuote():Text(" The terrain stays selected.")
    end

    private action MovingBrush
        Subsection("Moving the brush")
        BulletList()
        ListItem():Strong("With the mouse:"):Text(" the ring follows the pointer over the ground. Off the
ground, it hides.")
        ListItem():Strong("With the keyboard:"):Text(" the arrow keys move the ring across the ground.
The directions are relative to the camera: "):Key("Up"):Text(" moves away from you,
"):Key("Down"):Text(" toward you, and "):Key("Left"):Text(" and "):Key("Right"):Text(" sideways. Hold a key to keep
moving.")
        Paragraph("Each time the brush moves by a key, Quorum Studio reports the height of the
ground under its middle. Screen reader users might hear a phrase such as
"):DoubleQuote():Output("Height 0.0"):DoubleQuote():Text(", or "):DoubleQuote():Output("Off the ground"):DoubleQuote():Text(" past the terrain's edge. When you let go
of the arrow key, the full description follows: the tool, where the brush
is, the ground's height and slope, and the brush's size.")
    end

    private action SizeStrengthFalloff
        Subsection("Size, strength and falloff")
        Paragraph("The brush has three settings, shown in the Brush section:")
        BulletList()
        ListItem():Strong("Size"):Text(" is the brush's radius, in world units. Press "):Keys("Alt", "="):Text(" to make it
larger and "):Keys("Alt", "-"):Text(" to make it smaller (on Mac, "):Keys("Option", "="):Text(" and
"):Keys("Option", "-"):Text("). Screen reader users might hear a phrase such as "):DoubleQuote():Output("Brush size
5.8"):DoubleQuote():Text(".")
        ListItem():Strong("Strength"):Text(" is how fast the tool works. For Raise and Lower, it is how
many units per second the middle of the brush rises or sinks. Press
"):Keys("Alt", "]"):Text(" for stronger and "):Keys("Alt", "["):Text(" for weaker (on Mac, "):Keys("Option", "]"):Text(" and
"):Keys("Option", "["):Text("). Screen reader users might hear a phrase such as "):DoubleQuote():Output("Brush
strength 1.25"):DoubleQuote():Text(".")
        ListItem():Strong("Falloff"):Text(" is how the effect fades from the middle of the brush to its
edge. At 1, it fades smoothly. Above 1, the change stays closer to the
middle, which makes sharper peaks. Below 1, it spreads out toward the
edge, which makes rounder, wider hills. Falloff has no key; type it in
the panel.")
        Paragraph("You can also type a size or strength in the panel. Press "):Keys("Cmd", "P"):Text(" on Mac or
"):Keys("Ctrl", "P"):Text(" on Windows to move into the panel, and "):Key("Escape"):Text(" to go back to the
scene.")
    end

    private action MakingStroke
        Subsection("Making a stroke")
        Paragraph("A "):Term("stroke"):Text(" is one continuous use of a tool: it starts when you start
pressing and ends when you let go. While a stroke goes on, the tool keeps
working on the ground under the brush, a little more on every frame, so
holding longer makes a bigger change, the way holding a paint spray longer
puts on more paint. You can move the brush during a stroke, to draw a ridge,
a trench or a path. Everything from pressing to letting go counts as one
change: Quorum Studio treats the whole stroke as a single step, and reports
it as one result when it ends. A quick tap changes very little; hold for a
second or more, or make the brush stronger, for a bigger change.")
        BulletList()
        ListItem():Strong("With the keyboard:"):Text(" hold "):Key("Space"):Text(". Press the arrow keys while holding
it to move the brush as you go.")
        ListItem():Strong("With the mouse:"):Text(" press the left button on the ground and drag. A click
moves the brush to the pointer and starts the stroke there.")
        Paragraph("When a stroke ends, Quorum Studio reports what changed and the new height
under the brush. Screen reader users might hear a phrase such as "):DoubleQuote():Output("Raised by
up to 2.4. Height 2.4"):DoubleQuote():Text(". If nothing changed, it reports "):DoubleQuote():Output("Nothing changed"):DoubleQuote():Text(". If
the brush is past the edge of the ground, the stroke doesn't start, and it
reports "):DoubleQuote():Output("The brush is off the ground"):DoubleQuote():Text(".")
        Paragraph():Strong("Changed your mind during a stroke?"):Text(" Press "):Key("Escape"):Text(" while still holding
"):Key("Space"):Text(" or the mouse button. The ground goes back to how it was, and Quorum
Studio reports "):DoubleQuote():Output("Stroke canceled"):DoubleQuote():Text(". Pressing "):Key("Escape"):Text(" again leaves the tool.
Saving the scene saves the shaped ground.")
    end

    private action ShapingTools
        Subsection("The shaping tools")

        // Raise
        Subsubsection("Raise")
        Paragraph("Raise pushes the ground up under the brush, highest in the middle and
fading toward the edge, so a short stroke makes a small bump and a longer
one makes a hill. Moving the brush during the stroke draws a ridge. It is
the tool to start with for hills, mountains and walls of earth.")
        NumberedList()
        ListItem("Choose Raise: press "):Keys("Alt", "1"):Text(" ("):Keys("Option", "1"):Text(" on Mac), or choose "):Strong("Raise"):Text(" in
the Brush section's Tool group.")
        ListItem("Move the brush to where the hill should be, with the arrow keys or the
mouse pointer.")
        ListItem("Hold "):Key("Space"):Text(", or press the left mouse button and drag, until the hill is
as high as you want. Let go to end the stroke.")
        ListItem("Screen reader users might hear a phrase such as "):DoubleQuote():Output("Raised by up to 2.4.
Height 2.4"):DoubleQuote():Text(".")

        // Lower
        Subsubsection("Lower")
        Paragraph("Lower is the opposite of Raise: it pushes the ground down under the brush,
deepest in the middle. Use it for valleys, holes, riverbeds and lakes. The
ground can go below 0, so a lake can sit below the flat ground around it.")
        NumberedList()
        ListItem("Choose Lower: press "):Keys("Alt", "2"):Text(" ("):Keys("Option", "2"):Text(" on Mac), or choose "):Strong("Lower"):Text(" in
the Tool group.")
        ListItem("Move the brush to where the dip should be.")
        ListItem("Hold "):Key("Space"):Text(", or press the left mouse button and drag. Let go to end the
stroke.")
        ListItem("Screen reader users might hear a phrase such as "):DoubleQuote():Output("Lowered by up to 1.8.
Height -1.8"):DoubleQuote():Text(".")

        // Smooth
        Subsubsection("Smooth")
        Paragraph("Smooth evens out the ground under the brush by pulling each point toward the
heights around it. Sharp peaks get rounder, steep edges get gentler, and
small bumps disappear, without moving the ground much overall. Use it after
Raise and Lower to make the land look natural.")
        NumberedList()
        ListItem("Choose Smooth: press "):Keys("Alt", "3"):Text(" ("):Keys("Option", "3"):Text(" on Mac), or choose "):Strong("Smooth"):Text(" in
the Tool group.")
        ListItem("Move the brush over the rough or sharp area.")
        ListItem("Hold "):Key("Space"):Text(", or press the left mouse button and drag over the area.
Let go to end the stroke.")
        ListItem("Screen reader users might hear a phrase such as "):DoubleQuote():Output("Smoothed, changing
heights by up to 0.6. Height 1.9"):DoubleQuote():Text(".")

        // Flatten: the two choices, then the steps
        Subsubsection("Flatten")
        Paragraph("Flatten evens the ground toward one height, making a level place, such as
the top of a plateau, a building site or a sports field. Ground higher than
that height is pulled down, and ground lower is pulled up. In the Brush
section, "):Strong("Flatten to"):Text(" chooses which height:")
        BulletList()
        ListItem():Strong("This height"):Text(", the number in the "):Strong("Height"):Text(" field. It starts at 0. Press
"):Keys("Alt", "M"):Text(" ("):Keys("Option", "M"):Text(" on Mac), or use the "):Strong("Use the height under the
brush"):Text(" button, to set it to the ground's height where the brush is now.")
        ListItem():Strong("The height where each stroke starts"):Text(", so each stroke levels the ground
to wherever it began.")
        NumberedList()
        ListItem("Choose Flatten: press "):Keys("Alt", "4"):Text(" ("):Keys("Option", "4"):Text(" on Mac), or choose "):Strong("Flatten"):Text("
in the Tool group.")
        ListItem("Choose the height to flatten to. For example, move the brush onto a
hilltop and press "):Keys("Alt", "M"):Text(". Screen reader users might hear a phrase such
as "):DoubleQuote():Output("Flatten to height 2.4"):DoubleQuote():Text(".")
        ListItem("Move the brush to the area to level.")
        ListItem("Hold "):Key("Space"):Text(", or press the left mouse button and drag over the area.
Let go to end the stroke.")
        ListItem("Screen reader users might hear a phrase such as "):DoubleQuote():Output("Flattened, changing
heights by up to 1.2. Height 2.4"):DoubleQuote():Text(".")

        // Ramp
        Subsubsection("Ramp")
        Paragraph("Ramp shapes the ground into a straight slope between two points you
choose, its "):Strong("start"):Text(" and its "):Strong("end"):Text(". Each point keeps the ground's height
where you set it, so a ramp from a valley floor to a hilltop climbs evenly
from one to the other. Painting with the Ramp tool pulls the ground under
the brush toward that slope. Use it for paths, roads and ramps that a
player or a car can climb. The Brush section shows the ramp's two ends, and
has "):Strong("Set ramp start"):Text(", "):Strong("Set ramp end"):Text(" and "):Strong("New ramp"):Text(" buttons.")
        NumberedList()
        ListItem("Choose Ramp: press "):Keys("Alt", "5"):Text(" ("):Keys("Option", "5"):Text(" on Mac), or choose "):Strong("Ramp"):Text(" in the
Tool group.")
        ListItem("Move the brush to where the ramp starts, and press "):Keys("Alt", "G"):Text(" ("):Keys("Option", "G"):Text("
on Mac), or click there with the mouse. Screen reader users might hear a
phrase such as "):DoubleQuote():Output("Ramp start at -10.0, 0.0, height 0.0. Now set its end."):DoubleQuote()
        ListItem("Move the brush to where the ramp ends, and press "):Keys("Alt", "G"):Text(" again, or
click there. Screen reader users might hear a phrase such as "):DoubleQuote():Output("Ramp end at
10.0, 0.0, height 4.0. The ramp is ready: from -10.0, 0.0 at height 0.0,
to 10.0, 0.0 at height 4.0"):DoubleQuote():Text(".")
        ListItem("Move the brush along the line between the two ends, and hold "):Key("Space"):Text(", or
press the left mouse button and drag, to shape the ground into the ramp.
Let go to end the stroke.")
        ListItem("Screen reader users might hear a phrase such as "):DoubleQuote():Output("Shaped the ramp,
changing heights by up to 1.5. Height 2.0"):DoubleQuote():Text(".")
        ListItem("To make another ramp, use "):Strong("New ramp"):Text(" in the Brush section, then set
two new ends.")
        Paragraph("If you try to shape the ramp before setting both ends, Quorum Studio
reports "):DoubleQuote():Output("Set the ramp first: click where it starts, then where it ends, or
press Alt+G at each end."):DoubleQuote()
    end

    private action OtherTools
        Subsection("Other tools")
        Paragraph("The Tool group has four more tools, covered in other tutorials:")
        BulletList()
        ListItem():Strong("Paint"):Text(" ("):Keys("Alt", "6"):Text(", "):Keys("Option", "6"):Text(" on Mac) paints a material onto the ground.
See "):Link("Terrain Materials and Painting", "/tutorials/Scenes/terrainMaterials.html"):Text(".")
        ListItem():Strong("Blend paint"):Text(" ("):Keys("Alt", "7"):Text(", "):Keys("Option", "7"):Text(" on Mac) will soften the edges between
painted materials. It isn't ready yet: choosing it and starting a stroke
reports "):DoubleQuote():Output("Blend paint strokes aren't ready yet. The other tools are."):DoubleQuote()
        ListItem():Strong("Add region"):Text(" ("):Keys("Alt", "8"):Text(", "):Keys("Option", "8"):Text(" on Mac) adds a new square of flat
ground where the brush is, so the world can grow beyond its edges.")
        ListItem():Strong("Remove region"):Text(" ("):Keys("Alt", "9"):Text(", "):Keys("Option", "9"):Text(" on Mac) removes the region under
the brush.")
        Paragraph("The two region tools work like the others: move the brush and hold "):Key("Space"):Text(",
or click. "):Link("Generating Terrain", "/tutorials/Scenes/terrainGenerate.html"):Text("
explains regions in more detail.")
    end

    private action Keys
        Subsection("The keys")
        Table("Terrain Brush Keys", "media/scenes/Terrain/Shaping/Keys.csv")
        Paragraph("Every one of these keys can be changed in Quorum Studio's key map, like the
other scene editor keys.")
    end

    action Engage
        Section("Engage")
        Paragraph("In this activity, one partner shapes a terrain and the other explores it
without looking at the screen. The goal is to practice shaping terrain with
the tools, and to experience how Quorum Studio describes the ground in
words. Each of you adds a terrain to your own scene. While Partner B looks
away, Partner A shapes three features somewhere on the terrain: a hill with
a flattened top, made with Raise and then Flatten; a valley, made with
Lower and then Smooth; and a ramp leading up the side of the hill. Save the
scene. Then Partner B finds the three features without looking: with a
screen reader on, or with the screen covered while Partner A reads out what
Quorum Studio reports. Choose a tool so the brush appears, then move it
with the arrow keys, listening to the height after each step and the full
description when you let go. Partner B then says roughly where each feature
is, how high or deep it is, and how steep, and Partner A checks. Swap roles.")
        Paragraph("Then give each other feedback on the reports. Which messages helped most?
What was missing, or said too often? If you could change one thing about how
Quorum Studio describes the ground, what would it be, and why? Write your
suggestion down as you would for a bug report or feature request.")
    end

    action WrapUp
        Section("Wrap up")
        Paragraph("A brush changes the heights you met in
"):Link("Terrain in a Scene", "/tutorials/Scenes/terrain.html"):Text(", one stroke at a time:
raising, lowering, smoothing, flattening and ramping. Quorum Studio
describes the ground in words as well as pictures, which is what lets someone shape and explore a world
without seeing it. Think about a game you know: how does it tell a player
about the shape of the land? In the next tutorial,
"):Link("Generating Terrain", "/tutorials/Scenes/terrainGenerate.html"):Text(", you will make
whole landscapes at once by following rules instead of by hand.")
    end
end
