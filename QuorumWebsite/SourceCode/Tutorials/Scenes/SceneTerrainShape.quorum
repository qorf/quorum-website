use Libraries.Web.Page.all
use Libraries.Containers.Array

class SceneTerrainShape is Lesson
    text dq = ""
    dq = dq:GetDoubleQuote()
    text cr = ""
    cr = cr:GetCarriageReturn()

    action Setup
        //html header stuff
        SetWebPageTitle("Shaping Terrain - Quorum Programming Language")
        AddDefaultHeaders()

        //page header
        Array<Division> divs = InitializeTutorialPage()
        Division bodyDiv = divs:Get(1)
        Division onPageDiv = divs:Get(2)

        Header headDiv
        headDiv:SetClassAttribute("flex flex-col gap-y-2")
        AddHeading(headDiv, "Shaping Terrain", 1)
        bodyDiv:Add(headDiv)

        bodyDiv:Add(AddOverview())
        bodyDiv:Add(AddWarmup())
        bodyDiv:Add(AddExplore())
        bodyDiv:Add(AddEngage())
        bodyDiv:Add(AddWrapup())

        Section nextLesson
        nextLesson:AddClassAttribute("flex flex-col gap-y-2")
        bodyDiv:Add(nextLesson)
        WriteNextTutorial(nextLesson)
        onPageDiv:Add(CreateHeadingTableOfContents())
    end

    action AddOverview returns Section
        Section section
        section:AddClassAttribute("flex flex-col gap-y-2")
        AddHeading(section, "Overview", 2)
        Paragraph paragraph1
        paragraph1:AddText("A flat terrain is a start, but games need hills to climb, valleys to hide
in, flat places to build on and ramps to drive up. In this tutorial, you
will shape a terrain by hand with a ")
        AddBold(paragraph1, "brush")
        paragraph1:AddText(": a circle on the ground that
changes whatever is under it. Different ")
        AddBold(paragraph1, "tools")
        paragraph1:AddText(" make the brush do
different things: raise the ground, lower it, smooth it, flatten it, or
shape it into a ramp. Everything can be done with the mouse or entirely
with the keyboard, and Quorum Studio describes the ground to screen reader
users as the brush moves, so the shape of the land can be explored without
seeing it.")
        section:Add(paragraph1)

        AddHeading(section, "Goals", 3)
        section:AddParagraph("You have the following goals for this lesson:")
        UnorderedList list1
        list1:AddClassAttribute("list-disc list-outside pl-8")
        list1:AddListItem("Choose a terrain tool, and change the brush's size, strength and falloff")
        list1:AddListItem("Explain what a stroke is")
        list1:AddListItem("Shape the ground with Raise, Lower, Smooth, Flatten and Ramp, with the
keyboard or the mouse")
        list1:AddListItem("Follow the shape of the ground through Quorum Studio's spoken reports")
        section:Add(list1)
        return section
    end

    action AddWarmup returns Section
        Section section
        section:AddClassAttribute("flex flex-col gap-y-2")
        AddHeading(section, "Warm up", 2)
        section:AddParagraph("Imagine you can't see the screen. You have just made a hill somewhere on
the ground. How could you find out where it is, how high it is and how
steep its sides are? What would you want the computer to tell you, and how
often?")

        AddHeading(section, "Vocabulary", 3)
        section:AddParagraph("You will be learning about the following vocabulary words:")
        WebTable table1 = LoadWebTable("Vocabulary", "/html/media/scenes/Terrain/Shaping/Vocabulary.csv")
        section:Add(table1)

        AddHeading(section, "CSTA Standards", 3)
        Paragraph standardsParagraph
        standardsParagraph:AddText("This lesson covers the following standards, from the ")
        AddLink(standardsParagraph, "2026 CSTA K–12 Computer Science Standards", "https://csteachers.org/pk12standards/view/")
        standardsParagraph:AddText(":")
        section:Add(standardsParagraph)

        UnorderedList standards
        standards:AddClassAttribute("list-disc list-outside pl-8")
        AddStandard(standards, "HS-PRO-TR-20", "Refine a computing technology based on user feedback, testing results, and responsible design values to improve its effectiveness and impact.")
        AddStandard(standards, "S1-SWD-DD-03", "Use integrated development environment (IDE) features to streamline software development, including code editing, debugging, version control, and project management.")
        AddStandard(standards, "S2-GMD-PX-04", "Evaluate game interactions using diverse input devices to enhance immersion and player experience.")
        section:Add(standards)
        return section
    end

    action AddExplore returns Section
        Section section
        section:AddClassAttribute("flex flex-col gap-y-2")
        AddHeading(section, "Explore", 2)
        Paragraph paragraph1
        paragraph1:AddText("This tutorial uses the terrain from
")
        AddLink(paragraph1, "Terrain in a Scene", "/tutorials/Scenes/terrain.html")
        paragraph1:AddText(". Select it before you
start, from the scene tree, by clicking the ground or with the scene
cursor.")
        section:Add(paragraph1)
        AddChoosingTool(section)
        AddMovingBrush(section)
        AddSizeStrengthFalloff(section)
        AddMakingStroke(section)
        AddShapingTools(section)
        AddOtherTools(section)
        AddKeys(section)
        return section
    end

    action AddChoosingTool(Section section)
        AddHeading(section, "Choosing a tool", 3)
        Paragraph paragraph2
        paragraph2:AddText("A terrain is shaped with ")
        AddBold(paragraph2, "tools")
        paragraph2:AddText(". Each tool makes the brush do one kind of
change, and only one tool is chosen at a time. With the terrain selected,
choose one in either of two ways:")
        section:Add(paragraph2)
        UnorderedList list1
        list1:AddClassAttribute("list-disc list-outside pl-8")
        ListItem item1
        AddBold(item1, "With the keyboard:")
        item1:AddText(" press ")
        AddKey(item1, "Alt")
        item1:AddText(" and the tool's number (on Mac,
")
        AddKey(item1, "Option")
        item1:AddText(" and the number). The numbers are in the table below.")
        list1:Add(item1)
        ListItem item2
        AddBold(item2, "In the Properties panel:")
        item2:AddText(" the ")
        AddBold(item2, "Brush")
        item2:AddText(" section has a ")
        AddBold(item2, "Tool")
        item2:AddText(" group
listing every tool.")
        list1:Add(item2)
        section:Add(list1)
        WebTable table1 = LoadWebTable("Terrain Tools", "/html/media/scenes/Terrain/Shaping/Tools.csv")
        section:Add(table1)
        section:AddParagraph("A ring appears on the ground: that is the brush. The first time, it starts
in the middle of the terrain. Screen reader users might hear a phrase such
as:")
        section:AddParagraph(dq + "Raise tool. Raise brush at 0.0, 0.0, ground height 0.0, slope 0 degrees,
size 5.0" + dq)
        Paragraph paragraph3
        paragraph3:AddText("To stop using the tool, press ")
        AddKey(paragraph3, "Escape")
        paragraph3:AddText(", or choose ")
        AddBold(paragraph3, "No tool")
        paragraph3:AddText(" in the Brush
section. Screen reader users might hear " + dq + "No tool. The arrow keys move the
selection again." + dq + " The terrain stays selected.")
        section:Add(paragraph3)
    end

    action AddMovingBrush(Section section)
        AddHeading(section, "Moving the brush", 3)
        UnorderedList list2
        list2:AddClassAttribute("list-disc list-outside pl-8")
        ListItem item3
        AddBold(item3, "With the mouse:")
        item3:AddText(" the ring follows the pointer over the ground. Off the
ground, it hides.")
        list2:Add(item3)
        ListItem item4
        AddBold(item4, "With the keyboard:")
        item4:AddText(" the arrow keys move the ring across the ground.
The directions are relative to the camera: ")
        AddKey(item4, "Up")
        item4:AddText(" moves away from you,
")
        AddKey(item4, "Down")
        item4:AddText(" toward you, and ")
        AddKey(item4, "Left")
        item4:AddText(" and ")
        AddKey(item4, "Right")
        item4:AddText(" sideways. Hold a key to keep
moving.")
        list2:Add(item4)
        section:Add(list2)
        section:AddParagraph("Each time the brush moves by a key, Quorum Studio reports the height of the
ground under its middle. Screen reader users might hear a phrase such as
" + dq + "Height 0.0" + dq + ", or " + dq + "Off the ground" + dq + " past the terrain's edge. When you let go
of the arrow key, the full description follows: the tool, where the brush
is, the ground's height and slope, and the brush's size.")
    end

    action AddSizeStrengthFalloff(Section section)
        AddHeading(section, "Size, strength and falloff", 3)
        section:AddParagraph("The brush has three settings, shown in the Brush section:")
        UnorderedList list3
        list3:AddClassAttribute("list-disc list-outside pl-8")
        ListItem item5
        AddBold(item5, "Size")
        item5:AddText(" is the brush's radius, in world units. Press ")
        AddKey(item5, "Alt+=")
        item5:AddText(" to make it
larger and ")
        AddKey(item5, "Alt+-")
        item5:AddText(" to make it smaller (on Mac, ")
        AddKey(item5, "Option+=")
        item5:AddText(" and
")
        AddKey(item5, "Option+-")
        item5:AddText("). Screen reader users might hear a phrase such as " + dq + "Brush size
5.8" + dq + ".")
        list3:Add(item5)
        ListItem item6
        AddBold(item6, "Strength")
        item6:AddText(" is how fast the tool works. For Raise and Lower, it is how
many units per second the middle of the brush rises or sinks. Press
")
        AddKey(item6, "Alt+]")
        item6:AddText(" for stronger and ")
        AddKey(item6, "Alt+[")
        item6:AddText(" for weaker (on Mac, ")
        AddKey(item6, "Option+]")
        item6:AddText(" and
")
        AddKey(item6, "Option+[")
        item6:AddText("). Screen reader users might hear a phrase such as " + dq + "Brush
strength 1.25" + dq + ".")
        list3:Add(item6)
        ListItem item7
        AddBold(item7, "Falloff")
        item7:AddText(" is how the effect fades from the middle of the brush to its
edge. At 1, it fades smoothly. Above 1, the change stays closer to the
middle, which makes sharper peaks. Below 1, it spreads out toward the
edge, which makes rounder, wider hills. Falloff has no key; type it in
the panel.")
        list3:Add(item7)
        section:Add(list3)
        Paragraph paragraph4
        paragraph4:AddText("You can also type a size or strength in the panel. Press ")
        AddKey(paragraph4, "Cmd+P")
        paragraph4:AddText(" on Mac or
")
        AddKey(paragraph4, "Ctrl+P")
        paragraph4:AddText(" on Windows to move into the panel, and ")
        AddKey(paragraph4, "Escape")
        paragraph4:AddText(" to go back to the
scene.")
        section:Add(paragraph4)
    end

    action AddMakingStroke(Section section)
        AddHeading(section, "Making a stroke", 3)
        Paragraph paragraph5
        paragraph5:AddText("A ")
        AddBold(paragraph5, "stroke")
        paragraph5:AddText(" is one continuous use of a tool: it starts when you start
pressing and ends when you let go. While a stroke goes on, the tool keeps
working on the ground under the brush, a little more on every frame, so
holding longer makes a bigger change, the way holding a paint spray longer
puts on more paint. You can move the brush during a stroke, to draw a ridge,
a trench or a path. Everything from pressing to letting go counts as one
change: Quorum Studio treats the whole stroke as a single step, and reports
it as one result when it ends. A quick tap changes very little; hold for a
second or more, or make the brush stronger, for a bigger change.")
        section:Add(paragraph5)
        UnorderedList list4
        list4:AddClassAttribute("list-disc list-outside pl-8")
        ListItem item8
        AddBold(item8, "With the keyboard:")
        item8:AddText(" hold ")
        AddKey(item8, "Space")
        item8:AddText(". Press the arrow keys while holding
it to move the brush as you go.")
        list4:Add(item8)
        ListItem item9
        AddBold(item9, "With the mouse:")
        item9:AddText(" press the left button on the ground and drag. A click
moves the brush to the pointer and starts the stroke there.")
        list4:Add(item9)
        section:Add(list4)
        section:AddParagraph("When a stroke ends, Quorum Studio reports what changed and the new height
under the brush. Screen reader users might hear a phrase such as " + dq + "Raised by
up to 2.4. Height 2.4" + dq + ". If nothing changed, it reports " + dq + "Nothing changed" + dq + ". If
the brush is past the edge of the ground, the stroke doesn't start, and it
reports " + dq + "The brush is off the ground" + dq + ".")
        Paragraph paragraph6
        AddBold(paragraph6, "Changed your mind during a stroke?")
        paragraph6:AddText(" Press ")
        AddKey(paragraph6, "Escape")
        paragraph6:AddText(" while still holding
")
        AddKey(paragraph6, "Space")
        paragraph6:AddText(" or the mouse button. The ground goes back to how it was, and Quorum
Studio reports " + dq + "Stroke canceled" + dq + ". Pressing ")
        AddKey(paragraph6, "Escape")
        paragraph6:AddText(" again leaves the tool.
Saving the scene saves the shaped ground.")
        section:Add(paragraph6)
    end

    action AddShapingTools(Section section)
        AddHeading(section, "The shaping tools", 3)
        AddHeading(section, "Raise", 4)
        section:AddParagraph("Raise pushes the ground up under the brush, highest in the middle and
fading toward the edge, so a short stroke makes a small bump and a longer
one makes a hill. Moving the brush during the stroke draws a ridge. It is
the tool to start with for hills, mountains and walls of earth.")
        OrderedList list5
        list5:AddClassAttribute("list-decimal list-outside pl-8")
        ListItem item10
        item10:AddText("Choose Raise: press ")
        AddKey(item10, "Alt+1")
        item10:AddText(" (")
        AddKey(item10, "Option+1")
        item10:AddText(" on Mac), or choose ")
        AddBold(item10, "Raise")
        item10:AddText(" in
the Brush section's Tool group.")
        list5:Add(item10)
        list5:AddListItem("Move the brush to where the hill should be, with the arrow keys or the
mouse pointer.")
        ListItem item11
        item11:AddText("Hold ")
        AddKey(item11, "Space")
        item11:AddText(", or press the left mouse button and drag, until the hill is
as high as you want. Let go to end the stroke.")
        list5:Add(item11)
        list5:AddListItem("Screen reader users might hear a phrase such as " + dq + "Raised by up to 2.4.
Height 2.4" + dq + ".")
        section:Add(list5)
        AddHeading(section, "Lower", 4)
        section:AddParagraph("Lower is the opposite of Raise: it pushes the ground down under the brush,
deepest in the middle. Use it for valleys, holes, riverbeds and lakes. The
ground can go below 0, so a lake can sit below the flat ground around it.")
        OrderedList list6
        list6:AddClassAttribute("list-decimal list-outside pl-8")
        ListItem item12
        item12:AddText("Choose Lower: press ")
        AddKey(item12, "Alt+2")
        item12:AddText(" (")
        AddKey(item12, "Option+2")
        item12:AddText(" on Mac), or choose ")
        AddBold(item12, "Lower")
        item12:AddText(" in
the Tool group.")
        list6:Add(item12)
        list6:AddListItem("Move the brush to where the dip should be.")
        ListItem item13
        item13:AddText("Hold ")
        AddKey(item13, "Space")
        item13:AddText(", or press the left mouse button and drag. Let go to end the
stroke.")
        list6:Add(item13)
        list6:AddListItem("Screen reader users might hear a phrase such as " + dq + "Lowered by up to 1.8.
Height -1.8" + dq + ".")
        section:Add(list6)
        AddHeading(section, "Smooth", 4)
        section:AddParagraph("Smooth evens out the ground under the brush by pulling each point toward the
heights around it. Sharp peaks get rounder, steep edges get gentler, and
small bumps disappear, without moving the ground much overall. Use it after
Raise and Lower to make the land look natural.")
        OrderedList list7
        list7:AddClassAttribute("list-decimal list-outside pl-8")
        ListItem item14
        item14:AddText("Choose Smooth: press ")
        AddKey(item14, "Alt+3")
        item14:AddText(" (")
        AddKey(item14, "Option+3")
        item14:AddText(" on Mac), or choose ")
        AddBold(item14, "Smooth")
        item14:AddText(" in
the Tool group.")
        list7:Add(item14)
        list7:AddListItem("Move the brush over the rough or sharp area.")
        ListItem item15
        item15:AddText("Hold ")
        AddKey(item15, "Space")
        item15:AddText(", or press the left mouse button and drag over the area.
Let go to end the stroke.")
        list7:Add(item15)
        list7:AddListItem("Screen reader users might hear a phrase such as " + dq + "Smoothed, changing
heights by up to 0.6. Height 1.9" + dq + ".")
        section:Add(list7)
        AddHeading(section, "Flatten", 4)
        Paragraph paragraph7
        paragraph7:AddText("Flatten evens the ground toward one height, making a level place, such as
the top of a plateau, a building site or a sports field. Ground higher than
that height is pulled down, and ground lower is pulled up. In the Brush
section, ")
        AddBold(paragraph7, "Flatten to")
        paragraph7:AddText(" chooses which height:")
        section:Add(paragraph7)
        UnorderedList list8
        list8:AddClassAttribute("list-disc list-outside pl-8")
        ListItem item16
        AddBold(item16, "This height")
        item16:AddText(", the number in the ")
        AddBold(item16, "Height")
        item16:AddText(" field. It starts at 0. Press
")
        AddKey(item16, "Alt+M")
        item16:AddText(" (")
        AddKey(item16, "Option+M")
        item16:AddText(" on Mac), or use the ")
        AddBold(item16, "Use the height under the
brush")
        item16:AddText(" button, to set it to the ground's height where the brush is now.")
        list8:Add(item16)
        ListItem item17
        AddBold(item17, "The height where each stroke starts")
        item17:AddText(", so each stroke levels the ground
to wherever it began.")
        list8:Add(item17)
        ListItem item18
        item18:AddText("Choose Flatten: press ")
        AddKey(item18, "Alt+4")
        item18:AddText(" (")
        AddKey(item18, "Option+4")
        item18:AddText(" on Mac), or choose ")
        AddBold(item18, "Flatten")
        item18:AddText("
in the Tool group.")
        list8:Add(item18)
        ListItem item19
        item19:AddText("Choose the height to flatten to. For example, move the brush onto a
hilltop and press ")
        AddKey(item19, "Alt+M")
        item19:AddText(". Screen reader users might hear a phrase such
as " + dq + "Flatten to height 2.4" + dq + ".")
        list8:Add(item19)
        list8:AddListItem("Move the brush to the area to level.")
        ListItem item20
        item20:AddText("Hold ")
        AddKey(item20, "Space")
        item20:AddText(", or press the left mouse button and drag over the area.
Let go to end the stroke.")
        list8:Add(item20)
        list8:AddListItem("Screen reader users might hear a phrase such as " + dq + "Flattened, changing
heights by up to 1.2. Height 2.4" + dq + ".")
        section:Add(list8)
        AddHeading(section, "Ramp", 4)
        Paragraph paragraph8
        paragraph8:AddText("Ramp shapes the ground into a straight slope between two points you
choose, its ")
        AddBold(paragraph8, "start")
        paragraph8:AddText(" and its ")
        AddBold(paragraph8, "end")
        paragraph8:AddText(". Each point keeps the ground's height
where you set it, so a ramp from a valley floor to a hilltop climbs evenly
from one to the other. Painting with the Ramp tool pulls the ground under
the brush toward that slope. Use it for paths, roads and ramps that a
player or a car can climb. The Brush section shows the ramp's two ends, and
has ")
        AddBold(paragraph8, "Set ramp start")
        paragraph8:AddText(", ")
        AddBold(paragraph8, "Set ramp end")
        paragraph8:AddText(" and ")
        AddBold(paragraph8, "New ramp")
        paragraph8:AddText(" buttons.")
        section:Add(paragraph8)
        OrderedList list9
        list9:AddClassAttribute("list-decimal list-outside pl-8")
        ListItem item21
        item21:AddText("Choose Ramp: press ")
        AddKey(item21, "Alt+5")
        item21:AddText(" (")
        AddKey(item21, "Option+5")
        item21:AddText(" on Mac), or choose ")
        AddBold(item21, "Ramp")
        item21:AddText(" in the
Tool group.")
        list9:Add(item21)
        ListItem item22
        item22:AddText("Move the brush to where the ramp starts, and press ")
        AddKey(item22, "Alt+G")
        item22:AddText(" (")
        AddKey(item22, "Option+G")
        item22:AddText("
on Mac), or click there with the mouse. Screen reader users might hear a
phrase such as " + dq + "Ramp start at -10.0, 0.0, height 0.0. Now set its end." + dq)
        list9:Add(item22)
        ListItem item23
        item23:AddText("Move the brush to where the ramp ends, and press ")
        AddKey(item23, "Alt+G")
        item23:AddText(" again, or
click there. Screen reader users might hear a phrase such as " + dq + "Ramp end at
10.0, 0.0, height 4.0. The ramp is ready: from -10.0, 0.0 at height 0.0,
to 10.0, 0.0 at height 4.0" + dq + ".")
        list9:Add(item23)
        ListItem item24
        item24:AddText("Move the brush along the line between the two ends, and hold ")
        AddKey(item24, "Space")
        item24:AddText(", or
press the left mouse button and drag, to shape the ground into the ramp.
Let go to end the stroke.")
        list9:Add(item24)
        list9:AddListItem("Screen reader users might hear a phrase such as " + dq + "Shaped the ramp,
changing heights by up to 1.5. Height 2.0" + dq + ".")
        ListItem item25
        item25:AddText("To make another ramp, use ")
        AddBold(item25, "New ramp")
        item25:AddText(" in the Brush section, then set
two new ends.")
        list9:Add(item25)
        section:Add(list9)
        section:AddParagraph("If you try to shape the ramp before setting both ends, Quorum Studio
reports " + dq + "Set the ramp first: click where it starts, then where it ends, or
press Alt+G at each end." + dq)
    end

    action AddOtherTools(Section section)
        AddHeading(section, "Other tools", 3)
        section:AddParagraph("The Tool group has four more tools, covered in other tutorials:")
        UnorderedList list10
        list10:AddClassAttribute("list-disc list-outside pl-8")
        ListItem item26
        AddBold(item26, "Paint")
        item26:AddText(" (")
        AddKey(item26, "Alt+6")
        item26:AddText(", ")
        AddKey(item26, "Option+6")
        item26:AddText(" on Mac) paints a material onto the ground.
See ")
        AddLink(item26, "Terrain Materials and Painting", "/tutorials/Scenes/terrainMaterials.html")
        item26:AddText(".")
        list10:Add(item26)
        ListItem item27
        AddBold(item27, "Blend paint")
        item27:AddText(" (")
        AddKey(item27, "Alt+7")
        item27:AddText(", ")
        AddKey(item27, "Option+7")
        item27:AddText(" on Mac) will soften the edges between
painted materials. It isn't ready yet: choosing it and starting a stroke
reports " + dq + "Blend paint strokes aren't ready yet. The other tools are." + dq)
        list10:Add(item27)
        ListItem item28
        AddBold(item28, "Add region")
        item28:AddText(" (")
        AddKey(item28, "Alt+8")
        item28:AddText(", ")
        AddKey(item28, "Option+8")
        item28:AddText(" on Mac) adds a new square of flat
ground where the brush is, so the world can grow beyond its edges.")
        list10:Add(item28)
        ListItem item29
        AddBold(item29, "Remove region")
        item29:AddText(" (")
        AddKey(item29, "Alt+9")
        item29:AddText(", ")
        AddKey(item29, "Option+9")
        item29:AddText(" on Mac) removes the region under
the brush.")
        list10:Add(item29)
        section:Add(list10)
        Paragraph paragraph9
        paragraph9:AddText("The two region tools work like the others: move the brush and hold ")
        AddKey(paragraph9, "Space")
        paragraph9:AddText(",
or click. ")
        AddLink(paragraph9, "Generating Terrain", "/tutorials/Scenes/terrainGenerate.html")
        paragraph9:AddText("
explains regions in more detail.")
        section:Add(paragraph9)
    end

    action AddKeys(Section section)
        AddHeading(section, "The keys", 3)
        WebTable table2 = LoadWebTable("Terrain Brush Keys", "/html/media/scenes/Terrain/Shaping/Keys.csv")
        section:Add(table2)
        section:AddParagraph("Every one of these keys can be changed in Quorum Studio's key map, like the
other scene editor keys.")
    end

    action AddEngage returns Section
        Section section
        section:AddClassAttribute("flex flex-col gap-y-2")
        AddHeading(section, "Engage", 2)
        section:AddParagraph("In this activity, one partner shapes a terrain and the other explores it
without looking at the screen. The goal is to practice shaping terrain with
the tools, and to experience how Quorum Studio describes the ground in
words. Each of you adds a terrain to your own scene. While Partner B looks
away, Partner A shapes three features somewhere on the terrain: a hill with
a flattened top, made with Raise and then Flatten; a valley, made with
Lower and then Smooth; and a ramp leading up the side of the hill. Save the
scene. Then Partner B finds the three features without looking: with a
screen reader on, or with the screen covered while Partner A reads out what
Quorum Studio reports. Choose a tool so the brush appears, then move it
with the arrow keys, listening to the height after each step and the full
description when you let go. Partner B then says roughly where each feature
is, how high or deep it is, and how steep, and Partner A checks. Swap roles.")
        section:AddParagraph("Then give each other feedback on the reports. Which messages helped most?
What was missing, or said too often? If you could change one thing about how
Quorum Studio describes the ground, what would it be, and why? Write your
suggestion down as you would for a bug report or feature request.")
        return section
    end

    action AddWrapup returns Section
        Section section
        section:AddClassAttribute("flex flex-col gap-y-2")
        AddHeading(section, "Wrap up", 2)
        Paragraph paragraph1
        paragraph1:AddText("A brush changes the heights you met in
")
        AddLink(paragraph1, "Terrain in a Scene", "/tutorials/Scenes/terrain.html")
        paragraph1:AddText(", one stroke at a time:
raising, lowering, smoothing, flattening and ramping. Quorum Studio
describes the ground in words as well as pictures, which is what lets someone shape and explore a world
without seeing it. Think about a game you know: how does it tell a player
about the shape of the land? In the next tutorial,
")
        AddLink(paragraph1, "Generating Terrain", "/tutorials/Scenes/terrainGenerate.html")
        paragraph1:AddText(", you will make
whole landscapes at once by following rules instead of by hand.")
        section:Add(paragraph1)
        return section
    end

    private action AddStandard(UnorderedList list, text identifier, text standard)
        ListItem item
        AddBold(item, identifier)
        item:AddText(": " + standard)
        list:Add(item)
    end

    private action AddBold(WebTag tag, text value)
        StrongText strong
        strong:AddText(value)
        tag:AddNestedTag(strong)
    end

    private action AddKey(WebTag tag, text value)
        KeyboardInput key
        key:AddText(value)
        tag:AddNestedTag(key)
    end

    private action AddLink(WebTag tag, text name, text address)
        Link link
        link:AddText(name)
        link:SetAddress(address)
        link:SetClassAttribute("underline text-quorum-blue-150")
        tag:AddNestedTag(link)
    end

    action GetMetaDescription returns text
        return "Learn to shape a terrain in Quorum Studio with brush tools, using the keyboard or the mouse."
    end

    action GetSummaryName returns text
        return "Shaping Terrain"
    end

    action GetName returns text
        return "Shaping Terrain"
    end

    action GetShortDescription returns text
        return "shaping terrain with brush tools"
    end

    action GetLocation returns text
        return "tutorials/Scenes/terrainShape.html"
    end

    action GetLinkName returns text
        return "Shaping Terrain"
    end

    action GetSectionName returns text
        return "Scene Editing"
    end
end
