use Libraries.Web.Page.QuorumPage

/*
    Keyboard Accessibility.
    Converted from the old Lesson page by plan 13's generator: the same
    words, now without Tailwind.
*/
class ChartsAccessibilityText is QuorumPage

    on create
        SetLocation("tutorials/charts/charttextnavigation.html")
        // The name lists and links use, and the series and track it belongs
        // to: its section and picture.
        SetShortTitle("Keyboard Navigation Accessibility")
        SetSectionName("Charts")
        // For search engines and link previews, and what lists of pages say.
        SetDescription("Learn about using screen readers with charts in the Quorum programming language.")
        SetSummary("how to use keyboard navigation and screen reader with charts")
    end

    action Setup
        SetWebPageTitle("Keyboard Controls in Charts - Quorum Programming Language")
        Title("Keyboard Accessibility")
        Paragraph("This tutorial introduces how to control charts with the keyboard")
        NavigatingChartsOnTheKeyboard()
        GeneralChartKeys()
        BoxAndViolinPlotKeys()
        HistogramAndPieChartKeys()
        BarChartLineChartAndScatterPlotKeys()
        AccessibleDataByChartType()
        TryItYourself()
    end

    private action NavigatingChartsOnTheKeyboard
        Section("Navigating Charts on the Keyboard")
        Paragraph("Users can navigate through the chart using the computer arrow keys. If a screen reader is enabled, this will describe the contents of the chart, such as the x-axis, y-axis, and data points.")
    end

    private action GeneralChartKeys
        Section("General Chart Keys")
        Table("General Chart Hotkeys")
        TableHeader():Cell("Name"):Cell("Keys"):Cell("Description")
        TableRow():Cell("Move Between Areas"):Cell("Page Up"):Cell("Page up: moves from legend to y-axis to x-axis. If missing a feature, just skips it and moves onto the next. Does not loop, so returns to overview after x-axis.")
        TableRow():Cell("Move Between Areas"):Cell("Page Down"):Cell("Page down: moves from x-axis to y-axis to legend. If missing a feature, just skips it and moves onto the next. Does not loop, so won't move past legend.")
        TableRow():Cell("Chart Data Access"):Cell("Tab"):Cell("Move from anywhere in the graph to the main chart area, allowing access to specific data.")
        TableRow():Cell("Return to Overview"):Cell("Shift + Tab"):Cell("Return to overview from anywhere in the chart.")
        TableRow():Cell("Zoom in"):Cell("Enter"):Cell("Move to the first data point or subgroup in the chart, or first data point in subgroup.")
        TableRow():Cell("Zoom Out"):Cell("Shift + Enter"):Cell("Without subgroups or from subgroup overview: move to general chart data area. Within subgroups: move to subgroup overview.")
        TableRow():Cell("Multi-Chart Movement"):Cell("Up Arrow Key"):Cell("Down the list of charts.")
        TableRow():Cell("Multi-Chart Movement"):Cell("Down Arrow Key"):Cell("Up the list of charts.")
        TableRow():Cell("Multi-Chart Movement"):Cell("Left Arrow Key"):Cell("Up the list of charts.")
        TableRow():Cell("Multi-Chart Movement"):Cell("Right Arrow Key"):Cell("Down the list of charts.")
    end

    private action BoxAndViolinPlotKeys
        Section("Box and Violin Plot Keys")
        Table("Box and Violin Plots Keys")
        TableHeader():Cell("Name"):Cell("Keys"):Cell("Description")
        TableRow():Cell("Move Through Specifics"):Cell("Up Arrow Key"):Cell("Minimum to maximum movement. Full list of data: Minimum, interquartile range, first quartile, median, third quartile, maximum, outliers.")
        TableRow():Cell("Move Through Specifics"):Cell("Down Arrow Key"):Cell("Maximum to minimum movement. Full list of data: Minimum, interquartile range, first quartile, median, third quartile, maximum, outliers.")
        TableRow():Cell("Move Through Specifics"):Cell("Left Arrow Key"):Cell("Maximum to minimum movement. Full list of data: Minimum, interquartile range, first quartile, median, third quartile, maximum, outliers.")
        TableRow():Cell("Move Through Specifics"):Cell("Right Arrow Key"):Cell("Minimum to maximum movement. Full list of data: Minimum, interquartile range, first quartile, median, third quartile, maximum, outliers.")
    end

    private action HistogramAndPieChartKeys
        Section("Histogram and Pie Chart Keys")
        Table("Hisrogram and Pie Chart Keys")
        TableHeader():Cell("Name"):Cell("Keys"):Cell("Description")
        TableRow():Cell("X-Axis Movement"):Cell("Up Arrow Key"):Cell("Move towards origin.")
        TableRow():Cell("X-Axis Movement"):Cell("Down Arrow Key"):Cell("Move away from origin.")
        TableRow():Cell("X-Axis Movement"):Cell("Left Arrow Key"):Cell("Move away from origin.")
        TableRow():Cell("X-Axis Movement"):Cell("Right Arrow Key"):Cell("Move towards origin.")
        TableRow():Cell("Value Movement"):Cell("Page Up"):Cell("Towards largest value point movement.")
        TableRow():Cell("Value Movement"):Cell("Page Down"):Cell("Towards smallest valued point movement.")
    end

    private action BarChartLineChartAndScatterPlotKeys
        Section("Bar Chart, Line Chart, and Scatter Plot Keys")
        Table("Bar Chart, Line Chart, and Scatter Plot Keys")
        TableHeader():Cell("Name"):Cell("Keys"):Cell("Description")
        TableRow():Cell("X-Axis Movement"):Cell("Up Arrow Key"):Cell("Move towards origin.")
        TableRow():Cell("X-Axis Movement"):Cell("Down Arrow Key"):Cell("Move away from origin.")
        TableRow():Cell("X-Axis Movement"):Cell("Left Arrow Key"):Cell("Move away from origin.")
        TableRow():Cell("X-Axis Movement"):Cell("Right Arrow Key"):Cell("Move towards origin.")
        TableRow():Cell("Value Movement"):Cell("Page Up"):Cell("Towards smallest valued point movement.")
        TableRow():Cell("Value Movement"):Cell("Page Down"):Cell("Towards smallest valued point movement.")
        TableRow():Cell("Subgroup to Data Points"):Cell("Enter"):Cell("Move to specific data within a subgroup from the subgroup list.")
    end

    private action AccessibleDataByChartType
        Section("Accessible Data by Chart Type")
        Table("Accessible Data by Chart Type")
        TableHeader():Cell("Chart Type"):Cell("Value Data Provided")
        TableRow():Cell("Bar Chart"):Cell("Bar values, subgroup overview.")
        TableRow():Cell("Histogram"):Cell("Bin values.")
        TableRow():Cell("Pie Chart"):Cell("Slice values.")
        TableRow():Cell("Scatter Plot"):Cell("Data point values, subgroup overview.")
        TableRow():Cell("Line Chart"):Cell("Data point values, line overview.")
        TableRow():Cell("Box Plot"):Cell("Minimum, interquartile range, first quartile, median, third quartile, maximum, outliers.")
        TableRow():Cell("Violin Plot"):Cell("Minimum, interquartile range, first quartile, median, third quartile, maximum.")
    end

    private action TryItYourself
        Section("Try it Yourself!")
        Paragraph("Press the blue run button to execute the code in the code editor. Press the red stop button to end the program. Your program will work when the console outputs "):DoubleQuote():Text("Build Successful!"):DoubleQuote()
        CodeEditorFromProject("Keyboard Navigation", "NaviCharts.quorum", "examples/Charts/chartNavigation.quorum")
        Paragraph("This runnable example demonstrates how to use the accessibility features with charts. Note that we must have screen reader enabled to go through all the individial parts of the chart.")
        Paragraph("For this example, the data may not make sense to the chart type. However, we will be discussing what makes a good chart in the next section.")
    end
end
