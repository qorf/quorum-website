use Libraries.Web.Page.QuorumPage

/*
    CSVs and Charts.
    Converted from the old Lesson page by plan 13's generator: the same
    words, now without Tailwind.
*/
class ChartsDownloading is QuorumPage

    on create
        SetLocation("tutorials/charts/downloading.html")
        // The name lists and links use, and the series and track it belongs
        // to: its section and picture.
        SetShortTitle("Downloading Comma Separated Value (CSV) Files")
        SetSectionName("Charts")
        // For search engines and link previews, and what lists of pages say.
        SetDescription("Learn about downloading CSVs in the Quorum programming language.")
        SetSummary("how to download CSVs to use the data in the tutorials")
    end

    action Setup
        SetWebPageTitle("Downloading CSVs - Quorum Programming Language")
        Title("CSVs and Charts")
        Paragraph("This tutorial introduces how download a CSV to use in a Chart")
        DownloadingCSVsForOurCharts()
    end

    private action DownloadingCSVsForOurCharts
        Section("Downloading CSVs for Our Charts")
        Paragraph("This tutorial will teach you how to download the Comma Separated Values files that we use in our examples. For this tutorial we will be downloading one file - "):Link("Christmas Spending", "https://github.com/qorf/curriculum/blob/main/Reference/DataScience/Charts%20(New)/Data/Miscellaneous/Christmas%20spending.csv"):Text(".")
        Paragraph("First, let's open the link by clicking on Christmas Spending above. This will take us to the GitHub page. You will have a Christmas spending.csv shown to you with 3 different columns and 24 rows. At the top of the CSV preview, there is the following information: the number of lines, the size of the file, two options, Raw and Blame, and the other four options. You want to click the "):DoubleQuote():Text("Raw"):DoubleQuote():Text(" option that is located to the left of the "):DoubleQuote():Text("Blame"):DoubleQuote():Text(" option.")
        Image("media/tutorials/charts/github_page.png", "This is an image of the position of the")
        Paragraph("After you click that, the button will take you to a page with a lot of text. This is the raw data of the comma separated value file. You need to right-click anywhere on the page and select a "):DoubleQuote():Text("Save as..."):DoubleQuote():Text(" option to save it. This will open a download menu; select the folder you would like to download the file to and make sure that Save as type is "):DoubleQuote():Text("Comma Separated Value File (*.csv)."):DoubleQuote():Text(" Click "):DoubleQuote():Text("Save,"):DoubleQuote():Text(" and this will download the comma separated value file to the folder you selected.")
        Image("media/tutorials/charts/save_as.png", "This is an image of the ")
    end
end
