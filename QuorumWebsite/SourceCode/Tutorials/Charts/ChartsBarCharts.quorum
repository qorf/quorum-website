use Libraries.Web.Page.QuorumPage

/*
    Bar Charts.
    Converted from the old Lesson page by plan 13's generator: the same
    words, now without Tailwind.
*/
class ChartsBarCharts is QuorumPage
    // A double quote, for code and words that hold one.
    text dq = ""

    on create
        SetLocation("tutorials/charts/barchart.html")
        // The name lists and links use, and the series and track it belongs
        // to: its section and picture.
        SetShortTitle("Bar Chart")
        SetSectionName("Charts")
        // For search engines and link previews, and what lists of pages say.
        SetDescription("Learn about Bar Charts in the Quorum programming language.")
        SetSummary("how to make a simple bar chart in Quorum")
    end

    action Setup
        dq = dq:GetDoubleQuote()
        SetWebPageTitle("Bar Charts - Quorum Programming Language")
        // Its editors and charts use the charts script.
        UseCharts()
        Title("Bar Charts")
        Paragraph("This tutorial introduces how to make Bar Charts in Quorum")
        MakingABarChart()
        LoadingAndFormatting()
        LabelingTheBarChart()
        CustomizingTheBarChart()
        DisplayingTheChart()
        TryItYourself()
        FinalChart()
        FurtherUsefulBarChartFunctions()
    end

    private action MakingABarChart
        Section("Making a Bar Chart")
        Paragraph("The first chart type we will be using a new type of dataset to make a Bar Chart. Bar charts are useful for data scientists to compare the quantities of different types of groups. This dataset being used showcases the costs of night out activities around different parts of the country. We will be using it to compare how much total these activities cost per country.")
        Paragraph("First step to this process is that we will need to load in the dataset and format it. It is best to keep track of where we are storing our data files. For this tutorial, we will have our dataset inside of a Data folder contained in another internal folder called "):DoubleQuote():Text("Miscellaneous."):DoubleQuote()
        Paragraph("To follow along, we can download the WorldNightOut.csv dataset "):Link("here", "https://github.com/qorf/quorum-website/blob/main/QuorumWebsite/html/data/WorldNightOut.csv"):Text(".")
        Paragraph("Here is a snippet of what the dataset should look like:")
        Table("World Night Out CSV")
        TableHeader():Cell("Category"):Cell("City"):Cell("Country"):Cell("Item"):Cell("Cost")
        TableRow():Cell("Date night"):Cell("Barcelona"):Cell("Spain"):Cell("Dinner"):Cell("69.38")
        TableRow():Cell("Date night"):Cell("Barcelona"):Cell("Spain"):Cell("Dinner and Dessert"):Cell("21.28")
        TableRow():Cell("Date night"):Cell("Barcelona"):Cell("Spain"):Cell("Cinema entry"):Cell("11.87")
        TableRow():Cell("Date night"):Cell("Barcelona"):Cell("Spain"):Cell("Taxi"):Cell("10.92")
        TableRow():Cell("Date night"):Cell("Barcelona"):Cell("Spain"):Cell("Big Mac"):Cell("4.75")
    end

    private action LoadingAndFormatting
        Section("Loading and Formatting")
        Paragraph("As mentioned previously, to load and read in the dataset, we will need a DataFrame. Using the frame, we use the Load function and type in the file path of the Night Outs CSV. A comma separated file (CSV) file is a plain text file that separates data with commas.")
        CodeExample("use Libraries.Compute.Statistics.DataFrame
use Libraries.Interface.Controls.Charts.BarChart

// Create a dataframe to hold the data.
DataFrame frame

// Load your data file into the frame.
frame:Load(" + dq + "data/WorldNightOut.csv" + dq + ")")
        Paragraph("In a chart, we typically want to categorize / separate our data in a way where we can see a relationship or draw comparisons from. An example of this is trying to find the profit out of grocery store items; instead of having each item be its own category (ex. milk products such as ice cream, cheese, etc), we can group food items to see the overall profit (ex. dairy). We approach our categories of data using this approach through factoring. Later we will be examining an action that allows us to categorize our data, sorting each entry into its respective factor.")
        Paragraph("For this next part, we will want to select two columns of the dataset that we are comparing: Country and Cost. For Country, we will categorize this data because there are multiple activities listed for one country. This helps format the totals in which we will use Cost to add how much these activities cost per country. To select the Country column in our dataset, we would want to use the function, AddSelectedFactors(text textHeader). This will put countries listed on the x-axis. Adding an additional factor will separate our bar chart even further into smaller bars that can categorize items based on a broader factor, such as countries. We will also be extracting "):DoubleQuote():Text("Items"):DoubleQuote():Text(" from the dataset and this will separate each activity from the country and display on the legend.")
        Paragraph("Similarly, to get the Cost column from the dataset, we use the action AddSelectedColumns("):DoubleQuote():Text("Cost"):DoubleQuote():Text("). This will add up the totals of these columns based on the categorized country and display them on the y axis. We will also briefly describe these two functions below in a table.")
        Table("DataFrame Data Extraction Actions")
        TableHeader():Cell("Function"):Cell("Description"):Cell("Usage")
        TableRow():Cell("dataFrameObject:AddSelectedColumns(text heading)"):Cell("AddSelectedFactors() takes in a string that matches a column heading from our dataset. This function is used to format our legend and separate our data into categories For this tutorial, we will be calling this function twice and extract " + dq + "Country" + dq + " and " + dq + "Item" + dq):Cell("frame:AddSelectedFactors(" + dq + "heading" + dq + ")")
        TableRow():Cell("dataFrameObject:AddSelectedColumns(text heading)"):Cell("AddSelectedColumns() takes in a string that matches a column heading from our dataset. This function is used to format our axises. For this tutorial, we will extract " + dq + "Cost" + dq):Cell("frame:AddSelectedColumns(" + dq + "heading" + dq + ")")
        CodeExample("// Select data from the frame that you wish to use in your bar chart.
// Note: In Bar Charts, factors are used as the independent data, and Columns are used as the dependent data.
// For this example we will be categorizing by " + dq + "Country" + dq + " and " + dq + "Item" + dq + " and calculating the bar value by " + dq + "Cost" + dq + ".
frame:AddSelectedFactors(" + dq + "Country" + dq + ")
frame:AddSelectedFactors(" + dq + "Item" + dq + ")
frame:AddSelectedColumns(" + dq + "Cost" + dq + ")")
        Paragraph("Now we create a bar chart object:")
        CodeExample("// Using the frame, create a BarChart object.
BarChart chart = frame:BarChart()

// Display your bar chart.
chart:Display()")
        CodeEditorFromProject("Reading in and Displaying", "BarChart.quorum", "examples/Charts/BC1.quorum")
        Paragraph("Calling the Display() function will give us a pop-up of our formatted data so far. We still need to give meaning to our data, therefore, the following steps will show us how to label and customize our chart.")
    end

    private action LabelingTheBarChart
        Section("Labeling the Bar Chart")
        Paragraph("We have successfully created our BarChart object! Now it is time to add features and tidy it up so we are able to present our data to viewers and have them understand what they are looking at. We will now be setting the title, the x axis title, and the y axis title. We will also be setting the font size so our data chart can be read easily.")
        Paragraph("To label the titles, we must call the following functions now using our "):DoubleQuote():Text("chart"):DoubleQuote():Text(" component: SetTitle(text title), SetXAxisTitle(text title), and SetYAxisTitle(text title). SetTitle(text title) takes in a string as the parameter so we can come up with a title that briefly describes our comparisons; in this case our title can be "):DoubleQuote():Text("How Expensive are Night Outs Per Country."):DoubleQuote():Text(" The next part is about labeling the x axis and y axis.")
        Paragraph("For the x axis, we again will call our SetXAxisTitle(text title) function from our chart component which takes in a string; we should label this "):DoubleQuote():Text("Countries"):DoubleQuote():Text(" and put it inside the parameter. The same process follows for SetYAxisTitle(text title) in which it should be labeled as "):DoubleQuote():Text("Cost (in USD $)"):DoubleQuote():Text(" because our data calculates the cost in US dollars.")
        Paragraph("We should also add a subtitle in our chart so we give clarity for our viewers of what the chart is about. This can be any small description or any useful / additional information. In this case, we would call SetSubtitle(text title) and insert a string inside the parameters. We will make our string "):DoubleQuote():Text("Various nightly activities cost in different countries."):DoubleQuote()
        Paragraph("We should have the following code:")
        CodeExample("// Give the chart a descriptive title.
chart:SetTitle(" + dq + "How Expensive are Night Outs Per Country?" + dq + ")

// Add a subtitle for further description.
chart:SetSubtitle(" + dq + "Various nightly activities cost in different countries" + dq + ")

// Give the x axis a descriptive title.
chart:SetXAxisTitle(" + dq + "Countries" + dq + ")

// Give the y axis a descriptive title.
chart:SetYAxisTitle(" + dq + "Cost (in USD $)" + dq + ")")
        CodeEditorFromProject("Labeling Bar Charts", "BarChart.quorum", "examples/Charts/BC2.quorum")
    end

    private action CustomizingTheBarChart
        Section("Customizing the Bar Chart")
        Paragraph("With our bar chart, we are also able to change the color palette, the legend title, and the legend location. Before we display our chart, let us take a look at how to further customize this bar chart. For this tutorial, we will be selecting the Colorgorical palette.")
        CodeExample("// If needed, you can change the color palette to a predefined palette or create a custom one.
// By default, the palette is set to Colorgorical which helps give our graphs aesthetic and discriminable elements.
chart:SetColorPaletteToColorgorical()")
        Paragraph("Lastly, we will play around with the legend. Labeling our legend is important so that it provides clarity for the data, especially giving meaning to our categories created in the bar chart. To label the legend, we must call the SetLegendTitle(text title) function which takes in a string value, which we will label as "):DoubleQuote():Text("Countries."):DoubleQuote():Text(" Next we can change the position of the legend; by default, it is displayed on the right side, but it can be positioned at top, bottom, and left as well. Let us call the function, SetLegendLocationToBottom() which will set the location to the bottom of the chart.")
        Paragraph("We should have the following code:")
        CodeExample("// If needed, you can change the legend location to either left, right, top or bottom. 
// By default, the legend is displayed on the right when showing.
chart:SetLegendLocationToBottom()

// Give the legend a descriptive title.
chart:SetLegendTitle(" + dq + "Activity" + dq + ")")
        CodeEditorFromProject("Labeling Bar Charts", "BarChart.quorum", "examples/Charts/BC2.quorum")
    end

    private action DisplayingTheChart
        Section("Displaying The Chart")
        Paragraph("Congratulations, our bar chart is constructed! Now we can display our chart with the Display() function. There are two ways to do this, letting it automatically display and specifying a specific window size. By doing chart:Display() it will display in a size equal to the screen size. By doing chart:Display(num, num), it will display the chart in a respected constraint window size. We will be using the default display to show the bar chart.")
        CodeExample("chart:Display()")
        Paragraph("Now, feel free to clean, build, and run the program and we shortly should see a Game window pop-up. This is our Bar Chart! To view the entire code, click "):Link("here", "https://github.com/qorf/curriculum/blob/main/Reference/DataScience/Charts%20(New)/DataScienceCurric/SourceCode/BarChartExample.quorum"):Text(" to view the file.")
    end

    private action TryItYourself
        Section("Try it Yourself!")
        Paragraph("Press the blue run button to execute the code in the code editor. Press the red stop button to end the program. Your program will work when the console outputs "):DoubleQuote():Text("Build Successful!"):DoubleQuote()
        CodeExample("chart:Display()")
        CodeEditorFromProject("Full Bar Chart Example", "BarChart.quorum", "examples/Charts/BarChart.quorum")
    end

    private action FinalChart
        Section("Final Chart")
        Chart("media/tutorials/charts/barcharttutorial.svg")
    end

    private action FurtherUsefulBarChartFunctions
        Section("Further Useful Bar Chart Functions")
        Table("DataFrame Data Extraction Actions")
        TableHeader():Cell("Function"):Cell("Description"):Cell("Usage")
        TableRow():Cell("StackBars(boolean)"):Cell("StackBars() will stack bars on top of each other when a group contains multiple bars. They are not stacked by default."):Cell("chart:StackBars(true)")
        TableRow():Cell("SortByBarSize()"):Cell("SortByBarSize() takes in no parameters and will sort the bars from largest bar to smallest bar. Note that it only will work with one factor added."):Cell("chart:SortByBarSize()")
        TableRow():Cell("SeparateByFactor(integer)"):Cell("SeparateByFactor() will separate the chart into a grid of subcharts based on the bar groups. It takes in an integer as the number of columns in the grid. If empty, it results in a single-column grid."):Cell("chart:SeparateByFactor(4)")
        TableRow():Cell("SeparateBySeries(integer)"):Cell("SeparateBySeries() will separate the chart into a grid of subcharts based on the legend (series). It takes in an integer as the number of columns in the grid. If empty, it results in a single-column grid."):Cell("chart:SeparateBySeries(4)")
        Paragraph("To view more examples with charts, we can reference the Quorum Curriculum Repository for "):Link("charts", "https://github.com/qorf/curriculum/tree/main/Reference/DataScience/Charts%20(New)/DataScienceCurric/SourceCode"):Text(".")
    end
end
