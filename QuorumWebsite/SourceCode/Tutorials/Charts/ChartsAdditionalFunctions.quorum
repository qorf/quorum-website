use Libraries.Web.Page.QuorumPage

/*
    Additional Functions in Charts.
    Converted from the old Lesson page by plan 13's generator: the same
    words, now without Tailwind.
*/
class ChartsAdditionalFunctions is QuorumPage

    on create
        SetLocation("tutorials/charts/additionalchartfunctions.html")
        // The name lists and links use, and the series and track it belongs
        // to: its section and picture.
        SetShortTitle("Additional Useful Functions")
        SetSectionName("Charts")
        // For search engines and link previews, and what lists of pages say.
        SetDescription("Learn about more useful charts functions in the Quorum programming language.")
        SetSummary("how to customize data charts even further")
    end

    action Setup
        SetWebPageTitle("Additional Useful Charts Functions - Quorum Programming Language")
        Title("Additional Functions in Charts")
        Paragraph("This tutorial introduces additional useful chart functions in Quorum")
        AdditionalUsefulFunctions()
    end

    private action AdditionalUsefulFunctions
        Section("Additional Useful Functions")
        Paragraph("As a data scientist, we always want to present our data to help viewers understand and draw conclusions from the data. These functions listed below are additional resources to help us customize our data visualizations even further. All the functions described will work with any chart type.")
        Table("Additional Useful Functions")
        TableHeader():Cell("Function"):Cell("Description"):Cell("Usage")
        TableRow():Cell("SetYAxisMinimum(number num)"):Cell("This function sets the minimum value of the chart on the y axis"):Cell("chart:SetYAxisMinimum(5)")
        TableRow():Cell("SetYAxisMaximum(number num)"):Cell("This function sets the maximum value of the chart on the y axis"):Cell("chart:SetYAxisMaximum(200)")
        TableRow():Cell("SetXAxisMinimum(number num)"):Cell("This function sets the minimum value of the chart on the x axis"):Cell("chart:SetXAxisMinimum(0)")
        TableRow():Cell("SetXAxisMaximum(number num)"):Cell("This function sets the maximum value of the chart on the x axis"):Cell("chart:SetXAxisMaximum(600)")
        TableRow():Cell("FlipOrientation()"):Cell("This function takes in no parameters, and this function will swap the places of the x and y axis"):Cell("chart:FlipOrientation()")
        TableRow():Cell("SetFontSize(integer size)"):Cell("This function will adjust the font size on all areas of the chart based on points (pt) given"):Cell("chart:SetFontSize(20)")
        TableRow():Cell("SetLegendLabelFontSize(integer size)"):Cell("This function will adjust the font size of the labels on the legend of the chart based on points (pt) given"):Cell("chart:SetLegendLabelFontSize(10)")
    end
end
