use Libraries.Web.Page.QuorumPage

/*
    Chart Separation.
    Converted from the old Lesson page by plan 13's generator: the same
    words, now without Tailwind.
*/
class ChartSeparation is QuorumPage

    on create
        SetLocation("tutorials/charts/chartSeparation.html")
        // The name lists and links use, and the series and track it belongs
        // to: its section and picture.
        SetShortTitle("Chart Separation")
        SetSectionName("Charts")
        // For search engines and link previews, and what lists of pages say.
        SetDescription("Chart Separation")
        SetSummary("How to split data into multiple charts for the same plot display.")
    end

    action Setup
        SetWebPageTitle("Chart Separation")
        // Its editors and charts use the charts script.
        UseCharts()
        Title("Chart Separation")
        Paragraph("This tutorial tells use the DataFrame to save data back to disk")
        SeparateByFactor()
        SeparateBySeries()
    end

    private action SeparateByFactor
        Section("Separate by Factor")
        Paragraph("SeparateByFactor() will separate the chart into a grid of subcharts based on the bar groups. It takes in an integer as the number of columns in the grid. If empty, it results in a single-column grid.")
        Paragraph("Unfortunately, there are some limitations to the usage of this function. The Separate by Factor function can be used with a certain amount of columns and/or factors. And that number is unique to each chart. The following chart displays some of the possible combinations of factors and/or columns. It has the column input with numerical and nonnumerical data and the factor input columns.")
        Table("Can you use SeparateByFactor with these inputs?")
        TableHeader():Cell("Amount of Column Input"):Cell("Amount of Factor Input"):Cell("Bar Chart"):Cell("Pie Chart"):Cell("Histogram"):Cell("Line Chart"):Cell("Scatter Plot"):Cell("Box Plot"):Cell("Violin Plot")
        TableRow():Cell("0"):Cell("1"):Cell("Yes"):Cell("Yes"):Cell("No"):Cell("No"):Cell("No"):Cell("No"):Cell("No")
        TableRow():Cell("0"):Cell("2"):Cell("No"):Cell("No"):Cell("No"):Cell("No"):Cell("No"):Cell("No"):Cell("No")
        TableRow():Cell("1 (non-numerical)"):Cell("0"):Cell("Yes"):Cell("Yes"):Cell("No"):Cell("No"):Cell("No"):Cell("No"):Cell("No")
        TableRow():Cell("1 (numerical)"):Cell("0"):Cell("No"):Cell("Yes"):Cell("No"):Cell("No"):Cell("No"):Cell("No"):Cell("No")
        TableRow():Cell("1 (non-numerical)"):Cell("1"):Cell("No"):Cell("No"):Cell("No"):Cell("No"):Cell("No"):Cell("No"):Cell("No")
        TableRow():Cell("1 (numerical)"):Cell("1"):Cell("Yes"):Cell("Yes"):Cell("No"):Cell("No"):Cell("No"):Cell("Yes"):Cell("Yes")
        TableRow():Cell("1 (non-numerical)"):Cell("2"):Cell("No"):Cell("No"):Cell("No"):Cell("No"):Cell("No"):Cell("No"):Cell("No")
        TableRow():Cell("1 (numerical)"):Cell("2"):Cell("Yes"):Cell("Yes"):Cell("No"):Cell("No"):Cell("No"):Cell("Yes"):Cell("Yes")
        TableRow():Cell("2 (non-numerical)"):Cell("0"):Cell("No"):Cell("No"):Cell("No"):Cell("No"):Cell("No"):Cell("No"):Cell("No")
        TableRow():Cell("2 (numerical)"):Cell("0"):Cell("No"):Cell("Yes"):Cell("No"):Cell("No"):Cell("No"):Cell("No"):Cell("No")
        TableRow():Cell("2 (non-numerical)"):Cell("1"):Cell("No"):Cell("No"):Cell("No"):Cell("No"):Cell("Yes"):Cell("No"):Cell("No")
        TableRow():Cell("2 (numerical)"):Cell("1"):Cell("Yes"):Cell("Yes"):Cell("No"):Cell("No"):Cell("Yes"):Cell("Yes"):Cell("Yes")
        TableRow():Cell("2 (non-numerical)"):Cell("2"):Cell("No"):Cell("No"):Cell("No"):Cell("No"):Cell("No"):Cell("No"):Cell("No")
        TableRow():Cell("2 (numerical)"):Cell("2"):Cell("No"):Cell("No"):Cell("No"):Cell("No"):Cell("No"):Cell("No"):Cell("No")
    end

    private action SeparateBySeries
        Section("Separate by Series")
        Paragraph("SeparateBySeries() will separate the chart into a grid of subcharts based on the legend (series). It takes in an integer as the number of columns in the grid. If empty, it results in a single-column grid.")
        Paragraph("Unfortunately, there are some limitations to the usage of this function. The Separate by Series function can be used with a certain amount of columns and/or factors. And that number is unique to each chart. The following chart displays some of the possible combinations of factors and/or columns. It has the column input with numerical and nonnumerical data and the factor input columns.")
        Table("Can you use SeparateBySeries with these inputs?")
        TableHeader():Cell("Amount of Column Input"):Cell("Amount of Factor Input"):Cell("Bar Chart"):Cell("Pie Chart"):Cell("Histogram"):Cell("Line Chart"):Cell("Scatter Plot"):Cell("Box Plot"):Cell("Violin Plot")
        TableRow():Cell("0"):Cell("1"):Cell("No"):Cell("Yes"):Cell("No"):Cell("No"):Cell("No"):Cell("No"):Cell("No")
        TableRow():Cell("0"):Cell("2"):Cell("No"):Cell("No"):Cell("No"):Cell("No"):Cell("No"):Cell("No"):Cell("No")
        TableRow():Cell("1 (non-numerical)"):Cell("0"):Cell("No"):Cell("Yes"):Cell("No"):Cell("No"):Cell("No"):Cell("No"):Cell("No")
        TableRow():Cell("1 (numerical)"):Cell("0"):Cell("No"):Cell("Yes"):Cell("No"):Cell("No"):Cell("No"):Cell("No"):Cell("No")
        TableRow():Cell("1 (non-numerical)"):Cell("1"):Cell("No"):Cell("No"):Cell("No"):Cell("No"):Cell("No"):Cell("No"):Cell("No")
        TableHeader()
        TableRow():Cell("1 (non-numerical)"):Cell("2"):Cell("No"):Cell("No"):Cell("No"):Cell("No"):Cell("No"):Cell("No"):Cell("No")
        TableRow():Cell("1 (numerical)"):Cell("2"):Cell("Yes"):Cell("Yes"):Cell("No"):Cell("No"):Cell("No"):Cell("Yes"):Cell("Yes")
        TableRow():Cell("2 (non-numerical)"):Cell("0"):Cell("No"):Cell("No"):Cell("No"):Cell("No"):Cell("No"):Cell("No"):Cell("No")
        TableRow():Cell("2 (numerical)"):Cell("0"):Cell("Yes"):Cell("Yes"):Cell("Yes"):Cell("Yes"):Cell("No"):Cell("No"):Cell("No")
        TableRow():Cell("2 (non-numerical)"):Cell("1"):Cell("No"):Cell("No"):Cell("No"):Cell("No"):Cell("Yes"):Cell("No"):Cell("No")
        TableRow():Cell("2 (numerical)"):Cell("1"):Cell("No"):Cell("Yes"):Cell("No"):Cell("No"):Cell("Yes"):Cell("Yes"):Cell("Yes")
        TableRow():Cell("2 (non-numerical)"):Cell("2"):Cell("No"):Cell("No"):Cell("No"):Cell("No"):Cell("No"):Cell("No"):Cell("No")
        TableRow():Cell("2 (numerical)"):Cell("2"):Cell("No"):Cell("No"):Cell("No"):Cell("No"):Cell("No"):Cell("No"):Cell("No")
    end
end
