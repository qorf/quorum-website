use Libraries.Web.Page.QuorumPage

/*
    Chart Gallery.
    Converted from the old Lesson page by plan 13's generator: the same
    words, now without Tailwind.
*/
class ChartsChartGallery is QuorumPage

    on create
        SetLocation("tutorials/charts/chartgallery.html")
        // The name lists and links use, and the series and track it belongs
        // to: its section and picture.
        SetShortTitle("Chart Gallery")
        SetSectionName("Charts")
        // For search engines and link previews, and what lists of pages say.
        SetDescription("Learn about more useful charts functions in the Quorum programming language.")
        SetSummary("multiple examples of a variety of chart types")
    end

    action Setup
        SetWebPageTitle("Chart Gallery - Quorum Programming Language")
        // Its editors and charts use the charts script.
        UseCharts()
        Title("Chart Gallery")
        Paragraph("Quorum features a variety of chart types to suit different needs for data visualization. Below are several examples of what is possible using the Chart library. It is by no means exhaustive, but rather intended to highlight common use cases and design possibilities.")
        BarCharts()
        Histograms()
        PieCharts()
        LineCharts()
        ScatterPlots()
        BoxPlots()
        ViolinPlots()
    end

    private action BarCharts
        Section("Bar Charts")
        Subsection("One Factor, One Column")
        Chart("media/tutorials/charts/gallery/barchart1.svg")
        Subsection("One Factor, Three Columns, and Horizontal Orientation")
        Chart("media/tutorials/charts/gallery/barchart2.svg")
        Subsection("One Factor, Three Columns")
        Chart("media/tutorials/charts/gallery/barchart3.svg")
        Subsection("Two Factors, One Column, Separated by Factors, and Colorgorical Colors")
        Chart("media/tutorials/charts/gallery/barchart4.svg")
    end

    private action Histograms
        Section("Histograms")
        Subsection("One Column")
        Chart("media/tutorials/charts/gallery/histogram2.svg")
        Subsection("Two Columns, Horizontal Orientation")
        Chart("media/tutorials/charts/gallery/histogram1.svg")
        Subsection("One Column")
        Chart("media/tutorials/charts/gallery/HighKurtosisHistogram.svg")
        Subsection("Two Columns Seperated by Series")
        Chart("media/tutorials/charts/gallery/histogram3.svg")
    end

    private action PieCharts
        Section("Pie Charts")
        Subsection("One Factor")
        Chart("media/tutorials/charts/gallery/piechart1.svg")
        Subsection("Donut Chart set at 20%")
        Chart("media/tutorials/charts/gallery/piechart2.svg")
        Subsection("Donut Chart set at 10%")
        Chart("media/tutorials/charts/gallery/piechart3.svg")
        Subsection("Donut Chart set at 50%, Seperated by Factors, and Cool Colors")
        Chart("media/tutorials/charts/gallery/piechart4.svg")
    end

    private action LineCharts
        Section("Line Charts")
        Subsection("Two Columns, One Factor")
        Chart("media/tutorials/charts/gallery/linechart1.svg")
        Subsection("Four Columns, One Factor, Hiding Points, and Calm Colors")
        Chart("media/tutorials/charts/gallery/linechart2.svg")
    end

    private action ScatterPlots
        Section("Scatter Plots")
        Subsection("Two Columns")
        Chart("media/tutorials/charts/gallery/scatterplot1.svg")
        Subsection("Two Columns, One Factor, Showing Regression")
        Chart("media/tutorials/charts/gallery/scatterplot3.svg")
        Subsection("Two Columns, One Factor")
        Chart("media/tutorials/charts/gallery/scatterplot4.svg")
        Subsection("Two Columns, One Factor, Larger Points, and Exciting Colors")
        Chart("media/tutorials/charts/gallery/PositiveCorrelation.svg")
    end

    private action BoxPlots
        Section("Box Plots")
        Subsection("One Factor, One Column")
        Chart("media/tutorials/charts/gallery/BoxExample1.svg")
        Subsection("Horizontal with Two Columns")
        Chart("media/tutorials/charts/gallery/BoxEpiq.svg")
        Subsection("Two Factors, One Column, Trustworthy Colors")
        Chart("media/tutorials/charts/gallery/BoxExample3.svg")
    end

    private action ViolinPlots
        Section("Violin Plots")
        Subsection("Two Columns")
        Chart("media/tutorials/charts/gallery/ViolinExample1.svg")
        Subsection("One Factor, Two Columns")
        Chart("media/tutorials/charts/gallery/ViolinExample2.svg")
        Subsection("One Factor, Four Columns")
        Chart("media/tutorials/charts/gallery/ViolinPlotEpiq.svg")
        Subsection("Three Columns, Playful Colors")
        Chart("media/tutorials/charts/gallery/HighDispersionViolin.svg")
    end
end
