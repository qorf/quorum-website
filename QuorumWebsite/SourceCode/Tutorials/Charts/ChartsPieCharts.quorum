use Libraries.Web.Page.QuorumPage

/*
    Pie Charts.
    Converted from the old Lesson page by plan 13's generator: the same
    words, now without Tailwind.
*/
class ChartsPieCharts is QuorumPage
    // A double quote, for code and words that hold one.
    text dq = ""

    on create
        SetLocation("tutorials/charts/piechart.html")
        // The name lists and links use, and the series and track it belongs
        // to: its section and picture.
        SetShortTitle("Pie Chart")
        SetSectionName("Charts")
        // For search engines and link previews, and what lists of pages say.
        SetDescription("Learn about creating a pie chart in the Quorum programming language.")
        SetSummary("how to use pie charts in Quorum Studio")
    end

    action Setup
        dq = dq:GetDoubleQuote()
        SetWebPageTitle("Pie Charts - Quorum Programming Language")
        // Its editors and charts use the charts script.
        UseCharts()
        Title("Pie Charts")
        Paragraph("This tutorial introduces how to make Pie Charts in Quorum")
        MakingAPieChart()
        LoadingAndFormatting()
        LabelingThePieChart()
        CustomizingThePieChart()
        DisplayingTheChart()
        TryItYourself()
        FinalChart()
        FurtherUsefulPieChartFunctions()
    end

    private action MakingAPieChart
        Section("Making a Pie Chart")
        Paragraph("The next chart to learn is the pie chart. Pie charts are used to see parts-to-whole relationships such as totaling the favorite types of movie genres out of a survey of 100 people. Pie charts divide up a circle into various slices in which each slice represents a percentage of the total variable being represented. The dataset that we will be using for this lesson describes wine reviews in which we can observe the various popular wine types.")
        Paragraph("First step to this process is that we will need to properly load in the dataset and format it. It is best to keep track of where we are storing our data files. For this tutorial, we will have our dataset inside of a Data folder contained in another internal folder called "):DoubleQuote():Text("Miscellaneous."):DoubleQuote()
        Paragraph("To follow along, we can download the wineReviews.csv dataset "):Link("here", "https://github.com/qorf/curriculum/blob/main/Reference/DataScience/Charts%20(New)/Data/Miscellaneous/wineReviews.csv"):Text(".")
        Paragraph("Here is a snippet of what the dataset should look like:")
        Table("Airbnb Prices in NYC CSV")
        TableHeader():Cell("Province"):Cell("Region 1"):Cell("Variety")
        TableRow():Cell("California"):Cell("Napa Valley"):Cell("Cabernet Sauvignon")
        TableRow():Cell("Northern Spain"):Cell("Toro"):Cell("Tinta de Toro")
        TableRow():Cell("California"):Cell("Knights Valley"):Cell("Sauvignon Blanc")
        TableRow():Cell("Oregon"):Cell("Willamette Valley"):Cell("Pinot Noir")
        TableRow():Cell("Provence"):Cell("Bandol"):Cell("Provence red blend")
    end

    private action LoadingAndFormatting
        Section("Loading and Formatting")
        Paragraph("As mentioned previously, to load and read in the dataset, we will need to create a DataFrame component named "):DoubleQuote():Text("frame"):DoubleQuote():Text(". Using the frame, we must use the Load function and type in the file path of the wine reviews CSV. Recall that a CSV is a comma separated text file that holds in data.")
        CodeExample("use Libraries.Compute.Statistics.DataFrame
use Libraries.Interface.Controls.Charts.PieChart

// create dataframe to read in data
DataFrame frame
frame:Load(" + dq + "../Data/Miscellaneous/wineReviews.csv" + dq + ")")
        Paragraph("Once the data has been loaded in, we will now extract this data to use in the data chart. We will be using the function, AddSelectedFactors(text header) to format our data into the pie chart. AddSelectedFactors(text header) will take in a string value that matches a column header to the dataset. For instance, we will be extracting the "):DoubleQuote():Text("variety"):DoubleQuote():Text(" column from the dataset.")
        CodeExample("// pull out selected data, for this we will be categorizing by wine type
frame:AddSelectedFactors(" + dq + "variety" + dq + ")")
        Paragraph("Now it is time to create the Pie Chart which can be done with the following code. This creates a chart object from our DataFrame component, frame. The rest of this lesson, we will be using the chart object we have created to change and format the rest of our line chart.")
        CodeExample("// pull out selected data, for this we will be categorizing by wine type
frame:AddSelectedFactors(" + dq + "variety" + dq + ")
// create chart component inherited from the line chart library
PieChart chart = frame:PieChart()
chart:Display()")
        CodeEditorFromProject("Reading in and Displaying", "PieChart.quorum", "examples/Charts/P1.quorum")
    end

    private action LabelingThePieChart
        Section("Labeling the Pie Chart")
        Paragraph("Pie charts are unique because there actually is no need to label an x axis or y axis. The different variables within the genre group we are using separates into parts that we can examine as a whole. For this part, we will focus on learning how to label our chart title and our legend title. Additionally, we will also change the orientation of our legend within the pie chart. The functions we would be using in this case are: SetTitle(text title), SetLegendTitle(text title), SetLegendLocationToBottom(), and SetSubtitle(text title). Here is a brief description of what each function takes in.")
        Table("Pie Chart Labeling Functions")
        TableHeader():Cell("Function"):Cell("Description"):Cell("Usage")
        TableRow():Cell("SetTitle(text name)"):Cell("SetTitle() takes in a string as a parameter, which would be the title of the chart. For this example, we will name the chart " + dq + "Top Wine Reviews Based on Type." + dq):Cell("chart:SetTitle(" + dq + "Title Name" + dq + ")")
        TableRow():Cell("SetLegendTitle(text name)"):Cell("SetLegendTitle() takes in a string as a parameter, which would label the legend of the chart. The legend identifies the separate countries into different lines. For this example, we will label the legend " + dq + "Variety." + dq):Cell("chart:SetLegendTitle(" + dq + "Legend Description" + dq + ")")
        TableRow():Cell("SetLegendLocationToBottom()"):Cell("SetLegendLocationToBottom() takes in no parameters, which would be the directions, but will place the legend in a specificed place. For this example, we will place the legend on the bottom. Alternatively, you could also use SetLegendLocationToTop(), SetLegendLocationToLeft() or SetLegendLocationToRight()."):Cell("chart:SetLegendLocationToBottom()")
        TableRow():Cell("SetSubtitle(text title)"):Cell("SetSubtitle takes in a string as a parameter which would set a subtitle under the title. This can be any short description or any other necessary information for our chart. For this example, we will label the subtitle " + dq + "Praised wine categorized by type" + dq):Cell("chart:SetSubtitle(" + dq + "Praised wine categorized by type" + dq + ")")
        CodeExample("// create title to describe graph
chart:SetTitle(" + dq + "Top Wine Reviews Based on Type" + dq + ")

// label your legend to show users what is being categorized
chart:SetLegendTitle(" + dq + "Variety" + dq + ")
chart:SetSubtitle(" + dq + "Praised wine categorized by type" + dq + ")
// set the legend location, choices are left, right, top and bottom
chart:SetLegendLocationToBottom()")
        CodeEditorFromProject("Reading in and Displaying", "PieChart.quorum", "examples/Charts/P2.quorum")
    end

    private action CustomizingThePieChart
        Section("Customizing the Pie Chart")
        Paragraph("Now that we have our data labeled, we can customize our data to our liking, such as adjusting the font size, changing the color palette, and creating a hole in the middle of our pie chart. We will be playing around with all these features and to do so, we will be again, using our chart object to call these functions. The functions we will be using for this would be: SetDonutHolePercent(), SetFontSize(), and SetColorPaletteToPositive()")
        Table("Other Useful Pie Chart Functions")
        TableHeader():Cell("Function"):Cell("Description"):Cell("Usage")
        TableRow():Cell("SetDonutHolePercent(float percent)"):Cell("SetDonutHolePercent() takes in a decimal value which will adjust the size of the hole in relation to the size of the pie chart. Larger percentages will make the hole bigger and smaller percentages will make the hole smaller. For this tutorial, let us make our hole 10%"):Cell("chart:SetDonutHolePercent(0.6) // sets hole size to 60% of chart")
        TableRow():Cell("SetColorPaletteToPositive()"):Cell("SetColorPaletteToPositive() takes in no parameters, but will adjust the color palette based on a positive color scale including bright oranges, greens, pinks, and yellows"):Cell("chart:SetColorPaletteToPositive()")
        TableRow():Cell("SetFontSize(integer size)"):Cell("SetFontSize() takes in an integer as a parameter and will set the font size on all text based on the desired input. For this tutorial, we will insert 20 as the font size."):Cell("chart:SetFontSize(20)")
        CodeExample("// creates a hole in the middle of the pie chart (optional feature)
chart:SetDonutHolePercent(0.1)

// adjust font size by preference, here we set it to 20 pt
chart:SetFontSize(20)

/* change color palette if needed, this color palette is set to 
   Colorgorical which helps give our graphs aesthetic and discriminable color palettes
*/
//chart:SetColorPaletteToNegative()
//chart:SetColorPaletteToCalm()
//chart:SetColorPaletteToMagma()
//chart:SetColorPaletteToColorgorical()
chart:SetColorPaletteToPositive()")
        CodeEditorFromProject("Customizing Pie Chart", "PieChart.quorum", "examples/Charts/P3.quorum")
    end

    private action DisplayingTheChart
        Section("Displaying The Chart")
        Paragraph("Congratulations, our Pie Chart is constructed! Now we can display our chart with the Display() function. There are two ways to do this, letting it automatically display and specifying a specific window size. By doing chart:Display() it will display in a size equal to the screen size. By doing chart:Display(num, num), it will display the chart in a respected constraint window size. We will be using the default display to show the histogram.")
        CodeExample("chart:Display()")
        Paragraph("Now, feel free to clean, build, and run our program and we shortly should see a Game window pop-up. This is our Pie Chart! To view the entire code, click "):Link("here", "https://github.com/qorf/curriculum/blob/main/Reference/DataScience/Charts%20(New)/DataScienceCurric/SourceCode/PieChartExample3.quorum"):Text(" to view the file.")
    end

    private action TryItYourself
        Section("Try it Yourself!")
        Paragraph("Press the blue run button to execute the code in the code editor. Press the red stop button to end the program. Your program will work when the console outputs "):DoubleQuote():Text("Build Successful!"):DoubleQuote()
        CodeEditorFromProject("Full Pie Chart Example", "PieChart.quorum", "examples/Charts/PieChart.quorum")
    end

    private action FinalChart
        Section("Final Chart")
        Chart("media/tutorials/charts/piecharttutorial.svg")
    end

    private action FurtherUsefulPieChartFunctions
        Section("Further Useful Pie Chart Functions")
        Table("Other Useful Pie Chart Actions")
        TableHeader():Cell("Function"):Cell("Description"):Cell("Usage")
        TableRow():Cell("SeparateByFactor(integer)"):Cell("SeparateByFactor() will separate graphs based on number of columns we want in the grid of subcharts. It takes in an integer, but could be left empty. If empty, by default, it would leave it as a single chart"):Cell("chart:SeparateByFactor(4)")
        Paragraph("To view more examples with charts, we can reference the Quorum Curriculum Repository for "):Link("charts", "https://github.com/qorf/curriculum/tree/main/Reference/DataScience/Charts%20(New)/DataScienceCurric/SourceCode"):Text(".")
    end
end
