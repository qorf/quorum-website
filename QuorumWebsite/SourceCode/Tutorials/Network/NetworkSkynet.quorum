use Libraries.Web.Page.QuorumPage

/*
    Connecting to Skynet.
    Converted from the old Lesson page by plan 13's generator: the same
    words, now without Tailwind.
*/
class NetworkSkynet is QuorumPage
    // A double quote, for code and words that hold one.
    text dq = ""

    on create
        SetLocation("tutorials/network/skynet.html")
        // The name lists and links use, and the series and track it belongs
        // to: its section and picture.
        SetShortTitle("Connecting to Skynet")
        SetSectionName("Network")
        // For search engines and link previews, and what lists of pages say.
        SetDescription("Connecting to Skynet using HTTP with the Quorum programming language.")
        SetSummary("an introduction to connecting to Skynet's telescopes to take a picture using the Hypertext Transfer Protocol (HTTP)")
    end

    action Setup
        dq = dq:GetDoubleQuote()
        SetWebPageTitle("Connecting to Skynet")
        Title("Connecting to Skynet")
        Paragraph("Connecting to Skynet using Hypertext Transfer Protocol (HTTP)")
        SettingUpASkynetAccount()
        TakingAPicture()
        SubmittingAnObservationRequestByName()
        SubmittingAnObservationRequestByCoordinates()
        HandlingSkynetSResponseMessage()
    end

    private action SettingUpASkynetAccount
        Section("Setting Up a Skynet Account")
        Paragraph("In order to use Skynet’s telescopes to take a picture you must first set up an account which will contain your Time Account ID number and then acquire a token to use for submitting observation requests. You can click on the links for more information regarding "):Link("Skynet", "https://skynet.unc.edu"):Text(" and "):Link("Skynet Junior Scholars", "https://skynetjuniorscholars.org"):Text(".")
    end

    private action TakingAPicture
        Section("Taking a Picture")
        Paragraph("After you have setup an account through Skynet and obtained your "):DoubleQuote():Text("token"):DoubleQuote():Text(" and "):DoubleQuote():Text("Time Account ID"):DoubleQuote():Text(" you are all set to start taking pictures using Skynet’s telescopes. There are two ways you can request an observation (picture) including:")
        BulletList()
        ListItem():Strong("Astronomical Target Name"):Text(" : such as ("):DoubleQuote():Text("Pinwheel Galaxy"):DoubleQuote():Text(", "):DoubleQuote():Text("Saturn"):DoubleQuote():Text(")")
        ListItem():Strong("Astronomical Target Coordinates"):Text(" : such as (RA: 14h 3m 13s | Dec: 54°20'57"):DoubleQuote():Text(")")
        Paragraph("To start in the process of taking a picture and obtaining data from Skynet’s Response Message we will need to add the following libraries:")
        CodeExample("use Libraries.Network.NetworkResponseEvent
use Libraries.Data.Formats.JavaScriptObjectNotation
use Libraries.Science.Astronomy.Skynet
use Libraries.Science.Astronomy.SkynetListener
use Libraries.System.File
use Libraries.Containers.HashTable
use Libraries.Containers.Iterator")
        Paragraph("Next, we will create a text type variable called "):DoubleQuote():Text("token"):DoubleQuote():Text(" which will contain our token key obtained from Skynet for ease of use. Then we will create a Skynet object called "):DoubleQuote():Text("skynet"):DoubleQuote():Text(" which we will add all of our specifications to in the next step.")
        CodeExample("class DriverCode is SkynetListener
   text token = " + dq + "your token will go here" + dq + "
   Skynet skynet")
        Paragraph("In this next step we will add all of the necessary specifications in obtaining a picture to our Skynet object "):DoubleQuote():Text("skynet"):DoubleQuote():Text(" as shown below:")
        Paragraph("For further information on the meaning of these specifications look to SkynetJuniorScholars.org Explorations IDATA section which includes a module dedicated to "):Link("Using Telescopes to take Images of Asteroids", "https://skynetjuniorscholars.org/explorations/idata/activities/module1-section3/steps/introduction-section3"):Text(".")
        CodeExample("   action Main
       skynet:AddListener(me)
        //sets your previously defined " + dq + "token" + dq + " as the Skynet Account key to be used in
        //requesting the observation.
       skynet:SetAccountKey(token)
        //sets the maximum sun elevation integer (we used the default of -12 in this case) 
       skynet:SetMaxSun(-12)
        //sets the minimum object elevation integer (we used the default of 30.0
        //in this case)
       skynet:SetMinElevation(30.0)
        //sets your 5 digit time account ID integer for a specific telescope which must 
        //have an adequate time allowance to be used in requesting an observation.
        //(We used a sample account ID in this example to show that the time account 
        //ID should be entered as an integer)
       skynet:SetTimeAccount(12345)
        //sets the name of the telescope you will be using to make your observations,
        //(for more information on available telescopes and their associated Time 
        //Account ID’s look at your Account on Skynet.)
       skynet:AddTelescope(" + dq + "Prompt6" + dq + ")
        //sets the filter for your observation
       skynet:AddFilter(" + dq + "Clear" + dq + ")
        //sets the number of exposures for your observation
       skynet:SetNumberOfExposures(2)
        //sets the exposure length for your observation
       skynet:SetExposureLength(30.0)")
    end

    private action SubmittingAnObservationRequestByName
        Section("Submitting an Observation Request by Name")
        Paragraph("If you wish to submit an observation request by coordinates, then you can skip this step and move to the section labeled "):DoubleQuote():Text("Submitting an Observation Request by Coordinates"):DoubleQuote():Text(" below.")
        Paragraph("To submit a request for an observation by name you will have to provide the following information:")
        BulletList()
        ListItem():Strong("Name"):Text(" : used to identify the Astronomical target. (We will use "):DoubleQuote():Text("M104"):DoubleQuote():Text(" in this example)")
        ListItem():Strong("Type"):Text(" : used to specify the type of Astronomical target you are observing. (We will use "):DoubleQuote():Text("sidereal"):DoubleQuote():Text(" in this example)")
        Paragraph("The information will be added to the existing code in the following format:")
        CodeExample("        //sets the Astronomical Type to " + dq + "sidereal" + dq + "
       skynet:SetAstronomicalType(" + dq + "sidereal" + dq + ")
        //sets the name of the Astronomical Target to " + dq + "M104" + dq + "
       skynet:SetName(" + dq + "M104" + dq + ")
        //lets Skynet know that we are submitting the observation request by name
       skynet:SubmitObservationByName()")
    end

    private action SubmittingAnObservationRequestByCoordinates
        Section("Submitting an Observation Request by Coordinates")
        Paragraph("If you are already submitting an observation request by name then you can skip this step and move to the section labeled "):DoubleQuote():Text("Handling Skynet’s Response Message"):DoubleQuote():Text(" below.")
        Paragraph("To submit a request for an observation by coordinates you will have to provide the following information:")
        BulletList()
        ListItem():Strong("Name"):Text(" : used to identify the Astronomical target. (We will use "):DoubleQuote():Text("M104"):DoubleQuote():Text(" in this example)")
        ListItem():Strong("Right Ascension & Declination"):Text(" : specify the direction of the Astronomical target in the sky. If you are unsure of the coordinates you can find them by searching the Astronomical target on the internet.")
        Paragraph("In a search for our example Astronomical Target "):Link("The Right Ascension and Declination for our Astronomical target " + dq + "M104" + dq, "https://en.wikipedia.org/wiki/Sombrero_Galaxy"):Text(" you will find the following results (12h 39m 59.4s) and (-11° 37’ 23"):DoubleQuote():Text(") which need to be formatted as follows to "):DoubleQuote():Text("12:39:59.4"):DoubleQuote():Text(" and "):DoubleQuote():Text("-11:37:23"):DoubleQuote():Text(" so that the coordinates will be interpreted correctly by Skynet.)")
        Paragraph("The information will be added to the existing code in the following format:")
        CodeExample("       //sets the name of the Astronomical Target to " + dq + "M104" + dq + "
       skynet:SetName(" + dq + "M104" + dq + ")
       //sets the Right Ascension for the specified Astronomical Target " + dq + "M104" + dq + "
       skynet:SetRightAscension(" + dq + "12:39:59.4" + dq + ")
       //sets the Declination for the specified Astronomical Target " + dq + "M104" + dq + "
       skynet:SetDeclination(" + dq + "-11:37:23" + dq + ")
       //lets Skynet know that we are submitting the Observation Request by Coordinates
       skynet:SubmitObservationByCoordinates()")
    end

    private action HandlingSkynetSResponseMessage
        Section("Handling Skynet’s Response Message")
        Paragraph("We have all of the code necessary to complete an observation request through Skynet, however, we will want to view the components of the Response Message that they send back to us. There are several ways in which we can view and format this data. In this tutorial we will go over how to output specific Response Data such as the Web Address accessed, the Status Code and Status Text, the Content Type and the Response Headers. We will also go over how to output the Response Text in formatted JavaScript Object Notation.")
        Paragraph("We will begin by creating a NetworkResponseEvent "):DoubleQuote():Text("response"):DoubleQuote():Text(" and outputting "):DoubleQuote():Text("response’s"):DoubleQuote():Text(" web address, status code, status text, and content type with labels for readability.")
        CodeExample("   //creates a NetworkResponseEvent object " + dq + "response" + dq + " which will hold the contents of
   //the Response Message from Skynet
   action ResponseReceived(NetworkResponseEvent response)
       //outputs the Response Message’s web address, Status Code, Status Text, and
       //Content Type with their labels
       output " + dq + " URL : " + dq + " + response:GetWebAddress()
       output " + dq + " Status Code : " + dq + " + response:GetStatusCode()
       output " + dq + " Status Text : " + dq + " + response:GetStatusText()
       output " + dq + " Content Type : " + dq + " + response:GetContentType()
       //creates a HashTable object " + dq + "headers" + dq + " which holds all of the
       //NetworkResponseEvent object " + dq + "response’s" + dq + " Response Headers.")
        Paragraph("Next, we will output the Response Headers with a label, by iterating (or going through) the HashTable object "):DoubleQuote():Text("headers"):DoubleQuote():Text(" that contains the response headers as shown below.")
        CodeExample("       output " + dq + "Response Headers : " + dq + "
       HashTable<text, text> headers = response:GetHeaders()
       //iterates (goes through) the entire HashTable object " + dq + "headers" + dq + " and outputs the
       //key name and its associated value(s) separated by a colon " + dq + ":" + dq + " for readability.
       Iterator<text> keys = headers:GetKeyIterator()
       repeat while keys:HasNext()
           key = keys:Next()
           output key + " + dq + ":" + dq + " + headers:GetValue(key)
       end")
        Paragraph("Finally, we will output the specific "):DoubleQuote():Text("obsId"):DoubleQuote():Text(" and "):DoubleQuote():Text("telescope"):DoubleQuote():Text(" key names and their associated value(s) that are included in the returned Response Text using JavaScript Object Notation formatting.")
        CodeExample("       //creates a JavaScriptObjectNotation object " + dq + "json" + dq + " which is used to read in the
       //Response Text from the NetworkResponseEvent object " + dq + "response" + dq + " and output 
       //the requested key name’s associated values in JavaScript Object Notation
       //format
       JavaScriptObjectNotation json
       json:Read(response:GetResponseText())
       output " + dq + " ObservationID : " + dq + " + json:GetValue(" + dq + "obsId" + dq + ")
       output " + dq + "Telescope Info : " + dq + " + json:GetVaue(" + dq + "telescope" + dq + ")")
        Paragraph("If you would like to view ALL of the key names and values included in the Response Text in JavaScript Object Notation format then you can use the following code instead:")
        CodeExample("       //creates a JavaScriptObjectNotation object " + dq + "json" + dq + " which is used to read in the
       //Response Text from the NetworkResponseEvent object " + dq + "response" + dq + " and output 
       //in JavaScript Object Notation format
       JavaScriptObjectNotation json
       json:Read(response:GetResponseText())
       output Response Text in JavaScript Object Notation Format : " + dq + " + json:ToText()")
        Paragraph("Alternately, if you would like to condense the JavaScript Object Notation Response Text you can use the following code instead without the need to create the JavaScriptObjectNotation object "):DoubleQuote():Text("json"):DoubleQuote():Text(":")
        CodeExample("output " + dq + "Response Text : " + dq + " + response:GetResponseText()")
        Paragraph("In which case the condensed Response Text will look something like this:")
        CodeExample("Response Text : 
        {" + dq + "endBefore" + dq + ": null, " + dq + "commandedDec" + dq + ": null, " + dq + "telescope" + dq + ": {" + dq + "site" + dq + ": {" + dq + "lngDegs" + dq + ": -70.8053888736413, 
        " + dq + "id" + dq + ": 2, " + dq + "name" + dq + ": " + dq + "CTIO" + dq + ", " + dq + "latDegs" + dq + ": -30.167638879504135}, " + dq + "name" + dq + ": " + dq + "Prompt6" + dq + ", " + dq + "id" + dq + ": 31}, 
        " + dq + "startAfter" + dq + ": null, " + dq + "timeArchived" + dq + ": null, " + dq + "linkedExps" + dq + ": [], " + dq + "wcsState" + dq + ": " + dq + "not_attempted" + dq + ", 
        " + dq + "filterRequested" + dq + ": {" + dq + "id" + dq + ": 19, " + dq + "name" + dq + ": " + dq + "Clear" + dq + "}, " + dq + "statsState" + dq + ": " + dq + "not_attempted" + dq + ", 
        " + dq + "timeIn" + dq + ": " + dq + "2018-06-21T18:49:33" + dq + ", " + dq + "id" + dq + ": 21762074, " + dq + "compression" + dq + ": null, 
        " + dq + "parentCollabTimeAccountId" + dq + ": null, " + dq + "creditsCharged" + dq + ": 30, " + dq + "teleId" + dq + ": 31, 
        " + dq + "timeAccountId" + dq + ": 12345, " + dq + "expLength" + dq + ": 30.0, " + dq + "delay" + dq + ": null, " + dq + "state" + dq + ": " + dq + "ready" + dq + ", 
        " + dq + "timeSubmitted" + dq + ": " + dq + "2018-06-21T18:49:33.619087" + dq + ", " + dq + "obsId" + dq + ": 2933191, " + dq + "expNum" + dq + ": 2, 
        " + dq + "wcsSolution" + dq + ": null, " + dq + "type" + dq + ": " + dq + "light" + dq + ", " + dq + "filterIdUsed" + dq + ": null, " + dq + "expLengthUsed" + dq + ": null, 
        " + dq + "teleOwner" + dq + ": null, " + dq + "commandedRa" + dq + ": null, " + dq + "timeTaken" + dq + ": null, " + dq + "timeTakenIsFromHdr" + dq + ": false, 
        " + dq + "filterIdRequested" + dq + ": 19, " + dq + "filterUsed" + dq + ": null, " + dq + "wcsId" + dq + ": null, " + dq + "targetExpId" + dq + ": null, 
        " + dq + "teleOwnerIdUsed" + dq + ": null, " + dq + "binningRequested" + dq + ": 2, " + dq + "isCompressed" + dq + ": false, 
        " + dq + "binningUsed" + dq + ": 1, " + dq + "numFileErrors" + dq + ": 0, " + dq + "parentGroupTimeAccountId" + dq + ": null, " + dq + "obs" + dq + ": 
        {" + dq + "id" + dq + ": 2933191, " + dq + "name" + dq + ": " + dq + "M104" + dq + "}}")
        Paragraph("The complete code section for submitting an observation request by coordinates and handling the response message from Skynet is shown below:")
        CodeExample("use Libraries.Network.NetworkResponseEvent
use Libraries.Data.Formats.JavaScriptObjectNotation
use Libraries.Science.Astronomy.Skynet
use Libraries.Science.Astronomy.SkynetListener
use Libraries.System.File
use Libraries.Containers.HashTable
use Libraries.Containers.Iterator
use Libraries.Containers.Array

class DriverCode is SkynetListener
  text token = " + dq + "Your token goes here" + dq + "
  Skynet skynet

  action Main
      skynet:AddListener(me)
       //If you would like to submit an observation request by name simply omit the next two
       //lines and replace them with  " + dq + "skynet:SetAstronomicalType(" + dq + "sidereal" + dq + ")" + dq + "
      skynet:SetRightAscension(" + dq + "12:39:59.4" + dq + ")
      skynet:SetDeclination(" + dq + "-11:37:23" + dq + ")
      skynet:SetName(" + dq + "M104" + dq + ")

      skynet:SetAccountKey(token)
      skynet:SetMaxSun(-12)
      skynet:SetMinElevation(30.0)
       //you will need to use your 5 digit Time Account integer here
      skynet:SetTimeAccount(12345)
      skynet:AddTelescope(" + dq + "Prompt6" + dq + ")
      skynet:AddFilter(" + dq + "Clear" + dq + ")
      skynet:SetNumberOfExposures(2)
      skynet:SetExposureLength(30.0)
       //if you would like to submit an observation request by name simply omit the following
       //line and replace it with " + dq + "skynet:SubmitObservationByName()" + dq + "
      skynet:SubmitObservationByCoordinates()
  end

  action ResponseReceived(NetworkResponseEvent response)
      output " + dq + "URL : " + dq + " + response:GetWebAddress()
      output " + dq + "Status Code : " + dq + " + response:GetStatusCode()
      output " + dq + "Status Text : " + dq + " + response:GetStatusText()
      output " + dq + "Content Type : " + dq + " + response:GetContentType()
      output " + dq + "Response Headers : " + dq + "
      HashTable<text, text> headers = response:GetHeaders()
      Iterator<text> keys = headers:GetKeyIterator()
      repeat while keys:HasNext()
          key = keys:Next()
          output key + " + dq + " : " + dq + " + headers:GetValue(key)
      end
      JavaScriptObjectNotation json
      json:Read(response:GetResponseText())
      output " + dq + "ObservationID : " + dq + " + json:GetValue(" + dq + "obsId" + dq + ")
      output " + dq + "Telescope Info : " + dq + " + json:GetValue(" + dq + "telescope" + dq + ")
  end
end")
        CodeEditorWithCode("Activity: Submitting an Observation Request", "//This code will output the Response Status Code, Text, Headers, and specific fields of the Response Message Body"):HideDisplay()
        Paragraph("The output should look something like this:")
        CodeExample("URL  : https://api.skynet.unc.edu/2.0/exps
Status Code  : 200
Status Text  : OK
Content Type  : text/html; charset=utf-8
Response Headers : 
content-type : text/html; charset=utf-8
expires : Thu, 21 Jun 2018 18:45:09 GMT
cache-control : no-store, no-cache, must-revalidate, post-check=0, pre-check=0
pragma : no-cache
ObservationID : 2933108
Telescope Info : {
   " + dq + "site" + dq + ":     {
{
      " + dq + "lngDegs" + dq + ": -70.8053888736413,
      " + dq + "id" + dq + ": 2,
      " + dq + "name" + dq + ": " + dq + "CTIO" + dq + ",
      " + dq + "latDegs" + dq + ": -30.167638879504135
}
  },
  " + dq + "name" + dq + ": " + dq + "Prompt6" + dq + ",
  " + dq + "id" + dq + ": 31
}")
    end
end
