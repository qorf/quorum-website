use Libraries.Web.Page.QuorumPage

/*
    Setting the Request Message Body.
    Converted from the old Lesson page by plan 13's generator: the same
    words, now without Tailwind.
*/
class NetworkRequestMessage is QuorumPage
    // A double quote, for code and words that hold one.
    text dq = ""

    on create
        SetLocation("tutorials/network/requestMessage.html")
        // The name lists and links use, and the series and track it belongs
        // to: its section and picture.
        SetShortTitle("Setting the Request Message Body")
        SetSectionName("Network")
        // For search engines and link previews, and what lists of pages say.
        SetDescription("Setting the Request Message Body using HTTP with the Quorum programming language.")
        SetSummary("an introduction to setting the request message body using the Hypertext Transfer Protocol (HTTP).")
    end

    action Setup
        dq = dq:GetDoubleQuote()
        SetWebPageTitle("Setting the Request Message Body")
        Title("Setting the Request Message Body")
        Paragraph("Setting the Request Message Body for a Network Request Body using Hypertext Transfer Protocol (HTTP)")
        QueryStrings()
        SettingTheRequestMessageBodyUsingTextData()
        SettingTheRequestMessageBodyUsingJavaScriptObjec()
    end

    private action QueryStrings
        Section("Query Strings")
        Paragraph("When there is additional user data to be sent to the server it is either added to the Uniform Resource Locator (URL) when using the GET Method, or added in the Request Message Body when using the POST Method. The data being sent is contained in what is referred to as the "):Strong("Query String"):Text(", which contains data submitted in name value pairs (fields) with the name and value separated by an equal sign (=) and multiple fields separated by an ampersand (&). (Any whitespace in the value is replaced with a plus sign (+)). For example if we had the following three fields:")
        CodeExample("name: John Smith
age: 15
student: true")
        Paragraph("Then the query string would be formatted as shown below :")
        CodeExample("name=John+Smith&age=15&student=true")
    end

    private action SettingTheRequestMessageBodyUsingTextData
        Section("Setting the Request Message Body Using Text Data")
        Paragraph("In order to format multiple fields of text data (key name: value pairs) we will use the "):DoubleQuote():Text("Libraries.Network.NetworkRequest"):DoubleQuote():Text(" and "):DoubleQuote():Text("Libraries.Containers.HashTable"):DoubleQuote():Text(" libraries. We will then create multiple text type variables to store the key names and their associated value as shown below:")
        CodeExample("use Libraries.Network.NetworkRequest
use Libraries.Containers.HashTable

class Main
   action Main
       text key1 = " + dq + "name" + dq + "
       text value1 = " + dq + "John Smith" + dq + "
       text key2 = " + dq + "age" + dq + "
       text value2 = " + dq + "15" + dq + "
       text key3 = " + dq + "student" + dq + "
       text value3 = " + dq + "true" + dq)
        Paragraph("Next, we will create a HashTable object "):DoubleQuote():Text("data"):DoubleQuote():Text(" to add the name:value pairs to. Then we will create a NetworkRequest object "):DoubleQuote():Text("request"):DoubleQuote():Text(" which will contain the formatted query string with "):DoubleQuote():Text("data’s"):DoubleQuote():Text(" name:value pairs.")
        CodeExample("        //creates a HashTable object " + dq + "data" + dq + " and adds the key name:value pairs to
        //" + dq + "data" + dq + "
       HashTable<text, text> data
       data:Add(key1, value1)
       data:Add(key2, value2)
       data:Add(key3, value3)
        //creates a NetworkRequest object " + dq + "request" + dq + " and formats data’s name:value
        //pairs as a query string for the Request Message Body
       NetworkRequest request
       request:SetParameters(data)")
        Paragraph("Finally, we will output the formatted query string to the screen. The complete code section looks like this:")
        CodeExample("use Libraries.Network.NetworkRequest
use Libraries.Containers.HashTable

class Main
   action Main
       text key1 = " + dq + "name" + dq + "
       text value1 = " + dq + "John Smith" + dq + "
       text key2 = " + dq + "age" + dq + "
       text value2 = " + dq + "15" + dq + "
       text key3 = " + dq + "student" + dq + "
       text value3 = " + dq + "true" + dq + "
       HashTable<text, text> data
       data:Add(key1, value1)
       data:Add(key2, value2)
       data:Add(key3, value3)
       NetworkRequest request
       request:SetParameters(data)
       output request:GetBody()
   end
end")
        CodeEditorWithCode("Activity: Setting the Message Body with Text Data", "//This code will output the formatted query string"):HideDisplay()
        Paragraph("The output should look similar to this, with each key name and value separated by an equal "):DoubleQuote():Text("="):DoubleQuote():Text(" sign (the order may be different from the example output shown below, which will not matter as the values are accessed by their key name and not by their order):")
        CodeExample("name=John+Smith&age=15&student=true")
        Paragraph("The output should look similar to this, with each key name and value separated by an equal "):DoubleQuote():Text("="):DoubleQuote():Text(" sign (the order may be different from the example output shown below, which will not matter as the values are accessed by their key name and not by their order):")
        CodeExample("name=Jane+Adams&age=22&student=false")
    end

    private action SettingTheRequestMessageBodyUsingJavaScriptObjec
        Section("Setting the Request Message Body Using JavaScript Object Notation (JSON) Data")
        Paragraph("In order to format JavaScriptObjectNotation object data ({"):DoubleQuote():Text("name"):DoubleQuote():Text(":"):DoubleQuote():Text("value"):DoubleQuote():Text("} pairs) we will need to use the additional "):DoubleQuote():Text("Libraries.Data.Formats.JavaScriptObjectNotation"):DoubleQuote():Text(" library. We will then create a JavaScriptObjectNotation object "):DoubleQuote():Text("data"):DoubleQuote():Text(" which will contain the {"):DoubleQuote():Text("name"):DoubleQuote():Text(":"):DoubleQuote():Text("value"):DoubleQuote():Text("} pairs as shown below: (For more information on JavaScriptObjectNotation see the "):Link("Data Tutorials Section", "https://quorumlanguage.com/tutorials/data/overview.html"):Text(")")
        CodeExample("use Libraries.Network.NetworkRequest
use Libraries.Data.Formats.JavaScriptObjectNotation

class Main
   action Main
       text key1 = " + dq + "name" + dq + "
       text value1 = " + dq + "Jane Adams" + dq + "
       text key2 = " + dq + "age" + dq + "
       integer value2 = 22
       text key3 = " + dq + "student" + dq + "
       boolean value3 = false

        //creates a JavaScriptObjectNotation object " + dq + "data" + dq + "which will
        //hold the (key name:value) pairs
       JavaScriptObjectNotation data
       data:Add(key1, value1)
       data:Add(key2, value2)
       data:Add(key3, value3)")
        Paragraph("We will then create a NetworkRequest object "):DoubleQuote():Text("request"):DoubleQuote():Text(", format the JavaScriptObjectNotation object "):DoubleQuote():Text("data"):DoubleQuote():Text(" as a query string, and output the formatted query string to the screen.")
        CodeExample("        //creates a NetworkRequest object " + dq + "request" + dq + "
       NetworkRequest request
        //formats the JavaScriptObjectNotation object " + dq + "data" + dq + " as a query
        //string for the Request Message Body
       request:SetParameters(data)
        //outputs the formatted query string to the screen
       output request:GetBody()")
        Paragraph("Here is the complete code section to create a formatted query string from a JavaScriptObjectNotation object:")
        CodeExample("use Libraries.Network.NetworkRequest
use Libraries.Data.Formats.JavaScriptObjectNotation

class Main
   action Main
       text key1 = " + dq + "name" + dq + "
       text value1 = " + dq + "Jane Adams" + dq + "
       text key2 = " + dq + "age" + dq + "
       integer value2 = 22
       text key3 = " + dq + "student" + dq + "
       boolean value3 = false
       JavaScriptObjectNotation data
       data:Add(key1, value1)
       data:Add(key2, value2)
       data:Add(key3, value3)
       NetworkRequest request
       request:SetParameters(data)
       output request:GetBody()
   end
end")
        CodeEditorWithCode("Activity: Setting the Message Body with JSON Data", "//This code will output the formatted query string"):HideDisplay()
    end
end
