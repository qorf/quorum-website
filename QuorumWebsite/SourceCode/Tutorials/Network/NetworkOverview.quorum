use Libraries.Web.Page.QuorumPage

/*
    Managing a Network Connection Overview.
    Converted from the old Lesson page by plan 13's generator: the same
    words, now without Tailwind.
*/
class NetworkOverview is QuorumPage
    // A double quote, for code and words that hold one.
    text dq = ""

    on create
        SetLocation("tutorials/network/overview.html")
        // The name lists and links use, and the series and track it belongs
        // to: its section and picture.
        SetShortTitle("Overview")
        SetSectionName("Network")
        // For search engines and link previews, and what lists of pages say.
        SetDescription("Learn to manage a network connection with the Quorum programming language.")
        SetSummary("an overview into managing a network connection.")
    end

    action Setup
        dq = dq:GetDoubleQuote()
        SetWebPageTitle("Managing a Network Connection Overview")
        Title("Managing a Network Connection Overview")
        Paragraph("Managing a Network Connection Using Hypertext Transfer Protocol (HTTP)")
        Overview()
        RequestMessage()
        ResponseMessage()
    end

    private action Overview
        Section("Overview")
        Paragraph("A network connection is used to manage communication between web browsers and web servers. Hypertext Transfer Protocol (HTTP) is one of the more popular ways to manage this connection, with the web browser using a "):Strong("Request Message"):Text(" to locate and provide (GET) a resource or to POST data to the web server, and the web server returning a "):Strong("Response Message"):Text(" which includes the requested resource, a success message, or an error message in some cases. When a user enters a Uniform Resource Locator (URL) in the address bar on a web browser, the browser converts that Uniform Resource Locator (URL) into a request message to send to the web server for interpretation and a response.")
    end

    private action RequestMessage
        Section("Request Message")
        Paragraph("A typical Request Message consists of a "):Strong("Request Line"):Text(", "):Strong("Request Headers"):Text(", a "):Strong("Blank Line"):Text(" (which must be included to separate the Request Headers from the Request Message Body), and a "):Strong("Request Message Body"):Text(" (which we will go over in another tutorial). The "):Strong("Request Line"):Text(" includes: "):Strong("Request Headers"):Text(" ask the server to respond with specific properties (such as in a specific language, or media type). These requested properties are listed as name:value pairs with the name and value separated by a colon "):DoubleQuote():Text(":"):DoubleQuote():Text(" and multiple associated values separated by commas "):DoubleQuote():Text(","):DoubleQuote():Text(" as shown in the following example:")
        BulletList()
        ListItem():Strong("Request Method"):Text(" : which are predefined by the Hypertext Transfer Protocol (HTTP), case sensitive, and must be typed in all uppercase letters (we will discuss a few of these, GET and POST, in a future tutorial).")
        ListItem():Strong("Web Address"):Text(" : specifies the resource being requested from the server")
        ListItem():Strong("HTTP Version"):Text(" : either HTTP/1.0 or HTTP/1.1 which is sent as a request to the server. If the server does not support the requested version it will respond informing the user to switch to the alternate version.")
        Paragraph("The Request Line is sent in the following format:")
        CodeExample("RequestMethod  WebAddress  HTTP-Version")
        Paragraph("To set the web address for a NetworkRequest object in Quorum, we start by using the "):DoubleQuote():Text("Libraries.Network.NetworkRequest"):DoubleQuote():Text(" library. We will then create a NetworkRequest object "):DoubleQuote():Text("request"):DoubleQuote():Text(" and set the web address for "):DoubleQuote():Text("request"):DoubleQuote():Text(". Finally we will output the web address to the screen.")
        Paragraph("Here is the complete code section:")
        CodeExample("use Libraries.Network.NetworkRequest

class Main
   action Main
      NetworkRequest request
      request:SetWebAddress(" + dq + "https://quorumlanguage.com/GETtest.php" + dq + ")
      output request:GetWebAddress()
   end
end")
        CodeEditorWithCode("Activity: Setting the Web Address", "//This code will output the Web Address we have set"):HideDisplay()
        Paragraph("The output should look something like this:")
        CodeExample("https://quorumlanguage.com/GETtest.php")
        CodeExample("Content-type: application/json
Connection: keep-alive
Accept: text/plain, text/html, image/gif, application/json
Accept-Encoding: gzip, deflate
Accept-Language: en-us")
        Paragraph("In order to add Request Headers to a NetworkRequest object "):DoubleQuote():Text("request"):DoubleQuote():Text(" we will need to use the "):DoubleQuote():Text("Libraries.Network.NetworkRequest"):DoubleQuote():Text(" and "):DoubleQuote():Text("Libraries.Containers.HashTable"):DoubleQuote():Text(" libraries. Then we will create a HashTable object "):DoubleQuote():Text("headers"):DoubleQuote():Text(" to store our headers as shown below:")
        CodeExample("use Libraries.Network.NetworkRequest
use Libraries.Containers.HashTable

class Main
   action Main
    //creates a HashTable object " + dq + "headers" + dq + " with text type key names and text type
    //values
   HashTable <text, text> headers
    //Adds the name, value pairs to be used as headers
   headers:Add(" + dq + "Connection" + dq + ", " + dq + "keep-alive" + dq + ")
    //use comma’s " + dq + "," + dq + " to separate multiple values in a header
   headers:Add(" + dq + "Accept-Encoding" + dq + ", " + dq + "gzip, deflate" + dq + ")")
        Paragraph("Next, we will create a NetworkRequest object "):DoubleQuote():Text("request"):DoubleQuote():Text(" and set "):DoubleQuote():Text("request’s"):DoubleQuote():Text(" Headers to the HashTable object "):DoubleQuote():Text("headers"):DoubleQuote():Text(".")
        CodeExample("    //creates a NetworkRequest object " + dq + "request" + dq + "
   NetworkRequest request
    //sets the NetworkRequest object " + dq + "request’s" + dq + " Headers to the Headers we
    //created and set as the HashTable object " + dq + "headers" + dq + "
   request:SetHeaders(headers)")
        Paragraph("Finally we will output the associated value of "):DoubleQuote():Text("request’s"):DoubleQuote():Text(" header by its key name as shown below:")
        CodeExample("    //will output the header value that is associated with the key name " + dq + "Connection" + dq + "
   output headers:GetValue(" + dq + "Connection" + dq + ")
    //will output the header values that are associated with the key name 
    //" + dq + "Accept-Encoding" + dq + ". Since this header has more than one value the values will
    //be separated by a comma " + dq + "," + dq + " when they are output to the screen.
   output headers:GetValue(" + dq + "Accept-Encoding" + dq + ")")
        Paragraph("Here is the complete code section to set the NetworkRequest object "):DoubleQuote():Text("request’s"):DoubleQuote():Text(" headers and then output the key name’s specific "):DoubleQuote():Text("header's"):DoubleQuote():Text(" value(s) :")
        CodeExample("use Libraries.Network.NetworkRequest
use Libraries.Containers.HashTable

class Main
   action Main
       HashTable<text, text> headers
       headers:Add(" + dq + "Connection" + dq + ", " + dq + "keep-alive" + dq + ")
       headers:Add(" + dq + "Accept-Encoding" + dq + ", " + dq + "gzip, deflate" + dq + ")
       NetworkRequest request
       request:SetHeaders(headers)
       output headers:GetValue(" + dq + "Connection" + dq + ")
       output headers:GetValue(" + dq + "Accept-Encoding" + dq + ")
   end
end")
        CodeEditorWithCode("Activity: Setting the Web Address", "//This code will output the Request Headers we have set"):HideDisplay()
        Paragraph("The output should look like this:")
        CodeExample("keep-alive
gzip, deflate")
    end

    private action ResponseMessage
        Section("Response Message")
        BulletList()
        ListItem():Strong("HTTP Version"):Text(" : either HTTP/1.0 or HTTP/1.1")
        ListItem():Strong("Status Code"):Text(" : which provides the outcome of the request")
        ListItem():Strong("Status Text"):Text(" : which provides a short, human-readable message describing the status code such as "):DoubleQuote():Text("200 OK"):DoubleQuote():Text(", "):DoubleQuote():Text("404 Not Found"):DoubleQuote():Text(", or "):DoubleQuote():Text("401 WWW-Authenticate"):DoubleQuote():Text(".")
        Paragraph("The Status Line is returned in the following format:")
        CodeExample("HTTP-Version  StatusCode  StatusText")
        Paragraph("In order to view the Response Message’s Status Code and Status Text in Quorum we will start by adding the following libraries:")
        CodeExample("use Libraries.Network.NetworkConnection
use Libraries.Network.NetworkRequest
use Libraries.Network.NetworkResponseEvent
use Libraries.Network.NetworkRequestListener")
        Paragraph("We will then create a NetworkRequest object "):DoubleQuote():Text("request"):DoubleQuote():Text(" and set its type and web address which are discussed in depth in the following tutorials.")
        CodeExample("class Main is NetworkRequestListener
  action Main
        //creates the NetworkRequest object " + dq + "request" + dq + "
      NetworkRequest request
        //sets " + dq + "request’s" + dq + " type to GET
      request:SetRequestTypeToGet()
       //sets " + dq + "request’s" + dq + " web address to " + dq + "https://quorumlanguage.com/GETtest.php" + dq + "
      request:SetWebAddress(" + dq + "https://quorumlanguage.com/GETtest.php" + dq + ")")
        Paragraph("Next, we will create a NetworkConnection object "):DoubleQuote():Text("http"):DoubleQuote():Text(", add the NetworkListener which will be notified when a response is received from the server, and then Send a Request of the NetworkRequest object "):DoubleQuote():Text("request"):DoubleQuote():Text(" as shown below:")
        CodeExample("       //creates a NetworkConnection object " + dq + "http" + dq + "
      NetworkConnection http
       //Adds a listener to the NetworkConnection object " + dq + "http" + dq + "
      http:AddListener(me)
       //Adds a SendRequest of the NetworkRequest object " + dq + "request" + dq + " to the
       //NetworkConnection object " + dq + "http" + dq + "
      http:SendRequest(request)
  end")
        Paragraph("Finally, we will view the response Status Code followed by the Status Text using the following code:")
        CodeExample("  action ResponseReceived(NetworkResponseEvent response)
      output response:GetStatusCode() + " + dq + " " + dq + " + response:GetStatusText()
  end")
        Paragraph("Here is the complete code section to create a NetworkRequest object "):DoubleQuote():Text("request"):DoubleQuote():Text(" and view "):DoubleQuote():Text("request’s"):DoubleQuote():Text(" response from the server:")
        CodeExample("use Libraries.Network.NetworkConnection
use Libraries.Network.NetworkRequest
use Libraries.Network.NetworkResponseEvent
use Libraries.Network.NetworkRequestListener
class Main is NetworkRequestListener
  action Main
      NetworkRequest request
      request:SetRequestTypeToGet()
      request:SetWebAddress(" + dq + "https://quorumlanguage.com/GETtest.php" + dq + ")
      NetworkConnection http
      http:AddListener(me)
      http:SendRequest(request)
  end
  action ResponseReceived(NetworkResponseEvent response)
      output response:GetStatusCode() + " + dq + " " + dq + " + response:GetStatusText()
  end
end")
        CodeEditorWithCode("Activity: Viewing Response Status", "//This code will output the Web Address we have set"):HideDisplay()
        Paragraph("The output should look like this:")
        CodeExample("200 OK")
    end
end
