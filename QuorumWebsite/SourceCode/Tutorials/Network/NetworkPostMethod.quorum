use Libraries.Web.Page.QuorumPage

/*
    POST Method.
    Converted from the old Lesson page by plan 13's generator: the same
    words, now without Tailwind.
*/
class NetworkPostMethod is QuorumPage
    // A double quote, for code and words that hold one.
    text dq = ""

    on create
        SetLocation("tutorials/network/postMethod.html")
        // The name lists and links use, and the series and track it belongs
        // to: its section and picture.
        SetShortTitle("POST Method")
        SetSectionName("Network")
        // For search engines and link previews, and what lists of pages say.
        SetDescription("Sending a Request Message using the HTTP POST Method with the Quorum programming language.")
        SetSummary("an introduction to sending a request message using the Hypertext Transfer Protocol (HTTP) POST Method.")
    end

    action Setup
        dq = dq:GetDoubleQuote()
        SetWebPageTitle("POST Method")
        Title("POST Method")
        Paragraph("Sending a Request Message using the Hypertext Transfer Protocol (HTTP) POST Method")
        ThePOSTMethod()
    end

    private action ThePOSTMethod
        Section("The POST Method")
        Paragraph("The "):Strong("POST"):Text(" method is used by the browser to send, or POST, larger amounts of data to the server and create or update an existing resource. This additional data is added to the Message Body in the Request Message. A POST Request Message uses the same format as other Request Messages, replacing the Request Method in the Request Line with "):DoubleQuote():Text("POST"):DoubleQuote():Text(" as shown below:")
        CodeExample("POST  WebAddress  HTTP-Version")
        Paragraph("The POST method requires the "):Emphasis("Content-type"):Text(" and "):Emphasis("Content-length"):Text(" Request Headers which let the server know the media type and length of the Request Message Body. The Content-type Request Header is set automatically when using the SetBodyAsFormEncodedData() action, which will be discussed in the next tutorial.")
        Paragraph("In order to use the POST method type with Quorum we will have to use the "):DoubleQuote():Text("Libraries.Network.NetworkRequest"):DoubleQuote():Text(" library. We will then create a NetworkRequestType "):DoubleQuote():Text("type"):DoubleQuote():Text(" which we will set to POST as shown below:")
        CodeExample("use Libraries.Network.NetworkRequest
use Libraries.Network.NetworkRequestType

class Main
   action Main
        //creates a NetworkRequestType object " + dq + "type" + dq + "and sets " + dq + "type" + dq + " to
        //the POST method
       NetworkRequestType type
       type:SetToPost()")
        Paragraph("We will then create a NetworkRequest object "):DoubleQuote():Text("request"):DoubleQuote():Text(" and set its RequestType to "):DoubleQuote():Text("type"):DoubleQuote():Text(" (POST):")
        CodeExample("        //creates a NetworkRequest object " + dq + "request" + dq + " and uses " + dq + "type" + dq + "
        //(which is already set to POST) as the parameter in
        //SetRequestType()
       NetworkRequest request
       request:SetRequestType(type)")
        Paragraph("Here is the complete code section to set the RequestType to POST and then return the RequestType as output to the screen:")
        CodeExample("use Libraries.Network.NetworkRequest
use Libraries.Network.NetworkRequestType

class Main
   action Main
       NetworkRequest request
       NetworkRequestType type
       type:SetToPost()
       request:SetRequestType(type)
       output request:GetRequestType()
   end
end")
        CodeEditorWithCode("Activity: Setting Request Type to POST", "//This code will output the Request Type we have set to POST"):HideDisplay()
        Paragraph("The output should look like this letting us know that our NetworkRequestType (method) is set to POST:")
        CodeExample("POST")
    end
end
