use Libraries.Web.Page.QuorumPage

/*
    GET Method.
    Converted from the old Lesson page by plan 13's generator: the same
    words, now without Tailwind.
*/
class NetworkGetMethod is QuorumPage
    // A double quote, for code and words that hold one.
    text dq = ""

    on create
        SetLocation("tutorials/network/getMethod.html")
        // The name lists and links use, and the series and track it belongs
        // to: its section and picture.
        SetShortTitle("GET Method")
        SetSectionName("Network")
        // For search engines and link previews, and what lists of pages say.
        SetDescription("Sending a Request Message using the HTTP GET Method with the Quorum programming language.")
        SetSummary("an introduction to sending a request message using the Hypertext Transfer Protocol (HTTP) GET Method")
    end

    action Setup
        dq = dq:GetDoubleQuote()
        SetWebPageTitle("GET Method")
        Title("GET Method")
        Paragraph("Sending a Request Message using the Hypertext Transfer Protocol (HTTP) GET Method")
        TheGETMethod()
    end

    private action TheGETMethod
        Section("The GET Method")
        CodeExample("GET  WebAddress  HTTP-Version")
        Paragraph("The Request Headers and Request Message Body are both optional when using the GET method.")
        Paragraph("In order to use the GET method type with Quorum we will have to use the "):DoubleQuote():Text("Libraries.Network.NetworkRequest"):DoubleQuote():Text(" library. Then we will create a NetworkRequestType "):DoubleQuote():Text("type"):DoubleQuote():Text(" which we will set to GET as shown below:")
        CodeExample("use Libraries.Network.NetworkRequest
use Libraries.Network.NetworkRequestType

class Main
   action Main
        //creates a NetworkRequestType object " + dq + "type" + dq + "and sets " + dq + "type" + dq + " to
        //the GET method
       NetworkRequestType type
       type:SetToGet()")
        Paragraph("We will then create a NetworkRequest object "):DoubleQuote():Text("request"):DoubleQuote():Text(" and set its RequestType to "):DoubleQuote():Text("type"):DoubleQuote():Text(" (GET) as shown below:")
        CodeExample("        //creates a NetworkRequest object " + dq + "request" + dq + " and uses " + dq + "type" + dq + "
        //(which is already set to GET) as the parameter in
        //SetRequestType()
       NetworkRequest request
       request:SetRequestType(type)")
        Paragraph("Here is the complete code section to set the RequestType to GET and then return the RequestType as output to the screen:")
        CodeExample("use Libraries.Network.NetworkRequest
use Libraries.Network.NetworkRequestType

class Main
   action Main
       NetworkRequest request
       NetworkRequestType type
       type:SetToGet()
       request:SetRequestType(type)
       output request:GetRequestType()
   end
end")
        CodeEditorWithCode("Activity: Setting Request Type to GET", "//This code will output the Request Type we have set to GET"):HideDisplay()
        Paragraph("The output should look like this letting us know that our NetworkRequestType (method) is set to GET:")
        CodeExample("GET")
    end
end
