use Libraries.Web.Page.QuorumPage

/*
    Input and Events in Quorum.
    Converted from the old Lesson page by plan 13's generator: the same
    words, now without Tailwind.
*/
class GamesEventsTutorial is QuorumPage
    // A double quote, for code and words that hold one.
    text dq = ""

    on create
        SetLocation("tutorials/games/events.html")
        // The name lists and links use, and the series and track it belongs
        // to: its section and picture.
        SetShortTitle("Input Polling")
        SetSectionName("User Interaction and Events")
        SetCardImage("/media/games/Events.png")
        // For search engines and link previews, and what lists of pages say.
        SetDescription("Learn about how to capture events from a keyboard, mouse, or touch screen using the Quorum programming language.")
        SetSummary("How to use input and events in our games.")
    end

    action Setup
        dq = dq:GetDoubleQuote()
        SetWebPageTitle("Events - Quorum Programming Language")
        Title("Input and Events in Quorum")
        Paragraph("This tutorial shows how to use input and events in our games.")
        InputPolling()
        TryItYourself()
    end

    private action InputPolling
        Section("Input Polling")
        Paragraph("In this tutorial, we will learn about using player input and the game engine’s event system. With these tools, our games will be able to react to mouse and keyboard input, as well as to colliding game objects.")
        Paragraph("The first method we will discuss for getting player input is known as "):Strong("polling"):Text(".Polling is a technique which involves regularly checking the current state of the mouse or keyboard to see if the player is giving us any input.")
        Paragraph("To do this in the Quorum Game Engine, we must include the InputMonitor library with the statement "):Code("use Libraries.Game.InputMonitor"):Text(". If we want to monitor keyboard input, we will also include the KeyboardEvent library with the statement "):Code("use Libraries.Interface.Events.KeyboardEvent"):Text(".")
        Paragraph("To see input polling in action, we will use a sample program which will play a sound when we press the spacebar on the keyboard or when we click inside the screen. To download a sample project that includes audio files, click "):Link("here", "/files/games/InputPollingProject.zip"):Text(".")
        Paragraph("To begin with this sample, let’s start by looking at the objects we will use in our program.")
        CodeExample("InputMonitor monitor
KeyboardEvent keys
Audio keySound
Audio mouseSound")
        BulletList()
        ListItem("The "):Strong("InputMonitor"):Text(" class is what we will use to poll the mouse and keyboard for input. We will see how this is used in the Update action.")
        ListItem("The "):Strong("KeyboardEvent"):Text(" is typically used for getting player input through event handling, which is an alternative approach compared to polling. However, in this case we will use it to test if a particular key has been pressed because it also contains descriptive values for all supported keys on the keyboard so we don't have to use numeric codes.")
        ListItem("The "):Strong("Audio"):Text(" class will be used to play our sounds when the user gives us input. For more information on how Audio works, see "):Link("Playing Audio Files in Quorum", "/tutorials/dsp/audiointro.html"):Text(".")
        CodeExample("   action Update(number seconds)
       // If the user is currently clicking the mouse, play a sound.
        if monitor:IsClicked()
            mouseSound:Play()
        end

       // If the user is pressing the spacebar, play a sound.
        if monitor:IsKeyPressed(keys:SPACE)
            keySound:Play()
        end
    end")
        Paragraph("The two"):Code(" if "):Text("statements are where we check for input. In "):Code("if monitor:IsClicked() "):Text("we ask the InputMonitor to check if any of the mouse buttons are currently being held down. If any of them are, we will enter the code inside the "):Code("if "):Text("block.")
        Paragraph("Then we reach "):Code("if monitor:IsKeyPressed(keys:SPACE) "):Text(". The InputMonitor action IsKeyPressed will test if a particular key on the keyboard is being held down. Inside the action, we have to tell Quorum which key we want to test, so we give it the value of SPACE from the KeyboardEvent class. To see the names of all the keys refer to the "):Link("KeyboardEvent", "/Libraries/Interface/Events/KeyboardEvent.html"):Text(" documentation.")
        Paragraph("These two actions are enough to test for input from both mouse and keyboard, but the InputMonitor has other actions to poll for other kinds of information, such as the current location of the mouse. For full details on what an InputMonitor can do, see its documentation page "):Link("here", "/Libraries/Game/InputMonitor.html"):Text(".")
        Paragraph("Try it out below:")
        Paragraph("We put our InputMonitor in the Update action because we want to check (poll) the status of the inputs at every frame. This is where we test for input, and react accordingly.")
    end

    private action TryItYourself
        Section("Try it Yourself!")
        Paragraph("Press the blue run button to execute the code in the code editor. Press the red stop button to end the program. Your program will work when the console outputs "):DoubleQuote():Text("Build Successful!"):DoubleQuote()
        CodeEditorWithCode("Play Sounds with Input Polling", "PlaySounds.quorum", "use Libraries.Game.Game
use Libraries.Game.InputMonitor
use Libraries.Interface.Events.KeyboardEvent
use Libraries.Sound.Audio

class Main is Game
   InputMonitor monitor
   KeyboardEvent keys
   Audio keySound
   Audio mouseSound

   action Main
       StartGame()
   end

   action CreateGame
       keySound:Load(" + dq + "AudioFiles/lightSound.wav" + dq + ")
       mouseSound:Load(" + dq + "AudioFiles/heavySound.wav" + dq + ")
   end

   action Update(number seconds)
       if monitor:IsClicked()
           mouseSound:Play()
       end

       if monitor:IsKeyPressed(keys:SPACE)
           keySound:Play()
       end
   end
end")
    end
end
