use Libraries.Web.Page.QuorumPage

/*
    Mouse Events.
    Converted from the old Lesson page by plan 13's generator: the same
    words, now without Tailwind.
*/
class MouseEventsTutorial is QuorumPage
    // A double quote, for code and words that hold one.
    text dq = ""

    on create
        SetLocation("tutorials/games/mouseEvents.html")
        // The name lists and links use, and the series and track it belongs
        // to: its section and picture.
        SetShortTitle("Mouse Events")
        SetSectionName("User Interaction and Events")
        SetCardImage("/media/games/Events.png")
        // For search engines and link previews, and what lists of pages say.
        SetDescription("Learn about how to capture events from a mouse using the Quorum programming language.")
        SetSummary("How to use mouse events events in our games.")
    end

    action Setup
        dq = dq:GetDoubleQuote()
        SetWebPageTitle("Mouse Events - Quorum Programming Language")
        Title("Mouse Events")
        Paragraph("This tutorial shows how to use mouse events in Quorum.")
        UsingMouseEvents()
        UsingMouseListeners()
        UsingMouseMovement()
        UsingMouseMovementListeners()
    end

    private action UsingMouseEvents
        Section("Using MouseEvents")
        Paragraph("We can also use events for mouse input. There are three possible listeners for MouseEvents.")
        BulletList()
        ListItem("A "):Strong("MouseListener"):Text(" is used to listen for when mouse buttons are clicked or released.")
        ListItem("A "):Strong("MouseMovementListener"):Text(" is used to listen for when the mouse is moved or dragged.")
        ListItem("A "):Strong("MouseWheelListener"):Text(" is used to detect when the mouse wheel is scrolled up or down.")
    end

    private action UsingMouseListeners
        Section("Using MouseListeners")
        Paragraph("In this next sample program, we will use a MouseListener to make a square change color while we are clicking on it, and return it to its previous color when we release the mouse button. Try the total code out below in the browser or Quorum Studio:")
        CodeEditorWithCode("Clicking with the Mouse", "ClickingMouse.quorum", "use Libraries.Game.Game
use Libraries.Game.Graphics.Color
use Libraries.Interface.Events.MouseListener
use Libraries.Interface.Events.MouseEvent
use Libraries.Game.Graphics.Drawable

class Main is Game, MouseListener
    Drawable square
    Color clickColor
    Color releaseColor

    action Main
        StartGame()
    end
    
    action CreateGame
        // This code draws our square on the screen.
        Color white
        white = white:White()
        square:LoadFilledRectangle(50, 50, white)
        square:SetPosition(0, 0)
        Add(square)

        // Set the colors
        clickColor:SetColor(0, 0.9, 0, 1)
        releaseColor:SetColor(0.9, 0, 0, 1)
        square:SetColor(releaseColor)
        
        //Add listener to the square
        square:AddMouseListener(me)
    end
    
    action Update(number seconds)
    end
    
    // Gets an event when we click
    action ClickedMouse(MouseEvent event)
        output " + dq + "Clicked" + dq + "
        square:SetColor(clickColor)
    end
    
    // Gets an event when we release
    action ReleasedMouse(MouseEvent event)
        output " + dq + "Released" + dq + "
        square:SetColor(releaseColor)
    end
end")
        Paragraph("Notice that when we create our class using the line "):Code("class Main is Game, MouseListener "):Text(", we inherit from MouseListener, similar to how we inherit from KeyboardListener to listen for KeyboardEvents. We also need to call AddMouseListener to notify the engine like we did before.")
        CodeExample("// Ensure this object will receive mouse events when it is clicked.
AddMouseListener(me)")
        Paragraph("In this case, instead of adding the listener directly to the Game class, we show an alternative approach where we add the listener directly to an Item (the square). Functionally the engine calls the predefined actions of the class (if they are specified), however in this case, the listener only applies if the square was clicked. If we wanted different behavior for different objects, we can and add them anywhere.")
        Paragraph("In any class that inherits from MouseListener, the ClickedMouse action will automatically be called when the user clicks the mouse. This action must take a MouseEvent as a parameter. The MouseEvent can contain lots of information, including what mouse button was clicked or the X,Y coordinates of the mouse when the event occurred. To see everything that a MouseEvent can contain, see its full documentation "):Link("here", "/Libraries/Interface/Events/MouseEvent.html"):Text(".")
        CodeExample("action ClickedMouse(MouseEvent event)
   SetColor(clickColor)
end")
        Paragraph("Similarly, a class that inherits from MouseListener can use the ReleasedMouse action to automatically call code when the user releases a mouse button. This action must also take a MouseEvent as a parameter.")
        CodeExample("action ReleasedMouse(MouseEvent event)
   SetColor(releaseColor)
end")
        Paragraph("The image on the left is when the game starts and the image on the right is when the image is clicked on")
        Image("media/games/Red_Square.png", "This is an image of a red square")
        Image("media/games/Green_Square.png", "This is an image of a green square")
        Paragraph("The code in Main is used to additionally position and draw our square on the screen.")
    end

    private action UsingMouseMovement
        Section("Using MouseMovement")
        Paragraph("MouseEvents can also be used with MouseMovementListeners to detect when the mouse is moved or dragged (which means that the mouse was moved while a mouse button was held down). In this next sample, we will make a square rotate when the mouse when the mouse is moved and make the square move when dragged.")
        CodeEditorWithCode("Moving with the Mouse", "ClickingMouse.quorum", "use Libraries.Game.Game
use Libraries.Game.Graphics.Color
use Libraries.Interface.Events.MouseListener
use Libraries.Interface.Events.MouseEvent
use Libraries.Game.Graphics.Drawable

class Main is Game, MouseListener
    Drawable square
    Color clickColor
    Color releaseColor

    action Main
        StartGame()
    end
    
    action CreateGame
        // This code draws our square on the screen.
        Color white
        white = white:White()
        square:LoadFilledRectangle(50, 50, white)
        square:SetPosition(0, 0)
        Add(square)

        // Set the colors
        clickColor:SetColor(0, 0.9, 0, 1)
        releaseColor:SetColor(0.9, 0, 0, 1)
        square:SetColor(releaseColor)
        
        //Add listener to the square
        square:AddMouseListener(me)
    end
    
    action Update(number seconds)
    end
    
    // Gets an event when we click
    action ClickedMouse(MouseEvent event)
        output " + dq + "Clicked" + dq + "
        square:SetColor(clickColor)
    end
    
    // Gets an event when we release
    action ReleasedMouse(MouseEvent event)
        output " + dq + "Released" + dq + "
        square:SetColor(releaseColor)
    end
end")
        Paragraph("Just like the other listeners, when we create our class with the line "):Code("class Main is Game, MouseMovementListener"):Text(", we need to inherit from the listener we are using, which in this case is the MouseMovementListener and the Game. This lets us create our two special actions that will be called automatically for us.")
        Paragraph("The first of these two actions is MovedMouse. This action will be called anytime the mouse is moved and there are no buttons held down on the mouse. In our example, we use "):Code("event:GetX()"):Text(" and "):Code("event:GetY()"):Text(" to get the x, y coordinates of the mouse after it has moved.")
        CodeExample("// This action will be called on a mouse event
   // because the mouse was moved with no mouse buttons being held down
   action MovedMouse(MouseEvent event)
       // This code rotates the square.
       number x = event:GetX()
       square:Rotate(x * 0.1)
   end")
        Paragraph("The other action that will be automatically called by inheriting from MouseMovementListener is the DraggedMouse action. This action is called when the mouse is moved while holding down a button. In our example, we use "):Code("event:GetMovementX()"):Text(" and "):Code("event:GetMovementY()"):Text(" to get the distance traveled by the mouse since the last time the mouse was moved or dragged.")
        CodeExample("// This action is called when moving the mouse while holding down a button.
   action DraggedMouse(MouseEvent event)
       // This code drags the square
       number x = event:GetMovementX()
       number y = event:GetMovementY()
       square:Move(x, y)
   end")
        Paragraph("The most important thing in our Main class is the line "):Code("AddMouseMovementListener(me)"):Text(". This line tells the game engine to notify us every time the mouse is moved or dragged.")
    end

    private action UsingMouseMovementListeners
        Section("Using MouseMovementListeners")
        Paragraph("The last type of listener for MouseEvents is the MouseWheelListener. In this sample, we will use a MouseWheelListener to rotate a triangle on the screen when the user scrolls the mouse wheel.")
        CodeEditorWithCode("Wheeling with the Mouse", "ClickingMouse.quorum", "use Libraries.Game.Game
use Libraries.Game.Graphics.Color
use Libraries.Interface.Events.MouseListener
use Libraries.Interface.Events.MouseEvent
use Libraries.Game.Graphics.Drawable

class Main is Game, MouseListener
    Drawable square
    Color clickColor
    Color releaseColor

    action Main
        StartGame()
    end
    
    action CreateGame
        // This code draws our square on the screen.
        Color white
        white = white:White()
        square:LoadFilledRectangle(50, 50, white)
        square:SetPosition(0, 0)
        Add(square)

        // Set the colors
        clickColor:SetColor(0, 0.9, 0, 1)
        releaseColor:SetColor(0.9, 0, 0, 1)
        square:SetColor(releaseColor)
        
        //Add listener to the square
        square:AddMouseListener(me)
    end
    
    action Update(number seconds)
    end
    
    // Gets an event when we click
    action ClickedMouse(MouseEvent event)
        output " + dq + "Clicked" + dq + "
        square:SetColor(clickColor)
    end
    
    // Gets an event when we release
    action ReleasedMouse(MouseEvent event)
        output " + dq + "Released" + dq + "
        square:SetColor(releaseColor)
    end
end")
        Paragraph("Inside our class there is one action, "):Code("action ScrolledMouse(MouseEvent event) "):Text(". This is the only action that will be called when using a MouseWheelListener. Inside this action we use "):Code("event:scrollAmount "):Text(". (Note that it is lower-case without parenthesis - we are directly using a variable inside event, instead of calling an action.) The "):Code("scrollAmount "):Text("value represents how far the mouse wheel has been scrolled. If the wheel was scrolled up, it will be positive, and if it was scrolled down, it will be negative. The faster the wheel was scrolled, the larger the number will be.")
        Paragraph("To make the game inform our listener of events, we need to add it. We can see this in our example code on the line "):Code("AddMouseWheelListener(me) "):Text(".")
    end
end
