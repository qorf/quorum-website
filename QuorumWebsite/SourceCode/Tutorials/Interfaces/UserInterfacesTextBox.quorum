use Libraries.Web.Page.all
use Libraries.Web.Page.Standards.ComputerScienceStandards2026
use Libraries.Web.Page.Standards.QuorumStandards

/*
    Tutorial: Text Boxes, part of the user interface series.
*/
class UserInterfacesTextBox is QuorumPage
    // The site's sets of standards, built once for every page.
    QuorumStandards standards

    on create
        SetLocation("tutorials/ui/textBox.html")
        SetShortTitle("Text Boxes")
        SetSectionName("User Interfaces")
    end

    action Setup
        // For search engines and link previews.
        SetDescription("How to use text boxes in Quorum: put them on a page, work with the text and the selection, add line numbers and text styles, and think about autocorrect and automation.")

        Title("Text Boxes")

        Overview()
        WarmUp()
        Explore()
        Engage()
        WrapUp()
    end

    action Overview
        Section("Overview")
        Paragraph("A text box is an area where a person can type many lines of text, like notes,
a story or a program. Quorum Studio's code editor is built on the same idea.
In this tutorial, you will put two text boxes on a page, add buttons that
clear, show and copy text between them, and then add line numbers and
colored, underlined text.")

        Subsection("Goals")
        Paragraph("You have the following goals for this tutorial:")
        Goals()
        ListItem("Add text boxes to a page and give each one a clear label, name and
description")
        ListItem("Get, set, add to and empty the text in a text box from code")
        ListItem("Use a "):Code("TextBoxSelection"):Text(" to work with the text a person has selected")
        ListItem("Add a line number gutter and a text style, and explain why style alone
shouldn't carry meaning")
        ListItem("Examine how autocorrect, an algorithm in many text boxes, helps some
people and harms others")
        ListItem("Evaluate how automation such as self-driving vehicles can create and
replace jobs")
    end

    action WarmUp
        Section("Warm up")
        Paragraph("Think of three programs where you type more than one line of text: maybe a
word processor, a chat app and a code editor. What extra features does each
one add beyond typing? Which of those features would you miss most if they
were gone?")

        Subsection("Vocabulary")
        Paragraph("You will be learning about the following vocabulary words:")
        Table("Vocabulary", "media/userInterface/TextBox/Vocabulary.csv")

        Subsection("New Code to Learn")
        Paragraph("You will be using the following new pieces of code:")
        Table("New Code to Learn", "media/userInterface/TextBox/Code.csv")

        Subsection("CSTA Standards")
        Paragraph("This tutorial covers the following "):Link("CSTA standards", "https://csteachers.org/pk12standards/view/"):Text(":")
        ComputerScienceStandards2026 computerScience = standards:GetComputerScience2026()
        CoversStandard(computerScience, computerScience:HIGH_SCHOOL_PROGRAM_DEVELOPMENT_12)
        CoversStandard(computerScience, computerScience:MIDDLE_SCHOOL_PROGRAM_DEVELOPMENT_12)
        CoversStandard(computerScience, computerScience:MIDDLE_SCHOOL_IMPACTS_OF_ALGORITHMS_AND_DESIGN_10)
        CoversStandard(computerScience, computerScience:MIDDLE_SCHOOL_CAREER_EXPLORATION_45)
        CoversStandard(computerScience, computerScience:HIGH_SCHOOL_IMPACTS_OF_COMPUTING_SYSTEMS_37)
        CoversStandard(computerScience, computerScience:HIGH_SCHOOL_HISTORY_OF_COMPUTING_39)
        CoversStandard(computerScience, computerScience:GRADE_4_EMERGING_TECHNOLOGIES_17)
        CoversStandard(computerScience, computerScience:SPECIALTY_1_SOFTWARE_DEVELOPMENT_USER_EXPERIENCE_4)
        StandardsList(computerScience)
    end

    action Explore
        Section("Explore")
        BoxesAndFields()
        MakingTwoTextBoxes()
        MovingTheFocus()
        ButtonsThatWorkWithText()
        WorkingWithTheSelection()
        LineNumbers()
        TextStyles()
        TheFinishedProgram()
        Autocorrect()
        AutomationAndJobs()
    end

    private action BoxesAndFields
        Subsection("Text boxes and text fields")
        Paragraph("In the "):Link("Text Fields", "/tutorials/ui/textField.html"):Text(" tutorial, you used a text
field for one line of text. A "):Strong("text box"):Text(" ("):Code("TextBox"):Text(") holds many lines. It
scrolls when the text doesn't fit, and it can show extras like line numbers.
Most of the actions are the same: "):Code("GetText"):Text(", "):Code("SetText"):Text(" and "):Code("Empty"):Text(" work just
as they do on a text field.")

        Paragraph("A person can type in a text box with the usual editing keys: the arrow keys, "):Key("Home"):Text(" and "):Key("End"):Text(", "):Key("Shift"):Text(" to select, "):Key("Enter"):Text(" for a new line, and "):Keys("Ctrl", "A"):Text(", "):Keys("Ctrl", "C"):Text(", "):Keys("Ctrl", "X"):Text(", "):Keys("Ctrl", "V"):Text(", "):Keys("Ctrl", "Z"):Text(" and "):Keys("Ctrl", "Y"):Text(" (use "):Key("Cmd"):Text(" on a Mac).")
    end

    private action MakingTwoTextBoxes
        Subsection("Making two text boxes")
        Paragraph("In this tutorial, we build a small note copier: a "):DoubleQuote():Text("Source notes"):DoubleQuote():Text(" box and a "):DoubleQuote():Text("Copied notes"):DoubleQuote():Text(" box. A page's "):Code("AddTextBox"):Text(" action makes a text box and adds it
to the page. The page makes it as wide as the row and four lines tall. "):Code("SetLayoutRows"):Text(" makes it taller.")

        Paragraph("Like a text field, a text box shows no words of its own, so each one gets a
label. A label added right before a text box sits above it.")
        CodeExampleFromFile("sources/tutorials/ui/TextBox/Main.quorum")

        Paragraph("The two boxes have different names and descriptions, so a screen reader user
can tell them apart. Don't rely on color or position alone to tell them
apart: a person who can't see the screen, or who can't tell the colors
apart, would miss it.")
    end

    private action MovingTheFocus
        Subsection("Moving the focus with Tab")
        Paragraph("The page sets the "):Key("Tab"):Text(" order for you, top to bottom: the title, then each
label and the text box under it. In a text box, "):Key("Tab"):Text(" moves the focus to the next control
by default. That's what you want in most programs, because it means a
keyboard user is never trapped in a text box. A code editor is different:
there, "):Key("Tab"):Text(" should indent. You can switch with "):Code("SetMoveFocusOnTab(false)"):Text(",
but then you must give keyboard users another way to leave the box.")
    end

    private action ButtonsThatWorkWithText
        Subsection("Buttons that work with the text")
        Paragraph("Next, we add four buttons in a row under the text boxes. Each one gets its
own behavior class. Each behavior is a "):Code("FormBehavior"):Text(", so it can find the
text boxes on the page by their names with "):Code("GetTextBox"):Text(". This keeps every
class small and easy to read.")

        Paragraph():Strong("Clear"):Text(" empties the copied notes. Make "):Code("ClearBehavior.quorum"):Text(":")
        CodeExampleFromFile("sources/tutorials/ui/TextBox/ClearBehavior.quorum")

        Paragraph():Strong("Show text"):Text(" outputs the copied notes and counts their lines. Make "):Code("ShowBehavior.quorum"):Text(":")
        CodeExampleFromFile("sources/tutorials/ui/TextBox/ShowBehavior.quorum")
    end

    private action WorkingWithTheSelection
        Subsection("Working with the selection")
        Paragraph("When a person selects text, the text box keeps track of where the selection
starts and ends. Each position is an "):Strong("index"):Text(": the number of characters
before it, counting from 0. If the text is "):DoubleQuote():Text("Hello world!"):DoubleQuote():Text(" and "):DoubleQuote():Text("world"):DoubleQuote():Text(" is
selected, the selection starts at index 6 and ends at index 11.")

        Paragraph():Code("GetSelection"):Text(" returns a "):Code("TextBoxSelection"):Text(" with these indexes. Its "):Code("IsEmpty"):Text("
action is true if nothing is selected, and its "):Code("GetText"):Text(" action returns the
selected text. "):Strong("Copy selection"):Text(" adds the selected text to the end of the
copied notes. Make "):Code("CopySelectionBehavior.quorum"):Text(":")
        CodeExampleFromFile("sources/tutorials/ui/TextBox/CopySelectionBehavior.quorum")

        Paragraph("A person can select text with the mouse, or by holding "):Key("Shift"):Text(" and pressing
the arrow keys. The selection stays when the focus moves to the button.")
    end

    private action LineNumbers
        Subsection("Line numbers")
        Paragraph("A "):Strong("gutter"):Text(" is a strip down the left side of a text box. The most common one
shows line numbers, as in a code editor. Quorum has a "):Code("LineNumberGutter"):Text(" you
can add with the text box's "):Code("Add"):Text(" action. A gutter is also a kind of control,
so the code uses "):Code("cast"):Text(" to tell Quorum which "):Code("Add"):Text(" action you mean:")
        CodeExampleFromFile("sources/tutorials/ui/TextBox/AddGutter.quorum")

        Paragraph("A gutter can also react when a person clicks it. A "):Strong("gutter listener"):Text(" is
told which line was clicked. This one moves the caret, the blinking mark
where typing goes, to the start of that line. Make "):Code("GoToLineListener.quorum"):Text(":")
        CodeExampleFromFile("sources/tutorials/ui/TextBox/GoToLineListener.quorum")

        Paragraph("Then add it to the gutter, in "):Code("Main.quorum"):Text(":")
        CodeExampleFromFile("sources/tutorials/ui/TextBox/AddGutterListener.quorum")

        Paragraph("A gutter only reacts to the mouse. A person using a keyboard can't click
it, so every job a gutter does needs a keyboard way too. Here, a text
field and a button go to a line from the keyboard. Make "):Code("GoToLineBehavior.quorum"):Text(":")
        CodeExampleFromFile("sources/tutorials/ui/TextBox/GoToLineBehavior.quorum")

        Paragraph("And add the field and button to "):Code("Main.quorum"):Text(", after the source notes:")
        CodeExampleFromFile("sources/tutorials/ui/TextBox/AddGoToLine.quorum")

        Paragraph("Now there are two ways to do the same thing:")

        BulletList()
        ListItem():Strong("With the mouse:"):Text(" click a line number in the gutter.")
        ListItem():Strong("With the keyboard:"):Text(" press "):Key("Tab"):Text(" to reach the Line number field, type a
number such as "):Code("2"):Text(", press "):Key("Tab"):Text(" to reach Go to line, and press "):Key("Space"):Text(".
The caret moves to the start of line 2. Press "):Keys("Shift", "Tab"):Text(" until you are
back in the source notes to keep typing there.")

        Paragraph("People count lines from 1, but a text box counts them from 0, so the
behavior subtracts 1. "):Code("ParseInteger"):Text(" expects a whole number: typing a word
instead stops the program with an error.")
    end

    private action TextStyles
        Subsection("Text styles")
        Paragraph("A "):Strong("text style"):Text(" changes how part of the text looks. You make a "):Code("TextStyle"):Text(",
set its colors and an optional highlight such as "):Code("TextUnderline"):Text(", tell it
where to start ("):Code("SetIndex"):Text(") and how many characters to cover ("):Code("SetSize"):Text("), then
add it to the text box with "):Code("AddTextStyle"):Text(". Each style needs a name. This
behavior colors and underlines the selected text. Make "):Code("StyleBehavior.quorum"):Text(":")
        CodeExampleFromFile("sources/tutorials/ui/TextBox/StyleBehavior.quorum")

        Paragraph("The "):Code("count"):Text(" gives each style its own name. If you type inside styled text,
the new letters take the same style.")

        Paragraph("A screen reader reads the words, not their color or underline. If a style
means something, like "):DoubleQuote():Text("this part is important,"):DoubleQuote():Text(" also say it in words.")
    end

    private action TheFinishedProgram
        Subsection("The finished program")
        Paragraph("Here is the whole program in "):Code("Main.quorum"):Text(", with the buttons and the gutter. The
buttons go in a "):Strong("grouping"):Text(" with no title, which puts them side by side in
one row, as in the "):Link("Groupings", "/tutorials/ui/groupings.html"):Text(" tutorial.")
        CodeExampleFromFile("sources/tutorials/ui/TextBox/Main2.quorum")

        Paragraph("Press "):Key("Tab"):Text(" from the top and notice where the focus goes. It moves through
the title, each label and its control, the Go to line button, and then the
four buttons in the row, in the
order they are on the page. You didn't write any focus code.")

        BlockEditorFile("CopySelectionBehavior.quorum", "html/sources/tutorials/ui/TextBox/CopySelectionBehavior.quorum")
        BlockEditorFile("StyleBehavior.quorum", "html/sources/tutorials/ui/TextBox/StyleBehavior.quorum")
        BlockEditorFile("ClearBehavior.quorum", "html/sources/tutorials/ui/TextBox/ClearBehavior.quorum")
        BlockEditorFile("ShowBehavior.quorum", "html/sources/tutorials/ui/TextBox/ShowBehavior.quorum")
        BlockEditorFile("GoToLineBehavior.quorum", "html/sources/tutorials/ui/TextBox/GoToLineBehavior.quorum")
        BlockEditorFile("GoToLineListener.quorum", "html/sources/tutorials/ui/TextBox/GoToLineListener.quorum")
        BlockEditor("Main.quorum", "html/sources/tutorials/ui/TextBox/Main2.quorum", "", true, true)
    end

    private action Autocorrect
        Subsection("When a text box guesses: autocorrect")
        Paragraph("The text boxes in this tutorial show exactly what a person types. Many text
boxes in phones and word processors do more: they run "):Strong("autocorrect"):Text(", an
algorithm that compares each word with a dictionary and changes or marks
words it doesn't find. That helps most people fix typing mistakes quickly.
But a dictionary that leaves out some names treats those names as mistakes.
In 2024, a campaign called I Am Not A Typo checked the names of babies born
in Northern Ireland in 2022 against Microsoft's English (UK) dictionary.
It found that 42% of the names, such as Fiadh, Meabh, Oisin and Daithi,
were marked as wrong. Names of African and Asian origin were also marked
more often than others
("):Link("The Irish Times", "https://irishtimes.com/ireland/2024/03/11/popular-irish-names-deemed-typos-in-harmful-filters"):Text(").")

        Paragraph("Who benefits from autocorrect, and who is harmed? Whose names were most
likely left out of the dictionary, and why might that have happened?")

        Paragraph("Try it yourself. In a word processor or on a phone, type five names: your
own, and four from your school, your family or the news that come from
different languages. Write down which ones autocorrect changes or marks as
wrong, and one thing you would change about it.")
    end

    private action AutomationAndJobs
        Subsection("Automation and jobs: self-driving cars")
        Paragraph("User interfaces, including many of the components in these tutorials, provide a powerful way for humans to ask a machine to do something easily. A textbox can correct text or a button can be told to tell a car to "):DoubleQuote():Text("move."):DoubleQuote():Text(" There is nothing good or bad about user interfaces. However, "):Strong("Automation"):Text("
can also do a whole job. Self-driving cars are a current example. Waymo, a
US company, runs taxis with no human driver. In a February 2026 post on its
own website, Waymo said it was giving more than 400,000 rides every week
across six US metropolitan areas, gave 15 million rides in 2025, and was
preparing to start in more than 20 more cities in 2026, including Tokyo and
London
("):Link("Waymo", "https://waymo.com/blog/2026/02/waymo-raises-usd16-billion-investment-round/"):Text(").
These are the company's own numbers; this tutorial did not find an
independent count of them. A regular taxi ride needs a paid driver; a Waymo
ride does not.")

        Paragraph("Driving is a large source of work in the United States. The US Bureau of
Labor Statistics (BLS), a government agency that counts jobs, reports for
2025:")

        BulletList()
        ListItem():Strong("Taxi drivers, shuttle drivers and chauffeurs:"):Text(" 455,700 jobs, with a
median pay of $37,960 a year. No formal education credential is needed
to start. BLS projects 9% more of these jobs by 2035
("):Link("BLS", "https://www.bls.gov/ooh/transportation-and-material-moving/taxi-drivers-and-chauffeurs.htm"):Text(").")
        ListItem():Strong("Heavy and tractor-trailer truck drivers:"):Text(" 2,221,200 jobs, with a
median pay of $58,640 a year. Most drivers start with truck driving
school. BLS projects 4% more of these jobs by 2035
("):Link("BLS", "https://www.bls.gov/ooh/transportation-and-material-moving/heavy-and-tractor-trailer-truck-drivers.htm"):Text(").")

        Paragraph("Together, that is more than 2.6 million people whose work is driving.
Waymo's taxis do the work of the first group. The technology required to do the latter, however, is similar.")

        Paragraph():Strong("What about jobs created?"):Text(" Here the evidence is much weaker. Waymo says
its vehicle factory in Mesa, Arizona, "):DoubleQuote():Text("has created hundreds of jobs"):DoubleQuote():Text("
("):Link("Waymo", "https://waymo.com/blog/2025/05/scaling-our-fleet-through-us-manufacturing/"):Text(").
That is a claim from the company. It gives no exact number, doesn't say
how the jobs were counted, and this tutorial found no independent source
that checks it. Even if it is accurate, "):DoubleQuote():Text("hundreds"):DoubleQuote():Text(" means fewer than 1,000.
Next to the 455,700 taxi and chauffeur jobs that driverless taxis are built
to do, 999 jobs would be less than one quarter of one percent. This tutorial also found no reliable count of how many
driving jobs self-driving cars have replaced so far, or of how many new jobs
they have created overall.")
    end

    action Engage
        Section("Engage")
        Paragraph("In this activity, you discuss how self-driving vehicles could create and
replace jobs, in a small group or as a class. There is no programming for this one, although if you want to add such a component, students can create an app with a textbox in it and type their arguments in there. Use
the facts in "):DoubleQuote():Text("Automation and jobs: self-driving cars"):DoubleQuote():Text(" as your evidence, and
say which fact you are using when you make a point. Consider the following in the discussion.")

        NumberedList()
        ListItem("Are the facts actually facts? Consider the sources of each of the alleged numbers and look at BLS directly. Consider if there are any flaws in the claims.")
        ListItem("What are the sources missing? Think like a scientist or a reporter and imagine the incentives of all of the people making and using the technology")
        ListItem("What do you think the impact will be on society? Overall, what effect do you think the technology will have and what rules or laws might help shape that impact to be positive overall?")

        Paragraph("To finish, write a paragraph or two with your position. Show it to a partner and consider the points and counterpoints. Then, see if you can find a middle ground between any positions you had, if they were different.")
    end

    action WrapUp
        Section("Wrap up")
        Paragraph("A text box holds many lines of text. You can read and change the text, work
with what a person selected, and add extras like line numbers and styles.
Every feature you add should work with the keyboard as well as the mouse,
as the line number gutter's "):DoubleQuote():Text("Go to line"):DoubleQuote():Text(" does. Think about software you
use: what work does it do that a person used to do, and who did that work?")
    end
end
