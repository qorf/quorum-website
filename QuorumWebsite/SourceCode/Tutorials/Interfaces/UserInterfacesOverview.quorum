use Libraries.Web.Page.all
use Libraries.Web.Page.Standards.ComputerScienceStandards2026
use Libraries.Web.Page.Standards.QuorumStandards

/*
    Tutorial: User Interfaces Overview, the first page of the user interface
    series.
*/
class UserInterfacesOverview is QuorumPage
    // The site's sets of standards, built once for every page.
    QuorumStandards standards

    on create
        SetLocation("tutorials/ui/overview.html")
        SetShortTitle("Overview")
        SetSectionName("User Interfaces")
    end

    action Setup
        // For search engines and link previews.
        SetDescription("An overview of user interfaces in Quorum: what a graphical user interface is, Forms and Games, your first Form, and a map of the series.")

        Title("User Interfaces Overview")

        Overview()
        WarmUp()
        Explore()
        Engage()
        WrapUp()
    end

    action Overview
        Section("Overview")
        Paragraph("A user interface is the part of a program that a person sees, hears, and
touches. Buttons, text fields, lists, and menus are all parts of a user
interface. In this series of tutorials, you will learn how to build user
interfaces in Quorum. You will start with a "):Strong("Form"):Text(", a ready-made window for
apps that places your controls and sets up the keyboard for you. Later, if
you want controls next to pictures and animation, you can put them inside a "):Strong("Game"):Text(". This page explains both, shows your first Form, and gives you a map
of the rest of the series.")

        Subsection("Goals")
        Paragraph("You have the following goals for this lesson:")
        Goals()
        ListItem("Learn what a graphical user interface is and why it is designed for people,
not for programmers")
        ListItem("Learn how the same app can need to work differently on a computer, in a web
browser and on a phone")
        ListItem("Run a first Form and use it with only the keyboard")
        ListItem("Plan which tutorials in the series to read next")
    end

    action WarmUp
        Section("Warm up")
        Paragraph("Pick an app you use every day. Make a list of every part of the screen you
can interact with: things you can press, type into, pick from, or scroll.
Then imagine that you can't use a mouse or a touch screen, only a keyboard.
Could you still use every part of the app? Which parts would be hardest?")

        Subsection("Vocabulary")
        Paragraph("You will be learning about the following vocabulary words:")
        Table("Vocabulary", "media/userInterface/Overview/Vocabulary.csv")

        Subsection("New Code to Learn")
        Paragraph("You will be using the following new pieces of code:")
        Table("New Code to Learn", "media/userInterface/Overview/Code.csv")

        Subsection("CSTA Standards")
        Paragraph("This lesson covers the following "):Link("CSTA K–12 standards", "https://csteachers.org/pk12standards/view/"):Text(":")
        ComputerScienceStandards2026 computerScience = standards:GetComputerScience2026()
        CoversStandard(computerScience, computerScience:HIGH_SCHOOL_HUMANS_AND_COMPUTING_43)
        CoversStandard(computerScience, computerScience:MIDDLE_SCHOOL_HUMANS_AND_COMPUTING_43)
        CoversStandard(computerScience, computerScience:MIDDLE_SCHOOL_IMPACTS_OF_ALGORITHMS_AND_DESIGN_9)
        CoversStandard(computerScience, computerScience:MIDDLE_SCHOOL_HARDWARE_AND_SOFTWARE_30)
        CoversStandard(computerScience, computerScience:SPECIALTY_1_SOFTWARE_DEVELOPMENT_USER_EXPERIENCE_5)
        StandardsList(computerScience)
    end

    action Explore
        Section("Explore")
        Paragraph("Building a "):Strong("graphical user interface (GUI)"):Text(" is one of the more complex
topics in computer science. It takes practice to program one. It is also
hard because a GUI is used by people, and people may not understand what
the programmer had in mind. Before you write code, it helps to think about
who will use your program and how.")

        DesignedForPeople()
        OneAppManyDevices()
        YourFirstForm()
        FormsFirstGamesLater()
        WhatYouShouldKnowFirst()
        AMapOfTheSeries()
    end

    private action DesignedForPeople
        Subsection("Designed for people")
        Paragraph("A user interface is made for a person, not for a programmer. A button is
made to be pressed. A list is made to be scrolled and picked from. A text
field is made for typing. Over many years, computer scientists have agreed
on how each kind of control should look and act. These agreements are
called "):Strong("conventions"):Text(". For example, people expect a button to do something
when they press it, and they expect "):Key("Tab"):Text(" to move to the next control.
Conventions are studied in a field called "):Link("Human Computer Interaction", "https://en.wikipedia.org/wiki/Human%E2%80%93computer_interaction"):Text(".")

        Paragraph("People use computers in many different ways. Some use a mouse. Some use a
touch screen. Some use only a keyboard. Some are blind and use a "):Strong("screen
reader"):Text(", which reads the screen aloud or sends it to a braille display.
Quorum's controls are built to work with all of these. When you use
Quorum's controls and give each one a clear name, a screen reader can tell
a person what the control is and what it does.")

        Paragraph("Every control in this series works with the keyboard, and with touch on a
phone or tablet. On a touch screen, you tap a control to use it. With a
phone's screen reader on, such as VoiceOver on an iPhone or TalkBack on
Android, you swipe right or left to move between controls and double-tap to
use the one you are on. On a computer, these keys work everywhere:")

        Table("Keys that work everywhere")
        TableHeader():Cell("Key"):Cell("What it does")
        TableRow():Cell("Tab"):Cell("Moves the focus to the next control")
        TableRow():Cell("Shift+Tab"):Cell("Moves the focus to the previous control")
        TableRow():Cell("Space or Enter"):Cell("Presses the button that has the focus")

        Paragraph("The control that keyboard input goes to is said to have the "):Strong("focus"):Text(". A
screen reader reads the control that has the focus. You will learn more in
the "):Link("Focus", "/tutorials/ui/focus.html"):Text(" and "):Link("Accessibility", "/tutorials/ui/accessibility.html"):Text(" tutorials.")
    end

    private action OneAppManyDevices
        Subsection("One app, many devices")
        Paragraph("The same app can run on very different computers. Each one has its own
screen, its own way of taking input, and its own people using it:")

        Table("One app on three kinds of computer")
        TableHeader():Cell(""):Cell("Desktop or laptop"):Cell("Web browser"):Cell("Phone")
        TableRow():Cell("Screen"):Cell("Large, and the window can be resized"):Cell("Whatever size the browser window is"):Cell("Small, and part of it can be covered by a camera cutout or system bars")
        TableRow():Cell("Input"):Cell("Keyboard and mouse"):Cell("Keyboard and mouse, or touch"):Cell("Touch, and sometimes a keyboard")
        TableRow():Cell("Screen reader"):Cell("For example, NVDA on Windows or VoiceOver on a Mac"):Cell("The computer's own screen reader"):Cell("For example, VoiceOver on an iPhone or TalkBack on Android")

        Paragraph("A good interface works for the people who will use it, on the computers they
have. A design that fits a big screen may be too crowded on a phone. A
control that is easy to click with a mouse may be too small to tap.
Before you build an app, ask who will use it and on what.")

        Paragraph("A Form helps with this. It arranges its controls to fit the space it has.
An interface that changes its arrangement to fit the size of the screen or
window is called "):Strong("responsive"):Text(", and this idea is called "):Strong("responsiveness"):Text(". For example, when there is room, a Page puts a label
beside the field it describes. When there isn't, such as on a narrow screen,
it puts the label above the field instead. A Form also keeps its pages away from parts of a
phone's screen that a camera cutout or system bar covers.")
    end

    private action YourFirstForm
        Subsection("Your first Form")
        Paragraph("A "):Strong("Form"):Text(" is a window for an app. Every Form has at least one "):Strong("Page"):Text(",
which is one screen of the app. You add controls to a Page, and the Form
places them, one under another, and works out the order that "):Key("Tab"):Text(" moves
through them.")

        Paragraph("To try it, open Quorum Studio, choose "):Strong("File"):Text(", then "):Strong("New Project"):Text(". Under "):Strong("General"):Text(", choose "):Strong("App"):Text(". Studio makes a project that looks like this
program:")
        CodeExampleFromFile("sources/tutorials/ui/Overview/Main.quorum")

        Paragraph("Run the program. A window opens with a title and one button named "):DoubleQuote():Text("Hi"):DoubleQuote():Text(".
Press "):Key("Tab"):Text(" until the button has the focus, then press "):Key("Space"):Text(". Nothing
happens yet, because the button has no code to run. You will fix that in the "):Link("Behaviors", "/tutorials/ui/behavior.html"):Text(" tutorial.")

        BlockEditor("Main.quorum", "html/sources/tutorials/ui/Overview/Main.quorum", "", true, true)
    end

    private action FormsFirstGamesLater
        Subsection("Forms first, Games later")
        Paragraph("Quorum has two ways to build a user interface. Both use the same controls,
like buttons and lists. They differ in how much Quorum does for you.")

        Table("Forms and controls in a Game")
        TableHeader():Cell(""):Cell("Forms"):Cell("Controls in a Game")
        TableRow():Cell("Good for"):Cell("Apps, like a quiz, a sign-up sheet, or a calculator"):Cell("Games, and screens where controls sit next to graphics and animation")
        TableRow():Cell("Where controls go"):Cell("The Page places them for you"):Cell("You choose a layout, sizes, and positions")
        TableRow():Cell("Focus and keyboard order"):Cell("Set up for you, top to bottom"):Cell("You set it up yourself")
        TableRow():Cell("Starting template in Quorum Studio"):Cell("General, then App"):Cell("General, then Game")
        TableRow():Cell("Where to start"):Cell("Forms"):Cell("Layouts, later in the series")

        Paragraph("Most of this series uses Forms. You can build a complete app without ever
choosing a size or a position. Putting controls in a Game is the advanced
path: you decide where each control goes, how big it is, and which control "):Key("Tab"):Text(" moves to next. The controls are the same, so what you learn with Forms
carries over. When you are ready, the "):Link("Layouts", "/tutorials/ui/layout.html"):Text(", "):Link("Focus", "/tutorials/ui/focus.html"):Text(" and "):Link("Input Sets", "/tutorials/ui/inputSet.html"):Text(" tutorials show how.")
    end

    private action WhatYouShouldKnowFirst
        Subsection("What you should know first")
        Paragraph("This series assumes you are already familiar with the "):Link("online tutorials", "/tutorials/online/starting.html"):Text(", from getting started
through the later lessons. In particular, you will use actions and classes
often, because every behavior you write is a class with an action that runs
when something happens.")
    end

    private action AMapOfTheSeries
        Subsection("A map of the series")
        Paragraph("The tutorials build on each other. Read the first five in order. After
that, read the ones you need.")

        NumberedList()
        ListItem():Strong("Start here:")
        NestedBulletList()
        ListItem():Link("Forms", "/tutorials/ui/forms.html"):Text(": build your first app;")
        ListItem():Link("Behaviors", "/tutorials/ui/behavior.html"):Text(": make things happen;")
        ListItem():Link("Buttons", "/tutorials/ui/button.html"):Text(": the most common control;")
        ListItem():Link("Pages", "/tutorials/ui/pages.html"):Text(": apps with more than one screen;")
        ListItem():Link("Groupings", "/tutorials/ui/groupings.html"):Text(": rows, cards and banners.")
        EndNestedList()
        ListItem():Strong("Typing and choosing:")
        NestedBulletList()
        ListItem():Link("Checkboxes", "/tutorials/ui/checkbox.html"):Text(";")
        ListItem():Link("Radio Buttons", "/tutorials/ui/radioButton.html"):Text(";")
        ListItem():Link("Text Fields", "/tutorials/ui/textField.html"):Text(";")
        ListItem():Link("Text Boxes", "/tutorials/ui/textBox.html"):Text(";")
        ListItem():Link("Combo Boxes", "/tutorials/ui/comboBox.html"):Text(".")
        EndNestedList()
        ListItem():Strong("Numbers, colors and dates:")
        NestedBulletList()
        ListItem():Link("Sliders", "/tutorials/ui/slider.html"):Text(";")
        ListItem():Link("Progress Bars", "/tutorials/ui/progressBar.html"):Text(";")
        ListItem():Link("Color Wells", "/tutorials/ui/colorWell.html"):Text(";")
        ListItem():Link("Calendars and Dates", "/tutorials/ui/calendar.html"):Text(".")
        EndNestedList()
        ListItem():Strong("Showing data:")
        NestedBulletList()
        ListItem():Link("Lists", "/tutorials/ui/list.html"):Text(";")
        ListItem():Link("Trees", "/tutorials/ui/tree.html"):Text(";")
        ListItem():Link("Spreadsheets", "/tutorials/ui/spreadsheet.html"):Text(".")
        EndNestedList()
        ListItem():Strong("Organizing a window:")
        NestedBulletList()
        ListItem():Link("Tab Panes", "/tutorials/ui/tabPane.html"):Text(";")
        ListItem():Link("Menus", "/tutorials/ui/menu.html"):Text(";")
        ListItem():Link("Popup Menus", "/tutorials/ui/popupMenu.html"):Text(";")
        ListItem():Link("Toolbars", "/tutorials/ui/toolbar.html"):Text(";")
        ListItem():Link("Scroll Panes", "/tutorials/ui/scrollPane.html"):Text(".")
        EndNestedList()
        ListItem():Strong("Talking with the user:")
        NestedBulletList()
        ListItem():Link("Dialogs", "/tutorials/ui/dialog.html"):Text(";")
        ListItem():Link("Option Dialogs", "/tutorials/ui/optionDialog.html"):Text(";")
        ListItem():Link("File Choosers", "/tutorials/ui/fileChooser.html"):Text(".")
        EndNestedList()
        ListItem():Strong("Making it work for everyone:")
        NestedBulletList()
        ListItem():Link("Focus", "/tutorials/ui/focus.html"):Text(";")
        ListItem():Link("Layouts", "/tutorials/ui/layout.html"):Text(": choose sizes and positions
yourself;")
        ListItem():Link("Input Sets", "/tutorials/ui/inputSet.html"):Text(";")
        ListItem():Link("Themes and Dark Mode", "/tutorials/ui/themes.html"):Text(";")
        ListItem():Link("Accessibility", "/tutorials/ui/accessibility.html"):Text(".")
        EndNestedList()
    end

    action Engage
        Section("Engage")
        Paragraph("In this activity, you and a partner examine the interfaces you use
every day, and judge how well they work for different people on different
devices. The goal is to learn to think of an app as a set of controls, and to
notice which design choices help people and which leave some out. Each of
you picks one app you use often that also runs on another kind of device,
such as a music player you use on both a phone and a computer. Together, list
every control on the app's main screen and name each one by its kind:
button, text field, list, checkbox and so on.")

        Paragraph("Next, compare the two versions of the app. What is different about the
screen, the controls and the way you use them? Which differences come from
the device, and which seem to be the designers' choices? Write down one
thing each version does well for its users and one thing that leaves some
people out, such as a control you can't reach without a mouse.")

        Paragraph("Finally, run the Form from this page. Take turns using it with only the
keyboard, using "):Key("Tab"):Text(", "):Keys("Shift", "Tab"):Text(", "):Key("Space"):Text(" and "):Key("Enter"):Text(". If you can, turn on
your computer's screen reader and notice what it reports when the button
gets the focus. Then change the button's name and run it again. What
changes in the app, and what changes in what the screen reader reports?")
    end

    action WrapUp
        Section("Wrap up")
        Paragraph("Think about the app you picked in the Engage. Which of its controls follow
conventions you already knew? Which ones surprised you? How might the
designers have made it easier to use for someone who uses only a keyboard,
a screen reader, or a small phone screen?")
    end
end
