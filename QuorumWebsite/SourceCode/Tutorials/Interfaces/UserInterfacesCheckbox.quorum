use Libraries.Web.Page.all
use Libraries.Web.Page.Standards.ComputerScienceStandards2026
use Libraries.Web.Page.Standards.QuorumStandards

/*
    Tutorial: Checkboxes, in the user interface series.
*/
class UserInterfacesCheckbox is QuorumPage
    // The site's sets of standards, built once for every page.
    QuorumStandards standards

    on create
        SetLocation("tutorials/ui/checkbox.html")
        SetShortTitle("Checkboxes")
        SetSectionName("User Interfaces")
    end

    action Setup
        // For search engines and link previews.
        SetDescription("Add checkboxes to a Quorum Form, find out which ones are checked, react when a box changes, and think about who a box that starts checked helps.")

        Title("Checkboxes")

        Overview()
        WarmUp()
        Explore()
        Engage()
        WrapUp()
    end

    action Overview
        Section("Overview")
        Paragraph("A checkbox is a small box that a person can turn on or off. You find them
everywhere: "):DoubleQuote():Text("Remember me,"):DoubleQuote():Text(" "):DoubleQuote():Text("Send me the newsletter,"):DoubleQuote():Text(" or a list of pizza
toppings. Each checkbox answers one yes-or-no question, and a person can check
as many boxes as they want. In this tutorial, you will add checkboxes to a
page, find out which ones are checked, and make your program react the moment
a box changes.")

        Subsection("Goals")
        Paragraph("You have the following goals for this tutorial:")
        Goals()
        ListItem("Add checkboxes to a page and give each one a clear name and description")
        ListItem("Read whether a checkbox is checked with "):Code("GetToggleState")
        ListItem("Use a behavior's "):Code("Run"):Text(" and "):Code("Dispose"):Text(" actions to react when a box is checked
or unchecked")
        ListItem("Explain how a person using a keyboard or a screen reader uses a checkbox,
and how a box that starts checked can affect people")
    end

    action WarmUp
        Section("Warm up")
        Paragraph("Think about the last time you signed up for something online. Which choices
were checkboxes? Were any of them already checked for you? Who do you think
benefits when a box starts out checked: the person signing up or the company?")

        Subsection("Vocabulary")
        Paragraph("You will be learning about the following vocabulary words:")
        Table("Vocabulary", "media/userInterface/Checkbox/Vocabulary.csv")

        Subsection("New Code to Learn")
        Paragraph("You will be using the following new pieces of code:")
        Table("New Code to Learn", "media/userInterface/Checkbox/Code.csv")

        Subsection("CSTA Standards")
        Paragraph("This tutorial covers the following "):Link("CSTA standards", "https://csteachers.org/pk12standards/view/"):Text(":")
        ComputerScienceStandards2026 computerScience = standards:GetComputerScience2026()
        CoversStandard(computerScience, computerScience:HIGH_SCHOOL_HUMANS_AND_COMPUTING_43)
        CoversStandard(computerScience, computerScience:MIDDLE_SCHOOL_HUMANS_AND_COMPUTING_43)
        CoversStandard(computerScience, computerScience:SPECIALTY_1_SOFTWARE_DEVELOPMENT_USER_EXPERIENCE_4)
        CoversStandard(computerScience, computerScience:MIDDLE_SCHOOL_IMPACTS_OF_DATA_SCIENCE_28)
        StandardsList(computerScience)
    end

    action Explore
        Section("Explore")
        WhatIsACheckbox()
        MakingCheckboxes()
        FindingCheckedBoxes()
        ReactingWhenABoxChanges()
        WhoChoseTheDefault()
        WhatAScreenReaderSays()
        GroupingCheckboxes()
        Colors()
    end

    private action WhatIsACheckbox
        Subsection("What is a checkbox?")
        Paragraph("In the "):Link("Buttons", "/tutorials/ui/button.html"):Text(" tutorial, a button did one thing
each time a person pressed it. A checkbox is a special kind of button called a "):Strong("toggle button"):Text(". A toggle button remembers whether it is on or off. Each time
a person activates it, it flips to the other state. This on-or-off value is
called its "):Strong("toggle state"):Text(".")

        Paragraph("In Quorum, the "):Code("Checkbox"):Text(" class comes from the "):Code("ToggleButton"):Text(" class, and "):Code("ToggleButton"):Text(" comes from "):Code("Button"):Text(". That means a checkbox can do everything a
button can do, plus remember its state. The radio buttons in the next tutorial
come from "):Code("ToggleButton"):Text(" too.")

        Paragraph("Checkboxes are independent. Checking one box never unchecks another. If you
want a person to pick exactly one choice, use "):Link("radio buttons", "/tutorials/ui/radioButton.html"):Text(" instead.")
    end

    private action MakingCheckboxes
        Subsection("Making checkboxes on a page")
        Paragraph("A page's "):Code("AddCheckbox"):Text(" action makes a checkbox, adds it to the page and
returns it so that you can change it. The text you pass in is the
checkbox's name. It is the label a person sees beside the box and the name a
screen reader says. Each checkbox gets its own row on the page.")

        Paragraph("The program below makes a pizza order form with three toppings and a button.
Each checkbox also gets a description. A screen reader reads the description
after the name, so it is a good place for a short hint.")
        CodeExampleFromFile("sources/tutorials/ui/Checkbox/Main.quorum")

        Paragraph("The page sets the focus order for you, so you can already move between the
boxes with "):Key("Tab"):Text(" and "):Keys("Shift", "Tab"):Text(". Clicking a box, or pressing "):Key("Space"):Text(" while it
has the focus, checks or unchecks it.")

        Paragraph("On a phone or tablet:")
        BulletList()
        ListItem():Strong("With touch:"):Text(" tap a box to check it. Tap it again to uncheck it.")
        ListItem():Strong("With VoiceOver (iPhone and iPad) or TalkBack (Android) on:"):Text(" swipe
right to move to the next control and left to move to the previous one.
When the screen reader reaches a box, it reads the box's name and whether
it is checked. Double-tap anywhere on the screen to check or uncheck the
box it is on.")
    end

    private action FindingCheckedBoxes
        Subsection("Finding out which boxes are checked")
        Paragraph("A checkbox's "):Code("GetToggleState"):Text(" action returns "):Code("true"):Text(" if the box is checked. The "):DoubleQuote():Text("Place order"):DoubleQuote():Text(" button uses this to list the toppings. Make a new class in a
file named "):Code("OrderBehavior.quorum"):Text(". It comes from "):Code("FormBehavior"):Text(", which gives it
the "):Code("GetPage"):Text(" action, so it can find each checkbox by name with "):Code("GetCheckbox"):Text(".")
        CodeExampleFromFile("sources/tutorials/ui/Checkbox/OrderBehavior.quorum")

        Paragraph("Run the program, check two toppings and press "):DoubleQuote():Text("Place order."):DoubleQuote():Text(" The label below
the button lists the two toppings you picked. A screen reader user can press "):Key("Tab"):Text(" once more to reach it.")

        BlockEditorFile("OrderBehavior.quorum", "html/sources/tutorials/ui/Checkbox/OrderBehavior.quorum")
        BlockEditor("Main.quorum", "html/sources/tutorials/ui/Checkbox/Main.quorum", "", true, true)
    end

    private action ReactingWhenABoxChanges
        Subsection("Reacting when a box changes")
        Paragraph("Sometimes a program should react the moment a box changes, not when another
button is pressed. A checkbox can have a behavior, just like a button, but it
uses two of the behavior's actions:")
        BulletList()
        ListItem("when the box is "):Strong("checked"):Text(", the checkbox calls the behavior's "):Code("Run"):Text(" action;")
        ListItem("when the box is "):Strong("unchecked"):Text(", it calls the behavior's "):Code("Dispose"):Text(" action.")

        Paragraph("Make a class in a file named "):Code("ReportBehavior.quorum"):Text(". "):Code("Run"):Text(" gets the checkbox
from the event and saves its name, so that "):Code("Dispose"):Text(" can use the name later.")
        CodeExampleFromFile("sources/tutorials/ui/Checkbox/ReportBehavior.quorum")

        Paragraph("Now give the behavior to a checkbox. This program adds one setting and starts
it checked with "):Code("SetToggleState(true)"):Text(":")
        CodeExampleFromFile("sources/tutorials/ui/Checkbox/Main2.quorum")

        Paragraph("Calling "):Code("SetToggleState(true)"):Text(" after "):Code("SetBehavior"):Text(" runs the behavior right
away, so the program starts by writing that the newsletter is on. If you set
the state before you set the behavior, nothing is written at the start. Try
both.")
    end

    private action WhoChoseTheDefault
        Subsection("Who chose the default?")
        Paragraph("The value a control starts with is called its "):Strong("default"):Text(". Most people never
change a default, so the person who sets it makes a choice for many other
people. A newsletter box that starts checked signs up everyone who doesn't
notice it. That may be good for the company and bad for the person.")

        Paragraph("When you write a form, start each box unchecked unless checking it is clearly
what the person wants. If a box must start checked, say so in its name or
description, so a screen reader user hears it too.")
    end

    private action WhatAScreenReaderSays
        Subsection("What a screen reader says")
        Paragraph("A screen reader says a checkbox's name, that it is a checkbox, and whether it
is checked. Then it may read the description. The exact words depend on the
screen reader. When the person presses "):Key("Space"):Text(", the screen reader says the new
state.")

        Paragraph("This is why the name matters. A box named "):DoubleQuote():Text("Option 1"):DoubleQuote():Text(" tells a screen reader
user nothing. A box named "):DoubleQuote():Text("Extra cheese"):DoubleQuote():Text(" says exactly what it does.")
    end

    private action GroupingCheckboxes
        Subsection("Grouping checkboxes")
        Paragraph("A long list of checkboxes is easier to read with a heading. As in the "):Link("Groupings", "/tutorials/ui/groupings.html"):Text(" tutorial, put them in a "):Strong("grouping"):Text(" with a
title, and the page draws them together, under the title, as one card:")
        CodeExampleFromFile("sources/tutorials/ui/Checkbox/Main3.quorum")

        Paragraph("The checkboxes in the grouping are still independent: checking one never
unchecks another. "):Code("page:GetCheckbox"):Text(" finds them inside the grouping too, so "):Code("OrderBehavior"):Text(" works without changes. This is the same kind of card you
made for the Pet Sitter app.")
    end

    private action Colors
        Subsection("Colors")
        Paragraph("The colors of the box and the checkmark come from the current theme, so they
match the rest of the program and change in dark mode. You don't set them on
the checkbox itself. The "):Link("Themes and Dark Mode", "/tutorials/ui/themes.html"):Text("
tutorial shows how to change them.")
    end

    action Engage
        Section("Engage")
        Paragraph("In this activity, you build a sign-up form for a made-up school club. The
goal is to use checkboxes for choices where more than one answer can be
picked, to choose defaults carefully, and to give clear feedback when the
form is submitted. The form needs at least four checkboxes, for example one
for each day a person can meet, and a "):DoubleQuote():Text("Sign up"):DoubleQuote():Text(" button. Give every checkbox a
clear name and a description. When the button is pressed, show the days
that were checked in a label. If no days were checked, show a message that
asks the person to pick at least one.")

        Paragraph("Add one more checkbox: "):DoubleQuote():Text("Share my email with other club members."):DoubleQuote():Text(" Decide
whether it should start checked or unchecked. To decide, think about two
made-up members: Sam wants to meet other members outside the club, and Priya
doesn't want her email shared with people she hasn't met. Write your choice
and your reasons in a comment in your code. Who is helped and who could be
harmed by each choice?")

        Paragraph("When it works, test it with this self-check list, using only the keyboard: "):Key("Tab"):Text(", "):Keys("Shift", "Tab"):Text(" and "):Key("Space"):Text(".")
        BulletList()
        ListItem("Can you reach every checkbox and the button, in the order they appear?")
        ListItem("Does "):Key("Space"):Text(" check and uncheck each box?")
        ListItem("Would each name make sense if it were the only thing you knew about the box?")
        ListItem("Does the label show the right days, and the message when no day is checked?")
        ListItem("If you have a screen reader, turn it on: does it report each box's name and
whether it is checked?")

        Paragraph("Fix anything that fails, then pick one name or description and rewrite it so
it is clearer.")
    end

    action WrapUp
        Section("Wrap up")
        Paragraph("A checkbox is a toggle button that stores one yes-or-no answer. You can read
its state with "):Code("GetToggleState"):Text(" when you need it, or react right away with a
behavior's "):Code("Run"):Text(" and "):Code("Dispose"):Text(" actions. Think back to the warm up: when you
write a form, which boxes should start checked, and why?")
    end
end
