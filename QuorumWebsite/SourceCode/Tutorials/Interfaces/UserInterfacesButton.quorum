use Libraries.Web.Page.all
use Libraries.Web.Page.Standards.ComputerScienceStandards2026
use Libraries.Web.Page.Standards.QuorumStandards

/*
    Tutorial: Buttons, the fourth page of the user interface series.
*/
class UserInterfacesButton is QuorumPage
    // The site's sets of standards, built once for every page.
    QuorumStandards standards

    on create
        SetLocation("tutorials/ui/button.html")
        SetShortTitle("Buttons")
        SetSectionName("User Interfaces")
    end

    action Setup
        // For search engines and link previews.
        SetDescription("Add buttons to a Quorum Form, share one behavior among many buttons, change a button's name, make picture buttons, and give every button a clear name.")

        Title("Buttons")

        Overview()
        WarmUp()
        Explore()
        Engage()
        WrapUp()
    end

    action Overview
        Section("Overview")
        Paragraph("A "):Strong("button"):Text(" is the most common control in a user interface. A person
presses it, and something happens. In this tutorial, you will add buttons
to a page, connect them to behaviors, let one behavior serve many buttons,
change what a button says while the program runs, and make buttons that
show a picture. Along the way, you will make sure
every button works with a keyboard and a screen reader.")

        Subsection("Goals")
        Paragraph("You have the following goals for this lesson:")
        Goals()
        ListItem("Add buttons to a page and run code when they are pressed")
        ListItem("Use one behavior for many buttons by checking which button was pressed")
        ListItem("Change a button's name while a program runs, and make picture buttons")
        ListItem("Give every button a clear name and description for screen reader users")
    end

    action WarmUp
        Section("Warm up")
        Paragraph("Find the buttons in an app or website you use. Read only their names,
ignoring everything around them. Can you tell what each one does?
Find one button whose name is clear on its own and one whose name only
makes sense alongside the rest of the screen.")

        Subsection("Vocabulary")
        Paragraph("You will be learning about the following vocabulary words:")
        Table("Vocabulary", "media/userInterface/Button/Vocabulary.csv")

        Subsection("New Code to Learn")
        Paragraph("You will be using the following new pieces of code:")
        Table("New Code to Learn", "media/userInterface/Button/Code.csv")

        Subsection("CSTA Standards")
        Paragraph("This lesson covers the following "):Link("CSTA K–12 standards", "https://csteachers.org/pk12standards/view/"):Text(":")
        ComputerScienceStandards2026 computerScience = standards:GetComputerScience2026()
        CoversStandard(computerScience, computerScience:HIGH_SCHOOL_TESTING_AND_REFINING_19)
        CoversStandard(computerScience, computerScience:MIDDLE_SCHOOL_TESTING_AND_REFINING_20)
        StandardsList(computerScience)
    end

    action Explore
        Section("Explore")
        Paragraph("Buttons are everywhere: "):DoubleQuote():Text("Send"):DoubleQuote():Text(", "):DoubleQuote():Text("Next"):DoubleQuote():Text(", "):DoubleQuote():Text("Buy"):DoubleQuote():Text(", "):DoubleQuote():Text("Play"):DoubleQuote():Text(". Because people use
them so often, they expect every button to work the same way. A button
should look like it can be pressed. Its name should say what it does,
usually with a verb, like "):DoubleQuote():Text("Save"):DoubleQuote():Text(" or "):DoubleQuote():Text("Play Again"):DoubleQuote():Text(". And it should work no
matter how a person reaches it.")

        Paragraph("In Quorum, a person can press a button in any of these ways:")

        Table("Ways to press a button")
        TableHeader():Cell("How"):Cell("What to do")
        TableRow():Cell("Mouse"):Cell("Click the button")
        TableRow():Cell("Touch screen"):Cell("Tap the button")
        TableRowWriter keyboard = TableRow()
        keyboard:Cell("Keyboard")
        keyboard:Cell():Text("Press "):Key("Tab"):Text(" until the button has the focus, then press "):Key("Space"):Text(" or "):Key("Enter")

        Paragraph("When a button gets the focus, a screen reader says the button's "):Strong("name"):Text(",
and that it is a button. It may also read the button's "):Strong("description"):Text(".
That is why every button in this tutorial gets a clear name and a
description when the name alone isn't enough.")

        AButtonOnAPage()
        OneBehaviorForManyButtons()
        ChangingWhatAButtonSays()
        ButtonsWithPictures()
        MakingButtonsEveryoneCanUse()
    end

    private action AButtonOnAPage
        Subsection("A button on a page")
        Paragraph("You met this pattern in "):Link("Forms", "/tutorials/ui/forms.html"):Text(" and "):Link("Behaviors", "/tutorials/ui/behavior.html"):Text(". "):Code("page:AddButton"):Text(" makes the button,
places it on the page, and gives it back to you. "):Code("SetBehavior(me)"):Text(" tells the
button to run this class's "):Code("Run"):Text(" action when it is pressed. Make a project
with "):Strong("General"):Text(", then "):Strong("App"):Text(", and replace "):Code("Main.quorum"):Text(" with:")
        CodeExampleFromFile("sources/tutorials/ui/Button/Main.quorum")

        Paragraph("Run it. Press "):Key("Tab"):Text(" until you reach the button, then press "):Key("Space"):Text(" or "):Key("Enter"):Text(". The label below the button changes to "):DoubleQuote():Text("Hello world!"):DoubleQuote():Text(". Press "):Key("Tab"):Text("
once more to move to the label. A screen reader reads its new text.")

        Paragraph("Notice what you didn't have to do. The page chose the button's size and
place, and it put the button in the "):Key("Tab"):Text(" order. You never set a size, a
position, or the focus yourself.")
    end

    private action OneBehaviorForManyButtons
        Subsection("One behavior for many buttons")
        Paragraph("An app often has several buttons that do similar things. Instead of writing
a behavior for each, you can write one and check which button was pressed. "):Code("event:GetItem()"):Text(" gives you the item that was pressed. It comes back as an "):Code("Item"):Text(", so you "):Strong("cast"):Text(" it to a "):Code("Button"):Text(", then read its name.")
        CodeExampleFromFile("sources/tutorials/ui/Button/Main2.quorum")

        Paragraph("All three buttons run the same "):Code("Run"):Text(" action. The text in the label depends
on which button was pressed.")

        Paragraph("On a page, each button gets its own row. The "):Link("Groupings", "/tutorials/ui/groupings.html"):Text(" tutorial, after Pages, shows how to put buttons
side by side.")
    end

    private action ChangingWhatAButtonSays
        Subsection("Changing what a button says")
        Paragraph():Code("SetName"):Text(" changes the text on a button at any time, not just when you make
it. Because the name is also what a screen reader says, the new name is
read the next time the button gets the focus. This program counts how many
times its button has been pressed. Add a file named "):Code("CountBehavior.quorum"):Text(":")
        CodeExampleFromFile("sources/tutorials/ui/Button/CountBehavior.quorum")

        Paragraph("And use it in "):Code("Main.quorum"):Text(":")
        CodeExampleFromFile("sources/tutorials/ui/Button/Main3.quorum")

        Paragraph("The variable "):Code("count"):Text(" belongs to the behavior object, so it keeps its value
between presses.")
    end

    private action ButtonsWithPictures
        Subsection("Buttons with pictures")
        Paragraph("A button can show a picture. Put an image file, such as a PNG, in a folder
named "):Code("Images"):Text(" inside your project folder. Then give "):Code("AddButton"):Text(" both a
name and the image's path:")
        CodeExampleFromFile("sources/tutorials/ui/Button/Main4.quorum")

        Paragraph("A picture button "):Strong("still needs a name"):Text(". A screen reader can't describe the
picture, so the name is the only way a screen reader user knows what the
button does. Name it for what it does ("):DoubleQuote():Text("Add to favorites"):DoubleQuote():Text("), not for what it
looks like ("):DoubleQuote():Text("Star"):DoubleQuote():Text(").")

        BlockEditor("Main.quorum", "html/sources/tutorials/ui/Button/Main4.quorum", "", true, true)
    end

    private action MakingButtonsEveryoneCanUse
        Subsection("Making buttons everyone can use")
        Paragraph("Before you share a program with buttons, check each one:")

        BulletList()
        ListItem():Strong("Name:"):Text(" does it say what the button does, even with nothing else on the
screen? Use a verb: "):DoubleQuote():Text("Save"):DoubleQuote():Text(", not "):DoubleQuote():Text("OK"):DoubleQuote():Text(" or "):DoubleQuote():Text("Button 1"):DoubleQuote():Text(".")
        ListItem():Strong("Description:"):Text(" if the name is short, does the description explain the
result?")
        ListItem():Strong("Keyboard:"):Text(" can you reach it with "):Key("Tab"):Text(" and press it with "):Key("Space"):Text(" or "):Key("Enter"):Text("?")
        ListItem():Strong("Feedback:"):Text(" when the button is pressed, can a person tell something
happened, without seeing the screen? Changing a label, which a screen
reader user can reach with "):Key("Tab"):Text(", is one way.")
    end

    action Engage
        Section("Engage")
        Paragraph("In this activity, you and a partner build a small message board: an app
with at least four buttons that each show a different word or phrase. The
goal is to practice creating buttons, sharing one behavior between them,
and giving each button a name and description that make sense. Use one
behavior for all the buttons. When a button is pressed, show its message in
a label on the page. Give every button a name and a description. Decide
together what order the buttons should go in, and write down why.")

        Paragraph("When it works, swap with another pair. Test their message board with only
the keyboard, then with a screen reader if you can. For each button, write
down whether its name made sense on its own. Give the other pair your
notes, and use the notes you get back to improve at least one of your own
buttons.")
    end

    action WrapUp
        Section("Wrap up")
        Paragraph("The name of a button does two jobs: it is the text people see, and it is
what a screen reader says. When might those two jobs pull in different
directions? How would you choose a name that works for both?")
    end
end
