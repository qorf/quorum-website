use Libraries.Web.Page.all
use Libraries.Web.Page.Standards.ComputerScienceStandards2026
use Libraries.Web.Page.Standards.QuorumStandards

/*
    Tutorial: Groupings, rows, cards and banners, in the user interface
    series.
*/
class UserInterfacesGroupings is QuorumPage
    // The site's sets of standards, built once for every page.
    QuorumStandards standards

    on create
        SetLocation("tutorials/ui/groupings.html")
        SetShortTitle("Groupings")
        SetSectionName("User Interfaces")
    end

    action Setup
        // For search engines and link previews.
        SetDescription("Use groupings in a Quorum Form to put buttons side by side, make titled cards under a banner, add a footer of buttons, and learn how designers break a screen into parts.")

        Title("Groupings")

        Overview()
        WarmUp()
        Explore()
        Engage()
        WrapUp()
    end

    action Overview
        Section("Overview")
        Paragraph("As a Page grows, a long column of controls gets hard to follow. Paper forms
solve this by putting related questions in a box, such as the parts of an
address. In a Form, a "):Strong("grouping"):Text(" does the same job. In this tutorial, you
will use groupings to put buttons side by side, to make titled sections
called "):Strong("cards"):Text(", and to make a row of buttons along the bottom of a Page.
You will also find out how people who design screens for a living decide
what belongs together.")

        Subsection("Goals")
        Paragraph("You have the following goals for this lesson:")
        Goals()
        ListItem("Put buttons side by side in a grouping with no title")
        ListItem("Organize a Page into cards with titled groupings, under a banner")
        ListItem("Add a footer of buttons to the bottom of a Page")
        ListItem("Describe how web developers and digital designers break a screen into parts and work as a team")
    end

    action WarmUp
        Section("Warm up")
        Paragraph("Think of a screen you use often, such as a music app or a school website.
Which parts of it belong together? Pick two parts that sit in the same box
or row, and say why someone might have put them there.")

        Subsection("Vocabulary")
        Paragraph("You will be learning about the following vocabulary words:")
        Table("Vocabulary", "media/userInterface/Groupings/Vocabulary.csv")

        Subsection("New Code to Learn")
        Paragraph("You will be using the following new pieces of code:")
        Table("New Code to Learn", "media/userInterface/Groupings/Code.csv")

        Subsection("CSTA Standards")
        Paragraph("This lesson covers the following "):Link("CSTA K–12 standards", "https://csteachers.org/pk12standards/view/"):Text(":")
        ComputerScienceStandards2026 computerScience = standards:GetComputerScience2026()
        CoversStandard(computerScience, computerScience:HIGH_SCHOOL_CAREER_EXPLORATION_45)
        CoversStandard(computerScience, computerScience:HIGH_SCHOOL_IMPACTS_OF_ALGORITHMS_AND_DESIGN_9)
        CoversStandard(computerScience, computerScience:MIDDLE_SCHOOL_CAREER_EXPLORATION_44)
        StandardsList(computerScience)
    end

    action Explore
        Section("Explore")
        Paragraph("In "):Link("Forms", "/tutorials/ui/forms.html"):Text(", you learned that a Page puts each
control in its own row, from top to bottom. A grouping changes that for the
controls inside it. "):Code("page:AddGrouping(name)"):Text(" adds a grouping to the Page and
gives it back to you. Then you add controls to the grouping, not the Page,
with the same actions you already know, such as "):Code("AddLabel"):Text(", "):Code("AddTextField"):Text(" and "):Code("AddButton"):Text(".")

        Paragraph("How a grouping is arranged depends on what you give it:")
        BulletList()
        ListItem():Strong("With no title"):Text(", a grouping puts its controls side by side in one row,
each with an equal share of the row's width.")
        ListItem():Strong("With a title"):Text(", set with "):Code("SetTitle"):Text(", a grouping is drawn as a "):Strong("card"):Text(":
a box around its controls, with the title at the top.")
        ListItem():Strong("With only buttons, no title, and placed at the bottom"):Text(" with "):Code("PositionFromBottom"):Text(", a grouping becomes the Page's "):Strong("footer"):Text(": a row of
buttons along the bottom, with a line above it.")

        ButtonsSideBySide()
        CardsFootersAndBanners()
        GroupingIsAJobSkill()
    end

    private action ButtonsSideBySide
        Subsection("Buttons side by side")
        Paragraph("Here is the color picker from the "):Link("Buttons", "/tutorials/ui/button.html"):Text("
tutorial, with its three buttons in a grouping with no title:")
        CodeExampleFromFile("sources/tutorials/ui/Groupings/Main.quorum")

        Paragraph("Only "):Code("Main"):Text(" changed. The Page's "):Code("AddGrouping"):Text(" action makes the grouping,
and the buttons are added with the grouping's own "):Code("AddButton"):Text(" action. Now
the three buttons sit in one row. "):Key("Tab"):Text(" still moves through them in order,
left to right, and then on to the label.")
    end

    private action CardsFootersAndBanners
        text dq = ""
        dq = dq:GetDoubleQuote()

        Subsection("Cards, footers and banners")
        Paragraph("You met banners in the "):Link("Forms", "/tutorials/ui/forms.html"):Text(" tutorial. A banner
is a special grouping for the top of a Page. When a card comes right after
a banner at the top of a Page, the card rises a little into the banner, so
the two read as one header.")

        Paragraph("This Page, from a made-up pet-sitting app, uses a banner, two cards and a
footer:")
        CodeExampleFromFile("sources/tutorials/ui/Groupings/Main2.quorum")

        BlockEditor("Main.quorum", "html/sources/tutorials/ui/Groupings/Main2.quorum", "", true, true)

        Paragraph():Code("SetLeadingButtonCount(1)"):Text(" puts the footer's first button, Back, on the
left, apart from the others. That is where a Back button usually goes. The
buttons don't do anything yet. You could give them a behavior, as in "):Link("Pages", "/tutorials/ui/pages.html"):Text(", to move between Pages.")

        Paragraph("A few things to notice:")
        BulletList()
        ListItem():Strong("Find controls the same way."):Text(" "):Code("page:GetTextField(" + dq + "Pet's name" + dq + ")"):Text(" finds
the text field even though it is inside a grouping. The Page searches inside
its groupings for you.")
        ListItem():Strong("Tab order follows the order you add things."):Text(" "):Key("Tab"):Text(" goes through the
banner, then each card, then the footer. The footer was added last, so it
comes last, which matches where it sits on the Page. If you added it
first, it would still be placed at the bottom, but "):Key("Tab"):Text(" would reach it
first. Add things in the order a person reads them.")
        ListItem():Strong("Titles take the focus."):Text(" The banner's title and each card's title can
take the focus, so a screen reader user reaches "):DoubleQuote():Text("Your pet"):DoubleQuote():Text(" before the
fields in that card, and knows what the fields are about.")

        Paragraph("A grouping can also arrange its controls in its own way, using a layout.
That comes much later, in the "):Link("Layouts", "/tutorials/ui/layout.html"):Text("
tutorial. Some controls always go in a grouping; you will meet one in "):Link("Radio Buttons", "/tutorials/ui/radioButton.html"):Text(".")
    end

    private action GroupingIsAJobSkill
        Subsection("Grouping is a job skill")
        Paragraph("Deciding what goes in each card is a kind of "):Strong("decomposition"):Text(": breaking a
big screen into smaller parts, each about one thing. It is part of real
jobs. The US Bureau of Labor Statistics describes digital designers as
people who develop and test the layout, functions and navigation of
websites and interfaces. The duties it lists for web developers and digital
designers include meeting with clients about what a site needs, working
with other team members to decide what information a site will contain,
working with graphic designers on its layout, and making prototypes and
mockups
("):Link("source", "https://www.bls.gov/ooh/computer-and-information-technology/web-developers.htm"):Text(").")

        Paragraph("Notice that much of this is teamwork. A client knows what the site is for,
other team members decide what information it holds, and designers decide
how it is laid out. Each person brings a different view of the same
problem. Think about the Pet Sitter page: who might know best what belongs
in the "):DoubleQuote():Text("Care"):DoubleQuote():Text(" card, a pet owner, a pet sitter or a programmer? Why might a
team that includes all three build a better Page than any one of them
alone?")
    end

    action Engage
        Section("Engage")
        Paragraph("The goal of this activity is to build a small Page with one card and a row
of buttons. Choose a made-up topic, such as a book club, a bake sale or a
school play. First, on paper, list everything the Page should show. Circle
the items that belong together in one card, and pick three short actions,
such as "):DoubleQuote():Text("Join"):DoubleQuote():Text(", "):DoubleQuote():Text("Remind me"):DoubleQuote():Text(" and "):DoubleQuote():Text("Share"):DoubleQuote():Text(", for a row of buttons.")

        Paragraph("Now build it. Your Page needs:")
        BulletList()
        ListItem("a banner with a title;")
        ListItem("one grouping with a title (a card) that holds at least two labels;")
        ListItem("one grouping with no title that holds three buttons side by side.")

        Paragraph("Give each button a description. Run your Page and move through it with only "):Key("Tab"):Text(". Check that you reach the banner, the card's title, the labels in the
card, and then the buttons, in that order. If you have time, give the
buttons a behavior that changes a label, as in the color picker.")

        Paragraph("Last, write one sentence explaining why you put the items in your card
together.")
    end

    action WrapUp
        Section("Wrap up")
        Paragraph("Designers and developers break screens into parts before they build them.
Think of a job you might like someday, in or out of computing. What is one
big problem in that job that people solve by breaking it into smaller
parts? Who would you need on your team to solve it well?")
    end
end
