use Libraries.Web.Page.all
use Libraries.Web.Page.Standards.ComputerScienceStandards2026
use Libraries.Web.Page.Standards.QuorumStandards

/*
    Tutorial: Forms, the second page of the user interface series.
*/
class UserInterfacesForms is QuorumPage
    // The site's sets of standards, built once for every page.
    QuorumStandards standards
    // A double quote, for code that holds one.
    text dq = ""

    on create
        SetLocation("tutorials/ui/forms.html")
        SetShortTitle("Forms")
        SetSectionName("User Interfaces")
    end

    action Setup
        dq = dq:GetDoubleQuote()

        // For search engines and link previews.
        SetDescription("Build your first app with a Quorum Form: add controls to a Page, respond to a button press, and choose dark mode and a window size.")

        Title("Forms")

        Overview()
        WarmUp()
        Explore()
        Engage()
        WrapUp()
    end

    action Overview
        Section("Overview")
        Paragraph("A "):Strong("Form"):Text(" is Quorum's quickest way to build an app. It opens a window,
places your controls for you, and sets up the keyboard order so that
everyone can use the app. Every Form holds one or more "):Strong("Pages"):Text(". A Page is
one screen of the app, like a home screen or a settings screen. In this
tutorial, you will build an app with one Page: a banner, a label, a text
field and a button that greets the person who typed their name. The "):Link("Pages", "/tutorials/ui/pages.html"):Text(" tutorial, after Behaviors and Buttons,
adds more Pages.")

        Subsection("Goals")
        Paragraph("You have the following goals for this lesson:")
        Goals()
        ListItem("Create a Form and add controls to its main Page")
        ListItem("Respond to a button press with a "):Code("FormBehavior")
        ListItem("Read what a person typed and show a result")
        ListItem("Choose light or dark mode and a window size")
    end

    action WarmUp
        Section("Warm up")
        Paragraph("Think of a sign-in screen or a search screen you use often. Where is each
part of it: the heading, the places to type, the buttons? If you could only
use the "):Key("Tab"):Text(" key to move around it, in what order would you want to reach
each part?")

        Subsection("Vocabulary")
        Paragraph("You will be learning about the following vocabulary words:")
        Table("Vocabulary", "media/userInterface/Forms/Vocabulary.csv")

        Subsection("New Code to Learn")
        Paragraph("You will be using the following new pieces of code:")
        Table("New Code to Learn", "media/userInterface/Forms/Code.csv")

        Subsection("CSTA Standards")
        Paragraph("This lesson covers the following "):Link("CSTA K–12 standards", "https://csteachers.org/pk12standards/view/"):Text(":")
        ComputerScienceStandards2026 computerScience = standards:GetComputerScience2026()
        CoversStandard(computerScience, computerScience:HIGH_SCHOOL_PROGRAM_DEVELOPMENT_13)
        CoversStandard(computerScience, computerScience:MIDDLE_SCHOOL_PROGRAM_DEVELOPMENT_13)
        CoversStandard(computerScience, computerScience:MIDDLE_SCHOOL_TESTING_AND_REFINING_20)
        CoversStandard(computerScience, computerScience:HIGH_SCHOOL_TESTING_AND_REFINING_20)
        StandardsList(computerScience)
    end

    action Explore
        Section("Explore")
        Paragraph("The "):Link("Overview", "/tutorials/ui/overview.html"):Text(" introduced two ways to build an
interface. This tutorial covers the first: Forms. A Form does three jobs for
you. It opens a window. It places each control in a row below the one
before it. And it works out the keyboard order, so "):Key("Tab"):Text(" moves through the
controls from top to bottom.")

        YourFirstForm()
        WhatYouCanPutOnAPage()
        BuildingAGreetingApp()
        HowAPageArrangesControls()
        LightModeDarkModeAndWindowSize()
        AccessibilityInForms()
    end

    private action YourFirstForm
        Subsection("Your first Form")
        Paragraph("In Quorum Studio, make a new project. Under "):Strong("General"):Text(", choose "):Strong("App"):Text(".
Studio gives you this program:")
        CodeExampleFromFile("sources/tutorials/ui/Forms/Main.quorum")

        Paragraph("Here is what each line does:")
        BulletList()
        ListItem():Code("Form form"):Text(" makes the Form. A new Form already has one Page, called the "):Strong("main Page"):Text(".")
        ListItem():Code("form:GetMainPage()"):Text(" gives you that Page, so you can add things to it.")
        ListItem():Code("page:AddButton(" + dq + "Hi" + dq + ")"):Text(" adds a button. Its name, "):DoubleQuote():Text("Hi"):DoubleQuote():Text(", is the text on the
button. It is also what a screen reader says.")
        ListItem():Code("form:Display()"):Text(" opens the window and shows the main Page.")

        Paragraph("Controls always go on a Page, not on the Form itself. Most Form programs
have these same lines: make a Form, get its main Page, add controls, and
call "):Code("Display"):Text(". The greeting app later in this tutorial puts the same
lines inside a class called "):Code("Main"):Text(", because it needs a class.")
    end

    private action WhatYouCanPutOnAPage
        Subsection("What you can put on a Page")
        Paragraph("A Page has an action for each kind of control. Each one takes a name, adds
the control below the last one, and gives the control back to you, so you
can change it. Each control has its own tutorial later in this series.")

        Table("Actions that add controls to a Page")
        TableHeader():Cell("Action"):Cell("Adds"):Cell("Tutorial")
        TableRowWriter row = TableRow()
        row:Cell():Code("AddBanner(title)"):Text(" or "):Code("AddBanner(title, label)")
        row:Cell("A large heading")
        row:Cell():Link("Groupings", "/tutorials/ui/groupings.html")
        row = TableRow()
        row:Cell():Code("AddLabel(name)"):Text(" or "):Code("AddLabel(name, text)")
        row:Cell("Text to read")
        row:Cell("This page")
        row = TableRow()
        row:Cell():Code("AddButton(name)"):Text(" or "):Code("AddButton(name, imageFile)")
        row:Cell("A button, with words or a picture")
        row:Cell():Link("Buttons", "/tutorials/ui/button.html")
        row = TableRow()
        row:Cell():Code("AddCheckbox(name)")
        row:Cell("A box that can be checked or not")
        row:Cell():Link("Checkboxes", "/tutorials/ui/checkbox.html")
        row = TableRow()
        row:Cell():Code("AddGrouping(name)")
        row:Cell("A group of controls, such as radio buttons")
        row:Cell():Link("Groupings", "/tutorials/ui/groupings.html"):Text(", "):Link("Radio Buttons", "/tutorials/ui/radioButton.html")
        row = TableRow()
        row:Cell():Code("AddTextField(name)")
        row:Cell("A one-line place to type")
        row:Cell():Link("Text Fields", "/tutorials/ui/textField.html")
        row = TableRow()
        row:Cell():Code("AddTextBox(name)")
        row:Cell("A place to type many lines")
        row:Cell():Link("Text Boxes", "/tutorials/ui/textBox.html")
        row = TableRow()
        row:Cell():Code("AddComboBox(name)"):Text(" or "):Code("AddComboBox(name, choices)")
        row:Cell("A text field with a list of choices that opens below it")
        row:Cell():Link("Combo Boxes", "/tutorials/ui/comboBox.html")
        row = TableRow()
        row:Cell():Code("AddSlider(name)"):Text(" or "):Code("AddSlider(name, minimum, maximum)")
        row:Cell("A slider for choosing a number")
        row:Cell():Link("Sliders", "/tutorials/ui/slider.html")
        row = TableRow()
        row:Cell():Code("AddSliderField(name)"):Text(" or "):Code("AddSliderField(name, minimum, maximum)")
        row:Cell("A slider with a box beside it for typing the number")
        row:Cell():Link("Sliders", "/tutorials/ui/slider.html")
        row = TableRow()
        row:Cell():Code("AddProgressBar(name)"):Text(" or "):Code("AddProgressBar(name, minimum, maximum)")
        row:Cell("A bar that shows how far along something is")
        row:Cell():Link("Progress Bars", "/tutorials/ui/progressBar.html")
        row = TableRow()
        row:Cell():Code("AddColorWell(name)"):Text(" or "):Code("AddColorWell(name, color)")
        row:Cell("A button showing a color, which opens a color picker")
        row:Cell():Link("Color Wells", "/tutorials/ui/colorWell.html")
        row = TableRow()
        row:Cell():Code("AddCalendar(name)")
        row:Cell("A month to choose a day from")
        row:Cell():Link("Calendars and Dates", "/tutorials/ui/calendar.html")
        row = TableRow()
        row:Cell():Code("AddDateField(name)")
        row:Cell("A text field for a date, with a button that opens a calendar")
        row:Cell():Link("Calendars and Dates", "/tutorials/ui/calendar.html")
        row = TableRow()
        row:Cell():Code("AddList(name)")
        row:Cell("A list to pick from")
        row:Cell():Link("Lists", "/tutorials/ui/list.html")
        row = TableRow()
        row:Cell():Code("AddTree(name)")
        row:Cell("A list with items inside items")
        row:Cell():Link("Trees", "/tutorials/ui/tree.html")
        row = TableRow()
        row:Cell():Code("AddSpreadsheet(name)"):Text(" or "):Code("AddSpreadsheet(name, file)")
        row:Cell("A grid of cells, empty or from a CSV file")
        row:Cell():Link("Spreadsheets", "/tutorials/ui/spreadsheet.html")
        row = TableRow()
        row:Cell():Code("AddIcon(name, imageFile)")
        row:Cell("A picture")
        row:Cell("This page")

        Paragraph("Some controls, such as tab panes, have no "):Code("Add"):Text(" action of their own. Later
tutorials put them on a Page with "):Code("page:Add(control)"):Text(", and the Page lays
them out like the rest.")

        Paragraph("The "):Strong("name"):Text(" you give a control matters. You use it to find the control
again later, and a screen reader uses it to tell a person what the control
is. So pick names a person would understand, like "):DoubleQuote():Text("Your name"):DoubleQuote():Text(", not "):DoubleQuote():Text("field1"):DoubleQuote():Text(".")
    end

    private action BuildingAGreetingApp
        Subsection("Building a greeting app")
        Paragraph("Now you will make an app that asks for a name and says hello. It needs to "):Strong("do"):Text(" something when the button is pressed. Code that runs when something
happens is called a "):Strong("behavior"):Text(". For Forms, Quorum has a special behavior
class called "):Code("FormBehavior"):Text(". Here, the "):Code("Main"):Text(" class itself is a "):Code("FormBehavior"):Text(", so it can be the button's behavior. That is what "):Code("button:SetBehavior(me)"):Text(" means: when this button is pressed, run the "):Code("Run"):Text("
action in this class. The "):Link("Behaviors", "/tutorials/ui/behavior.html"):Text(" tutorial
covers behaviors in more depth.")
        CodeExampleFromFile("sources/tutorials/ui/Forms/Main2.quorum")

        Paragraph("Run the app. Type your name, then press "):Key("Tab"):Text(" to move to the button and
press "):Key("Space"):Text(" or "):Key("Enter"):Text(". The label below the button changes to greet you.")

        BlockEditor("Main.quorum", "html/sources/tutorials/ui/Forms/Main2.quorum", "", true, true)

        Paragraph("Examine the "):Code("Run"):Text(" action. "):Code("GetPage()"):Text(" gives you the Page that is showing
right now. Then "):Code("GetTextField(" + dq + "Your name" + dq + ")"):Text(" and "):Code("GetLabel(" + dq + "Greeting" + dq + ")"):Text(" find
the controls by the names you gave them in "):Code("Main"):Text(". "):Code("field:GetText()"):Text(" gives
you what the person typed, and "):Code("greeting:SetText(...)"):Text(" changes what the
label shows.")

        Paragraph("Notice the two calls to "):Code("AddLabel"):Text(". The first value is the label's "):Strong("name"):Text(", used to find it. The second value is the "):Strong("text"):Text(" it shows. The "):DoubleQuote():Text("Your name"):DoubleQuote():Text(" label is there for people who can see the screen. The text
field's own name, "):DoubleQuote():Text("Your name"):DoubleQuote():Text(", is what a screen reader says when the field
has the focus. "):Code("SetDescription"):Text(" adds more detail that a screen reader can
read.")
    end

    private action HowAPageArrangesControls
        Subsection("How a Page arranges controls")
        Paragraph("You never gave a position or a size in the greeting app. The Page did it.
It puts each control in its own row, from top to bottom. The rows take up
most of the window's width and sit in the middle. Two things are worth
knowing:")

        BulletList()
        ListItem():Strong("A label followed by a field share a row."):Text(" When a label comes right
before a text field, text box, combo box, date field, slider or progress
bar, the Page puts the label beside it. In a narrow window, the label
goes above the field in smaller letters instead. That is why "):DoubleQuote():Text("Your name"):DoubleQuote():Text("
sits next to its text field.")
        ListItem():Strong("Text fields don't stretch forever."):Text(" In a wide window, a text field
stops growing at a comfortable width, so it doesn't run across the whole
screen.")

        Paragraph("To line the controls up on the left instead of the center, call "):Code("page:LeftAlignContent()"):Text(". There are also "):Code("CenterAlignContent()"):Text(" and "):Code("RightAlignContent()"):Text(".")

        Paragraph("The order you add controls is the order they appear on the screen. It is
also the order "):Key("Tab"):Text(" moves through them. After the last control, "):Key("Tab"):Text(" goes
back to the first. "):Keys("Shift", "Tab"):Text(" goes the other way. You don't write any of
this yourself: the Form works out the order when the Page first appears.
This keeps what a person sees and what a keyboard user reaches in the same
order, which is an important part of accessible design.")

        Paragraph("Later, in the "):Link("Layouts", "/tutorials/ui/layout.html"):Text(" tutorial, you will learn
how to place controls yourself. Until then, every tutorial uses Pages, which
do this work for you.")
    end

    private action LightModeDarkModeAndWindowSize
        Subsection("Light mode, dark mode, and window size")
        Paragraph("A Form uses light mode unless you tell it otherwise. Call "):Code("form:SetToDarkMode()"):Text(" before "):Code("form:Display()"):Text(" to show light text on a dark
background. Some people find dark mode easier on their eyes. "):Code("form:SetToLightMode()"):Text(" goes back to light mode. The "):Link("Themes and Dark Mode", "/tutorials/ui/themes.html"):Text(" tutorial covers this in
more depth.")

        Paragraph():Code("form:Display()"):Text(" opens a window 750 pixels wide and 1000 pixels tall. To
pick another size, give the width and height: "):Code("form:Display(600, 400)"):Text(".")
        CodeExampleFromFile("sources/tutorials/ui/Forms/Main3.quorum")

        Paragraph("Try making the window narrower by dragging its edge while the greeting app
runs. Notice the "):DoubleQuote():Text("Your name"):DoubleQuote():Text(" label move from beside the field to above it.")
    end

    private action AccessibilityInForms
        Subsection("Accessibility in Forms")
        Paragraph("Forms do much of the accessibility work for you:")

        BulletList()
        ListItem("When the window opens, the first control that can take the focus gets it.")
        ListItem():Key("Tab"):Text(" and "):Keys("Shift", "Tab"):Text(" move through the controls in the order you added
them.")
        ListItem("Titles and labels can take the focus, so a screen reader reads them as a
person tabs through the Page.")
        ListItem():Key("Space"):Text(" or "):Key("Enter"):Text(" presses the button that has the focus.")

        Paragraph("Your job is to choose clear names, add a description when a name alone
isn't enough, and add controls in an order that makes sense when read from
top to bottom.")
    end

    action Engage
        Section("Engage")
        Paragraph("The goal of this activity is to plan a small one-page app on paper, build
it as a Form, and improve it based on what someone else notices. With a
partner, pick a small topic, such as a greeting card maker, a pet name
picker or a "):DoubleQuote():Text("what should I read next"):DoubleQuote():Text(" helper. First, sketch the Page on
paper. Write next to every control the name a screen reader should say, and
number the controls in the order "):Key("Tab"):Text(" should reach them. Then build it. Your
Page needs a banner, at least one label and text field pair, a button, and
a label that changes when the button is pressed, based on what was typed.
If you like, add one control from the table in this tutorial, such as a
checkbox or a slider field.")

        Paragraph("When your app works, swap with another pair. Test their app using only the
keyboard: unplug the mouse or keep your hand off it. Then try it in a narrow
window and in dark mode. Write down which design choices made the app easy
to use, which were missing, and one change that would help most. Give them
your notes, and use the notes you get back to make one change to your own
app. Run it again to check the change helped.")
    end

    action WrapUp
        Section("Wrap up")
        Paragraph("A Form decides where controls go and what order the keyboard reaches them
in. What do you gain when a library makes these choices for you? What might
you give up? Think of an app where you would want more control than a Form
gives you.")
    end
end
