use Libraries.Web.Page.all
use Libraries.Web.Page.Standards.ComputerScienceStandards2026
use Libraries.Web.Page.Standards.QuorumStandards

/*
    Tutorial: Layouts, part of the user interface series.
*/
class UserInterfacesLayout is QuorumPage
    // The site's sets of standards, built once for every page.
    QuorumStandards standards

    on create
        SetLocation("tutorials/ui/layout.html")
        SetShortTitle("Layouts")
        SetSectionName("User Interfaces")
    end

    action Setup
        // For search engines and link previews.
        SetDescription("How a Quorum form lays out its controls, how to give a grouping its own FlowLayout or GridLayout, how to place controls in a window with pixels and percentages in a ManualLayout, and what a resized window can and can't tell you about a phone.")

        Title("Layouts")

        Overview()
        WarmUp()
        Explore()
        Engage()
        WrapUp()
    end

    action Overview
        Section("Overview")
        Paragraph("A user interface has to fit on many screens: a large monitor, a small
laptop, a phone, or a window that someone drags to a new size. A "):Strong("layout"):Text("
is a set of rules that decides where each control goes and how big it is.
Every form you have built so far used a layout without you writing one. In
this tutorial, you will give part of a form its own layout, so that buttons
wrap onto new lines or sit in a grid. You will also lay out a whole window
yourself, with sizes in pixels and percentages that change when the window
does.")

        Subsection("Goals")
        Paragraph("You have the following goals for this tutorial:")
        Goals()
        ListItem("Explain what a layout and a container are, and what a form's layout does
for you")
        ListItem("Give a "):Code("Grouping"):Text(" on a page its own layout")
        ListItem("Arrange a row of controls that wraps with a "):Code("FlowLayout"):Text(", and a grid of
controls with a "):Code("GridLayout")
        ListItem("Position and size controls with pixels and with percentages in a
"):Code("ManualLayout")
        ListItem("Use "):Code("LayoutProperties"):Text(" to describe how a control is sized, including a
different arrangement for narrow windows")
        ListItem("Explain what resizing a window can and can't tell you about a phone or a
desktop screen")
    end

    action WarmUp
        Section("Warm up")
        Paragraph("Open a website you use often. Make the browser window wide, and then slowly
make it narrow. What stays the same size? What gets smaller? What moves to a
new place, or disappears into a menu? Why do you think the designers made
those choices?")

        Subsection("Vocabulary")
        Paragraph("You will be learning about the following vocabulary words:")
        Table("Vocabulary", "media/userInterface/Layout/Vocabulary.csv")

        Subsection("New Code to Learn")
        Paragraph("You will be using the following new pieces of code:")
        Table("New Code to Learn", "media/userInterface/Layout/Code.csv")

        Subsection("CSTA Standards")
        Paragraph("This tutorial covers the following
"):Link("2026 CSTA standards", "https://csteachers.org/pk12standards/view/"):Text(":")
        ComputerScienceStandards2026 computerScience = standards:GetComputerScience2026()
        CoversStandard(computerScience, computerScience:MIDDLE_SCHOOL_PROGRAM_DEVELOPMENT_15)
        CoversStandard(computerScience, computerScience:HIGH_SCHOOL_PROGRAM_DEVELOPMENT_15)
        CoversStandard(computerScience, computerScience:HIGH_SCHOOL_HARDWARE_AND_SOFTWARE_30)
        CoversStandard(computerScience, computerScience:HIGH_SCHOOL_TESTING_AND_REFINING_19)
        CoversStandard(computerScience, computerScience:SPECIALTY_1_SOFTWARE_DEVELOPMENT_USER_EXPERIENCE_4)
        CoversStandard(computerScience, computerScience:SPECIALTY_2_SOFTWARE_DEVELOPMENT_USER_EXPERIENCE_6)
        StandardsList(computerScience)
    end

    action Explore
        Section("Explore")
        WhatIsALayout()
        PixelsAndPercentages()
        LayoutModes()
        AboutLayoutProperties()
        AGroupingWithItsOwnLayout()
        TheToolbar()
        TheNumberPad()
        TheTabOrderOfAGrouping()
        AWholeWindow()
        StandingInForAPhone()
    end

    private action WhatIsALayout
        Subsection("What is a layout?")
        Paragraph("Every control lives inside a "):Strong("container"):Text(". A page is a container, and so
is a grouping, a game window, or any "):Code("Control"):Text(" that you add other items to.
A container can have a "):Strong("layout"):Text(", which is an object that positions and
sizes the items inside it. When the window changes size, the layout
arranges everything again.")

        Paragraph("A form page already has a layout. It puts each control in its own row, from
top to bottom, centers the rows, and makes them 80% as wide as the page. It
pairs a label with the field after it, and it puts the controls in a
grouping side by side. That is why your forms have been tidy without any
layout code, and why they still work when the window is narrow.")

        Paragraph("Sometimes you want a different arrangement for one part of a page, such as
a toolbar or a number pad. Quorum's library has many layout classes, but
most are built for one kind of control. For example, "):Code("ButtonLayout"):Text("
arranges the text and icon inside a button. Three layouts are meant for
your own programs:")
        BulletList()
        ListItem():Strong("FlowLayout"):Text(": items are placed in a row from left to right, starting
at the top left. When a row is full, the next item starts a new row.")
        ListItem():Strong("GridLayout"):Text(": items are placed in the cells of a grid of rows and
columns.")
        ListItem():Strong("ManualLayout"):Text(": you say exactly where each item goes and how big it
is, in pixels, in percentages, or in both.")
    end

    private action PixelsAndPercentages
        Subsection("Pixels and percentages")
        Paragraph("Positions in Quorum are measured from the "):Strong("bottom left"):Text(" corner of the
container. Moving right makes x bigger, and moving up makes y bigger.")

        Paragraph("You can give a position or a size in two ways:")
        BulletList()
        ListItem():Strong("Pixels"):Text(" stay the same. A button 200 pixels wide is 200 pixels wide in a
small window and in a large one.")
        ListItem():Strong("Percentages"):Text(" are a part of the container, written from 0.0 to 1.0. A
button with a percentage width of 0.5 is always half as wide as its
container.")

        Paragraph("You can also use both at once. The layout adds them together. For example, a
percentage y of 1.0 and a pixel y of -70 means "):DoubleQuote():Text("70 pixels below the top,"):DoubleQuote():Text("
however tall the container is.")
    end

    private action LayoutModes
        Subsection("Layout modes")
        Paragraph("A "):Strong("layout mode"):Text(" tells a control how to work out its width or height.
There are five modes:")
        BulletList()
        ListItem():Strong("STANDARD"):Text(": the size is a percentage of the container plus a number of
pixels. Use this when you want to set the size yourself.")
        ListItem():Strong("FILL"):Text(": the control fills the space that is left in the container.")
        ListItem():Strong("FIT_CONTENTS"):Text(": the control is just big enough to hold what is inside it.
A button uses this for its width by default.")
        ListItem():Strong("FIT_FONT"):Text(": the height fits one line of the control's font. A button uses
this for its height by default. It only works for height.")
        ListItem():Strong("MAINTAIN_ASPECT_RATIO"):Text(": one side is worked out from the other, so the
shape stays the same. Only one side can use this mode at a time.")

        Paragraph("A "):Code("FlowLayout"):Text(" and a "):Code("GridLayout"):Text(" read the modes to decide how big each
control should be. A "):Code("ManualLayout"):Text(" doesn't: it uses the pixel and
percentage sizes you set.")
    end

    private action AboutLayoutProperties
        Subsection("LayoutProperties")
        Paragraph("Every control keeps its layout information in a "):Code("LayoutProperties"):Text(" object:
its position, size, margins, grid cell and layout modes. Actions like
"):Code("SetPixelWidth"):Text(" on a button are shortcuts that change the button's default
"):Code("LayoutProperties"):Text(". You can also get that object with
"):Code("GetDefaultLayoutProperties"):Text(" and change it yourself. Some settings, such as
a minimum or maximum size, are only available this way.")

        Paragraph("The layout modes are numbers stored in "):Code("LayoutProperties"):Text(", so it is the
easiest place to set them:")
        CodeExampleFromFile("sources/tutorials/ui/Layout/LayoutModes.quorum")
    end

    private action AGroupingWithItsOwnLayout
        Subsection("A grouping with its own layout")
        Paragraph("In the "):Link("Pages", "/tutorials/ui/pages.html"):Text(" tutorial, you added groupings to a
page with "):Code("AddGrouping"):Text(". A grouping can have its own layout:
"):Code("SetLayout"):Text(" gives it one. The page still places the grouping as one row, but
the grouping's layout arranges what is inside it.")

        Paragraph("The program below makes the start of a phone app with two groupings: a
toolbar that uses a "):Code("FlowLayout"):Text(", and a number pad that uses a
"):Code("GridLayout"):Text(". Replace "):Code("Main.quorum"):Text(" with this program:")
        CodeExampleFromFile("sources/tutorials/ui/Layout/Main.quorum")

        Paragraph("The first lines make the window resizable, so you can try it. Run the
program and drag the edge of the window. To resize it with the keyboard on
Windows, press "):Keys("Alt", "Space"):Text(", then "):Key("S"):Text(", then the arrow keys, and "):Key("Enter"):Text(" when
it is the size you want. On any computer, you can also choose the size in
the code: add "):Code("config:width = 360"):Text(" just after "):Code("config:resizable = true"):Text(" and
run the program again. Try a few widths, such as 360 and 1000.")
    end

    private action TheToolbar
        Subsection("The toolbar: a FlowLayout")
        Paragraph("The toolbar's "):Code("FlowLayout"):Text(" puts the first button at the top left of the
grouping and each next button to its right. When the next button doesn't
fit in the row, it starts a new row underneath. Make the window narrow, and
the buttons that no longer fit move to a second row. A grouping is as tall
as what is inside it, so the toolbar grows to hold the new row, and the
number pad moves down.")

        Paragraph("Each button is as wide as its text, because a button's horizontal layout
mode is "):Code("FIT_CONTENTS"):Text(" by default. The margins add 5 pixels of space around
each button so they don't touch.")

        Paragraph("A "):Code("FlowLayout"):Text(" decides where each control goes, so it ignores the x and y
values you set on the controls inside it. It does use their sizes, layout
modes and margins. It also has two options:")
        BulletList()
        ListItem():Code("flow:SetSingleLine(true)"):Text(" keeps every control on one row, even when the
row is too long.")
        ListItem():Code("flow:SetVerticalCentering(true)"):Text(" centers the controls in each row from top
to bottom, which helps when they have different heights.")
    end

    private action TheNumberPad
        Subsection("The number pad: a GridLayout")
        Paragraph("A "):Code("GridLayout"):Text(" divides its container into cells of equal size. You tell the
container how many columns and rows it has, and you tell each control which
cell it goes in. Columns are counted from the left, starting at 0. Rows are
counted from the "):Strong("bottom"):Text(", starting at 0, because positions in Quorum go
up from the bottom.")

        Paragraph("Some things to notice:")
        BulletList()
        ListItem():Strong("The grid size belongs to the container."):Text(" "):Code("SetContainerGridWidth(3)"):Text(" and
"):Code("SetContainerGridHeight(4)"):Text(" give the pad 3 columns and 4 rows. Always set
both.")
        ListItem():Strong("The pad needs a height of its own."):Text(" A grouping's height normally fits
what is inside it, but a grid's cells get their size from the
container, so the two would wait on each other. Setting the pad's
vertical layout mode to "):Code("STANDARD"):Text(" and its height to 240 pixels breaks
the tie. Without the "):Code("STANDARD"):Text(" line, the program stops with a message
that the "):Code("GridLayout"):Text(" does not support the layout mode.")
        ListItem():Strong("The top row is row 3."):Text(" The loop starts at row 3 and counts down, so the
keys 1, 2 and 3 end up at the top, like on a phone.")
        ListItem():Strong("FILL makes each key fill its cell."):Text(" With both layout modes set to
"):Code("FILL"):Text(", each key fills its whole cell, minus its margins.")
        ListItem():Strong("The 0 key spans three cells."):Text(" "):Code("SetGridWidth(3)"):Text(" makes it cover columns
0, 1 and 2. "):Code("SetGridHeight"):Text(" does the same for rows.")
    end

    private action TheTabOrderOfAGrouping
        Subsection("The Tab order of a grouping")
        Paragraph("A layout only changes where controls appear on the screen. It doesn't change
the order in which the "):Key("Tab"):Text(" key moves between them. On a form, the "):Key("Tab"):Text("
order follows the order you "):Strong("add"):Text(" the controls: the toolbar's buttons
from Contacts to Help, then the keys, then Call.")

        Paragraph("That is why "):Code("AddKey"):Text(" is called in reading order: 1, 2, 3, then 4, 5, 6, and
so on, ending with 0. If the loop added the bottom row first, the pad would
look the same, but "):Key("Tab"):Text(" would visit 7, 8 and 9 before 1, 2 and 3. Always
add controls in the order a person reads them, usually left to right and
top to bottom.")

        Paragraph("When a key has the focus, a screen reader reads its name, its description
and that it is a button. Press "):Key("Space"):Text(" or "):Key("Enter"):Text(" to press the key.")
    end

    private action AWholeWindow
        Subsection("A whole window: a ManualLayout")
        Paragraph("A form arranges a whole page for you. Sometimes, such as in a game, you
want to place everything in the window yourself. For that, a program uses
the "):Code("Game"):Text(" class and gives the window a "):Code("ManualLayout"):Text(". Each control says
where it goes and how big it is.")

        Paragraph("The following program makes a window that you can resize. Each control uses
a different rule:")
        BulletList()
        ListItem():Strong("Center"):Text(" stays in the middle of the window.")
        ListItem():Strong("Corner"):Text(" is always 200 by 50 pixels, 20 pixels from the bottom left
corner.")
        ListItem():Strong("Sidebar"):Text(", a blue panel, takes the right quarter of a wide window. In a
window 600 pixels wide or less, it moves to a strip across the top.")

        Paragraph("Replace "):Code("Main.quorum"):Text(" with this game:")
        CodeExampleFromFile("sources/tutorials/ui/Layout/Main2.quorum")

        Paragraph("Run the program and drag the edge of the window, or use the keys or
"):Code("config:width"):Text(" from the Phone form. The Center button stays in
the middle, the Corner button does not change at all, and the sidebar
grows and shrinks with the window until the window is narrow enough for
the sidebar to jump to the top.")

        BlockEditor("Main.quorum", "html/sources/tutorials/ui/Layout/Main2.quorum", "", true, true)

        Paragraph("A few details in this program are worth examining:")
        BulletList()
        ListItem():Strong("The origin."):Text(" By default, a control's position is its bottom left
corner. "):Code("SetPercentageOriginX(0.5)"):Text(" and "):Code("SetPercentageOriginY(0.5)"):Text(" move
that point to the center of the button, so a position of 0.5, 0.5 puts the
center of the button at the center of the window.")
        ListItem():Strong("A minimum size."):Text(" "):Code("GetDefaultLayoutProperties"):Text(" returns the sidebar's
default properties, the ones the "):Code("SetPercentage"):Text(" actions above changed.
"):Code("SetMinimumWidth(150)"):Text(" stops the sidebar from getting narrower than 150
pixels. "):Code("SetMaximumWidth"):Text(" does the opposite.")
        ListItem():Strong("A second set of properties."):Text(" "):Code("AddLayoutProperties"):Text(" gives the sidebar
another "):Code("LayoutProperties"):Text(" object to choose from. "):Code("SetMaximumContainerWidth(600)"):Text("
says it is only for containers 600 pixels wide or less. Each time the
window is laid out, the sidebar uses the "):Code("narrow"):Text(" properties if they fit,
and its default properties if not. Changing the arrangement to fit the
window like this is called "):Strong("responsive design"):Text(".")
        ListItem():Strong("A Tab order of your own."):Text(" A form sets the "):Key("Tab"):Text(" order for you, but a
game doesn't. "):Code("SetNextFocus"):Text(" and "):Code("SetPreviousFocus"):Text(" link the two buttons
so "):Key("Tab"):Text(" and "):Keys("Shift", "Tab"):Text(" move between them, and "):Code("Focus"):Text(" gives the Center
button the focus at the start. The "):Link("Focus", "/tutorials/ui/focus.html"):Text("
tutorial explains these actions in more detail.")
        ListItem():Strong("The sidebar is only a picture."):Text(" A screen reader skips it. An "):Code("Icon"):Text(" is
not announced unless you give it an accessibility code, which the
"):Link("Accessibility", "/tutorials/ui/accessibility.html"):Text(" tutorial explains. The
buttons are read by their names, followed by their descriptions.")
    end

    private action StandingInForAPhone
        Subsection("Standing in for a phone")
        Paragraph("Programs run on screens of many sizes, and you may not have every device to
test on. Resizing a window is a "):Strong("simulation"):Text(": the window stands in for a
smaller or a larger screen. It can tell you what your layout does when there
is less room: which controls move, shrink, overlap or disappear, and whether
a narrow arrangement, like the sidebar's, takes over when it should.")

        Paragraph("A simulation also has limits. A resized window on a computer is still used
with a mouse and a keyboard. It can't tell you whether a button is big
enough to tap with a finger, whether an on-screen keyboard covers your text
field, or how the program feels in someone's hand. When a resized window
says your layout works, treat that as a good first test, not the last one.")
    end

    action Engage
        Section("Engage")
        Paragraph("In this activity, you work in a team of three to design and build a
calculator on a form, and then test it in a window sized like a phone and
like a desktop screen. The goal is to follow a team workflow with a design
document and clear roles, to build a layout with a grouping that has its own
layout, and to find out what a resized window can and can't tell you.")

        Paragraph("Each person takes one role: the "):Strong("planner"):Text(" writes the design document, the
"):Strong("builder"):Text(" writes the code, and the "):Strong("tester"):Text(" tests it. In a team of two,
the planner also tests. On your next project, switch roles so that everyone
gets a turn at each one. Work in this order:")
        NumberedList()
        ListItem():Strong("Design (planner, with the team)."):Text(" The calculator needs a text field
at the top for the number being typed, a grid of number and operator
keys, and a wide "):DoubleQuote():Text("equals"):DoubleQuote():Text(" key. The planner sketches the keypad twice,
once for a wide window and once for a narrow one, and labels the column
and row of every key; remember that row 0 is at the bottom. The planner
also writes the layout out as a list in words, so every teammate can
review it, including one who uses a screen reader. Each teammate
suggests at least one change before the team agrees on the design.")
        ListItem():Strong("Build (builder)."):Text(" The builder builds it with a "):Code("GridLayout"):Text(" inside a
grouping, adding the keys in reading order so "):Key("Tab"):Text(" follows the rows
from top to bottom. The builder writes down any place where the code
had to differ from the design, and why.")
        ListItem():Strong("Test (tester)."):Text(" Using only the keyboard, the tester checks that every
key can be reached with "):Key("Tab"):Text(" and "):Keys("Shift", "Tab"):Text(" and pressed with "):Key("Space"):Text(".
Then the tester drags the window, or uses the keys or "):Code("config:width"):Text("
from Explore, to make it as narrow as a phone held upright, and then as
wide as a desktop screen, and writes down anything that
overlaps, disappears or becomes too small to read.")
        ListItem():Strong("Review (whole team)."):Text(" Compare the test results with the design
document. Agree on one change, make it, and update the document.")

        Paragraph("Finish by writing two things the resized window showed you about a phone,
and two things it couldn't show you.")
    end

    action WrapUp
        Section("Wrap up")
        Paragraph("Think about an app on your phone that you also use on a computer. How does
its layout change between the two? Which choices do you think were made for
the size of the screen, and which were made for how people hold or use the
device? Which of the three layouts would you pick for a game's inventory
screen, and why? In your team, which role was the hardest, and how did the
design document help the builder and the tester?")

        Paragraph("In the next tutorial, "):Link("Input Sets", "/tutorials/ui/inputSet.html"):Text(", you will
choose which keys and mouse buttons run your program's behaviors.")
    end
end
