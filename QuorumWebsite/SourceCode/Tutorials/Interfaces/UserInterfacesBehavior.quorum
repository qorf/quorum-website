use Libraries.Web.Page.all
use Libraries.Web.Page.Standards.ComputerScienceStandards2026
use Libraries.Web.Page.Standards.QuorumStandards

/*
    Tutorial: Behaviors, the third page of the user interface series.
*/
class UserInterfacesBehavior is QuorumPage
    // The site's sets of standards, built once for every page.
    QuorumStandards standards
    // A double quote, for code that holds one.
    text dq = ""

    on create
        SetLocation("tutorials/ui/behavior.html")
        SetShortTitle("Behaviors")
        SetSectionName("User Interfaces")
    end

    action Setup
        dq = dq:GetDoubleQuote()

        // For search engines and link previews.
        SetDescription("Write behaviors in Quorum: code that runs once when a button is pressed, and code that runs a little at a time, such as a countdown.")

        Title("Behaviors")

        Overview()
        WarmUp()
        Explore()
        Engage()
        WrapUp()
    end

    action Overview
        Section("Overview")
        Paragraph("A user interface has to "):Strong("do"):Text(" something when a person uses it. When a
button is pressed, a message appears. When a timer starts, it counts down.
In Quorum, the code that runs when something happens goes in a "):Strong("behavior"):Text(". A behavior is a class that inherits from "):Code("Behavior"):Text(". In this
tutorial, you will write a behavior that runs once when a button on a page
is pressed, and a behavior that runs a little at a time, over several
seconds.")

        Subsection("Goals")
        Paragraph("You have the following goals for this lesson:")
        Goals()
        ListItem("Learn the four main actions of the "):Code("Behavior"):Text(" class and when each one runs")
        ListItem("Write a behavior and attach it to a button on a page with "):Code("SetBehavior")
        ListItem("Write a behavior that runs over time and attach it with "):Code("AddBehavior")
        ListItem("Show changes in a way that every person can find, including screen reader
users")
    end

    action WarmUp
        Section("Warm up")
        Paragraph("Think about a microwave. You press "):DoubleQuote():Text("Start"):DoubleQuote():Text(", and it runs for a set time,
then beeps and stops. What happens once at the start? What happens over and
over while it runs? What happens once at the end? Consider one other
device that works the same way.")

        Subsection("Vocabulary")
        Paragraph("You will be learning about the following vocabulary words:")
        Table("Vocabulary", "media/userInterface/Behavior/Vocabulary.csv")

        Subsection("New Code to Learn")
        Paragraph("You will be using the following new pieces of code:")
        Table("New Code to Learn", "media/userInterface/Behavior/Code.csv")

        Subsection("CSTA Standards")
        Paragraph("This lesson covers the following "):Link("CSTA K–12 standards", "https://csteachers.org/pk12standards/view/"):Text(":")
        ComputerScienceStandards2026 computerScience = standards:GetComputerScience2026()
        CoversStandard(computerScience, computerScience:HIGH_SCHOOL_PROGRAM_DEVELOPMENT_12)
        CoversStandard(computerScience, computerScience:HIGH_SCHOOL_READING_AND_DOCUMENTING_17)
        CoversStandard(computerScience, computerScience:MIDDLE_SCHOOL_PROGRAM_DEVELOPMENT_12)
        CoversStandard(computerScience, computerScience:MIDDLE_SCHOOL_READING_AND_DOCUMENTING_17)
        StandardsList(computerScience)
    end

    action Explore
        Section("Explore")
        Paragraph("In "):Link("Forms", "/tutorials/ui/forms.html"):Text(", you used a "):Code("FormBehavior"):Text(" to respond
to a button. "):Code("FormBehavior"):Text(" is one kind of behavior. In this tutorial, you
will explore the "):Code("Behavior"):Text(" class itself and write your own. You should
already know about "):Link("inheritance", "/tutorials/language/inheritance.html"):Text(",
because every behavior inherits from "):Code("Behavior"):Text(" and replaces, or "):Strong("overrides"):Text(", some of its actions.")

        TheBehaviorClass()
        TwoWaysABehaviorRuns()
        ABehaviorForAButton()
        BehaviorsThatChangeThePage()
        ABehaviorThatTakesTime()
        AShortcutTimedBehavior()
        MakingChangesEveryoneCanFind()
    end

    private action TheBehaviorClass
        Subsection("The Behavior class")
        Paragraph("The "):Code("Behavior"):Text(" class lives in "):Code("Libraries.Interface.Behaviors"):Text(". On its own,
it does nothing. You make a new class that inherits from it and override
the actions you need. These are its four main actions:")
        CodeExampleFromFile("sources/tutorials/ui/Behavior/BehaviorActions.quorum")

        Table("The four main actions of a Behavior")
        TableHeader():Cell("Action"):Cell("When it runs"):Cell("What it is for")
        TableRowWriter row = TableRow()
        row:Cell():Code("Run")
        row:Cell("Once, when the behavior starts")
        row:Cell("The main work, or setting things up")
        row = TableRow()
        row:Cell():Code("Update")
        row:Cell("Every frame, while the behavior is running")
        row:Cell("Changes that happen bit by bit, like a countdown")
        row = TableRow()
        row:Cell():Code("IsFinished")
        row:Cell():Text("Every frame, before "):Code("Update")
        row:Cell():Text("Returns "):Code("true"):Text(" when the behavior is done")
        row = TableRow()
        row:Cell():Code("Dispose")
        row:Cell():Text("Once, after "):Code("IsFinished"):Text(" returns "):Code("true")
        row:Cell():Text("Cleaning up, or showing "):DoubleQuote():Text("done"):DoubleQuote()

        Paragraph("The "):Code("event"):Text(" that "):Code("Run"):Text(" gets is a "):Code("BehaviorEvent"):Text(". Its "):Code("GetItem"):Text(" action
tells you which item the behavior belongs to, such as the button that was
pressed.")
    end

    private action TwoWaysABehaviorRuns
        Subsection("Two ways a behavior runs")
        Paragraph("There are two ways to give a behavior to an item. They run the actions
differently:")

        Table("SetBehavior and AddBehavior")
        TableRowWriter header = TableHeader()
        header:Cell("")
        header:Cell():Code("SetBehavior")
        header:Cell():Code("AddBehavior")
        TableRowWriter row = TableRow()
        row:Cell("Used on")
        row:Cell("Buttons and other controls")
        row:Cell("Any item, such as a label or a button")
        row = TableRow()
        row:Cell():Text("When "):Code("Run"):Text(" happens")
        row:Cell("Every time the control is pressed")
        row:Cell("Once, right away")
        row = TableRow()
        row:Cell():Code("Update"):Text(", "):Code("IsFinished"):Text(", "):Code("Dispose")
        row:Cell("Not called by a button")
        row:Cell():Text("Called every frame until "):Code("IsFinished"):Text(" returns "):Code("true")
        row = TableRow()
        row:Cell("Good for")
        row:Cell("Reacting to a press")
        row:Cell("Something that takes time, like a countdown")

        Paragraph("You will try both.")
    end

    private action ABehaviorForAButton
        Subsection("A behavior for a button")
        Paragraph("To start, make a new project in Quorum Studio. Under "):Strong("General"):Text(", choose "):Strong("App"):Text(". Then add a new file to the project named "):Code("OutputBehavior.quorum"):Text("
with this code:")
        CodeExampleFromFile("sources/tutorials/ui/Behavior/OutputBehavior.quorum")

        Paragraph("This class overrides only "):Code("Run"):Text(". It gets the item that was pressed with "):Code("event:GetItem()"):Text(", then its name with "):Code("GetName()"):Text(", and writes a message in
the output window.")

        Paragraph("Now replace the code in "):Code("Main.quorum"):Text(" with this:")
        CodeExampleFromFile("sources/tutorials/ui/Behavior/Main.quorum")

        Paragraph("Run the program. Press "):Key("Tab"):Text(" until the Hello button has the focus, then
press "):Key("Space"):Text(" or "):Key("Enter"):Text(", or click it. The output window shows "):DoubleQuote():Text("You pressed
Hello"):DoubleQuote():Text(". Press "):Key("Tab"):Text(" to move to the other button and press it. Now the output window shows "):DoubleQuote():Text("You pressed Goodbye"):DoubleQuote():Text(". One behavior object serves both buttons, because "):Code("event:GetItem()"):Text(" tells it which one was pressed. With "):Code("SetBehavior"):Text(", a
button calls "):Code("Run"):Text(" each time it is pressed. It doesn't call "):Code("Update"):Text(", "):Code("IsFinished"):Text(", or "):Code("Dispose"):Text(".")
    end

    private action BehaviorsThatChangeThePage
        Subsection("Behaviors that change the page")
        Paragraph():Code("OutputBehavior"):Text(" writes to the output window, which is only for you, the
programmer. Most apps change something on the page instead. A "):Strong("FormBehavior"):Text(" is a behavior that can find the page that is showing, with
its "):Code("GetPage"):Text(" action. From the page, it can find any control by its name.")

        Paragraph("In this program, the "):Code("Main"):Text(" class is itself a "):Code("FormBehavior"):Text(", so it can be
the button's behavior, as in the "):Link("Forms", "/tutorials/ui/forms.html"):Text("
tutorial:")
        CodeExampleFromFile("sources/tutorials/ui/Behavior/Main2.quorum")

        Paragraph():Code("page:AddLabel(" + dq + "Count" + dq + ", ...)"):Text(" gives the label a name, "):DoubleQuote():Text("Count"):DoubleQuote():Text(", and the text
it shows. In "):Code("Run"):Text(", "):Code("GetPage()"):Text(" gets the page, and "):Code("GetLabel(" + dq + "Count" + dq + ")"):Text(" finds
the label by its name. "):Code("SetText"):Text(" changes what it says. The variable "):Code("presses"):Text(" belongs to the "):Code("Main"):Text(" object, so it keeps its value between
presses.")
    end

    private action ABehaviorThatTakesTime
        Subsection("A behavior that takes time")
        Paragraph("Now you will make a countdown: a label that counts down from 5 seconds,
then says "):DoubleQuote():Text("Time is up!"):DoubleQuote():Text(". This needs all four actions. Add a new file named "):Code("CountdownBehavior.quorum"):Text(":")
        CodeExampleFromFile("sources/tutorials/ui/Behavior/CountdownBehavior.quorum")

        Paragraph("Here is how each action works:")
        BulletList()
        ListItem():Strong("Variables:"):Text(" "):Code("label"):Text(" remembers the label between actions. It starts as "):Code("undefined"):Text(", which means "):DoubleQuote():Text("nothing yet"):DoubleQuote():Text(". "):Code("timer"):Text(" counts the seconds that
have passed. "):Code("secondsShown"):Text(" counts the whole seconds the label has shown.")
        ListItem():Code("Run"):Text(": "):Code("event:GetItem()"):Text(" gives back an "):Code("Item"):Text(", the most general kind
of object on the screen. To change its text, you need it as a "):Code("Label"):Text(", so
you "):Strong("cast"):Text(" it. Then the code shows the starting time.")
        ListItem():Code("Update"):Text(": "):Code("seconds"):Text(" is the time since the last frame, usually a tiny
fraction of a second. The code adds it to "):Code("timer"):Text(". Each time another whole
second has passed, it changes the label.")
        ListItem():Code("IsFinished"):Text(": returns "):Code("true"):Text(" once five seconds have passed.")
        ListItem():Code("Dispose"):Text(": runs once, after "):Code("IsFinished"):Text(" returns "):Code("true"):Text(". It changes the
label to "):DoubleQuote():Text("Time is up!"):DoubleQuote():Text(".")

        Paragraph("Now replace "):Code("Main.quorum"):Text(" with this program. Its button starts a new
countdown on the label each time it is pressed:")
        CodeExampleFromFile("sources/tutorials/ui/Behavior/Main3.quorum")

        Paragraph("Run it and press "):Strong("Start"):Text(". The label counts down, one second at a time,
then says "):DoubleQuote():Text("Time is up!"):DoubleQuote():Text(". With "):Code("AddBehavior"):Text(", "):Code("Run"):Text(" happens right away. After
that, on every frame, the Form asks "):Code("IsFinished"):Text(". While the answer is "):Code("false"):Text(", it calls "):Code("Update"):Text(". Once the answer is "):Code("true"):Text(", it calls "):Code("Dispose"):Text("
and removes the behavior.")

        Paragraph("The line "):Code("CountdownBehavior countdown"):Text(" is inside "):Code("Run"):Text(", so a brand new
countdown, with its timer at zero, is made each time the button is pressed.
Try pressing the button twice, about two seconds apart. What happens to the
label, and why?")

        BlockEditorFile("CountdownBehavior.quorum", "html/sources/tutorials/ui/Behavior/CountdownBehavior.quorum")
        BlockEditor("Main.quorum", "html/sources/tutorials/ui/Behavior/Main3.quorum", "", true, true)
    end

    private action AShortcutTimedBehavior
        Subsection("A shortcut: TimedBehavior")
        Paragraph("Counting time is so common that Quorum has a behavior that does it for you: "):Code("TimedBehavior"):Text(". You give it a number of seconds with "):Code("SetTimer"):Text(". Its "):Code("Update"):Text(" counts down, and its "):Code("IsFinished"):Text(" returns "):Code("true"):Text(" when the time is
up. Add a file named "):Code("WaitBehavior.quorum"):Text(":")
        CodeExampleFromFile("sources/tutorials/ui/Behavior/WaitBehavior.quorum")

        Paragraph():Code("WaitBehavior"):Text(" doesn't write "):Code("Update"):Text(" or "):Code("IsFinished"):Text(" at all. It uses the
ones it inherits from "):Code("TimedBehavior"):Text(". To try it, use "):Code("WaitBehavior"):Text("
instead of "):Code("CountdownBehavior"):Text(" in "):Code("Main"):Text(". If you ever override "):Code("Update"):Text(" in a "):Code("TimedBehavior"):Text(", call the parent's first, with "):Code("parent:TimedBehavior:Update(seconds)"):Text(", so the timer keeps counting.")
    end

    private action MakingChangesEveryoneCanFind
        Subsection("Making changes everyone can find")
        Paragraph("When a behavior changes the page, every person using the app needs a way
to find the change. In these programs, the change is in a label's text. On
a Form, labels are in the "):Key("Tab"):Text(" order, so a screen reader user can press "):Key("Tab"):Text(" from the button to reach the label and hear what it says now. Keep the
label close to the button that changes it, so it's easy to find.")

        Paragraph("A change that is only a color, a movement or a picture is easy to miss,
even for people who can see the screen. When a behavior changes something,
ask yourself how a person who can't see it would find out. Putting the news
in a label's text, or in a control's name or description, is a good way.")
    end

    action Engage
        Section("Engage")
        Paragraph("In this activity, you and a partner change and write behaviors, predicting
what each change will do before you run it. The goal is to understand that a
behavior is code that runs when something happens, and to practice reading
code carefully. One of you types while the other reads each line aloud and
predicts what it will do; switch roles after each task. First, change "):Code("CountdownBehavior"):Text(" so it counts down from 10 seconds. Before you run it,
agree on every number you need to change. Could you change the class so
there is only one number to change?")

        Paragraph("Next, write a new behavior, "):Code("CountUpBehavior"):Text(", that counts up from 0 to 5,
one second at a time, and then shows "):DoubleQuote():Text("Done counting"):DoubleQuote():Text(". Then add a second
button named "):DoubleQuote():Text("Count up"):DoubleQuote():Text(" that starts your "):Code("CountUpBehavior"):Text(" on a second label.
To finish, test your program with only the keyboard: can you reach and press
both buttons, and can you reach each label with "):Key("Tab"):Text(" to find out what it says?")
    end

    action WrapUp
        Section("Wrap up")
        Paragraph("You used "):Code("SetBehavior"):Text(" to react to a press and "):Code("AddBehavior"):Text(" to make
something happen over time. Think of a game or app you know. Find one thing
in it that would use "):Code("SetBehavior"):Text(" and one that would use "):Code("AddBehavior"):Text(".
Explain your choices to a partner.")
    end
end
