use Libraries.Web.Page.all
use Libraries.Web.Page.Standards.ComputerScienceStandards2026
use Libraries.Web.Page.Standards.QuorumStandards

/*
    Tutorial: Tab Panes, part of the user interface series.
*/
class UserInterfacesTabPane is QuorumPage
    // The site's sets of standards, built once for every page.
    QuorumStandards standards

    on create
        SetLocation("tutorials/ui/tabPane.html")
        SetShortTitle("Tab Panes")
        SetSectionName("User Interfaces")
    end

    action Setup
        // For search engines and link previews.
        SetDescription("How to put a tab pane on a Quorum form, fill its tabs with content, add tabs while the program runs, find out when a tab opens or closes, and move between tabs with the keyboard.")

        Title("Tab Panes")

        Overview()
        WarmUp()
        Explore()
        Engage()
        WrapUp()
    end

    action Overview
        Section("Overview")
        Paragraph("Many programs have more to show than fits on one screen. A web browser
holds many pages, and a settings window holds many groups of options. A
"):Strong("tab pane"):Text(" solves this by letting several panels share the same space. A
row of "):Strong("tabs"):Text(" sits along the top, and only the panel for the chosen tab is
shown. In this tutorial, you will put a tab pane on a form, put content in
each tab, add new tabs while the program runs, and find out when a tab is
opened or closed. You will also learn which keys a keyboard or screen
reader user presses to move between tabs.")

        Subsection("Goals")
        Paragraph("You have the following goals for this tutorial:")
        Goals()
        ListItem("Put a "):Code("TabPane"):Text(" on a form page and fill it with "):Code("Tab"):Text(" objects that each show their own content")
        ListItem("Give each tab a name and description so that a screen reader can read it")
        ListItem("Add tabs while a program is running, using a button and a behavior")
        ListItem("Use a "):Code("TabChangeListener"):Text(" to find out when a tab is opened or closed")
    end

    action WarmUp
        Section("Warm up")
        Paragraph("Think of a program you use that has tabs, like a web browser, a spreadsheet
or a settings window. Why did its designers use tabs instead of putting
everything on one long page? What would go wrong if the program had 40 tabs?
How do you think a person who uses only a keyboard moves from one tab to the
next?")

        Subsection("Vocabulary")
        Paragraph("You will be learning about the following vocabulary words:")
        Table("Vocabulary", "media/userInterface/TabPane/Vocabulary.csv")

        Subsection("New Code to Learn")
        Paragraph("You will be using the following new pieces of code:")
        Table("New Code to Learn", "media/userInterface/TabPane/Code.csv")

        Subsection("CSTA Standards")
        Paragraph("This tutorial covers the following "):Link("2026 CSTA standards", "https://csteachers.org/pk12standards/view/"):Text(":")
        ComputerScienceStandards2026 computerScience = standards:GetComputerScience2026()
        CoversStandard(computerScience, computerScience:HIGH_SCHOOL_TESTING_AND_REFINING_19)
        CoversStandard(computerScience, computerScience:MIDDLE_SCHOOL_TESTING_AND_REFINING_20)
        CoversStandard(computerScience, computerScience:SPECIALTY_1_SOFTWARE_DEVELOPMENT_USER_EXPERIENCE_4)
        CoversStandard(computerScience, computerScience:MIDDLE_SCHOOL_IMPACTS_OF_COMPUTING_SYSTEMS_36)
        StandardsList(computerScience)
    end

    action Explore
        Section("Explore")
        TabsAndTabPanes()
        PuttingATabPaneOnAForm()
        UsingTheKeyboard()
        AddingTabs()
        Listening()
        TheFinishedProgram()
        FindingTheChosenTab()
    end

    private action TabsAndTabPanes
        Subsection("Tabs and tab panes")
        Paragraph("A tab pane has two parts. Across the top is the "):Strong("tab bar"):Text(", a row of tabs.
Below it is the "):Strong("view area"):Text(", where the content of the chosen tab is shown.
Each tab has a name, which is the text on the tab, and a "):Strong("related item"):Text(",
which is the content it shows. Only one tab is chosen at a time. The other
tabs keep their content; it is just not drawn until you choose them again.")

        Paragraph("Each tab also has a small close button. From the keyboard, "):Keys("Ctrl", "F4"):Text("
("):Keys("Command", "W"):Text(" on a Mac or in a web browser) closes the chosen tab instead.
Closing a tab removes it from the tab pane.")
    end

    private action PuttingATabPaneOnAForm
        Subsection("Putting a tab pane on a form")
        Paragraph("A page has
actions like "):Code("AddButton"):Text(" for many controls, but there is no "):Code("AddTabPane"):Text(".
For a control like this, you make it yourself and put it on the page with
"):Code("page:Add"):Text(". The page gives it its own row.")

        Paragraph("The program below makes a study planner with three tabs. Each tab's
content is a label with a reminder. The "):Code("MakeTab"):Text(" action builds one tab, so
the same code is not written three times.")
        CodeExampleFromFile("sources/tutorials/ui/TabPane/Main.quorum")

        Paragraph("A few things to notice:")
        BulletList()
        ListItem():Strong("The size."):Text(" A tab pane starts out as wide and as tall as whatever holds
it. On a page, that is too tall, so the program sets its own size:
"):Code("SetPercentageWidth(0.8)"):Text(" makes it 80% as wide as the page, like the
page's other rows. "):Code("SetPercentageHeight(0)"):Text(" turns off the "):DoubleQuote():Text("as tall as the
page"):DoubleQuote():Text(" part, and "):Code("SetPixelHeight(300)"):Text(" makes it 300 pixels tall.")
        ListItem():Strong("The content."):Text(" "):Code("tab:SetRelatedItem(label)"):Text(" connects a tab to its
content. You never place the label yourself; the tab pane puts it in the
view area when its tab is chosen.")
        ListItem():Strong("Every tab's content can take the focus."):Text(" When a tab is chosen, the
focus moves to the first thing in its content that can take the focus,
and a screen reader reads it. "):Code("label:SetFocusable(true)"):Text(" makes the label
such a thing. Every tab's content must have at least one item that can
take the focus.")
        ListItem():Strong("The focus starts in the tab pane."):Text(" When the form opens, it gives the
focus to the first thing on the page that can take it. Here that is the
page's title. Press "):Key("Tab"):Text(" to move into the tab pane. When a tab pane gets
the focus and no tab is chosen yet, it chooses the first tab and moves
the focus into its content.")

        Paragraph("You can also add many tabs at once. An "):Strong("array"):Text(" is a group of values kept
in order, so an "):Code("Array<Tab>"):Text(" is a group of tabs. If you have one, then
"):Code("pane:Add(tabs)"):Text(" adds every tab in the array, in order. The
"):Link("Arrays tutorial", "/tutorials/language/arrays.html"):Text(" shows how to make one.")
    end

    private action UsingTheKeyboard
        Subsection("Using a tab pane with the keyboard")
        Paragraph("Every tab pane in Quorum works with the keyboard. These keys work when the
focus is anywhere inside the tab pane, on a tab or in its content:")

        Table("A tab pane's keys")
        TableHeader():Cell("What it does"):Cell("Windows and Linux"):Cell("Mac and web browser")
        TableRowWriter nextRow = TableRow()
        nextRow:Cell("Choose the next tab")
        nextRow:Cell():Keys("Ctrl", "Tab")
        nextRow:Cell():Keys("Ctrl", "]")
        TableRowWriter previousRow = TableRow()
        previousRow:Cell("Choose the previous tab")
        previousRow:Cell():Keys("Ctrl", "Shift", "Tab")
        previousRow:Cell():Keys("Ctrl", "[")
        TableRowWriter closeRow = TableRow()
        closeRow:Cell("Close the chosen tab")
        closeRow:Cell():Keys("Ctrl", "F4")
        closeRow:Cell():Keys("Cmd", "W")
        TableRowWriter leaveRow = TableRow()
        leaveRow:Cell("Leave the content and go back to the tabs")
        leaveRow:Cell():Key("Esc")
        leaveRow:Cell():Key("Esc")

        Paragraph("When the focus is on a tab, "):Key("Tab"):Text(" and "):Keys("Shift", "Tab"):Text(" move to the next or
previous tab, going around in a loop. "):Key("Space"):Text(" or "):Key("Enter"):Text(" chooses the tab
and moves the focus into its content. A screen reader reads the tab's
name, says that it is a tab, and reads its description. This is why every
tab should have a short, clear name: the name is all that many users notice
before they choose.")

        Paragraph("Because "):Key("Tab"):Text(" goes around the tabs in a loop, it doesn't move on to the
rest of the page. So put the tab pane last on its page, and put the other
controls the page needs inside its tabs.")
    end

    private action AddingTabs
        Subsection("Adding tabs while the program runs")
        Paragraph("A tab pane can change while the program runs. Next, you will add a button
that makes a new tab each time it is pressed. A button runs a "):Strong("behavior"):Text("
when it is pressed, so make a new class named "):Code("AddTabBehavior"):Text(":")
        CodeExampleFromFile("sources/tutorials/ui/TabPane/AddTabBehavior.quorum")

        Paragraph("The behavior needs to know which tab pane to add to, so "):Code("SetTabPane"):Text(" stores
it. "):Code("pane:Select(tab)"):Text(" chooses the new tab and moves the focus into its
content, so a screen reader reads the new note right away. Press "):Key("Esc"):Text("
to go back to the tabs.")
    end

    private action Listening
        Subsection("Listening for tabs that open and close")
        Paragraph("A "):Strong("listener"):Text(" is an object that a program asks to be told when something
happens. A "):Code("TabChangeListener"):Text(" is told when a tab is added to a tab pane
("):Code("OpenedTab"):Text(") and when one is closed ("):Code("ClosedTab"):Text("). Each time, it gets a
"):Code("TabChangeEvent"):Text(", and "):Code("GetTab"):Text(" returns the tab that changed. Make a class
named "):Code("TabLogger"):Text(":")
        CodeExampleFromFile("sources/tutorials/ui/TabPane/TabLogger.quorum")
    end

    private action TheFinishedProgram
        Subsection("The finished program")
        Paragraph("Where should the button go? The tab pane is last on the page, so the button
goes inside a tab. The finished program adds a first tab named Notes whose
content is the button. "):Code("DisplayCloseButton(false)"):Text(" hides the Notes tab's
close button, so the button can't be closed away by accident.")
        CodeExampleFromFile("sources/tutorials/ui/TabPane/Main2.quorum")

        Paragraph("Run the program and press "):Key("Tab"):Text(". The Notes tab is chosen and the focus is
on the button. Press it a few times, then close a note tab with its close
button or the keyboard. Each change is written to the output by
"):Code("TabLogger"):Text(".")

        BlockEditorFile("AddTabBehavior.quorum", "html/sources/tutorials/ui/TabPane/AddTabBehavior.quorum")
        BlockEditorFile("TabLogger.quorum", "html/sources/tutorials/ui/TabPane/TabLogger.quorum")
        BlockEditor("Main.quorum", "html/sources/tutorials/ui/TabPane/Main2.quorum", "", true, true)
    end

    private action FindingTheChosenTab
        Subsection("Finding the chosen tab")
        Paragraph("To find out which tab is chosen, use "):Code("GetSelectedTab"):Text(". It returns
"):Code("undefined"):Text(" if no tab is chosen, so check before you use it:")
        CodeExampleFromFile("sources/tutorials/ui/TabPane/SelectedTab.quorum")
    end

    action Engage
        Section("Engage")
        Paragraph("In this activity, you and a partner build a small "):DoubleQuote():Text("class information"):DoubleQuote():Text("
program with a tab pane on a form, and check that every tab and control can
be reached with and without a mouse. The goal is to organize information into tabs,
and to understand how focus moves between the tabs and what's inside them.
Start by planning three or four tabs together, such as Schedule, Homework
and Contacts, and decide what each one shows. Then build the tab pane, with
a name and a description on every tab, and make sure each tab's content
can take the focus. Put a button inside one tab. Press "):Key("Esc"):Text(" from that
button and check that the focus goes back to the tabs. When it works, trade programs with your partner.")
    end

    action WrapUp
        Section("Wrap up")
        Paragraph("Tabs save space, but they also hide things. When is a tab pane a good
choice, and when would a single page, or a menu, be better? Think about what
a user can no longer find when a tab is not chosen.")

        Paragraph("In the next tutorial, "):Link("Menus", "/tutorials/ui/menu.html"):Text(", you will give a
program a menu bar.")
    end
end
