use Libraries.Web.Page.all
use Libraries.Web.Page.Standards.ComputerScienceStandards2026
use Libraries.Web.Page.Standards.QuorumStandards

/*
    Tutorial: Menus, part of the user interface series.
*/
class UserInterfacesMenu is QuorumPage
    // The site's sets of standards, built once for every page.
    QuorumStandards standards

    on create
        SetLocation("tutorials/ui/menu.html")
        SetShortTitle("Menus")
        SetSectionName("User Interfaces")
    end

    action Setup
        // For search engines and link previews.
        SetDescription("How to put a menu bar on a Quorum form, fill it with menus and submenus, connect commands to behaviors, add mnemonics and keyboard shortcuts, and use a menu from the keyboard.")

        Title("Menus")

        Overview()
        WarmUp()
        Explore()
        Engage()
        WrapUp()
    end

    action Overview
        Section("Overview")
        Paragraph("Most desktop programs have a "):Strong("menu bar"):Text(": a row of words such as File,
Edit and Help along the top of the window. Choosing one opens a "):Strong("menu"):Text(", a
list of commands. Some commands open another, smaller menu called a
"):Strong("submenu"):Text(". Menus let a program offer many commands without filling the
screen with buttons. In this tutorial, you will put a menu bar at the top of
a page, fill it with menus and submenus, connect each command to a
behavior, and add keyboard shortcuts. You will also learn how a keyboard or
screen reader user moves through a menu.")

        Subsection("Goals")
        Paragraph("You have the following goals for this tutorial:")
        Goals()
        ListItem("Build a "):Code("MenuBar"):Text(" out of "):Code("MenuItem"):Text(" objects, with menus and submenus, and put it on a page")
        ListItem("Connect a menu command to a behavior so that choosing it does something")
        ListItem("Add mnemonics and keyboard shortcuts to menu items")
        ListItem("Use "):Code("GetMenuPath"):Text(" to find out where a chosen command sits in the menu")
        ListItem("Compare the roles that people, companies and a government played in
shaping menus and windows")
    end

    action WarmUp
        Section("Warm up")
        Paragraph("Open a program you use often, like a word processor or a web browser, and
explore its menu bar. Which menus does it have? Pick one command and write
down every step it takes to reach it. Is there a faster way, like a
shortcut shown next to the command? Why do you think most programs put
File first and Help last?")

        Subsection("Vocabulary")
        Paragraph("You will be learning about the following vocabulary words:")
        Table("Vocabulary", "media/userInterface/Menu/Vocabulary.csv")

        Subsection("New Code to Learn")
        Paragraph("You will be using the following new pieces of code:")
        Table("New Code to Learn", "media/userInterface/Menu/Code.csv")

        Subsection("CSTA Standards")
        Paragraph("This tutorial covers the following "):Link("CSTA standards", "https://csteachers.org/pk12standards/view/"):Text(":")
        ComputerScienceStandards2026 computerScience = standards:GetComputerScience2026()
        CoversStandard(computerScience, computerScience:HIGH_SCHOOL_PROGRAM_DEVELOPMENT_12)
        CoversStandard(computerScience, computerScience:MIDDLE_SCHOOL_PROGRAM_DEVELOPMENT_12)
        CoversStandard(computerScience, computerScience:MIDDLE_SCHOOL_TESTING_AND_REFINING_20)
        CoversStandard(computerScience, computerScience:MIDDLE_SCHOOL_HISTORY_OF_COMPUTING_38)
        CoversStandard(computerScience, computerScience:SPECIALTY_1_SOFTWARE_DEVELOPMENT_USER_EXPERIENCE_5)
        CoversStandard(computerScience, computerScience:HIGH_SCHOOL_HISTORY_OF_COMPUTING_38)
        StandardsList(computerScience)
    end

    action Explore
        Section("Explore")
        HowAMenuIsBuilt()
        ABehaviorForTheCommands()
        PuttingAMenuBarOnAPage()
        UsingTheKeyboard()
        Mnemonics()
        KeyboardShortcuts()
        FindingThePath()
        WhereMenusCameFrom()
    end

    private action HowAMenuIsBuilt
        Subsection("How a menu is built")
        Paragraph("In Quorum, every part of a menu is a "):Code("MenuItem"):Text(". A menu item on its own is a
"):Strong("command"):Text(". When you add other items to it, it becomes a "):Strong("menu"):Text(" that
holds them. This means a menu is built like a tree:")
        BulletList()
        ListItem("the "):Code("MenuBar"):Text(" holds the top-level items, such as Animals and Help;")
        ListItem("each top-level item holds the commands or submenus in its menu;")
        ListItem("a submenu, such as Pets, holds its own commands.")

        Paragraph("In this tutorial you will build this menu:")
        BulletList()
        ListItem("Animals")
        NestedBulletList()
        ListItem("Pets: Dog, Cat")
        ListItem("Farm: Cow, Duck")
        EndNestedList()
        ListItem("Help")
        NestedBulletList()
        ListItem("About")
        EndNestedList()
    end

    private action ABehaviorForTheCommands
        Subsection("A behavior for the commands")
        Paragraph("Each command needs something to do. Every command in this program shows a
message, so one behavior class can serve all of them. Add a new class named
"):Code("OutputBehavior"):Text(". It remembers a label and a message, and when it runs, it puts
the message on the label and writes it to the output:")
        CodeExampleFromFile("sources/tutorials/ui/Menu/OutputBehavior.quorum")
    end

    private action PuttingAMenuBarOnAPage
        Subsection("Putting a menu bar on a page")
        Paragraph("A page has an "):Code("Add"):Text(" action for each common control, like "):Code("AddButton"):Text(" and
"):Code("AddLabel"):Text(". There is no "):Code("AddMenuBar"):Text(". Instead, you make the menu bar
yourself and give it to the page's plain "):Code("Add"):Text(" action. The page puts it in
a row of its own, like everything else, and stretches it across the full
width of the window. Add the menu bar "):Strong("first"):Text(", so it sits at the top of
the page, above everything else.")

        Paragraph("Now replace "):Code("Main.quorum"):Text(". The "):Code("MakeCommand"):Text(" action builds one command,
gives it an "):Code("OutputBehavior"):Text(", and returns it, so each command takes one line.")
        CodeExampleFromFile("sources/tutorials/ui/Menu/Main.quorum")

        Paragraph("Some things to notice:")
        BulletList()
        ListItem():Code("page:Add(bar)"):Strong(" comes first."):Text(" A page shows its controls from top to
bottom in the order you add them, so the menu bar is the top row and the
message is below it.")
        ListItem():Code("AddLabel"):Strong(" gives back the label."):Text(" The program keeps it in "):Code("message"):Text(",
so every "):Code("OutputBehavior"):Text(" can change its text.")
        ListItem():Strong("Build from the top down."):Text(" Add a menu to its parent before you add
items to it. For example, "):Code("animals:Add(pets)"):Text(" comes before
"):Code("pets:Add(...)"):Text(". A submenu shows its small arrow only if it already has a
parent menu when its first item is added.")
        ListItem():Code("SetName"):Strong(" is the text on the item."):Text(" It is also what a screen reader
reads, so keep it short and clear.")
        ListItem():Strong("Only commands get behaviors."):Text(" Animals, Pets and Farm only open menus,
so they have no behavior.")
        ListItem():Strong("The form sets the "):Key("Tab"):Strong(" order for you."):Text(" The menu bar can take the
keyboard focus, so it is part of the page's "):Key("Tab"):Text(" order, just like a
button. Because it is first on the page, it has the focus when the app
starts. Press "):Key("Tab"):Text(" to move to the message, and "):Keys("Shift", "Tab"):Text(" to move back.")
    end

    private action UsingTheKeyboard
        Subsection("Using a menu with the keyboard")
        Paragraph("Every Quorum menu works with the keyboard. When the menu bar first gets the
focus, nothing on it is chosen yet. Press "):Key("Right"):Text(" to choose the first menu,
or press a menu's mnemonic letter. Then use these keys:")

        Table("A menu's keys")
        TableHeader():Cell("Key"):Cell("What it does")
        TableRowWriter rightRow = TableRow()
        rightRow:Cell():Key("Right arrow")
        rightRow:Cell("Moves to the next menu on the menu bar. On an item that holds a submenu it opens the submenu.")
        TableRowWriter leftRow = TableRow()
        leftRow:Cell():Key("Left arrow")
        leftRow:Cell("Moves to the previous menu on the menu bar or closes a submenu.")
        TableRowWriter downRow = TableRow()
        downRow:Cell():Key("Down arrow")
        downRow:Cell("Opens the chosen menu or moves down one item.")
        TableRowWriter upRow = TableRow()
        upRow:Cell():Key("Up arrow")
        upRow:Cell("Opens the chosen menu or moves up one item.")
        TableRowWriter enterRow = TableRow()
        enterRow:Cell():Key("Enter"):Text(" or "):Key("Space")
        enterRow:Cell("Runs the chosen command or opens the chosen menu.")
        TableRowWriter escapeRow = TableRow()
        escapeRow:Cell():Key("Esc")
        escapeRow:Cell("Closes the open submenu or menu. Pressed again it gives the focus back to where it was before the menu bar.")
        TableRowWriter letterRow = TableRow()
        letterRow:Cell("A letter")
        letterRow:Cell("Chooses the item whose mnemonic is that letter.")

        Paragraph("When you choose a command, the menu closes and the keyboard focus goes back
to the control that had it before you moved to the menu bar.")

        Paragraph("A screen reader reads each item's name as you move, so every item needs a
clear name.")

        Paragraph("Notice that no single key jumps to the menu bar from somewhere else on the
page. In a form, you reach it with "):Key("Tab"):Text(" and "):Keys("Shift", "Tab"):Text(", like any other
control. Putting it first on the page keeps it easy to find.")
    end

    private action Mnemonics
        Subsection("Mnemonics")
        text quote = ""
        quote = quote:GetDoubleQuote()
        Paragraph("A "):Strong("mnemonic"):Text(" is one letter that chooses a menu item from the keyboard.
In "):Code("Main"):Text(", "):Code("animals:SetMnemonic(" + quote + "a" + quote + ")"):Text(" means that pressing "):Key("A"):Text(" while the
menu bar has the focus opens the Animals menu and chooses its first item.
Mnemonics work for the items of an open menu too, so you could give Pets
the mnemonic "):Code("p"):Text(" and Farm the mnemonic "):Code("f"):Text(". Pick letters that are in the
item's name, and do not use the same letter twice in one menu.")
    end

    private action KeyboardShortcuts
        Subsection("Keyboard shortcuts")
        Paragraph("A "):Strong("shortcut"):Text(" runs a command without opening any menu. Shortcuts are made
from an "):Code("InputSet"):Text(", which describes a key and any modifier keys held with
it. You only need four lines of it here: "):Code("KeyboardEvent"):Text(" holds a constant
for every key, such as "):Code("keys:D"):Text(", "):Code("SetKeyboardInput"):Text(" chooses the key, and
"):Code("AddModifier"):Text(" adds a key that must be held with it, such as "):Code("CONTROL"):Text(". The
"):Link("Input Sets", "/tutorials/ui/inputSet.html"):Text(" tutorial covers input sets in
full.")

        Paragraph("There is one catch. A shortcut is added to the running app's list of keys,
so it can only be set once the app's window is open. The lines in
"):Code("action Main"):Text(" run before "):Code("form:Display()"):Text(" opens the window. To set a
shortcut after the window opens, the program itself becomes a "):Code("Form"):Text(": the
class says "):Code("is Form"):Text(", and its "):Code("CreateGame"):Text(" action runs once the window is
open. "):Code("CreateGame"):Text(" first calls "):Code("parent:Form:CreateGame()"):Text(", so the form still
does all of its own setup, then sets the shortcut.")

        Paragraph("Here is the whole program again, now with the shortcut "):Keys("Ctrl", "D"):Text(" for Dog:")
        CodeExampleFromFile("sources/tutorials/ui/Menu/Main2.quorum")

        Paragraph("What changed:")
        BulletList()
        ListItem():Code("class Main is Form"):Text(" means "):Code("Main"):Text(" is the form. So it calls
"):Code("GetMainPage()"):Text(" and "):Code("Display()"):Text(" itself, with no "):Code("form:"):Text(" in front.")
        ListItem("Dog is kept in the "):Code("dog"):Text(" variable so "):Code("CreateGame"):Text(" can reach it.")
        ListItem():Code("CreateGame"):Text(" sets the shortcut once the window is open.")

        Paragraph("The menu now shows "):DoubleQuote():Text("Control + D"):DoubleQuote():Text(" next to Dog, and pressing "):Keys("Ctrl", "D"):Text(" runs
the Dog command even when the menu is closed. Shortcuts help everyone work
faster, and they matter most to people who use only a keyboard.")
    end

    private action FindingThePath
        Subsection("Finding the path to a command")
        Paragraph("Sometimes a behavior needs to know which menu item ran it. The
"):Code("BehaviorEvent"):Text(" that "):Code("Run"):Text(" gets holds that item, and a menu item's
"):Code("GetMenuPath"):Text(" action returns every item from the top of the menu down to
it. For Dog, the path is Animals, Pets, Dog. Here is "):Code("OutputBehavior"):Text(" again,
now writing the path to the output as well:")
        CodeExampleFromFile("sources/tutorials/ui/Menu/OutputBehavior2.quorum")

        Paragraph("The "):Code("is MenuItem"):Text(" check matters. A behavior can be used by other controls
too, such as a button, and then the item is not a menu item. You will use
"):Code("OutputBehavior"):Text(" with buttons in the "):Link("Toolbars", "/tutorials/ui/toolbar.html"):Text("
tutorial.")

        BlockEditorFile("OutputBehavior.quorum", "html/sources/tutorials/ui/Menu/OutputBehavior2.quorum")
        BlockEditor("Main.quorum", "html/sources/tutorials/ui/Menu/Main2.quorum", "", true, true)
    end

    private action WhereMenusCameFrom
        Subsection("Where menus came from")
        Paragraph("Menus and windows were shaped by people, companies and a government. In
1968, Douglas Engelbart and his team at the Stanford Research Institute
showed NLS, a system with a mouse and windows on the screen. Its funding
came from DARPA, a research agency of the US government, and the US Air
Force ("):Link("source", "https://www.darpa.mil/node/2102"):Text("). In the 1970s, researchers
at Xerox's Palo Alto Research Center (PARC) built the Alto, a computer
used through windows, icons, menus and a mouse. In 1979, a group from Apple
led by Steve Jobs visited PARC. Apple's Lisa, released in 1983, had a menu
bar of pull-down menus at the top of the screen, and the Macintosh followed
in 1984. Microsoft first released Windows in 1985
("):Link("source", "https://computerhistory.org/blog/the-lisa-apples-most-influential-failure/"):Text(").")
    end

    action Engage
        Section("Engage")
        Paragraph("In this activity, you and a partner design and build the menu bar for a
simple drawing program, and test how quickly it can be used. The goal is to organize commands into menus, and to choose
mnemonics and shortcuts that make common commands fast. Plan it first, on
paper or with physical manipulatives such as sticky notes or index cards: decide on three menus, the commands in each, at least one submenu, a
mnemonic for each top-level menu, and two shortcuts. Then build it in
Quorum on a page, using "):Code("OutputBehavior"):Text(" so each command writes what it would
do.")

        Paragraph("When it works, swap programs. Your partner runs every command with the
keyboard, the mouse or another device they use, and says out loud how they
reached each one. Find the command your partner used most, and count the
steps it took, such as key presses, clicks or taps. Could a
shortcut, or moving it to a different menu, make it shorter? Ask your
partner which command was the hardest to find. Change one thing in your
design based on what your partner told you and what you counted.")
    end

    action WrapUp
        Section("Wrap up")
        Paragraph("Menus hide commands until you ask for them. That saves space but makes
commands harder to discover. How do mnemonics and shortcuts change that
trade-off? Which commands in your own program deserve a shortcut, and why?
In "):DoubleQuote():Text("Where menus came from"):DoubleQuote():Text(", what did the government do that a company
could not, and what did the companies do that the researchers did not?")

        Paragraph("The next tutorial covers "):Link("Popup Menus", "/tutorials/ui/popupMenu.html"):Text(", menus
that appear right where you need them instead of on a bar.")
    end
end
