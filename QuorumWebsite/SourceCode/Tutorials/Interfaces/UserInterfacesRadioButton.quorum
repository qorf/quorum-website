use Libraries.Web.Page.all
use Libraries.Web.Page.Standards.ComputerScienceStandards2026
use Libraries.Web.Page.Standards.QuorumStandards

/*
    Tutorial: Radio Buttons, part of the user interface series.
*/
class UserInterfacesRadioButton is QuorumPage
    // The site's sets of standards, built once for every page.
    QuorumStandards standards

    on create
        SetLocation("tutorials/ui/radioButton.html")
        SetShortTitle("Radio Buttons")
        SetSectionName("User Interfaces")
    end

    action Setup
        // For search engines and link previews.
        SetDescription("How to use radio buttons in Quorum: put them in a grouping on a page, find out which one is picked, and move through a group with the arrow keys.")

        Title("Radio Buttons")

        Overview()
        WarmUp()
        Explore()
        Engage()
        WrapUp()
    end

    action Overview
        Section("Overview")
        Paragraph("Radio buttons let a person pick exactly one choice from a short list, like a
pizza size or a game's difficulty. Picking one choice clears the one that was
picked before. The name comes from old car radios, where pushing in one
station button popped the others out. In this tutorial, you will put radio
buttons in a grouping on a page, read which one is picked, and learn how
people move through a group with the arrow keys.")

        Subsection("Goals")
        Paragraph("You have the following goals for this tutorial:")
        Goals()
        ListItem("Put radio buttons in a grouping so that only one can be picked at a time")
        ListItem("Find out which radio button is picked with "):Code("GetSelectedButton")
        ListItem("Explain how the keyboard works in a group: "):Key("Tab"):Text(" to reach it, arrow keys to
change the choice")
        ListItem("Decide when to use radio buttons and when to use checkboxes")
    end

    action WarmUp
        Section("Warm up")
        Paragraph("Think of a form you have filled out, on paper or online. Find a question where
you could pick only one answer and a question where you could pick several.
How did the form show you the difference? What would go wrong if the two
kinds were mixed up?")

        Subsection("Vocabulary")
        Paragraph("You will be learning about the following vocabulary words:")
        Table("Vocabulary", "media/userInterface/RadioButton/Vocabulary.csv")

        Subsection("New Code to Learn")
        Paragraph("You will be using the following new pieces of code:")
        Table("New Code to Learn", "media/userInterface/RadioButton/Code.csv")

        Subsection("CSTA Standards")
        Paragraph("This tutorial covers the following "):Link("CSTA standards", "https://csteachers.org/pk12standards/view/"):Text(":")
        ComputerScienceStandards2026 computerScience = standards:GetComputerScience2026()
        CoversStandard(computerScience, computerScience:HIGH_SCHOOL_TESTING_AND_REFINING_19)
        CoversStandard(computerScience, computerScience:MIDDLE_SCHOOL_TESTING_AND_REFINING_19)
        CoversStandard(computerScience, computerScience:SPECIALTY_1_SOFTWARE_DEVELOPMENT_USER_EXPERIENCE_4)
        CoversStandard(computerScience, computerScience:MIDDLE_SCHOOL_ALGORITHMIC_PROBLEM_SOLVING_3)
        CoversStandard(computerScience, computerScience:HIGH_SCHOOL_ALGORITHMIC_PROBLEM_SOLVING_3)
        StandardsList(computerScience)
    end

    action Explore
        Section("Explore")
        WhatAreRadioButtons()
        MakingRadioButtons()
        FindingThePickedOne()
        UsingTheKeyboard()
        OnAPhoneOrTablet()
        ReactingToChanges()
        RadioButtonsOrCheckboxes()
    end

    private action WhatAreRadioButtons
        Subsection("What are radio buttons?")
        Paragraph("In the "):Link("Checkboxes", "/tutorials/ui/checkbox.html"):Text(" tutorial, you met the "):Strong("toggle button"):Text(": a button that remembers whether it is on or off. In Quorum,
these all come from the "):Code("ToggleButton"):Text(" class. "):Code("Checkbox"):Text(" is one kind of toggle
button. "):Code("RadioButton"):Text(" is another.")

        Paragraph("The difference is in how they turn off. A checkbox turns off when you activate
it again. A radio button does not. Once it is picked, it stays picked until a
different radio button in the same group is picked. This makes radio buttons
right for questions with exactly one answer.")

        Paragraph("That only works if the radio buttons know about each other. On a page, they
do this through a "):Strong("grouping"):Text(", which you met in the "):Link("Groupings", "/tutorials/ui/groupings.html"):Text(" tutorial. A grouping that holds radio
buttons turns all the others off when one is turned on.")
    end

    private action MakingRadioButtons
        Subsection("Making radio buttons on a page")
        Paragraph("A page's "):Code("AddGrouping"):Text(" action makes a grouping. Then the grouping's "):Code("AddRadioButton"):Text(" action makes a radio button, puts it in the group and shows
it, all in one step. The page puts the radio buttons side by side, in one
row, each with an equal share of the width.")

        Paragraph("The grouping's name, "):DoubleQuote():Text("Pizza size"):DoubleQuote():Text(", is what a screen reader says when the group
gets the focus. A person who can see the screen needs the question too, so
the program also adds a label above the grouping.")
        CodeExampleFromFile("sources/tutorials/ui/RadioButton/Main.quorum")

        Paragraph("The line "):Code("medium:SetToggleState(true)"):Text(" picks "):DoubleQuote():Text("Medium"):DoubleQuote():Text(" before the form appears.
It's good practice to start with a sensible choice already picked, so that the
question always has an answer.")
    end

    private action FindingThePickedOne
        Subsection("Finding out which one is picked")
        Paragraph("A grouping's "):Code("GetSelectedButton"):Text(" action returns the toggle button that is
picked. If nothing is picked yet, it returns "):Code("undefined"):Text(", so check for that.
Make a class in a file named "):Code("SizeBehavior.quorum"):Text(". It is a "):Code("FormBehavior"):Text(",
so it can find the grouping and the label on the page by their names:")
        CodeExampleFromFile("sources/tutorials/ui/RadioButton/SizeBehavior.quorum")

        Paragraph():Code("GetSelectedButton"):Text(" returns a "):Code("ToggleButton"):Text(", the parent class of "):Code("RadioButton"):Text(", which is why the behavior uses "):Code("ToggleButton"):Text(" and not "):Code("RadioButton"):Text(".")

        BlockEditorFile("SizeBehavior.quorum", "html/sources/tutorials/ui/RadioButton/SizeBehavior.quorum")
        BlockEditor("Main.quorum", "html/sources/tutorials/ui/RadioButton/Main.quorum", "", true, true)
    end

    private action UsingTheKeyboard
        Subsection("Using the keyboard: one Tab stop, then arrow keys")
        Paragraph("A group of radio buttons is one stop in the "):Key("Tab"):Text(" order, not one stop per
button. The "):Strong("group"):Text(" gets the focus, not the radio buttons inside it:")

        BulletList()
        ListItem("Press "):Key("Tab"):Text(" or "):Keys("Shift", "Tab"):Text(" to move the focus to the group. If nothing was
picked yet, the first radio button is picked for you.")
        ListItem("Press "):Key("Down Arrow"):Text(" or "):Key("Right Arrow"):Text(" to pick the next choice. Press "):Key("Up Arrow"):Text("
or "):Key("Left Arrow"):Text(" to pick the previous one. At the end of the list, the arrows
wrap around to the other end.")
        ListItem("Press "):Key("Tab"):Text(" again to leave the group.")

        Paragraph("You don't write any code for this. The grouping does it. This is the same
way radio buttons work in web pages and desktop programs, so people who use a
keyboard or a screen reader already know it. It also keeps the "):Key("Tab"):Text(" order
short: a group with ten choices is still one "):Key("Tab"):Text(" stop.")

        Paragraph("A screen reader says the group's name when the group gets the focus, and the
radio button that is picked. As the person presses the arrow keys, it says
each new choice. The exact words depend on the screen reader.")
    end

    private action OnAPhoneOrTablet
        Subsection("On a phone or tablet")
        BulletList()
        ListItem():Strong("With touch:"):Text(" tap a choice to pick it. The choice that was picked before
is unpicked for you.")
        ListItem():Strong("With VoiceOver (iPhone and iPad) or TalkBack (Android) on:"):Text(" swipe
right to move to the next choice and left to move to the previous one.
Each radio button is its own stop, so the screen reader reads each choice
and whether it is picked. Double-tap anywhere on the screen to pick the
choice it is on.")
    end

    private action ReactingToChanges
        Subsection("Reacting when the choice changes")
        Paragraph("Like a checkbox, a radio button can have a behavior. Its "):Code("Run"):Text(" action is
called each time that radio button is picked, whether by a click, an arrow key
or code. You can give the same behavior to every radio button in a group and
use the event to find out which one was picked:")
        CodeExampleFromFile("sources/tutorials/ui/RadioButton/PickedBehavior.quorum")

        Paragraph("To use it, add these lines to "):Code("Main.quorum"):Text(" after the radio buttons are made, and
before "):Code("medium:SetToggleState(true)"):Text(":")
        CodeExampleFromFile("sources/tutorials/ui/RadioButton/AddPickedBehavior.quorum")

        Paragraph("When a different radio button is picked, the old one is turned off, and the
grouping calls the old one's behavior's "):Code("Dispose"):Text(" action. You can use "):Code("Dispose"):Text(" to undo whatever "):Code("Run"):Text(" did.")
    end

    private action RadioButtonsOrCheckboxes
        Subsection("Radio buttons or checkboxes?")
        Paragraph("Use this rule:")

        BulletList()
        ListItem():Strong("Exactly one answer?"):Text(" Use radio buttons. Example: pizza size.")
        ListItem():Strong("Any number of answers, including none?"):Text(" Use checkboxes. Example: pizza
toppings.")
        ListItem():Strong("A single yes-or-no?"):Text(" Use one checkbox, not two radio buttons labeled "):DoubleQuote():Text("Yes"):DoubleQuote():Text(" and "):DoubleQuote():Text("No."):DoubleQuote()
    end

    action Engage
        Section("Engage")
        Paragraph("In this activity, you write a short quiz with three multiple-choice
questions. The goal is to use radio buttons for choices where only one
answer can be picked, and to think about how a quiz should start. Each
question is a label and a grouping of radio buttons, and a "):DoubleQuote():Text("Check answers"):DoubleQuote():Text("
button shows in a label how many answers are right. Give each grouping a
name that is the question, such as "):DoubleQuote():Text("What is 6 times 7?"):DoubleQuote():Text(", and give each radio
button a clear name. Then decide whether each question should start with a
choice already picked. For a quiz, is that fair? Explain your decision in a
comment in your code.")

        Paragraph("Before you test, write a short test plan: for each question, which choices
you will pick and what the label should say. Include all right, all wrong,
and a mix. Run your plan using only the keyboard: "):Key("Tab"):Text(" to each question and
the arrow keys to choose an answer. Then check your quiz against this list:")

        BulletList()
        ListItem("Does "):Key("Tab"):Text(" stop once on each question, and do the arrow keys change the
answer?")
        ListItem("Does every row of your test plan give the label you wrote down?")
        ListItem("Would each question's name make sense to someone who had never seen the
quiz?")

        Paragraph("Fix anything that doesn't match, and write down each change you made and
why, in a comment at the top of your code.")
    end

    action WrapUp
        Section("Wrap up")
        Paragraph("Radio buttons are toggle buttons that live in a group. The group makes sure
only one is picked, takes the focus for all of them, and lets people change
the choice with the arrow keys. Think about the warm up again: why do you
think the keyboard works differently for a group of radio buttons than for a
list of checkboxes?")
    end
end
