use Libraries.Web.Page.all
use Libraries.Web.Page.Standards.ComputerScienceStandards2026
use Libraries.Web.Page.Standards.QuorumStandards

/*
    Tutorial: Color Wells, part of the user interface series.
*/
class UserInterfacesColorWell is QuorumPage
    // The site's sets of standards, built once for every page.
    QuorumStandards standards

    on create
        SetLocation("tutorials/ui/colorWell.html")
        SetShortTitle("Color Wells")
        SetSectionName("User Interfaces")
    end

    action Setup
        // For search engines and link previews.
        SetDescription("How to add color wells to a Quorum form, read the color a person chose, check whether two colors are easy to read together and react when a color changes.")

        Title("Color Wells")

        Overview()
        WarmUp()
        Explore()
        Engage()
        WrapUp()
    end

    action Overview
        Section("Overview")
        Paragraph("A color well is a button that shows a color. You find them in drawing apps,
slide editors and website builders, anywhere a person picks the color of a
shape, a background or some text. Pressing the well opens a color picker,
where a person can choose a new color with a color wheel, sliders, a hex
code or a row of ready-made colors. In this tutorial, you will add color
wells to a form, read the color a person chose, check whether two colors are
easy to read together, and make your program react the moment a color
changes.")

        Subsection("Goals")
        Paragraph("You have the following goals for this tutorial:")
        Goals()
        ListItem("Add a color well to a form with "):Code("AddColorWell"):Text(" and give it a clear name")
        ListItem("Read the chosen color with "):Code("GetColor"):Text(" and "):Code("GetColorText")
        ListItem("Use a "):Code("ColorWellListener"):Text(" to react when a person picks a new color")
        ListItem("Check whether text will be easy to read on a background with "):Code("CalculateContrast")
        ListItem("Explain how a person using a keyboard or a screen reader picks a color")
    end

    action WarmUp
        Section("Warm up")
        Paragraph("Think of a poster or a slide that was hard to read. What made it hard? Was it
the size of the text, or the colors? Now think about how you would tell
someone a color without showing it to them. Would you say "):DoubleQuote():Text("blue"):DoubleQuote():Text("? Which blue?")

        Subsection("Vocabulary")
        Paragraph("You will be learning about the following vocabulary words:")
        Table("Vocabulary", "media/userInterface/ColorWell/Vocabulary.csv")

        Subsection("New Code to Learn")
        Paragraph("You will be using the following new pieces of code:")
        Table("New Code to Learn", "media/userInterface/ColorWell/Code.csv")

        Subsection("CSTA Standards")
        Paragraph("This tutorial covers the following "):Link("CSTA standards", "https://csteachers.org/pk12standards/view/"):Text(":")
        ComputerScienceStandards2026 computerScience = standards:GetComputerScience2026()
        CoversStandard(computerScience, computerScience:HIGH_SCHOOL_IMPACTS_OF_ALGORITHMS_AND_DESIGN_9)
        CoversStandard(computerScience, computerScience:MIDDLE_SCHOOL_IMPACTS_OF_ALGORITHMS_AND_DESIGN_9)
        CoversStandard(computerScience, computerScience:SPECIALTY_1_SOFTWARE_DEVELOPMENT_USER_EXPERIENCE_4)
        CoversStandard(computerScience, computerScience:HIGH_SCHOOL_ALGORITHMIC_PROBLEM_SOLVING_3)
        StandardsList(computerScience)
    end

    action Explore
        Section("Explore")
        WhatIsAColorWell()
        MakingColorWells()
        ReadingTheColor()
        ChoosingWithTheKeyboard()
        ReactingToChanges()
        WhatAScreenReaderSays()
        ColorsOfTheWell()
    end

    private action WhatIsAColorWell
        Subsection("What is a color well?")
        Paragraph("A computer stores a color as three numbers: how much red, how much green and
how much blue light to mix. Quorum's "):Code("Color"):Text(" class keeps each of these as a
number from 0 to 1. People rarely think about colors that way, though, so
programs let them pick colors directly instead, with the mouse or the
keyboard. A "):Strong("color
well"):Text(" is the control that does this. It is a kind of
"):Link("button", "/tutorials/ui/button.html"):Text(": it shows a small square of its color and
the color's "):Strong("hex code"):Text(", such as "):Code("#2F5BBB"):Text(". Pressing it opens a "):Strong("color
picker"):Text(" just below it.")

        Paragraph("The color picker has several ways to choose the same thing, so a person can
use whichever is easiest for them:")

        BulletList()
        ListItem("a "):Strong("hue ring"):Text(", a circle of colors around the edge that picks the hue;")
        ListItem("a square inside the ring that picks the "):Strong("saturation"):Text(" (from gray at the
left to full color at the right) and the "):Strong("brightness"):Text(" (from black at the
bottom to bright at the top);")
        ListItem():Code("Red"):Text(", "):Code("Green"):Text(" and "):Code("Blue"):Text(" slider fields, each from 0 to 255, like the ones
in the "):Link("Sliders", "/tutorials/ui/slider.html"):Text(" tutorial;")
        ListItem("a "):Code("Hex"):Text(" field to type a hex code into;")
        ListItem("16 "):Strong("swatches"):Text(", the basic colors of HTML and CSS, such as black, red,
navy and teal;")
        ListItem():Code("Cancel"):Text(" and "):Code("OK"):Text(" buttons.")

        Paragraph("Changing any part changes the others, and the well shows the new color as it
changes. "):Code("OK"):Text(" keeps the new color. "):Code("Cancel"):Text(" puts the old one back.")
    end

    private action MakingColorWells
        Subsection("Making color wells on a form")
        Paragraph("The easiest way to make a color well is on a form, which you met in the
"):Link("Forms", "/tutorials/ui/forms.html"):Text(" tutorial. A page's "):Code("AddColorWell"):Text(" action
makes a color well, adds it to the page and returns it. The first value is the
well's name. A screen reader says the name, so it should say what the color
is for, such as "):DoubleQuote():Text("Background color."):DoubleQuote():Text(" The second value is the color it starts
with. If you leave the color out, the well starts black.")

        Paragraph("A color well shows its hex code, not its name. That means a person who can see
the screen needs a label to know what each well is for. Add a label with
"):Code("AddLabel"):Text(" just before each well.")

        Paragraph("The program below makes a poster designer with two wells, one for the
background and one for the text, and a button that checks the colors.")
        CodeExampleFromFile("sources/tutorials/ui/ColorWell/Main.quorum")

        Paragraph():Code("palette:Navy()"):Text(" and "):Code("palette:White()"):Text(" are two of the colors the "):Code("Color"):Text(" class
has ready-made. You can also make any color from its hex code with
"):Code("SetHexColor"):Text(":")
        CodeExampleFromFile("sources/tutorials/ui/ColorWell/HexColor.quorum")
    end

    private action ReadingTheColor
        Subsection("Reading the chosen color")
        Paragraph("A color well has two ways to tell you its color:")

        BulletList()
        ListItem():Code("GetColor"):Text(" returns a copy of the color as a "):Code("Color"):Text(" object, which you can
use for drawing or for math;")
        ListItem():Code("GetColorText"):Text(" returns the color as words: its hex code, then the name of
the closest named color. Navy is "):DoubleQuote():Text("#000080, navy,"):DoubleQuote():Text(" and "):Code("#4A5A6E"):Text(" is
"):DoubleQuote():Text("#4A5A6E, dim gray."):DoubleQuote()

        Paragraph("The name comes after the hex code because it is only the closest of a list of
about 140 named colors, so it is a good hint, not an exact answer.")

        Paragraph("The "):Code("Color"):Text(" class can also measure how readable two colors are together. Its
"):Code("CalculateContrast"):Text(" action returns the "):Strong("contrast ratio"):Text(" between two colors,
a number from 1 (the same lightness) to 21 (black on white). The Web Content
Accessibility Guidelines, a standard from the W3C, ask for a ratio of at least
4.5 to 1 for normal-size text, in success criterion 1.4.3, "):DoubleQuote():Text("Contrast
(Minimum)"):DoubleQuote():Text(" ("):Link("WCAG 2.1", "https://www.w3.org/TR/WCAG21/#contrast-minimum"):Text(").")

        Paragraph("Make a class in a file named "):Code("CheckColorsBehavior.quorum"):Text(". It comes from
"):Code("FormBehavior"):Text(", which gives it the "):Code("GetPage"):Text(" action, so it can find each color
well by its name with "):Code("GetColorWell"):Text(".")
        CodeExampleFromFile("sources/tutorials/ui/ColorWell/CheckColorsBehavior.quorum")

        Paragraph("Run the program and press "):DoubleQuote():Text("Check colors."):DoubleQuote():Text(" Navy and white are far apart, so
the contrast is high. Now open the text well, pick the gray swatch, press
"):Code("OK"):Text(" and check again. Gray on navy is much harder to read.")
    end

    private action ChoosingWithTheKeyboard
        Subsection("Choosing a color with the keyboard")
        Paragraph("Everything in the picker works from the keyboard:")

        Table("The color picker's keys")
        TableHeader():Cell("Key"):Cell("What it does")
        TableRowWriter openRow = TableRow()
        openRow:Cell():Key("Space"):Text(" or "):Key("Enter"):Text(" on the well")
        openRow:Cell("Opens the picker, with the focus on the hue ring")
        TableRowWriter tabRow = TableRow()
        tabRow:Cell():Key("Tab"):Text(", "):Keys("Shift", "Tab")
        tabRow:Cell():Text("Moves through the ring, the square, the red, green and blue sliders and their number fields, the hex field, the swatches, "):Code("Cancel"):Text(" and "):Code("OK")
        TableRowWriter ringRow = TableRow()
        ringRow:Cell():Key("Left"):Text(", "):Key("Right"):Text(" (or "):Key("Up"):Text(", "):Key("Down"):Text(") on the ring")
        ringRow:Cell():Text("Turns the hue 10 degrees; with "):Key("Shift"):Text(", 1 degree")
        TableRowWriter pageRow = TableRow()
        pageRow:Cell():Key("Page Up"):Text(", "):Key("Page Down"):Text(" on the ring")
        pageRow:Cell("Turns the hue 30 degrees")
        TableRowWriter saturationRow = TableRow()
        saturationRow:Cell():Key("Left"):Text(", "):Key("Right"):Text(" on the square")
        saturationRow:Cell():Text("Lowers or raises the saturation 10 percent; with "):Key("Shift"):Text(", 1 percent")
        TableRowWriter brightnessRow = TableRow()
        brightnessRow:Cell():Key("Up"):Text(", "):Key("Down"):Text(" on the square")
        brightnessRow:Cell():Text("Raises or lowers the brightness 10 percent; with "):Key("Shift"):Text(", 1 percent")
        TableRow():Cell("Arrow keys on the swatches"):Cell("Moves to the next or previous swatch and picks it")
        TableRowWriter enterRow = TableRow()
        enterRow:Cell():Key("Enter")
        enterRow:Cell():Text("Keeps the new color and closes the picker, like "):Code("OK")
        TableRowWriter escapeRow = TableRow()
        escapeRow:Cell():Key("Escape")
        escapeRow:Cell():Text("Puts the old color back and closes the picker, like "):Code("Cancel")

        Paragraph("However the picker closes, the focus goes back to the well. A click
outside the picker cancels. You can use "):Key("Escape"):Text(" for the same purpose.")

        Paragraph("Tabbing into the swatches doesn't pick one. A person can tab past them
without changing the color, which is different from the
"):Link("radio buttons", "/tutorials/ui/radioButton.html"):Text(" on a form.")
    end

    private action ReactingToChanges
        Subsection("Reacting when the color changes")
        Paragraph("Sometimes a program should react the moment a color changes, not when
another button is pressed. A color well tells "):Strong("listeners"):Text(" about each
change. A listener is a class that comes from "):Code("ColorWellListener"):Text(" and writes
one action, "):Code("ColorWellChanged"):Text(".")

        Paragraph("A color well sends two kinds of changes:")

        BulletList()
        ListItem():Strong("while the picker is open"):Text(", each change a person makes, such as each step
of the hue ring, is sent as a change that is "):Strong("not final"):Text(";")
        ListItem():Strong("when the picker closes"):Text(", one more change is sent as "):Strong("final"):Text(": after
"):Code("OK"):Text(" if the color changed, or after "):Code("Cancel"):Text(" if it has to put the old color
back.")

        Paragraph("The event's "):Code("IsFinal"):Text(" action tells you which kind you have. Use the changes
that are not final for quick things, such as a preview, and the final change
for anything that should happen once.")

        Paragraph("Make a class in a file named "):Code("ColorReportListener.quorum"):Text(". It shows each
final change in a label on the page:")
        CodeExampleFromFile("sources/tutorials/ui/ColorWell/ColorReportListener.quorum")

        Paragraph("Now give the listener to a color well:")
        CodeExampleFromFile("sources/tutorials/ui/ColorWell/Main2.quorum")

        Paragraph("Open the well, move the hue ring a few steps and press "):Code("OK"):Text(". The label
changes once, when the picker closes. Try it again and press "):Code("Cancel"):Text("
instead. The label shows the old color, because the cancel put it back.")

        Paragraph("A program's own "):Code("SetColor"):Text(" doesn't tell listeners, because a person didn't
make the change. If you add "):Code("jersey:SetColor(blue)"):Text(" to the program, the label
still says "):DoubleQuote():Text("No changes yet."):DoubleQuote()

        BlockEditorFile("ColorReportListener.quorum", "html/sources/tutorials/ui/ColorWell/ColorReportListener.quorum")
        BlockEditor("Main.quorum", "html/sources/tutorials/ui/ColorWell/Main2.quorum", "", true, true)
    end

    private action WhatAScreenReaderSays
        Subsection("What a screen reader says")
        Paragraph("A color can't be heard, so a color well gives screen readers words for it.
The well's name is the name you gave it, such as "):DoubleQuote():Text("Jersey color."):DoubleQuote():Text(" Its
description is its color text: the hex code, then the closest name, such as
"):DoubleQuote():Text("#2F5BBB, royal blue."):DoubleQuote():Text(" The well keeps the description up to date as the color
changes, so you don't set it yourself. When the well gets the focus, a
screen reader reads its name and its color. The exact words depend on the
screen reader.")

        Paragraph("Inside the picker, each part says what it is:")

        BulletList()
        ListItem("the picker is a group with the well's name, such as "):DoubleQuote():Text("Jersey color"):DoubleQuote():Text(";")
        ListItem("the hue ring is a slider that says its degrees and the name of the color
at that hue;")
        ListItem("the square has two values, saturation and brightness, each in percent with
the name of the color;")
        ListItem("each swatch says its hex code and name, such as "):DoubleQuote():Text("#FF0000, red."):DoubleQuote()

        Paragraph("Nothing extra is spoken when the color changes. A person who wants to check
the color moves the focus to the well, or to the report label, and the
screen reader reads it.")
    end

    private action ColorsOfTheWell
        Subsection("Colors of the well itself")
        Paragraph("The well's own background, border and focus border come from the current
theme, so they change in dark mode too. The "):Link("Themes and Dark Mode", "/tutorials/ui/themes.html"):Text(" tutorial shows how to change them with the
theme key "):DoubleQuote():Text("ColorWell."):DoubleQuote()
    end

    action Engage
        Section("Engage")
        Paragraph("In this activity, you build a "):DoubleQuote():Text("Make a Sign"):DoubleQuote():Text(" form for a school event, then
test and evaluate it yourself. The form needs at least three color wells,
with labels: one for the background, one for the title text and one for the
small text. Give each well a clear name. Add a "):DoubleQuote():Text("Check sign"):DoubleQuote():Text(" button. When it
is pressed, output the contrast ratio between the background and each text
color, and output a warning for any pair below 4.5 to 1.")

        Paragraph("Then add a listener to the background well that reports each final change in
a label, so that a screen reader reads the new color when a person moves to the
label.")

        Paragraph("When it works, test your form as if you had never used it. Use only the
keyboard: "):Key("Tab"):Text(", "):Key("Space"):Text(", the arrow keys, "):Key("Enter"):Text(" and "):Key("Escape"):Text(". If you have a
screen reader, turn it on and notice what it reports for each well. If not, examine the name of the color. Then
evaluate your design with this self-check:")

        BulletList()
        ListItem("Does every well have a name that says what it colors?")
        ListItem("After a change, does the person get feedback, such as the label?")
        ListItem("Can a person back out of a mistake, such as choosing the wrong color?")
        ListItem("Does "):DoubleQuote():Text("Check sign"):DoubleQuote():Text(" warn about every pair below 4.5 to 1?")

        Paragraph("For each "):DoubleQuote():Text("no"):DoubleQuote():Text(", write which human-centered design idea is missing. Fix at
least one of them, and test again.")
    end

    action WrapUp
        Section("Wrap up")
        Paragraph("A color well is a button that shows a color and opens a picker to change it.
You can read the color with "):Code("GetColor"):Text(" and "):Code("GetColorText"):Text(", or react right
away with a "):Code("ColorWellListener"):Text(", using "):Code("IsFinal"):Text(" to tell a preview from a
finished choice. Because a color can't be heard, the well says it in words:
the hex code first, then the closest name. Think back to the warm up: how
would you now tell someone a color without showing it? In the next tutorial,
"):Link("Calendars and Dates", "/tutorials/ui/calendar.html"):Text(", you will let a person
pick a day.")
    end
end
