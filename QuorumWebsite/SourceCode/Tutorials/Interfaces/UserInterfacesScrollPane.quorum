use Libraries.Web.Page.QuorumPage

/*
    Tutorial: ScrollPane.
    Converted from the old Lesson page by plan 13's generator: the same
    words, now without Tailwind.
*/
class UserInterfacesScrollPane is QuorumPage
    // A double quote, for code and words that hold one.
    text dq = ""

    on create
        SetLocation("tutorials/ui/scrollPane.html")
        // The name lists and links use, and the series and track it belongs
        // to: its section and picture.
        SetShortTitle("ScrollPane")
        SetSectionName("User Interfaces")
        // For search engines and link previews, and what lists of pages say.
        SetDescription("Learn about ScrollPanes in the Quorum programming language.")
        SetSummary("how to use ScrollPanes")
    end

    action Setup
        dq = dq:GetDoubleQuote()
        SetWebPageTitle("ScrollPane Tutorial - Quorum Programming Language")
        Title("Tutorial: ScrollPane")
        Paragraph("This tutorial tells you how to use ScrollPanes in Quorum")
        AnIntroductionToScrollPanesInQuorum()
        CreatingAScrollPane()
        Indicies()
        TryMakingAUserInterface()
    end

    private action AnIntroductionToScrollPanesInQuorum
        Section("An Introduction to ScrollPanes in Quorum")
        Subsection("What is a ScrollPane?")
        Paragraph("In this tutorial, we will learn how to use ScrollPanes in the Quorum Game Engine. ScrollPanes are interface tools which allows users to look at portion of a large region by use of a smaller pane and then navigate that region to change what part of the region they see by use of scroll bars. For example, the webpage for this tutorial is a ScrollPane with a vertical scrollbar and can be scrolled up or down to display only a portion of the webpage. In this webpage example, the pane would be the area of the window where the webpage is displayed, and the region would be the entire webpage.")
        Paragraph("For this tutorial, we will create a ScrollPane that only displays a small portion of a much larger region, with Buttons located at the center and each corner of the region. Thus, the user must navigate the region using the vertical and horizontal scrollbars to find each Button. To start, create a new Game Application project.")
    end

    private action CreatingAScrollPane
        Section("Creating a ScrollPane")
        Paragraph("In order to use a ScrollPane, we must include the ScrollPane library. In addition, we will need the libraries for Color, ManualLayout, and Button, requiring the following use statements:")
        CodeExample("use Libraries.Game.Game
use Libraries.Interface.Controls.ScrollPane
use Libraries.Game.Graphics.Color
use Libraries.Interface.Layouts.ManualLayout
use Libraries.Interface.Controls.Button")
        Paragraph("Since we want the ScrollPane to be usable as soon as the game begins, we’ll add our code to the CreateGame class. To start, we’ll simply declare the variables we’ll be using. We also need to set our game’s layout so the ScrollPane will render to the screen. We will need two ManualLayouts, which we will set to the Game and the ScrollPane. By default the Scrollpane has a FlowLayout, but we will manually lay out our Buttons so we will change that. Then we need a ScrollPane, and a Color variable, giving us the following lines of code:")
        CodeExample("ManualLayout layout
SetLayout(layout)
ManualLayout layoutScroll

ScrollPane scrollpane
scrollpane:SetLayout(layoutScroll)
Color color")
        Paragraph("Next, we will take our ScrollPane and set its Background, Size, and Position. We are only setting its background for appearance to differentiate the region of the ScrollPane with the Background of the Game window. Also note that changing the Size and Position of the ScrollPane only affects the Pane and not the Region. After we set those values, we can Add our pane to the Game giving us the following code:")
        CodeExample("scrollpane:SetBackgroundColor(color:Gray())
scrollpane:SetSize(600, 400)
scrollpane:SetPosition(100, 100)
Add(scrollpane)")
        Paragraph("If we were to run the program now, there would only be a Gray region in the center of the game window. You might be able to scroll through it due to the default size of the region, but you will find nothing in it. This is because we have not added anything to the region, and we will do that now by making the buttons that will be on different positions on the screen.")
        Subsection("Buttons on a ScrollPane")
        Subsubsection("Button Behavior")
        Paragraph("Before we begin with the main class, we will create a Behavior class for our Buttons, which we will call "):DoubleQuote():Text("ButtonBehavior.quorum."):DoubleQuote():Text(" This class will use the libraries for Behavior, BehaviorEvent, and Speech. We need the Item library because we will be using the GetItem action from the BehaviorEvent.")
        Paragraph("The ButtonBehavior class will inherit the Behavior class and in the Run action, we need to have the program output and say the button's name. To get the name we use GetItem action from event and since it returns an Item, we save it to an Item variable. For this example, we do not need any casting because the GetName action from the Button is inherited from the Item class.")
        Paragraph("This gives us the completed ButtonBehavior class as follows:")
        CodeExample("use Libraries.Interface.Behaviors.Behavior
use Libraries.Interface.Events.BehaviorEvent
use Libraries.Sound.Speech
use Libraries.Interface.Item

class ButtonBehavior is Behavior
    action Run(BehaviorEvent event)
            Item item = event:GetItem()
            Speech speech
            speech:Say(item:GetName())
            output item:GetName()
    end
end")
        Subsubsection("Adding to our ScrollPane")
        Paragraph("Now with a behavior for the buttons made we can go back to the main class and add our buttons. You can start by adding these declarations:")
        CodeExample("Button topLeft
Button topRight
Button center
Button bottomLeft
Button bottomRight")
        Paragraph("Before we add our Buttons to the ScrollPane, we’ll make a behavior object for all of them to have set and we will set their names. This is done with the following lines of code:")
        CodeExample("ButtonBehavior behavior

topLeft:SetName(" + dq + "Top Left" + dq + ")
topLeft:SetBehavior(behavior)

topRight:SetName(" + dq + "Top Right" + dq + ")
topRight:SetBehavior(behavior)

center:SetName(" + dq + "Center" + dq + ")
center:SetBehavior(behavior)

bottomLeft:SetName(" + dq + "Bottom Left" + dq + ")
bottomLeft:SetBehavior(behavior)

bottomRight:SetName(" + dq + "Bottom Right" + dq + ")
bottomRight:SetBehavior(behavior)")
        Paragraph("Now that our Buttons are created, we can add them to the ScrollPane with the following code:")
        CodeExample("scrollpane:Add(topLeft)
scrollpane:Add(topRight)
scrollpane:Add(center)
scrollpane:Add(bottomLeft)
scrollpane:Add(bottomRight)")
        Paragraph("Now we need to set the position of each Button within the ScrollPane. Because we added each Button to the ScrollPane, that these positions are relative to region within the ScrollPane, not the game window. For example, since we set the ScrollPane’s position to the (x, y) coordinate of (100, 100), calling "):DoubleQuote():Text("bottomLeft:SetPosition(0, 0)"):DoubleQuote():Text(" will place the Button at the relative position of (0, 0) in region of the ScrollPane. Our Button positions are as follows:")
        CodeExample("topLeft:SetPosition(0, 2000 - 30)
topRight:SetPosition(2000 - 100, 2000 - 30)
center:SetPosition((2000 / 2) - 50, (2000 / 2) - 15)
bottomLeft:SetPosition(0, 0)
bottomRight:SetPosition(2000 - 100, 0)")
        Paragraph("Finally, we will call the FitRegionToContents action to automatically resize the region to fit all that we added to it. For example, we used "):DoubleQuote():Text("topRight:SetPosition(2000 - 100, 2000 - 30)"):DoubleQuote():Text(" to place our topRight Button. Thismoves the Button to the (x, y) coordinate of (1900, 1970). So, FitRegionToContents will make the region for the ScrollPane extend to (2000, 2000) since it will also account for the size of the button. The call will look like this:")
        CodeExample("scrollpane:FitRegionToContents()")
        Paragraph("Now when the program is run, it has a ScrollPane showing only a 600 x 400 portion of the 2000 x 2000 region. Thus, the scrollbars can be used to display other parts of the 2000 x 2000 region. For example, below is an image of the ScrollPane at the top left of the region and near the center of the region. When a Button is activated, the program will output and say its name aloud.")
        Image("media/userInterface/scrollPaneMiddle.png", "This image shows the ScrollPane with the Center Button visible in the middle of the screen.")
        Subsection("Manually Setting the Region Size")
        Paragraph("Suppose we wanted to move the Buttons closer together now. We can move the Buttons again by simply calling the SetPosition action again, using the following lines:")
        CodeExample("topLeft:SetPosition(0, 500 - 30)
topRight:SetPosition(500 - 100, 500 - 30)
center:SetPosition((500 / 2) - 50, (500 / 2) - 15)
bottomLeft:SetPosition(0, 0)
bottomRight:SetPosition(500 - 100, 0)")
        Paragraph("By using 500 in our calculations instead of 2000, we've shrunk down the area containing all five buttons by a factor of 4. If we were to run the program now, the vast majority of the region for our ScrollPane would be unnecessary. As such, it is reasonable to shrink down the region itself to match our Buttons. Fortunately, Quorum allows you to manually set the region size, using the ScrollPane's SetRegionSize action with a width and height. Thus, we will add the following line:")
        CodeExample("scrollpane:SetRegionSize(500, 500)")
        Paragraph("However, recall that when we made our ScrollPane, we gave it the view area of 600 x 400. We cannot view more area than exists for our ScrollPane, so we need to change the view area as well. Fortunately, this is done by simply calling the SetSize action again, giving us the following line:")
        CodeExample("scrollpane:SetSize(400, 300)")
        Paragraph("Lastly, to fit the ScrollPane to the middle of our game window, we will add the following line of code:")
        CodeExample("scrollpane:SetPosition(200, 150)")
        Paragraph("Now, when we run the program, the area is much smaller, as shown in the following image:")
        Image("media/userInterface/scrollPaneEnd.png", "This image shows a smaller version of the ScrollPane with the TopLeft and Center buttons visable.")
    end

    private action Indicies
        Section("Indicies")
        Paragraph("In Quorum, ScrollPanes have an additional tracking feature: indices. An index is simply an integer, starting from 0, associated with an object added to the ScrollPane. In the previous section, we added our Buttons to the ScrollPane without indicies, which simply gives an index in the order that objects were added. For example, since topLeft was the first thing we added, it has the index value of 0. Similarly, bottomLeft was the fourth thing we added, so it has the index value of 3. We could have also used the Add action with an index specified, in the form of "):DoubleQuote():Text("scrollpane:Add(0, topLeft)."):DoubleQuote():Text(" For example, the following Add actions would have given us the same indicies as the section above:")
        CodeExample("scrollpane:Add(0, topLeft)
scrollpane:Add(1, topRight)
scrollpane:Add(2, center)
scrollpane:Add(3, bottomLeft)
scrollpane:Add(4, bottomRight)")
        Paragraph("However, note that using the Add action this way must either use the very next index value, or a previous value, otherwise it will crash the program. For instance, starting with "):DoubleQuote():Text("scrollpane:Add(1, topLeft)"):DoubleQuote():Text(" instead would crash, as would finishing with "):DoubleQuote():Text("scrollpane:Add(5, bottomRight)."):DoubleQuote()
        Paragraph("As for specifying a previously assigned index, the new object will push the preexisting object, and everything following it, up by 1. For example, consider the following Add actions:")
        CodeExample("scrollpane:Add(0, topLeft)
scrollpane:Add(0, topRight)
scrollpane:Add(1, center)
scrollpane:Add(0, bottomLeft)
scrollpane:Add(2, bottomRight)")
        Paragraph("In this case, the order of events is as follows:")
        NumberedList()
        ListItem("topLeft is assigned to index 0.")
        ListItem("topRight is assigned to index 0, and topLeft is pushed from index 0 to index 1.")
        ListItem("center is assigned to index 1, and topLeft is pushed from index 1 to index 2.")
        ListItem("bottomLeft is assigned to index 0, topRight is pushed from index 0 to index 1, center is pushed from index 1 to index 2, and topLeft is pushed from index 2 to index 3.")
        ListItem("bottomRight is assigned to index 2, center is pushed from index 2 to index 3, and topLeft is pushed from index 3 to index 4.")
        Paragraph("Final Indicies are:")
        BulletList()
        ListItem("topLeft = Index 4")
        ListItem("topRight = Index 1")
        ListItem("center = Index 3")
        ListItem("bottomLeft = Index 0")
        ListItem("bottomRight = Index 2")
        Paragraph("In particular, indicies are used to remove objects from ScrollPanes. For example, if we wanted to Remove the Center Button using the previous example, we could either use "):DoubleQuote():Text("scrollpane:Remove(center)"):DoubleQuote():Text(" or "):DoubleQuote():Text("scrollpane:Remove(3)."):DoubleQuote():Text(" While we just call the Remove action like this, note that the Remove action with an Item parameter will return a boolean, True if the item was in the ScrollPane and successfully removed or False if the item was not in the ScrollPane. The Remove action with an integer parameter will return the Item that was previously contained at that index.")
        Paragraph("The action of removing an object also has an impact on the indicies of other objects, though in this case, it will change the following indicies by 1 to fill in the space left by the removed object. Using the previous example again, consider the following Removes:")
        CodeExample("scrollpane:Remove(3)
scrollpane:Remove(0)")
        Paragraph("In this case, the order of events is as follows:")
        NumberedList()
        ListItem("center (index 3) is removed, and topLeft is pulled down from index 4 to index 3.")
        ListItem("bottomLeft (index 0) is removed, topRight is pulled down from index 1 to index 0, bottomRight is pulled down from index 2 to index 1, and topLeft is pulled down from index 3 to index 2.")
        Paragraph("Final Indicies are:")
        BulletList()
        ListItem("topLeft = Index 2")
        ListItem("topRight = Index 0")
        ListItem("center = N/A (Removed)")
        ListItem("bottomLeft = N/A (Removed)")
        ListItem("bottomRight = Index 1")
    end

    private action TryMakingAUserInterface
        Section("Try making a User Interface")
        CodeEditorWithCode("Activity: ScrollPane", "ScrollPane.quorum", "use Libraries.Game.Game
use Libraries.Interface.Controls.ScrollPane
use Libraries.Game.Graphics.Color
use Libraries.Interface.Layouts.ManualLayout
use Libraries.Interface.Controls.Button

class Main is Game
    action Main
        StartGame()
    end

    action CreateGame
        ManualLayout layout
        SetLayout(layout)
        ManualLayout layoutScroll
        
        ScrollPane scrollpane
        scrollpane:SetLayout(layoutScroll)
        Color color

        scrollpane:SetBackgroundColor(color:Gray())
        scrollpane:SetSize(600, 400)
        scrollpane:SetPosition(100, 100)
        Add(scrollpane)

        Button topLeft
        Button topRight
        Button center
        Button bottomLeft
        Button bottomRight

        scrollpane:Add(topLeft)
        scrollpane:Add(topRight)
        scrollpane:Add(center)
        scrollpane:Add(bottomLeft)
        scrollpane:Add(bottomRight)

        topLeft:SetPosition(0, 2000 - 30)
        topRight:SetPosition(2000 - 100, 2000 - 30)
        center:SetPosition((2000 / 2) - 50, (2000 / 2) - 15)
        bottomLeft:SetPosition(0, 0)
        bottomRight:SetPosition(2000 - 100, 0)
        
        scrollpane:FitRegionToContents()

    end
end")
    end
end
