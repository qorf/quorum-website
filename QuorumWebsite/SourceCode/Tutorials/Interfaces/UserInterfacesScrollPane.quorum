use Libraries.Web.Page.all
use Libraries.Web.Page.Standards.ComputerScienceStandards2026
use Libraries.Web.Page.Standards.QuorumStandards

/*
    Tutorial: Scroll Panes, part of the user interface series.
*/
class UserInterfacesScrollPane is QuorumPage
    // The site's sets of standards, built once for every page.
    QuorumStandards standards

    on create
        SetLocation("tutorials/ui/scrollPane.html")
        SetShortTitle("Scroll Panes")
        SetSectionName("User Interfaces")
    end

    action Setup
        // For search engines and link previews.
        SetDescription("How a Quorum form page scrolls and follows the focus, how to put a long list of controls in a scroll pane on a page, how to add and remove items while the program runs, and how to check AI-generated code.")

        Title("Scroll Panes")

        Overview()
        WarmUp()
        Explore()
        Engage()
        WrapUp()
    end

    action Overview
        Section("Overview")
        Paragraph("Sometimes there is more to show than fits on the screen: a list of a hundred
songs, a long chat, or a map that is much bigger than the window. A "):Strong("scroll
pane"):Text(" shows one part of a large area at a time, and scroll bars let the
user move around to reach the rest. In this tutorial, you will find out that every
form page already scrolls, put a long list into a scroll pane of its own on
a page, and add and remove items while the program runs. You will also explore
what scrolling means for people who use a keyboard or a screen reader
instead of a mouse.")

        Subsection("Goals")
        Paragraph("You have the following goals for this tutorial:")
        Goals()
        ListItem("Explain the difference between a scroll pane's view and its scroll region")
        ListItem("Explain how a form page scrolls, and how it follows the focus")
        ListItem("Show a long list of controls in a scroll pane on a page")
        ListItem("Add, insert and remove items in a scroll pane, and keep them reachable
from the keyboard")
        ListItem("Check AI-generated code against the library documentation and the
program's requirements")
    end

    action WarmUp
        Section("Warm up")
        Paragraph("Think about the apps you scrolled through today. How did you scroll in each
one: a mouse wheel, a finger, a scroll bar, or the arrow keys? Now imagine
you could not use a mouse or a touch screen at all. How would you get to the
bottom of a long page?")

        Subsection("Vocabulary")
        Paragraph("You will be learning about the following vocabulary words:")
        Table("Vocabulary", "media/userInterface/ScrollPane/Vocabulary.csv")

        Subsection("New Code to Learn")
        Paragraph("You will be using the following new pieces of code:")
        Table("New Code to Learn", "media/userInterface/ScrollPane/Code.csv")

        Subsection("CSTA Standards")
        Paragraph("This tutorial covers the following
"):Link("2026 CSTA standards", "https://csteachers.org/pk12standards/view/"):Text(":")
        ComputerScienceStandards2026 computerScience = standards:GetComputerScience2026()
        CoversStandard(computerScience, computerScience:MIDDLE_SCHOOL_PROGRAM_DEVELOPMENT_13)
        CoversStandard(computerScience, computerScience:MIDDLE_SCHOOL_READING_AND_DOCUMENTING_18)
        CoversStandard(computerScience, computerScience:HIGH_SCHOOL_READING_AND_DOCUMENTING_18)
        CoversStandard(computerScience, computerScience:HIGH_SCHOOL_TESTING_AND_REFINING_19)
        CoversStandard(computerScience, computerScience:MIDDLE_SCHOOL_TESTING_AND_REFINING_19)
        CoversStandard(computerScience, computerScience:SPECIALTY_1_SOFTWARE_DEVELOPMENT_USER_EXPERIENCE_4)
        StandardsList(computerScience)
    end

    action Explore
        Section("Explore")
        ViewAndScrollRegion()
        EveryPageScrolls()
        AScrollPaneOfItsOwn()
        AddingInsertingAndRemoving()
        ScrollingFromCode()
        RegionsOfOtherShapes()
        CheckingCodeAnAIWrote()
    end

    private action ViewAndScrollRegion
        Subsection("The view and the scroll region")
        Paragraph("A scroll pane has two sizes:")
        BulletList()
        ListItem("The "):Strong("view"):Text(" is the box shown on the screen.")
        ListItem("The "):Strong("scroll region"):Text(" is the whole area that holds the items you add. It
can be much bigger than the view. Anything in the region that is outside
the view is hidden until the user scrolls to it.")

        Paragraph("When the region is bigger than the view, the scroll pane shows a scroll bar.
The user can turn the mouse wheel over the pane, drag the scroll bar, click
the bar's track, or drag a finger on a touch screen to move the view.
A scroll pane has no scroll keys yet. With the keyboard, the view moves by
following the focus: press "):Key("Tab"):Text(" to a control outside the view, and the
pane scrolls to show it. You will try this below.")
    end

    private action EveryPageScrolls
        Subsection("Every page already scrolls")
        Paragraph("You have been using scroll panes since the "):Link("Forms", "/tutorials/ui/forms.html"):Text("
tutorial without knowing it: in Quorum, a form "):Code("Page"):Text(" is a kind of
"):Code("ScrollPane"):Text(". When a page has more rows than fit in the window, it shows a
scroll bar.")

        Paragraph("Replace "):Code("Main.quorum"):Text(" with this program. It puts 30 song buttons on one page.")
        CodeExampleFromFile("sources/tutorials/ui/ScrollPane/Main.quorum")

        Paragraph("Each button runs the same behavior, which writes the name of the button
that was pressed. Put it in its own file, "):Code("OutputNameBehavior.quorum"):Text(":")
        CodeExampleFromFile("sources/tutorials/ui/ScrollPane/OutputNameBehavior.quorum")

        Paragraph("Run the program. Only the first songs fit in the window, and a scroll bar
appears on the right. Now put the mouse aside and press "):Key("Tab"):Text(" again and
again. Each time the focus moves to a song below the window, the page
scrolls just far enough to show it. This is how a scroll pane works with
the keyboard: it has no keys of its own for scrolling, but it "):Strong("follows the
focus"):Text(". A screen reader reads each song's name and description as it gets
the focus.")
    end

    private action AScrollPaneOfItsOwn
        Subsection("A scroll pane of its own")
        Paragraph("A long page is fine when the list is the only thing on it. Often, though,
you want a list of a set size among other controls, such as a playlist with
buttons below it. For that, put a scroll pane on the page.")

        Paragraph("On a form, use a "):Code("FormScrollPane"):Text(". It is a scroll pane that the form knows
how to look inside, so the form puts the controls in it into the page's
"):Key("Tab"):Text(" order, after the controls above it and before the ones below it.
(A plain "):Code("ScrollPane"):Text(" works in a game, but a form doesn't look inside it,
so "):Key("Tab"):Text(" would skip its controls.)")
        CodeExampleFromFile("sources/tutorials/ui/ScrollPane/Main2.quorum")

        Paragraph("Some things to notice:")
        BulletList()
        ListItem():Code("page:Add(songs)"):Strong(" puts the scroll pane on the page."):Text(" A page has actions
like "):Code("AddButton"):Text(" for many controls, but not for a scroll pane, so you
make it yourself and add it. The page gives it its own row.")
        ListItem():Code("SetPixelHeight(250)"):Strong(" sets the size of the view."):Text(" A page row is
normally one line of text tall. The view is 250 pixels tall and as wide
as the page's other rows. The scroll region is as wide as the view and
grows taller to fit what you add.")
        ListItem():Strong("The songs are made, not added with "):Code("AddButton"):Strong("."):Text(" "):Code("AddButton"):Text(" is a page
action; inside the scroll pane you make each "):Code("Button"):Text(" and add it with
"):Code("songs:Add"):Text(".")
        ListItem():Code("FILL"):Strong(" makes each song a whole row."):Text(" A scroll pane places its items
one after another from left to right, starting a new line when one is
full. A button is normally only as wide as its text, so several songs
would share a line. "):Code("FILL"):Text(" is a "):Strong("layout mode"):Text(" that makes the button fill
the rest of the line. "):Code("FILL"):Text(" belongs to the "):Code("Control"):Text(" class, so a "):Code("Button"):Text("
variable reaches it with "):Code("parent:Control:"):Text(". The
"):Link("Layouts", "/tutorials/ui/layout.html"):Text(" tutorial explains layout modes.")

        Paragraph("Run the program and press "):Key("Tab"):Text(". The focus moves from the title into the
songs, the list scrolls to follow it, and after Song 20 it moves on to the
two buttons below the list.")

        BlockEditorFile("OutputNameBehavior.quorum", "html/sources/tutorials/ui/ScrollPane/OutputNameBehavior.quorum")
        BlockEditorFile("AddSongBehavior.quorum", "html/sources/tutorials/ui/ScrollPane/AddSongBehavior.quorum")
        BlockEditorFile("RemoveSongBehavior.quorum", "html/sources/tutorials/ui/ScrollPane/RemoveSongBehavior.quorum")
        BlockEditor("Main.quorum", "html/sources/tutorials/ui/ScrollPane/Main2.quorum", "", true, true)
    end

    private action AddingInsertingAndRemoving
        Subsection("Adding, inserting and removing items")
        Paragraph("Each item in a scroll pane has an "):Strong("index"):Text(", a number for its place in the
order. The first item you add has index 0, the next has index 1, and so on.
In a list like this one, the index is also the item's place on the screen,
from the top.")

        Paragraph():Code("songs:Add(0, song)"):Text(" adds a song at index 0. The song that was there, and
everything after it, moves down one place. The index must be one that
already exists, or one more than the last index.")

        Paragraph("There are two ways to remove an item:")
        BulletList()
        ListItem():Code("songs:Remove(song)"):Text(" removes that item. It returns "):Code("true"):Text(" if the item was
in the scroll pane, and "):Code("false"):Text(" if it was not.")
        ListItem():Code("songs:Remove(0)"):Text(" removes the item at index 0 and returns it.")

        Paragraph("A form works out its "):Key("Tab"):Text(" order once, when it is displayed. After you add
or remove an item, ask the page to work it out again with
"):Code("CalculateDefaultFocusOrdering"):Text(". Otherwise "):Key("Tab"):Text(" skips the new song, or
tries to move to a song that is gone. This one line is all you need here;
the "):Link("Focus", "/tutorials/ui/focus.html"):Text(" tutorial covers the focus order in
full.")

        Paragraph("The two behaviors need the page, so they come from "):Code("FormBehavior"):Text(", which
has "):Code("GetPage"):Text(". Put this class in "):Code("AddSongBehavior.quorum"):Text(":")
        CodeExampleFromFile("sources/tutorials/ui/ScrollPane/AddSongBehavior.quorum")

        Paragraph():Code("song:Focus()"):Text(" moves the focus to the new song. The list scrolls to the top
to show it, and a screen reader reads its name. Put this class in
"):Code("RemoveSongBehavior.quorum"):Text(":")
        CodeExampleFromFile("sources/tutorials/ui/ScrollPane/RemoveSongBehavior.quorum")
    end

    private action ScrollingFromCode
        Subsection("Scrolling from code")
        Paragraph("You can also move the view yourself. "):Code("SetScrollPercentageY"):Text(" moves it up or
down, where 0 is the top and 1 is the bottom:")
        CodeExampleFromFile("sources/tutorials/ui/ScrollPane/ScrollToTop.quorum")

        Paragraph("You rarely need this for a list of controls, because the pane already
follows the focus. It helps with content that can't take the focus, such
as a picture. Keep in mind that a keyboard or screen reader user can only
scroll by moving the focus, so anything a person must reach should be able
to take the focus.")
    end

    private action RegionsOfOtherShapes
        Subsection("Regions of other shapes")
        Paragraph("By default, the scroll region is as wide as the view and grows taller to
fit its items, which is right for a list. "):Code("SetScrollRegionResizing"):Text("
chooses another rule:")
        BulletList()
        ListItem():Code("FIT_CONTENTS_VERTICALLY"):Text(", the default: as wide as the view, as tall as
the items;")
        ListItem():Code("FIT_CONTENTS_HORIZONTALLY"):Text(": as tall as the view, as wide as the items;")
        ListItem():Code("MANUAL_REGION_SIZING"):Text(": the size you give to "):Code("SetRegionSize"):Text(", or the size
"):Code("FitRegionToContents"):Text(" works out from the items in it.")

        Paragraph("A large map that scrolls both ways would use "):Code("MANUAL_REGION_SIZING"):Text(" and
place each item at a position of its own. Placing items at positions is
what a "):Code("ManualLayout"):Text(" does, which you will learn in the next tutorial,
"):Link("Layouts", "/tutorials/ui/layout.html"):Text(".")
    end

    private action CheckingCodeAnAIWrote
        Subsection("Checking code an AI wrote")
        Paragraph("The Playlist program on this page, with its three behaviors, was written by
an AI system called Claude when this tutorial was drafted. So was the rest
of the code in this tutorial. AI-generated code can look right and still be
wrong. It can call an action that doesn't exist, use a real action the
wrong way, or skip something the program was supposed to do. Before you
trust code like this, check it, the same way you would check a classmate's
work. Textbooks could have issues as well, but this is more rare.")

        Paragraph("The Playlist program has these "):Strong("requirements"):Text(", the things it is supposed
to do:")
        NumberedList()
        ListItem("It shows 20 songs in a list 250 pixels tall, with two buttons below it.")
        ListItem("Every song has a name and a description, and can be reached with "):Key("Tab"):Text(".")
        ListItem():DoubleQuote():Text("Add a song at the top"):DoubleQuote():Text(" puts a new song first in the list and moves the
focus to it.")
        ListItem():DoubleQuote():Text("Remove the top song"):DoubleQuote():Text(" removes the first song. When the list is empty,
it says so and nothing breaks.")
        ListItem("After any change, "):Key("Tab"):Text(" reaches every song in the list, and none that
are gone.")

        Paragraph("Check the code in three ways:")
        BulletList()
        ListItem():Strong("Accuracy:"):Text(" does every action it calls exist, and does it do what the
code expects? Look each one up in the library documentation, starting
with the "):Link("ScrollPane", "/Libraries/Interface/Controls/ScrollPane.html"):Text(" and
"):Link("FormScrollPane", "/Libraries/Interface/Forms/FormScrollPane.html"):Text(" pages.
For example, find "):Code("Remove(integer index)"):Text(" and read what it returns. If a
class's page says little about an action, check the class it comes from.")
        ListItem():Strong("Reliability:"):Text(" does it work every time, not just the first time? Try
the unusual cases: remove songs until the list is empty, then press
Remove again; add several songs in a row; add a song after removing them
all.")
        ListItem():Strong("Fit to the requirements:"):Text(" go through the list above one item at a
time, and mark each one met, not met, or not sure. Also notice anything
the code does that no requirement asked for.")
    end

    action Engage
        Section("Engage")
        Paragraph("In this activity, you check the AI-generated Playlist program on your own,
then turn it into a scrolling contact list and test it. The goal is to
decide, with evidence, whether code you didn't write can be trusted, and to
test, fix and record changes to a scroll pane program. Work through these
steps:")
        NumberedList()
        ListItem():Strong("Check each action."):Text(" Make a table with one row for every action the
Playlist program calls, such as "):Code("SetPixelHeight"):Text(", "):Code("Add"):Text(", "):Code("Remove"):Text(",
"):Code("GetScrollRegionItems"):Text(", "):Code("CalculateDefaultFocusOrdering"):Text(" and "):Code("Focus"):Text(". For
each, write the class whose documentation page describes it, what the
documentation says it does, and whether the program uses it correctly.
Mark any action you could not find.")
        ListItem():Strong("Test each requirement."):Text(" Run the program and test the five
requirements from "):DoubleQuote():Text("Checking code an AI wrote"):DoubleQuote():Text(", first with the mouse and
then with only the keyboard. Include the unusual cases. Mark each
requirement met, not met or not sure, and write down what you did that
shows it.")
        ListItem():Strong("Change and fix."):Text(" Change the program into a contact list with at least
15 made-up contacts, each with a name and a description. Fix any problem
you found in steps 1 and 2. Then use your keyboard results to improve one
thing. For example, would the buttons be easier to reach above a long
list?")
        ListItem():Strong("Record your changes."):Text(" For every change, write what you changed, why,
and how you tested it afterwards. Then run all five tests again.")

        Paragraph("Finish with a short verdict: would you trust the AI-generated program as it
was, with changes, or not at all? Give your two strongest reasons.")
    end

    action WrapUp
        Section("Wrap up")
        Paragraph("Scrolling is so common that people rarely think about it. What did you
learn about how scrolling works for people who do not use a mouse? Which of
your checks found something that running the program once would have
missed? Would you check code that a person wrote any differently from code
that an AI wrote?")
    end
end
