use Libraries.Web.Page.QuorumPage

/*
    Tutorial: Tree Tables.
    Converted from the old Lesson page by plan 13's generator: the same
    words, now without Tailwind.
*/
class UserInterfacesTreeTable is QuorumPage

    on create
        SetLocation("tutorials/ui/treeTable.html")
        // The name lists and links use, and the series and track it belongs
        // to: its section and picture.
        SetShortTitle("Tree Table")
        SetSectionName("User Interfaces")
        // For search engines and link previews, and what lists of pages say.
        SetDescription("Learn about Tree Tables in the Quorum programming language.")
        SetSummary("how to use Tree Tables")
    end

    action Setup
        SetWebPageTitle("Tree Table Tutorial - Quorum Programming Language")
        Title("Tutorial: Tree Tables")
        Paragraph("This tutorial will teach you how to use Tree Tables in Quorum.")
        IntroductionToTreeTablesInQuorum()
    end

    private action IntroductionToTreeTablesInQuorum
        Section("Introduction to Tree Tables in Quorum")
    end
end
