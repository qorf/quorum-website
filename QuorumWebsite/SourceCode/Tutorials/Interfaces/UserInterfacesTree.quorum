use Libraries.Web.Page.all
use Libraries.Web.Page.Standards.ComputerScienceStandards2026
use Libraries.Web.Page.Standards.QuorumStandards

/*
    Tutorial: Trees, part of the user interface series.
*/
class UserInterfacesTree is QuorumPage
    // The site's sets of standards, built once for every page.
    QuorumStandards standards

    on create
        SetLocation("tutorials/ui/tree.html")
        SetShortTitle("Trees")
        SetSectionName("User Interfaces")
    end

    action Setup
        // For search engines and link previews.
        SetDescription("How to add a tree to a Quorum form page, fill it with items inside other items, use it from the keyboard, react when an item is activated, find the path to an item and give each item an icon.")

        Title("Trees")

        Overview()
        WarmUp()
        Explore()
        Engage()
        WrapUp()
    end

    action Overview
        Section("Overview")
        Paragraph("A "):Strong("tree"):Text(" shows items that belong inside other items. The folders on a
computer are a tree: a project folder holds a source code folder, and the
source code folder holds files. In this tutorial, you will build a tree of
colors on a page. Each color can hold lighter and darker shades. You will
open and close parts of the tree, react when a person picks a color, find
the path from the top of the tree to any item, and add a small picture to
each color.")

        Subsection("Goals")
        Paragraph("You have the following goals for this tutorial:")
        Goals()
        ListItem("Add a tree to a page with "):Code("AddTree"):Text(", and fill it with "):Code("TreeItem"):Text(" objects inside other items")
        ListItem("Use a tree with the keyboard")
        ListItem("Run a behavior when a person activates an item")
        ListItem("Find the path from the top of a tree to an item")
    end

    action WarmUp
        Section("Warm up")
        Paragraph("Open the file browser on your computer, or picture one. Your files are
inside folders, and folders are inside other folders. Draw this as a
diagram on paper, with the top folder at the top and lines down to what is
inside it. You may also use physical contraptions like blocks, paper, or notes, to build it. Why do you think computers show folders this way instead of one
long list of every file?")

        Subsection("Vocabulary")
        Paragraph("You will be learning about the following vocabulary words:")
        Table("Vocabulary", "media/userInterface/Tree/Vocabulary.csv")

        Subsection("New Code to Learn")
        Paragraph("You will be using the following new pieces of code:")
        Table("New Code to Learn", "media/userInterface/Tree/Code.csv")

        Subsection("CSTA Standards")
        Paragraph("This tutorial covers the following "):Link("CSTA standards", "https://csteachers.org/pk12standards/view/"):Text(":")
        ComputerScienceStandards2026 computerScience = standards:GetComputerScience2026()
        CoversStandard(computerScience, computerScience:HIGH_SCHOOL_READING_AND_DOCUMENTING_17)
        CoversStandard(computerScience, computerScience:MIDDLE_SCHOOL_READING_AND_DOCUMENTING_17)
        CoversStandard(computerScience, computerScience:SPECIALTY_2_SOFTWARE_DEVELOPMENT_DESIGN_AND_DEVELOPMENT_1)
        CoversStandard(computerScience, computerScience:SPECIALTY_1_SOFTWARE_DEVELOPMENT_USER_EXPERIENCE_4)
        CoversStandard(computerScience, computerScience:HIGH_SCHOOL_ALGORITHMIC_PROBLEM_SOLVING_1)
        StandardsList(computerScience)
    end

    action Explore
        Section("Explore")
        WhatIsATree()
        MakingATreeOfColors()
        UsingATreeWithTheKeyboard()
        FindingThePath()
        CountingAndOrdering()
        AddingPictures()
    end

    private action WhatIsATree
        Subsection("What is a tree?")
        Paragraph("A tree shows items in a "):Strong("hierarchy"):Text(": levels, where each item can hold
other items. Quorum Studio, for example, shows each project as a tree.
A project holds a Source Code folder, and the folder holds three files.")

        Paragraph("An item that holds other items is a "):Strong("parent"):Text(". The items it holds are its
"):Strong("children"):Text(". A parent and everything inside it is a "):Strong("subtree"):Text(". A person
can "):Strong("open"):Text(" a parent to show its children or "):Strong("close"):Text(" it to hide them.")

        Paragraph("In Quorum, a tree is a "):Code("Tree"):Text(" object, and every entry in it is a
"):Code("TreeItem"):Text(". You add "):Code("TreeItem"):Text(" objects to the tree, and you add
"):Code("TreeItem"):Text(" objects to other "):Code("TreeItem"):Text(" objects to make children.")
    end

    private action MakingATreeOfColors
        Subsection("Making a tree of colors")
        Paragraph("Make a new Form project in Quorum Studio. You will need two files.")

        Paragraph("First, add a class named "):Code("OutBehavior.quorum"):Text(". For now, it only writes
the name of the item that was activated:")
        CodeExampleFromFile("sources/tutorials/ui/Tree/OutBehavior.quorum")

        Paragraph():Code("event:GetItem()"):Text(" returns the item that was activated as a general
"):Code("Item"):Text(". The "):Code("cast"):Text(" tells Quorum to treat it as a "):Code("TreeItem"):Text(", so you can
ask for its name.")

        Paragraph("Next, replace the code in "):Code("Main.quorum"):Text(" with this program:")
        CodeExampleFromFile("sources/tutorials/ui/Tree/Main.quorum")

        text quote = ""
        quote = quote:GetDoubleQuote()
        Paragraph("Here is what the program does:")

        BulletList()
        ListItem():Code("page:AddTree(" + quote + "Colors" + quote + ")"):Text(" adds a tree to the page. The name is what a
screen reader calls the tree, and "):Code("SetDescription"):Text(" tells it a little
more.")
        ListItem():Code("MakeItem"):Text(" is an action you write yourself. It makes one "):Code("TreeItem"):Text(",
sets its name and gives it the behavior. Writing this once saves you from
repeating three lines for each of the eight colors.")
        ListItem():Code("SetName"):Text(" sets the text shown on the item's row. A screen reader reads
the same text.")
        ListItem():Code("tree:Add(red)"):Text(" puts Red at the top level of the tree. "):Code("red:Add(pink)"):Text("
puts Pink inside Red, so Red becomes a parent.")

        Paragraph("Run the program. Only Red, Blue and Green show at first, because their
children are closed. The tree sits at the left of the page, so it doesn't
move sideways as items open and close.")
    end

    private action UsingATreeWithTheKeyboard
        Subsection("Using a tree with the keyboard")
        Paragraph("A tree can be used fully from the keyboard:")

        BulletList()
        ListItem():Key("Up Arrow"):Text(" and "):Key("Down Arrow"):Text(" move to the item above or below.")
        ListItem():Key("Right Arrow"):Text(" opens a closed item. If it's already open, it moves to the
first child.")
        ListItem():Key("Left Arrow"):Text(" closes an open item. If it's already closed, it moves up to
the parent.")
        ListItem():Key("Home"):Text(" and "):Key("End"):Text(" jump to the first or last item.")
        ListItem("Typing a letter jumps to the next item that starts with it.")
        ListItem():Key("Enter"):Text(" activates the selected item.")

        Paragraph("With the mouse, clicking an item selects it. Double-clicking an item opens
or closes it and activates it.")

        Paragraph("Try activating Purple. The program writes "):DoubleQuote():Text("Purple"):DoubleQuote():Text(".")

        Paragraph("If you want a part of the tree to start open, call "):Code("Open"):Text(" on that item
after you add its children:")
        CodeExampleFromFile("sources/tutorials/ui/Tree/Open.quorum")
    end

    private action FindingThePath
        Subsection("Finding the path to an item")
        Paragraph("Sometimes the name of an item is not enough. "):DoubleQuote():Text("Dark Purple"):DoubleQuote():Text(" makes more
sense when you know it is inside Purple, which is inside Blue. The list of
items from the top of the tree down to one item is its "):Strong("path"):Text(".")

        Paragraph("Every "):Code("TreeItem"):Text(" has a "):Code("GetTreePath"):Text(" action. It returns the path as an
"):Code("Array"):Text(" of "):Code("TreeItem"):Text(" objects, starting at the top and ending with the item
itself. To learn more about arrays, refer to the
"):Link("Arrays tutorial", "/tutorials/language/arrays.html"):Text(".")

        Paragraph("Change "):Code("OutBehavior.quorum"):Text(" to this:")
        CodeExampleFromFile("sources/tutorials/ui/Tree/OutBehavior2.quorum")

        Paragraph("The "):Code("repeat while"):Text(" loop visits each item in the path, in order, and adds
its name to "):Code("message"):Text(". To learn more about loops, refer to the
"):Link("Repeat tutorial", "/tutorials/language/repeat.html"):Text(".")

        Paragraph("Run the program, open Blue and Purple, and activate Dark Purple. The
program writes "):DoubleQuote():Text("Blue, then Purple, then Dark Purple"):DoubleQuote():Text(".")
    end

    private action CountingAndOrdering
        Subsection("Counting and ordering")
        Paragraph("Two ideas help when you work with the items in a tree or a path.
"):Strong("Cardinality"):Text(" is how many items there are. The path to Dark Purple has a
cardinality of 3, and "):Code("path:GetSize()"):Text(" returns it. "):Strong("Ordinality"):Text(" is an
item's position in order: first, second, third. In the path, Blue is first,
Purple is second and Dark Purple is third. People count positions from 1,
but an "):Code("Array"):Text(" counts them from 0, so "):Code("path:Get(0)"):Text(" is the first item, Blue.
A tree has ordinality too: a parent's children have an order, and a person
moving with the "):Key("Down"):Text(" key meets them in that order.")

        Paragraph("Screen readers and braille displays bring these ideas to people too. When a
person moves through a tree or a list, many screen readers say an item's
position and the number of items, such as "):DoubleQuote():Text("2 of 3,"):DoubleQuote():Text(" and a braille display
shows the same words under the person's fingers. That is ordinality and
cardinality, given by speech or by touch.")
    end

    private action AddingPictures
        Subsection("Adding pictures to the items")
        Paragraph("An item can show a small picture, called an "):Strong("icon"):Text(", before its name.
Here, each color gets a circle of its own color.")

        Paragraph("Pictures can only be made once the program's window is open. Until now,
your programs built the whole page in "):Code("Main"):Text(" and then called
"):Code("form:Display()"):Text(", which opens the window. To make pictures, the page has to
be built after the window opens. A class that is a "):Code("Form"):Text(" has an action for
that: Quorum calls its "):Code("CreateGame"):Text(" action once the window is open.")

        Paragraph("Change "):Code("Main.quorum"):Text(" to this program. "):Code("OutBehavior.quorum"):Text(" stays the same.")
        CodeExampleFromFile("sources/tutorials/ui/Tree/Main2.quorum")

        Paragraph("Here is what changed:")

        BulletList()
        ListItem():Code("class Main is Form"):Text(" makes the program itself a form. "):Code("Main"):Text(" calls
"):Code("Display()"):Text(" to open the window, the same as "):Code("form:Display()"):Text(" before.")
        ListItem("The page is built in "):Code("CreateGame"):Text(" instead of "):Code("Main"):Text(". "):Code("GetMainPage()"):Text("
works the same way as before, without "):Code("form:"):Text(" in front.")
        ListItem("The last line, "):Code("parent:Form:CreateGame()"):Text(", lets the form do its own setup
after your code: it shows the page and gives the first control the
focus.")
        ListItem():Code("LoadFilledCircle(8, shade)"):Text(" makes a filled circle 8 pixels across from
the center to the edge, in the color "):Code("shade"):Text(". "):Code("SetIcon"):Text(" puts it on the
item's row.")
        ListItem():Code("CustomColor(red, green, blue, alpha)"):Text(" mixes a color from four numbers
between 0 and 1. The last number, alpha, is how solid the color is.
Refer to the "):Link("Color class documentation", "/Libraries/Game/Graphics/Color.html"):Text("
for more.")

        Paragraph("An icon is only a picture. A screen reader still reads the item's name, so
make sure the name says everything a person needs to know. Here, the name
already says the color.")

        BlockEditorFile("OutBehavior.quorum", "html/sources/tutorials/ui/Tree/OutBehavior2.quorum")
        BlockEditor("Main.quorum", "html/sources/tutorials/ui/Tree/Main2.quorum", "", true, true)
    end

    action Engage
        Section("Engage")
        Paragraph("In this activity, you build a tree for something that has levels. The goal is to organize
information in a hierarchy and to move through a tree with the keyboard.
Choose something with levels, such as your school (grades, then classes,
then students), a family of animals, or the parts of a video game. Draw it
on paper first or create it with physical items. Then build it as a tree with at least three levels,
and when an item is activated, have the program write its full path.")
    end

    action WrapUp
        Section("Wrap up")
        Paragraph("A tree is a way to show data that has levels. Think back to your drawing
from the warm up. Which parts of your drawing became "):Code("TreeItem"):Text(" objects,
and which lines became calls to "):Code("Add"):Text("? When would a tree be a better
choice than a list, and when would a list be better?")

        Paragraph():Link("Next tutorial: Spreadsheets", "/tutorials/ui/spreadsheet.html")
    end
end
