use Libraries.Web.Page.all
use Libraries.Web.Page.Standards.ComputerScienceStandards2026
use Libraries.Web.Page.Standards.QuorumStandards

/*
    Tutorial: Toolbars, part of the user interface series.
*/
class UserInterfacesToolBar is QuorumPage
    // The site's sets of standards, built once for every page.
    QuorumStandards standards

    on create
        SetLocation("tutorials/ui/toolbar.html")
        SetShortTitle("Toolbars")
        SetSectionName("User Interfaces")
    end

    action Setup
        // For search engines and link previews.
        SetDescription("How to put a toolbar on a Quorum form, fill it with named buttons, move between its buttons with the arrow keys, and share one behavior between a toolbar button and a menu command.")

        Title("Toolbars")

        Overview()
        WarmUp()
        Explore()
        Engage()
        WrapUp()
    end

    action Overview
        Section("Overview")
        Paragraph("Below the menu bar in many programs is a row of small buttons for the
commands people use most, like Save, Undo or Bold. This row is a
"):Strong("toolbar"):Text(". A toolbar is a shortcut: every button on it usually does the
same thing as a command in a menu, but it takes one click instead of
several. In this tutorial, you will put a toolbar on a page, connect its
buttons to behaviors, and share those behaviors with a menu bar so that
both do the same thing. You will also learn how a keyboard user moves along
a toolbar with the arrow keys.")

        Subsection("Goals")
        Paragraph("You have the following goals for this tutorial:")
        Goals()
        ListItem("Create a "):Code("ToolBar"):Text(", fill it with named, described buttons, and put it on a page")
        ListItem("Move between toolbar buttons with the arrow keys")
        ListItem("Share one behavior between a toolbar button and a menu command")
        ListItem("Decide which commands belong on a toolbar")
    end

    action WarmUp
        Section("Warm up")
        Paragraph("Open a program that has a toolbar, like a word processor, a drawing program
or a web browser. List the buttons on its toolbar. Then find each of those
commands in the program's menus. Are there any toolbar buttons that are
"):Emphasis("not"):Text(" in a menu? Why might the designers have picked these commands, and
not others, for the toolbar?")

        Subsection("Vocabulary")
        Paragraph("You will be learning about the following vocabulary words:")
        Table("Vocabulary", "media/userInterface/ToolBar/Vocabulary.csv")

        Subsection("New Code to Learn")
        Paragraph("You will be using the following new pieces of code:")
        Table("New Code to Learn", "media/userInterface/ToolBar/Code.csv")

        Subsection("CSTA Standards")
        Paragraph("This tutorial covers the following "):Link("CSTA standards", "https://csteachers.org/pk12standards/view/"):Text(":")
        ComputerScienceStandards2026 computerScience = standards:GetComputerScience2026()
        CoversStandard(computerScience, computerScience:HIGH_SCHOOL_TESTING_AND_REFINING_20)
        CoversStandard(computerScience, computerScience:MIDDLE_SCHOOL_TESTING_AND_REFINING_20)
        CoversStandard(computerScience, computerScience:SPECIALTY_1_SOFTWARE_DEVELOPMENT_USER_EXPERIENCE_5)
        CoversStandard(computerScience, computerScience:HIGH_SCHOOL_PROGRAM_DEVELOPMENT_14)
        CoversStandard(computerScience, computerScience:MIDDLE_SCHOOL_PROGRAM_DEVELOPMENT_14)
        StandardsList(computerScience)
    end

    action Explore
        Section("Explore")
        WhatAToolBarDoes()
        BuildingAToolBar()
        UsingTheKeyboard()
        SharingBehaviors()
        Icons()
    end

    private action WhatAToolBarDoes
        Subsection("What a toolbar does")
        Paragraph("A "):Code("ToolBar"):Text(" is a control that holds other controls, usually buttons, in a
single row. On its own, it does these things for you:")
        BulletList()
        ListItem("it stretches across the full width of whatever holds it, and is 30
pixels high;")
        ListItem("it lines its buttons up from left to right;")
        ListItem("it turns on a tooltip for each control you add, so pointing at a button
with the mouse shows a small hint, and so does pressing "):Keys("Shift", "F1"):Text(" on
the button that has the focus ("):Key("Esc"):Text(" closes it);")
        ListItem("it tells a screen reader that it is a toolbar, and lets the user move
between its buttons with the arrow keys.")

        Paragraph("A toolbar should hold only the commands people use most. If every command
went on the toolbar, it would be as hard to search as a menu.")
    end

    private action BuildingAToolBar
        Subsection("Building a toolbar")
        Paragraph("This tutorial uses "):Code("OutputBehavior"):Text(" from the "):Link("Menus", "/tutorials/ui/menu.html"):Text("
tutorial. Add a class with that name:")
        CodeExampleFromFile("sources/tutorials/ui/ToolBar/OutputBehavior.quorum")

        Paragraph("A page has no "):Code("AddToolBar"):Text(" action, so you make the toolbar yourself and
give it to the page's plain "):Code("Add"):Text(" action, as you did with the menu bar.
Add it first, so it is the top row of the page.")

        Paragraph("Now replace "):Code("Main.quorum"):Text(". "):Code("MakeButton"):Text(" builds one button, gives it a
name, a description and an "):Code("OutputBehavior"):Text(", and returns it:")
        CodeExampleFromFile("sources/tutorials/ui/ToolBar/Main.quorum")

        Paragraph():Code("SetName"):Text(" replaces the toolbar's default name, "):DoubleQuote():Text("Toolbar"):DoubleQuote():Text(", with one that
tells a screen reader user what the buttons are for.")
    end

    private action UsingTheKeyboard
        Subsection("Using a toolbar with the keyboard")
        Paragraph("A toolbar is one stop in the page's "):Key("Tab"):Text(" order. You press "):Key("Tab"):Text(" to reach
the toolbar, then use the arrow keys to move between its buttons. Because
the toolbar is first on this page, it has the focus when the app starts.
When the toolbar or any of its buttons has the focus, these keys work:")

        Table("A toolbar's keys")
        TableHeader():Cell("Key"):Cell("What it does")
        TableRowWriter nextRow = TableRow()
        nextRow:Cell():Key("Right arrow"):Text(" or "):Key("Down arrow")
        nextRow:Cell("Moves the focus to the next button. After the last button it goes back to the first.")
        TableRowWriter previousRow = TableRow()
        previousRow:Cell():Key("Left arrow"):Text(" or "):Key("Up arrow")
        previousRow:Cell("Moves the focus to the previous button. Before the first button it goes to the last.")
        TableRowWriter pressRow = TableRow()
        pressRow:Cell():Key("Space"):Text(" or "):Key("Enter")
        pressRow:Cell("Presses the button that has the focus.")
        TableRowWriter tabRow = TableRow()
        tabRow:Cell():Key("Tab"):Text(" or "):Keys("Shift", "Tab")
        tabRow:Cell("Leaves the toolbar for the next or previous control on the page.")

        Paragraph("When the toolbar itself has the focus, pressing "):Key("Right"):Text(" or "):Key("Down"):Text(" moves the
focus to its first button, and pressing "):Key("Left"):Text(" or "):Key("Up"):Text(" moves it to its last
button.")

        Paragraph():Key("Tab"):Strong(" and the toolbar."):Text(" The form sets the "):Key("Tab"):Text(" order for the controls
on the page: here, the toolbar and the message. The buttons are inside the
toolbar, so "):Key("Tab"):Text(" doesn't stop on each one. The arrow keys move between the
buttons, and "):Key("Tab"):Text(" or "):Keys("Shift", "Tab"):Text(" on any button moves on to the next or
previous control on the page. This follows the toolbar pattern in the
W3C's WAI-ARIA Authoring Practices, a guide to accessible controls.")
    end

    private action SharingBehaviors
        Subsection("Sharing behaviors with a menu bar")
        Paragraph("Most toolbar buttons are copies of menu commands. When a button and a menu
item should do exactly the same thing, give them the "):Strong("same behavior
object"):Text(". Then there is only one place to change if the command changes.")

        Paragraph("The finished program below has a menu bar, then a toolbar, then the
message. The "):Code("AddCommand"):Text(" action makes one "):Code("OutputBehavior"):Text(", then makes a menu
item and a toolbar button that both use it.")
        CodeExampleFromFile("sources/tutorials/ui/ToolBar/Main2.quorum")

        Paragraph("Run it. Choosing Animals, then Dog, and pressing the Dog button on the
toolbar now do the same thing, because they run the same "):Code("OutputBehavior"):Text(".
The form puts the menu bar, the toolbar and the message in the "):Key("Tab"):Text(" order,
from top to bottom. On a toolbar button, "):Key("Tab"):Text(" goes on to the message and
"):Keys("Shift", "Tab"):Text(" goes back to the menu bar.")

        BlockEditorFile("OutputBehavior.quorum", "html/sources/tutorials/ui/ToolBar/OutputBehavior.quorum")
        BlockEditor("Main.quorum", "html/sources/tutorials/ui/ToolBar/Main2.quorum", "", true, true)
    end

    private action Icons
        Subsection("Icons on toolbar buttons")
        Paragraph("Many toolbars show small pictures instead of words. If you give a button an
icon, still give it a name with "):Code("SetName"):Text(". A screen reader cannot describe
a picture; it reads the name. A good rule is that every toolbar button
should still make sense from its name alone.")

        Paragraph("If you use icons that someone else made, they are that person's
"):Strong("intellectual property"):Text(". Check the icon's license, which says whether
you may use it and how, and give the credit it asks for, such as the
artist's name and where the icon came from, in your program's About
command or its documentation.")
    end

    action Engage
        Section("Engage")
        Paragraph("In this activity, you and a partner add a toolbar to the menu bar you
designed in the "):Link("Menus", "/tutorials/ui/menu.html"):Text(" tutorial, and test which
commands deserve a place on it. The goal is to decide which commands people
use most, and to share one behavior between a menu item and a toolbar
button. Start by picking the three or four commands you think people will
use most, and explain your choice to your partner. Then add a toolbar with
those commands, sharing each behavior with its menu item.")

        Paragraph("When it works, swap programs with your partner, and do a short task in
theirs, such as drawing two shapes and saving. Your partner counts how
often you use the toolbar and how often the menu. Afterwards, tell your
partner which command you reached for and didn't find on the toolbar.
Based on their counts and your partner's feedback, move one command onto or
off the toolbar.")
    end

    action WrapUp
        Section("Wrap up")
        Paragraph("A toolbar repeats commands that are already in a menu. Why is it worth
having the same command in two places? What could go wrong if the toolbar
button and the menu item used two different behaviors?")
    end
end
