use Libraries.Web.Page.all
use Libraries.Web.Page.Standards.ComputerScienceStandards2026
use Libraries.Web.Page.Standards.QuorumStandards

/*
    Tutorial: Dialogs, small windows that open on top of a program, in the
    user interface series.
*/
class UserInterfacesDialog is QuorumPage
    // The site's sets of standards, built once for every page.
    QuorumStandards standards
    // A double quote, for code that holds one.
    text dq = ""

    on create
        SetLocation("tutorials/ui/dialog.html")
        SetShortTitle("Dialogs")
        SetSectionName("User Interfaces")
    end

    action Setup
        dq = dq:GetDoubleQuote()

        // For search engines and link previews.
        SetDescription("Build a Quorum Dialog, open it from a button on a Form, give it more than one page, make it work with a keyboard and a screen reader, and evaluate a real law, the GDPR.")

        Title("Dialogs")

        Overview()
        WarmUp()
        Explore()
        Engage()
        WrapUp()
    end

    action Overview
        Section("Overview")
        Paragraph("A "):Strong("dialog"):Text(" is a small window that opens on top of a program to show
something for a short time: a message, a warning, a few settings, or a
question. When the person is done, the dialog closes and they go back to
what they were doing. In Quorum, a "):Code("Dialog"):Text(" holds a "):Strong("page"):Text(", the same kind
of page that a Form uses, so you fill a dialog with labels and buttons the
same way you fill a Form. In this tutorial, you will build a dialog, open it
from a button on a Form, close it, give it more than one page, and make sure
it works well with a keyboard and a screen reader.")

        Subsection("Goals")
        Paragraph("You have the following goals for this tutorial:")
        Goals()
        ListItem("Make your own dialog class that inherits from "):Code("Dialog")
        ListItem("Fill a dialog with a page of labels and buttons using "):Code("InitializeDefaultPage")
        ListItem("Open and close a dialog with "):Code("Show"):Text(", "):Code("Hide"):Text(" and the "):Key("Escape"):Text(" key")
        ListItem("Move between pages in a dialog with "):Code("SetCurrentPage")
        ListItem("Evaluate the reasons behind a real law, the GDPR, that shapes the consent
dialogs many websites show")
    end

    action WarmUp
        Section("Warm up")
        Paragraph("Think of a dialog you have used recently. Maybe a program asked "):DoubleQuote():Text("Save
changes before closing?"):DoubleQuote():Text(", or a game showed a help box. What was it asking
you? Could you use the rest of the program while it was open? How did you
close it? If you use a keyboard or a screen reader, where did your focus go
when it opened, and where did it go when it closed?")

        Subsection("Vocabulary")
        Paragraph("You will be learning about the following vocabulary words:")
        Table("Vocabulary", "media/userInterface/Dialog/Vocabulary.csv")

        Subsection("New Code to Learn")
        Paragraph("You will be using the following new pieces of code:")
        Table("New Code to Learn", "media/userInterface/Dialog/Code.csv")

        Subsection("CSTA Standards")
        Paragraph("This tutorial covers the following "):Link("CSTA standards", "https://csteachers.org/pk12standards/view/"):Text(":")
        ComputerScienceStandards2026 computerScience = standards:GetComputerScience2026()
        CoversStandard(computerScience, computerScience:HIGH_SCHOOL_PROGRAM_DEVELOPMENT_12)
        CoversStandard(computerScience, computerScience:MIDDLE_SCHOOL_PROGRAM_DEVELOPMENT_12)
        CoversStandard(computerScience, computerScience:SPECIALTY_1_SOFTWARE_DEVELOPMENT_USER_EXPERIENCE_4)
        CoversStandard(computerScience, computerScience:HIGH_SCHOOL_IMPACTS_OF_COMPUTING_SYSTEMS_36)
        StandardsList(computerScience)
    end

    action Explore
        Section("Explore")

        WhatIsInADialog()
        MakingADialogClass()
        OpeningTheDialogFromAPage()
        MoreThanOnePage()
        HidingTheTopBar()
        DialogsAndTheKeyboard()
        DialogsAndTheLaw()
    end

    private action WhatIsInADialog
        Subsection("What is in a dialog")
        Paragraph("Every Quorum dialog has two parts:")
        BulletList()
        ListItem("a "):Strong("top bar"):Text(", which shows the dialog's name and an X button that closes it;")
        ListItem("a "):Strong("page"):Text(" under the top bar, which holds everything else.")

        Paragraph("A page stacks what you add to it in rows, from top to bottom. If you have
read the "):Link("Forms", "/tutorials/ui/forms.html"):Text(" and
"):Link("Pages", "/tutorials/ui/pages.html"):Text(" tutorials, this is the same "):Code("Page"):Text(" you
used there, with the same "):Code("AddLabel"):Text(" and "):Code("AddButton"):Text(" actions.")

        Paragraph("A dialog can also be "):Strong("modal"):Text(". While a modal dialog is open, clicks and
key presses outside it are ignored, so the person has to deal with the
dialog first.")
    end

    private action MakingADialogClass
        Subsection("Making a dialog class")
        Paragraph("Add a new class named "):Code("HelpDialog.quorum"):Text(". Your class
"):Strong("inherits"):Text(" from "):Code("Dialog"):Text(", so it gets all of "):Code("Dialog"):Text("'s actions. (The
"):Link("Inheritance tutorial", "/tutorials/language/inheritance.html"):Text(" explains more
about inheritance.)")
        CodeExampleFromFile("sources/tutorials/ui/Dialog/HelpDialog.quorum")

        Paragraph("Here is what each part does:")
        BulletList()
        ListItem():Code("SetName(" + dq + "Help" + dq + ")"):Text(" gives the dialog its name. The name is shown in the top
bar, and a screen reader reads it when the dialog opens.")
        ListItem():Code("SetPixelWidth"):Text(" and "):Code("SetPixelHeight"):Text(" give the dialog its size. Set the
size "):Strong("before"):Text(" you call "):Code("InitializeDefaultPage"):Text(", because the page fits
itself to the dialog.")
        ListItem():Code("DialogHideBehavior"):Text(" is a behavior that comes with Quorum. When it runs,
it closes the dialog you gave it with "):Code("SetDialog"):Text(". Here it is used twice:")
        NestedBulletList()
        ListItem("on the Close button;")
        ListItem("with the dialog's own "):Code("SetBehavior"):Text(", which runs when the person presses
"):Key("Enter"):Text(" and the focus is not on a button.")
        EndNestedList()
        ListItem():Code("InitializeDefaultPage()"):Text(" creates an empty page, puts it in the dialog,
and returns it. Then you add a label and a button to the page, just as on
a Form's page. As on a Form, the first name you give "):Code("AddLabel"):Text(" names the
label, and the second is the text it shows.")
        ListItem():Code("OnShow"):Text(" runs every time the dialog opens. It moves the focus to the first
thing on the page, which is the label. A screen reader user hears the help
message first, and can press "):Key("Tab"):Text(" to reach the Close button. A dialog
doesn't move the focus into itself, so this one line does it:
"):Code("GetFirstFocusableItem"):Text(" finds the first control on the page, and "):Code("Focus"):Text("
gives it the focus. The "):Link("Focus", "/tutorials/ui/focus.html"):Text(" tutorial covers
the focus in full.")
        ListItem():Code("OnHide"):Text(" runs every time the dialog closes.")
    end

    private action OpeningTheDialogFromAPage
        Subsection("Opening the dialog from a page")
        Paragraph("A dialog is not added to a page. Instead, something calls its "):Code("Show"):Text("
action. Here, a button on the Form's page does it. Add a class named
"):Code("ShowDialogBehavior.quorum"):Text(":")
        CodeExampleFromFile("sources/tutorials/ui/Dialog/ShowDialogBehavior.quorum")

        Paragraph("Because "):Code("dialog"):Text(" has the type "):Code("Dialog"):Text(", this behavior can open any dialog,
including the ones you make later in this tutorial.")

        Paragraph("Now replace "):Code("Main.quorum"):Text(":")
        CodeExampleFromFile("sources/tutorials/ui/Dialog/Main.quorum")

        Paragraph("Run the program, press "):Key("Tab"):Text(" to reach the Help button, and press "):Key("Space"):Text(".
The dialog opens in the middle of the window. You can close it four ways:")
        BulletList()
        ListItem("press "):Key("Tab"):Text(" to reach the Close button, then press "):Key("Space"):Text(" or "):Key("Enter"):Text(";")
        ListItem("press "):Key("Enter"):Text(" while the help text has the focus, which runs the dialog's
behavior;")
        ListItem("press "):Key("Escape"):Text(", which closes any dialog;")
        ListItem("click the X in the top bar.")

        Paragraph("When the dialog closes, the focus goes back to the Help button, the control
that had it before the dialog opened. A keyboard user is right where they
left off.")
    end

    private action MoreThanOnePage
        Subsection("More than one page")
        Paragraph("Some dialogs walk a person through steps, like a setup screen with Next and
Back buttons. A dialog can do this by switching pages:")
        BulletList()
        ListItem():Code("InitializeDefaultPage"):Text(" makes the first page.")
        ListItem("For each other page, make a "):Code("StackedRowPage"):Text(" yourself, and call
"):Code("ApplyDefaultStyleToPage"):Text(" so it gets the same size and border.")
        ListItem():Code("SetCurrentPage"):Text(" swaps the page the dialog shows.")

        Paragraph("Add a class named "):Code("WelcomeDialog.quorum"):Text(":")
        CodeExampleFromFile("sources/tutorials/ui/Dialog/WelcomeDialog.quorum")

        Paragraph("The Next button needs a behavior that calls "):Code("ShowSecondPage"):Text(". Add a class
named "):Code("NextPageBehavior.quorum"):Text(":")
        CodeExampleFromFile("sources/tutorials/ui/Dialog/NextPageBehavior.quorum")

        Paragraph("To try it, change "):Code("Main.quorum"):Text(" so the button opens a "):Code("WelcomeDialog"):Text("
instead:")
        CodeExampleFromFile("sources/tutorials/ui/Dialog/Main2.quorum")

        Paragraph("Some things to notice:")
        BulletList()
        ListItem():Code("OnShow"):Text(" always goes back to the first page, so the dialog starts over
each time it opens.")
        ListItem("Each time the page changes, the focus moves to the first thing on the new
page. Without this, a keyboard or screen reader user would be left on a
button that is no longer on the screen.")
        ListItem("Each label says "):DoubleQuote():Text("Step 1 of 2"):DoubleQuote():Text(" or "):DoubleQuote():Text("Step 2 of 2"):DoubleQuote():Text(", so everyone knows how many
steps there are.")
        ListItem():Code("SetBehavior"):Text(" changes what "):Key("Enter"):Text(" does on each page: Next on the first
page, Done on the second.")

        BlockEditorFile("WelcomeDialog.quorum", "html/sources/tutorials/ui/Dialog/WelcomeDialog.quorum")
        BlockEditorFile("NextPageBehavior.quorum", "html/sources/tutorials/ui/Dialog/NextPageBehavior.quorum")
        BlockEditorFile("ShowDialogBehavior.quorum", "html/sources/tutorials/ui/Dialog/ShowDialogBehavior.quorum")
        BlockEditor("Main.quorum", "html/sources/tutorials/ui/Dialog/Main2.quorum", "", true, true)
    end

    private action HidingTheTopBar
        Subsection("Hiding the top bar")
        Paragraph("Sometimes you don't want a top bar, for example on a splash screen when a
program starts. Call "):Code("SetTopBarVisible(false)"):Text(" in "):Code("Setup"):Text(", before the dialog
is shown:")
        CodeExampleFromFile("sources/tutorials/ui/Dialog/HideTopBar.quorum")

        Paragraph("Without a top bar, there is no X button, and the name is not shown on the
screen. So:")
        BulletList()
        ListItem("always give the dialog a button that closes it;")
        ListItem("still call "):Code("SetName"):Text(", because a screen reader uses the name even when it
is not shown;")
        ListItem("call "):Code("SetTopBarVisible"):Text(" "):Strong("before"):Text(" "):Code("InitializeDefaultPage"):Text(". The page makes
room for the top bar only if the top bar is turned on.")

        Paragraph():Key("Escape"):Text(" still closes a dialog that has no top bar.")
    end

    private action DialogsAndTheKeyboard
        Subsection("Dialogs and the keyboard")
        Paragraph("Here is a summary of the keys a dialog understands:")
        BulletList()
        ListItem():Key("Escape"):Text(" closes the dialog.")
        ListItem():Key("Enter"):Text(" runs the behavior you gave the dialog with "):Code("SetBehavior"):Text(", unless
the focus is on a button, which "):Key("Enter"):Text(" presses instead. If you didn't
give the dialog a behavior, "):Key("Enter"):Text(" does nothing on the dialog itself.")
        ListItem():Key("Tab"):Text(" and "):Keys("Shift", "Tab"):Text(" move between the labels and buttons on the page.")

        Paragraph("A good dialog always moves the focus into itself in "):Code("OnShow"):Text(". If it
doesn't, the focus stays on the control behind the dialog, and a keyboard
user can't reach the dialog at all. When the dialog closes, Quorum gives the
focus back to the control that had it before.")
    end

    private action DialogsAndTheLaw
        Subsection("Dialogs and the law: the GDPR")
        Paragraph("Many websites open a dialog the first time you visit, asking whether they
may use cookies. "):Strong("Cookie"):Text(" is a strange name for something simple: a cookie
is a small piece of text that a website stores in your web browser,
formatted so the site can keep data about you, such as whether you are
signed in or which pages you have visited. The next time you visit, the
browser sends the cookie back to the site. One reason for the dialog is a
law. The European Union's "):Strong("General Data
Protection Regulation (GDPR)"):Text(", Regulation (EU) 2016/679, sets rules for
how organizations handle personal data about people in the EU
("):Link("EUR-Lex", "https://eur-lex.europa.eu/eli/reg/2016/679/oj"):Text("). A few of its
rules:")
        BulletList()
        ListItem():Strong("Cookies can identify people."):Text(" The GDPR notes that people can be
linked to "):DoubleQuote():Text("online identifiers,"):DoubleQuote():Text(" such as "):DoubleQuote():Text("cookie identifiers,"):DoubleQuote():Text(" that can be
used to build profiles of them (Recital 30).")
        ListItem():Strong("Consent must be real."):Text(" Consent means a "):DoubleQuote():Text("freely given, specific,
informed and unambiguous"):DoubleQuote():Text(" agreement, shown "):DoubleQuote():Text("by a statement or by a clear
affirmative action"):DoubleQuote():Text(" (Article 4(11)).")
        ListItem():Strong("Saying no must be as easy as saying yes."):Text(" People may withdraw consent
at any time, and "):DoubleQuote():Text("it shall be as easy to withdraw as to give consent"):DoubleQuote():Text("
(Article 7(3)).")
        ListItem():Strong("Children need a parent."):Text(" For online services offered directly to
children, a child under 16 needs a parent's consent. Each EU country may
lower that age, but not below 13 (Article 8(1)).")
        ListItem():Strong("People can ask for their data to be erased"):Text(" in certain cases, such as
when it is no longer needed or when they withdraw consent (Article 17).")
        ListItem():Strong("Breaking the rules is costly."):Text(" The largest fines are up to 20 million
euros or 4% of a company's total worldwide yearly turnover (Article 83(5)).")

        Paragraph("The rule that a website must ask before storing cookies on your device
comes from a related EU law, the ePrivacy Directive (Article 5(3)). The
GDPR sets what counts as real consent
("):Link("EUR-Lex", "https://eur-lex.europa.eu/eli/dir/2002/58/oj/eng"):Text(").")
    end

    action Engage
        Section("Engage")
        Paragraph("In this activity, you build a consent dialog that follows the GDPR, then
judge the reasons behind the law. Use the rules in "):DoubleQuote():Text("Dialogs and the law:
the GDPR"):DoubleQuote():Text(" as your evidence.")

        NumberedList()
        ListItem():Strong("Plan it."):Text(" On paper or with physical manipulatives, design a cookie
consent dialog for a made-up website.
Write its name, its message and its buttons. For each GDPR rule listed
above, write how your dialog follows it. For example, Article 7(3) means
saying no can't take more steps than saying yes, and Article 4(11) means
nothing can be agreed to for the person in advance.")
        ListItem():Strong("Build it."):Text(" Make the dialog as a class that inherits from "):Code("Dialog"):Text(",
using "):Code("InitializeDefaultPage"):Text(", "):Code("AddLabel"):Text(" and "):Code("AddButton"):Text(", and open it
from a button on a Form's page, like the "):Code("HelpDialog"):Text(" example. Test that
you can open it, read it, choose an answer and close it with only the
keyboard.")
        ListItem():Strong("Judge the law."):Text(" Answer in a few sentences each:")
        NestedBulletList()
        ListItem("What problem does each rule try to solve, and who does it protect?")
        ListItem("What does each rule cost: for people using websites, for small
companies, for large ones?")
        ListItem("Is a dialog a good way to get real consent, or do people click
whatever ends the interruption? What evidence would help you decide?")
        ListItem("Compare one GDPR rule with COPPA, the US rule for children's data
from the "):Link("Pages", "/tutorials/ui/pages.html"):Text(" tutorial.
Which approach do you think works better, and why?")
        EndNestedList()
    end

    action WrapUp
        Section("Wrap up")
        Paragraph("Dialogs interrupt people. When is that a good thing, and when is it
annoying? Think of one dialog you have used that should not have been a
dialog at all. What could the program have done instead?")

        Paragraph("The next tutorial covers the "):Link("Option Dialog", "/tutorials/ui/optionDialog.html"):Text(",
a ready-made dialog that asks a yes or no question.")
    end
end
