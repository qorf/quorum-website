use Libraries.Web.Page.QuorumPage

/*
    Tutorial: Accessibility.
    Converted from the old Lesson page by plan 13's generator: the same
    words, now without Tailwind.
*/
class UserInterfacesAccessibility is QuorumPage

    on create
        SetLocation("tutorials/ui/accessibility.html")
        // The name lists and links use, and the series and track it belongs
        // to: its section and picture.
        SetShortTitle("Accessibility")
        SetSectionName("User Interfaces")
        // For search engines and link previews, and what lists of pages say.
        SetDescription("Learn about Accessibility in the Quorum programming language.")
        SetSummary("how to use Accessibility")
    end

    action Setup
        SetWebPageTitle("Accessibility Tutorial - Quorum Programming Language")
        Title("Tutorial: Accessibility")
        Paragraph("This tutorial will teach you about accessibility in Quorum")
        IntroductionToAccessibilityInQuorum()
    end

    private action IntroductionToAccessibilityInQuorum
        Section("Introduction to Accessibility in Quorum")
    end
end
