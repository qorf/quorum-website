use Libraries.Web.Page.QuorumPage

/*
    Tutorial: Playing Longer Audio.
    Converted from the old Lesson page by plan 13's generator: the same
    words, now without Tailwind.
*/
class AudioPlayLongerAudioTutorial is QuorumPage
    // A double quote, for code and words that hold one.
    text dq = ""

    on create
        SetLocation("tutorials/dsp/audioplaylongeraudiotutorial.html")
        // The name lists and links use, and the series and track it belongs
        // to: its section and picture.
        SetShortTitle("Playing Longer Audio")
        SetSectionName("Data Science")
        SetCardImage("/media/Sound.gif")
        // For search engines and link previews, and what lists of pages say.
        SetDescription("Learn how to code sound applications using the Quorum programming language.")
        SetSummary("how to play audio files Quorum")
    end

    action Setup
        dq = dq:GetDoubleQuote()
        SetWebPageTitle("Playing Longer Audio - Quorum Programming Language")
        Title("Tutorial: Playing Longer Audio")
        Paragraph("This tutorial teaches you how to stream large audio files in Quorum.")
        PlayingLongerAudioStreaming()
    end

    private action PlayingLongerAudioStreaming
        Section("Playing Longer Audio: Streaming")
        Paragraph("If we have a longer audio file, like one that contains a full-length song, we may want to load our file via the LoadToStream action. The LoadToStream action allows our audio file to be loaded in "):DoubleQuote():Text("chunks,"):DoubleQuote():Text("as they are needed instead of all at once. This is more efficient and allows the file to start playing more quickly than if it must wait for the entire audio file to be loaded, especially for longer sounds, like songs. In order to stream our Audio object, we will need a loop that keeps the Audio object streaming as long as it is playing. An example of this follows:")
        CodeExample("use Libraries.Sound.Audio

// this line creates our Audio object we will be using to stream
Audio streamingAudio

// this line loads a " + dq + "chunk" + dq + "of the data from the file " + dq + "LongSong.ogg" + dq + "to our Audio object
streamingAudio:LoadToStream(" + dq + "Sounds/longSong.ogg" + dq + ")

// this line plays the first " + dq + "chunk" + dq + "of the data that was loaded from the file
streamingAudio:Play()

// this loop will continuously check if the whole song has been played
repeat while streamingAudio:IsPlaying()
   // this gets the next " + dq + "chunk" + dq + "of data to play
   streamingAudio:Stream()
end")
        Paragraph("A Quorum File object can also be used instead of a text file path when calling the LoadToStream action.")
        Paragraph("If we are playing sound as part of a game using the Quorum Game Engine, the proper place to put the Stream() call is inside the Update action, which is called every frame in the Main Game Loop. This will ensure that the next "):DoubleQuote():Text("chunk"):DoubleQuote():Text("of sound will be loaded at every opportunity. An example of streaming in the game engine follows:")
        CodeExample("use Libraries.Game.Game
use Libraries.Sound.Audio

class Main is Game
   Audio audio1
   Audio song

   action Main
       StartGame()
   end

   action CreateGame
       audio1:Load(" + dq + "Sounds/Fwip.ogg" + dq + ")
       audio1:Play()
       song:LoadToStream(" + dq + "Sounds/song.ogg" + dq + ")
       song:Play()
   end

   action Update(number seconds)
       //since this action is in the main game loop and called every frame it should not be inside another loop.
       song:Stream()
   end
end")
        CodeEditorWithCode("Activity: Playing Longer Audio", "//the same thing but with a longer audio file")
    end
end
