use Libraries.Web.Page.QuorumPage
use Libraries.Web.Series.PageSeries
use Libraries.Containers.Array

/*
    The Legacy Audio Track page: a banner, then "About the Course" and a
    card for each unit (design B, plan 13 phase 5): its name, linked to its
    first lesson, its description, and what its lessons teach.
*/
class AudioTrack is QuorumPage
    // The track's units, in order, from the builder.
    Array<PageSeries> units = undefined

    on create
        SetLocation("lessons/audio.html")
    end

    action SetTrackSeries(Array<PageSeries> trackUnits)
        units = trackUnits
    end

    action Setup
        SetWebPageTitle("Audio Track - Quorum Programming Language")
        Banner("Legacy Audio Track", "Learning to code through programming Audio", "media/userInterface/quorumAssets/resources.png", "Quincy the bunny stacking books, representing how concepts build on other concepts in computer science")
        Section("About the Course")
        integer i = 0
        repeat while i < units:GetSize()
            PageSeries unit = units:Get(i)
            UnitCard(unit:GetName(), unit)
            i = i + 1
        end
    end
end
