use Libraries.Web.Page.QuorumPage

/*
    Using Quorum on Android Devices.
    Converted from the old Lesson page by plan 13's generator: the same
    words, now without Tailwind.
*/
class MobileAndroidTutorial is QuorumPage

    on create
        SetLocation("tutorials/mobile/android.html")
        // The name lists and links use, and the series and track it belongs
        // to: its section and picture.
        SetShortTitle("Android Mobiles Support")
        SetSectionName("Mobile")
        // For search engines and link previews, and what lists of pages say.
        SetDescription("Learn how to use the Quorum programming language for coding on Android devices.")
        SetSummary("how to use Quorum on an Android device.")
    end

    action Setup
        SetWebPageTitle("Setting Up Android - Quorum Programming Language")
        Title("Using Quorum on Android Devices")
        Paragraph("Quorum can be compiled to run on Android Devices.")
        InstallingAndroidStudio()
        ConfiguringAndroidStudio()
        SettingUpYourAndroidDevice()
        SendingYourProjectToTheAndroidApplication()
        PracticeSendingAGameProjectToTheAndroidApplicati()
    end

    private action InstallingAndroidStudio
        Section("Installing Android Studio")
        Paragraph("In order to use the android application features, you must first download "):Link("Android Studio", "https://developer.android.com/studio/"):Text(" and complete its installation.")
        Image("media/tutorials/android/pic1.png", "This is an image showing the Android Studio install wizard.")
        Paragraph("Additionally, you will need to install OpenJDK, as described on the "):Link("Downloads", "/download.html"):Text(" page of the Quroum website. If you have not already done so, follow the instructions there to properly install OpenJDK on your particular operating system.")
    end

    private action ConfiguringAndroidStudio
        Section("Configuring Android Studio")
        Paragraph("First, we need to open up the SDK Manager from either the "):DoubleQuote():Text("Configure"):DoubleQuote():Text(" or "):DoubleQuote():Text("Tools"):DoubleQuote():Text(" dropdown menus, as shown below.")
        Image("media/tutorials/android/pic4-1.png", "This is an image showing the Configure dropdown menu.")
        Image("media/tutorials/android/pic4.png", "This is an image showing the Tools dropdown menu.")
        Paragraph("In the "):DoubleQuote():Text("SDK Platforms"):DoubleQuote():Text(" tab, install Android SDK 21 by checking the "):DoubleQuote():Text("Android 5.0 (Lollipop)"):DoubleQuote():Text(" box and clicking the "):DoubleQuote():Text("Apply"):DoubleQuote():Text(" button. Then click "):DoubleQuote():Text("OK"):DoubleQuote():Text(" on the pop-up about making changes. Then wait for the installation to complete.")
        Image("media/tutorials/android/pic5.png", "This is an image showing the SDK Platforms tab.")
        Image("media/tutorials/android/pic6.png", "This is an image showing the Android 5.0 Lollipop box.")
        Paragraph("Next, switch to the "):DoubleQuote():Text("SDK Tools"):DoubleQuote():Text(" tab and check the "):DoubleQuote():Text("Show Package Details"):DoubleQuote():Text(" box in the bottom right corner. Then scroll down until you find the "):DoubleQuote():Text("NDK (Side by side),"):DoubleQuote():Text(" "):DoubleQuote():Text("CMake,"):DoubleQuote():Text(" and "):DoubleQuote():Text("NDK"):DoubleQuote():Text(" options. Select the NDK (Side by side) box, CMake's version 3.6, and the NDK box. Uncheck CMake's version 3.10 if it is already installed. Then click the "):DoubleQuote():Text("Apply"):DoubleQuote():Text(" button and confirm the changes once more. Now you can click the "):DoubleQuote():Text("OK"):DoubleQuote():Text(" button to exit the SDK Manager, and you can also exit Android Studio.")
        Image("media/tutorials/android/pic7.png", "This is an image showing the Show Package Details box.")
        Image("media/tutorials/android/pic8.png", "This is an image showing the NDK and CMake boxes.")
    end

    private action SettingUpYourAndroidDevice
        Section("Setting Up Your Android Device")
        BulletList()
        ListItem("Open the "):Strong("Settings"):Text(" application.")
        ListItem("Select "):Strong("System")
        ListItem("Select "):Strong("About Phone")
        ListItem("Find the section labeled "):Strong("Build Number"):Text(" and tap on the build number 7 times to enable Developer Options and Debugging on the device. When you return to the previous screen you will now be able to see the "):Strong("Developer Options"):Text(" section near the bottom.")
        ListItem("Click on the "):Strong("Developer Options")
        ListItem("Scroll down and enable "):Strong("USB Debugging"):Text(" on the device which will allow Android Studio and the Software Development Kit tools to recognize your Android device when it is connected using the USB for debugging.")
        Paragraph("Click the following link for more information on "):Link("enabling developer options and debugging", "https://developer.android.com/studio/debug/dev-options")
        Paragraph("After the Android device is set to enable USB debugging, you will need to set up your operating system to detect the device.")
        BulletList()
        ListItem("For "):Strong("MAC OS X"):Text(" users, you can skip this step, the system is already setup to detect your device automatically.")
        ListItem("For "):Strong("Windows"):Text(" users, you will first need to install an original equipment manufacturer (OEM) USB driver for Android Debug Bridge (ADB). Click the link for more information on "):Link("how to install the original equipment manufacturer (OEM) USB driver", "https://developer.android.com/studio/run/oem-usb")
        ListItem("For "):Strong("Ubuntu Linux"):Text(" users, use the command line "):Code("apt-get install android-tools-adb"):Text(" to install the Android Debug Bridge (ADB) tools package. This will give you the community maintained set of "):Code("udev"):Text(" rules for all Android devices. Additionally, you must ensure that you are part of the "):Code("plugdev"):Text(" group. To check which groups you are in use command line "):Code("id"):Text(". If you are not already in the plugdev group you can add yourself to the group by using the command line "):Code("sudo usermod -aG plugdev $LOGNAME")
        Paragraph("Click the following link for more information regarding "):Link("how to setup and connect your Android Device", "https://developer.android.com/studio/run/device"):Text(".")
    end

    private action SendingYourProjectToTheAndroidApplication
        Section("Sending Your Project to the Android Application")
        Paragraph("After you have installed Android Studio, the Java 8 update 211, and finished setting up your Android device, you are ready to connect the device to your computer via USB and send your project to the Android Application. The Quorum program that you are sending to the Android Application needs to use the Game class to work properly on Android devices. When your program is complete, simply plug the device in, right click on your Project in the side pane in the Quorum development environment, and select "):DoubleQuote():Text("Send to Android Application"):DoubleQuote():Text(" as shown:")
        Image("media/windows/SendToAndroid.png", "This is an image showing the send to Android Application selection option")
        Paragraph("Your Quorum project should now appear on the Android device's screen as an application labeled "):DoubleQuote():Text("Default."):DoubleQuote():Text(" Click on the application "):DoubleQuote():Text("Default"):DoubleQuote():Text(" and your project will run on the Android Device. If you have to make any changes to the project in Quorum, then you will need to delete/uninstall the existing "):DoubleQuote():Text("Default"):DoubleQuote():Text(" Android application on the device before resending the edited project to the Android Application.")
    end

    private action PracticeSendingAGameProjectToTheAndroidApplicati
        Section("Practice Sending a Game Project to the Android Application")
        Paragraph("Let's try sending a program to an Android device and then running that program as an Android Application. We will start by creating a simple Game Project like the one shown below. This game will create a teal square, 100 pixels by 100 pixels, positioned 100 pixels up and 100 pixels to the right of the bottom left hand corner of the screen. The square will then rotate 30 degrees every second.")
        CodeExample("use Libraries.Game.Game
use Libraries.Game.Graphics.Color
use Libraries.Game.Graphics.Drawable

class Main is Game
   Color color
   Drawable drawable
   action Main
       StartGame()
   end
   action CreateGame
       drawable:LoadFilledRectangle(100, 100, color:Teal())
       drawable:SetPosition(100, 100)
       Add(drawable)
   end
   action Update(number seconds)
       drawable:Rotate(30 * seconds)
   end
end")
        Paragraph("You can test the project in Quorum first to make sure that everything runs as expected (there are no bugs) before sending the project to the Android Application. After everything is running correctly, you can send the game to the Android Application by following the instructions above which include right clicking the project name in the side pane of the Quorum Development Environment and selecting "):DoubleQuote():Text("Send to Android Application."):DoubleQuote():Text(" The program will show up as an application labeled "):DoubleQuote():Text("Default"):DoubleQuote():Text(" on the device with the output on the screen of the Android Device matching the output from when you ran the project using the Quorum development environment.")
        Paragraph("The output from the above example should look similar to this (with the square demonstrating a rotating action).")
        Image("media/windows/GameView.png", "This image shows the output from the example game.")
    end
end
