use Libraries.Web.Page.QuorumPage

/*
    Loading a dataset "by Hand".
    Converted from the old Lesson page by plan 13's generator: the same
    words, now without Tailwind.
*/
class LoadFileByHand is QuorumPage
    // A double quote, for code and words that hold one.
    text dq = ""

    on create
        dq = dq:GetDoubleQuote()
        SetLocation("tutorials/SavingAndLoading/LoadingByHand.html")
        // The name lists and links use, and the series and track it belongs
        // to: its section and picture.
        SetShortTitle("Loading a File (By Hand)")
        SetSectionName("Data Science")
        // For search engines and link previews, and what lists of pages say.
        SetDescription("Learn about loading data ")
        SetSummary("how to load data " + dq + "by Hand" + dq + " in a file using DataFrames")
    end

    action Setup
        dq = dq:GetDoubleQuote()
        SetWebPageTitle("Data Science - Quorum Programming Language")
        Title("Loading a dataset " + dq + "by Hand" + dq)
        Paragraph("This tutorial tells use the DataFrame to load data "):DoubleQuote():Text("by Hand"):DoubleQuote()
        LoadingDataByHand()
        CodeExamplePart()
        TryItYourself()
    end

    private action LoadingDataByHand
        Section("Loading data " + dq + "by Hand" + dq)
        Paragraph("While normally we load data from a file or another source, we can also create it by hand. We recommend making our data in excel or other sources, but document this possibility here for completeness. By default, there are six column types we can add, NumberColumn, BooleanColumn, IntegerColumn, TextColumn, AudioColumn, and DateColumn. Here are brief explanations on each valid column data entry we can use.")
        Table("Column Types")
        TableHeader():Cell("Object"):Cell("Description"):Cell("Usage")
        TableRow():Cell("NumberColumn"):Cell("NumberColumns allow us to insert both integers and decimal values into our data sets."):Cell("NumberColumn numCol numCol:Add(" + dq + "1" + dq + ") numCol:Add(" + dq + "1.5" + dq + ")")
        TableRow():Cell("BooleanColumn"):Cell("BooleanColumns allow us to insert true and false values into our data sets."):Cell("BooleanColumn boolCol boolCol:Add(true) boolCol:Add(false)")
        TableRow():Cell("IntegerColumn"):Cell("IntegerColumns allow us to insert whole numbers into our data sets."):Cell("IntegerColumn intCol integerCol:Add(5) integerCol:Add(8)")
        TableRow():Cell("TextColumn"):Cell("TextColumns allow us to insert strings/text into our data sets."):Cell("TextColumn txtCol txtCol:(" + dq + "Mickey" + dq + ") txtCol:(" + dq + "Mouse" + dq + ")")
        TableRow():Cell("AudioColumn"):Cell("AudioColumns allow us to insert audio files into our data sets. It takes in a string which is the file path of the audio file. AudioColumn* will accept both .ogg files and .wav files."):Cell("AudioColumn aCol aCol:Add(" + dq + "..\Audio\squeak.mp4" + dq + ") aCol:Add(" + dq + "..\Audio\beep.mp4" + dq + ")")
        TableRow():Cell("DateColumn**"):Cell("DateColumns allow us to insert dates into our data sets."):Cell("DateColumn dCol dCol:Add(" + dq + "11/2/2022" + dq + ") dCol:Add(" + dq + "11/3/2022" + dq + ")")
        Paragraph("**DateColumn was added in Quorum 10.0.")
        Paragraph("For this example, we will be creating a dataset that incorporates a selection of the data types we can insert. What we want to start off is creating a DataFrame object to load our dataset. We will go ahead and name it 'frame.' Now, let us create the columns of the data types: number, boolean, integer, and text.")
        Paragraph("We should have the following code:")
        Paragraph():Strong("*Note that AudioColumns cannot be used with the ToText() function with DataFrames.")
    end

    private action CodeExamplePart
        Section("Code Example")
        CodeExample("//We need the DataFrame class to load in files for Data Science operations.
use Libraries.Compute.Statistics.DataFrame
use Libraries.Compute.Statistics.Columns.NumberColumn
use Libraries.Containers.Array
use Libraries.Compute.Statistics.DataFrameColumn
use Libraries.Compute.Statistics.Columns.TextColumn
use Libraries.Compute.Statistics.Columns.BooleanColumn
use Libraries.Compute.Statistics.Columns.IntegerColumn

//Create a DataFrame, which is essentially a table that understands 
//more information about the data that is being loaded.
DataFrame frame

NumberColumn numCol
TextColumn textCol
BooleanColumn boolCol
IntegerColumn intCol")
        Paragraph("Now that we have our data columns, we can simply use the Add(type element) with the respective column object we have created. Our Add(type element) can be used with all the different columns and will add our element of the respective data type within the data set. Here, we will add two elements to each column.")
        CodeExample("numCol:Add(1.4)
textCol:Add(" + dq + "Fruit" + dq + ")
boolCol:Add(true)
intCol:Add(6)

numCol:Add(3.5)
textCol:Add(" + dq + "Vegetable" + dq + ")
boolCol:Add(false)
intCol:Add(10)")
        Paragraph("Now that we have populated our dataset, we would like to insert them into the DataFrame. Doing this step actually helps construct the elements and form it into a CSV-style type of dataset. We can achieve this by calling the AddColumn(dataColumn type) function with our DataFrame 'frame' object. Here is a brief description of how AddColumn(dataColumn type) works.")
        Table("AddColumn Function")
        TableHeader():Cell("Function"):Cell("Description"):Cell("Usage")
        TableRow():Cell("frame:AddColumn(dataColumn type)"):Cell("This function takes in a data column of either: text, boolean, number, audio, integer, or date and constructs the column. It forms one column each instance it is called."):Cell("booleanColumn boolCol boolCol:Add(true) boolCol:Add(true) boolCol:Add(false) frame:AddColumn(boolCol)")
        Paragraph("For our case, calling AddColumn() will add the two elements of each type into a DataFrame. Afterwards, we can view our data set onto the console by calling the ToText() function with our 'frame' object as well. We will now be inserting the elements we have added onto our data frame as follows and displaying them onto the console:")
        CodeExample("frame:AddColumn(numCol)
frame:AddColumn(textCol)
frame:AddColumn(boolCol)
frame:AddColumn(intCol)

output frame:ToText()")
    end

    private action TryItYourself
        Section("Try it Yourself!")
        Paragraph("Press the blue run button to execute the code in the code editor. Press the red stop button to end the program. Your program will work when the console outputs "):DoubleQuote():Text("Build Successful!"):DoubleQuote()
        CodeEditorFromProject("Loading a File by Hand", "LoadFileHand.quorum", "examples/DataFrames/LoadFileHand.quorum")
        Paragraph("Congratulations! We have successfully created our first dataset. To view another example of loading data by hand we can reference it "):Link("here", "https://github.com/qorf/curriculum/blob/main/Reference/DataScience/Data%20Frames/FileLoadByHand.quorum"):Text(". To add on, here is another example of using the AudioColumn"):Text(" "):Link("here", "https://github.com/qorf/curriculum/blob/main/Reference/DataScience/Data%20Frames/FileLoadByHandAudio.quorum"):Text(".")
    end
end
