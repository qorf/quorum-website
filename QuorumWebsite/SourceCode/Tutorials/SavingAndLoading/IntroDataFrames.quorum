use Libraries.Web.Page.QuorumPage

/*
    Introduction to Data Science.
    Converted from the old Lesson page by plan 13's generator: the same
    words, now without Tailwind.
*/
class IntroDataFrames is QuorumPage
    // A double quote, for code and words that hold one.
    text dq = ""

    on create
        SetLocation("tutorials/SavingAndLoading/IntroDataFrames.html")
        // The name lists and links use, and the series and track it belongs
        // to: its section and picture.
        SetShortTitle("What is a DataFrame?")
        SetSectionName("Data Science")
        // For search engines and link previews, and what lists of pages say.
        SetDescription("Learn about data frames in the Quorum programming language.")
        SetSummary("Introduction to data frames")
    end

    action Setup
        dq = dq:GetDoubleQuote()
        SetWebPageTitle("Data Science - Quorum Programming Language")
        Title("Introduction to Data Science")
        Paragraph("This tutorial introduces the concept of DataFrames in Quorum.")
        WhatIsADataFrame()
        CreatingADataFrame()
        TryItYourself()
    end

    private action WhatIsADataFrame
        Section("What is a DataFrame?")
        Paragraph("The key component in loading data is to use a DataFrame. A DataFrame is a series of rows and columns, like a table, except that the columns inside of this table understand information about their data and can transform it in a variety of ways. For example, one column might contain text, another might contain numbers, and another might contain integers. DataFrames can have selections, kind of like selecting a row or column in a spreadsheet, and can do operations on top of that selection.")
        Paragraph("We use DataFrames for everything in our library and always load and save it the same way. By default, Quorum data frames use the "):DoubleQuote():Text("Comma Separated Files"):DoubleQuote():Text(" method for loading into DataFrame objects. Second, if we want to, we can load a DataFrame by hand, meaning we can inject and use values in a table manually.")
    end

    private action CreatingADataFrame
        Section("Creating a DataFrame")
        Paragraph("To create a DataFrame, the way that we create it is defining it like a normal variable such as: DataType variableName. In this case, the data type would be of type DataFrame and we can name the DataFrame as any meaningful name. Typically, the easiest name for a DataFrame is to call it 'frame.' In many of our tutorials using DataFrames we use the naming convention 'frame' for consistency.")
        Subsection("Code Example")
        Paragraph("Once we have this DataFrame object created, we can now use these to access any datasets we have uploaded, create charts, compute data statistics, and much more.")
        CodeExample("DataFrame frame")
    end

    private action TryItYourself
        Section("Try it Yourself!")
        Paragraph("Press the blue run button to execute the code in the code editor. Press the red stop button to end the program. Your program will work when the console outputs "):DoubleQuote():Text("Build Successful!"):DoubleQuote()
        CodeEditorWithCode("Try Quorum", "output " + dq + "Hello World" + dq)
    end
end
