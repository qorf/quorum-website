use Libraries.Web.Page.QuorumPage

/*
    Saving data back to disk.
    Converted from the old Lesson page by plan 13's generator: the same
    words, now without Tailwind.
*/
class SavingData is QuorumPage
    // A double quote, for code and words that hold one.
    text dq = ""

    on create
        SetLocation("tutorials/SavingAndLoading/SavingData.html")
        // The name lists and links use, and the series and track it belongs
        // to: its section and picture.
        SetShortTitle("Saving Data")
        SetSectionName("Data Science")
        // For search engines and link previews, and what lists of pages say.
        SetDescription("Learn about saving data back in the Quorum programming language.")
        SetSummary("how to save data back using DataFrames")
    end

    action Setup
        dq = dq:GetDoubleQuote()
        SetWebPageTitle("Data Science - Quorum Programming Language")
        Title("Saving data back to disk")
        Paragraph("This tutorial tells use the DataFrame to save data back to disk")
        LoadingDataByHand()
        TryItYourselfSavingAFile()
        CodeExampleSavingAFileByHand()
        TryItYourselfSavingAFileByHand()
    end

    private action LoadingDataByHand
        Section("Loading data " + dq + "by Hand" + dq)
        Paragraph("Just like with loading, we can save DataFrame objects back to disk if we want to. Copying data is plausibly useful, but where this becomes more helpful is after cleaning. For example, in a typical data set in data science, we often gather data, clean it up to remove problems, and then make a copy of that cleaned data. We can automate that process in code, then save it back, so that we can then reproduce our results later. We will be showing two examples of how to save the data we have created using our DataFrames.")
        Paragraph("The first way is possibly the easiest way to save our data, which uses the Load(text fileLocation) function to read in a preexisting file such as:")
        CodeExample("//We need the DataFrame class to load in files for Data Science operations.
use Libraries.Compute.Statistics.DataFrame

//Create a DataFrame, which is essentially a table that understands 
//more information about the data that is being loaded.
DataFrame frame

//This loads the project relative to the project, so the Population.csv file in the Data folder
//If we deploy our program, this path is relative to the binary.
frame:Load(" + dq + "../Data/Geography/US States.csv" + dq + ")")
        Paragraph("And in this program, we end up manipulating the data by either removing unnecessary columns or adding more to our dataset. In order to save our modified dataset without changing the preexisting one, we can use the Save(text fileDestination) function in order to create a new copy of our new data. Here is a brief description of what our Save(text fileDestination) function does:")
        Table("Save Helper Function")
        TableHeader():Cell("Function"):Cell("Description"):Cell("Usage")
        TableRow():Cell("frame:Save(text fileDestination)"):Cell("This function takes in a string which is the file path of where we want this new dataset to be located in our file explorer. Note that the extension of our dataset must be a CSV file."):Cell("frame:Save(" + dq + "..\Data\catsNew.csv" + dq + ")")
        Paragraph("Here is an example of changing our loaded dataset and saving it onto a new dataset:")
        CodeExample("//We can now save this. This is not very useful in this example,
//but can be if we have data frames we have generated or transformed
frame:Save(" + dq + "../Data/Geography/US States.csv" + dq + ")")
    end

    private action TryItYourselfSavingAFile
        Section("Try it Yourself: Saving a File")
        Paragraph("Press the blue run button to execute the code in the code editor. Press the red stop button to end the program. Your program will work when the console outputs "):DoubleQuote():Text("Build Successful!"):DoubleQuote()
        CodeEditorFromProject("Saving a File with DataFrames", "Saving.quorum", "examples/DataFrames/Saving1.quorum")
    end

    private action CodeExampleSavingAFileByHand
        Section("Code Example: Saving a File by Hand")
        Paragraph("The other method is to use our data creation "):DoubleQuote():Text("by hand"):DoubleQuote():Text(" and save the data we made within Quorum onto our computer. To do this, let's take an example program:")
        CodeExample("//We need the DataFrame class to load in files for Data Science operations.
use Libraries.Compute.Statistics.DataFrame
use Libraries.Compute.Statistics.Columns.NumberColumn
use Libraries.Containers.Array
use Libraries.Compute.Statistics.DataFrameColumn
use Libraries.Compute.Statistics.Columns.TextColumn
use Libraries.Compute.Statistics.Columns.BooleanColumn
use Libraries.Compute.Statistics.Columns.IntegerColumn

//Create a DataFrame, which is essentially a table that understands 
//more information about the data that is being loaded.
DataFrame frame

//This creates a TextColumn, which contains strings/text
TextColumn txtColumn
txtColumn:SetHeader(" + dq + "Names" + dq + ")
txtColumn:Add(" + dq + "Daniel" + dq + ")
txtColumn:Add(" + dq + "Yuria" + dq + ")
txtColumn:Add(" + dq + "Kristine" + dq + ")
txtColumn:Add(" + dq + "Yuri" + dq + ")
txtColumn:Add(" + dq + "Rebecca" + dq + ")
txtColumn:Add(" + dq + "Brianna" + dq + ")

TextColumn txtColumn1
txtColumn1:SetHeader(" + dq + "Favorite Ice Cream" + dq + ")
txtColumn1:Add(" + dq + "Vanilla" + dq + ")
txtColumn1:Add(" + dq + "Matcha" + dq + ")
txtColumn1:Add(" + dq + "Birthday Cake" + dq + ")
txtColumn1:Add(" + dq + "Rocky Road" + dq + ")
txtColumn1:Add(" + dq + "Chocolate" + dq + ")
txtColumn1:Add(" + dq + "Strawberry" + dq + ")

//This creates a NumberColumn, which contains decimal values
NumberColumn numColumn
numColumn:SetHeader(" + dq + "Cost" + dq + ")
numColumn:Add(3.40)
numColumn:Add(3.50)
numColumn:Add(4.00)
numColumn:Add(4.10)
numColumn:Add(2.80)
numColumn:Add(2.50)

//This will add the data we added into a formal column
//Adding more columns will create the comma separation similar to a CSV
frame:AddColumn(txtColumn1)
frame:AddColumn(txtColumn)
frame:AddColumn(numColumn)

//The system loaded the file, but can also output it a text value, or the console, if we want that.
output frame:ToText()")
    end

    private action TryItYourselfSavingAFileByHand
        Section("Try it Yourself: Saving a File by Hand")
        Paragraph("Press the blue run button to execute the code in the code editor. Press the red stop button to end the program. Your program will work when the console outputs "):DoubleQuote():Text("Build Successful!"):DoubleQuote()
        CodeEditorFromProject("Saving a File by Hand with DataFrames", "Saving.quorum", "examples/DataFrames/Saving1.quorum")
        Paragraph("To view the whole code, we can click this"):Text(" "):Link("link", "https://github.com/qorf/curriculum/blob/main/Reference/DataScience/Data%20Frames/FileSaveExample2.quorum"):Text(".")
    end
end
