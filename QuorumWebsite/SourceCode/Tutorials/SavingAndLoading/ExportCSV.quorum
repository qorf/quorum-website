use Libraries.Web.Page.QuorumPage

/*
    Exporting a Comma Separated Value (CSV) File.
    Converted from the old Lesson page by plan 13's generator: the same
    words, now without Tailwind.
*/
class ExportCSV is QuorumPage

    on create
        SetLocation("tutorials/SavingAndLoading/ExportCSV.html")
        // The name lists and links use, and the series and track it belongs
        // to: its section and picture.
        SetShortTitle("Exporting a Comma Separated Value (CSV) File")
        SetSectionName("Data Science")
        // For search engines and link previews, and what lists of pages say.
        SetDescription("Learn about exporting CSVs in the Quorum programming language.")
        SetSummary("how to export a csv from excel and google sheets")
    end

    action Setup
        SetWebPageTitle("Data Science - Quorum Programming Language")
        Title("Exporting a Comma Separated Value (CSV) File")
        Paragraph("This tutorial tells you how to export a Comma Separated Value (CSV) file from Google Sheets or Excel")
        ExportingFromGoogleSheets()
        ExportingFromMircosoftExcel()
    end

    private action ExportingFromGoogleSheets
        Section("Exporting from Google Sheets")
        Paragraph("We assume that all data has been finalized to how we want it and are now ready to export our data to use for further analysis. This would be done by uploading an XLXS (Excel file) or by entering data in each box. How we can have our data be saved as a CSV is fairly simple on Google Sheets.")
        Image("media/tutorials/dataFrames/sh1.jpg", "Screenshot of Google Sheets, referencing an AskAManager Dataset")
        Paragraph("When we have our sheet file open, we would want to click on the 'File' tab on the left hand corner. Under 'Files' we now want to scroll down to 'Download' where it will pop-up a sub-menu on various file extensions which we can choose from. We want to navigate to the second to last option called 'Comma Separated Value' CSV and click it. This will prompt a download in which our file will be located in the 'Downloads' folder within our computers.")
    end

    private action ExportingFromMircosoftExcel
        Section("Exporting from Mircosoft Excel")
        Paragraph("We assume that all data has been finalized to how we want it and are now ready to export our data to use for further analysis. This would be done by uploading an XLXS (Excel file) or by entering data in each box. How we can have our data be saved as a CSV is fairly simple on Microsoft Excel.")
        Image("media/tutorials/dataFrames/excel1.jpg", "Screenshot of Mircosoft Excel, referencing a Dry Bean Dataset")
        Paragraph("When we have our sheet file open, we would want to click on the 'File' tab on the left hand corner. It should take us onto a new screen where we have many different saving options. We then want to go to the 'Save As' tab.")
        Image("media/tutorials/dataFrames/excel2.jpg", "Screenshot of Saving the file from Excel, Save As Page")
        Paragraph("Through there, we can specify the file location on where we want our newly created CSV file to live. Underneath where we can change the file name, we can choose the specific file extension with the pop-up drop down menu. From there, we want to select CSV (comma delimited) (*.csv) as our extension type. Then click the save button following on the right side of the file extension.")
    end
end
