use Libraries.Web.Page.QuorumPage

/*
    Tutorial: Actions.
    Converted from the old Lesson page by plan 13's generator: the same
    words, now without Tailwind.
*/
class ReducibilityTest is QuorumPage

    on create
        SetLocation("tutorials/statstest/reducibility.html")
        // The name lists and links use, and the series and track it belongs
        // to: its section and picture.
        SetShortTitle("Check Reducibility")
        SetSectionName("Statistical Tests")
        // For search engines and link previews, and what lists of pages say.
        SetDescription("Learn about Reducibility on Quorum Language.")
        SetSummary("how to check the reducibility of your data")
    end

    action Setup
        SetWebPageTitle("Check Reducibility - Quorum Programming Lanugage")
        Title("Tutorial: Actions")
        Paragraph("How to tell a program to take a behavior.")
        CheckReducibility()
    end

    private action CheckReducibility
        Section("Check Reducibility")
        Paragraph("The CheckReducibility Class in Quorum implements suitability checks that are needed before factor analysis to reduce the dimensionality of large datasets. It checks that the correlation between variables are about equal or the sphericity of it.")
        Paragraph("The Goodness of Fit tests if the frequency distribution was different from the expected frequency distribution. The Test of Independence tests if two variables are related to each other.")
        Table("Tests for a Significant Correlation Between Groups")
        TableHeader():Cell("Formal Test"):Cell("Action in CheckReducibility Class")
        TableRow():Cell("Bartlett's Test of Sphericity"):Cell("CheckReducibility")
        Subsection("Check if Variables are Correlated")
        Subsubsection():Text("Technical Test Name: "):Link("Bartlett's Test of Sphericity", "https://en.wikipedia.org/wiki/Bartlett%27s_test")
        Paragraph("A Bartlett's Test of Sphericity is used to determine if the correlation matrix is significantly different from the identity matrix. Essentially, if the correlation matrix is the identity matrix, then a Principal Component Analysis cannot be run to reduce the dataset since the variables will be uncorrelated.")
        Paragraph("Let's say we have a lot of different things like fruit and you want to put them all together based on their characteristics. We can group apples, bananas, and oranges together because they are sweet. Then we can group zucchini, cucumbers, and peppers together because they are vegetables.")
        Paragraph("Let's say we have a lot of different things like fruit and you want to put them all together based on their characteristics. We can group apples, bananas, and oranges together because they are sweet. Then we can group zucchini, cucumbers, and peppers together because they are vegetables.")
        Paragraph("This test checks if our data is suitable for factor analysis. Factor analysis is trying to group things together that are similar to each other. But before we can do that, we have to check if our data is good enough which is where Barlett's Test comes in.")
        Paragraph("It checks if our data is spherical or if all of our data is equally related to each other. If our data is not spherical, then that means some data is more related to others and is not really good enough for factor analysis. Below is an example of how to run this test in Quorum.")
        CodeEditorFromProject("Bartlett's Test of Sphericity", "Main.quorum", "examples/StatsTest/Bartletts.quorum"):HideDisplay()
    end
end
