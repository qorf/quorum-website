use Libraries.Web.Page.QuorumPage

/*
    Tutorial: Actions.
    Converted from the old Lesson page by plan 13's generator: the same
    words, now without Tailwind.
*/
class PCA is QuorumPage

    on create
        SetLocation("tutorials/statstest/pcaTest.html")
        // The name lists and links use, and the series and track it belongs
        // to: its section and picture.
        SetShortTitle("Principal Component Analysis")
        SetSectionName("Statistical Tests")
        // For search engines and link previews, and what lists of pages say.
        SetDescription("Learn about Principal Component Analysis on Quorum Language.")
        SetSummary("how to reduce big datasets")
    end

    action Setup
        SetWebPageTitle("Tests to Reduce Datasets - Quorum Programming Lanugage")
        Title("Tutorial: Actions")
        Paragraph("How to tell a program to take a behavior.")
        ReduceLargeSetsOfDataForAnalysis()
    end

    private action ReduceLargeSetsOfDataForAnalysis
        Section("Reduce Large Sets of Data For Analysis")
        Subsection():Text("Technical Name:"):Text(" "):Link("Principal Component Analysis", "https://en.wikipedia.org/wiki/Principal_component_analysis")
        Paragraph("The PrincipalComponentAnalysis (PCA) class in Quorum is a procedure in statistics that attempts to condense or summarize the information explained by large datasets (i.e. a large number of factors or variables) into a smaller set of components that can be easier to analyze or visualize.")
        Paragraph("One example would be figuring out what has caused cancer (generally). There can be many factors like genetics, diet, exposure, location, and so on which can be hard to understand. Using Principal Component Analysis, we can try to summarize these factors into a smaller number of components that will explain the variance between all of the factors and expose the key factors related to cancer.")
        Paragraph("It finds all the important information that could be related to what caused the cancer by looking at all the factors and figuring which ones are most different from each other. It then combines all those factors into a couple of new ones, called principal components, that get all the most important information.")
        Subsection("Rotations")
        Paragraph("Factors have a habit of loading on lots of variables, so to help us interpret them, we can "):DoubleQuote():Text("rotate"):DoubleQuote():Text("the results. This can maximize or minimize the loading of a particular variable on a particular factor.")
        Table("Rotations for PCA")
        TableHeader():Cell("Rotations"):Cell("Purpose"):Cell("Function Call")
        TableRow():Cell("Uncorrelated Component Rotation"):Cell("Orthogonal Varimax Rotation - keeps factors unrelated"):Cell("UseUncorrelatedRotation()")
        TableRow():Cell("Correlated Component Rotation"):Cell("Oblique Direct Quartimin Rotation - allows factors to be correlated"):Cell("UseCorrelatedRotation()")
        Subsection("Customize Rotations")
        Paragraph("Use the functions below to customize the rotations.")
        Table("Custom Functions for the PCA Class")
        TableHeader():Cell("Functions"):Cell("Purpose")
        TableRow():Cell("Normalize()"):Cell("Signifies if a Kaiser normalization takes place on the loading before the rotation. Resets to un-normalized afterwards.")
        TableRow():Cell("SetEpsilon()"):Cell("Signifies the convergence threshold (the percentage variance used to define key metrics as converged) compared to the difference of the criterion for each iteration in the rotation algorithm")
        TableRow():Cell("SetMaximumIterations()"):Cell("Signifies the stopping point even if convergence is not reached during a rotation")
        Paragraph("An example of the PCA test implemented in Quorum is below.")
        CodeEditorFromProject("Example of a Principal Component Analysis", "Main.quorum", "examples/StatsTest/PCA.quorum"):HideDisplay()
    end
end
