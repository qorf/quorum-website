use Libraries.Web.Page.QuorumPage

/*
    Tutorial: Actions.
    Converted from the old Lesson page by plan 13's generator: the same
    words, now without Tailwind.
*/
class CompareGroupsTests is QuorumPage

    on create
        SetLocation("tutorials/statstest/compareGroupsTests.html")
        // The name lists and links use, and the series and track it belongs
        // to: its section and picture.
        SetShortTitle("Compare Means")
        SetSectionName("Statistical Tests")
        // For search engines and link previews, and what lists of pages say.
        SetDescription("Learn about Statistical Tests Overview on Quorum Language.")
        SetSummary("how to compare the difference between groups ")
    end

    action Setup
        SetWebPageTitle("Tests to Compare Means - Quorum Programming Lanugage")
        Title("Tutorial: Actions")
        Paragraph("How to tell a program to take a behavior.")
        CompareMeans()
        OneGroup()
        TwoGroupsDifferentSubjectsPerGroup()
        TwoGroupsDifferentSubjectsPerGroup2()
        NGroupsDifferentSubjectsPerGroup()
        NGroupsSameSubjectsPerGroupRepeatedMeasurementsO()
        FactorialANOVAAndMANOVA()
    end

    private action CompareMeans
        Section("Compare Means")
        Paragraph("The CompareMeans class is ultimately getting at a tricky question in statistics. In English, we often think of this as whether separate distributions of data, like columns in a spreadsheet, are statistically significantly different from each other.")
        Paragraph("Consider an example. Suppose we have two columns of data in a spreadsheet. In the first column, the average is higher than the second. We can declare that and it might be true, but that data also has variation in it. Statistical tests at their core often try to balance 1) measures of centricity, 2) measures of dispersion, and 3) how much evidence is available. Intuitively, this makes sense. If the second group has a higher mean, but there is a lot of variation in the data and a small sample, this might indicate the result is less reliable than if there were more evidence or less variation. Statistical tests, while imperfect, try to balance these ideas and assign a number to them.")
        Paragraph("Quorum implements multiple parametric and non-parametric tests. It has the ability to measure differences in means or variables for data that is normally distributed and not normally distributed.")
        Paragraph("Listed below are functions that allow you to customize the statistical tests that you run. For example, the Ranked() function would be called when you want the results to be ranked or the call the RepeatedMeasures() function for tests that use repeated measures.")
        Table("Custom Functions for the Compare Means Class")
        TableHeader():Cell("Custom Functions"):Cell("Purpose")
        TableRow():Cell("Ranked()"):Cell("Set the ranked boolean to true for ranked samples observations. Default is false")
        TableRow():Cell("Paired()"):Cell("Set the ranked boolean to true for ranked samples observations. Default is false.")
        TableRow():Cell("RepeatedMeasures()"):Cell("Set the paired boolean to true for paired samples in a Two-Sample Test. Default is false.")
        TableRow():Cell("TestVarianceAssumption()"):Cell("Set the repeatedMeasures boolean to true in an N-sample test. Default is false.t")
        TableRow():Cell("TestDistributionAssumption()"):Cell("Set the testVarianceAssumption boolean to true to test variance assumptions. Default is false.")
        TableRow():Cell("AssumeEqualVariances()"):Cell("Set the assumeEqualVariances boolean to true to assume variances are equal. Default is false.")
        TableRow():Cell("AssumeNormalDistribution()"):Cell("Set the assumeNormalDistribution boolean to true to assume normal distribution.Default is false.")
        TableRow():Cell("CorrectFamilyWiseError()"):Cell("Set the correctFamilyWiseError boolean to false in N-sample pairwise tests. Default is true.")
        TableRow():Cell("SetMean()"):Cell("Set the mean in tests where it is applicable.")
        TableRow():Cell("SetMedian()"):Cell("Set the median in tests where it is applicable")
    end

    private action OneGroup
        Section("One Group")
        Paragraph("The tests listed below are used with a single sample group.")
        Table("Tests For One Group")
        TableHeader():Cell("Formal Test"):Cell("Action in CompareMeans Class")
        TableRow():Cell("Parametric: One-Sample T-Test"):Cell("CompareMeans")
        TableRow():Cell("Non-Parametric: Wilcoxon Signed Rank Test"):Cell("CompareRelatedRankedMeans")
        Subsection("Compare Mean with a Given Value")
        Subsubsection():Text("Technical Test Name: "):Link("One Sample T-Test", "https://en.wikipedia.org/wiki/Student%27s_t-test")
        Paragraph("We can test whether the mean of a population is different from a proposed value in Quorum by using a One Sample T-Test.")
        Paragraph("Let's say you had a snack that claimed it had 25 grams of protein. You can compare whether it really does. To do this, collect a sample of the same energy bars from different stores and record the grams of protein in each one. Then run compare it to 25 to determine if it is true or not.")
        Paragraph("An example of how the test is implemented in Quorum is shown below.")
        CodeEditorFromProject("Example of a One Sample T-Test", "Main.quorum", "examples/StatsTest/OneSampleTTest.quorum"):HideDisplay()
        Subsection("Compare Ranked Median with a Given Value")
        Subsubsection():Text("Technical Test Name: "):Link("Wilcoxon Signed Rank", "https://en.wikipedia.org/wiki/Wilcoxon_signed-rank_test")
        Paragraph("Using a Wilcoxon Signed Rank Test, we can test the median of a group of numbers of a single sample with a given median for data that is not normally distributed to determine if it is different or not. Such data does not have a bell shaped curve or has really big values.")
        Paragraph("For example, you want to see if a new medicine influences driving abilities. You would randomly pick a group of drivers for your group that took the medicine and then compare their driving abilities to the basic driving abilities for drivers that have not taken any medicine.")
        Paragraph("An example of how the test is implemented in Quorum is shown below.")
        CodeEditorFromProject("Example of a Wilcoxon Signed Rank Test", "Main.quorum", "examples/StatsTest/WilcoxonSignedRanks.quorum"):HideDisplay()
    end

    private action TwoGroupsDifferentSubjectsPerGroup
        Section("Two Groups: Different Subjects Per Group")
        Paragraph("The tests listed below are used with two sample groups from different populations.")
        Table("Tests For Two Groups: Different Subjects")
        TableHeader():Cell("Formal Test"):Cell("Action in CompareMeans Class")
        TableRow():Cell("Parametric: Two-Sample T-Test for Equal Variances, Welch's Two-Sample T-Test for Unequal Variances"):Cell("CompareMeans")
        TableRow():Cell("Non-Parametric: Mann-Whitney U-Test (Wilcoxon Rank Sum Test)"):Cell("CompareRankedMeans")
        Subsection("Compare Means of Two Samples With Equal Variances")
        Subsubsection():Text("Technical Test Name: "):Link("Two-Sample T-Test", "https://en.wikipedia.org/wiki/Student%27s_t-test")
        Paragraph("We can use a Two-Sample T-test to determine if the means of two samples are equal assuming that the sample groups have equal variances or in other words, the data is spread out equally.")
        Paragraph("One example where this test could be used is comparing the average scores on a quiz for students from two different schools.")
        Paragraph("Below is an example of how to run it in Quorum")
        CodeEditorFromProject("Example of a Two-Sample T-Test", "Main.quorum", "examples/StatsTest/TwoSampleTTest.quorum"):HideDisplay()
        Subsection("Compare Means of Two Samples With Unequal Variances")
        Subsubsection():Text("Technical Test Name: "):Link("Welch's Two-Sample T-Test", "https://en.wikipedia.org/wiki/Welch%27s_t-test")
        Paragraph("We can test data samples that have unequal variances to determine if the means of two populations are equal through a Welch's Two-Sample T-Test. This is the default test in Quorum.")
        Paragraph("Suppose that we want to improve the reading ability of elementary students through a series of activities for reading. Two groups of students would be needed - one group participating in the reading activities and one group not participating. At the end of the trial period, all students take a test to see if their reading abilities have improved or not. We can then compare if the activities helped from all the student's scores.")
        Paragraph("To implement this test in Quorum, refer to the example below.")
        CodeEditorFromProject("Example of a Welch Two-Sample T-Test", "Main.quorum", "examples/StatsTest/WelchTwoSample.quorum"):HideDisplay()
        Subsection("Compare Sample Populations")
        Subsubsection():Text("Technical Test Name: "):Link("Mann-Whitney U-Test or Wilcoxon Rank-Sum Test", "https://en.wikipedia.org/wiki/Mann%E2%80%93Whitney_U_test")
        Paragraph("We can determine if two different independent samples are from the same population through a Mann-Whitney U-Test. This test is for data that is not normally distributed, so it doesn't have a bell shaped curve.")
        Paragraph("As an example, suppose we are trying to see if exercise or healthy eating is better at lowering sugar levels. One group would exercise and the other group would eat healthy to determine at the end of the study which one lowered sugar more.")
        Paragraph("To do this test in Quorum, refer to the example below.")
        CodeEditorFromProject("Example of a Mann-Whitney U-Test", "Main.quorum", "examples/StatsTest/MannWhitney.quorum"):HideDisplay()
    end

    private action TwoGroupsDifferentSubjectsPerGroup2
        Section("Two Groups: Different Subjects Per Group")
        Paragraph("The tests listed below are used with two sample groups from different populations.")
        Table("Tests For Two Groups: Same Subjects")
        TableHeader():Cell("Formal Test"):Cell("Action in CompareMeans Class")
        TableRow():Cell("Parametric: Paired T-Test"):Cell("CompareRelatedMeans")
        TableRow():Cell("Non-Parametric: Wilcoxon Signed Rank Test"):Cell("CompareRelatedRankedMeans")
        Subsection("Compare Means of Two Dependent/Paired Groups with a Given Value")
        Subsubsection():Text("Technical Test Name: "):Link("Paired Two-Sample T-Test", "https://en.wikipedia.org/wiki/Student%27s_t-test")
        Paragraph("We can determine if the means of two paired groups are different from a proposed mean. To use this test in Quorum, refer to the example below.")
        Paragraph("One scenario for this test to be used would be seeing the effect of two different study methods on the average exam scores of students in the same class.")
        Paragraph("Below is an example of how to run it in Quorum")
        CodeEditorFromProject("Example of a Paired Two-Sample T-Test", "Main.quorum", "examples/StatsTest/PairedTTest.quorum"):HideDisplay()
        Subsection("Compare Ranked Medians of Two Paired Samples With a Given Value")
        Subsubsection():Text("Technical Test Name:"):Text(" "):Link("Wilcoxon Signed Rank Test - Two Groups", "https://en.wikipedia.org/wiki/Wilcoxon_signed-rank_test")
        Paragraph("We use a Wilcoxon Signed Rank Test to determine if the ranked medians of two paired samples is different from a proposed median. It is the same as the one previously mentioned, just with two groups now.")
        Paragraph("For example, imagine you are a student in an 8th-grade science class, and your teacher wants to see if a new way of teaching helps students learn better. She decides to split the class into two groups - one group will be taught using the traditional method, and the other group will be taught using the new method. Both groups will take a pre-test to see what they already know, and then they will be taught using their assigned methods. After a certain period of time, both groups will take a post-test to see how much they have learned. The Wilcoxon Signed Rank Test can be used to compare the scores of the two groups. Since the same students are taking both tests, we can pair up their scores and see if there is a significant difference between the two groups.")
        Paragraph("To implement this test factorin Quorum, refer to the example below.")
        CodeEditorFromProject("Example of a Wilcoxon Signed Rank Test", "Main.quorum", "examples/StatsTest/WilcoxonSignedRanks2.quorum"):HideDisplay()
    end

    private action NGroupsDifferentSubjectsPerGroup
        Section("N Groups - Different Subjects Per Group")
        Paragraph("The tests listed below are used for a N (two or more) amount of different groups. Consider the post-hoc analysis tests after running the tests below.")
        Table("Tests For N Groups: Different Subjects")
        TableHeader():Cell("Formal Test"):Cell("Action in CompareMeans Class")
        TableRow():Cell("Parametric: One-Way ANOVA for Equal Variances, Welch's One-Way ANOVA for Unequal Variances"):Cell("CompareMeans, CompareMeansAssumingEqualVariances")
        TableRow():Cell("Non-Parametric: Kruskal-Wallis H-Test"):Cell("CompareRankedMeans")
        Subsection("Compare Means of Two or More Different Groups with Equal Variances")
        Subsubsection():Text("Technical Test Name:"):Text(" "):Link("One-Way ANOVA", "https://en.wikipedia.org/wiki/One-way_analysis_of_variance")
        Paragraph("We can check if the means of two or more different groups are different from each other by using a One-Way ANOVA. It would work best with three or more groups.")
        Paragraph("A scenario in which this test would be used is finding the difference between average headache relief given three different medicines.")
        Paragraph("An example of how to implement this test in Quorum is shown below.")
        CodeEditorFromProject("Example of a One-Way ANOVA", "Main.quorum", "examples/StatsTest/OneWayAnova.quorum"):HideDisplay()
        Paragraph("We can use Tukey's HSD Multiple Comparison Test as a followup to do some post-hoc analysis.")
        Subsection("Compare Means of Two or More Different Groups with Unequal Variances")
        Subsubsection():Text("Technical Test Name: "):Link("Welch's ANOVA", "https://en.wikipedia.org/wiki/One-way_analysis_of_variance")
        Paragraph("We can use Welch's ANOVA Test to check if the means of two or more different groups with unequal variances are different from each other.")
        Paragraph("One scenario to use this test would be determining how outgoing different hair colors (brown, blonde, black, or red) are. It does not assume variances of the groups are equal meaning that there might be data that varies from the average.")
        Paragraph("An example of how to implement this test in Quorum is shown below.")
        CodeEditorFromProject("Example of a Welch's ANOVA", "Main.quorum", "examples/StatsTest/WelchAnova.quorum"):HideDisplay()
        Paragraph("The Games-Howell Multiple Comparison Test is most commonly used as the post-hoc analysis for this test.")
        Subsection("Compare Medians of Two or More Different Groups")
        Subsubsection():Text("Technical Test Name: "):Link("Kruskal-Wallis H-Test", "https://en.wikipedia.org/wiki/Kruskal%E2%80%93Wallis_one-way_analysis_of_variance")
        Paragraph("We use a Kruskal-Wallis Test to compare the medians of two or more different groups to see if they are different. It is an ANOVA test for data that does not have a normal distribution.")
        Paragraph("Suppose we want to measure the growth of a plant in different sunlight. We plant some seeds in five different spots with either lots of sunlight directly, medium sunlight, low sunlight, sunlight through a window, or no sunlight. After some time, we can measure the height of the plants that grew in each different sunlight. A Kruskal-Wallis test will help determine if sunlight impacts the growth of the plant using the median.")
        Paragraph("An example of how to do this test in Quorum is shown below.")
        CodeEditorFromProject("Example of a Kruskal-Wallis H-Test", "Main.quorum", "examples/StatsTest/KruskalWallis.quorum"):HideDisplay()
    end

    private action NGroupsSameSubjectsPerGroupRepeatedMeasurementsO
        Section("N Groups - Same Subjects Per Group (Repeated Measurements/Observations)")
        Paragraph("The tests listed below are used with a N (two or more) amount of groups from the same population.")
        Table("Tests For N Groups: Same Subjects")
        TableHeader():Cell("Formal Test"):Cell("Action in CompareMeans Class")
        TableRow():Cell("Parametric: Repeated Measures Anova"):Cell("CompareRelatedMeans")
        TableRow():Cell("Non-Parametric: Friedman Test"):Cell("CompareRelatedRankedMeans")
        Subsection("Compare Means of Several Similar Groups")
        Subsubsection():Text("Technical Test Name:"):Text(" "):Link("Repeated Measures ANOVA Test", "https://en.wikipedia.org/wiki/Repeated_measures_design")
        Paragraph("We can determine if the means of several similar groups are the same or not through repeated observations or trials over time.")
        Paragraph("One scenario to use the Repeated Measures One-Way ANOVA test would be tracking the weight gain of a puppy after eating a specific dog food for 6 weeks. Weighing the puppy before starting the dog food and every week after that for 6 weeks would be the repeated measures part.")
        Paragraph("Below is an example of how to run it in Quorum")
        CodeEditorFromProject("Example of a Repeated Measures ANOVA Test", "Main.quorum", "examples/StatsTest/RMAnova.quorum"):HideDisplay()
        Paragraph("We can run a Bonferroni Pairwise Procedure as a post hoc analysis test.")
        Subsection("Compare Medians of Several Similar Groups")
        Subsubsection():Text("Technical Test Name:"):Text(" "):Link("Friedman Test", "https://en.wikipedia.org/wiki/Friedman_test")
        Paragraph("We use a Friedman Test to compare the difference between the medians of three or more groups through repeated observations.")
        Paragraph("An example scenario of when this test could be used is watching movies. We could have a group of people watch five different movies and rate how good it was. Every person will rate the five movies so a Friedman test could determine if there are any major differences in the ratings of the five movies.")
        Paragraph("An example of how to do this test in Quorum is shown below.")
        CodeEditorFromProject("Example of a Friedman Test", "Main.quorum", "examples/StatsTest/FriedmanTest.quorum"):HideDisplay()
    end

    private action FactorialANOVAAndMANOVA
        Section("Factorial ANOVA and MANOVA")
        Paragraph("A Factorial ANOVA is a type of ANOVA that looks at two or more factors at the same time and can be either balanced or unbalanced. A factor is just a category or group that we're interested in.")
        Paragraph("This test uses the factors that we are interested in and tries to see what changes they caused on one dependent variable. For example, let's say we want to know if there's a difference in test scores based on both the number of hours studied per day AND the type of study method used (flashcards, reading notes, or practicing problems). We could use a Factorial ANOVA to analyze this data and see if there are significant differences between the different groups. Basically, a Factorial ANOVA is a statistical test that looks at multiple factors at the same time and can either be balanced or unbalanced which is explained in more detail below.")
        Paragraph("The tests listed below are used for a N (two or more) amount of different groups with more than one factor.")
        Table("Tests For N Groups: Multiple Factors")
        TableHeader():Cell("Formal Test"):Cell("Action in CompareMeans Class")
        TableRow():Cell("Parametric: Balanced Factorial ANOVA"):Cell("CompareMeans")
        TableRow():Cell("Non-Parametric: Unbalanced Factorial ANOVA"):Cell("CompareMeans")
        Subsection("Compare Several Means With Same Number of Groups")
        Subsubsection():Text("Technical Test Name:"):Text(" "):Link("Balanced Factorial ANOVA", "https://en.wikipedia.org/wiki/Two-way_analysis_of_variance")
        Paragraph("In a Balanced Factorial ANOVA, each group has the same number of participants.")
        Paragraph("We are going to use the example above to see what different study methods and different amounts of time affect test scores. For a Balanced Factorial ANOVA, if we have 3 different study methods and 3 different study hours (which are the factors), we would need the same number of participants in each of the 9 resulting groups. Then it would make the data balanced and we can then compare any differences between the groups.")
        Subsection("Compare Several Means With Different Number of Groups")
        Subsubsection():Text("Technical Test Name:"):Text(" "):Link("Unbalanced Factorial ANOVA", "https://en.wikipedia.org/wiki/Two-way_analysis_of_variance")
        Paragraph("In an Unbalanced Factorial ANOVA, groups might have more participants than others. This happens mostly when there are not enough groups or not enough people to recruit.")
        Paragraph("Let's use the example above to see what different study methods and different amounts of time affect test scores. We might have three groups for studying time: one group that studies for 1 hour, another group that studies for 2 hours, and a third group that studies for 3 hours. With these, there might be more participants in one group than in another like we have 10 participants in the 1 hour group, 15 participants in the 2 hour group, and 8 participants in the 3 hour group. This unequal grouping makes it harder to see differences between the groups, but it can be done using an Unbalanced Factorial ANOVA!")
        CodeEditorFromProject("Example of a Factorial ANOVA", "Main.quorum", "examples/StatsTest/FactorialAnova.quorum"):HideDisplay()
        Subsection("Factorial MANOVA")
        Paragraph("MANOVA stands for multivariate analysis of variance which is a type of statistical analysis that looks at the relationship between multiple variables.")
        Paragraph("A Factorial MANOVA looks at the effects of multiple independent variables (factors) on multiple dependent variables at the same time. This test helps us compare groups of data based on different variables (factors or characteristics) to see if there are any differences between them. Our goal is to see how the independent variables or factors affect the dependent variables.")
        Paragraph("The tests listed below are used for a N (two or more) amount of different groups with more than one factor.")
        Table("Tests For N Groups: Multiple Dependent Variables")
        TableHeader():Cell("Formal Test"):Cell("Action in CompareMeans Class")
        TableRow():Cell("Parametric: Factorial MANOVA"):Cell("CompareSeveralMeans")
        Subsection("Compare Means Of Several Groups With Multiple Dependent and Independent Variables")
        Subsubsection():Text("Technical Test Name:"):Text(" "):Link("Factorial MANOVA", "https://en.wikipedia.org/wiki/Multivariate_analysis_of_variance")
        Paragraph("In a Balanced Factorial ANOVA, each group has the same number of participants.")
        Paragraph("Imagine you have a bunch of data about different things, like the height, weight, and age of a group of people. Now, you want to find out if certain factors, like gender and exercise, have an effect on people's height or weight. A Factorial MANOVA lets you look at multiple factors together at the same time instead of looking at them one at a time.")
        CodeEditorFromProject("Example of a Factorial MANOVA", "Main.quorum", "examples/StatsTest/WilcoxonSignedRanks.quorum"):HideDisplay()
    end
end
