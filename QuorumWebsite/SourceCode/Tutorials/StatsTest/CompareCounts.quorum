use Libraries.Web.Page.QuorumPage

/*
    Tutorial: Actions.
    Converted from the old Lesson page by plan 13's generator: the same
    words, now without Tailwind.
*/
class CompareCountsTests is QuorumPage

    on create
        SetLocation("tutorials/statstest/compareCounts.html")
        // The name lists and links use, and the series and track it belongs
        // to: its section and picture.
        SetShortTitle("Compare Counts")
        SetSectionName("Statistical Tests")
        // For search engines and link previews, and what lists of pages say.
        SetDescription("Learn about comparing chances on Quorum Language.")
        SetSummary("how to compare the chances of your results")
    end

    action Setup
        SetWebPageTitle("Compare Counts - Quorum Programming Lanugage")
        Title("Tutorial: Actions")
        Paragraph("How to tell a program to take a behavior.")
        CompareCounts()
    end

    private action CompareCounts
        Section("Compare Counts")
        Paragraph("The CompareCounts Class in Quorum is used to determine if the results you got are different from what was expected for data that is not normally distributed. It implements two different tests: goodness of fit and test of independence.")
        Paragraph("The Goodness of Fit tests if the frequency distribution was different from the expected frequency distribution. The Test of Independence tests if two variables are related to each other.")
        Table("Tests For Checking the Chances of Your Results")
        TableHeader():Cell("Formal Test"):Cell("Action in CompareCounts Class")
        TableRow():Cell("Pearson's Chi-Squared Test"):Cell("CompareCounts")
        Subsection("Check Relationship Between Variables")
        Subsubsection():Text("Technical Test Name: "):Link("Pearson's Chi-Squared Test", "https://en.wikipedia.org/wiki/Pearson%27s_chi-squared_test")
        Paragraph("Pearson's Chi-Squared Test can calculate the frequency of unique items, calculate expected or observed counts, or compare tables and columns to return a chi-squared statistic. It can be used to test if two variables are related or not.")
        Paragraph("For example, Pearson's Chi-Squared Test can be used to see if there is any relation between the rate of certain colors being picked and gender. If the value you get back is a big number, then it means there is a strong relationship. If it is small, then it doesn't really have a relationship. Basically, Pearson's chi-squared test of independence is a way to figure out if two things are related by comparing what you actually observe to what you would expect if there was no relationship. Refer to the example below on how to do this test in Quorum.")
        CodeEditorFromProject("Pearson's Chi-Squared Test", "Main.quorum", "examples/StatsTest/PearsonsChiSquared.quorum"):HideDisplay()
    end
end
