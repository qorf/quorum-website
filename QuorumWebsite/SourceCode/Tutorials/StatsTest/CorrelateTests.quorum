use Libraries.Web.Page.QuorumPage

/*
    Tutorial: Actions.
    Converted from the old Lesson page by plan 13's generator: the same
    words, now without Tailwind.
*/
class CorrelateTests is QuorumPage

    on create
        SetLocation("tutorials/statstest/correlate.html")
        // The name lists and links use, and the series and track it belongs
        // to: its section and picture.
        SetShortTitle("Correlate Groups")
        SetSectionName("Statistical Tests")
        // For search engines and link previews, and what lists of pages say.
        SetDescription("Learn about Correlating Variables on Quorum Language.")
        SetSummary("how to correlate variables")
    end

    action Setup
        SetWebPageTitle("Correlate - Quorum Programming Lanugage")
        Title("Tutorial: Actions")
        Paragraph("How to tell a program to take a behavior.")
        CorrelateGroups()
    end

    private action CorrelateGroups
        Section("Correlate Groups")
        Paragraph("The CorrelateGroups Class in Quorum implements several tests that determine if variables have any relationship to each other. This test provides useful information about the variables that can be helpful in Regression tests.")
        Paragraph("Listed below are functions that can be used to customize the tests that you run.")
        Table("Set the ranked boolean to true for ranked samples observations. Default is false.")
        TableHeader():Cell("Custom Function"):Cell("Purpose")
        TableRow():Cell("Ranked()"):Cell("Set the ranked boolean to true for ranked samples observations. Default is false.")
        Paragraph("The tests listed below is used for two groups of related data.")
        Table("Tests for Two Groups")
        TableHeader():Cell("Formal Test"):Cell("Action in CompareGroups Class")
        TableRow():Cell("Parametric: Pearson Correlation Coefficient"):Cell("CorrelateSelectedColumns")
        TableRow():Cell("Non-Parametric: Spearman Correlation Coefficient"):Cell("CorrelateSelectedRankedColumns")
        Subsection("Measure Strength of Relationships For Related Data")
        Subsubsection():Text("Technical Test Name:"):Text(" "):Link("Pearson Correlation Coefficient", "https://en.wikipedia.org/wiki/Pearson_correlation_coefficient")
        Paragraph("A Pearson Correlation Coefficient measures the relationship between two related variables or groups. It can tell us how strong the relationship is and what direction it will change. This test tries to see if there is any connection between two things.")
        Paragraph("If the coefficient is between 0 and 1, then both will change in the same direction. An example of this is baby weight and length since the longer the length or height, the heavier the weight. If the coefficient is between 0 and -1, then they will change in opposite directions. One example of this would be the higher you go in the atmosphere, the less amount of oxygen there is. If it is zero, it means there is no relationship, but the farther away it is from zero means a stronger relationship.")
        CodeEditorFromProject("Example of a Pearson Correlation Coefficient", "Main.quorum", "examples/StatsTest/PearsonCorrelation.quorum"):HideDisplay()
        Subsection("Measure Strength of Relationships For Unrelated Data")
        Subsubsection():Text("Technical Test Name:"):Text(" "):Link("Spearman Correlation Coefficient", "https://en.wikipedia.org/wiki/Spearman%27s_rank_correlation_coefficient")
        Paragraph("A Spearman Correlation Coefficient measures the relationship between two variables or groups that may not necessarily be related. It tries to see if there is any connection between two things. It will use the rank of the values for the two groups to determine the strength and direction of their relationship. It is much like the Pearson Correlation Coefficient mentioned above.")
        Paragraph("If the coefficient is between 0 and 1, then both will change in the same direction and there is a strong positive relationship. If the coefficient is between 0 and -1, then they will change in opposite directions and there is a strong negative relationship. If it is zero, there is no correlation or relationship.")
        Paragraph("For example, let's say we have a big friend group and we want to know if their height and weight are related to each other. We can use this test to see if there is a relationship and how strong that relationship is. If it is close to 1, then that means taller friends usually weigh more. If it is 0 then there is no relationship between height and weight.")
        CodeEditorFromProject("Example of a Spearman Correlation Coefficient", "Main.quorum", "examples/StatsTest/SpearmanCorrelation.quorum"):HideDisplay()
    end
end
