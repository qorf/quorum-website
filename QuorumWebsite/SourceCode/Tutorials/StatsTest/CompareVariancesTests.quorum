use Libraries.Web.Page.QuorumPage

/*
    Tutorial: Actions.
    Converted from the old Lesson page by plan 13's generator: the same
    words, now without Tailwind.
*/
class CompareVarianceTest is QuorumPage

    on create
        SetLocation("tutorials/statstest/compareVariances.html")
        // The name lists and links use, and the series and track it belongs
        // to: its section and picture.
        SetShortTitle("Compare Variances")
        SetSectionName("Statistical Tests")
        // For search engines and link previews, and what lists of pages say.
        SetDescription("Learn how to compare chances on Quorum Language.")
        SetSummary("how to compare the variances between groups")
    end

    action Setup
        SetWebPageTitle("Compare Variances - Quorum Programming Lanugage")
        Title("Tutorial: Actions")
        Paragraph("How to tell a program to take a behavior.")
        CompareVariances()
        CheckForVarianceEqualityDifferentSubjectsPerGrou()
        CheckForVarianceSphericitySameSubjectsPerGroupRe()
    end

    private action CompareVariances
        Section("Compare Variances")
        Paragraph("The CompareVariances Class in Quorum implements multiple tests to check different properties to see if they vary in a similar way under different conditions. It is how different each value in the data is from the average. Listed below are functions that allow you to customize the statistical tests that you run. For example, the Ranked() function would be called when you want the results to be ranked or the call the RepeatedMeasures() function for tests that use repeated measures.")
        Table("Custom Functions for the Compare Variances Class")
        TableHeader():Cell("Custom Functions"):Cell("Purpose")
        TableRow():Cell("UseMedianAsCenter()"):Cell("Set the useMedianAsCenter boolean to false. Default is true.")
        TableRow():Cell("UseMeanAsCenter()"):Cell("Set the useMeanAsCenter boolean to true. Default is false.")
        TableRow():Cell("UseTrimmedMeanAsCenter()"):Cell("Set the useTrimmedMeanAsCenter boolean to true. Default is false.")
        TableRow():Cell("RepeatedMeasures()"):Cell("Set the repeatedMeasures boolean to true in an N-sample test. Default is false.")
    end

    private action CheckForVarianceEqualityDifferentSubjectsPerGrou
        Section("Check For Variance Equality - Different Subjects Per Group")
        Paragraph("The tests listed below are used for two or more independent groups in T-Tests and Anovas.")
        Table("Custom Functions for the Compare Variances Class")
        TableHeader():Cell("Formal Test"):Cell("Action in CompareVariances Class")
        TableRow():Cell("Levene's Homogeneity Of Variances Test"):Cell("CompareVariancesUsingMean")
        TableRow():Cell("Brown-Forsythe Homogeneity Of Variances Test"):Cell("CompareVariances")
        Subsection("Check if Groups Vary Using Mean")
        Subsubsection():Text("Technical Test Name:"):Text(" "):Link("Levene's Homogeneity of Variances Test", "https://en.wikipedia.org/wiki/Levene%27s_test")
        Paragraph("We use Levene's Homogeneity of Variances Test to determine if the groups vary in the same way by using the mean.")
        Paragraph("It checks if the variances of two or more groups are the same or not. Let's say we want to compare the heights of students in two different classes. We measure the heights in the two classes and then calculate the mean. But, the spread of data, variance, for each class might be different like one class could have a wider range of heights than the other class.")
        Paragraph("Levene's Test checks if the variances are equal and if they are not, then it means one class might have more height differences than the other class.")
        Paragraph("To do this test in Quorum, refer to the example below.")
        CodeEditorFromProject("Example of a Levene's Homogeneity of Variances Test", "Main.quorum", "examples/StatsTest/LeveneHomogeneity.quorum"):HideDisplay()
        Subsection("Check if Groups Vary Using Median")
        Subsubsection():Text("Technical Test Name:"):Text(" "):Link("Brown-Forsythe Homogeneity Of Variances Test", "https://en.wikipedia.org/wiki/Brown%E2%80%93Forsythe_test")
        Paragraph("A Brown-Forsythe Homogeneity Of Variances Test is used to determine if the groups vary in the same way by using the median or trimmed mean. It checks whether the variance or spread of two or more groups of data is similar or not.")
        Paragraph("Let's say you have two groups of students and you want to compare their test scores. Before you do that, you want to make sure that the spread of scores within each group is roughly the same. We can use this statistical test to check it.")
        Paragraph("Below is an example of the test using the median in Quorum.")
        CodeEditorFromProject("Example of a Brown-Forsythe Homogeneity of Variances Test", "Main.quorum", "examples/StatsTest/BrownForsytheHomogeneity.quorum"):HideDisplay()
    end

    private action CheckForVarianceSphericitySameSubjectsPerGroupRe
        Section("Check For Variance Sphericity - Same Subjects Per Group (Repeated Measurements)")
        Paragraph("The tests listed below are used for two or more dependent groups in Repeated Measures Anovas.")
        Table("Tests to Check Varaince Sphericity for the Same Subjects")
        TableHeader():Cell("Formal Test"):Cell("Action in CompareVariances Class")
        TableRow():Cell("Mauchly's Test Of Sphericity"):Cell("CompareRelatedVariances")
        Subsection("Check if Groups Vary With Repeated Measures")
        Subsubsection():Text("Technical Test Name:"):Text(" "):Link("Mauchly's Test of Sphericity", "https://en.wikipedia.org/wiki/Mauchly%27s_sphericity_test")
        Paragraph("Mauchly's Test of Sphericity determines if the variances of the differences, or sphericity, are equal. Essentially, it checks if several groups vary in a similar way when they are repeated measures or where something is tested more than once.")
        Paragraph("It checks if a Repeated-Measures ANOVA is right to analyze this type of data. If the variances of differences are not equal, then a Repeated-Measures ANOVA might not be the best to analyze your data. An example of how to conduct this test in Quorum is below.")
        CodeEditorFromProject("Example of a Mauchly's Test of Sphericity", "Main.quorum", "examples/StatsTest/MauchleySphericity.quorum"):HideDisplay()
    end
end
