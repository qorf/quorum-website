use Libraries.Web.Page.QuorumPage

/*
    Tutorial: Actions.
    Converted from the old Lesson page by plan 13's generator: the same
    words, now without Tailwind.
*/
class RegressionTest is QuorumPage

    on create
        SetLocation("tutorials/statstest/regressionTest.html")
        // The name lists and links use, and the series and track it belongs
        // to: its section and picture.
        SetShortTitle("Regression")
        SetSectionName("Statistical Tests")
        // For search engines and link previews, and what lists of pages say.
        SetDescription("Learn about Regression on Quorum Language.")
        SetSummary("how to predict the outcome")
    end

    action Setup
        SetWebPageTitle("Regression - Quorum Programming Lanugage")
        Title("Tutorial: Actions")
        Paragraph("How to tell a program to take a behavior.")
        Regression()
    end

    private action Regression
        Section():Link("Regression", "https://en.wikipedia.org/wiki/Regression_analysis")
        Paragraph("The Regression Class in Quorum is a statistical procedure that uses existing datasets (i.e. a large number of factors or variables) to create an equation that predicts unknown outcome variables. Quorum conducts an Ordinary Least Squares regression.")
        Paragraph("It basically takes independent variables as the input and gives us the dependent variable or outcome as the output which is what we are trying to predict.")
        Table("Tests to Check Varaince Sphericity for the Same Subjects")
        TableHeader():Cell("Formal Test"):Cell("Action in Regression Class")
        TableRow():Cell("Regression"):Cell("RegressionOnSelected")
        Paragraph("For example, a sales manager is trying to predict next year's sales. There are so many factors that could affect them from a new competitor, bad marketing, or even the climate. Regression will then determine which variable or factors have an impact.")
        Paragraph("It takes what has happened in the past to predict what might happen in the future")
        Paragraph("Below is an example in Quorum.")
        CodeEditorFromProject("Example of Regression", "Main.quorum", "examples/StatsTest/Regression.quorum"):HideDisplay()
    end
end
