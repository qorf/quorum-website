use Libraries.Web.Page.QuorumPage
use Libraries.Web.Page.TableRowWriter

/*
    Tutorial: Actions.
    Converted from the old Lesson page by plan 13's generator: the same
    words, now without Tailwind.
*/
class StatisticalTestsOverview is QuorumPage
    // The table row being written, when its cells hold more than words.
    TableRowWriter row = undefined

    on create
        SetLocation("tutorials/statstest/statOverview.html")
        // The name lists and links use, and the series and track it belongs
        // to: its section and picture.
        SetShortTitle("Statistical Tests Overview")
        SetSectionName("Statistical Tests")
        // For search engines and link previews, and what lists of pages say.
        SetDescription("Learn about Statistical Tests Overview on Quorum Language.")
        SetSummary("overview on statistical tests")
    end

    action Setup
        SetWebPageTitle("Statistical Tests Overview - Quorum Programming Lanugage")
        Title("Tutorial: Actions")
        Paragraph("How to tell a program to take a behavior.")
        StatisticalTestsOverview()
    end

    private action StatisticalTestsOverview
        Section("Statistical Tests Overview")
        Paragraph("Conducting tests help scientists learn more about the information they are given. In the realm of statistics and data science, statistical tests provide a mechanism for making quantitative decisions about processes. A common example is providing us specific kinds of metrics on whether to accept or reject a hypothesis.")
        Paragraph("Similar to other statistical computing software such as R, Python, and Matlab, Quorum can conduct statistical tests. In these tutorials, we will describe the tests at a high-level and provide links to the technical name sometimes used in various libraries or documentation. In all cases, statistical testing is not needed by all people using or consuming data and is generally considered an advanced topic.")
        Paragraph("As one final point for this first tutorial, consider that every major programming language uses its own naming conventions and organization, if any, for the various statistical tests. Textbooks, generally, use technical names that do not match the programming language in a direct way (e.g., sometimes abbreviated, sometimes changed). For this reason, we provide a loose list of technical textbook names and which Quorum tutorial they would correspond to:")
        Table("Overview of Statistical Tests in Quorum")
        TableHeader():Cell("Class in Quorum"):Cell("Formal Test(s)"):Cell("Purpose")
        row = TableRow()
        row:Cell():Link("CheckReducibility", "reducibility.html")
        row:Cell():Text("Bartletts Test of Sphericity")
        row:Cell():Text("Tests used to determine whether samples significantly correlate or relate with each other.")
        row = TableRow()
        row:Cell():Link("CheckReducibilityStrength", "reducibilityStrength.html")
        row:Cell():Text("Kaiser-Meyer-Olkin Measure Of Sampling Adequacy (KMO) Test")
        row:Cell():Text("Tests used to measure how suited data is for factor analysis (finding variables that correlate highly together but do not mix and mingle with other variables outside that group).")
        row = TableRow()
        row:Cell():Link("CompareCounts", "compareCounts.html")
        row:Cell():Text("Chi-square Goodness of Fit Test, Chi-square Test of Independence")
        row:Cell():Text("Tests used to measure how suited data is for factor analysis (finding variables that correlate highly together but do not mix and mingle with other variables outside that group).")
        row = TableRow()
        row:Cell():Link("CompareDistributions", "compareDistributions.html")
        row:Cell():Text("Shapiro-Wilk Test")
        row:Cell():Text("Tests used to determine whether samples are distributed normally or not.")
        row = TableRow()
        row:Cell():Link("CompareMeans", "compareGroupsTests.html")
        row:Cell():Text("One-Sample T-Test, Paired T-Test, Wilcoxon Signed-Ranks Test, Two-Sample T-Test, Mann-Whitney U-Test, ANOVA, Kruskal-Wallis Test, Repeated Measures ANOVA, Friedman Test")
        row:Cell():Text("Tests used to compare whether data sets are different and in what way")
        row = TableRow()
        row:Cell():Link("CompareVariances", "compareVariances.html")
        row:Cell():Text("Levene's Homogeneity of Variance Test, Brown-Forsythe Homogeneity of Variance Test and Mauchly's Sphericity Test")
        row:Cell():Text("Tests used to compare different kinds of properties, like the amount of variance (spread of data).")
        row = TableRow()
        row:Cell():Link("CompareMeansPairwise", "postHocTests.html")
        row:Cell():Text("Bonferroni Procedure, Tukey's HSD Multiple Comparison Test, Tukey-Kramer Multiple Comparison Test, Games-Howell Multiple Comparison Test")
        row:Cell():Text("Tests used to check which group or groups failed after running a CompareGroups test first.")
        row = TableRow()
        row:Cell():Link("CorrelateGroups", "correlate.html")
        row:Cell():Text("Pearson Correlation Coefficient, Spearman Correlation Coefficient")
        row:Cell():Text("Tests used to compare whether variables have any significant relationship to each other.")
        row = TableRow()
        row:Cell():Link("PrincipalComponentAnalysis", "pcaTest.html")
        row:Cell():Text("Principal Component Analysis")
        row:Cell():Text("This test evaluates a set of variables and reduces them into a smaller number of them. It is often useful to figure out what variables matter in a data set.")
        row = TableRow()
        row:Cell():Link("Regression", "regressionTest.html")
        row:Cell():Text("OLS Linear Regression")
        row:Cell():Text("Used to determine the relationship between one dependent variable and groups of other independent variables.")
        Paragraph("In the following tutorials, there will be examples of how to run the statistical tests in Quorum. The data used in these examples will be in a Comma Separated File (.csv). Many tests use the "):Link("random.csv", "https://raw.githubusercontent.com/qorf/quorum-website/main/QuorumWebsite/html/data/random.csv"):Text(" file that is not necessarily meaningful data but something that is simple to understand. There are some tests that use the "):Link("Height of Male and Female by Country 2022.csv", "https://raw.githubusercontent.com/qorf/quorum-website/main/QuorumWebsite/html/data/Height%20of%20Male%20and%20Female%20by%20Country%202022.csv"):Text(" data that can be downloaded as well.")
    end
end
