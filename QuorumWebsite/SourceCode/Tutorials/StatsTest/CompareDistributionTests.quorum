use Libraries.Web.Page.QuorumPage

/*
    Tutorial: Actions.
    Converted from the old Lesson page by plan 13's generator: the same
    words, now without Tailwind.
*/
class CompareDistributeTests is QuorumPage

    on create
        SetLocation("tutorials/statstest/compareDistributions.html")
        // The name lists and links use, and the series and track it belongs
        // to: its section and picture.
        SetShortTitle("Compare Distributions")
        SetSectionName("Statistical Tests")
        // For search engines and link previews, and what lists of pages say.
        SetDescription("Learn about Statistical Tests Overview on Quorum Language.")
        SetSummary("how to check the distributions of data")
    end

    action Setup
        SetWebPageTitle("Compare Distributions - Quorum Programming Lanugage")
        Title("Tutorial: Actions")
        Paragraph("How to tell a program to take a behavior.")
        CompareDistributions()
    end

    private action CompareDistributions
        Section("Compare Distributions")
        Paragraph("The CompareDistributions Class in Quorum can check if data has a normal distribution or does not have a normal distribution. Data without a normal distribution may not have symmetry or have really big values. Some samples may not be normally distributed which can affect what tests in the CompareGroups class can be used on the data set.")
        Table("Tests For Checking Distribution")
        TableHeader():Cell("Formal Test"):Cell("Action in CompareDistributions Class")
        TableRow():Cell("Shapiro-Wilk Test"):Cell("CompareDistributionToNormal")
        Subsection("Check Normal Distribution")
        Subsubsection():Text("Technical Test Name: "):Link("Shapiro-Wilk Test", "https://en.wikipedia.org/wiki/Shapiro%E2%80%93Wilk_test")
        Paragraph("We can use a Shapiro-Wilk Test to check if a sample is distributed normally. To implement this in Quorum, refer to the example below.")
        Paragraph("If the data is normally distributed, then it would be in a bell-shaped curve. If it is not normally distributed, then more data might be on one side of the curve than the other.")
        CodeEditorFromProject("Example of a Shapiro-Wilk Test", "Main.quorum", "examples/StatsTest/ShapiroWilk.quorum"):HideDisplay()
    end
end
