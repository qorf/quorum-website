use Libraries.Web.Page.QuorumPage

/*
    Tutorial: Actions.
    Converted from the old Lesson page by plan 13's generator: the same
    words, now without Tailwind.
*/
class ReducibilityStrengthTest is QuorumPage
    // A double quote, for code and words that hold one.
    text dq = ""

    on create
        SetLocation("tutorials/statstest/reducibilityStrength.html")
        // The name lists and links use, and the series and track it belongs
        // to: its section and picture.
        SetShortTitle("Check Reducibility Strength")
        SetSectionName("Statistical Tests")
        // For search engines and link previews, and what lists of pages say.
        SetDescription("Learn about Reducibility Strength on Quorum Language.")
        SetSummary("how to check the reducibility strength of your data")
    end

    action Setup
        dq = dq:GetDoubleQuote()
        SetWebPageTitle("Check Reducibility Strength - Quorum Programming Lanugage")
        Title("Tutorial: Actions")
        Paragraph("How to tell a program to take a behavior.")
        CheckReducibilityStrength()
    end

    private action CheckReducibilityStrength
        Section("Check Reducibility Strength")
        Paragraph("The CheckReducibilityStrength Class in Quorum implements suitability checks before factor analysis. It determines what amount of variance in our data or variables may be caused by underlying factors.")
        Paragraph("The test listed below is used to check sampling adequacy. For example, is it random? What is the size of the sample? Is it likely to change? How accurate do we want to be?")
        Table("Tests to Check for Suitability")
        TableHeader():Cell("Formal Test"):Cell("Action in CheckReducibilityStrength Class")
        TableRow():Cell("Kaiser-Meyer-Olkin Measure of Sampling Adequacy"):Cell("CheckReducibilityStrength")
        Subsection("Check if Data is Good Enough")
        Subsubsection():Text("Technical Test Name:"):Text(" "):Link("Kaiser-Meyer-Olkin Measure of Sampling Adequacy", "https://en.wikipedia.org/wiki/Kaiser%E2%80%93Meyer%E2%80%93Olkin_test")
        Paragraph("A Kaiser-Meyer-Olkin Measure of Sampling Adequacy is a way to see if the data that we have collected is good enough to use in certain statistical analysis.")
        Paragraph("Let's say we have a bunch of puzzle pieces that we want to put together to see a big picture. This test is basically making sure that we have all the pieces of the puzzle before we start actually putting things together.")
        Paragraph("It looks at how each puzzle piece is related to other pieces. If they are alike, it means we might now have data that is good enough to get a good analysis. But if they are different from each other, then we have a lot of different things to work with.")
        Paragraph("Data needs to be suitable for factor analysis to work. Basically, this test measures how suited your data is for factor analysis and what quantity of variance is in the data that might be caused by underlying factors. The higher the difference, the more suited your data is for factor analysis")
        CodeEditorWithCode("Example of a Kaiser-Meyer-Olkin Measure of Sampling Adequacy", "// We need the DataFrame class to load in files and the CheckReducibilityStrength Class for the statistical test
use Libraries.Compute.Statistics.DataFrame
use Libraries.Compute.Statistics.Tests.CheckReducibilityStrength

//Create a DataFrame, which is essentially a table that understands 
//more information about the data that is being loaded.
DataFrame frame

//This loads data relative to the project, so put the random.csv file in the Data folder
// this is just some data
frame:Load(" + dq + "data/random.csv" + dq + ")
// get the first 5 columns 
frame:AddSelectedColumnRange(0,3)

// Create a CompareCounts and call it to do the statistical test
CheckReducibilityStrength test = frame:CheckReducibilityStrength()

// Get the results!
output test:GetSummary()
output test:GetFormalSummary()"):HideDisplay()
    end
end
