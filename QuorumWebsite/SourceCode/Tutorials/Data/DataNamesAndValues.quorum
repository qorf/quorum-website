use Libraries.Web.Page.QuorumPage

/*
    Tutorial: Returning Key Names and Values from a JavaScriptObjectNotation Object.
    Converted from the old Lesson page by plan 13's generator: the same
    words, now without Tailwind.
*/
class DataNamesAndValues is QuorumPage
    // A double quote, for code and words that hold one.
    text dq = ""

    on create
        SetLocation("tutorials/data/namesAndValues.html")
        // The name lists and links use, and the series and track it belongs
        // to: its section and picture.
        SetShortTitle("Returning Key Names and Values")
        SetSectionName("Reading and Writing JavaScript Object Notation (JSON) Data")
        // For search engines and link previews, and what lists of pages say.
        SetDescription("Learn to return key names and values using JSON with the Quorum programming language.")
        SetSummary("how to return key names and values from JavaScriptObjectNotation objects")
    end

    action Setup
        dq = dq:GetDoubleQuote()
        SetWebPageTitle("Returning Key Names and Values from a JavaScriptObjectNotation Object")
        Title("Tutorial: Returning Key Names and Values from a JavaScriptObjectNotation Object")
        Paragraph("This tutorial tells you how to return a list of JavaScriptObjectNotation object key names and their associated values")
        ReturningAListOfKeyNamesFromAJavaScriptObjectNot()
        ReturningValuesFromAJavaScriptObjectNotationObje()
    end

    private action ReturningAListOfKeyNamesFromAJavaScriptObjectNot
        Section("Returning a List of Key Names from a JavaScriptObjectNotation Object")
        Paragraph("In order to return a list of all the key names included in a JavaScriptObjectNotation object we will use an Array container to manage the key names and then output those key names to the screen. We will start by adding the necessary libraries and creating a JavaScriptObjectNotation object “json” with nested JavaScriptObjectNotation object values.")
        CodeExample("use Libraries.Data.Formats.JavaScriptObjectNotation
use Libraries.Containers.Array

class Main
   action Main
       JavaScriptObjectNotation json
       JavaScriptObjectNotation joe
       JavaScriptObjectNotation jill
       joe:Add(" + dq + "First Name" + dq + ", " + dq + "Joe" + dq + ")
       joe:Add(" + dq + "Last Name" + dq + ", " + dq + "Smith" + dq + ")
       joe:Add(" + dq + "Age" + dq + ", 15)
       joe:Add(" + dq + "GPA" + dq + ", 3.89)

       jill:Add(" + dq + "First Name" + dq + ", " + dq + "Jill" + dq + ")
       jill:Add(" + dq + "Last Name" + dq + ", " + dq + "Miller" + dq + ")
       jill:Add(" + dq + "Age" + dq + ", 14)
       jill:Add(" + dq + "GPA" + dq + ", 3.65)

       json:Add(" + dq + "Student1" + dq + ", joe)
       json:Add(" + dq + "Student2" + dq + ", jill)
       json:Add(" + dq + "School" + dq + ", " + dq + "Elm Creek High School" + dq + ")
       json:Add(" + dq + "City" + dq + ", " + dq + "Jackson" + dq + ")
       json:Add(" + dq + "State" + dq + ", " + dq + "MS" + dq + ")
       json:Add(" + dq + "Zip Code" + dq + ", 12345)")
        Paragraph("Now that we have a JavaScriptObjectNotation object "):DoubleQuote():Text("json"):DoubleQuote():Text(" to gather key names from, we will create an Array of text values called “keys,” and set that Array to collect all of the key names in our JavaScriptObjectNotation object “json” by using the “GetKeys()” action.")
        CodeExample("        //creates the Array of text values " + dq + "keys" + dq + "and assigns " + dq + "keys" + dq + " to the text values of the
        //key names in out JavaScriptObjectNotation object " + dq + "json" + dq + "
       Array<text> keys = json:GetKeys()
        //loop to continue " + dq + "Get" + dq + "ting " + dq + "key's" + dq + " key names one at a time and output each key
        //name until there are no more key names to " + dq + "Get" + dq + "
       i = 0
       repeat keys:GetSize() times
           key = keys:Get(i)
           output key
           i = i + 1
       end")
        Paragraph("The entire code section should look like this:")
        CodeExample("use Libraries.Data.Formats.JavaScriptObjectNotation
use Libraries.Containers.Array

class Main
   action Main
       JavaScriptObjectNotation json
       JavaScriptObjectNotation joe
       JavaScriptObjectNotation jill
       joe:Add(" + dq + "First Name" + dq + ", " + dq + "Joe" + dq + ")
       joe:Add(" + dq + "Last Name" + dq + ", " + dq + "Smith" + dq + ")
       joe:Add(" + dq + "Age" + dq + ", 15)
       joe:Add(" + dq + "GPA" + dq + ", 3.89)

       jill:Add(" + dq + "First Name" + dq + ", " + dq + "Jill" + dq + ")
       jill:Add(" + dq + "Last Name" + dq + ", " + dq + "Miller" + dq + ")
       jill:Add(" + dq + "Age" + dq + ", 14)
       jill:Add(" + dq + "GPA" + dq + ", 3.65)

       json:Add(" + dq + "Student1" + dq + ", joe)
       json:Add(" + dq + "Student2" + dq + ", jill)
       json:Add(" + dq + "School" + dq + ", " + dq + "Elm Creek High School" + dq + ")
       json:Add(" + dq + "City" + dq + ", " + dq + "Jackson" + dq + ")
       json:Add(" + dq + "State" + dq + ", " + dq + "MS" + dq + ")
       json:Add(" + dq + "Zip Code" + dq + ", 12345)

       Array<text> keys = json:GetKeys()
       i = 0
       repeat keys:GetSize() times
           key = keys:Get(i)
           output key
           i = i + 1
       end
   end
end")
        CodeEditorWithCode("Activity: Returning a List of Key Names", "ReturningKeys.quorum", "//This code will output the key names from the JavaScriptObjectNotation object")
        Paragraph("The output should look similar to this:")
        CodeExample("Student1
Student2
School
City
State
Zip Code")
        Paragraph("Notice how there is no indication that “Student1” and “Student2” contain nested JavaScriptObjectNotation object values. All that we have returned to us are the key names connected to the values, which can be very helpful when trying to sort through large amounts of data for relevant information. In the next section we will go over how to return the values associated with specific key names in a JavaScriptObjectNotation object.")
    end

    private action ReturningValuesFromAJavaScriptObjectNotationObje
        Section("Returning Values from a JavaScriptObjectNotation Object")
        Paragraph("Once you have a list of all the key names in a JavaScriptObjectNotation object, you can use those key names to determine which specific key name values you would like to have returned for viewing, rather than having all of the key name and value pairs returned to you at once. In order to return a specific key name’s value we will use the “GetValue()” action which takes one text type value as a parameter. This parameter should be the key name associated with the value(s) that you wish to have returned. In the example below, we will use the JavaScriptObjectNotation object “json” with the nested JavaScriptObjectNotation object values “joe” and “jill” that we used in the previous tutorial. We will be using the list of key names that was returned to us to determine which of their values we would like to “Get”.")
        Paragraph("In order to specify which value(s) we wish to have returned, we will pass in the value's key name as a parameter to the “GetValue()” action. In this example we are going to have the “School” value and the “Student1” value returned to us. Since “Student1” has a nested JavaScriptObjectNotation object as its value, the “GetValue()” action will return the entire JavaScriptObjectNotation object “joe” value. You can add the following lines of code to your existing code section from the previous tutorial.")
        CodeExample("       output " + dq + "Student1: " + dq + " +  json:GetValue(" + dq + "Student1" + dq + ")
       output " + dq + "School: " + dq + " +  json:GetValue(" + dq + "School" + dq + ")")
        Paragraph("The complete code section to create a Nested JavaScriptObjectNotation object and return specific values located within that JavaScriptObjectNotation object looks like this:")
        CodeExample("use Libraries.Data.Formats.JavaScriptObjectNotation

class Main
   action Main
       JavaScriptObjectNotation json
       JavaScriptObjectNotation joe
       JavaScriptObjectNotation jill
       joe:Add(" + dq + "First Name" + dq + ", " + dq + "Joe" + dq + ")
       joe:Add(" + dq + "Last Name" + dq + ", " + dq + "Smith" + dq + ")
       joe:Add(" + dq + "Age" + dq + ", 15)
       joe:Add(" + dq + "GPA" + dq + ", 3.89)

       jill:Add(" + dq + "First Name" + dq + ", " + dq + "Jill" + dq + ")
       jill:Add(" + dq + "Last Name" + dq + ", " + dq + "Miller" + dq + ")
       jill:Add(" + dq + "Age" + dq + ", 14)
       jill:Add(" + dq + "GPA" + dq + ", 3.65)

       json:Add(" + dq + "Student1" + dq + ", joe)
       json:Add(" + dq + "Student2" + dq + ", jill)
       json:Add(" + dq + "School" + dq + ", " + dq + "Elm Creek High School" + dq + ")
       json:Add(" + dq + "City" + dq + ", " + dq + "Jackson" + dq + ")
       json:Add(" + dq + "State" + dq + ", " + dq + "MS" + dq + ")
       json:Add(" + dq + "Zip Code" + dq + ", 12345)

       output " + dq + "Student1: " + dq + " +  json:GetValue(" + dq + "Student1" + dq + ")
       output " + dq + "School: " + dq + " +  json:GetValue(" + dq + "School" + dq + ")
   end
end")
        CodeEditorWithCode("Activity: Returning Values from a JavaScriptObjectNotation object", "ReturningValues.quorum", "//This code will output the specified values from the JavaScriptObjectNotation object")
        Paragraph("The output should look similar to this:")
        CodeExample("   Student1: {" + dq + "First Name" + dq + ": " + dq + "Joe" + dq + ", " + dq + "Last Name" + dq + ": " + dq + "Smith" + dq + ", " + dq + "Age" + dq + ": 15, " + dq + "GPA" + dq + ": 3.89}
   School: Elm Creek High School")
    end
end
