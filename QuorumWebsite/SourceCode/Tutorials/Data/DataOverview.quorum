use Libraries.Web.Page.QuorumPage

/*
    Reading and Writing Data Overview.
    Converted from the old Lesson page by plan 13's generator: the same
    words, now without Tailwind.
*/
class DataOverview is QuorumPage
    // A double quote, for code and words that hold one.
    text dq = ""

    on create
        SetLocation("tutorials/data/overview.html")
        // The name lists and links use, and the series and track it belongs
        // to: its section and picture.
        SetShortTitle("Overview of JavaScript Object Notation (JSON) Data")
        SetSectionName("Reading and Writing JavaScript Object Notation (JSON) Data")
        // For search engines and link previews, and what lists of pages say.
        SetDescription("Learn to read and write data using JSON with the Quorum programming language.")
        SetSummary("an overview into reading and writing data.")
    end

    action Setup
        dq = dq:GetDoubleQuote()
        SetWebPageTitle("Reading and Writing Data Overview")
        Title("Reading and Writing Data Overview")
        Paragraph("Reading and Writing data using JavaScript Object Notation (JSON)")
        Overview()
        JSONInQuorum()
    end

    private action Overview
        Section("Overview")
        Paragraph("JavaScript Object Notation (JSON) is a human-readable way to format data and is commonly used for transmission between a server and web applications. JavaScript Object Notation (JSON) is a more “lightweight” and understandable format than another commonly used alternative known as Extensible Markup Language (XML). Because of these advantages and the fact that it is understood natively by the JavaScript programming language used in browsers, it is generally the preferred format today.")
        Paragraph("JavaScript Object Notation (JSON) objects are a set of unordered key-value pairs, separated by a colon (“:“) and encapsulated with curly brackets (“{“ “}”), also called braces. The key portion of the pair is a name in double quotes and the value can be a text, integer, number, boolean or array value. Each of the pairs is separated by a comma (“,”) and any whitespace is ignored.")
        Paragraph("In the following example, the first key name is “firstName” with a text value of “Joe”, the second key name is “lastName” with a text value of “Smith”, the third key name is “age” with an integer value of 15, and the fourth key name is “student” with a boolean value of true.")
        Paragraph("Example JavaScript Object Notation format:")
        CodeExample("{
     " + dq + "firstName" + dq + " : " + dq + "Joe" + dq + ",
     " + dq + "lastName" + dq + " : " + dq + "Smith" + dq + ",
     " + dq + "age" + dq + " : 15,
     " + dq + "student" + dq + " : true
}", "")
    end

    private action JSONInQuorum
        Section("JSON in Quorum")
        Paragraph("In order to access the JavaScriptObjectNotation class we must add the “use Libraries.Data.Formats.JavaScriptObjectNotation” statement at the beginning of our class definitions when working with JavaScript Object Notation (JSON).")
    end
end
