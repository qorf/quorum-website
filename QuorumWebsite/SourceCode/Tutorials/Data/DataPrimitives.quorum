use Libraries.Web.Page.QuorumPage

/*
    Tutorial: Adding Primitive Values to a JavaScriptObjectNotation Object.
    Converted from the old Lesson page by plan 13's generator: the same
    words, now without Tailwind.
*/
class DataPrimitives is QuorumPage
    // A double quote, for code and words that hold one.
    text dq = ""

    on create
        SetLocation("tutorials/data/primitives.html")
        // The name lists and links use, and the series and track it belongs
        // to: its section and picture.
        SetShortTitle("Primitives")
        SetSectionName("Reading and Writing JavaScript Object Notation (JSON) Data")
        // For search engines and link previews, and what lists of pages say.
        SetDescription("Learn to read and write data with primitive value types using JSON with the Quorum programming language.")
        SetSummary("an introduction to creating JavaScriptObjectNotation objects with primitive value types.")
    end

    action Setup
        dq = dq:GetDoubleQuote()
        SetWebPageTitle("Adding Primitive Values to a JavaScriptObjectNotation Object")
        Title("Tutorial: Adding Primitive Values to a JavaScriptObjectNotation Object")
        Paragraph("This tutorial tells you how to add primitive values to a JavaScriptObjectNotation (JSON) object")
        Primitives()
        AddingAnIntegerValueToAJavaScriptObjectNotationO()
        AddingOtherValueTypesToAJavaScriptObjectNotation()
    end

    private action Primitives
        Section("Primitives")
        Paragraph("In this tutorial we will go over how to add key names and their associated primitive type values to a JavaScriptObjectNotation object, including:")
        BulletList()
        ListItem():Strong("Integer Values"):Text(" : such as (1, 2, 3)")
        ListItem():Strong("Number Values"):Text(" : such as (1.0, 2.2, 3.7)")
        ListItem():Strong("Boolean Values"):Text(" : true or false")
        ListItem():Strong("Text Values"):Text(" : such as ("):DoubleQuote():Text("name"):DoubleQuote():Text(", "):DoubleQuote():Text("John"):DoubleQuote():Text(", "):DoubleQuote():Text("Smith"):DoubleQuote():Text(")")
        Paragraph("Although integer value types are not standardly used in JavaScript Object Notation, we have added the integer value type as an added convenience for the user.")
    end

    private action AddingAnIntegerValueToAJavaScriptObjectNotationO
        Section("Adding an Integer Value to a JavaScriptObjectNotation Object")
        Paragraph("We start by creating a JavaScriptObjectNotation object, called “json” in this example.")
        CodeExample("use Libraries.Data.Formats.JavaScriptObjectNotation

class Main
    action Main
        JavaScriptObjectNotation json")
        Paragraph("We then have to “Add” the text key, and associated integer value to the JavaScriptObjectNotation object json.")
        CodeExample("         json:Add(" + dq + "item1" + dq + ", 1)
         json:Add(" + dq + "item2" + dq + ", 2)")
        Paragraph("Here is the complete code section, which outputs our formatted JavaScriptObjectNotation object to the screen, allowing us to view each of the { name : value } pairs within the curly braces that encapsulate the object:")
        CodeExample("use Libraries.Data.Formats.JavaScriptObjectNotation

class Main
    action Main
        JavaScriptObjectNotation json
        json:Add(" + dq + "item1" + dq + ", 1)
        json:Add(" + dq + "item2" + dq + ", 2)
        output json:ToText()
    end
end")
        CodeEditorWithCode("Activity: Adding an Integer Value", "AddInteger.quorum", "//This code will output the name and integer value pairs in JavaScript Object Notation format")
        Paragraph("Where the output should look something like this:")
        CodeExample("{
  " + dq + "item1" + dq + ": 1,
  " + dq + "item2" + dq + ": 2
}")
    end

    private action AddingOtherValueTypesToAJavaScriptObjectNotation
        Section("Adding Other Value Types to a JavaScriptObjectNotation Object")
        Paragraph("Similar to the way in which we added an integer value to the JavaScriptObjectNotation we start by creating a JavaScriptObjectNotation object. However, when “Add”ing our { name : value } pairs to the object we will change the value type accordingly to a number, boolean, or text type.")
        Paragraph("Adding a number type value to the JavaScriptObjectNotation object:")
        CodeExample("use Libraries.Data.Formats.JavaScriptObjectNotation

class Main
    action Main
        JavaScriptObjectNotation json
        json:Add(" + dq + "item1" + dq + ", 1.1)
        json:Add(" + dq + "item2" + dq + ", 2.2)
        output json:ToText()
    end
end")
        CodeEditorWithCode("Activity: Adding an Number Value", "AddNumber.quorum", "//This code will output the name and number value pairs in JavaScript Object Notation format")
        Paragraph("Adding a boolean type value to a JavaScriptObjectNotation object:")
        CodeExample("use Libraries.Data.Formats.JavaScriptObjectNotation

class Main
    action Main
        JavaScriptObjectNotation json
        json:Add(" + dq + "item1" + dq + ", true)
        json:Add(" + dq + "item2" + dq + ", false)
        output json:ToText()
    end
end")
        CodeEditorWithCode("Activity: Adding an Boolean Value", "AddBoolean.quorum", "//This code will output the name and boolean value pairs in JavaScript Object Notation format")
        Paragraph("Adding a text type value to a JavaScriptObjectNotation object:")
        CodeExample("use Libraries.Data.Formats.JavaScriptObjectNotation

class Main
    action Main
        JavaScriptObjectNotation json
        json:Add(" + dq + "firstName" + dq + ", " + dq + "Joe" + dq + ")
        json:Add(" + dq + "lastName" + dq + ", " + dq + "Smith" + dq + ")
        output json:ToText()
    end
end")
        CodeEditorWithCode("Activity: Adding an Text Value", "AddText.quorum", "//This code will output the name and text value pairs in JavaScript Object Notation format")
    end
end
