use Libraries.Web.Page.QuorumPage

/*
    Tutorial: Adding an Array Value Type to a JavaScriptObjectNotation Object.
    Converted from the old Lesson page by plan 13's generator: the same
    words, now without Tailwind.
*/
class DataArrays is QuorumPage
    // A double quote, for code and words that hold one.
    text dq = ""

    on create
        SetLocation("tutorials/data/arrays.html")
        // The name lists and links use, and the series and track it belongs
        // to: its section and picture.
        SetShortTitle("Arrays")
        SetSectionName("Reading and Writing JavaScript Object Notation (JSON) Data")
        // For search engines and link previews, and what lists of pages say.
        SetDescription("Learn to read and write data using arrays and JSON with the Quorum programming language.")
        SetSummary("how to use array values with JavaScriptObjectNotation objects")
    end

    action Setup
        dq = dq:GetDoubleQuote()
        SetWebPageTitle("Adding an Array Value Type to a JavaScriptObjectNotation Object")
        Title("Tutorial: Adding an Array Value Type to a JavaScriptObjectNotation Object")
        Paragraph("This tutorial tells you how to add an array value to a JavaScriptObjectNotation (JSON) object")
        AddingAnArrayValueTypeToAJavaScriptObjectNotatio()
    end

    private action AddingAnArrayValueTypeToAJavaScriptObjectNotatio
        Section("Adding an Array Value Type to a JavaScriptObjectNotation Object")
        Paragraph("In this tutorial we will create an array using JavaScriptObjectNotation which we will call “array.” We will use "):DoubleQuote():Text("array"):DoubleQuote():Text(" as a corresponding value for the key name “detail” in a JavaScriptObjectNotation object called “json.” We will then output the final result. We begin by adding the necessary JavaScriptObjectNotation library and creating our JavaScriptObjectNotation object "):DoubleQuote():Text("array"):DoubleQuote():Text(" to be used as a value in our JavaScriptObjectNotation object "):DoubleQuote():Text("json"):DoubleQuote():Text(".")
        CodeExample("use Libraries.Data.Formats.JavaScriptObjectNotation

class Main
   action Main
        //creates a JavaScriptObjectNotation object " + dq + "array" + dq + "
       JavaScriptObjectNotation array
        //sets the JavaScriptObjectNotation object " + dq + "array" + dq + " to type Array.
       array:SetArray()
        //Adds the values of " + dq + "project1" + dq + " and " + dq + "project2" + dq + " to " + dq + "array" + dq + "
       array:Add(" + dq + "arrayValue1" + dq + ")
       array:Add(" + dq + "arrayValue2" + dq + ")")
        Paragraph("Finally, we need to “Add” the JavaScriptObjectNotation object value “array” to the JavaScriptObjectNotation object “json”.")
        CodeExample("       JavaScriptObjectNotation json
       json:Add(" + dq + "data1" + dq + ", 10)
       json:Add(" + dq + "data2" + dq + ", 11)
       json:Add(" + dq + "myArray" + dq + ", array)")
        Paragraph("Here is the complete code section which will add an array value to a JavaScriptObjectNotation object and output the { name : value } pairs in JavaScript Object Notation format.")
        CodeExample("use Libraries.Data.Formats.JavaScriptObjectNotation

class Main
   action Main
       JavaScriptObjectNotation array
       array:SetArray()
       array:Add(" + dq + "arrayValue1" + dq + ")
       array:Add(" + dq + "arrayValue2" + dq + ")
       JavaScriptObjectNotation json
       json:Add(" + dq + "data1" + dq + ", 10)
       json:Add(" + dq + "data2" + dq + ", 11)
       json:Add(" + dq + "myArray" + dq + ", array)
       json:SetPrettyPrint(true)
       output json:ToText()
   end
end")
        CodeEditorWithCode("Activity: Adding an Array Value", "AddArray.quorum", "//This code will output the name and value pairs, including an array value, in JavaScript Object Notation format")
        Paragraph("The final result should look like this, with the “array” values separated by commas and enclosed within square brackets:")
        CodeExample("{
       " + dq + "data1" + dq + ": 10,
       " + dq + "data2" + dq + ": 11,
       " + dq + "myArray" + dq + ": [" + dq + "arrayValue1" + dq + ", " + dq + "arrayValue2" + dq + "]
}", "")
    end
end
