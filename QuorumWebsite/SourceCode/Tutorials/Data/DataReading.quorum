use Libraries.Web.Page.QuorumPage

/*
    Reading in JavaScript Object Notation Formatted Data from Text Values or from a File.
    Converted from the old Lesson page by plan 13's generator: the same
    words, now without Tailwind.
*/
class DataReading is QuorumPage
    // A double quote, for code and words that hold one.
    text dq = ""

    on create
        SetLocation("tutorials/data/reading.html")
        // The name lists and links use, and the series and track it belongs
        // to: its section and picture.
        SetShortTitle("Reading")
        SetSectionName("Reading and Writing JavaScript Object Notation (JSON) Data")
        // For search engines and link previews, and what lists of pages say.
        SetDescription("Learn to read in formatted JSON data with the Quorum programming language.")
        SetSummary("an overview into reading in JavaScript Object Notation (JSON) data from text values and files")
    end

    action Setup
        dq = dq:GetDoubleQuote()
        SetWebPageTitle("Reading in JavaScript Object Notation Formatted Data from Text Values or from a File")
        Title("Reading in JavaScript Object Notation Formatted Data from Text Values or from a File")
        Paragraph("This tutorial will teach you how to read in JavaScript Object Notation (JSON) formatted data from a text value or from a file")
        Overview()
        ReadingInFromATextValue()
        ReadingInFromAFile()
    end

    private action Overview
        Section("Overview")
        Paragraph("If you have data which is already in JavaScript Object Notation format, with { “name” : value } pairs in curly braces, then the data can be read in and stored as a JavaScriptObjectNotation object. This data can be read in as a text value or from a file.")
    end

    private action ReadingInFromATextValue
        Section("Reading in from a Text Value")
        Paragraph("In this example, we are using the JavaScript Object Notation formatted text “myValue” with the key name “data” and its associated array value.")
        CodeExample("use Libraries.Data.Formats.JavaScriptObjectNotation

class Main
   action Main
        //sets myValue = {“data” : [21.5, 22.7, 23.9]} 
       text dq = " + dq + dq + "
       dq = dq:GetDoubleQuote()
       text myValue = " + dq + "{" + dq + " + dq + " + dq + "data" + dq + " + dq + " + dq + ": [21.5, 22.7, 23.9]}" + dq + "
        //creates a JavaScriptObjectNotation object “json” to store
        //“myValue” and outputs the JavaScript Object Notation formatted object
       JavaScriptObjectNotation json
       json:Read(myValue)
       output json:ToText()
   end
end")
        CodeEditorWithCode("Activity: Reading from a Text Value", "ReadingText", "//This code will output the JavaScriptObjectNotation object in JavaScript Object Notation format")
        Paragraph("The output should look like this:")
        CodeExample("{
       " + dq + "data" + dq + " : [21.5, 22.7, 23.9]
}")
    end

    private action ReadingInFromAFile
        Section("Reading in from a File")
        Paragraph("To read in formatted JavaScript Object Notation data from a file we need to use the additional “Libraries.System.File” library and connect to the file containing the data. The file "):Link("response.json", "/files/data/response.json"):Text(" is available for you to download for testing in this next example.")
        CodeExample("use Libraries.Data.Formats.JavaScriptObjectNotation
use Libraries.System.File

class Main
   action Main
       JavaScriptObjectNotation json
        //Creates a File object “myFile”, Sets the Path for “myFile”
        //(where you will be reading the JavaScript Object Notation data from)
        //and Reads from the specified file path.
       File myFile
        //be sure to use the file path that you have set your response.json file to
       myFile:SetPath(" + dq + "files/data/response.json" + dq + ")
       json:Read(myFile)
       output json:ToText()
   end
end")
        CodeEditorWithCode("Activity: Reading from a File", "ReadFile.quorum", "//This code will read a file online or offline and output it in JavaScript Object Notation format")
        Paragraph("Since the file"):DoubleQuote():Text(" response.json"):DoubleQuote():Text(" that we are reading in from contained the following JavaScript Object Notation formatted data:")
        CodeExample("{
      " + dq + "item1" + dq + ": 22,
      " + dq + "item2" + dq + ": 33.2,
      " + dq + "item3" + dq + ": true
}")
        Paragraph("The output to the screen should look like this:")
        CodeExample("{
      " + dq + "item1" + dq + ": 22,
      " + dq + "item2" + dq + ": 33.2,
      " + dq + "item3" + dq + ": true
}")
    end
end
