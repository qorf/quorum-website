use Libraries.Web.Page.QuorumPage

/*
    Writing JavaScript Object Notation Formatted Data as a Text Value or to a File.
    Converted from the old Lesson page by plan 13's generator: the same
    words, now without Tailwind.
*/
class DataWriting is QuorumPage
    // A double quote, for code and words that hold one.
    text dq = ""

    on create
        SetLocation("tutorials/data/writing.html")
        // The name lists and links use, and the series and track it belongs
        // to: its section and picture.
        SetShortTitle("Writing")
        SetSectionName("Reading and Writing JavaScript Object Notation (JSON) Data")
        // For search engines and link previews, and what lists of pages say.
        SetDescription("Learn to write formatted JSON data with the Quorum programming language.")
        SetSummary("how to write JavaScript Object Notation (JSON) formatted data as a text value or to a file")
    end

    action Setup
        dq = dq:GetDoubleQuote()
        SetWebPageTitle("Writing JavaScript Object Notation Formatted Data as Text Values or to a File")
        Title("Writing JavaScript Object Notation Formatted Data as a Text Value or to a File")
        Paragraph("This tutorial will teach you how to write JavaScript Object Notation (JSON) formatted data as a text value or to a file")
        WritingJavaScriptObjectNotationObjectsAsATextVal()
        WritingJavaScriptObjectNotationObjectsToAFile()
        WritingAJavaScriptObjectNotationObjectAsAListWit()
    end

    private action WritingJavaScriptObjectNotationObjectsAsATextVal
        Section("Writing JavaScript Object Notation Objects as a Text Value")
        Paragraph("To write formatted JavaScript Object Notation data as a text value we will use the “ToText()” action on the JavaSciptObjectNotation object which will output the associated JavaScriptObjectNotation object to the screen by default. Using just the "):DoubleQuote():Text("ToText()"):DoubleQuote():Text(" action on its own will output the JavaScriptObjectNotation object as a single line of text with the {name : value} pairs separated only by a comma. To output the JavaScriptObjectNotation with the {name : value} pairs separated by a comma and a carriage return, we must also use the "):DoubleQuote():Text("SetPrettyPrint()"):DoubleQuote():Text(" action with the boolean parameter set to true. In the following example we begin by creating a JavaScriptObjectNotation object “json” and adding a few { name : value } pairs to the object. To write ”json” as a text value in JavaScript Object Notation format we will first set "):DoubleQuote():Text("json"):DoubleQuote():Text(" to use PrettyPrint and then output the JavaScriptObjectNotation text value to the screen")
        Paragraph("Here is the complete code to output the JavaScriptObjectNotation object “json” as a text value to the screen:")
        CodeExample("use Libraries.Data.Formats.JavaScriptObjectNotation

class Main
   action Main
       JavaScriptObjectNotation json
       json:Add(" + dq + "item1" + dq + ", 1)
       json:Add(" + dq + "item2" + dq + ", 2.2)
       json:Add(" + dq + "item3" + dq + ", " + dq + "three" + dq + ")
       json:SetPrettyPrint(true)
       output json:ToText()
   end
end")
        CodeEditorWithCode("Activity: Writing as a Text Value in JSON Format", "WriteJsonToText.quorum", "//This code will output the JavaScriptObjectNotation object's key value pairs as a text value in JavaScript Object Notation format")
        Paragraph("The text value output to the screen should look similar to this:")
        CodeExample("{
       " + dq + "item1" + dq + ": 1,
       " + dq + "item2" + dq + ": 2.2,
       " + dq + "item3" + dq + ": " + dq + "three" + dq + "
}", "")
        Paragraph("Try changing the "):DoubleQuote():Text("SetPrettyPrint()"):DoubleQuote():Text(" boolean parameter to false and you will notice the change in format.")
    end

    private action WritingJavaScriptObjectNotationObjectsToAFile
        Section("Writing JavaScript Object Notation Objects to a File")
        Paragraph("In order to write a JavaScripObjectNotation object to a file we must use the additional “Libraries.System.File” library. After adding our { name : value } pairs to the JavaScriptObjectNotaion object “json” we will create a File object and specify the path for the File called "):DoubleQuote():Text("myFile"):DoubleQuote():Text(" in this example. In specifying the path for "):DoubleQuote():Text("myFile"):DoubleQuote():Text(" we can either create a new file path or rewrite to an existing file path. For this example we will use the "):DoubleQuote():Text("response.json"):DoubleQuote():Text(" file path that we read in from in the last tutorial. By writing to an existing file, we will replace the contents of the existing file with the JavaScriptObjectNotation object "):DoubleQuote():Text("json"):DoubleQuote():Text(" that we are creating in this example. We will Write to the file using the “json:ToText()” action within the “Write()” action. Finally, note that we can only write to a File when running Quorum offline because of security on the Internet.")
        Paragraph("Here is the complete code to write a JavaScriptObjectNotation object to a file:")
        CodeExample("use Libraries.Data.Formats.JavaScriptObjectNotation
use Libraries.System.File

class Main
   action Main
       JavaScriptObjectNotation json
       json:Add(" + dq + "item1" + dq + ", 1)
       json:Add(" + dq + "item2" + dq + ", 2.2)
       json:Add(" + dq + "item3" + dq + ", " + dq + "three" + dq + ")
       json:SetPrettyPrint(true)
        //Creates a File object called “myFile” Sets the Path for “myFile”
        //(where you will be writing the JavaScriptObjectNotation object “json” to,
        //in this example we are using the file path for our downloaded " + dq + "response.json" + dq + " file)
        //and Writes the JavaScript Object Notation formatted “json” 
        //to the specified file path.
       File myFile
       myFile:SetWorkingDirectory(" + dq + "/Users/userName/Downloads" + dq + ")
       myFile:SetPath(" + dq + "response.json" + dq + ")
       myFile:Write(json:ToText())
   end
end")
        Paragraph("Your "):DoubleQuote():Text("response.json"):DoubleQuote():Text(" file will now contain the output from this example which will look like this:")
        CodeExample("{
       " + dq + "item1" + dq + ": 1,
       " + dq + "item2" + dq + ": 2.2,
       " + dq + "item3" + dq + ": " + dq + "three" + dq + "
}", "")
    end

    private action WritingAJavaScriptObjectNotationObjectAsAListWit
        Section("Writing a JavaScriptObjectNotation Object as a List with Name/Value Pairs")
        Paragraph("In order to get a list (array) of JavaScriptObjectNotation object key name and value pairs we must use the “Libraries.Containers.Array” library. In this example we will output a list of key names followed by an arrow and the name’s value.")
        CodeExample("use Libraries.Data.Formats.JavaScriptObjectNotation
use Libraries.Containers.Array

class Main
   action Main
       JavaScriptObjectNotation json
       json:Add(" + dq + "item1" + dq + ", 1)
       json:Add(" + dq + "item2" + dq + ", 2.2)
       json:Add(" + dq + "item3" + dq + ", true)
       json:Add(" + dq + "item4" + dq + ", " + dq + "text" + dq + ")
        //Loop to output a list of each key and the key’s associated value in the
        //JavaScriptObjectNotation object “json”
       Array<text> keys = json:GetKeys()
       i = 0
       repeat keys:GetSize() times
           key = keys:Get(i)
           output key + " + dq + " => " + dq + " + json:GetValue(key)
           i = i + 1
       end
   end
end")
        CodeEditorWithCode("Activity: Writing as a Text Value", "WritingAsList.quorum", "//This code will output the JavaScriptObjectNotation object's key value pairs as a text value in an alternate format")
        Paragraph("This example should produce a list of all of “json’s” name value pairs in the format (name => value). The output should look similar to this:")
        CodeExample("item1 => 1
item2 => 2.2
item3 => true
item4 => text")
    end
end
