use Libraries.Web.Page.QuorumPage

/*
    Tutorial: Adding a JavaScriptObjectNotation Value Type to a JavaScriptObjectNotation Object (Nesting).
    Converted from the old Lesson page by plan 13's generator: the same
    words, now without Tailwind.
*/
class DataNesting is QuorumPage
    // A double quote, for code and words that hold one.
    text dq = ""

    on create
        SetLocation("tutorials/data/nesting.html")
        // The name lists and links use, and the series and track it belongs
        // to: its section and picture.
        SetShortTitle("Nesting")
        SetSectionName("Reading and Writing JavaScript Object Notation (JSON) Data")
        // For search engines and link previews, and what lists of pages say.
        SetDescription("Learn to read and write data using nesting and JSON with the Quorum programming language")
        SetSummary("how to nest a JavaScriptObjectNotation object as a value within another JavaScriptObjectNotation object")
    end

    action Setup
        dq = dq:GetDoubleQuote()
        SetWebPageTitle("Adding a JavaScriptObjectNotation Value Type to a JavaScriptObjectNotation Object (Nesting)")
        Title("Tutorial: Adding a JavaScriptObjectNotation Value Type to a JavaScriptObjectNotation Object (Nesting)")
        Paragraph("This tutorial tells you how to nest JavaScriptObjectNotation object values within a JavaScriptObjectNotation object")
        Nesting()
    end

    private action Nesting
        Section("Nesting")
        Paragraph("In this tutorial, we will create a JavaScriptObjectNotation object “data” which will be nested in another JavaScriptObjectNotation object “json” and then output the final result. We begin by creating the JavaScriptObjectNotation object that we plan on nesting, “data” and “Add”ing the necessary { name : value } pairs to the nested JavaScriptObjectNotation object “data.”")
        CodeExample("use Libraries.Data.Formats.JavaScriptObjectNotation

class Main
   action Main
       JavaScriptObjectNotation data
       data:Add(" + dq + "item1" + dq + ", " + dq + "a" + dq + ")
       data:Add(" + dq + "item2" + dq + ", " + dq + "b" + dq + ")
       data:Add(" + dq + "item3" + dq + ", " + dq + "c" + dq + ")")
        Paragraph("We then create the JavaScriptObjectNotation object, which will encapsulate the nested object, “json” and “Add” the necessary { name : value } pairs. To add the JavaScriptObjectNotation object to a { name : value } pair we change the value to the object to be nested, in this case “data.”")
        CodeExample("     json:Add(" + dq + "detail" + dq + ", data)")
        Paragraph("Here is the complete code section which will create a nested JavaScriptObjectNotation object and output the formatted JavaScriptObjectNotation objects.")
        CodeExample("use Libraries.Data.Formats.JavaScriptObjectNotation

class Main
   action Main
       JavaScriptObjectNotation data
       data:Add(" + dq + "item1" + dq + ", " + dq + "a" + dq + ")
       data:Add(" + dq + "item2" + dq + ", " + dq + "b" + dq + ")
       data:Add(" + dq + "item3" + dq + ", " + dq + "c" + dq + ")

       JavaScriptObjectNotation json
       json:Add(" + dq + "data1" + dq + ", " + dq + "A" + dq + ")
       json:Add(" + dq + "data2" + dq + ", " + dq + "B" + dq + ")
       json:Add(" + dq + "detail" + dq + ", data)
       output json:ToText()
   end
end")
        CodeEditorWithCode("Activity: Nesting a JavaScriptObjectNotation object", "Nesting.quorum", "//This code will output a JavaScriptObjectNotation object value nested within another JavaScriptObjectNotation object")
        Paragraph("The output should look something like this, with the nested JavaScriptObjectNotation object enclosed by an inner pair of curly braces following its corresponding key name “detail”:")
        CodeExample("{
   " + dq + "data1" + dq + ": " + dq + "A" + dq + ",
   " + dq + "data2" + dq + ": " + dq + "B" + dq + ",
   " + dq + "detail" + dq + ":   {
           " + dq + "item1" + dq + ": " + dq + "a" + dq + ",
           " + dq + "item2" + dq + ": " + dq + "b" + dq + ",
           " + dq + "item3" + dq + ": " + dq + "c" + dq + "
   }
}", "")
    end
end
