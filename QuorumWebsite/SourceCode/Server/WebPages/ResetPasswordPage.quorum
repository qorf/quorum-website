use Libraries.Web.Page.QuorumPage
use Libraries.Web.Page.Input

/*
    The page a reset email links to, when the server builds it with the
    email's key (/ResetPassword.quorum): two password boxes and a button
    that sends the new password (script.js's resetPasswordClick), with the
    messages the script shows. Converted from the old Lesson page by plan
    13 (phase 6): the same words and ids, now without Tailwind.
*/
class ResetPasswordPage is QuorumPage
    text pageKey = ""

    action SetPageKey(text pageKey)
        me:pageKey = pageKey
    end

    action GetPageKey returns text
        return pageKey
    end

    action Setup
        SetWebPageTitle("Quorum Project Page - Quorum Programming Language")
        Title("Password Reset")

        Form("newPasswordForm", "javascript:resetPasswordClick()")
        FormWords("Reset your password below. Leaving this page will leave your password the same.")
        Input password = FormEntry("Password", "New Password", "newPasswordInput", "password", "password")
        password:AddAttribute("onblur", "checkValidityExists.call(this);")
        Input confirmPassword = FormEntry("Confirm Password", "Confirm New Password", "confirmNewPasswordInput", "password", "Confrim Password")
        confirmPassword:AddAttribute("onblur", "checkConfirmPassword('confirmNewPasswordInput', 'newPasswordInput');")
        HiddenField("hidden_reset_key", "hidden_reset_key", pageKey)
        SubmitButton("Reset my Password", "submitFormButton", "Save New Password")
        FeedbackMessage("resetFeedbackMessage")
        ProblemMessage("resetAlertMessage")
        EndForm()
    end
end
