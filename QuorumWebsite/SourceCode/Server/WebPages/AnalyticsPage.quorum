use Libraries.Web.Page.QuorumPage

/*
    The download counts, for an admin (/Analytics.quorum), which the
    server builds when asked. Converted from the old page by plan 13
    (phase 6): the same words, now without Tailwind.
*/
class AnalyticsPage is QuorumPage
    DownloadCounter counter = undefined

    on create
        SetDescription("Create, edit, share, and delete projects.")
    end

    action Setup
        SetWebPageTitle("Quorum Lessons - Quorum Programming Language")
        Title("Analytics")
        // The site's example of this page has no counts.
        if counter = undefined
            return now
        end
        Paragraph("Number of Releases: " + counter:GetNumberOfReleases())
        Paragraph("Latest Release: " + counter:GetLatestReleaseName())
        Paragraph("Mac ARM downloads: " + counter:GetArmCount())
        Paragraph("Mac Intel downloads: " + counter:GetIntelCount())
        Paragraph("Windows downloads: " + counter:GetWindowsCount())
    end

    action SetDownloadCount(DownloadCounter counter)
        me:counter = counter
    end
end
