use Libraries.Web.Page.QuorumPage
use Libraries.Web.Page.Division
use Libraries.Web.Page.Script

/*
    A shared project, running (/Share.quorum), which the server builds
    when asked: the project's name and its compiled program, drawing in
    the display under it. Converted from the old Lesson page by plan 13
    (phase 6): the same words and ids, now without Tailwind.
*/
class ProjectRunPage is QuorumPage
    text dq = ""
    text username = ""
    boolean isPublic = false
    text code = ""
    text projectName = ""
    text compiledProgram = ""

    action SetPublic(boolean isPublic)
        me:isPublic = isPublic
    end

    action SetUsername(text username)
        me:username = username
    end

    action SetCode(text code)
        me:code = code
    end

    action SetProjectName(text projectName)
        me:projectName = projectName
    end

    action SetCompiledCode(text compiled)
        me:compiledProgram = compiled
    end

    action Setup
        dq = dq:GetDoubleQuote()
        SetWebPageTitle(projectName)
        text header = "Run Quorum Online test"
        if projectName not= ""
            // Title escapes the words itself.
            header = dq + projectName + dq + " by " + username
        end
        Title(header)

        Script runnable
        runnable:SetCode(compiledProgram)
        Include(runnable)
        Division display
        display:SetIdentifier("QuorumUIContainer")
        Include(display)
    end
end
