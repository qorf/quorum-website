use Libraries.Web.Page.QuorumPage
use Libraries.Web.Page.Button
use Libraries.Web.Page.Form
use Libraries.Web.Page.Input
use Libraries.Web.Page.Paragraph
use Libraries.Web.Page.Link

/*
    A reader's project in the block editor (/Project.quorum and
    /BlocksProject.quorum), which the server builds when asked: its name
    and whether it is public, the block editor in project mode (Add File
    and Save Project in its toolbar), a link to the text editor, and the
    dialog that names and saves it. Converted from the old Lesson page by
    plan 13 (phase 6): the same words and ids, now without Tailwind; the
    old BlockIDE is QuorumPage's ProjectBlockEditor.
*/
class BlockProjectPage is QuorumPage
    text dq = ""
    text username = ""
    boolean isPublic = false
    text code = "[]"
    text projectName = ""
    constant text PUBLIC_PROJECT = "This is a public project. Anyone can view it."
    constant text PRIVATE_PROJECT = "This is a private project. Only you can view it."
    constant text EDITOR = "writeCodeIde"

    on create
        SetDescription("Create, edit, share, and delete projects.")
    end

    action SetPublic(boolean isPublic)
        me:isPublic = isPublic
    end

    action SetUsername(text username)
        me:username = username
    end

    // The project's files, as CodeForIDE:GetJsonArray gives them.
    action SetCode(text code)
        me:code = code
    end

    action SetProjectName(text projectName)
        me:projectName = projectName
    end

    action Setup
        dq = dq:GetDoubleQuote()
        SetWebPageTitle("Quorum Project Page - Quorum Programming Language")
        text header = "Run Quorum Online test"
        if projectName not= ""
            // Title escapes the words itself.
            header = dq + projectName + dq + " by " + username
        end
        Title(header)
        text subheading = "This is a page for running Quorum online."
        if isPublic and projectName not= ""
            subheading = PUBLIC_PROJECT
        elseif not isPublic and projectName not= ""
            subheading = PRIVATE_PROJECT
        end
        Paragraph(subheading)

        AddSaveDialog()
        ProjectBlockEditor(code, true)
        // Link escapes the address itself.
        Paragraph():Link("Swap to Text Mode", "/Project.quorum?user=" + username + "&file=" + projectName + "&text_mode=true")
    end

    // The dialog that names and saves the project; script.js saves it when
    // the form (saveProjectForm) is sent.
    private action AddSaveDialog
        Dialog("SaveModal", "Save this Project", EDITOR + "SaveTitleDiv", "closeSaveModal", "document.getElementById('SaveModal').hidden = true;")
        Form saveForm = Form("", "")
        saveForm:AddClassAttribute("saveProjectForm")
        saveForm:AddAttribute("method", "post")
        Input projectNameInput = FormField("Project Name: ", "projectNameInput", "text", "projectname")
        projectNameInput:AddAttribute("data-prefix", EDITOR)
        projectNameInput:AddAttribute("required", "true")
        projectNameInput:AddAttribute("data-projectname", SanitizeForHTML(projectName))
        projectNameInput:SetRequired(true)
        projectNameInput:AddAttribute("oninput", "
           (function(){
            let submitButton = document.getElementById('" + EDITOR + "saveProjectButton');
            let input = document.getElementById('projectNameInput');
            if (input.value.length > 0) {
                submitButton.removeAttribute('disabled');
            } else {
                submitButton.setAttribute('disabled', 'true');
            }
        })(); ")
        Button submitButton = FormButton("Save Project", EDITOR + "saveProjectButton", "submit")
        submitButton:SetTabIndex("0")
        EndForm()
        EndDialog()
    end

    action SanitizeForHTML(text string) returns text
        string = string:Replace("&", "&amp;")
        string = string:Replace(dq, "&quot;")
        string = string:Replace("'", "&#039;")
        string = string:Replace("<", "&lt;")
        string = string:Replace(">", "&gt;")
        return string
    end
end
