use Libraries.Web.Quorum.QuorumSiteOptions
use Libraries.Web.Page.QuorumPage
use Libraries.Web.Page.Button
use Libraries.Web.Page.Division
use Libraries.Web.Page.Form
use Libraries.Web.Page.Input
use Libraries.Web.Page.Paragraph
use Libraries.Web.Page.Script
use Libraries.Web.Page.Span
use Libraries.Web.Page.Label
use Libraries.Web.Page.Header
use Libraries.Web.Page.TableBody
use Libraries.Web.Page.TableCaption
use Libraries.Web.Page.TableData
use Libraries.Web.Page.TableHeader
use Libraries.Web.Page.TableHeaderCell
use Libraries.Web.Page.TableRow
use Libraries.Web.Page.WebTable
use Libraries.Web.Page.WebTag
use Libraries.Containers.Array
use Libraries.Compute.Statistics.DataFrame
use Libraries.Compute.Statistics.DataFrameColumn
use Libraries.System.DateTime

/*
    A reader's projects (/Profile.quorum), which the server builds when
    asked: a table of the projects (name, when changed, public, and Load,
    Share and Delete), a button for a new project, and the dialog that
    shares a project's link. Converted from the old Lesson page by plan 13
    (phase 6): the same words and ids, now without Tailwind; the old page
    had no title, so it has one ("Projects", as the navigation names it).
*/
class ProfilePage is QuorumPage
    QuorumSiteOptions quorumOptions
    text dq = ""
    text username = ""
    // The projects, one entry each, in the order the server gives them.
    Array<text> projectNames
    Array<text> modifiedDates
    Array<boolean> publicProjects

    constant text SHARE_RUNNING_SCRIPT = "const shareRunCheckbox = document.getElementById('shareRunningCheckbox');
const shareTextField = document.getElementById('shareText');
shareRunCheckbox.addEventListener('change', () => {
  if (shareRunCheckbox.checked) {
    shareTextField.value = shareTextField.value.replace('Project.quorum', 'Share.quorum');
  } else {
    shareTextField.value = shareTextField.value.replace('Share.quorum', 'Project.quorum');
  }
});"

    constant text PUBLIC_SCRIPT = "$('.publicCheckbox').change(function() {
var public = this.checked ? 1 : 0;
var value = this.value;
    $.ajax({
        type: 'POST',
        url: '/ChangePrivacy.quorum',
        data: {public: public, file: value},
        success: function (result) {
        },
        error: function (xhr, ajaxOptions, thrownError) {
            alert('I could not connect to the server at quorumlanguage.com: ' + thrownError);
        }
    });
});"

    on create
        SetDescription("Create, edit, share, and delete projects.")
    end

    /*
        Sets the projects from the database's table, with the columns
        project_name, modified and public.
    */
    action SetProjects(DataFrame table)
        DataFrameColumn names = table:GetColumn("project_name")
        DataFrameColumn dates = table:GetColumn("modified")
        DataFrameColumn publicList = table:GetColumn("public")
        integer i = 0
        repeat while i < names:GetSize()
            text projectName = names:GetAsText(i)
            if projectName = undefined
                projectName = ""
            end
            text modified = dates:GetAsText(i)
            check
                DateTime modifiedDate = dates:GetAsDateTime(i)
                modified = modifiedDate:GetMonthName() + " " + modifiedDate:GetDayOfMonth() + ", " + modifiedDate:GetYear()
            detect e
            end
            AddProject(projectName, modified, publicList:GetAsText(i) = "1")
            i = i + 1
        end
    end

    /*
        Adds a project to the table, as SetProjects does for each, such as
        for the example the site styles itself from.
    */
    action AddProject(text projectName, text modified, boolean isPublic)
        projectNames:Add(projectName)
        modifiedDates:Add(modified)
        publicProjects:Add(isPublic)
    end

    action SetUsername(text username)
        me:username = username
    end

    action Setup
        dq = dq:GetDoubleQuote()
        SetWebPageTitle("Quorum Lessons - Quorum Programming Language")
        Title("Projects")

        Dialog("shareModal", "Share my Project", "shareTitleDiv", "closeShareModal", "hideShareModal();")
        FormCheckbox("Share only running version", "shareRunningCheckbox")
        Input shareText = FormEntry("Project link", "", "shareText", "text", "shareText")
        shareText:SetDefaultValue("Name")
        shareText:SetReadOnly(true)
        FormWords("This link goes to your project. If the project is private, no one will be able to look at the project except you.
        If you want to share it with others, the project must be public.")
        Paragraph copyMessage = FormWords("The link has been copied to your clipboard.")
        copyMessage:SetIdentifier("clipboardCopyMessage")
        copyMessage:AddAttribute("hidden", "")
        Button hideButton = FormButton("Close", "", "button")
        hideButton:SetOnClick("hideShareModal()")
        EndDialog()
        Include(NewScript(SHARE_RUNNING_SCRIPT))

        // The button for a new project beside the title, and how many
        // projects there are under it.
        Form newProject
        newProject:SetFormAction("Project.quorum")
        Button submit
        submit:SetType("submit")
        submit:AddText("Create a New Project")
        SetStyle(submit, quorumOptions:GetForms():GetButton())
        SetStyleOnHover(submit, quorumOptions:GetForms():GetButtonHover())
        SetStyleOnKeyboardFocus(submit, quorumOptions:GetForms():GetButtonFocus())
        newProject:AddNestedTag(submit)
        Header titleRow = GetTitleHeader()
        SetLayout(titleRow, quorumOptions:GetProjectsTitleRow())
        titleRow:AddNestedTag(newProject)
        Paragraph count
        integer projects = projectNames:GetSize()
        if projects = 1
            count:AddText("1 project")
        else
            count:AddText("" + projects + " projects")
        end
        SetStyle(count, quorumOptions:GetProjectsCount())
        Include(count)

        // The table, scrolling sideways in its box on a narrow screen.
        Division tableBox
        SetStyle(tableBox, quorumOptions:GetProjectsTableBox())
        tableBox:AddNestedTag(GetProjectTable())
        Include(tableBox)
        Include(NewScript(PUBLIC_SCRIPT))
    end

    // The projects' table: one row each, with its Load, Share and Delete.
    private action GetProjectTable returns WebTable
        WebTable table
        SetStyle(table, quorumOptions:GetProjectsTable())
        TableCaption caption
        caption:AddText("Project Table")
        SetStyle(caption, quorumOptions:GetProjectsCaption())
        table:Add(caption)
        TableHeader head
        TableRow headRow
        Array<text> columns
        columns:Add("Project Name")
        columns:Add("Last Modified")
        columns:Add("Public")
        columns:Add("Actions")
        integer c = 0
        repeat while c < columns:GetSize()
            TableHeaderCell cell
            cell:AddAttribute("scope", "col")
            cell:AddText(columns:Get(c))
            if c = columns:GetSize() - 1
                SetStyle(cell, quorumOptions:GetProjectsHeaderEnd())
            else
                SetStyle(cell, quorumOptions:GetProjectsHeader())
            end
            headRow:Add(cell)
            c = c + 1
        end
        head:Add(headRow)
        table:Add(head)

        TableBody body
        integer i = 0
        repeat while i < projectNames:GetSize()
            text projectName = projectNames:Get(i)
            text shareLink = "quorumlanguage.com/Project.quorum?user=" + SanitizeForHTML(username) + "&file=" + SanitizeForHTML(projectName)
            TableRow row

            TableData name = NewCell(projectName)
            SetStyle(name, quorumOptions:GetProjectsNameCell())
            row:Add(name)
            row:Add(NewCell(modifiedDates:Get(i)))

            row:Add(NewCellWith(NewSwitch(projectName, i)))

            Form loadButton
            loadButton:SetFormAction("Project.quorum")
            Input userInput
            userInput:SetType("hidden")
            userInput:SetName("user")
            userInput:SetDefaultValue(SanitizeForHTML(username))
            Input fileInput
            fileInput:SetType("hidden")
            fileInput:SetName("file")
            fileInput:SetDefaultValue(SanitizeForHTML(projectName))
            Button profileButton
            profileButton:SetType("submit")
            profileButton:AddText("Load")
            SetStyle(profileButton, quorumOptions:GetForms():GetLinkButton())
            loadButton:Add(userInput)
            loadButton:Add(fileInput)
            loadButton:AddNestedTag(profileButton)

            Button shareButton
            shareButton:SetType("button")
            shareButton:SetOnClick("showShareModal('" + shareLink + "')")
            shareButton:AddText("Share")
            SetStyle(shareButton, quorumOptions:GetForms():GetLinkButton())

            Button deleteButton
            deleteButton:SetType("button")
            deleteButton:AddAttribute("value", SanitizeForHTML(projectName))
            deleteButton:SetOnClick("deleteRow(this)")
            deleteButton:AddText("Delete")
            SetStyle(deleteButton, quorumOptions:GetProjectsDelete())

            // Load, Share and Delete together, at the right.
            Division actions
            SetLayout(actions, quorumOptions:GetProjectsActions())
            actions:AddNestedTag(loadButton)
            actions:AddNestedTag(shareButton)
            actions:AddNestedTag(deleteButton)
            row:Add(NewCellWith(actions))

            body:Add(row)
            i = i + 1
        end
        table:Add(body)
        return table
    end

    // Whether a project is public, as a switch: its checkbox (which the
    // page's script sends to the server when it changes) hidden from sight
    // but used by the keyboard and screen readers, and the switch drawn
    // beside it, inside the checkbox's label.
    private action NewSwitch(text projectName, integer index) returns Label
        Label label
        Input checkbox
        checkbox:SetClassAttribute("publicCheckbox")
        checkbox:SetType("checkbox")
        checkbox:SetChecked(publicProjects:Get(index))
        checkbox:SetIdentifier("publicBox" + index)
        checkbox:SetName("public")
        checkbox:SetDefaultValue(SanitizeForHTML(projectName))
        checkbox:AddAttribute("aria-label", "Public: " + SanitizeForHTML(projectName))
        SetStyle(checkbox, quorumOptions:GetSwitchInput())
        label:AddNestedTag(checkbox)
        Span track
        track:AddAttribute("aria-hidden", "true")
        SetStyle(track, quorumOptions:GetSwitchTrack())
        SetStyleAfterChecked(track, quorumOptions:GetSwitchTrackOn())
        SetStyleAfterKeyboardFocus(track, quorumOptions:GetSwitchTrackFocus())
        Span knob
        SetStyle(knob, quorumOptions:GetSwitchKnob())
        SetStyleInsideAfterChecked(knob, quorumOptions:GetSwitchKnobOn())
        track:AddNestedTag(knob)
        label:AddNestedTag(track)
        return label
    end

    // A table cell with words, in the site's table look.
    private action NewCell(text words) returns TableData
        TableData cell
        cell:AddText(SanitizeForHTML(words))
        SetStyle(cell, quorumOptions:GetProjectsCell())
        return cell
    end

    // A table cell holding a control, in the site's table look.
    private action NewCellWith(WebTag control) returns TableData
        TableData cell
        cell:AddNestedTag(control)
        SetStyle(cell, quorumOptions:GetProjectsCell())
        return cell
    end

    private action NewScript(text code) returns Script
        Script script
        script:SetCode(code)
        return script
    end

    action SanitizeForHTML(text string) returns text
        string = string:Replace("&", "&amp;")
        string = string:Replace(dq, "&quot;")
        string = string:Replace("'", "&#039;")
        string = string:Replace("<", "&lt;")
        string = string:Replace(">", "&gt;")
        return string
    end
end
