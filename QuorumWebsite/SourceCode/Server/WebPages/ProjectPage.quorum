use Libraries.Web.Page.QuorumPage
use Libraries.Web.Page.Button
use Libraries.Web.Page.Form
use Libraries.Web.Page.IDE
use Libraries.Web.Page.Input
use Libraries.Web.Page.Script

/*
    A reader's project in the code editor (/Project.quorum with
    text_mode), which the server builds when asked: its name and whether
    it is public, the editor with the project's code and a Save Project
    button, and the dialog that names and saves it. Converted from the old
    Lesson page by plan 13 (phase 6): the same words and ids, now without
    Tailwind. (The editor itself, and the Save Project button that copies
    the editor's own look, are the IDE widget's: plan 13's F9.)
*/
class ProjectPage is QuorumPage
    text dq = ""
    text username = ""
    boolean isPublic = false
    text code = ""
    text projectName = ""
    constant text PUBLIC_PROJECT = "This is a public project. Anyone can view it."
    constant text PRIVATE_PROJECT = "This is a private project. Only you can view it."
    constant text EDITOR = "writeCodeIde"

    // Adds Save Project beside the editor's Export button, opening the save
    // dialog.
    constant text SAVE_BUTTON_SCRIPT = "
            document.addEventListener(`DOMContentLoaded`, function() {
              let topSidebar = document.querySelector(`[data-test='topSidebar']`)
              let exportButton = document.querySelector(`[data-test='exportButton']`)
              let exportButtonStyle = exportButton.getAttribute(`style`)
              let saveProjectButton = document.createElement(`button`)
              saveProjectButton.setAttribute(`style`, exportButtonStyle)
              saveProjectButton.setAttribute(`data-test`, `saveProjectButton`)
              saveProjectButton.innerHTML = `Save Project`
              saveProjectButton.id = `writeCodeIdesaveProjectButton`
              saveProjectButton.addEventListener(`click`, function() {
                document.getElementById(`outerContentModal`).hidden = false
              })
              topSidebar.appendChild(saveProjectButton)
            })
        "

    on create
        SetDescription("Create, edit, share, and delete projects.")
    end

    action SetPublic(boolean isPublic)
        me:isPublic = isPublic
    end

    action SetUsername(text username)
        me:username = username
    end

    action SetCode(text code)
        me:code = code
    end

    action SetProjectName(text projectName)
        me:projectName = projectName
    end

    action Setup
        dq = dq:GetDoubleQuote()
        SetWebPageTitle("Quorum Project Page - Quorum Programming Language")
        text header = "Run Quorum Online test"
        if projectName not= ""
            // Title escapes the words itself.
            header = dq + projectName + dq + " by " + username
        end
        Title(header)
        text subheading = "This is a page for running Quorum online."
        if isPublic and projectName not= ""
            subheading = PUBLIC_PROJECT
        elseif not isPublic and projectName not= ""
            subheading = PRIVATE_PROJECT
        end
        Paragraph(subheading)

        AddSaveDialog()

        text ideName = "Quorum Online"
        if projectName not= undefined and projectName not= ""
            ideName = projectName
        end
        IDE ide = CodeEditorWithCode(ideName, code)
        ide:SetIdentifier(EDITOR)
        ide:HideDisplay()
        Script saveButton
        saveButton:SetCode(SAVE_BUTTON_SCRIPT)
        Include(saveButton)
    end

    // The dialog that names and saves the project: Save Project stays
    // unavailable until the name has words.
    private action AddSaveDialog
        Dialog("outerContentModal", "Save this Project", EDITOR + "SaveTitleDiv", "", "hideSaveModal('" + EDITOR + "')")
        Form saveForm = Form("", "")
        saveForm:AddAttribute("method", "post")
        Input projectNameInput = FormField("Project Name: ", EDITOR + "projectNameInput", "text", "projectname")
        projectNameInput:AddAttribute("data-prefix", EDITOR)
        projectNameInput:AddAttribute("required", "true")
        projectNameInput:SetRequired(true)
        projectNameInput:AddAttribute("oninput", "
           (function(){
            let submitButton = document.getElementById('" + EDITOR + "saveProjectButton');
            let input = document.getElementById('" + EDITOR + "projectNameInput');
            if (input.value.length > 0) {
                submitButton.removeAttribute('disabled');
            } else {
                submitButton.setAttribute('disabled', 'true');
            }
        })(); ")
        Button submitButton = FormButton("Save Project", EDITOR + "saveProjectButton", "button")
        submitButton:AddAttribute("disabled", "true")
        submitButton:SetTabIndex("0")
        submitButton:SetOnClick("(function(){
          // Get data-test of IdeInput and get the ide and the value without the IdeInput
          let ideInput = document.querySelector('[data-test=\'IdeInput\']');
          let id = ideInput.getAttribute('id');
          let ide = id.replace('IdeInput', '');
          saveProject(ide, ide + 'IdeInput', ide + 'consoleSection', '" + EDITOR + "'+ 'projectNameInput', 'false');
          })();
        ")
        EndForm()
        EndDialog()
    end
end
