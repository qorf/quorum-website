/*
    Writes the whole website into html/. To run it, set "Main" in
    Project/Project.qp to "/SourceCode/Website/WebsiteMain.quorum".

    Named WebsiteMain, not Main, until main.quorum (whose class is Main) is
    deleted.
*/
class WebsiteMain
    action Main
        QuorumWebsite website
        website:Write()
    end
end
