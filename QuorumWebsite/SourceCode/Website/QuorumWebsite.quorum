    // Adds one of the old site's pages at its own location.
    private action Add(WebPage page)
        Add(page, page:GetLocation())
    end

    // Adds one of the old site's pages at a location. A few old pages give
    // theirs with a leading slash, which the site leaves out.
    private action Add(WebPage page, text location)
        if location:StartsWith("/")
            location = location:GetSubtext(1)
        end
        oldPages:Set(location, page)
    end

    // Makes an empty series of the old site's lessons and puts it on the
    // site. The key names it on the site, in full words.
    private action Series(text key) returns PageSeries
        PageSeries series
        series:SetKey(key)
        Array<Lesson> lessons
        seriesLessons:Set(key, lessons)
        site:AddSeries(series)
        return series
    end

    /*
        Adds a lesson to the end of a series. The series takes its name,
        description and picture from its first lesson, as the track pages
        show it. A lesson takes its Back and Next from its home series only,
        so a lesson that also ends another series (as each chapter ends the
        previous chapter's labs) keeps its own.
    */
    private action Add(PageSeries series, Lesson lesson)
        text key = series:GetKey()
        Array<Lesson> lessons = seriesLessons:GetValue(key)
        Lesson previous = undefined
        if lessons:IsEmpty()
            series:SetName(lesson:GetSectionName())
            series:SetDescription(lesson:GetMetaDescription())
            series:SetImage(lesson:GetImageLocation())
        else
            previous = lessons:Get(lessons:GetSize() - 1)
        end
        series:Add(lesson)
        lessons:Add(lesson)

        if not homeSeries:HasKey(lesson)
            homeSeries:Set(lesson, key)
            lesson:SetPreviousLesson(previous)
        end
        if previous not= undefined and homeSeries:GetValue(previous) = key
            previous:SetNextInSeries(lesson)
        end
    end

    // The lessons of a series, for the track pages that still list lessons.
    private action GetLessons(PageSeries series) returns Array<Lesson>
        return seriesLessons:GetValue(series:GetKey())
    end

    private action WriteProblemsPages
        ProblemGenerator generator
        generator:Generate()

        AllProblemsPage allProblemsPage
        allProblemsPage:SetGenerator(generator)

        allProblemsPage:Setup()
        allProblemsPage:Write(WRITE_PATH)

        Iterator<Problems> problemsIterator = generator:GetProblemsIterator()
        repeat while problemsIterator:HasNext()
            Problems problems = problemsIterator:Next()
            //generate the problems page
            ProblemsPage problemsPage
            problemsPage:SetProblems(problems)
            problemsPage:Setup()
            problemsPage:Write(WRITE_PATH)
            File writeFolder
            writeFolder:SetAbsolutePath(WRITE_PATH)

            //now generate all the pages for the individual problems
            Iterator<Problem> problemIterator = problems:GetProblemIterator()
            repeat while problemIterator:HasNext()
                Problem problem = problemIterator:Next()
                ProblemPage page
                page:SetProblem(problem)
                page:Setup()
                page:Write(WRITE_PATH)
            end
        problems:CopyTo(WRITE_PATH)
        end
    end

    private action BuildSiteMap
        File file
        file:SetPath("html")
        text result = ""
        text DQ = result:GetDoubleQuote()
        text NL = result:GetCarriageReturn() + result:GetLineFeed()
        result = "<?xml version="+DQ+"1.0"+DQ+" encoding="+DQ+"UTF-8"+DQ+"?>" + NL
        result = result + "<urlset xmlns="+DQ+"http://www.sitemaps.org/schemas/sitemap/0.9"+DQ+">" + NL
        text root = file:GetAbsolutePath()
        integer size = root:GetSize()
        Array<File> pages = file:GetDirectoryListing()
        i = 0
        repeat while i < pages:GetSize()
            File page = pages:Get(i)
            if page:IsDirectory()
                result = result + GetDirectoryMap(file, page)
            elseif page:IsFile() and page:GetFileExtension() = "html"
                text path = page:GetAbsolutePath()
                text newPath = SITE_NAME + path:GetSubtext(size)
                text url = "<url><loc>" + newPath + "</loc></url>" + NL
                result = result + url
            end
            i = i + 1
        end

        result = result + "</urlset>"
        File map
        map:SetPath("html/sitemap.xml")
        map:Write(result)
        map:Close()
    end

    private action GetDirectoryMap(File root, File file) returns text
        text result = ""
        text DQ = result:GetDoubleQuote()
        text NL = result:GetCarriageReturn() + result:GetLineFeed()
        integer size = root:GetAbsolutePath():GetSize()
        Array<File> pages = file:GetDirectoryListing()
        i = 0
        repeat while i < pages:GetSize()
            File page = pages:Get(i)
            if page:IsDirectory()
                result = result + GetDirectoryMap(root, page)
            elseif page:IsFile() and page:GetFileExtension() = "html"
                text path = page:GetAbsolutePath()
                text newPath = SITE_NAME + path:GetSubtext(size)
                text url = "<url><loc>" + newPath + "</loc></url>" + NL
                result = result + url
            end
            i = i + 1
        end
        return result
    end

