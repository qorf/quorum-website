/*
    The whole Quorum website: every page, in one place. Main writes it into
    html/; ServerMain writes it and then serves the pages that
    answer requests (signing in, saving projects, and so on).

    Each page is added once, and the site sets it up and writes it. Most
    pages are still the old site's, written exactly as they make
    themselves; pages in the new look (the scene lessons, so far) get the
    site's frame, stylesheet, search tags and course navigation. Lessons
    that follow one another are listed in a series, such as a unit of a
    track, and the track pages list their series.
*/
class QuorumWebsite
    constant text WRITE_PATH = "html/"
    constant text SITE_FOLDER = "html"
    constant text SITE_NAME = "https://quorumlanguage.com"

    // Search and sharing, for pages in the new look: the site's name, the
    // ending of every tab title, and the picture shown when a page
    // without its own is shared (Quincy, 1200 by 630).
    constant text SITE_TITLE = "Quorum Programming Language"
    constant text TITLE_ENDING = " - Quorum Programming Language"
    constant text DEFAULT_SHARE_IMAGE = "media/userInterface/quorumAssets/bunnyShare.jpg"
    constant text DEFAULT_SHARE_IMAGE_DESCRIPTION = "Tech-savvy bunny named Quincy with glasses working on a laptop"

    QuorumSite site

    // The look of every page in the new look.
    QuorumSiteOptions options

    // The old site's pages by location. A lesson in more than one track is
    // made once for each, and the last one added is the one written.
    HashTable<text, WebPage> oldPages

    // Each series' lessons by the series' key, and the key of each lesson's
    // home series: the first one it's added to, which gives it its Back
    // and Next.
    HashTable<text, Array<Lesson>> seriesLessons
    HashTable<Lesson, text> homeSeries

    /*
        Builds every page, writes the site into html/, then writes the
        practice problems and the sitemap, which are read from files.
    */
    action Write
        VersionHelper helper
        output "Loading Quorum Website. Version " + helper:GetLanguageVersion()
        output "Writing index pages"
        SiteSettings()
        HomePages()
        output "Writing Tutorials"
        TutorialPages()
        output "Writing Lessons"
        AddLessons()

        Iterator<text> locations = oldPages:GetKeyIterator()
        repeat while locations:HasNext()
            text location = locations:Next()
            site:AddPlainPage(oldPages:GetValue(location), location)
        end
        ServerResponders()
        site:SetFolder(SITE_FOLDER)
        site:Write()
        output "Website finished."

        output "Writing Problems Pages"
        WriteProblemsPages()
        output "Finished Problems Pages"

        BuildSiteMap()
        output "Sitemap created"
    end

    /*
        Answers requests on a port until the server is stopped: the
        responders below, and the site's pages. Write the site first.
    */
    action Serve(integer port)
        output "Listening ..."
        site:Serve(port)
    end

    action GetSite returns QuorumSite
        return site
    end

    // What the pages in the new look need from the site: the scripts'
    // versions, search and sharing, their look, and the report of the
    // 2026 CSTA standards their lessons cover (standards/CSTA2026.html).
    private action SiteSettings
        // Pages name their files from the top of the site, such as
        // "media/scenes/...".
        site:SetRelativeFolder("")

        VersionHelper versions
        site:SetScriptVersions(versions:GetLanguageVersionQuery(), versions:GetScriptVersionQuery(), versions:GetPrismVersionQuery(), versions:GetLoadVersionQuery())

        site:SetAddress(SITE_NAME)
        site:SetSiteName(SITE_TITLE)
        site:SetTitleEnding(TITLE_ENDING)
        site:SetDefaultShareImage(DEFAULT_SHARE_IMAGE, DEFAULT_SHARE_IMAGE_DESCRIPTION)
        site:SetStyleOptions(options)

        // Set to true to check every page in the new look for
        // accessibility problems; the build stops and lists any it finds.
        site:SetAccessibilityChecks(false)

        QuorumStandards standards
        site:AddStandardsReport(standards:GetComputerScience2026())
    end

    // Adds a page in the new look, with the site's look.
    private action AddStyled(QuorumPage page)
        page:SetStyleOptions(options)
        site:AddPage(page)
    end

    // What answers requests while people use the site: signing in, saving
    // and running projects, resetting passwords. Served, never written.
    private action ServerResponders
        Login login
        Logout logout
        Analytics analytics
        SessionValid session
        ChangePrivacy changePrivacy
        Search search
        ProjectSave projectSave
        ProjectRun projectRun
        Delete delete
        LoadProjectFile loadProjectFile
        LoadProjectSelect loadProjectSelect
        Profile profile
        Project project
        BlocksProject blocksProject
        Register register
        RequestPasswordReset requestReset
        ResetPasswordResponsePage resetPassword
        ConfirmResetPassword confirmPassword
        Fastrun fastrun

        site:AddResponder(login)
        site:AddResponder(logout)
        site:AddResponder(analytics)
        site:AddResponder(session)
        site:AddResponder(changePrivacy)
        site:AddResponder(search)
        site:AddResponder(projectSave)
        site:AddResponder(projectRun)
        site:AddResponder(delete)
        site:AddResponder(loadProjectFile)
        site:AddResponder(loadProjectSelect)
        site:AddResponder(profile)
        site:AddResponder(project)
        site:AddResponder(blocksProject)
        site:AddResponder(register)
        site:AddResponder(requestReset)
        site:AddResponder(resetPassword)
        site:AddResponder(confirmPassword)
        site:AddResponder(fastrun)
    end

