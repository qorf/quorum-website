/*
    Writes the whole website into html/, then answers the requests the
    site sends while people use it (signing in, saving projects, and so
    on) on port 9746. To run it, set "Main" in Project/Project.qp to
    "/SourceCode/Website/ServerMain.quorum". Stop the run to stop the
    server.

    The requests are still answered by RunServer, until they move to the
    site.
*/
class ServerMain
    action Main
        QuorumWebsite website
        website:Write()

        RunServer server
        server:SetupPages()
        server:StartServer()
    end
end
