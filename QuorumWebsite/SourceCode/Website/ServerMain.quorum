/*
    Writes the whole website into html/, then answers requests on port
    9746: the requests the site sends while people use it (signing in,
    saving projects, and so on), and the site's pages. To run it, set
    "Main" in Project/Project.qp to "/SourceCode/Website/ServerMain.quorum".
    Stop the run to stop the server.
*/
class ServerMain
    constant integer PORT = 9746

    action Main
        QuorumWebsite website
        website:Write()
        website:Serve(PORT)
    end
end
