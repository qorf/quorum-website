use Libraries.Web.Page.QuorumPage

/*
    CQuiz on Control Structures.
    Converted from the old Lesson page by plan 13's generator: the same
    words, now without Tailwind.
*/
class Chapter3ControlStructures is QuorumPage

    on create
        SetLocation("lessons/chapter3.html")
        // The name lists and links use, and the series and track it belongs
        // to: its section and picture.
        SetShortTitle("Control Structures")
        SetSectionName("Chapter 3")
        SetCardImage("/media/control.png")
        // For search engines and link previews, and what lists of pages say.
        SetDescription("Read some possible exam questions on how control structures like conditionals and loops are used in the Quorum programming language.")
        SetSummary("how work control structures in Quorum.")
    end

    action Setup
        SetWebPageTitle("Quiz on Control Structures - Quorum Programming Language")
        Title("CQuiz on Control Structures")
        Paragraph("This is a short quiz about concepts related to control flow and control structures")
        ControlStructuresQuiz()
        EssayQuestions()
    end

    private action ControlStructuresQuiz
        Section("Control Structures Quiz")
        NumberedList()
        ListItem("What are control structures? List two types of control structures and explain what they do. Give an example for each structure.")
        ListItem("What is lexical scoping and why is it important?")
        ListItem("What does it mean to 'mask' a variable inside of a nested block?")
        ListItem("Explain the difference between a loop and a conditional.")
        ListItem("What is an infinite loop? What strategies can help us prevent infinite loops?")
        ListItem("What is a breakpoint and what are they used for?")
        ListItem("Give an example of repeat times, while, and until.")
        ListItem("Give an example of an if statement.")
        ListItem("Describe a situation where a conditional statement would be useful.")
        ListItem("Describe a situation where a loop would be useful.")
        ListItem("What are libraries and how do they relate to use statements?")
        ListItem("Use the Quorum website's reference page to find the use statements for the following classes: 1) Drawable, 2) Microphone, and 3) File.")
        ListItem("Describe the concept of a package.")
        ListItem("Describe the concept of a nested loop and give an example in code.")
        ListItem("Describe how the concept of a conditional statement could be used for a program like a game (audio, visual, or multimedia) or robot?")
    end

    private action EssayQuestions
        Section("Essay Questions")
        NumberedList()
        ListItem("Think about the common errors you have personally while using control structures. Write a short essay describing these errors. Do you personally have compiler errors? Runtime errors? Which has been more challenging to solve in your own programs?")
        ListItem("Write a short essay describing how the debugger can be used to find errors in control structures. In your essay, include the following concepts: 1) the error window, 2) breakpoints, and 3) step over.")
    end
end
