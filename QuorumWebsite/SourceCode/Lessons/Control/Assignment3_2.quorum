use Libraries.Web.Page.QuorumPage

/*
    Assignment 3.2: Number Guessing Game.
    Converted from the old Lesson page by plan 13's generator: the same
    words, now without Tailwind.
*/
class Assignment3_2 is QuorumPage
    // A double quote, for code and words that hold one.
    text dq = ""

    on create
        SetLocation("lessons/chapter3/assignment3_2.html")
        // The name lists and links use, and the series and track it belongs
        // to: its section and picture.
        SetShortTitle("Assignment 3.2")
        SetSectionName("Control Structures")
        // For search engines and link previews, and what lists of pages say.
        SetDescription("Write a number guessing game while learning about lexical scoping, loops, and conditionals with the Quorum programming language.")
        SetSummary("how work Number Guessing Game in Quorum.")
    end

    action Setup
        dq = dq:GetDoubleQuote()
        SetWebPageTitle("Assignment 3.2: Number Guessing Game - Quorum Programming Language")
        Title("Assignment 3.2: Number Guessing Game")
        Objectives()
        ComputerSciencePrinciplesCurriculum()
        CommonCoreStandards()
        Vocabulary()
        Overview()
        CompleteTheFollowingTasksToMeetAllObjectives()
        SampleOutput()
    end

    private action Objectives
        Section("Objectives")
        Paragraph("The goal of this assignment is to learn the following:")
        BulletList()
        ListItem("Conditionals and lexical scoping")
        ListItem("Loops")
        ListItem("How to analyze a problem statement")
    end

    private action ComputerSciencePrinciplesCurriculum
        Section("Computer Science Principles Curriculum")
        BulletList()
        ListItem():Strong("Big Idea: Algorithms: "):Text("EU 4.2, LO 4.2.3, EK 4.2.3A, EK 4.2.3B, EK 4.2.3C")
        ListItem():Strong("Big Idea: Algorithms: "):Text("EU 4.2, LO 4.2.4, EK 4.2.4A, EK 4.2.4B, EK 4.2.4C, EK 4.2.4G")
        ListItem():Strong("Big Idea: Programming: "):Text("EU 5.4, LO 5.4.1, EK 5.4.1M, EK 5.4.1N")
    end

    private action CommonCoreStandards
        Section("Common Core Standards")
        BulletList()
        ListItem():Strong("English Language Arts Standards » Science & Technical Subjects: "):Text("CCSS.ELA-Literacy.RST.9-10.3, CCSS.ELA-Literacy.RST.9-10.4, CCSS.ELA-Literacy.RST.9-10.5, CCSS.ELA-Literacy.RST.9-10.7, CCSS.ELA-Literacy.RST.9-10.10, CCSS.ELA-Literacy.RST.11-12.2, CCSS.ELA-Literacy.RST.11-12.3, CCSS.ELA-Literacy.RST.11-12.4, CCSS.ELA-Literacy.RST.11-12.5, CCSS.ELA-Literacy.RST.11-12.10")
        ListItem():Strong("Standards For Mathmatical Practice: "):Text("CCSS.Math.Practice.MP1, CCSS.Math.Practice.MP2, CCSS.Math.Practice.MP4, CCSS.Math.Practice.MP5, CCSS.Math.Practice.MP6, CCSS.Math.Practice.MP7, CCSS.Math.Practice.MP8")
    end

    private action Vocabulary
        Section("Vocabulary")
        BulletList()
        ListItem("Conditional")
        ListItem("Lexical Scoping")
        ListItem("Random Number")
        ListItem("Repeat Loop")
    end

    private action Overview
        Section("Overview")
        Paragraph("In this assignment you will write a program using the skills you have already learned. Write a number guessing game that generates a random number between 1 and 100, inclusively (meaning 1 and 100 should be included). Once a number is generated, ask the user to guess that number and continue asking the until they guess the correct number. You will give the user hints, such as telling them their guess is too high or too low.")
    end

    private action CompleteTheFollowingTasksToMeetAllObjectives
        Section("Complete the Following Tasks to Meet All Objectives")
        Paragraph("Create a new project and name it "):Strong("GuessingGame"):Text(", and open the main.quorum file.")
        Paragraph("Your program should:")
        BulletList()
        ListItem("Use a repeat loop, so the game will continue until the game is over.")
        ListItem("Have a conditions to determine if the users guess is less than, greater than, or equal to the random number.")
        ListItem("Ask the user to enter a number between 1 and 100.")
        Paragraph():Strong("Example: "):Code("use"):Strong(" statement and "):Code("RandomIntegerBetween(integer, integer)"):Strong(" action you will need."):NewLine():Text("You will need to use "):Code("Libraries.Compute.Random"):Text(" to create a random number object. You will then need to call the "):Code("RandomIntegerBetween(integer, integer)"):Text(" action on that object.")
        CodeExample("//This line is the use statement.

use Libraries.Compute.Random
//Add your Random object here.
Random random
//Call this action on your Random object. Fill in the parameters with the correct integers.

random:RandomIntegerBetween(integer, integer)")
        Paragraph():Strong("NOTE: Output and the Online Editor"):NewLine():Text("When running this assignment online, the results of "):Code("output"):Text(" won't appear until after the program finishes. This means that if we use "):Code("output"):Text(" statements to let the user know if their guess is too low or too high, they won't get any feedback until after they've already guessed correctly. To get around this problem, we can add our output to the beginning of our "):Code("input"):Text(" statements instead.")
        CodeExample("// We can store our " + dq + "output" + dq + " in this variable.

text response = " + dq + "Welcome to the number guessing game. Can you guess my number?" + dq + "

// Then we can add our variable to the front of our input statement.

integer guess = cast(integer, input(response + " + dq + " Guess a number between 1 and 100:" + dq + "))")
        CodeEditorWithCode("Activity: Write a program with the given specifications", " ")
    end

    private action SampleOutput
        Section("Sample Output")
        Paragraph("The input dialog statements are included in the sample output. They are identified as [Input Dialog].")
        CodeExample("Welcome to the number guessing game. Can you guess my number?
[Input Dialog] Guess a number between 1 and 100: 50
My number is less than 50
[Input Dialog] Guess a number between 1 and 100: 25
My number is greater than 25
[Input Dialog] Guess a number between 1 and 100: 38
You guessed my number!
Game over.", "")
    end
end
