use Libraries.Web.Page.QuorumPage

/*
    Assignment 3.5: Robots - Visual.
    Converted from the old Lesson page by plan 13's generator: the same
    words, now without Tailwind.
*/
class Assignment3_5 is QuorumPage
    // A double quote, for code and words that hold one.
    text dq = ""

    on create
        SetLocation("lessons/chapter3/assignment3_5.html")
        // The name lists and links use, and the series and track it belongs
        // to: its section and picture.
        SetShortTitle("Assignment 3.5")
        SetSectionName("Control Structures")
        // For search engines and link previews, and what lists of pages say.
        SetDescription("Learn to remotely control a LEGO Mindstorms robot using loops and conditionals with the Quorum programming language.")
        SetSummary("how Robots work in Quorum.")
    end

    action Setup
        dq = dq:GetDoubleQuote()
        SetWebPageTitle("Assignment 3.5: Robots - Quorum Programming Language")
        Title("Assignment 3.5: Robots - Visual")
        VisualizingRobots()
        Overview()
        ExampleCreateTheConditionInWhichTheTopLeftButton()
    end

    private action VisualizingRobots
        Section("Visualizing Robots")
        Subsection("Goals")
        Paragraph("In this lab you will practice the following computer science concepts in a team or small group environment:")
        BulletList()
        ListItem("Creating Objects")
        ListItem("Using conditional statements and looping statements")
        Subsection("Computer Science Principles Curriculum")
        BulletList()
        ListItem():Strong("Big Idea: Creativity: "):Text("EU 1.2, LO 1.2.3, EK 1.2.3A, EU 1.3, LO 1.3.1, EK 1.3.1A")
        ListItem():Strong("Big Idea: Algorithms: "):Text("EU 4.1, LO 4.1.1, EK 4.1.1B")
        ListItem():Strong("Big Idea: Programming: "):Text("EU 5.1, LO 5.1.1, EK 5.1.1B, EU 5.2, LO 5.2.1, EK 5.2.1C, EK 5.2.1D")
        Subsection("Common Core Standards")
        BulletList()
        ListItem():Strong("English Language Arts Standards » Science & Technical Subjects: "):Text("CCSS.ELA-Literacy.RST.9-10.2, CCSS.ELA-Literacy.RST.9-10.3, CCSS.ELA-Literacy.RST.9-10.4, CCSS.ELA-Literacy.RST.9-10.5, CCSS.ELA-Literacy.RST.9-10.6, CCSS.ELA-Literacy.RST.11-12.2, CCSS.ELA-Literacy.RST.11-12.3, CCSS.ELA-Literacy.RST.9-10.1, CCSS.ELA-Literacy.RST.9-10.2, CCSS.ELA-Literacy.RST.9-10.7, CCSS.ELA-Literacy.RST.9-10.8, CCSS.ELA-Literacy.RST.9-10.9")
        ListItem():Strong("Standards For Mathmatical Practice: "):Text("CCSS.Math.Practice.MP1, CCSS.Math.Practice.MP2, CCSS.Math.Practice.MP5, CCSS.Math.Practice.MP6, CCSS.Math.Practice.MP7, CCSS.Math.Practice.MP8, CCSS.Math.Content.HSF.IF.A.1")
        Subsection("Vocabulary")
        BulletList()
        ListItem("Control Structures")
        ListItem("If statement")
        ListItem("Loops")
        ListItem("Input Manager")
        ListItem("Infrared Sensor")
        ListItem("Remote")
    end

    private action Overview
        Section("Overview")
        Paragraph("In this assignment you will use the "):Code("InfraredSensor"):Text(" Library to control the robot using the remote.")
        Subsection("Goal 1: Creating objects")
        Paragraph("Create a new Robot project. Name it properly and open the main.quorum file. In the top of the file type the appropriate code to use the Quorum "):Code("InfraredSensor"):Text(" and "):Code("Motor"):Text(" libraries inside the "):Code("Lego"):Text(" library.")
        Paragraph():Strong("Activity: Instantiate the "):Code("Motor"):Strong(" and "):Code("InfraredSensor"):Strong(" objects.")
        Paragraph("Call the "):Code("Motor"):Text(" object "):Code("motor"):Text(" and the "):Code("InfraredSensor"):Text(" object "):Code("infraredSensor"):Text(".")
        Paragraph("Now you must set the port to work with. That will be the port that the Infrared Sensor is connected to on the robot. You will do that using the "):Code("SetPort"):Text(" statement.")
        Subsection("Example: Set the port your Infrared Sensor is connected")
        CodeExample("// This line of code will set the port to work with
infraredSensor:SetPort(4) ")
        Paragraph("After that you should set the speed of the motors. This will affect the speed of your robot during turns and while moving straight.")
        Paragraph():Strong("Activity: Write the proper code to set the speed of the motors 'B' and 'C'.")
        Paragraph("Again you should have some lines of code before the conditions:")
        CodeExample("//This first line is just giving a value for the loop to start with but it’s going to change once the loop starts so the value doesn’t matter
integer command = 0
//This line is the looping condition, once the condition doesn’t match anymore the program stops
repeat while true
// This line is giving “command” the value that comes back from the GetRemoteCommand statement, that takes as parameter the channel you’re using in the remote
command = infraredSensor:GetRemoteCommand(1)")
        Subsection("Goal 2: Using conditional and looping statements")
        Paragraph("In this assignment we’re going to use the left part of the remote to control the robot's forward movement (top left button) or backwards movement (bottom left button). The right part of the remote will control if the robot turns right (top right button) or left (bottom right button).")
        Paragraph("Let’s do the conditions now. In this assignment it is clear what the conditions are: when pressed, each button should tell the motors what they should do. The top left button is represented by the number 1, the bottom left is the number 2, the top right the number 3, and the bottom right the number 4.")
    end

    private action ExampleCreateTheConditionInWhichTheTopLeftButton
        Section("Example: Create the condition in which the top left button is pressed")
        CodeExample("//This line creates the condition in which the top left button is pressed
if command = 1
//These lines tell the robot to move forward
motor:RotateBackward(" + dq + "B" + dq + ")
motor:RotateBackward(" + dq + "C" + dq + ")")
        Paragraph():Strong("Activity: Use "):Code("elseif"):Strong(" statements to create the other conditions.")
        Paragraph("Create the other conditions now: "):Code("elseif"):Text(" the command is equal to 2, "):Code("elseif"):Text(" the command is equal to 3, and "):Code("elseif"):Text(" the command is equal to 4. Remember you are making the robot go backwards, turn right, or turn left based on what button is pressed. To finish you will do the last condition: if no buttons are pressed.")
        Subsection("Example: Condition in which no buttons are pressed")
        CodeExample("//This line tells the robot what to do in case none of the above is true
else
motor:Stop(" + dq + "B" + dq + ")
motor:Stop(" + dq + "C" + dq + ")//These lines finish the looping and conditional statements
end
end")
        Paragraph("Congrats! You are finished with this assignment! Run your program and see if you get any errors. If you do, go back and fix them. Make sure your robot is doing what you expect it to. Did you assign everything as you intended to?")
    end
end
