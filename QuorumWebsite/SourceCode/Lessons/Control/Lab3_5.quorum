use Libraries.Web.Page.QuorumPage

/*
    Lab 3.5: Control Quincy: the Quorum Bunny.
    Converted from the old Lesson page by plan 13's generator: the same
    words, now without Tailwind.
*/
class Lab3_5 is QuorumPage
    // A double quote, for code and words that hold one.
    text dq = ""

    on create
        SetLocation("lessons/chapter3/lab3_5.html")
        // The name lists and links use, and the series and track it belongs
        // to: its section and picture.
        SetShortTitle("Lab 3.5")
        SetSectionName("Control Structures")
        // For search engines and link previews, and what lists of pages say.
        SetDescription("Learn about manipulating visual images with the keyboard using the Quorum programming language.")
        SetSummary("how to Control the Quorum Bunny in Quorum.")
    end

    action Setup
        dq = dq:GetDoubleQuote()
        SetWebPageTitle("Lab 3.5: Control the Quorum Bunny - Quorum Programming Language")
        Title("Lab 3.5: Control Quincy: the Quorum Bunny")
        Paragraph("Controlling items on the screen")
        GoalsPart()
        ComputerSciencePrinciplesCurriculum()
        CommonCoreStandards()
        Vocabulary()
        Overview()
        UnderstandingTheInputMonitorAndKeyboardEventLibr()
        Goal1CreatingObjects()
        Goal2UsingConditionalStatements()
    end

    private action GoalsPart
        Section("Goals")
        Paragraph("In this lab, we will learn the following computer science concepts:")
        BulletList()
        ListItem("Creating Objects")
        ListItem("Using conditional statements")
    end

    private action ComputerSciencePrinciplesCurriculum
        Section("Computer Science Principles Curriculum")
        BulletList()
        ListItem():Strong("Big Idea: Algorithms: "):Text("EU 4.1, LO 4.1.1, EK 4.1.1A, EK 4.1.1C, EK 4.1.1D")
    end

    private action CommonCoreStandards
        Section("Common Core Standards")
        BulletList()
        ListItem():Strong("English Language Arts Standards » Science & Technical Subjects: "):Text("CCSS.ELA-Literacy.RST.9-10.2, CCSS.ELA-Literacy.RST.9-10.3, CCSS.ELA-Literacy.RST.9-10.4, CCSS.ELA-Literacy.RST.9-10.5, CCSS.ELA-Literacy.RST.9-10.6, CCSS.ELA-Literacy.RST.11-12.2, CCSS.ELA-Literacy.RST.11-12.3, CCSS.ELA-Literacy.RST.9-10.1, CCSS.ELA-Literacy.RST.9-10.2, CCSS.ELA-Literacy.RST.9-10.7, CCSS.ELA-Literacy.RST.9-10.8, CCSS.ELA-Literacy.RST.9-10.9")
        ListItem():Strong("Standards For Mathmatical Practice: "):Text("CCSS.Math.Practice.MP1, CCSS.Math.Practice.MP2, CCSS.Math.Practice.MP5, CCSS.Math.Practice.MP6, CCSS.Math.Practice.MP7, CCSS.Math.Practice.MP8,")
    end

    private action Vocabulary
        Section("Vocabulary")
        BulletList()
        ListItem("Control Structures")
        ListItem("If Statement")
        ListItem("Looping")
        ListItem("Input Manager")
    end

    private action Overview
        Section("Overview")
        Paragraph("This lab demonstrates how to use key presses on the keyboard to perform some tasks. The task you will perform is to write a program that moves an image of a bunny around the screen upon pressing of the up, down, left, and right arrow keys. Download this "):Link("zip file", "/files/lessons/chapter3/Lab3_5Template.zip"):Text(" for a template to help you get started, or use the IDE below.")
        CodeEditorWithCode("Controlling your Game", "use Libraries.Game.Game
use Libraries.Game.Graphics.Drawable
use Libraries.Game.InputMonitor
use Libraries.Interface.Events.KeyboardEvent
/*
    This is a default class for creating a game in Quorum. Note that the Main 
    action begins by calling StartGame(), which loads a window a game can 
    be displayed in. The action CreateGame is where the game should load any 
    assets, like images to be displayed, frames of animation, or sounds to be
    played. 
*/

class Main is Game
    InputMonitor inputMonitor       // handles user input during game
    KeyboardEvent keys              // helps determine which key is pressed

    Drawable bunny                  // bunny image
    number speed = 100

    /*
        This action, Main, starts our computer program. In Quorum, programs always
        begin from Main.
    */

    action Main
        StartGame()
    end

    /*
        This action sets up the default values for a game. For example, we might
        use the Libraries.Game.Graphics.Drawable class to load up an image or 
        a shape. Or, we might add a Libraries.Interface.Button for making something clickable
        or a Libraries.Interface.TextBox for gathering user input in a game.
    */

    action CreateGame
    end

    /*
        The update action is called on every " + dq + "frame" + dq + " of animation in a game. This
        action should be used to do operations on items. So, for example, we 
        might use this action to change frames of animation, to rotate items, 
        or to make creatures jump.
    */

    action Update(number seconds)
    end
end")
    end

    private action UnderstandingTheInputMonitorAndKeyboardEventLibr
        Section("Understanding the InputMonitor and KeyboardEvent Libraries")
        Paragraph("Open the provided template and navigate to the "):Strong("Main.quorum file"):Text(" . Near the top of the file, there are two lines that look like this:")
        CodeExample("// this line declares an InputMonitor object called " + dq + "inputMonitor" + dq + "
InputMonitor inputMonitor
// this line declares a KeyboardEvent object called " + dq + "keys" + dq + "
KeyboardEvent keys")
        Paragraph("These two lines declare the objects you use to determine if a specific key has been pressed on the keyboard. The "):Code("InputMonitor"):Text(" object knows when a key is pressed down, and the "):Code("KeyboardEvent"):Text(" object knows which key is pressed down. You use these objects to determine when a key is pressed down and which key is pressed down.")
        Paragraph("The "):Code("InputMonitor"):Text(" object has an action called "):Code("IsKeyPressed"):Text(" that takes a "):Code("KeyboardEvent"):Text(" object variable and returns a "):Code("boolean"):Text(" — "):Code("true"):Text(" if the passed key is pressed, "):Code("false"):Text(" if not. You need to pass the "):Code("KeyboardEvent"):Text(" object variable to the "):Code("IsKeyPressed"):Text(" action, telling the "):Code("KeyboardEvent"):Text(" object which key you want to check is pressed. This is done with the following code:")
        Paragraph():Strong("Example: Use the "):Code("InputMonitor"):Strong(" and "):Code("KeyboardEvent"):Strong(" object to execute code when a key is pressed.")
        CodeExample("// This line of code will execute the statement(s) inside the if statement when
// the A key is pressed down.
if inputMonitor:IsKeyPressed(keys:A)
   output " + dq + "The 'A' Key was pressed!" + dq + "
end")
        Paragraph("This line looks a little complicated, so let’s break it down. "):Code("inputMonitor"):Text(" is the name of our "):Code("InputMonitor"):Text(" object. We are calling its "):Code("IsKeyPressed"):Text(" action. Its parameter is a variable that lives in our "):Code("KeyboardEvent"):Text(" object. The variable is the all-caps representation for the key. For example, "):DoubleQuote():Text("A"):DoubleQuote():Text(" represents the A key, "):DoubleQuote():Text("NUM_7"):DoubleQuote():Text(" represents the 7 key, and "):DoubleQuote():Text("F2"):DoubleQuote():Text(" represents the F2 key. This action returns a "):Code("boolean"):Text(" which we can use with an "):Code("if"):Text(" statement to execute code only when that action returns "):Code("true"):Text("—i.e., when the key in question is pressed down.")
    end

    private action Goal1CreatingObjects
        Section("Goal 1: Creating Objects")
        Paragraph("Navigate to the action called "):Code("CreateGame"):Text(" on line 36 through line 37. This is where you load the images for your "):Code("Drawable"):Text(" objects. An "):Code("Drawable"):Text(" object has already been declared for you, called "):Code("bunny"):Text(". Load the image called "):DoubleQuote():Text("media/bunny.png"):DoubleQuote():Text(" to the"):Code("Drawable"):Text(" object.")
        Paragraph():Strong("Activity: Load an image to your "):Code("Drawable"):Strong(" object and add it to the screen.")
        Paragraph("Recall that to load an image to a "):Code("Drawable"):Text(" object, we call the "):Code("Load"):Text(" action, passing the file name of the file we want to load. Once you have your "):Code("Drawable"):Text(" loaded, you should add it to the game. This is done by calling the "):Code("Add"):Text(" action with your "):Code("Drawable"):Text(" as the parameter. Now that you have your "):Code("Drawable"):Text(" loaded and added to the game, you can begin writing the code to move the image around the screen upon key presses.")
        Paragraph("Navigate to the action called "):Code("Update(number seconds)"):Text(" on line 46 through line 47. This action is called on every frame of your game. This is where you write your code to handle the key presses. This action should check whether some keys are pressed down and, if they are, begin the appropriate task for those keys.")
    end

    private action Goal2UsingConditionalStatements
        Section("Goal 2: Using Conditional Statements")
        Paragraph("The bunny should move vertically upon pressing of the up or down arrow keys. You need to check whether the up and down arrow keys are pressed. The names of the variables in "):Code("KeyboardEvent"):Text(" objects that represent the up and down arrow keys are "):Code("UP"):Text(" and "):Code("DOWN"):Text(", respectively.")
        Paragraph("If the up arrow key is pressed, the bunny should move up the screen. To do this, you need to get the current y-coordinate of the "):Code("Drawable"):Text(" object by calling the "):Code("GetY"):Text(" action. The new y-coordinate should be set to the current y-coordinate plus the speed of the "):Code("Drawable"):Text(" (declared and set earlier in the program) multiplied by the time between frames (the parameter of the "):Code("Update(number seconds)"):Text(" action in which you are currently writing your code).")
        Subsection("Example: Write the code that moves the bunny up when the Up key is pressed.")
        CodeExample("// this if statement checks when the Up key is pressed
if inputMonitor:IsKeyPressed(keys:UP)
   // this line of code gets the current y position of the bunny
   number y = bunny:GetY()
   // this line calculates the new y position based on the current y
   number newY = y + speed * seconds
   // this line sets the new y position
   bunny:SetY(newY)
end")
        Paragraph("If the down arrow key is pressed, the bunny should move down the screen. To do this, you need to get the current y-coordinate of the "):Code("Drawable"):Text(" object by calling the "):Code("GetY"):Text(" action. The new y-coordinate should be set to the current y-coordinate minus the speed multiplied by the seconds.")
        Paragraph():Strong("Activity: Write the code to move the bunny down the screen if the "):Code("DOWN"):Strong(" key is pressed.")
        Paragraph("The bunny should move horizontally upon pressing the right or left arrow keys. You need to check whether the left or right arrow keys are pressed. The names of the variables in "):Code("KeyboardEvent"):Text(" objects that represent the left and right arrow keys are "):Code("LEFT"):Text(" and "):Code("RIGHT"):Text(", respectively.")
        Paragraph("If the left arrow key is pressed, the bunny should move left across the screen. To do this, you need to get the current x-coordinate of the "):Code("Drawable"):Text(" object by calling the "):Code("GetX"):Text(" action. The new x-coordinate should be set to the current x-coordinate minus the speed of the "):Code("Drawable"):Text(" (declared and set earlier in the program) multiplied by the seconds between frames (the parameter of the "):Code("Update(number seconds)"):Text(" action in which you are currently writing your code).")
        Subsection("Example: Write the code to move the bunny towards the left when the Left key is pressed.")
        CodeExample("// this if statement checks when the Left key is pressed
if inputMonitor:IsKeyPressed(keys:LEFT)
   // this line gets the current x position
   number x = bunny:GetX()
  // this line calculates the new x position based on the current x
   number newX = x – speed * seconds
  // this line sets the new x position
   bunny:SetX(newX)
end")
        Paragraph("If the right arrow key is pressed, the bunny should move right across the screen. To do this, you need to get the current x-coordinate of the "):Code("Drawable"):Text(" object by calling the "):Code("GetX"):Text(" action. The new x-coordinate should be set to the current x-coordinate plus the speed multiplied by the seconds.")
        Paragraph():Strong("Activity: Write the code to move the bunny towards the right when the "):Code("RIGHT"):Strong(" key is pressed.")
        Paragraph("You may now compile and run your code. There should be no errors. If there are errors, fix them and try again. You should be able to move the bunny horizontally and vertically around the screen by pressing the appropriate keys.")
        Paragraph():Strong("Bonus Activity! Try experimenting with different keys and moving the bunny in different directions. You might try using the "):Code("W"):Strong(", "):Code("D"):Strong(", "):Code("A"):Strong(", and "):Code("S"):Strong(" buttons. If you ever intend to make an MMORPG you'll need to start here!")
    end
end
