use Libraries.Web.Page.QuorumPage

/*
    Challenge 3.3: Trivia Challenge - Visual.
    Converted from the old Lesson page by plan 13's generator: the same
    words, now without Tailwind.
*/
class Challenge3_3 is QuorumPage
    // A double quote, for code and words that hold one.
    text dq = ""

    on create
        SetLocation("lessons/chapter3/challenge3_3.html")
        // The name lists and links use, and the series and track it belongs
        // to: its section and picture.
        SetShortTitle("Challenge 3.3")
        SetSectionName("Control Structures")
        // For search engines and link previews, and what lists of pages say.
        SetDescription("Learn about control structures and reading files by coding a visual trivia game in the Quorum programming language.")
        SetSummary("how work Trivia Challenge - Visual in Quorum.")
    end

    action Setup
        dq = dq:GetDoubleQuote()
        SetWebPageTitle("Challenge 3.3: Trivia Challenge - Visual - Quorum Programming Language")
        Title("Challenge 3.3: Trivia Challenge - Visual")
        GoalsPart()
        ComputerSciencePrinciplesCurriculum()
        CommonCoreStandards()
        Vocabulary()
        Overview()
        Goal1ReadingFiles()
        Goal2UsingControlStructures()
        GetTheUserSInputFromTheTextBoxWhenTheEnterKeyIsP()
    end

    private action GoalsPart
        Section("Goals")
        Paragraph("In this assignment, you will practice the following computer science concepts:")
        BulletList()
        ListItem("Reading Files")
        ListItem("Using Control Structures")
    end

    private action ComputerSciencePrinciplesCurriculum
        Section("Computer Science Principles Curriculum")
        BulletList()
        ListItem():Strong("Big Idea: Creativity: "):Text("EU 1.1, LO 1.1.1, EK 1.1.1A, EU 1.2, LO 1.2.1, EK 1.2.1E")
        ListItem():Strong("Big Idea: Programming: "):Text("EU 5.3, LO 5.3.1, EK 5.3.1I, EU 5.5, LO 5.5.1, EK 5.5.1H, EK 5.5.1I, EK 5.5.1J")
    end

    private action CommonCoreStandards
        Section("Common Core Standards")
        BulletList()
        ListItem():Strong("English Language Arts Standards » Science & Technical Subjects: "):Text("CCSS.ELA-Literacy.RST.9-10.3, CCSS.ELA-Literacy.RST.9-10.4, CCSS.ELA-Literacy.RST.9-10.5, CCSS.ELA-Literacy.RST.9-10.7, CCSS.ELA-Literacy.RST.9-10.10, CCSS.ELA-Literacy.RST.11-12.2, CCSS.ELA-Literacy.RST.11-12.3, CCSS.ELA-Literacy.RST.11-12.4, CCSS.ELA-Literacy.RST.11-12.5, CCSS.ELA-Literacy.RST.11-12.10")
        ListItem():Strong("Standards For Mathmatical Practice: "):Text("CCSS.Math.Practice.MP1, CCSS.Math.Practice.MP2, CCSS.Math.Practice.MP4, CCSS.Math.Practice.MP5, CCSS.Math.Practice.MP6, CCSS.Math.Practice.MP7, CCSS.Math.Practice.MP8")
    end

    private action Vocabulary
        Section("Vocabulary")
        BulletList()
        ListItem("Array")
        ListItem("Control Structures")
        ListItem("File Reader")
    end

    private action Overview
        Section("Overview")
        Paragraph("In this assignment, you will create a trivia game. This assignment allows you to create your own questions and answers for the game. Download this "):Link("zip file", "/files/lessons/chapter3/Challenge3_3Template.zip"):Text(" for a template to help you get started. Open the provided project template and navigate to the "):Strong("main.quorum"):Text(" file.")
        Paragraph("This assignment stores the questions and answers for your game in separate "):Strong(dq + ".txt" + dq):Text(" files. This allows you to update or change your questions/answers without having to modify your program code. Create two "):Strong(dq + ".txt" + dq):Text(" files, one for the questions and one for the answers. Come up with the questions and answers for your game and put them in the appropriate files, one question or answer per line.")
        Subsection("Understanding FileReaders")
        Paragraph("Because your questions and answers are stored in separate "):Strong(dq + ".txt" + dq):Text(" files, your program needs to read those files in order to access your questions. To do this, you need to use the "):Code("FileReader"):Text(" object from the "):Code("Libraries.System.FileReader"):Text(" library. The "):Code("FileReader"):Text(" object reads a Quorum "):Code("File"):Text(" object sequentially starting from the beginning of the file. To store the questions and answers during the program you use an object known in Quorum as an "):Code("Array"):Text(". An "):Code("Array"):Text(" is simply a container that stores items in a contiguous block of memory. To use the "):Code("Array"):Text(" object, you need to include the "):Code("Libraries.Containers.Array"):Text(" library.")
        Paragraph("In order to use "):Code("FileReader"):Text(" objects, you first need to declare both "):Code("File"):Text(" and "):Code("FileReader"):Text(" objects. Do this below the other declarations but above the line that starts with "):Code("action CreateGame"):Text(". Since you have 2 files, one for questions and one for answers, you need two "):Code("File"):Text(" objects, one that represents the "):Strong(dq + "questions.txt" + dq):Text(" file and another that represents the "):Strong(dq + "answers.txt" + dq):Text(" file. You also need two "):Code("FileReader"):Text(" objects, one to read the "):Strong(dq + "questions.txt" + dq):Text(" file and another to read the "):Strong(dq + "answers.txt" + dq):Text(" file.")
        Paragraph():Strong("Example: Declare "):Code("File"):Strong(" and "):Code("FileReader"):Strong(" objects to store the questions.")
        CodeExample("// this line declares a file object called questionsFile
File questionsFile

// this line declares fileReader object called questionsReader
FileReader questionReader")
        Paragraph():Strong("Activity: Declare "):Code("File"):Strong(" and "):Code("FileReader"):Strong(" objects to store answers."):NewLine():Text("Declare the needed objects.")
        Paragraph("You also need to set the paths of the "):Code("File"):Text(" objects to your questions and answers files. Also do this in "):Code("action CreateGame"):Text(", below the existing code, but above the line that starts with "):Code("end"):Text(".")
        Paragraph():Strong("Example: Set the path for the question file. Use the "):Code("SetPath"):Strong(" action on the questionFile object.")
        CodeExample("questionsFile:SetPath(" + dq + "questions.txt" + dq + ")")
        Paragraph():Strong("Activity: Set the path for the answers file."):NewLine()
        Paragraph("Your program needs a place to store the questions and answers read from the files. To do this, we can use arrays. Navigate back up to where you placed your declarations for the "):Code("File"):Text(" and "):Code("FileReader"):Text(" objects. You will place the declarations for the Arrays below these declarations.")
        Paragraph():Strong("Example: Declare an "):Code("Array"):Strong(" object to store the questions.")
        CodeExample("// this line declares an array called questions. The <text> part tells the Array
// that it will store text
Array<text> questions")
        Paragraph():Strong("Activity: Declare an "):Code("Array"):Strong(" object to store the answer text."):NewLine():Text("Declare the needed object.")
    end

    private action Goal1ReadingFiles
        Section("Goal 1: Reading Files")
        Paragraph("To get your questions and answers from their files into your program, you need to tell your program to read the files. In order to read a file, it must first be opened. In Quorum, you must also tell files what they are being opened for (reading, writing, reading and writing). Since we are going to be reading our file once it has been opened, we use the "):Code("OpenForRead"):Text(" action on our "):Code("FileReader"):Text(" objects. This action takes a single parameter that represents the "):Code("File"):Text(" object we want to open for read. Call these actions in the "):Code("action CreateGame"):Text(" action, below the code you wrote to set the paths of the "):Code("File"):Text(" objects.")
        Paragraph():Strong("Example: Open question file to be read.")
        CodeExample("    questionsReader:OpenForRead(questionsFile)")
        Paragraph():Strong("Activity: Open the answers file to be read.")
        Paragraph("Now, your file is open and ready to read. We will read our files in the "):Code("action CreateGame"):Text(" action, below the code that opened the files for reading. There are many options for actions to read your file. The "):Code("Read"):Text(" action reads and returns the entire contents of the file. The "):Code("ReadLine"):Text(" action reads and returns a single line from the file. The "):Code("ReadLines"):Text(" action reads and returns all the remaining lines of the file starting from the current position. You can know if you have read the entire file or not by calling the "):Code("IsAtEndOfFile"):Text(" action. This action returns "):Code("true"):Text(" if the end of the file has been reached and "):Code("false"):Text(" otherwise.")
        Paragraph():Strong("Example: Use the "):Code("questionsReader"):Strong(" object to read the questions file one line at a time into the questions array until the end of the file has been reached.")
        CodeExample("// This line initially reads the file. This is needed before calling the 
// IsAtEndOfFile action
text question = questionsReader:ReadLine()

// this line adds the question we just read into the questions Array
questions:Add(question)

// this repeat statement reads the rest of the file until the end of the file is
// reached
repeat until questionsReader:IsAtEndOfFile()

   // this line reads in another line from the file
   question = questionsReader:ReadLine()

   // this line adds the question we just read into the questions Array
   questions:Add(question)
end")
        Paragraph():Strong("Example: Use the "):Code("questionsReader"):Strong(" object to read the questions file one line at a time into the questions array until the end of the file has been reached."):NewLine():Text("The answers file is read in the exact same way.")
        Paragraph("Once you have read the contents of your questions and answers files into their respective arrays, you are done with those files and "):Code("FileReader"):Text(" objects. In Quorum, once you are done using a file that you have opened in your program, you need to tell Quorum that you are done with it and that it is okay to close the file. You can do this by calling the "):Code("Close"):Text(" action on your "):Code("FileReader"):Text(" objects. Write this code after the code you have just completed.")
        Paragraph():Strong("Example: Close the questions file.")
        CodeExample("    questionsReader:Close()")
        Paragraph():Strong("Activity: Close the answers file")
    end

    private action Goal2UsingControlStructures
        Section("Goal 2: Using Control Structures")
        Paragraph("Once the program has read all of the questions and answers, it should start the game. Your program should output all of the questions and ask the user for answers. The user input is captured with a "):Code("TextBox"):Text(". The user input should be checked against the answer, and if the answer is correct, a message should be displayed. If the answer is not correct, a different message should be displayed. For the convenience of whoever is playing your game, you may want to ignore any whitespace before and after their answer. Calling the "):Code("Trim"):Text(" action on the text they inputted will accomplish this.")
        Paragraph("To accomplish this, we will write code in two places. The first place is in our game's "):Code("action Update(number seconds)"):Text(" action, where we will display the question for the user to answer if the game is not over, and if the game is over, we will display a message telling them how many questions they got right out of the total number of questions. The second place we will write code is in the action labeled "):Code("action PressedKey"):Text(" where we will write code to get the user's input guess and check it against the correct answer, displaying a message to the user telling them if they were right or wrong.")
        Subsection("Use control structures to ask questions, or display a message when the game is over.")
        CodeExample("action Update(number seconds)
   // This statement checks if it is time to get a new question for the 
   // user, or if the game is over
   if nextQuestion and not gameOver
       //If the game is not over, the text of the label  used to display
       //the question is set to the next question
       label:SetText(questions:Get(index))

       // once a new question is displayed, a new question will not be
       // ready until the question is answered
       nextQuestion = false
   end

   if gameOver
       // if the game is over, display the game over message, telling
       // the user how many questions they got right
       label:SetText(" + dq + "Game Over! You got " + dq + " + correctGuesses + " + dq + "/" + dq + " + questions:GetSize() + " + dq + " questions correct!" + dq + ")
   end
end")
        Paragraph("Our game is declared as a "):Code("KeyboardListener"):Text(", which means that the Quorum Game Engine will tell our game any time a key is pressed on the keyboard. When keys are pressed on the keyboard, if they are letters, numbers, or symbols, they will appear in the text box. We can tell our program what to do when a key is pressed by writing code in the action labeled "):Code("action PressedKey(KeyboardEvent event)"):Text(". If the user hits the enter key, we will then capture whatever is currently in the text box as their guess. That guess can then be checked against the correct answer to determine if the user is right or wrong. It is important to note that there is currently no way to clear text from a TextBox object, so users playing the game will have to backspace over any previously entered input.")
    end

    private action GetTheUserSInputFromTheTextBoxWhenTheEnterKeyIsP
        Section("Get the user's input from the TextBox when the enter key is pressed and check the guess against the correct answer.")
        CodeExample("//This line checks if the key being pressed is the enter key.
//If it is, then the input in the textbox is captured. If it is not, then the
//event is ignored
if event:keyCode = event:ENTER and index not= answers:GetSize()
   //This line gets whatever text is in the textbox and stores it as the variable guess
   text guess = box:GetInput()

   //This line removes whitespace from the user's guess.
   guess = guess:Trim()

   //This if statement checks the user's input against the answer to the
   //question. The EqualsIgnoringCase action will return true if the user's
   //guess is the same as the answer ignoring upper/lowercase.
   if guess:EqualsIgnoringCase(answers:Get(index))
       //If the guess was correct, increment the correctGuesses counter.
       correctGuesses = correctGuesses + 1

       //Show the correct message.
       correct:Show()
   else
       //If the guess was not correct, then show the incorrect message.
       incorrect:Show()
   end

   //This line allows the next question and answer to be accessed.
   index = index + 1

   //This line checks if there is another question avaliable to ask.
   //If there is not, then the game is over.
   if index < questions:GetSize()
       nextQuestion = true
   else
       gameOver = true
   end
end")
        Paragraph("You can now compile and run your game. If there are any errors, fix them and try again. Each question should appear on the screen. The player may enter text into the text box, pressing enter when he/she is done guessing. A message should display that tells the user if they were correct or incorrect.")
    end
end
