    private action Vocabulary
        Section("Vocabulary")
        BulletList()
        ListItem("Control Structures")
        ListItem("If statement")
        ListItem("Loops")
        ListItem("Input Manager")
    end

    private action Overview
        Section("Overview")
        Paragraph("This lab demonstrates how to use key presses on the keyboard to perform some tasks. The task you will perform is to write a program that changes the balance of a sound file from left to right or right to left upon pressing of the left and right arrow keys. The program will also increase the volume upon pressing of the up arrow key and decrease the volume upon pressing the down arrow key. Download this "):Link("zip file", "/files/lessons/chapter3/Lab3_4Template.zip"):Text(" for a template to help you get started.")
        CodeEditorWithCode("Controlling Audio", "use Libraries.Game.Game
use Libraries.Game.InputMonitor
use Libraries.Sound.Audio
use Libraries.Interface.Events.KeyboardEvent

/*
    This is a default class for creating a game in Quorum. Note that the Main 
    action begins by calling StartGame(), which loads a window a game can 
    be displayed in. The action CreateGame is where the game should load any 
    assets, like images to be displayed, frames of animation, or sounds to be
    played. 
*/

class Main is Game
    InputMonitor inputMonitor       // handles user input during program
    KeyboardEvent keys              // determines which key is pressed

    Audio song                      // song to play during program

    /*
        This action, Main, starts our computer program. In Quorum, programs always
        begin from Main.
    */

    action Main
        StartGame()
    end

    /*
        This action sets up the default values for a game. For example, we might
        use the Libraries.Game.Graphics.Drawable class to load up an image or 
        a shape. Or, we might add a Libraries.Interface.Button for making something clickable
        or a Libraries.Interface.TextBox for gathering user input in a game.
    */

    action CreateGame
    end

    /*
        The update action is called on every " + dq + "frame" + dq + " of animation in a game. This
        action should be used to do operations on items. So, for example, we 
        might use this action to change frames of animation, to rotate items, 
        or to make creatures jump.
    */

    action Update(number seconds)
    end
end")
    end

    private action UnderstandingTheInputMonitorAndKeyboardEventLibr
        Section("Understanding the InputMonitor and KeyboardEvent Libraries")
        Paragraph("Open the provided template and navigate to the "):Strong("main.quorum file"):Text(" . Near the top of the file, there are two lines that look like this on lines 15 and 16:")
    end

    private action Goal1CreatingObjects
        Section("Goal 1: Creating Objects")
        CodeExample("//This line declares an InputMonitor object called " + dq + "inputMonitor" + dq + "
InputMonitor inputMonitor")
        Paragraph("Line 16 declares one of the objects you use to determine if a specific key has been pressed on the keyboard. The "):Code("InputMonitor"):Text(" object can tell you when a key is pressed down, and the "):Code("KeyboardEvent"):Text(" object, which you will add in the first activity, can let you know which key is pressed down. You use these objects to determine when a key is pressed down and which key is pressed down.")
        Paragraph():Strong("Activity: Declare the "):Code("KeyboardEvent"):Strong(" object. Call it "):Code("keys"):Strong("."):NewLine():Text("Add this new line of code below the "):Code("InputMonitor"):Text(".")
        Paragraph("The "):Code("InputMonitor"):Text(" object has an action called "):Code("IsKeyPressed"):Text(" that takes a "):Code("KeyboardEvent"):Text(" object variable and returns a "):Code("boolean"):Text(" — "):Code("true"):Text(" if the passed key is pressed, "):Code("false"):Text(" if not. You need to pass the "):Code("KeyboardEvent"):Text(" object variable to the "):Code("IsKeyPressed"):Text(" action, telling the "):Code("KeyboardEvent"):Text(" object which key you want to check is pressed.")
        Paragraph():Strong("Activity: Declare the "):Code("Audio"):Strong(" object. Call it "):Code("song"):Strong("."):NewLine():Text("Add this new line of code below the "):Code("KeyboardEvent"):Text(".")
        Paragraph("Navigate to the action called "):Code("CreateGame"):Text(" on line 36 through line 37. This is where you load the song for your "):Code("Audio"):Text(" object. Recall that to load an audio file to an "):Code("Audio"):Text(" object, we call the "):Code("Load"):Text(" action, passing the file name of the file we want to load.")
        CodeExample("//This line will load the song to the audio object
song:Load(" + dq + "media/music.wav" + dq + ")")
        Paragraph():Strong("Activity: "):Code("EnableLooping"):Strong(", and "):Code("Play"):Strong(" your song."):NewLine():Text("Once you have your "):Code("Audio"):Text(" loaded, you should enable looping so that it can play over and over during your program. This is done by calling the "):Code("EnableLooping"):Text(" action on your "):Code("Audio"):Text(" object. Finally, you want to play your "):Code("Audio"):Text(" object. Recall that this is done by calling the "):Code("Play"):Text(" action on the "):Code("Audio"):Text(" object. Now that you have your "):Code("Audio"):Text(" loaded and set up, you can begin writing the code to change the volume and balance upon key presses.")
    end

    private action Goal2UsingConditionalStatements
        Section("Goal 2: Using Conditional Statements")
        Paragraph("Navigate to the action called "):Strong("Update(number seconds)"):Text(" around line 49. This action is called on every frame of your game. This is where you write your code to handle the key presses. This action should check whether some keys are pressed down and, if they are, begin the appropriate task for those keys.")
        Paragraph("The volume should be changed upon pressing of the up or down arrow keys. You need to check whether the up and down arrow keys are pressed. The names of the variables in "):Code("KeyboardEvent"):Text(" objects that represent the up and down arrow keys are "):Code("UP"):Text(" and "):Code("DOWN"):Text(", respectively.")
        Paragraph("If the up arrow key is pressed, the volume should be increased. To do this, you need to get the current volume of the "):Code("Audio"):Text(" object by calling the "):Code("GetVolume"):Text(" action. The new volume should be set to the current volume plus some increment value. The "):Code("SetVolume"):Text(" action takes one "):Code("number"):Text(" parameter that represents the percentage of the volume to play. A "):Code("number"):Text(" of 1 means to play the song at 100% of its normal volume. A "):Code("number"):Text(" of 0.8 means to play the song at 80% of its normal volume. A "):Code("number"):Text(" of 0.5 means to play the song at 50% of its normal volume, and so on.")
        Paragraph("Choose a good increment value for the volume to use when the up key is pressed down. A good one is to increase the volume by 10% with each key press.")
        Subsection("Example: Write the code that increases the volume when the Up key is pressed.")
        CodeExample("//This if statement checks when the Up key is pressed
if inputMonitor:IsKeyPressed(keys:UP)
   //This line gets the current volume of the audio
   number currentVolume = song:GetVolume()
   //This line uses the current volume and adds an increment value to it
   number newVolume = currentVolume + 0.1
   //This line sets the new volume
   song:SetVolume(newVolume)
end")
        Paragraph():Strong("Activity: Lower the volume of the song."):NewLine():Text("If the down arrow key is pressed, the volume should be decreased. To do this, you need to get the current volume of the "):Code("Audio"):Text(" object by calling the "):Code("GetVolume"):Text(" action. The new volume should be set to the current volume minus some decrement value. Choose a good decrement value for the volume to use when the down key is pressed down. A good one is to decrease the volume by 10% with each key press. Write the code to do this.")
        Paragraph("The balance should be changed upon pressing the right or left arrow keys. You need to check whether the left or right arrow keys are pressed. The names of the variables in "):Code("KeyboardEvent"):Text(" objects that represent the left and right arrow keys are "):Code("LEFT"):Text(" and "):Code("RIGHT"):Text(", respectively.")
        Paragraph("If the left arrow key is pressed, the balance should move towards the left ear. To do this, you need to get the current balance of the "):Code("Audio"):Text(" object by calling the "):Code("GetBalance"):Text(" action. The new balance should be set to the current balance minus some decrement value. The "):Code("SetBalance"):Text(" action takes one "):Code("number"):Text(" parameter between -1 and 1 that represents the audio balance. A "):Code("number"):Text(" of -1 means to play the audio fully in the left ear. A "):Code("number"):Text(" of 1 means to play the audio fully in the right ear. A "):Code("number"):Text(" of 0 means to play the audio equally in both ears, and so on.")
        Paragraph("Choose a good decrement value for the balance to use when the left key is pressed down. A good one is to decrease the balance by 0.1 with each key press.")
        Subsection("Example: Write the code to move the balance towards the left when the Left key is pressed.")
        CodeExample("//This line checks for the left key being pressed
if inputMonitor:IsKeyPressed(keys:LEFT)
   //This line get the current balance of the audio
   number currentBalance = song:GetBalance()
  //This line uses the current balance and subtracts a decrement value
   number newBalance = currentBalance - 0.1
  //This line sets the new balance
   song:SetBalance(newBalance)
end")
        Paragraph():Strong("Activity: Change the balance towards the right ear."):NewLine():Text("If the right arrow key is pressed, the balance should move towards the right ear. To do this, you need to get the current balance of the "):Code("Audio"):Text(" object by calling the "):Code("GetBalance"):Text(" action. The new balance should be set to the current balance plus some increment value. Choose a good increment value for the balance to use when the right arrow key is pressed down. A good one is to increase the balance by 0.1 with each key press.")
        Paragraph("You may now compile and run your code. There should be no errors. If there are errors, fix them and try again. You should be able to change the volume and balance by pressing the appropriate keys.")
    end

    private action Resources
        Section("Resources")
        Paragraph("The music used for this lab is Beachfront Celebration by Kevin MacLeod (incompetech.com). Licensed under Creative Commons: By Attribution 3.0 License.")
    end
end
