use Libraries.Web.Page.QuorumPage

/*
    Assignment 3.4: Key Press Madness - Visual.
    Converted from the old Lesson page by plan 13's generator: the same
    words, now without Tailwind.
*/
class Assignment3_4 is QuorumPage
    // A double quote, for code and words that hold one.
    text dq = ""

    on create
        SetLocation("lessons/chapter3/assignment3_4.html")
        // The name lists and links use, and the series and track it belongs
        // to: its section and picture.
        SetShortTitle("Assignment 3.4")
        SetSectionName("Control Structures")
        // For search engines and link previews, and what lists of pages say.
        SetDescription("Learn to code 2D image applications and keyboard listeners with the Quorum programming language.")
        SetSummary("how work Key Press Madness - Visual in Quorum.")
    end

    action Setup
        dq = dq:GetDoubleQuote()
        SetWebPageTitle("Assignment 3.4: Key Press Madness - Visual - Quorum Programming Language")
        Title("Assignment 3.4: Key Press Madness - Visual")
        Paragraph("A visual approach to the keyboard")
        GoalsPart()
        ComputerSciencePrinciplesCurriculum()
        CommonCoreStandards()
        Vocabulary()
        Overview()
        Goal1UsingConditionalStatements()
        ActivityAddThreeMoreConditions()
        SampleOutput()
    end

    private action GoalsPart
        Section("Goals")
        Paragraph("In this assignment, we will practice the following computer science concepts")
        BulletList()
        ListItem("Using conditional statements")
        ListItem("Managing User Input")
    end

    private action ComputerSciencePrinciplesCurriculum
        Section("Computer Science Principles Curriculum")
        BulletList()
        ListItem():Strong("Big Idea: Creativity: "):Text("EU 1.3, LO 1.3.1, EK 1.3.1D")
        ListItem():Strong("Big Idea: Programming: "):Text("EU 5.1, LO 5.1.2, EK 5.1.2A, EK 5.1.2B, EU 5.5, LO 5.5.1, EK 5.5.1E, EK 5.5.1F, EK 5.5.1G")
    end

    private action CommonCoreStandards
        Section("Common Core Standards")
        BulletList()
        ListItem():Strong("English Language Arts Standards » Science & Technical Subjects: "):Text("CCSS.ELA-Literacy.RST.9-10.3, CCSS.ELA-Literacy.RST.9-10.4, CCSS.ELA-Literacy.RST.9-10.5, CCSS.ELA-Literacy.RST.9-10.7, CCSS.ELA-Literacy.RST.9-10.10, CCSS.ELA-Literacy.RST.11-12.2, CCSS.ELA-Literacy.RST.11-12.3, CCSS.ELA-Literacy.RST.11-12.4, CCSS.ELA-Literacy.RST.11-12.5, CCSS.ELA-Literacy.RST.11-12.10")
        ListItem():Strong("Standards For Mathmatical Practice: "):Text("CCSS.Math.Practice.MP1, CCSS.Math.Practice.MP2, CCSS.Math.Practice.MP4, CCSS.Math.Practice.MP5, CCSS.Math.Practice.MP6, CCSS.Math.Practice.MP7, CCSS.Math.Practice.MP8")
    end

    private action Vocabulary
        Section("Vocabulary")
        BulletList()
        ListItem("Actions")
        ListItem("Class")
        ListItem("Conditional")
        ListItem("Image Sheet")
    end

    private action Overview
        Section("Overview")
        Paragraph("This lab demonstrates how to map certain animations to keys on the keyboard to play when that key is pressed. The Quorum "):Code("Game"):Text(" library will be used, along with the "):Code("InputMonitor"):Text(" and "):Code("KeyboardEvent"):Text(" libraries to handle keyboard input during the program. You will write a program that will play certain animations upon a key being pressed. Download "):Link("Assignment3_4Template", "/files/lessons/chapter3/Assignment3_4Template.zip"):Text(" for a template to help you get started.")
    end

    private action Goal1UsingConditionalStatements
        Section("Goal 1: Using Conditional Statements")
        Paragraph("Open the provided template. In the "):Strong("main.quorum"):Text(" file, code needs to be written in two places. The first place is in an action called "):Code("CreateGame"):Text(". In this action, you set up your "):Code("Sprite"):Text(" object. The second place you write code is in the action called "):Code("Update(number seconds)"):Text(". In this action, you write the code that plays the animations when keys are pressed. You can easily jump between Actions by using the Navigator window. The key command for the Navigator window is Ctrl+7. A Sprite object has already been declared for you. A file, or class, called "):Strong("Sprite.quorum"):Text(" has been provided to you that includes code that implements the animations. You can look through this file to see what animations are supported, and how they work. The sprite can:")
        BulletList()
        ListItem():Code("Punch")
        ListItem():Code("Crouch")
        ListItem():Code("Jump")
        ListItem():Code("JumpAndPunch")
        ListItem():Code("ShootPlasma")
        ListItem():Code("Walk")
        ListItem():Code("SpecialMove")
        ListItem():Code("DoNothing")
        Paragraph("Navigate to the "):Code("CreateGame"):Text(" action. In this action, we prepare the Sprite to be animated by the game. First, tell the Sprite object which ImageSheet to get animation images from. Do this by calling the "):Code("SetImageSheet(text sheetName)"):Text(" action on the Sprite. The "):Code("SetImageSheet"):Text(" action takes a text parameter that represents the name of the ImageSheet. An ImageSheet has already been provided for in the template, located in the resources folder. Once we have told our Sprite where to get its animation images, we setup the Sprite by calling the "):Code("SetUp"):Text(" action on the Sprite. This action sets the Sprite to its default pose. Next, "):Code("Add"):Text(" the Sprite to the game. You can look back in previous lesson to remember how to add an object.")
        Paragraph("Choose the three keys you want to play animations when pressed, and choose which animations to play when that key is pressed. You will write a conditional statement in the "):Code("Update(number seconds)"):Text(" action to check for these keys being pressed. If they are, play the animation for that key.")
        Subsection("Example: Jump when a key is pressed.")
        CodeExample("// this line checks if the " + dq + "A" + dq + " key is pressed.
if inputMonitor:IsKeyPressed(keys:A)
   // this line makes the sprite jump when we press the A key
   fighter:Jump()
end")
    end

    private action ActivityAddThreeMoreConditions
        Section("Activity: Add three more conditions.")
        Paragraph("Because the Sprite can only do one animation at a time, it makes sense to use the "):Code("if... elseif"):Text(" structure in this situation. This ensures that only one animation will play. Add the conditions for two more keys, and the condition for when no keys are pressed. If no keys are pressed, the Sprite's idle animation should play, by calling the "):Code("DoNothing"):Text(" action.")
        Paragraph("When you run your program and press those keys, the animations you associated with those keys will play. You can keep a key pressed down to play a animation for a longer period of time or just tap the key to play the animation for a short period of time.")
        Paragraph("To expand your game, choose more keys to associate animations with, check for those keys being pressed, and play more animations!")
    end

    private action SampleOutput
        Section("Sample Output")
        Paragraph("The program should play at least 3 different animations upon three different key presses. The Sprite should display its idle animation when no keys are pressed down.")
    end
end
