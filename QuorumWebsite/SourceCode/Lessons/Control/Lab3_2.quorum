    private action Vocabulary
        Section("Vocabulary")
        BulletList()
        ListItem("Loops")
        ListItem("Repeat times")
        ListItem("Repeat while")
        ListItem("Repeat until")
        ListItem("Random")
    end

    private action Overview
        Section("Overview")
        Paragraph("In this lab, we will learn about using loops in Quorum.")
    end

    private action Goal1UnderstandingTheTypesOfRepeatStatement
        Section("Goal 1: Understanding the types of repeat statement")
        Paragraph("The concept of repetition, where we do the same thing over and over again, is common in computer programming. Robots in the real world, for example, might do the same thing repeatedly in order to allow humans not to. Programs as well, might use repetition to do things like long searches, like looking for a phone number in a list. In this first goal, we will use the 'repeat' statement to do this.")
        Paragraph("In order to use loops you must use the "):Code("repeat"):Text(" statement. There are 3 types of the repeat statement: "):Code("repeat times"):Text(", "):Code("repeat while"):Text(" and "):Code("repeat until"):Text(".")
        Paragraph("The "):Code("repeat times"):Text(" statement you will use to perform a task a certain number of times.")
        Subsection("Example: Write " + dq + "Hello!" + dq + " 5 times.")
        CodeExample("repeat 5 times
     output " + dq + "Hello!" + dq + "
end")
        Paragraph("You should see in your output window exactly 5 "):DoubleQuote():Text("Hello!"):DoubleQuote():Text(".")
        CodeEditorWithCode("Activity: Write a phrase 10 times.", "//You can choose the phrase that you want for this particular activity.")
        Paragraph("The "):Code("repeat while"):Text(" loop works differently than the "):Code("repeat times"):Text(" loop. The "):Code("repeat while"):Text(" loop works like an if statement, but at the "):Code("end"):Text(" keyword, Quorum evaluates and determines if the loop should go again.")
        Paragraph():Strong("Example: Use "):Code("repeat while"):Strong(" to check how many apps for your phone you can buy.")
        CodeExample("text balanceInput  = input(" + dq + "How much money do you have in your account?" + dq + ")
number balance = cast(number, balanceInput)
integer counter = 0
repeat while balance > 1
     number price = 1.0
     counter = counter + 1
     balance = balance - price
     output " + dq + "You have enough money to buy another app!" + dq + "
end
output " + dq + "You don't have money enough to buy another app! You have bought " + dq + " + counter + " + dq + " apps!" + dq)
        Paragraph("For testing, let's use 6 as the input. Our output should be 5 times the phrase that we have enough money to buy another app. The last line is the phrase saying we do not have enough money and how many apps you have bought.")
        CodeEditorWithCode("Use 'repeat while' to check how many cheeseburgers you can buy.", "//Activity: Use $1.19 as the price for the cheeseburgers, and write a phrase telling how many cheeseburgers you bought.")
        Paragraph("The final type of loop in Quorum is the "):Code("repeat until"):Text(" loop. The "):Code("repeat until"):Text(" functions much in the same way as "):Code("repeat while"):Text(" , but the interpretation of your condition is slightly different. Instead of saying repeat while balance > 1 you can say repeat until balance < 1. The difference between these two conditions is that in the repeat while the number 1 is not included while in the repeat until the number 1 is included, for them to match exactly you should use <=(less or equal).")
        CodeEditorWithCode("Activity: Repeat the previous activity using 'repeat until' instead of 'repeat while'", "")
        Paragraph("Your output should look exactly the same for the same input with both statements.")
    end

    private action Goal2UsingLoops
        Section("Goal 2: Using Loops")
        Paragraph("You will work with all three kinds of loops to get a grasp of each loop. Also, for this task, you will be using the "):Code("Random"):Text(" class. Add a use statement for the "):Code("Random"):Text(" class, found in the Compute library, at the top of the file. To help you become familiar with the "):Code("Random"):Text(" class, sample code using the "):Code("Random"):Text(" class is provided below.")
        Subsection("Example: How to use the Random Class.")
        CodeExample("use Libraries.Compute.Random
Random choice
integer counter1 = 0
integer randomValue = 0
repeat 6 times
     randomValue = choice:RandomInteger(100)
     counter1 = counter1 + 1
     output " + dq + "counter = " + dq + " + counter1
     output " + dq + "random value = " + dq + " + randomValue
end")
        Paragraph("The loop repeats the block of code 6 times as you can see and each time the computer choose a randomly generated "):Code("integer"):Text(" value between 0 and 100.")
        CodeEditorWithCode("Activity: Write a program that repeats until the random number is greater than 50", "//You can choose if you wnat to use the 'repeat while' or the 'repeat until' statements and the number should be randomly generated by the computer")
    end
end
