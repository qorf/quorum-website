    Lab 3.2: Loops.
    Converted from the old Lesson page by plan 13's generator: the same
    words, now without Tailwind.
*/
class Lab3_2 is QuorumPage
    // A double quote, for code and words that hold one.
    text dq = ""

    on create
        SetLocation("lessons/chapter3/lab3_2.html")
        // The name lists and links use, and the series and track it belongs
        // to: its section and picture.
        SetShortTitle("Lab 3.2")
        SetSectionName("Control Structures")
        // For search engines and link previews, and what lists of pages say.
        SetDescription("Learn about how to code different kinds of loops (i.e., times, while, and until) in the Quorum programming language.")
        SetSummary("how work Loops in Quorum.")
    end

    action Setup
        dq = dq:GetDoubleQuote()
        SetWebPageTitle("Lab 3.2: Loops - Quorum Programming Language")
        Title("Lab 3.2: Loops")
        GoalsPart()
        ComputerSciencePrinciplesCurriculum()
        CommonCoreStandards()
        Vocabulary()
        Overview()
        Goal1UnderstandingTheTypesOfRepeatStatement()
        Goal2UsingLoops()
    end

    private action GoalsPart
        Section("Goals")
        Paragraph("The goal of this lab is to learn the following:")
        BulletList()
        ListItem("Understanding the types of repeat statement")
        ListItem("Using loops")
    end

    private action ComputerSciencePrinciplesCurriculum
        Section("Computer Science Principles Curriculum")
        BulletList()
        ListItem():Strong("Big Idea: Algorithms: "):Text("EK 4.1.1A, EK 4.1.1B, EK 4.1.1C, EK 4.1.1D, EK 4.1.1E, EK 4.1.1F, EK 4.1.1G, EK 4.1.1H, EK 4.2.1A, EK 4.2.1B")
        ListItem():Strong("Big Idea: Programming: "):Text("EK 5.1.2A, EK 5.1.2B, EK 5.2.1A, EK 5.2.1B, EK 5.2.1C, EK 5.2.1D, EK 5.2.1E, EK 5.5.1A, EK 5.5.1D")
    end

    private action CommonCoreStandards
        Section("Common Core Standards")
        BulletList()
        ListItem():Strong("English Language Arts Standards » Science & Technical Subjects: "):Text("CCSS.ELA-Literacy.RST.9-10.3, CCSS.ELA-Literacy.RST.9-10.4, CCSS.ELA-Literacy.RST.9-10.5, CCSS.ELA-Literacy.RST.9-10.7, CCSS.ELA-Literacy.RST.9-10.10, CCSS.ELA-Literacy.RST.11-12.2, CCSS.ELA-Literacy.RST.11-12.3, CCSS.ELA-Literacy.RST.11-12.4, CCSS.ELA-Literacy.RST.11-12.5, CCSS.ELA-Literacy.RST.11-12.10")
        ListItem():Strong("Mathematics Content: High School Functions » Building Functions: "):Text("CCSS.Math.Content.HSF.BF.1A")
        ListItem():Strong("Standards For Mathmatical Practice: "):Text("CCSS.Math.Practice.MP1, CCSS.Math.Practice.MP2, CCSS.Math.Practice.MP4, CCSS.Math.Practice.MP5, CCSS.Math.Practice.MP6, CCSS.Math.Practice.MP7, CCSS.Math.Practice.MP8")
