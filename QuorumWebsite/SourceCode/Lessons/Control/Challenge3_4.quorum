use Libraries.Web.Page.QuorumPage

/*
    Challenge 3.4: Robots.
    Converted from the old Lesson page by plan 13's generator: the same
    words, now without Tailwind.
*/
class Challenge3_4 is QuorumPage
    // A double quote, for code and words that hold one.
    text dq = ""

    on create
        SetLocation("lessons/chapter3/challenge3_4.html")
        // The name lists and links use, and the series and track it belongs
        // to: its section and picture.
        SetShortTitle("Challenge 3.4")
        SetSectionName("Control Structures")
        // For search engines and link previews, and what lists of pages say.
        SetDescription("Learn about control structures and loops with LEGO Mindstorms robots in the Quorum programming language.")
        SetSummary("how Robots work in Quorum.")
    end

    action Setup
        dq = dq:GetDoubleQuote()
        SetWebPageTitle("Challenge 3.4: Robots - Quorum Programming Language")
        Title("Challenge 3.4: Robots")
        Robot()
        Overview()
        ExampleSetThePortYourInfraredSensorIsConnectedTo()
    end

    private action Robot
        Section("Robot")
        Subsection("Goals")
        Paragraph("In this challenge you will practice the following computer science concepts in a team or small group environment:")
        BulletList()
        ListItem("Creating Objects")
        ListItem("Using conditional statements and looping statements")
        Subsection("Computer Science Principles Curriculum")
        BulletList()
        ListItem():Strong("Big Idea: Creativity: "):Text("EU 1.2, LO 1.2.3, EK 1.2.3A, EU 1.3, LO 1.3.1, EK 1.3.1A")
        ListItem():Strong("Big Idea: Algorithms: "):Text("EU 4.1, LO 4.1.1, EK 4.1.1B")
        ListItem():Strong("Big Idea: Programming: "):Text("EU 5.1, LO 5.1.1, EK 5.1.1B, EU 5.2, LO 5.2.1, EK 5.2.1C, EK 5.2.1D")
        Subsection("Common Core Standards")
        BulletList()
        ListItem():Strong("English Language Arts Standards » Science & Technical Subjects: "):Text("CCSS.ELA-Literacy.RST.9-10.2, CCSS.ELA-Literacy.RST.9-10.3, CCSS.ELA-Literacy.RST.9-10.4, CCSS.ELA-Literacy.RST.9-10.5, CCSS.ELA-Literacy.RST.9-10.6, CCSS.ELA-Literacy.RST.11-12.2, CCSS.ELA-Literacy.RST.11-12.3, CCSS.ELA-Literacy.RST.9-10.1, CCSS.ELA-Literacy.RST.9-10.2, CCSS.ELA-Literacy.RST.9-10.7, CCSS.ELA-Literacy.RST.9-10.8, CCSS.ELA-Literacy.RST.9-10.9")
        ListItem():Strong("Standards For Mathmatical Practice: "):Text("CCSS.Math.Practice.MP1, CCSS.Math.Practice.MP2, CCSS.Math.Practice.MP5, CCSS.Math.Practice.MP6, CCSS.Math.Practice.MP7, CCSS.Math.Practice.MP8, CCSS.Math.Content.HSF.IF.A.1")
        Subsection("Vocabulary")
        BulletList()
        ListItem("Control Structures")
        ListItem("If Statement")
        ListItem("Loops")
        ListItem("Input Manager")
        ListItem("Infrared Sensor")
    end

    private action Overview
        Section("Overview")
        Paragraph("This challenge will use the "):Code("InfraredSensor"):Text(" Library. You will use conditions with the Infrared Sensor in order to avoid the wall.")
        Subsection("Goal 1: Creating Objects")
        Paragraph("Create a new Robot project. Name it properly and open the main.quorum file. In the top of the file, type the appropriate code to use the Quorum "):Code("InfraredSensor"):Text(" and "):Code("Motor"):Text(" libraries inside the "):Code("Lego"):Text(" library.")
        Paragraph():Strong("Activity 1: Instantiate the Motor and the "):Code("InfraredSensor"):Strong(" objects.")
        Paragraph("Call the "):Code("Motor"):Text(" object "):Code("motor"):Text(" and the "):Code("InfraredSensor"):Text(" object "):Code("infraredSensor"):Text(".")
        Paragraph("Now you must set the port to work with. That will be the port that the Infrared Sensor is connected to on the robot. You will do that using the "):Code("SetPort"):Text(" statement.")
    end

    private action ExampleSetThePortYourInfraredSensorIsConnectedTo
        Section("Example: Set the port your Infrared Sensor is connected to")
        CodeExample("// This line of code will set the port that your robot will work with
infraredSensor:SetPort(4) //This line is a looping condition; once the condition doesn’t match anymore the program stops 
repeat while true ")
        Paragraph("After that you should set the speed of the motors, so despite any condition the motors will work at this speed when they’re active.")
        Paragraph():Strong("Activity 2: Write the code to set the speed of motors B and C.")
        CodeExample("")
        Subsection("Goal 2: Using conditional and looping statements")
        Paragraph("The robot should go forward and, if the infrared sensor detects a wall, it will turn to the right first. If there is a free space the robot will move forward, but if there is also a wall after turning right, it will turn to the left and move forward. If there is also a the wall there, the robot will stop because it has nowhere to go!")
        Paragraph("Let’s start with the conditions now. In order to get the distance between the robot and an obstacle you will use the "):Code("GetDistance"):Text(" command. To make sure we have enough space to turn, let’s use 25 cm as the maximum distance.")
        Subsubsection("Example: Create the conditions that will check the distance between the sensor and the wall and then make the robot move accordingly")
        CodeExample("//Before the conditions, to make it easier, let's set the distance values the sensor will take
distance = infraredSensor:GetDistance()
//This line states that in case the distance is greater than 40 cm
if infraredSensor:GetDistance() > 40
//the robot should move forward
motor:RotateBackward(" + dq + "B" + dq + ")
motor:RotateBackward(" + dq + "C" + dq + ")
//This line states that in case the distance isn’t greater than 25 cm
else
//the robot will stop and turn right
motor:Stop(" + dq + "B" + dq + ")
motor:Stop(" + dq + "C" + dq + ")
motor:RotateByDegrees(" + dq + "C" + dq + ", -655)
motor:Wait(" + dq + "C" + dq + ")
//You will also use an if statement inside an if statement to measure the distance again after turning right
//This line of code will do that again
distance = infraredSensor:GetDistance()")
        Paragraph():Strong("Activity 3: Using "):Code("if"):Strong(" and "):Code("else"):Strong(" statements, create the other conditions.")
        Paragraph("Don’t forget that you can (and in this case will need to) have an "):Code("if"):Text(" inside another. You’ll do these conditions now: "):Strong("If"):Text(" after the robot turns to the right, there is a free space, the robot should move forward. "):Strong("Else"):Text(" the robot should turn 180 degrees to the left. "):Strong("If"):Text(" there is free space the robot should move forward. After these conditions we still need one more: in case the left also has a wall.")
        Subsubsection("Example: Last condition: stop the motors")
        Subsubsection("Example: Last condition: stop the motors.")
        CodeExample("//This line of code states that in case there is no free space to the left 
else
//These lines will make the robot stop
motor:Stop(" + dq + "B" + dq + ")
motor:Stop(" + dq + "C" + dq + ")
//These lines finish each one of the conditional (if) statements and the looping (repeat) statement
end
end
end
end")
        Paragraph("Hopefully your program is running great at this point! Run it and see if you get any errors. If you do, go back and fix them. Otherwise, you just finished your challenge! Congrats!")
    end
end
