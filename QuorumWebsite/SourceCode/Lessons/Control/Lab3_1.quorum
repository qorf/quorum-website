/*
    Lab 3.1: Conditionals.
    Converted from the old Lesson page by plan 13's generator: the same
    words, now without Tailwind.
*/
class Lab3_1 is QuorumPage
    // A double quote, for code and words that hold one.
    text dq = ""

    on create
        SetLocation("lessons/chapter3/lab3_1.html")
        // The name lists and links use, and the series and track it belongs
        // to: its section and picture.
        SetShortTitle("Lab 3.1")
        SetSectionName("Control Structures")
        // For search engines and link previews, and what lists of pages say.
        SetDescription("Learn about conditional statements and lexical scoping in the Quorum programming language.")
        SetSummary("how Conditionals work in Quorum.")
    end

    action Setup
        dq = dq:GetDoubleQuote()
        SetWebPageTitle("Lab 3.1: Conditionals - Quorum Programming Language")
        Title("Lab 3.1: Conditionals")
        GoalsPart()
        ComputerSciencePrinciplesCurriculum()
        CommonCoreStandards()
        Vocabulary()
        Overview()
        Goal1LearnAboutConditionals()
        Goal2UsingConditionals()
    end

    private action GoalsPart
        Section("Goals")
        Paragraph("The goal of this lab is to learn the following:")
        BulletList()
        ListItem("Understanding conditionals")
        ListItem("Using conditionals")
    end

    private action ComputerSciencePrinciplesCurriculum
        Section("Computer Science Principles Curriculum")
        BulletList()
        ListItem():Strong("Big Idea: Programming: "):Text("EK 5.1.2B, EK 5.1.2E, EK 5.2.1F, EK 5.1.2J, EK 5.2.1C, EK 5.3.1D, EK 5.3.1I, EK 5.4.1")
        ListItem():Strong("Big Idea: Data and Information: "):Text("EK 3.1.1B")
    end

    private action CommonCoreStandards
        Section("Common Core Standards")
        BulletList()
        ListItem():Strong("English Language Arts Standards » Science & Technical Subjects: "):Text("CCSS.ELA-Literacy.RST.9-10.2, CCSS.ELA-Literacy.RST.9-10.3, CCSS.ELA-Literacy.RST.9-10.4, CCSS.ELA-Literacy.RST.9-10.5, CCSS.ELA-Literacy.RST.9-10.6, CCSS.ELA-Literacy.RST.11-12.2, CCSS.ELA-Literacy.RST.11-12.3")
        ListItem():Strong("Standards For Mathmatical Practice: "):Text("CCSS.Math.Practice.MP1, CCSS.Math.Practice.MP2, CCSS.Math.Practice.MP5, CCSS.Math.Practice.MP6, CCSS.Math.Practice.MP7, CCSS.Math.Practice.MP8")
    end

    private action Vocabulary
        Section("Vocabulary")
        BulletList()
        ListItem("Conditional statement")
        ListItem("If")
        ListItem("Else if")
        ListItem("Else")
        ListItem("End")
        ListItem("Lexical scope")
    end

    private action Overview
        Section("Overview")
        Paragraph("The goal of this lab is to learn the fundamentals of conditional statements and learn how to write Quorum programs using them.")
    end

    private action Goal1LearnAboutConditionals
        Section("Goal 1: Learn about conditionals.")
        Paragraph("Conditionals are one of the most important aspects of programming. Conditional statements allow the program to make decisions, changing the behavior of the software during runtime. So far, your code has run from top to bottom, with the same behavior each time. Conditional statements allow your program to alter its behavior depending on any condition you specify. Conditionals can be used for a variety of tasks such as determining if a number given by a user is less than the number 100, or if the battery of your phone is about to die.")
        Paragraph("To use conditionals you use certain statements: "):Code("if"):Text(", "):Code("elseif"):Text(", "):Code("else"):Text(" and "):Code("end"):Text(". The "):Code("if"):Text(" is the first command in your block of decision. If this condition is not true your program will move on to the "):Code("elseif"):Text(" command if it is available. Otherwise, it will move to the "):Code("else"):Text(" statement. The "):Code("elseif"):Text(" is not always used. You only use it when you have more than two decisions that must be made. If the program goes between the "):Code("if"):Text(" and "):Code("else"):Text(" statements in the block, and neither condition is met (or true), your program will go to the "):Code("elseif"):Text(", if it is available, or directly to a final "):Code("else"):Text(", if you choose to do that instead. In this case the "):Code("else"):Text(" is the final statement in the decision block and must be used, it being the last decision the computer can make if all the other decisions are false. Once your program decides your condition is true it will go to the end of the block and move on.")
        Paragraph("If you define a variable inside of the "):Code("if"):Text(" statement, in Quorum, this means it only exists inside the scope of the "):Code("if"):Text(" statement, between the "):Code("if"):Text(" and "):Code("end"):Text(" keywords. This is what is called "):Strong("lexical scoping"):Text(", and it is very useful to keep a program organized. In the case that you want the variable to be accessible outside of the "):Code("if"):Text("statement's scope, you have to define the variable above the "):Code("if"):Text(" statement.")
        Subsection("Example: Use conditional statements to find out users' phone preferences.")
        CodeExample("text answer = input (" + dq + "Do you use apple or android?" + dq + ")
if answer = " + dq + "Apple" + dq + "
   output " + dq + "I like the iPhone too!" + dq + "
else
   output " + dq + "Android is cool!" + dq + "
end")
        Paragraph("Run the program and there should not be any errors. Do not forget where you should enter your preference. If you wish, try other questions and answers as well!")
        CodeEditorWithCode("Activity:", "//Use conditional statements to find out users' computer preferences.")
        Paragraph("Use Mac and Windows as your choices; do not forget to output a phrase for each preference.")
    end

    private action Goal2UsingConditionals
        Section("Goal 2: Using conditionals")
        Paragraph("Now that you understand why and how to use conditional statements, let’s have some fun using them. We will start with a program that asks the users’ breakfast preferences.")
        Subsection("Example: Use conditional statements to find out users' breakfast preferences.")
        CodeExample("text choice = input (" + dq + "What do you prefer for breakfast? Press 1 for eggs, press 2 for pancakes or press 3 for something else." + dq + ")
if choice = " + dq + "1" + dq + "
   output " + dq + "I like mine over easy!" + dq + "
elseif choice = " + dq + "2" + dq + " 
   output " + dq + "I love butter and syrup with them!" + dq + "
else
   output " + dq + "It is great to have so many choices!" + dq + "
end")
        Paragraph("As you can see in the example above, you can insert a number in this case, as a text, but you can only use it in your block of decision if you have quotes.")
        CodeEditorWithCode("Activity:", "//Use conditional statements to find out users' game console preference. Use these 5 choices in your activity: PlayStation, Xbox, Wii, PC, or other option. 
        Run your program and see if it works properly. Show your work to your instructor. ")
    end
end
