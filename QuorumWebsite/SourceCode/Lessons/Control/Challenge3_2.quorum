use Libraries.Web.Page.QuorumPage

/*
    Challenge 3.2: Trivia Challenge - Audio.
    Converted from the old Lesson page by plan 13's generator: the same
    words, now without Tailwind.
*/
class Challenge3_2 is QuorumPage
    // A double quote, for code and words that hold one.
    text dq = ""

    on create
        SetLocation("lessons/chapter3/challenge3_2.html")
        // The name lists and links use, and the series and track it belongs
        // to: its section and picture.
        SetShortTitle("Challenge 3.2")
        SetSectionName("Control Structures")
        // For search engines and link previews, and what lists of pages say.
        SetDescription("Learn about control structures and reading files by coding an audio trivia game in the Quorum programming language.")
        SetSummary("how to do the Trivia Challenge - Audio in Quorum.")
    end

    action Setup
        dq = dq:GetDoubleQuote()
        SetWebPageTitle("Challenge 3.2: Trivia Challenge - Audio - Quorum Programming Language")
        Title("Challenge 3.2: Trivia Challenge - Audio")
        GoalsPart()
        ComputerSciencePrinciplesCurriculum()
        CommonCoreStandards()
        Overview()
        Goal1ReadingFiles()
        Goal2UsingControlStructures()
        SampleOutput()
    end

    private action GoalsPart
        Section("Goals")
        Paragraph("In this assignment, you will practice the following computer science concepts:")
        BulletList()
        ListItem("Reading Files")
        ListItem("Using Control Structures")
    end

    private action ComputerSciencePrinciplesCurriculum
        Section("Computer Science Principles Curriculum")
        BulletList()
        ListItem():Strong("Big Idea: Creativity: "):Text("EU 1.1, LO 1.1.1, EK 1.1.1A, EU 1.2, LO 1.2.1, EK 1.2.1E")
        ListItem():Strong("Big Idea: Algorithms: "):Text("EU 4.1, LO 4.1.1, EK 4.1.1B")
        ListItem():Strong("Big Idea: Programming: "):Text("EU 5.3, LO 5.3.1, EK 5.3.1I, EU 5.5, LO 5.5.1, EK 5.5.1H, EK 5.5.1I, EK 5.5.1J")
    end

    private action CommonCoreStandards
        Section("Common Core Standards")
        BulletList()
        ListItem():Strong("English Language Arts Standards » Science & Technical Subjects: "):Text("CCSS.ELA-Literacy.RST.9-10.2, CCSS.ELA-Literacy.RST.9-10.3, CCSS.ELA-Literacy.RST.9-10.4, CCSS.ELA-Literacy.RST.9-10.5, CCSS.ELA-Literacy.RST.9-10.6, CCSS.ELA-Literacy.RST.11-12.2, CCSS.ELA-Literacy.RST.11-12.3, CCSS.ELA-Literacy.RST.9-10.1, CCSS.ELA-Literacy.RST.9-10.2, CCSS.ELA-Literacy.RST.9-10.7, CCSS.ELA-Literacy.RST.9-10.8, CCSS.ELA-Literacy.RST.9-10.9")
        ListItem():Strong("Standards For Mathmatical Practice: "):Text("CCSS.Math.Practice.MP1, CCSS.Math.Practice.MP2, CCSS.Math.Practice.MP5, CCSS.Math.Practice.MP6, CCSS.Math.Practice.MP7, CCSS.Math.Practice.MP8, CCSS.Math.Content.HSF.IF.A.1")
    end

    private action Overview
        Section("Overview")
        Paragraph("In this assignment, you will create a program that plays a simple trivia game. This assignment allows you to create your own questions and answers for the game. Download this "):Link("zip file", "/files/lessons/chapter3/Challenge3_2Template.zip"):Text(" for a template to help you get started. Open the provided project template and navigate to the "):Strong("main.quorum"):Text(" file.")
        Paragraph():Strong("Activity 1: Write the questions and answers.")
        Paragraph("This assignment stores the questions and answers for your game in separate "):Strong(dq + ".txt" + dq):Text(" files. This allows you to update or change your questions/answers without having to modify your program code. Create two "):Strong(dq + ".txt" + dq):Text(" files, one for the questions and one for the answers. Come up with the questions and answers for your game and put them in the appropriate files, one per line.")
        Subsection("Understanding FileReaders")
        Paragraph("Because your questions and answers are stored in separate "):Strong(dq + ".txt" + dq):Text(" files, your program needs to read those files in order to access your questions. To do this, you need to use the "):Link("FileReader", "libraries/System/FileReader.html"):Text(" object from the "):Code("Libraries.System.FileReader"):Text(" library. The "):Code("FileReader"):Text(" object reads a Quorum "):Link("File", "libraries/System/File.html"):Text(" object sequentially starting from the beginning of the file. To store the questions and answers during the program you use an object known in Quorum as an "):Link("Array", "libraries/System/FileReader.html"):Text(". An "):Code("Array"):Text(" is simply a container that stores items in a contiguous block of memory. To use the "):Code("Array"):Text(" object, you need to include the "):Code("Libraries.Containers.Array"):Text(" library.")
        Paragraph():Strong("Activity 2: Tell Quorum you want to use the "):Code("FileReader"):Strong(", "):Code("File"):Strong(" and "):Code("Array"):Strong(" libraries, declare the "):Code("FileReader"):Strong(" and "):Code("File"):Strong(" objects for the questions and answers, and set the paths of the files.")
        Paragraph("In order to use "):Code("FileReader"):Text(" objects, you first need to declare both "):Code("File"):Text(" and "):Code("FileReader"):Text(" objects. Since you have 2 files, one for questions and one for answers, you need two "):Code("File"):Text(" objects, one that represents the "):Strong(dq + "questions.txt" + dq):Text(" file and another that represents the "):Strong(dq + "answers.txt" + dq):Text(" file. You also need two "):Code("FileReader"):Text(" objects, one to read the "):Strong(dq + "questions.txt" + dq):Text(" file and another to read the "):Strong(dq + "answers.txt" + dq):Text(" file. You also need to set the paths of the "):Code("File"):Text(" objects to your questions and answers files.")
        Paragraph("Your program needs a place to store the questions and answers read from the files. To do this, you use arrays.")
        Paragraph():Strong("Example: Declare "):Code("Array"):Strong(" objects to store the questions and answers.")
        CodeExample("// this line declares an array called questions. The <text> part tells the Array
// that it will store text
Array<text> questions

// this line sets the y position of our birds audio object.
// the sound will be coming from above our heads
birds:SetY(0.9)

// this line declares an array called answers. The <text> part tells the Array
// that it will store text
Array<text> answers")
    end

    private action Goal1ReadingFiles
        Section("Goal 1: Reading Files")
        Paragraph("To get your questions and answers from their files into your program, you need to tell your program to read the files. In order to read a file, it must first be opened. In Quorum, you must also tell files what they are being opened for (reading, writing, reading and writing). Since we are going to be reading our file once it has been opened, we use the "):Code("OpenForRead"):Text(" action on our "):Code("FileReader"):Text(" objects. This action takes a single parameter that represents the "):Code("File"):Text(" object we want to open for read.")
        Paragraph():Strong("Activity 3: Open the questions and answers files for read using the "):Code("OpenForRead"):Strong(" action on your "):Code("FileReader"):Strong(" objects.")
        Paragraph("Now, your file is open and ready to read. There are many options for actions to read your file. The "):Code("Read"):Text(" action reads and returns the entire contents of the file. The "):Code("ReadLine"):Text(" action reads and returns a single line from the file. The "):Code("ReadLines"):Text(" action reads and returns all the remaining lines of the file starting from the current position. You can know if you have read the entire file or not by calling the "):Code("IsAtEndOfFile"):Text(" action. This action returns "):Code("true"):Text(" if the end of the file has been reached and "):Code("false"):Text(" otherwise.")
        Paragraph():Strong("Example: Use the "):Code("questionsReader"):Strong(" object to read the questions file one line at a time into the questions array until the end of the file has been reached.")
        CodeExample("// This line initially reads the file. This is needed before calling the 
// IsAtEndOfFile action
text question = questionsReader:ReadLine()

// this line adds the question we just read into the questions Array
questions:Add(question)

// this repeat statement reads the rest of the file until the end of the file is
// reached
repeat until questionsReader:IsAtEndOfFile()

   // this line reads in another line from the file
   question = questionsReader:ReadLine()

   // this line adds the question we just read into the questions Array
   questions:Add(question)
end")
        Paragraph("The answers file is read in the exact same way.")
        Paragraph():Strong("Activity 4: Close the "):Code("FileReader"):Strong(" objects.")
        Paragraph("Once you have read the contents of your questions and answers files into their respective arrays, you are done with those files and "):Code("FileReader"):Text(" objects. In Quorum, once you are done using a file that you have opened in your program, you need to tell Quorum that you are done with it and that it is okay to close the file. You can do this by calling the "):Code("Close"):Text(" action on your "):Code("FileReader"):Text(" objects.")
    end

    private action Goal2UsingControlStructures
        Section("Goal 2: Using Control Structures")
        Paragraph("Once the program has read all of the questions and answers, it should start the game. Your program should output all of the questions and ask the user for answers. The user input is captured using the "):Code("input"):Text(" command. The user input should be checked against the answer, and if the answer is correct, a sound should be played. If the answer is not correct, a different sound should be played. For the convenience of whoever is playing your game, you may want to ignore any whitespace before and after their answer. Calling the "):Code("Trim"):Text(" action on the text they inputted will accomplish this.")
        Subsection("Example: Repeatedly ask the user questions and get their answers, checking the user’s entered answer against the correct answer. If the user is correct, output a message and play a sound. If the user is incorrect, output a different message and play a different sound.")
        CodeExample("integer counter = 0           // this variable keeps track of where we are in our arrays

// the GetSize action returns the number of elements in an array. We want to
// go through each element in the array in order to ask each question.
repeat questions.GetSize() times
  // the Get action returns the element in the array at the passed integer
   // index. Counter is the variable we use to keep track of where we are in
   // the array
   output questions:Get(counter)

  // this line gets the user’s input (i.e., their guess)
   text guess = input() 

   // this line gets the correct answer to the question from the answers array
  text correctAnswer = answers:Get(counter)

   // this if statement checks the user’s input against the answer to the
   // question. The EqualsIgnoringCase action will return true if the user’s
   // guess is the same as the answer ignoring upper/lowercase.
   if guess:EqualsIgnoringCase(correctAnswer)
      // output correct message
       // play correct sound
   else
      // output incorrect message
       // play incorrect sound
   end

  // this line updates the counter variable so that we can get the next
   // element in the arrays
   counter = counter + 1
end")
        Paragraph("Once the user has answered all of the questions, you should output a message that informs them that the game is over.")
        Paragraph("Optionally, you may add more sound events to your game or use the Quorum "):Code("say"):Text(" keyword to have the program read your questions to the user out loud.")
    end

    private action SampleOutput
        Section("Sample Output")
        Paragraph("Because the students create their own questions, the output will vary. Here is one example:")
        CodeExample("What statement in Quorum would you use to execute code only under certain conditions?
if
You are correct!

What is the name of the type in Quorum that stores numbers with decimal points?
number
You are correct!

What is the name of the type in Quorum that stores whole numbers?
integer
You are correct!

What is the name of the type in Quorum that stores words?
text
You are correct!

Which keyword in Quorum allows you to perform tasks over and over again?
repeat
You are correct!

What is the name of the type in Quorum that stores values that are either true or false?
boolean
You are correct!

What do you call a statement that is ignored by the compiler?
comment
You are correct!

What is the keyword that allows you to include a library in your Quorum project?
use
You are correct!

EGame Over. You got 8/8 questions right!
Thanks for playing!")
    end
end
