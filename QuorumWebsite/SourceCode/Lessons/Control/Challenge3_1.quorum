use Libraries.Web.Page.QuorumPage

/*
    Challenge 3.1: Updated Travel Reservation.
    Converted from the old Lesson page by plan 13's generator: the same
    words, now without Tailwind.
*/
class Challenge3_1 is QuorumPage

    on create
        SetLocation("lessons/chapter3/challenge3_1.html")
        // The name lists and links use, and the series and track it belongs
        // to: its section and picture.
        SetShortTitle("Challenge 3.1")
        SetSectionName("Control Structures")
        // For search engines and link previews, and what lists of pages say.
        SetDescription("Learn about conditionals and lexical scoping by coding travel reservation software in the Quorum programming language.")
        SetSummary("how work Updated Travel Reservation in Quorum.")
    end

    action Setup
        SetWebPageTitle("Challenge 3.1: Updated Travel Reservation - Quorum Programming Language")
        Title("Challenge 3.1: Updated Travel Reservation")
        ThisAssignmentUsesTheProgramMadeInAssignment31Th()
        Objectives()
        ComputerSciencePrinciplesCurriculum()
        CommonCoreStandards()
        Vocabulary()
        Overview()
        TasksToCompleteToMeetAllOvjectives()
        SampleOutput()
    end

    private action ThisAssignmentUsesTheProgramMadeInAssignment31Th
        Section("This assignment uses the program made in Assignment 3.1, the travel reservation.")
    end

    private action Objectives
        Section("Objectives")
        Paragraph("The goal of this assignment is to practice the following:")
        BulletList()
        ListItem("Conditionals and lexical scoping")
        ListItem("Loops")
        ListItem("How to analyze a problem statement")
        ListItem("How to modify an existing program")
    end

    private action ComputerSciencePrinciplesCurriculum
        Section("Computer Science Principles Curriculum")
        BulletList()
        ListItem():Strong("Big Idea: Algorithms: "):Text("EU 4.1, LO 4.1.1, EK 4.1.1A, EK 4.1.1B, EK 4.1.1C, EK 4.1.1D, EK 4.1.1E, EK 4.1.1F, EK 4.1.1G, EK 4.1.1H, EK 4.1.1I")
        ListItem():Strong("Big Idea: Algorithms: "):Text("EU 4.1, LO 4.1.2, EK 4.1.2A, EK 4.1.2C")
        ListItem():Strong("Big Idea: Programming: "):Text("EU 5.1, LO 5.1.2, EK 5.1.2C, EK 5.1.2D, EK 5.1.2E, EK 5.1.2F, EK 5.1.2G, EK 5.1.2H, EK 5.1.2I, EK 5.1.2J")
    end

    private action CommonCoreStandards
        Section("Common Core Standards")
        BulletList()
        ListItem():Strong("English Language Arts Standards » Science & Technical Subjects: "):Text("CCSS.ELA-Literacy.RST.9-10.3, CCSS.ELA-Literacy.RST.9-10.4, CCSS.ELA-Literacy.RST.9-10.5, CCSS.ELA-Literacy.RST.9-10.7, CCSS.ELA-Literacy.RST.9-10.10, CCSS.ELA-Literacy.RST.11-12.2, CCSS.ELA-Literacy.RST.11-12.3, CCSS.ELA-Literacy.RST.11-12.4, CCSS.ELA-Literacy.RST.11-12.5, CCSS.ELA-Literacy.RST.11-12.10")
        ListItem():Strong("Standards For Mathmatical Practice: "):Text("CCSS.Math.Practice.MP1, CCSS.Math.Practice.MP2, CCSS.Math.Practice.MP4, CCSS.Math.Practice.MP5, CCSS.Math.Practice.MP6, CCSS.Math.Practice.MP7, CCSS.Math.Practice.MP8")
    end

    private action Vocabulary
        Section("Vocabulary")
        BulletList()
        ListItem("Conditional")
        ListItem("Lexical Scoping")
        ListItem("Loop")
    end

    private action Overview
        Section("Overview")
        Paragraph("This assignment follows a different format than previous assignments. It does not have examples and activities, rather a list of changes to make to you existing program. Use what you have learned to make new changes to the logic, and add to the program to comply with the growing demand at the travel agency. The program checks for the user input. The program then asks the user to enter the value again if an incorrect value has been entered. The program also offers better options to give a client some flexibility with making a travel reservation.")
    end

    private action TasksToCompleteToMeetAllOvjectives
        Section("Tasks to Complete to Meet all Ovjectives")
        Paragraph("A small travel agency in St. Louis is growing and adding a couple of new destinations. More and more clients flock to the travel agency to make reservations. The travel agency needs to improve its existing program for better functionality and flexibility.")
        Paragraph("Before getting started with this assignment, create a new project and name it "):Strong("NewTravel"):Text(". Copy the existing code from the "):Strong("Travel"):Text(" project and paste it into a new project. All code should be in the main class as before. Run the program to make sure it works properly before moving on to make changes to the program.")
        Paragraph("Make changes to the code that handles invalid input by implementing the following:")
        BulletList()
        ListItem("If the user enters zero or less for the number of travelers, have the program prompt the user to enter the value again. The program should keep prompting the user until the correct value is entered. Otherwise, the correct value is entered and the program moves on.")
        ListItem("If the user enters a value that is outside the range of destination numbers, have the program keep prompting the user to enter a value until it is within the range. The user must enter a value between 1 and 5 to select a destination for the flight reservation. Once the correct value is checked, the program will store the city name and price as before. Otherwise, the program will keep asking the user to enter the correct value.")
        ListItem("When the user is asked to include the hotel option in the package, the user must enter Y, y, N, or N. If the user enters Y or y, the program will ask the user a couple of hotel questions. If the user enters N or n, the hotel reservation will not be made. If the user enters an invalid value (other than Y, y, N, or n), the program will keep prompting the user to enter the correct value.")
        ListItem("For the hotel type prompt, if the user enters a value that is outside the range of the hotel type number, the program will keep prompting the user to enter a value until it is within the range. The user must enter a value between 1 and 3 to select a hotel type. Once the correct value is checked, the program will store the hotel type and price as before. Otherwise, the program will keep asking the user for the correct value.")
        ListItem("For the number of hotel rooms, if the user enters zero or less, the program will keep prompting the user to enter the correct value. Otherwise, the correct value is entered and the program moves on.")
        ListItem("For the number of nights to stay at the hotel, if the user enters zero or less, the program will keep prompting the user to enter the correct value. Otherwise, the correct value is entered and the program moves on.")
        Paragraph("The travel agency wants to offer better flexibility by allowing the client an option of booking any reservation or just opting out of the program. Make changes to the program in the following ways:")
        BulletList()
        ListItem("The client is given an option to book a flight. If the client does not want to make a reservation for flights, the program will skip the flight reservation and move on to the hotel reservation.")
        ListItem("The new logic will allow the client to make a reservation for one of the following choices: 1) flights only, 2) hotel only, 3) both flights and hotel, and 4) no reservation at all. For example, the process will look like this:")
        BulletList()
        ListItem("The client is asked to make a reservation for flights.")
        ListItem("The client says yes and makes a reservation.")
        ListItem("The client is asked to make a reservation for hotel.")
        ListItem("The client says no and skips it.")
        Paragraph("Review the following logic to ensure that the program will provide the appropriate output to the client:")
        BulletList()
        ListItem("If the client makes a reservation for both flights and hotel, the price and information for flights and hotel will be provided.")
        ListItem("If the client books flights only, the flight details will be provided.")
        ListItem("If the client books hotel only, the hotel details will be provided.")
        ListItem("If the client does not make a reservation for flights and hotel, the program will announce that no reservation has been made.")
        Paragraph("The travel agency has added a couple of new destinations, so add the following destinations to the list:")
        Paragraph("______________________________________________________________________________________________________________________________________________________________________________ "):NewLine():Strong("Destination -> Round Trip Fare"):NewLine():Text("______________________________________________________________________________________________________________________________________________________________________________ "):NewLine():Text("Honolulu -> $650.00"):NewLine():Text("______________________________________________________________________________________________________________________________________________________________________________ "):NewLine():Text("New York City -> $290.00"):NewLine():Text("______________________________________________________________________________________________________________________________________________________________________________ "):NewLine():Text("San Francisco -> $359.00"):NewLine()
        CodeEditorWithCode("Activity:", "")
    end

