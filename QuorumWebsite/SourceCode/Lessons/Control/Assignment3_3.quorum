use Libraries.Web.Page.QuorumPage

/*
    Assignment 3.3: Key Press Madness - Audio.
    Converted from the old Lesson page by plan 13's generator: the same
    words, now without Tailwind.
*/
class Assignment3_3 is QuorumPage
    // A double quote, for code and words that hold one.
    text dq = ""

    on create
        SetLocation("lessons/chapter3/assignment3_3.html")
        // The name lists and links use, and the series and track it belongs
        // to: its section and picture.
        SetShortTitle("Assignment 3.3")
        SetSectionName("Control Structures")
        // For search engines and link previews, and what lists of pages say.
        SetDescription("Learn to code 3D audio applications and keyboard listeners with the Quorum programming language.")
        SetSummary("Key Press Madness - Audio in Quorum.")
    end

    action Setup
        dq = dq:GetDoubleQuote()
        SetWebPageTitle("Assignment 3.3: Key Press Madness - Audio - Quorum Programming Language")
        Title("Assignment 3.3: Key Press Madness - Audio")
        Paragraph("Learn to use keys in your program")
        GoalsPart()
        ComputerSciencePrinciplesCurriculum()
        CommonCoreStandards()
        Overview()
        Goal1UsingConditionalStatements()
        Goal2UsingLogicalOperations()
        SampleOutput()
    end

    private action GoalsPart
        Section("Goals")
        Paragraph("In this assignment, we will practice the following computer science concepts")
        BulletList()
        ListItem("Using conditional statements")
        ListItem("Using logical operations")
    end

    private action ComputerSciencePrinciplesCurriculum
        Section("Computer Science Principles Curriculum")
        BulletList()
        ListItem():Strong("Big Idea: Creativity: "):Text("EU 1.2, LO 1.2.3, EK 1.2.3A")
        ListItem():Strong("Big Idea: Algorithms: "):Text("EU 4.1, LO 4.1.1, EK 4.1.1B")
        ListItem():Strong("Big Idea: Programming: "):Text("EU 5.2, LO 5.2.1, EK 5.2.1A, EK 5.2.1B, EK 5.2.1C, EK 5.2.1D, EK 5.2.1E, EK 5.2.1F")
    end

    private action CommonCoreStandards
        Section("Common Core Standards")
        BulletList()
        ListItem():Strong("English Language Arts Standards » Science & Technical Subjects: "):Text("CCSS.ELA-Literacy.RST.9-10.2, CCSS.ELA-Literacy.RST.9-10.3, CCSS.ELA-Literacy.RST.9-10.4, CCSS.ELA-Literacy.RST.9-10.5, CCSS.ELA-Literacy.RST.9-10.6, CCSS.ELA-Literacy.RST.11-12.2, CCSS.ELA-Literacy.RST.11-12.3, CCSS.ELA-Literacy.RST.9-10.1, CCSS.ELA-Literacy.RST.9-10.2, CCSS.ELA-Literacy.RST.9-10.7, CCSS.ELA-Literacy.RST.9-10.8, CCSS.ELA-Literacy.RST.9-10.9")
        ListItem():Strong("Standards For Mathmatical Practice: "):Text("CCSS.Math.Practice.MP1, CCSS.Math.Practice.MP2, CCSS.Math.Practice.MP5, CCSS.Math.Practice.MP6, CCSS.Math.Practice.MP7, CCSS.Math.Practice.MP8, CCSS.Math.Content.HSF.IF.A.1")
    end

    private action Overview
        Section("Overview")
        Paragraph("This lab demonstrates how to map certain sounds to specific keys on the keyboard. When that key is pressed the program will play the designated sound. The Quorum "):Code("Games"):Text(" and "):Code("Audio"):Text(" libraries will be used, along with the "):Code("InputMonitor"):Text(" and "):Code("KeyboardEvent"):Text(" libraries to handle keyboard input during the program. You will write a program that will play certain sounds upon a key being pressed. Download this "):Link("zip file", "/files/lessons/chapter3/Assignment3_3Template.zip"):Text(" for a template to help you get started.")
        Paragraph("You may also use the IDE below for this assignment. The sounds we recommend using for this assignment are:")
        BulletList()
        ListItem("media/Bing.ogg")
        ListItem("media/Boom.ogg")
        ListItem("media/Chime.ogg")
        ListItem("media/Clang.ogg")
        ListItem("media/Firework.ogg")
        ListItem("media/Fwip.ogg")
        ListItem("media/longSong.ogg")
        ListItem("media/Modem.ogg")
        ListItem("media/Motorcycle.ogg")
        ListItem("media/Robot.ogg")
        ListItem("media/song.ogg")
        CodeEditorWithCode("Try Your Code Here", "use Libraries.Game.Game
use Libraries.Game.InputMonitor
use Libraries.Sound.Audio
use Libraries.Interface.Events.KeyboardEvent

/*
    This is a default class for creating a game in Quorum. Note that the Main 
    action begins by calling StartGame(), which loads a window a game can 
    be displayed in. The action CreateGame is where the game should load any 
    assets, like images to be displayed, frames of animation, or sounds to be
    played. 
*/

class Main is Game
    InputMonitor inputMonitor       // This handles user input during game
    KeyboardEvent keys              // This helps determine which key is pressed

    Audio sound1                    // audio object 1 (to map to a key)
    Audio sound2                    // audio object 2 (to map to a key)
    Audio sound3                    // audio object 3 (to map to a key)

    /*
        This action, Main, starts our computer program. In Quorum, programs always
        begin from Main.
    */

    action Main
        StartGame()
    end

    /*
        This action sets up the default values for a game. For example, we might
        use the Libraries.Game.Graphics.Drawable class to load up an image or 
        a shape. Or, we might add a Libraries.Interface.Button for making something clickable
        or a Libraries.Interface.TextBox for gathering user input in a game.
    */

    action CreateGame
    end

    /*
        The update action is called on every " + dq + "frame" + dq + " of animation in a game. This
        action should be used to do operations on items. So, for example, we 
        might use this action to change frames of animation, to rotate items, 
        or to make creatures jump.
    */

    action Update(number seconds)
    end
end")
    end

    private action Goal1UsingConditionalStatements
        Section("Goal 1: Using Conditional Statements")
        Paragraph("Open the provided template. In the "):Strong("main.quorum"):Text(" file code needs to be written in two places. The first place is in an action called "):Code("CreateGame"):Text(" on lines 38 through 39. In this action, you set up your "):Code("Audio"):Text(" objects. The second place you write code is in the action called "):Code("Update(number seconds)"):Text(" on lines 48 through 49. In this action, you write the code that plays the "):Code("Audio"):Text(" objects when keys are pressed. Three "):Code("Audio"):Text(" objects have already been declared for you. A folder called "):Strong("media"):Text(" has been provided to you that includes sounds for you to use for this program.")
        Paragraph():Strong("Activity: Load sounds to three "):Code("Audio"):Strong(" objects and enable looping on the three "):Code("Audio"):Strong(" objects.")
        Paragraph("Go through the "):Strong("media"):Text(" folder and choose three sounds you want to play during your program. Once you have chosen your sounds, you need to load them to your "):Code("Audio"):Text(" objects. You may want to enable looping on these sounds once you have loaded them so that the sounds play over and over again while a key is pressed.")
        Paragraph("Choose the three keys you want to play sounds when pressed and choose which "):Code("Audio"):Text(" object to play when that key is pressed. In the "):Code("Update(number seconds)"):Text(" action beginning on line 27, check for these keys being pressed. If they are, play the "):Code("Audio"):Text(" object for that key.")
        Subsection("Example: Play a sound when a key is pressed.")
        CodeExample("// this line checks if the " + dq + "A" + dq + " key is pressed.
if inputMonitor:IsKeyPressed(keys:A)
   // this line plays the sound we chose to associate with the A key
   sound1:Play()
end")
        Paragraph():Strong("Activity: Choose 2 more keys and play the other two "):Code("Audio"):Strong(" objects when those two keys are pressed.")
        Paragraph("When you run your program and press those keys, the sounds you associated with those keys should play. You can keep a key pressed down to play a sound for a longer period of time (due to the loops you created earlier) or just tap the key to play the sound for a short period of time. You will only hear the sound for the period you press the key. If you tap it you will barely hear a sound! Additionally, you may press more than one key at once to play multiple sounds.")
        Paragraph("Compile and run your program (after fixing any errors). You may notice that the sounds do not sound right if you hold a key down. Why might this be?")
    end

    private action Goal2UsingLogicalOperations
        Section("Goal 2: Using Logical Operations")
        Paragraph("Recall that the "):Code("Update(number seconds)"):Text(" action is called on every frame of your program. Also recall that the "):Code("Play"):Text(" action plays the audio file from the beginning. So each time the "):Code("Update(number seconds)"):Text(" action is called, any audio object currently playing will be played again from the beginning if the appropriate key is still pressed down. How might you fix this?")
        Paragraph("One easy way to fix this is to use the "):Code("IsPlaying"):Text(" action. "):Code("IsPlaying"):Text(" returns a "):Code("boolean"):Text(" — "):Code("true"):Text(" if the audio is playing and "):Code("false"):Text(" if not. We can use this action to our advantage because we only want to start playing our Audio objects if the appropriate key is pressed AND if the "):Code("Audio"):Text(" object is not already playing.")
        Subsection("Example: Only start playing the sound if the key is pressed and it is not already playing.")
        CodeExample("// this line checks if the " + dq + "A" + dq + " key is pressed and that the sound is not already
// playing
if inputMonitor:IsKeyPressed(keys:A) and not sound1::IsPlaying()
   // this line plays the sound we chose to associate with the A key
   sound1:Play()
end")
        Paragraph():Strong("Activity: Add the additional condition for the other "):Code("Audio"):Strong(" objects.")
        Paragraph("For extra fun, instantiate more "):Code("Audio"):Text(" objects (near the top of the file, above the "):Code("CreateGame"):Text(" action), load files to them, and play them on certain key presses!")
    end

    private action SampleOutput
        Section("Sample Output")
        Paragraph("The program should play at least 3 different sounds upon three different key presses. The sounds should continue to play smoothly while a key is held down.")
    end
end
