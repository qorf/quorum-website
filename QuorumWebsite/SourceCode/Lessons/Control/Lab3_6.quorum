use Libraries.Web.Page.QuorumPage

/*
    Lab 3.6: Robot.
    Converted from the old Lesson page by plan 13's generator: the same
    words, now without Tailwind.
*/
class Lab3_6 is QuorumPage
    // A double quote, for code and words that hold one.
    text dq = ""

    on create
        SetLocation("lessons/chapter3/lab3_6.html")
        // The name lists and links use, and the series and track it belongs
        // to: its section and picture.
        SetShortTitle("Lab 3.6")
        SetSectionName("Control Structures")
        // For search engines and link previews, and what lists of pages say.
        SetDescription("Learn about controlling the LEGO Mindstorms robot with the keyboard using the Quorum programming language.")
        SetSummary("how work Robot in Quorum.")
    end

    action Setup
        dq = dq:GetDoubleQuote()
        SetWebPageTitle("Lab 3.6: Robot - Quorum Programming Language")
        Title("Lab 3.6: Robot")
        Robot()
        Overview()
        ActivitySetTheDefaultSpeedOfTheMotorsYouMayChoos()
        ExampleNegativeValues()
    end

    private action Robot
        Section("Robot")
        Subsection("Goals")
        Paragraph("In this lab you will practice the following computer science concepts in a team or small group environment:")
        BulletList()
        ListItem("Taking actions based on user input")
        ListItem("Using conditional and looping statements")
        Subsection("Computer Science Principles Curriculum")
        BulletList()
        ListItem():Strong("Big Idea: Algorithms: "):Text("EU 4.1, LO 4.1.1, EK 4.1.1C, EK 4.1.1D")
        Subsection("Common Core Standards")
        BulletList()
        ListItem():Strong("English Language Arts Standards » Science & Technical Subjects: "):Text("CCSS.ELA-Literacy.RST.9-10.3, CCSS.ELA-Literacy.RST.9-10.4, CCSS.ELA-Literacy.RST.9-10.5, CCSS.ELA-Literacy.RST.9-10.7, CCSS.ELA-Literacy.RST.9-10.10, CCSS.ELA-Literacy.RST.11-12.2, CCSS.ELA-Literacy.RST.11-12.3, CCSS.ELA-Literacy.RST.11-12.4, CCSS.ELA-Literacy.RST.11-12.5, CCSS.ELA-Literacy.RST.11-12.10")
        ListItem():Strong("Standards For Mathmatical Practice: "):Text("CCSS.Math.Practice.MP1, CCSS.Math.Practice.MP2, CCSS.Math.Practice.MP4, CCSS.Math.Practice.MP5, CCSS.Math.Practice.MP6, CCSS.Math.Practice.MP7, CCSS.Math.Practice.MP8")
        Subsection("Vocabulary")
        BulletList()
        ListItem("Control Structures")
        ListItem("Conditional")
        ListItem("If statement")
        ListItem("Loops")
        ListItem("Input Manager")
    end

    private action Overview
        Section("Overview")
        Paragraph("This lab demonstrates how to use the InfraredSensor Library. You will use the Infrared Sensor to move the robot in the direction of the remote.")
        Subsection("Goal 1: Taking actions based on user input")
        Paragraph("Create a new Robot project. Name it properly and open the main.quorum file. In the top of the file type the appropriate code to use both the Quorum "):Code("InfraredSensor"):Text(" Library,and the "):Code("Motor"):Text(" library inside the "):Code("Lego"):Text(" library. After that, you will create objects from each library.")
        Subsection("Example: Declare a Motor object")
        CodeExample("// this line declares a Motor object called " + dq + "motor" + dq + "
Motor motor")
        Subsection("Activity: Declare an InfraredSensor object called infraredSensor")
        Paragraph("Sensors work differently than motors, in that you must set the port that the sensor is connected to. You will do that using the "):Code("SetPort"):Text(" statement.")
        Subsubsection("Example: Tell the port your Infrared Sensor is connected")
        CodeExample("// This line of code will set the port to work with
infraredSensor:SetPort(4)  //Inside the parentheses you should put the number of the port that your Infrared Sensor is connected")
    end

    private action ActivitySetTheDefaultSpeedOfTheMotorsYouMayChoos
        Section("Activity: Set the default speed of the motors. You may choose your speed")
        Subsection("Activity: Set the default speed of the motors. You may choose your speed")
        Paragraph("You should have some lines of code before the conditions. These lines and why you should use each of them are below:")
        CodeExample("//This first line gives a value for the loop to start. It will change once the loop starts so the value doesn't matter
integer direction = 0 
//This line starts the loop; it keeps the program working unless something break the loop
repeat while true 
//This line gives the number variable " + dq + "direction" + dq + " the value that comes back from the GetRemoteDirection statement, it takes as parameter the channel you're using on the remote 
number direction = infraredSensor:GetRemoteDirection(1)")
        Paragraph("The "):Code("GetRemoteDirection"):Text(" statement returns a value that represents the relative angle between the remote and the sensor. These values will be between -180 and 180.")
        Paragraph("For the "):Code("GetRemoteDirection"):Text(" statement to work, you need to press the large button (top center button) in the remote. Every condition, and the whole program, will only work if you press the button. That is what makes the repeat statement true.")
        Paragraph("You will use conditional statements to define how the robot will respond to the position of the remote.")
        Paragraph("The values between -180 and 180 represent the relative angle between the sensor and the remote. These values will be used in the conditional statements. If the value is negative, it means the remote is in the left of the robot; if the value is positive, the remote is to the right of the robot, and if the value is 0, the remote is directly ahead of the robot.")
    end

    private action ExampleNegativeValues
        Section("Example: Negative values")
        CodeExample("//This line checks to see if the condition returns a negative number
if direction < 0 
//These lines make the robot turn left, towards the remote
motor:RotateBackward(" + dq + "B" + dq + ")
motor:Stop(" + dq + "C" + dq + ")")
        Subsection("Activity: Add another statement to respond to positive values")
        Paragraph("Use an "):Code("elseif"):Text(" statement to make the robot turn left if direction > 0.")
        Paragraph("Our next condition also uses elseif, but now the only possible option it will be the value 0, so we don't need to specify that. We will define a minumum and maximum range the robot can be from the remote, so it will stop.")
        Paragraph():Strong("Example: Condition using the "):Code("GetRemoteDistance"):Strong(" statement.")
        CodeExample("//This line of code only runs if direction = 0, and the distance from the remote is between 10 cm and 50 cm (the maximum distance it could be from the remote) 
elseif infraredSensor:GetRemoteDistance(1) > 10 and infraredSensor:GetRemoteDistance(1) <= 50")
        Subsection("Activity: Write the code to make each motor move")
        Paragraph("You've already done the three possible direction conditions, so it's time to write the last condition, which is if none of these conditions are true. In that case the robot should stop both motors, to write that you'll use the else statement.")
        Subsubsection("Example: Last condition, in case none of the above is true")
        CodeExample("//These lines of code is to tell the motors to stop in any case that doesn't match the previous conditions
else
motor:Stop(" + dq + "B" + dq + ")
motor:Stop(" + dq + "C" + dq + ")
//These lines you use to finish the if loop and the repeat loop
end
end")
        Paragraph("You now have a working program, run and see if you get any errors. If you do, go back and fix it, otherwise just try to see if the robot is doing what you've told it to do when you keep the first button pressed with the remote in each position. Have fun!")
    end
end
