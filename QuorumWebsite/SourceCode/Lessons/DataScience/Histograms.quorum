use Libraries.Web.Page.QuorumPage

/*
    Histograms, Skew, and Kurtosis.
    Converted from the old Lesson page by plan 13's generator: the same
    words, now without Tailwind.
*/
class Histograms is QuorumPage
    // A double quote, for code and words that hold one.
    text dq = ""

    on create
        SetLocation("lessons/DataScience/histograms.html")
        // The name lists and links use, and the series and track it belongs
        // to: its section and picture.
        SetShortTitle("Histograms, Skew, and Kurtosis")
        SetSectionName("Data Science")
        // For search engines and link previews, and what lists of pages say.
        SetDescription("Histograms, Skew, and Kurtosis")
        SetSummary("Understanding distribution with historgrams, kurtosis, and skew using Quorum.")
    end

    action Setup
        dq = dq:GetDoubleQuote()
        SetWebPageTitle("Histograms, Skew, and Kurtosis")
        Title("Histograms, Skew, and Kurtosis")
        Paragraph("Understanding distribution using histograms, kurtosis, and skew")
        LearningObjectives()
        CreatingAHistogramUsingQuorumStudio10Minutes()
        ReadingAndDisplayingData5Minutes()
        LabelingTheHistogram10Minutes()
        CustomizingTheHistogram5Minutes()
        AccessingTheHistogram5Minutes()
        RelatingOurHistogramToSkewAndKurtosis10Minutes()
        RealWorldExamplesOfSkewAndKurtosis15Minutes()
        Skew()
        Kurtosis()
        RelevantCommonCoreStandards()
    end

    private action LearningObjectives
        Section("Learning Objectives")
        Paragraph("A histogram is a graphical representation that organizes a group of data points into user-specific rangers. It synthesizes a data series into an easily understandable visual representation by taking many data points and grouping them into logical ranges (or bins).")
        Paragraph("While a histogram looks similar to a bar chart (since they both use bars to represent the data), they are not technically the same. Histograms represent the frequency of distribution of variables in a data set while a bar chart typically represents a graphical comparison of categorical variables.")
        Paragraph("The student will learn:")
        BulletList()
        ListItem("Students will be able to create a histogram from a dataset.")
        ListItem("Students will be able to label information displayed on the histogram.")
        ListItem("Students will be able to customize histogram.")
        ListItem("Students will be able to access the information from the histogram using assistive technology.")
        Paragraph("To create a histogram, we will begin by creating a DataFrame. In order to do this, we will need to first download the "):Link("Airbnb NYC dataset", "https://raw.githubusercontent.com/qorf/curriculum/main/Reference/DataScience/Charts%20(New)/Data/Other/AB_NYC_2019.csv"):Text(" dataset (as a CSV file). We will then need to add the Factors and Columns before running the program to display the histogram. In this lesson we can follow the tutorial available on our website: "):Link("Histograms", "https://quorumlanguage.com/tutorials/charts/histogram.html")
    end

    private action CreatingAHistogramUsingQuorumStudio10Minutes
        Section("Creating a Histogram using Quorum Studio (10 Minutes)")
        Paragraph("To start us off we will download the dataset, so that we can have the means to create a bar chart.You can follow the link to download "):Link("Airbnb NYC dataset", "https://raw.githubusercontent.com/qorf/curriculum/main/Reference/DataScience/Charts%20(New)/Data/Other/AB_NYC_2019.csv"):Text(" dataset. If you are lost on how to download the dataset from GitHub, here is a link to our tutorial, "):Link("Downloading CSVs for our charts", "https://quorumlanguage.com/tutorials/charts/downloading.html")
        Paragraph("The Airbnb dataset describes public data of Airbnbs in New York City such as the name of the Airbnb, the host, the neighborhood, the price, room type, etc. It has 15 columns and 250 entries (rows) of listed Airbnb stays. We will be using one column, 'Price' for this lesson. Here is a snippet of what this dataset looks like:")
        Table("Airbnb Prices in NYC CSV")
        TableHeader():Cell("ID"):Cell("Name"):Cell("Host ID"):Cell("Host Name"):Cell("Neighborhood")
        TableRow():Cell("2539"):Cell("Clean & quiet apt home by the park"):Cell("2787"):Cell("John"):Cell("Brooklyn")
        TableRow():Cell("2595"):Cell("Skylit Midtown Castle"):Cell("2845"):Cell("Jennifer"):Cell("Manhattan")
        TableRow():Cell("3647"):Cell("THE VILLAGE OF HARLEM....NEW YORK !"):Cell("4632"):Cell("Elisabeth"):Cell("Manhattan")
        TableRow():Cell("3831"):Cell("Cozy Entire Floor of Brownstone"):Cell("4869"):Cell("LisaRoxanne"):Cell("Brooklyn")
        Paragraph("To start creating a Histogram, we need to import two libraries. "):Link("DataFrame", "https://quorumlanguage.com/Libraries/Compute/Statistics/DataFrame.html"):Text(", which is a frame where our chart will be drawn, and "):Link("Histogram", "https://quorumlanguage.com/Libraries/Interface/Controls/Charts/Histogram.html"):Text(", which allows us to create a histogram. Then we will initialize a DataFrame and load a comma separated values to the frame.")
    end

    private action ReadingAndDisplayingData5Minutes
        Section("Reading and Displaying Data (5 minutes)")
        Paragraph("Now that we have the histogram created, let us load the data from the "):Link("Airbnb NYC dataset", "https://raw.githubusercontent.com/qorf/curriculum/main/Reference/DataScience/Charts%20(New)/Data/Other/AB_NYC_2019.csv"):Text(" and display the histogram.")
        Paragraph("The steps that we describe in this task can be followed in the 'Loading and Formatting' section that is available in our "):Link("Histograms", "https://quorumlanguage.com/tutorials/charts/histogram.html"):Text(" tutorial.")
        Paragraph("Currently, we have only loaded the comma separated value file into the dataframe, and we are not reading anything from it. The first thing that we need to do is to load the columns and factors to be read by our bar chart. Specifically, we will add the one column that we will be using in this tutorial: 'Price.' After we have loaded the column, we need to create a histogram object using the frame that we have filled. Finally, we can display the content of that histogram. Next, we will be labeling and customizing our histogram.")
    end

    private action LabelingTheHistogram10Minutes
        Section("Labeling the Histogram (10 minutes)")
        Paragraph("The next step is to be able to add specific labels to the entire histogram, both axes, adding subtitles, and changing the font size of the print. Adding these features will allow us to present our data in a clearer way.")
        Paragraph("The steps that we describe in this task can be followed in the 'Labeling the Histogram' section that is available in our "):Link("Histograms", "https://quorumlanguage.com/tutorials/charts/histogram.html"):Text(" tutorial.")
        Paragraph("First, we will add labels for our chart, x-axis, and y-axis. This allows the reader to distinguish between the information and to understand what data they are looking at. For our chart we can label it the following way: title - 'Price per night with AirBnB in 2019 (NYC)'; x-axis - 'Price ($)'; y-axis - 'Number of Stays.' If we feel like those labels are not enough, we can add a subtitle to the histogram. For example, for this histogram the subtitle can be 'How expensive is it to stay in NYC?'")
    end

    private action CustomizingTheHistogram5Minutes
        Section("Customizing the Histogram (5 minutes)")
        Paragraph("For this lesson, we will explore how to change the color palette, change the tick interval, and adjust the x axis minimum value. The lesson uses the warm palette but there are many options of colors to choose from to attempt; regarding other color palettes we have reference using the information on the "):Link("Color Accessibility", "https://quorumlanguage.com/tutorials/charts/coloraccessibility.html"):Text(" page.")
        Paragraph("The steps that we describe in this task can be followed in the 'Customizing the Histogram' section that is available in our "):Link("Histograms", "https://quorumlanguage.com/tutorials/charts/histogram.html"):Text(" tutorial. Changing the tick interval involves the range between two values in our histogram. We want to also modify the x axis to demonstrate further customization of our histogram by being able to adjust what value our chart can start on.")
    end

    private action AccessingTheHistogram5Minutes
        Section("Accessing the Histogram (5 minutes)")
        Paragraph("Now let us explore the graphic using the accessibility tools on our devices. When the histogram has been created, we should see our chart pop up in a separate window. From there, we can reference this "):Link("tutorial on keyboard navigation", "https://quorumlanguage.com/tutorials/charts/charttextnavigation.html"):Text(" using the arrow keys for accessibility. One note is that when a bar chart is saved onto our computer devices, they save as an SVG (scalable vector graphic) which maintains not only resizability but accessibility to read these charts using a screen reader.")
    end

    private action RelatingOurHistogramToSkewAndKurtosis10Minutes
        Section("Relating our Histogram to Skew and Kurtosis (10 Minutes)")
        Paragraph("In math, we often have two primary concepts when thinking about histograms, Skew and Kurtosis. We measure skew as a number, positive or negative, which references whether the data set is shifted in one direction or the other. A skew of 0 means that the data is symmetrical around the mean. A positive skew, or right skew, indicates the tail of the data is longer above the mean. We can follow this "):Link("tutorial on how to calculate skew", "https://quorumlanguage.com/tutorials/Summarizing/skew.html"):Text(" in Quorum.")
        MathFromProject("examples/MathXML/Skew.xml")
        Paragraph("Kurtosis relates to determining the heaviness of the distribution. Having high kurtosis means that in the dataset, we have many outliers and having low kurtosis means a lack of outliers. There are technical terms we can look up for these properties, but they are used rarely even in the academic literature and are not important to memorize. We can follow this "):Link("tutorial on how to calculate kurtosis", "https://quorumlanguage.com/tutorials/Summarizing/kurtosis.html"):Text(" in Quorum.")
        MathFromProject("examples/MathXML/Kurtosis.xml")
        Paragraph("Note that while we present the equation here in MathJax form (visual and accessible), memorizing this equation is not important. The entire purpose of data science is to abstract away some of this mathematics in a programming language, to obtain the results of the equation without having to understand the nuance. If we did not do that, realistically data science would be too difficult for any one person to understand.")
    end

    private action RealWorldExamplesOfSkewAndKurtosis15Minutes
        Section("Real World Examples of Skew and Kurtosis (15 Minutes)")
        Paragraph("In this section, we will be showing graphs of skew and kurtosis to better understand the shape and how we can visually see these measurements using a histogram.")
    end

    private action Skew
        Section("Skew")
        Paragraph("For this exercise we will be using two datasets which can be downloaded from the following links: "):Link("Number of Children CSV", "https://raw.githubusercontent.com/qorf/curriculum/main/Reference/DataScience/Charts%20(New)/Data/Miscellaneous/numberOfChildren.csv"):Text(" and "):Link("Exam Scores CSV", "https://raw.githubusercontent.com/qorf/curriculum/main/Reference/DataScience/Charts%20(New)/Data/Miscellaneous/exams.csv"):Text(". The graph with the number of children will demonstrate a histogram with a right skew while the graph with Exam Scores will demonstrate a histogram with a left skew.")
        Subsection("Right Skew")
        CodeExample("use Libraries.Compute.Statistics.DataFrame
use Libraries.Interface.Controls.Charts.Histogram

/*
    This is an example of a Histogram built in quorum.
    The dataset we will be working with compares life spans of various dog breeds
*/

// create frame component
DataFrame frame
// read in data from dog csv
frame:Load('../Data/Miscellaneous/numberOfChildren.csv')

// pull out specific columns from csv that we are comparing
// note: histograms do not support factors
frame:AddSelectedColumns('Number of Children')

// create histogram object
// this will create two separate data charts to compare
Histogram chart = frame:Histogram()
chart:SetTitle('Number of Children for Arbitrary Families')
// let's adjust the font size so it appears nicely on the screen
chart:SetTitleFontSize(20)

// label the x axis, y axis, and the legend title
chart:SetXAxisTitle('Number of Children')
chart:SetYAxisTitle('Total Individuals')
chart:SetLegendTitle('People who have children')
// add subtitle for more description
chart:SetSubtitle('Age ranges of Dog Breeds')

// customization features
chart:SetColorPaletteToTrustworthy()
// define a clear interval, we separate each interval by 2
chart:SetXTickInterval(1)
// let's start our chart at 0 to examine a curve as a whole
chart:SetXAxisMinimum(0)
// let's also extend our y axis to see the skew
chart:SetYAxisMaximum(40)
chart:SetXAxisMaximum(10)

// display the histogram
chart:Display()")
        CodeEditorWithCode("Example of a Histogram with Right Skew", "use Libraries.Compute.Statistics.DataFrame
use Libraries.Interface.Controls.Charts.Histogram

/*
    This is an example of a Histogram built in quorum.
    The dataset we will be working with compares life spans of various dog breeds
*/

// create frame component
DataFrame frame
// read in data from dog csv
frame:Load(" + dq + "data/numberOfChildren.csv" + dq + ")

// pull out specific columns from csv that we are comparing
// note: histograms do not support factors
frame:AddSelectedColumns(" + dq + "Number of Children" + dq + ")

// create histogram object
// this will create two separate data charts to compare
Histogram chart = frame:Histogram()
chart:SetTitle(" + dq + "Number of Children for Arbitrary Families" + dq + ")
// let's adjust the font size so it appears nicely on the screen
chart:SetTitleFontSize(20)

// label the x axis, y axis, and the legend title
chart:SetXAxisTitle(" + dq + "Number of Children" + dq + ")
chart:SetYAxisTitle(" + dq + "Total Individuals" + dq + ")
chart:SetLegendTitle(" + dq + "People who have children" + dq + ")
// add subtitle for more description
chart:SetSubtitle(" + dq + "Age ranges of Dog Breeds" + dq + ")

// customization features
chart:SetColorPaletteToTrustworthy()
// define a clear interval, we separate each interval by 2
chart:SetXTickInterval(1)
// let's start our chart at 0 to examine a curve as a whole
chart:SetXAxisMinimum(0)
// let's also extend our y axis to see the skew
chart:SetYAxisMaximum(40)
chart:SetXAxisMaximum(10)

// display the histogram
chart:Display()
")
        Subsection("Left Skew")
        CodeExample("use Libraries.Compute.Statistics.DataFrame
use Libraries.Interface.Controls.Charts.Histogram

/*
    This is an example of a Histogram built in quorum.
    The dataset we will be working with compares life spans of various dog breeds
*/

// create frame component
DataFrame frame
// read in data from dog csv
frame:Load('../Data/Miscellaneous/exams.csv')

// pull out specific columns from csv that we are comparing
// note: histograms do not support factors
frame:AddSelectedColumns('math score')

// create histogram object
// this will create two separate data charts to compare
Histogram chart = frame:Histogram()
chart:SetTitle('Number of Children for Arbitrary Families')
// let's adjust the font size so it appears nicely on the screen
chart:SetTitleFontSize(20)

// label the x axis, y axis, and the legend title
chart:SetXAxisTitle('Number of Children')
chart:SetYAxisTitle('Total Individuals')
chart:SetLegendTitle('People who have children')
// add subtitle for more description
chart:SetSubtitle('Age ranges of Dog Breeds')

// customization features
chart:SetColorPaletteToTrustworthy()
// define a clear interval, we separate each interval by 2
chart:SetXTickInterval(5)
// let's start our chart at 0 to examine a curve as a whole
chart:SetXAxisMinimum(0)
// let's also extend our y axis to see the skew
chart:SetYAxisMaximum(20)
chart:SetXAxisMaximum(100)

// display the histogram
chart:Display()")
        CodeEditorWithCode("Example of a Histogram with Left Skew", "use Libraries.Compute.Statistics.DataFrame
use Libraries.Interface.Controls.Charts.Histogram

/*
    This is an example of a Histogram built in quorum.
    The dataset we will be working with compares life spans of various dog breeds
*/

// create frame component
DataFrame frame
// read in data from dog csv
frame:Load(" + dq + "data/exams.csv" + dq + ")

// pull out specified columns from csv that we are comparing
// note: histograms do not support factors
frame:AddSelectedColumns(" + dq + "math score" + dq + ")

// create histogram object
// this will create two separate data charts to compare
Histogram chart = frame:Histogram()
chart:SetTitle(" + dq + "Number of Children for Arbitrary Families" + dq + ")
// let's adjust the font size so it appears nicely on the screen
chart:SetTitleFontSize(20)

// label the x axis, y axis, and the legend title
chart:SetXAxisTitle(" + dq + "Number of Children" + dq + ")
chart:SetYAxisTitle(" + dq + "Total Individuals" + dq + ")
chart:SetLegendTitle(" + dq + "People who have children" + dq + ")
// add subtitle for more description
chart:SetSubtitle(" + dq + "Age ranges of Dog Breeds" + dq + ")

// customization features
chart:SetColorPaletteToTrustworthy()
// define a clear interval, we separate each interval by 2
chart:SetXTickInterval(5)
// let's start our chart at 0 to examine a curve as a whole
chart:SetXAxisMinimum(0)
// let's also extend our y axis to see the skew
chart:SetYAxisMaximum(20)
chart:SetXAxisMaximum(100)

// display the histogram
chart:Display()
")
    end

    private action Kurtosis
        Section("Kurtosis")
        Paragraph("For this exercise we will be using two datasets which can be downloaded from the following links: "):Link("Iris classification CSV", "https://raw.githubusercontent.com/qorf/curriculum/main/Reference/DataScience/Charts%20(New)/Data/Science/Iris.csv"):Text(" and "):Link("Electric Cars (EVs) CSV", "https://raw.githubusercontent.com/qorf/curriculum/main/Reference/DataScience/Charts%20(New)/Data/Miscellaneous/Cars%201.csv"):Text(". The graph with Irises will demonstrate a histogram with a high kurtosis while the graph with EVs will demonstrate a histogram with a low kurtosis.")
        Subsection("High Kurtosis")
        CodeExample("use Libraries.Compute.Statistics.DataFrame
use Libraries.Interface.Controls.Charts.Histogram

/*
    This is an example of a Histogram built in quorum
*/

// create frame component
DataFrame frame
// read in data from dog csv
frame:Load('../Data/Science/Iris.csv')

// pull out specific columns from csv that we are comparing
// note: histograms do not support factors
frame:AddSelectedColumns('SepalWidthCm')

// create histogram object
// this will create two separate data charts to compare
Histogram chart = frame:Histogram()
chart:SetTitle('Iris Classification')
// let's adjust the font size so it appears nicely on the screen
chart:SetTitleFontSize(20)

// label the x axis, y axis, and the legend title
chart:SetXAxisTitle('Sepal Width (CM)')
chart:SetYAxisTitle('Number of Irises')
chart:SetLegendTitle('Measurements of Iris')
// add subtitle for more description
chart:SetSubtitle('Age ranges of Dog Breeds')

// customization features
chart:SetColorPaletteToTrustworthy()
// define a clear interval, we separate each interval by 2
chart:SetXTickInterval(0.2)
// let's start our chart at 0 to examine a curve as a whole
chart:SetXAxisMinimum(0)
chart:SetXAxisMaximum(6)

// display the histogram
chart:Display()")
        CodeEditorWithCode("Example of a Histogram with High Kurtosis", "use Libraries.Compute.Statistics.DataFrame
use Libraries.Interface.Controls.Charts.Histogram

/*
    This is an example of a Histogram built in quorum
*/

// create frame component
DataFrame frame
// read in data from dog csv
frame:Load(" + dq + "data/Iris.csv" + dq + ")

// pull out specific columns from csv that we are comparing
// note: histograms do not support factors
frame:AddSelectedColumns(" + dq + "SepalWidthCm" + dq + ")

// create histogram object
// this will create two separate data charts to compare
Histogram chart = frame:Histogram()
chart:SetTitle(" + dq + "Iris Classification" + dq + ")
// let's adjust the font size so it appears nicely on the screen
chart:SetTitleFontSize(20)

// label the x axis, y axis, and the legend title
chart:SetXAxisTitle(" + dq + "Sepal Width (CM)" + dq + ")
chart:SetYAxisTitle(" + dq + "Number of Irises" + dq + ")
chart:SetLegendTitle(" + dq + "Measurements of Iris" + dq + ")
// add subtitle for more description
chart:SetSubtitle(" + dq + "Age ranges of Dog Breeds" + dq + ")

// customization features
chart:SetColorPaletteToTrustworthy()
// define a clear interval, we separate each interval by 2
chart:SetXTickInterval(0.2)
// let's start our chart at 0 to examine a curve as a whole
chart:SetXAxisMinimum(0)
chart:SetXAxisMaximum(6)

// display the histogram
chart:Display()
")
        Subsection("Low Kurtosis")
        Paragraph("With this dataset example, take notice in the first half of the histogram, there is a smaller bell curve which represents the low kurtosis.")
        CodeExample("use Libraries.Compute.Statistics.DataFrame
use Libraries.Interface.Controls.Charts.Histogram

/*
    This is an example of a Histogram built in quorum
*/

// create frame component
DataFrame frame
// read in data from dog csv
frame:Load('../Data/Miscellaneous/Cars 1.csv')

// pull out specific columns from csv that we are comparing
// note: histograms do not support factors
frame:AddSelectedColumns('Dimensions.Width')

// create histogram object
// this will create two separate data charts to compare
Histogram chart = frame:Histogram()
chart:SetTitle('EV Cars')
// let's adjust the font size so it appears nicely on the screen
chart:SetTitleFontSize(20)

// label the x axis, y axis, and the legend title
chart:SetXAxisTitle('Car Dimension')
chart:SetYAxisTitle('Number of Cars')
chart:SetLegendTitle('Attributes of EV Cars')
// add subtitle for more description
chart:SetSubtitle('Age ranges of Dog Breeds')

// customization features
chart:SetColorPaletteToTrustworthy()
// define a clear interval, we separate each interval by 2
chart:SetXTickInterval(10)
// let's start our chart at 0 to examine a curve as a whole
chart:SetXAxisMinimum(1)
chart:SetXAxisMaximum(250)

// display the histogram
chart:Display()")
        CodeEditorWithCode("Example of a Histogram with Low Kurtosis", "use Libraries.Compute.Statistics.DataFrame
use Libraries.Interface.Controls.Charts.Histogram

/*
    This is an example of a Histogram built in quorum
*/

// create frame component
DataFrame frame
// read in data from dog csv
frame:Load(" + dq + "data/Cars 1.csv" + dq + ")

// pull out specified columns from csv that we are comparing
// note: histograms do not support factors
frame:AddSelectedColumns(" + dq + "Dimensions.Width" + dq + ")

// create histogram object
// this will create two separate data charts to compare
Histogram chart = frame:Histogram()
chart:SetTitle(" + dq + "EV Cars" + dq + ")
// let's adjust the font size so it appears nicely on the screen
chart:SetTitleFontSize(20)

// label the x axis, y axis, and the legend title
chart:SetXAxisTitle(" + dq + "Car Dimension" + dq + ")
chart:SetYAxisTitle(" + dq + "Number of Cars" + dq + ")
chart:SetLegendTitle(" + dq + "Attributes of EV Cars" + dq + ")
// add subtitle for more description
chart:SetSubtitle(" + dq + "Age ranges of Dog Breeds" + dq + ")

// customization features
chart:SetColorPaletteToTrustworthy()
// define a clear interval, we separate each interval by 2
chart:SetXTickInterval(10)
// let's start our chart at 0 to examine a curve as a whole
chart:SetXAxisMinimum(1)
chart:SetXAxisMaximum(250)

// display the histogram
chart:Display()
")
        Paragraph("With these examples, let us take time to discuss the differences between each graph and examine the shape in relation to skew and kurtosis.")
    end

    private action RelevantCommonCoreStandards
        Section("Relevant Common Core Standards")
        Paragraph("We use the following "):Link("website", "https://corestandards.org/wp-content/uploads/2023/09/ADA-Compliant-Math-Standards.pdf"):Text(" for common core standards in relation to histograms and measurements of distribution.")
        Paragraph():Link("CCSS.MATH.CONTENT.HSS.ID.A.1", "https://corestandards.org/wp-content/uploads/2023/09/ADA-Compliant-Math-Standards.pdf"):Text(": Represent data with plots on the real number line (dot plots, histograms, and box plots)."):Link("CCSS.MATH.CONTENT.HSS.ID.A.2", "https://corestandards.org/wp-content/uploads/2023/09/ADA-Compliant-Math-Standards.pdf"):Text(": Use statistics appropriate to the shape of the data distribution to compare center (median, mean) and spread (interquartile range, standard deviation) of two or more different data sets."):Link("CCSS.MATH.CONTENT.HSS.ID.A.3", "https://corestandards.org/wp-content/uploads/2023/09/ADA-Compliant-Math-Standards.pdf"):Text(": Interpret differences in shape, center, and spread in the context of the data sets, accounting for possible effects of extreme data points (outliers). "):Link("CCSS.MATH.CONTENT.HSS.ID.A.4", "https://corestandards.org/wp-content/uploads/2023/09/ADA-Compliant-Math-Standards.pdf"):Text(": Use the mean and standard deviation of a data set to fit it to a normal distribution and to estimate population percentages. Recognize that there are data sets for which such a procedure is not appropriate. Use calculators, spreadsheets, and tables to estimate areas under the normal curve.")
    end
end
