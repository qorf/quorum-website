use Libraries.Web.Page.QuorumPage

/*
    DO-IT Summer Study: Activity.
    Converted from the old Lesson page by plan 13's generator: the same
    words, now without Tailwind.
*/
class Activity is QuorumPage

    on create
        SetLocation("lessons/DataScience/DOITSummerStudy/activity.html")
        // The name lists and links use, and the series and track it belongs
        // to: its section and picture.
        SetShortTitle("Activity")
        // For search engines and link previews, and what lists of pages say.
        SetDescription("DO-IT Summer Study")
        SetSummary("DO-IT Summer Study Presentation, navigating accessible charts")
    end

    action Setup
        SetWebPageTitle("DO-IT Summer Study: Activity")
        // Its editors and charts use the charts script.
        UseCharts()
        Title("DO-IT Summer Study: Activity")
        Paragraph("Overview of using charts in Quorum")
        DOITSummerStudyActivity()
        Chart1()
        Chart2()
        NextFeedback()
    end

    private action DOITSummerStudyActivity
        Section("DO-IT Summer Study: Activity")
    end

    private action Chart1
        Section("Chart 1")
        Chart("media/lessons/DataScience/DOITSummerStudy/histogram_activity.svg")
        Paragraph("Live Caption:")
        Paragraph("Questions:")
        BulletList()
        ListItem("What type of chart is this?")
        ListItem("What does the x axis show?")
        ListItem("What does the y axis show?")
        ListItem("What is the frequency value of the bin between 4 and 6 rating in the Pepsi sub chart?")
        ListItem("The highest frequency occured in the rating bin between __ and __ in the Coke sub chart?")
        ListItem("What's the difference between the Pepsi and Coke sub charts' frequency in the bin between 2 and 4 rating?")
        ListItem("Are either of the sub charts skewed? If so, in what direction?")
    end

    private action Chart2
        Section("Chart 2")
        Chart("media/lessons/DataScience/DOITSummerStudy/scatter_activity.svg")
        Paragraph("Live Caption:")
        Paragraph("Questions:")
        BulletList()
        ListItem("What type of chart is this?")
        ListItem("What does the x axis show?")
        ListItem("What does the y axis show?")
        ListItem("Can you describe the content of the chart?")
        ListItem("Does the plot have a trend? If so, what is the trend?")
        ListItem("Are there any outliers?")
        ListItem("Is the point at (34,721) above or below the trend line? By how many units?")
        ListItem("Do any of the points seem to be clustered together?")
    end

    private action NextFeedback
        Section("Next: Feedback")
        Paragraph("In the next section, we will dicuss some "):Link("Feedback", "/lessons/DataScience/DOITSummerStudy/feedback.html"):Text(" about the charts.")
    end
end
