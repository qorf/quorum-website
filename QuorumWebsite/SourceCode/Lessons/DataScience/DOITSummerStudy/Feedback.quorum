use Libraries.Web.Page.QuorumPage

/*
    DO-IT Summer Study: Feedback.
    Converted from the old Lesson page by plan 13's generator: the same
    words, now without Tailwind.
*/
class Feedback is QuorumPage

    on create
        SetLocation("lessons/DataScience/DOITSummerStudy/feedback.html")
        // The name lists and links use, and the series and track it belongs
        // to: its section and picture.
        SetShortTitle("Feedback")
        // For search engines and link previews, and what lists of pages say.
        SetDescription("DO-IT Summer Study")
        SetSummary("DO-IT Summer Study Presentation, navigating accessible charts")
    end

    action Setup
        SetWebPageTitle("DO-IT Summer Study: Feedback")
        // Its editors and charts use the charts script.
        UseCharts()
        Title("DO-IT Summer Study: Feedback")
        Paragraph("Feedback about using charts in Quorum")
        DOITSummerStudyFeedback()
        VisualsOfCharts()
        ChartNavigation()
        ScatterPlot()
        TouchGestures()
    end

    private action DOITSummerStudyFeedback
        Section("DO-IT Summer Study: Feedback")
    end

    private action VisualsOfCharts
        Section("Visuals of Charts")
        Subsection("Histogram")
        Chart("media/lessons/DataScience/DOITSummerStudy/histogram_activity.svg")
        Paragraph("Live Caption:")
        Subsection("Scatter Plot")
        Chart("media/lessons/DataScience/DOITSummerStudy/scatter_activity.svg")
        Paragraph("Live Caption:")
    end

    private action ChartNavigation
        Section("Chart Navigation")
        Paragraph("Questions:")
        BulletList()
        ListItem("What did you think of the keys used to navigate the chart? (tab, shift + tab, enter, shift + enter, arrow keys, page up/down)")
        ListItem("When focused on a bin in the histogram, what would you like to have described? For example, order of information or wording.")
        ListItem("When focused on a point in the scatter plot, what would you like to have described? For example, order of information or wording.")
    end

    private action ScatterPlot
        Section("Scatter Plot")
        Paragraph("Questions:")
        BulletList()
        ListItem("Scatter plots can become very complex as more points are added. If there were a million points, how would you want to navigate or what sort of information would you want to be able to hear about?")
    end

    private action TouchGestures
        Section("Touch Gestures")
        Paragraph("Questions:")
        BulletList()
        ListItem("If you were using these charts on a touchscreen devices, what sort of touch gestures would you want to use for the different navigation actions? (single tap, double tap, long press, swipe, pan, pinch zoom)")
    end
end
