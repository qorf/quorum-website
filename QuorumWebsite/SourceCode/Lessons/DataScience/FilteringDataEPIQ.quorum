use Libraries.Web.Page.QuorumPage

/*
    Filtering Data.
    Converted from the old Lesson page by plan 13's generator: the same
    words, now without Tailwind.
*/
class FilteringDataEPIQ is QuorumPage

    on create
        SetLocation("lessons/DataScience/filteringData.html")
        // The name lists and links use, and the series and track it belongs
        // to: its section and picture.
        SetShortTitle("Filtering data")
        SetSectionName("Data Science")
        // For search engines and link previews, and what lists of pages say.
        SetDescription("Filtering data")
        SetSummary("Understanding statistics and how to filter data using Quorum.")
    end

    action Setup
        SetWebPageTitle("Filtering Data")
        Title("Filtering Data")
        Paragraph("Understanding statistics and how to filter data using Quorum")
        LearningObjectives()
        FilteringByRowsAndColumns25Minutes()
        ReplacingAndRemovingUndefinedValues25Minutes()
    end

    private action LearningObjectives
        Section("Learning Objectives")
        Paragraph("In the real world, when finding datasets, many of the times we have to transform or clean our data. Datasets may contain values that are incorrectly formatted or are missing. Columns may need to be added, deleted, combined, or split up. We will be referencing this "):Link("overview", "https://quorumlanguage.com/tutorials/Transformations/overview.html"):Text(" on why we need to filter data. Let us specifically look at the "):Link("dataset", "https://www.askamanager.org/2021/04/how-much-money-do-you-make-4.html"):Text(" and observe key sections of why this is seen as a messy dataset.")
        Paragraph("Finally, let us remind ourselves what it means to have "):Link("Tidy", "https://cran.r-project.org/web/packages/tidyr/vignettes/tidy-data.html"):Text(" data. The biggest take away is that Quorum uses the Tidy data format to provide a standardized format on how datasets should be structured. Keep in mind that there are good reasons in computer science to not have data be in a Tidy format, especially when large databases are involved, but this format is still very useful for many real-world datasets.")
        Paragraph("The student will learn:")
        BulletList()
        ListItem("Students will be able to learn why clean data is important.")
        ListItem("Students will be able to 'filter' data by both rows and columns.")
        ListItem("Students will be able to remove and replace undefined values in a dataset.")
    end

    private action FilteringByRowsAndColumns25Minutes
        Section("Filtering by Rows and Columns (25 Minutes)")
        Paragraph("Filtering rows and columns help data scientists remove any unnecessary information within a dataset. As an example, let us say we have a dataset of over 10000 entries of data for household income. However, we only want to focus on entries that are between the income brackets of $50,000 to $70,000 which makes a lot of other cells unrelated to our analysis. We can remove all the rows pertaining to entries outside our desired range by filtering.")
        Paragraph("We will start off with referencing this "):Link("tutorial on how to filter by rows", "https://quorumlanguage.com/tutorials/Transformations/FilteringRows.html"):Text(" and discuss the changes made on our DataFrame. Then, we will immediately follow another "):Link("tutorial on how to filter by columns", "https://quorumlanguage.com/tutorials/Transformations/FilteringColumns.html"):Text(". Notice the different methods used to filter rows and columns; while filtering columns may seem more complicated than filtering rows, they both accomplish the same idea of transforming our DataFrame.")
    end

    private action ReplacingAndRemovingUndefinedValues25Minutes
        Section("Replacing and Removing Undefined Values (25 Minutes)")
        Paragraph("Another method of cleaning up our datasets is to remove or replace undefined values. Undefined values are cells that are blank. This is an example of a portion of our previously used "):Link("AskAManager dataset", "https://github.com/qorf/quorum-website/blob/main/QuorumWebsite/html/data/AskAManager.csv"):Text(", which contains undefined values. We can take time to go over more in this dataset that contains pieces of missing values, but overall, the idea here is to demonstrate that we can adjust these values in our data automatically if we want to.")
        Table("Ask a Manager CSV")
        TableHeader():Cell("How old are you?"):Cell("What industry do you work in?"):Cell("Job title"):Cell("If your job title needs additional context, please clarify here:"):Cell("What is your annual salary?"):Cell("How much additional monetary compensation do you get, if any?")
        TableRow():Cell("25-34"):Cell("Education (Higher Education)"):Cell("Research and Instruction Librarian"):Cell(""):Cell("55,000"):Cell("0")
        TableRow():Cell("25-34"):Cell("Computing or Tech"):Cell("Change & Internal Communications Manager"):Cell(""):Cell("54,600"):Cell("4000")
        TableRow():Cell("25-34"):Cell("Accounting, Banking & Finance"):Cell("Marketing Specialist"):Cell(""):Cell("34,000"):Cell("")
        TableRow():Cell("25-34"):Cell("Nonprofits"):Cell("Program Manager"):Cell(""):Cell("62,000"):Cell("3000")
        TableRow():Cell("25-34"):Cell("Accounting, Banking & Finance"):Cell("Accounting Manager"):Cell(""):Cell("50,000"):Cell("7000")
        Paragraph("To modify our undefined values we will be referencing this tutorial on how to "):Link("replace undefined values", "https://quorumlanguage.com/tutorials/Transformations/ReplacingUndefined.html"):Text(" and "):Link("remove undefined values", "https://quorumlanguage.com/tutorials/Transformations/RemovingUndefined.html"):Text(". There are many other techniques available for cleaning data.")
    end
end
