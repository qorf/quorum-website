use Libraries.Web.Page.QuorumPage

/*
    Box Plots, Violin Plots, and Understanding Dispersion.
    Converted from the old Lesson page by plan 13's generator: the same
    words, now without Tailwind.
*/
class BoxViolinDispersion is QuorumPage
    // A double quote, for code and words that hold one.
    text dq = ""

    on create
        SetLocation("lessons/DataScience/boxViolinDispersion.html")
        // The name lists and links use, and the series and track it belongs
        // to: its section and picture.
        SetShortTitle("Box Plots, Violin Plots, and Understanding Dispersion")
        SetSectionName("Data Science")
        // For search engines and link previews, and what lists of pages say.
        SetDescription("Box Plots, Violin Plots, and Understanding Dispersion")
        SetSummary("Understanding statistics and how to calculate important values using Quorum.")
    end

    action Setup
        dq = dq:GetDoubleQuote()
        SetWebPageTitle("Box Plots, Violin Plots, and Understanding Dispersion")
        // Its editors and charts use the charts script.
        UseCharts()
        Title("Box Plots, Violin Plots, and Understanding Dispersion")
        Paragraph("Understanding statistics and how to calculate important values using Quorum")
        LearningObjectives()
        UnderstandingDispersionThroughBoxPlotsAndViolinP()
        StandardDeviation()
        Variance()
        ProbabilityDensity()
        IQROnABoxPlot()
        CreatingABoxPlotUsingQuorumStudio10Minutes()
        LabelingAndCustomizingTheBoxPlots5Minutes()
        AccessingTheBoxPlot5Minutes()
        CreatingAViolinPlotUsingQuorumStudio10Minutes()
        LabelingAndCustomizingTheViolinPlots5Minutes()
        AccessingTheViolinPlots5Minutes()
        BreakOutGroupDiscussion5Minutes()
        RelevantCommonCoreStandards()
    end

    private action LearningObjectives
        Section("Learning Objectives")
        Paragraph("A box plot (also known as box and whisker plot) is a type of chart used to visually show the distribution of numerical data and skewness through displaying the data quartiles (or percentiles) and averages. Similar to box plots, violin plots also depict percentiles, however we can see how dense our data is. Overall, we often use chart types like these to better understand dispersion, or how and where our data varies.")
        Paragraph("The student will learn:")
        BulletList()
        ListItem("Students will be able to create a box plot and violin from a dataset.")
        ListItem("Students will be able to label information displayed on the box plot, customize it, and use assistive technology with a box plot.")
        ListItem("Students will be able to label information displayed on the violin plot, customize it, and use assistive technology with a violin plot.")
        ListItem("Students will be able to understand the dispersion in relation to these two plots.")
    end

    private action UnderstandingDispersionThroughBoxPlotsAndViolinP
        Section("Understanding Dispersion through Box Plots and Violin Plots (15 Minutes)")
        Paragraph("Dispersion, also known as the variability, scatter, or spread, measures how data is either squeezed or stretched. Measures of dispersion would be variance, standard deviation, and interquartile range. Variance is defined as how far the data set is spread out while standard deviation tells us how far the data is spread out.")
    end

    private action StandardDeviation
        Section("Standard Deviation")
        MathFromProject("examples/MathXML/StandardDeviation.xml")
    end

    private action Variance
        Section("Variance")
        MathFromProject("examples/MathXML/Variance.xml")
        Paragraph("With high dispersion, this means that the data values are more spread out / scattered, but if there is a low dispersion, this means that the data values are more clustered. We can learn more about how to calculate standard deviation and variance using the "):Link("following tutorial", "https://quorumlanguage.com/tutorials/Summarizing/varAndSD.html"):Text(".")
    end

    private action ProbabilityDensity
        Section("Probability Density")
        Paragraph("We have a violin plot showcasing high and low dispersion. We can notice an obviously low dispersion in the last column of repeating violin plots meaning lower density. The violin plot is separated by what conditions the weather is in and we examine different factors according to the weather. A violin plot works great to see the changes in temperature since it displays the density.")
        Chart("media/epiq/datascience/ViolinPlotEpiq.svg")
        Paragraph("Interquartile range (IQR) is another measure of dispersion that fits well using a box plot. IQR measures the spread of the middle half of our data, meaning it takes the upper quartile of our data and subtracts it from the lower quartile of our data to get the middle (50%). The IQR will give us a measurement of how spread out our entire dataset is. We can learn more about how to calculate the IQR with the "):Link("following tutorial", "https://quorumlanguage.com/tutorials/Summarizing/iqr.html"):Text(".")
    end

    private action IQROnABoxPlot
        Section("IQR on a Box Plot")
        Paragraph("Here we have a box plot to examine the IQR. Note that the IQR is equal to subtracting the upper quartile from the lower quartile. Box plot separates itself into four sections of 25% where we can see the upper and lower quartles, as well as the median.")
        Chart("media/epiq/datascience/BoxEpiq.svg")
        Paragraph("Similar to histograms, box plots and violin plots also help describe the shape to determine dispersion within our datasets. "):Link("Box plots", "https://chartio.com/learn/charts/box-plot-complete-guide/"):Text(" are great tools for basic summary statistics such as finding IQR, skew, outliers, etc. However, we do not actually see the dispersion in the data. On the other hand, "):Link("violin plots", "https://mode.com/blog/violin-plot-examples/"):Text(" provide visual dispersion through its display of peaks. This is important because we depict summary statistics and the density of each variable.")
        Paragraph("Now, let us view some violin plots and box plots with high and low dispersion. We will be using a dataset involving exam scores for both plots, and we can view this dataset by clicking on the following link: "):Link("exam score CSV", "https://raw.githubusercontent.com/qorf/curriculum/main/Reference/DataScience/Charts%20(New)/Data/Miscellaneous/exams.csv"):Text(".")
        Paragraph("This is an example of a box plot with low dispersion and high dispersion regarding test scores. Notice how values are closer together / compact versus being spread out for subjects such as reading. We can also see that math does have a higher dispersion compared to the reading and writing scores. We can assume that there is more variation of lower scores for math due to difficulty in understanding such topics compared to English and writing.")
        CodeExample("use Libraries.Compute.Statistics.DataFrame
use Libraries.Interface.Controls.Charts.BoxPlot

// create frame component
DataFrame frame
// read in data from height of male and female by country 2022 csv
frame:Load(" + dq + "../Data/Miscellaneous/peopleData.csv" + dq + ")

// pull out specified columns from csv that we are comparing
frame:AddSelectedColumns(" + dq + "Experience (Years)" + dq + ")
frame:AddSelectedColumns(" + dq + "Number of Children" + dq + ")

// create histogram object
// this will create two separate data charts to compare
BoxPlot chart = frame:BoxPlot()
chart:SetTitle(" + dq + "Randomized Data on People" + dq + ")
// let's adjust the font size so it appears nicely on the screen
chart:SetTitleFontSize(20)

// label the x axis, y axis, and the legend title
chart:SetXAxisTitle(" + dq + "Children and Years of Experience" + dq + ")
chart:SetYAxisTitle(" + dq + "Demographics" + dq + ")
// add subtitle for more description
chart:SetSubtitle(" + dq + "An arbitrary dataset about random people and their lives" + dq + ")
chart:HideOutliers()

// customization features
chart:SetColorPaletteToPlayful()
// define a clear interval, we separate each interval by 10
chart:SetYTickInterval(10)
chart:SetXAxisMinimum(0)
chart:FlipOrientation()


// display the box plot
chart:Display()")
        CodeEditorWithCode("Example of a Box Plot with high and low dispersion", "use Libraries.Compute.Statistics.DataFrame
use Libraries.Interface.Controls.Charts.BoxPlot

// create frame component
DataFrame frame
// read in data from height of male and female by country 2022 csv
frame:Load(" + dq + "data/peopleData.csv" + dq + ")

// pull out specified columns from csv that we are comparing
frame:AddSelectedColumns(" + dq + "Experience (Years)" + dq + ")
frame:AddSelectedColumns(" + dq + "Number of Children" + dq + ")

// create histogram object
// this will create two separate data charts to compare
BoxPlot chart = frame:BoxPlot()
chart:SetTitle(" + dq + "Randomized Data on People" + dq + ")
// let's adjust the font size so it appears nicely on the screen
chart:SetTitleFontSize(20)

// label the x axis, y axis, and the legend title
chart:SetXAxisTitle(" + dq + "Children and Years of Experience" + dq + ")
chart:SetYAxisTitle(" + dq + "Demographics" + dq + ")
// add subtitle for more description
chart:SetSubtitle(" + dq + "An arbitrary dataset about random people and their lives" + dq + ")
chart:HideOutliers()

// customization features
chart:SetColorPaletteToPlayful()
// define a clear interval, we separate each interval by 2
chart:SetYTickInterval(10)
chart:SetXAxisMinimum(0)
chart:FlipOrientation()


// display the box plot
chart:Display()")
        Paragraph("Now, this is the same dataset but in the form of a violin plot. Let us notice the peaks of dispersion compared to sole values in a box plot. We can see the density of the dataset and visualize the distribution of test scores. Here we can easily see how many students have scored in the range between the upper and lower quartiles. We can still make the same assumption from the box plot on this data, but now we see exactly student performance more holistically.")
        Paragraph("Since violin plots are fairly similar to box plots, we only have to change the following 2 lines of code:")
        CodeExample("use Libraries.Interface.Controls.Charts.BoxPlot")
        Paragraph("changes to")
        CodeExample("use Libraries.Interface.Controls.Charts.ViolinPlot")
        Paragraph("and")
        CodeExample("BoxPlot chart = frame:BoxPlot()")
        Paragraph("changes to")
        CodeExample("ViolinPlot chart = frame:ViolinPlot()")
        CodeEditorWithCode("Example of a Violin Plot with high and low dispersion", "use Libraries.Compute.Statistics.DataFrame
use Libraries.Interface.Controls.Charts.ViolinPlot

// Create a dataframe to hold the data.
DataFrame frame

// Load your data file into the frame.
frame:Load(" + dq + "data/2012-sat-results.csv" + dq + ")

// Select data from the frame that you wish to compare in your violin plot.
frame:AddSelectedColumns(" + dq + "SAT Critical Reading Avg. Score" + dq + ")
frame:AddSelectedColumns(" + dq + "SAT Math Avg. Score" + dq + ")
frame:AddSelectedColumns(" + dq + "SAT Writing Avg. Score" + dq + ")

// Let's shorten the names of our columns
frame:GetColumn(" + dq + "SAT Critical Reading Avg. Score" + dq + "):SetHeader(" + dq + "Reading" + dq + ")
frame:GetColumn(" + dq + "SAT Math Avg. Score" + dq + "):SetHeader(" + dq + "Math" + dq + ")
frame:GetColumn(" + dq + "SAT Writing Avg. Score" + dq + "):SetHeader(" + dq + "Writing" + dq + ")

// Using the frame, create a ViolinPlot object.
ViolinPlot chart = frame:ViolinPlot()

// Give the chart a descriptive title.
chart:SetTitle(" + dq + "Test Scores for the SATS at Schools in NYC" + dq + ")

// Add a subtitle for further description.
chart:SetSubtitle(" + dq + "How well did individuals do on their reading, math, and writing on the SATS?" + dq + ")

// Give the x axis a descriptive title.
chart:SetXAxisTitle(" + dq + "SAT Section" + dq + ")

// Give the y axis a descriptive title.
chart:SetYAxisTitle(" + dq + "Average Score" + dq + ")

// Let's adjust some of the font sizes so it appears nicely on the screen
chart:SetSubtitleFontSize(10)
chart:SetXLabelFontSize(10)
chart:SetYLabelFontSize(10)

// Customization features
chart:SetColorPaletteToPlayful()

// define a clear interval, we separate each interval by 50
chart:SetYTickInterval(50)

// Let's flip the chart so the plots appear horizontally
chart:FlipOrientation()

// We can hide the legend since it is not needed for this example
chart:ShowLegend(false)

// Display your violin plot.
chart:Display()

")
        Paragraph("Notice with each test score, it exhibits both a high and low dispersion. Many of the lower scores acculumated as the higher dispersion (ranges 320 to 340) while the higher scores are shown in the tails which shows a low dispersion (ranges 590 to 740).")
    end

    private action CreatingABoxPlotUsingQuorumStudio10Minutes
        Section("Creating a Box Plot using Quorum Studio (10 minutes)")
        Paragraph("To create a box plot, we will begin by creating a DataFrame. In order to do this, we will need to first download the "):Link("gender height dataset", "https://raw.githubusercontent.com/qorf/curriculum/4846bad77582e8d1da8325669b4de932b659e965/Reference/DataScience/Charts%20(New)/Data/Population/Height%20of%20Male%20and%20Female%20by%20Country%202022.csv"):Text(" (as a CSV file). We will then need to add the Factors and Columns before running the program to display the histogram. In this lesson we can follow the tutorial available on our website: "):Link("box plots", "https://quorumlanguage.com/tutorials/charts/boxplot.html"):Text(".")
        Paragraph("To start us off we will download the dataset, so that we can have the means to create a box plot. We can follow the link to download the "):Link("gender height dataset", "https://raw.githubusercontent.com/qorf/curriculum/4846bad77582e8d1da8325669b4de932b659e965/Reference/DataScience/Charts%20(New)/Data/Population/Height%20of%20Male%20and%20Female%20by%20Country%202022.csv"):Text(". If you are lost on how to download the dataset from GitHub, here is a link to our tutorial, "):Link("downloading CSVs for our charts", "https://quorumlanguage.com/tutorials/charts/downloading.html"):Text(".")
        Paragraph("The gender dataset describes the average height of males and females in different countries. It contains six columns and 200 entries (rows) of data. We will be using two columns within this dataset: 'Male Height in Cm' and 'Female Height in Cm.'")
        Table("Height of Male and Female by Country 2022 CSV")
        TableHeader():Cell("Country Name"):Cell("Male Height in Cm"):Cell("Female Height in Cm")
        TableRow():Cell("Netherlands"):Cell("183.78"):Cell("170.36")
        TableRow():Cell("Montenegro"):Cell("183.30"):Cell("169.96")
        TableRow():Cell("Estonia"):Cell("182.79"):Cell("168.66")
        TableRow():Cell("Bosnia and Herzegovina"):Cell("182.47"):Cell("167.47")
        TableRow():Cell("Iceland"):Cell("182.10"):Cell("168.91")
        Paragraph("To start creating a Box plot, we need to import two libraries: "):Link("DataFrame", "https://quorumlanguage.com/Libraries/Compute/Statistics/DataFrame.html"):Text(", which is a frame where our chart will be drawn, and "):Link("Box Plot", "https://quorumlanguage.com/Libraries/Interface/Controls/Charts/BoxPlot.html"):Text(", which allows us to create a box plot. Then we will initialize a DataFrame and load a comma separated values to the frame.")
        Paragraph("In order to read our dataset properly into Quorum, we will be using the action, Load(text location) which is found within our DataFrame class. Notice that inside the action's parameters, we will be inserting the file location of our "):Link("gender height dataset", "https://raw.githubusercontent.com/qorf/curriculum/4846bad77582e8d1da8325669b4de932b659e965/Reference/DataScience/Charts%20(New)/Data/Population/Height%20of%20Male%20and%20Female%20by%20Country%202022.csv"):Text(".")
        Paragraph("Now that we have read in our data, we can select our desired columns: male and female height in centimeters. For this, we will be using the action, AddSelectedColumns(text heading) which is found within our DataFrame class. Inside the parameters, we will want to type the heading from our dataset which will find and insert the selected heading into our DataFrame. We can reference the 'Loading and Formatting' Section in our "):Link("box plots", "https://quorumlanguage.com/tutorials/charts/boxplot.html"):Text(" tutorial regarding these steps.")
        Paragraph("Finally, we can create our box plot object using our frame with the following line of code:")
        CodeExample("BoxPlot chart = frame:BoxPlot()")
        Paragraph("Right now, we have a simple box plot, but there is not much to it. We will proceed on organizing our box plot with labels and further customization methods in the next section.")
    end

    private action LabelingAndCustomizingTheBoxPlots5Minutes
        Section("Labeling and Customizing the Box Plots (5 minutes)")
        Paragraph("The steps that we describe in this task can be followed in the 'Labeling the Box Plot' section that is available in our "):Link("box plots", "https://quorumlanguage.com/tutorials/charts/boxplot.html"):Text(" tutorial.")
        Paragraph("First, we will add labels for our chart, x-axis, and y-axis. This allows the reader to distinguish between the information and to understand what data they are looking at. For our chart we can label it the following way: title - 'Height of Males and Females in the World'; x-axis - 'Sex'; y-axis - 'Height (cm).' If we feel like those labels are not enough, we can add a subtitle to the histogram. For example, for this histogram the subtitle can be 'What is the average height of the population by sex?'")
        Paragraph("Other features we can add to further customize our box plot is that we can modify the font size, the location of our legend, the color palette, and even change the orientation of the box plot. Many of these features are available across all charts in Quorum. One unique function in regards to box plots is that we have access to HideOutliers() which will ignore any outlier data. We can reference the section 'Customizing the Data Chart' for more information in the "):Link("box plots", "https://quorumlanguage.com/tutorials/charts/boxplot.html"):Text(" tutorial.")
    end

    private action AccessingTheBoxPlot5Minutes
        Section("Accessing the Box Plot (5 minutes)")
        Paragraph("To view our actual plot we can type the following line of code:")
        CodeExample("chart:Display()")
        Paragraph("This displays our chart via pop-up box inside of Quorum or on the side view of the Quorum online editor! Now let us explore the graphic using the accessibility tools on our devices. When the box plot has been created, we should see our chart pop up in a separate window. From there, we can reference this "):Link("tutorial on keyboard navigation", "https://quorumlanguage.com/tutorials/charts/charttextnavigation.html"):Text(" using the arrow keys for accessibility. One note is that when a bar chart is saved onto our computer devices, they save as an SVG (scalable vector graphic) which maintains not only resizability but accessibility to read these charts using a screen reader.")
    end

    private action CreatingAViolinPlotUsingQuorumStudio10Minutes
        Section("Creating a Violin Plot using Quorum Studio (10 minutes)")
        Paragraph("A violin plot is a hybrid of a box plot and a kernel density plot (which shows peaks in the data). It is used to visualize the distribution of numerical data. Unlike a box plot (that shows summary statistics), violin plots show summary statistics and the density of each variable.")
        Paragraph("To create a violin plot, we will begin by creating a DataFrame. In order to do this, we will need to first download the "):Link("cats dataset", "https://raw.githubusercontent.com/qorf/curriculum/main/Reference/DataScience/Charts%20(New)/Data/Animals/Cats.csv"):Text(" (as a CSV file). We will then need to add the Factors and Columns before running the program to display the pie chart. In this lesson we can follow the tutorial available on our website: "):Link("violin plots", "https://quorumlanguage.com/tutorials/charts/violinplot.html")
        Paragraph("To start us off we will download the dataset, so that we can have the means to create a pie chart. You can follow the link to download "):Link("cats dataset", "https://raw.githubusercontent.com/qorf/curriculum/main/Reference/DataScience/Charts%20(New)/Data/Animals/Cats.csv"):Text(". If you are lost on how to download the dataset from GitHub, here is a link to our tutorial, "):Link("downloading CSVs for our charts", "https://quorumlanguage.com/tutorials/charts/downloading.html"):Text(".")
        Paragraph("The Cats dataset includes information like each cat's name, weight and temperament. It has 9 columns and 68 entries/rows of cats. We will be focusing on the 'Life Span' column for this lesson, but in general any columns with a range would work (eg, weight, but not temperament). Here's a snippet of the dataset:")
        Table("Height of Male and Female by Country 2022 CSV")
        TableHeader():Cell("Country Name"):Cell("Male Height in Cm"):Cell("Female Height in Cm")
        TableRow():Cell("Netherlands"):Cell("183.78"):Cell("170.36")
        TableRow():Cell("Montenegro"):Cell("183.30"):Cell("169.96")
        TableRow():Cell("Estonia"):Cell("182.79"):Cell("168.66")
        TableRow():Cell("Bosnia and Herzegovina"):Cell("182.47"):Cell("167.47")
        TableRow():Cell("Iceland"):Cell("182.10"):Cell("168.91")
        Paragraph("To start creating a violin plot, we need to import two libraries: "):Link("DataFrame", "https://quorumlanguage.com/Libraries/Compute/Statistics/DataFrame.html"):Text(", which is a frame where our chart will be drawn, and "):Link("Violin Plot", "https://quorumlanguage.com/Libraries/Interface/Controls/Charts/ViolinPlot.html"):Text(", which allows us to create a violin plot. Then we will initialize a DataFrame and load a comma separated values to the frame. Now that we have the violin plot created, let us load the data from the "):Link("cats dataset", "https://raw.githubusercontent.com/qorf/curriculum/main/Reference/DataScience/Charts%20(New)/Data/Animals/Cats.csv"):Text(" and display it.")
        Paragraph("The steps that we describe in this task can be followed in the 'Loading and Formatting' section that is available in our "):Link("violin plots", "https://quorumlanguage.com/tutorials/charts/violinplot.html"):Text(" tutorial.")
        Paragraph("Currently, we have only loaded the comma separated value file into the dataframe, and we are not reading anything from it. The first thing that we need to do is to load the columns to be read by our bar chart to create the x-axis. In this example, we added 'Minimum Life Span' and 'Maximum Life Span.' We don't need to add anything for the y-axis, since it's just the associated values for maximum and minimum life span.")
        Paragraph("Finally, we can create our violin plot object using our frame with the following line of code:")
        CodeExample("ViolinPlot chart = frame:ViolinPlot()")
        Paragraph("Right now, we have a simple violin plot, but there is not much to it. We will proceed on organizing our box plot with labels and further customization methods in the next section.")
    end

    private action LabelingAndCustomizingTheViolinPlots5Minutes
        Section("Labeling and Customizing the Violin Plots (5 minutes)")
        Paragraph("The next step is to be able to add specific labels to the entire violin plot, both axes, adding subtitles, and changing the font size of the print. Adding these features will allow us to present our data in a clearer way.")
        Paragraph("The steps that we describe in this task can be followed in the 'Labeling the Violin Plot' section that is available in our "):Link("violin plots", "https://quorumlanguage.com/tutorials/charts/violinplot.html"):Text(" tutorial.")
        Paragraph("First, we will add labels for our chart, x-axis, and y-axis. This allows the reader to distinguish between the information and to understand what data they are looking at. For our chart we can label it the following way: title - 'Minimum and Maximum Life Expectancy for Various Cat Breeds'; x-axis - 'Min/Max Lifespan'; y-axis - 'Type of Extrema.' If we feel like those labels are not enough, we can add a subtitle to the histogram. For example, for this histogram the subtitle can be 'How long do cats live?'")
        Paragraph("Like box plots, violin plots have some unique parts that may be customized due to their uniqueness as a chart. One of the unique features that we can explore here is 'flipping' the orientation of the data. Other features we can add to further customize our violin plot is that we can modify the font size, the location of our legend, and the color palette. Many of these features are available across all charts in Quorum. We can reference the section 'Customizing the Data Chart' for more information in the "):Link("violin plots", "https://quorumlanguage.com/tutorials/charts/violinplot.html"):Text(" tutorial.")
    end

    private action AccessingTheViolinPlots5Minutes
        Section("Accessing the Violin Plots (5 minutes)")
        Paragraph("To view our actual plot we can type the following line of code:")
        CodeExample("chart:Display()")
        Paragraph("This displays our chart via pop-up box inside of Quorum or on the side view of the Quorum online editor! Now let us explore the graphic using the accessibility tools on our devices. When the violin plot has been created, we should see our chart pop up in a separate window. From there, we can reference this "):Link("tutorial on keyboard navigation", "https://quorumlanguage.com/tutorials/charts/charttextnavigation.html"):Text(" using the arrow keys for accessibility. One note is that when a bar chart is saved onto our computer devices, they save as an SVG (scalable vector graphic) which maintains not only resizability but accessibility to read these charts using a screen reader.")
    end

    private action BreakOutGroupDiscussion5Minutes
        Section("Break-Out Group Discussion (5 Minutes)")
        Paragraph("We can use this time to find datasets that would be a best fit for using a box plot and violin plot, or simply talk about real-world uses for each chart. Since violin plots are more uncommon, we can discuss why they are but also note the benefits of using a violin plot versus a box plot.")
    end

    private action RelevantCommonCoreStandards
        Section("Relevant Common Core Standards")
        Paragraph("We use the following "):Link("website", "https://corestandards.org/wp-content/uploads/2023/09/ADA-Compliant-Math-Standards.pdf"):Text(" for common core standards in relation to histograms and measurements of distribution."):Link("CCSS.MATH.CONTENT.6.SP.B.4", "https://corestandards.org/wp-content/uploads/2023/09/ADA-Compliant-Math-Standards.pdf"):Text(": Display numerical data in plots on a number line, including dot plots, histograms, and box plots."):Link("CCSS.MATH.CONTENT.6.SP.B.5", "https://corestandards.org/wp-content/uploads/2023/09/ADA-Compliant-Math-Standards.pdf"):Text(": Summarize numerical data sets in relation to their context, such as by:"):Link("CCSS.MATH.CONTENT.6.SP.B.5.A", "https://corestandards.org/wp-content/uploads/2023/09/ADA-Compliant-Math-Standards.pdf"):Text(": Reporting the number of observations."):Link("CCSS.MATH.CONTENT.6.SP.B.5.B", "https://corestandards.org/wp-content/uploads/2023/09/ADA-Compliant-Math-Standards.pdf"):Text(": Describing the nature of the attribute under investigation, including how it was measured and its units of measurement."):Link("CCSS.MATH.CONTENT.6.SP.B.5.C", "https://corestandards.org/wp-content/uploads/2023/09/ADA-Compliant-Math-Standards.pdf"):Text(": Giving quantitative measures of center (median and/or mean) and variability (interquartile range and/or mean absolute deviation), as well as describing any overall pattern and any striking deviations from the overall pattern with reference to the context in which the data were gathered."):Link("CCSS.MATH.CONTENT.6.SP.B.5.D", "https://corestandards.org/wp-content/uploads/2023/09/ADA-Compliant-Math-Standards.pdf"):Text(": Relating the choice of measures of center and variability to the shape of the data distribution and the context in which the data were gathered.")
    end
end
