use Libraries.Web.Page.QuorumPage

/*
    Multi-Charts, Colors, and Options.
    Converted from the old Lesson page by plan 13's generator: the same
    words, now without Tailwind.
*/
class MultiChartsColorsOptions is QuorumPage
    // A double quote, for code and words that hold one.
    text dq = ""

    on create
        SetLocation("lessons/DataScience/multiChartsColorsOptions.html")
        // The name lists and links use, and the series and track it belongs
        // to: its section and picture.
        SetShortTitle("Multi-Charts, Colors, and Options")
        SetSectionName("Data Science")
        // For search engines and link previews, and what lists of pages say.
        SetDescription("Multi-Charts, Colors, and Options")
        SetSummary("Understanding customization of individual charts using Quorum.")
    end

    action Setup
        dq = dq:GetDoubleQuote()
        SetWebPageTitle("Multi-Charts, Colors, and Options")
        // Its editors and charts use the charts script.
        UseCharts()
        Title("Multi-Charts, Colors, and Options")
        Paragraph("Understanding the charts and their options that are available in Quorum")
        LearningObjectives()
        SetUpScatterPlot10Min()
        FeaturesOfTheQuorumCharts10Minutes()
        AddingFeaturesToScatterPlot10Minutes()
        SeparateByFactorAndSeparateBySeries30Minutes()
        SeriesSeparationForScatterPlot10Minutes()
        FinalChart()
        RelevantCommonCoreStandards()
    end

    private action LearningObjectives
        Section("Learning Objectives")
        Paragraph("Quorum has multiple charts and sometimes it can be confusing to keep track of the features each bar can offer to the user. In this tutorial we will list out the list of features that each of the charts that available in Quorum is capable of.")
        Paragraph("The student will learn:")
        BulletList()
        ListItem("Students will be able to change colors within graphics")
        ListItem("Students will be able to separate their charts")
        ListItem("Students will be able to identify which unique functions they can use with each chart type")
    end

    private action SetUpScatterPlot10Min
        Section("Set up Scatter Plot (10 min)")
        Paragraph("A lot of what we will talk about goes beyond just scatter plots, but since it would take a while to experiment with every feature on every graph, we'll do the highlights instead. Scatter plots have many interesting features, so we're going to start by getting one set up with the "):Link("Dogs dataset", "https://github.com/qorf/quorum-website/blob/main/QuorumWebsite/html/data/Dogs.csv"):Text(". If you want more information about how to create a scatter plot, look at our "):Link("Scatter Plot Tutorial", "https://quorumlanguage.com/tutorials/charts/scatterplot.html"):Text(".")
        CodeEditorWithCode("Basic Scatter Plot", "use Libraries.Compute.Statistics.DataFrame
use Libraries.Interface.Controls.Charts.ScatterPlot

/*
    This is an example of a simple scatter plot in quorum.
*/

// Create a dataframe to hold the data.
DataFrame frame

// Load your data file into the frame.
frame:Load(" + dq + "data/Dogs.csv" + dq + ")

// Select data from the frame that you wish to use in your scatter plot. 
// Note: In Scatter Plots, you must select at least two columns.
//      The first column will be the x-axis independent variable.
//      The second column or more will be the y-axis dependent variable.

frame:AddSelectedFactors(" + dq + "Breed Group" + dq + ")
frame:AddSelectedColumns(" + dq + "Maximum Life Span" + dq + ")
frame:AddSelectedColumns(" + dq + "Maximum Weight" + dq + ")

// Using the frame, create a ScatterPlot object.
ScatterPlot chart = frame:ScatterPlot()

// Give the chart a descriptive title.
chart:SetTitle(" + dq + "Dog Weight and Life Span" + dq + ")

// Add a subtitle for further description.
chart:SetSubtitle(" + dq + "Does weight correlate to life span for dogs?" + dq + ")

// Give the x axis a descriptive title.
chart:SetXAxisTitle(" + dq + "Maximum Life Span (years)" + dq + ")

// Give the y axis a descriptive title.
chart:SetYAxisTitle(" + dq + "Maximum Weight (pounds)" + dq + ")

// Give the legend a descriptive title.
chart:SetLegendTitle(" + dq + "Breed Group" + dq + ")

// Display your scatter plot.
chart:Display()


")
    end

    private action FeaturesOfTheQuorumCharts10Minutes
        Section("Features of the Quorum Charts (10 Minutes)")
        Paragraph("Below are the various chart features, some of which are universal, and others that are chart specific. Take a few minutes to scan over them briefly, but don't worry about going through everything in close detail.")
        Paragraph("Here are the options that are available for all of the charts that are implemented in Quorum: SetTitle, SetSubtitle, SetXAxisTitle, SetYAxisTitle, SetXAxisMinimum, SetYAxisMinimum, SetXAxisMaximum, SetYAxisMaximum, SetXTickInterval, SetYTickInterval, SetColorPalette, SetLegendLocationToBottom (SetLegendLocationToTop, SetLegendLocationToRight, SetLegendLocationToLeft), SetLegendTitle, SeparateBySeries, SeparateByFactors (Note: Histograms and Line Charts do not have this).")
        Table("Function Availability by Chart Type")
        TableHeader():Cell("Function"):Cell("Bar Charts"):Cell("Histograms"):Cell("Pie Charts"):Cell("Line Charts"):Cell("Scatter Plots"):Cell("Box Plots"):Cell("Violin Plots")
        TableRow():Cell("StackBars"):Cell("Yes"):Cell("Yes"):Cell("No"):Cell("No"):Cell("No"):Cell("No"):Cell("No")
        TableRow():Cell("SortByBarSize"):Cell("Yes"):Cell("No"):Cell("No"):Cell("No"):Cell("No"):Cell("No"):Cell("No")
        TableRow():Cell("OverlayBars"):Cell("No"):Cell("Yes"):Cell("No"):Cell("No"):Cell("No"):Cell("No"):Cell("No")
        TableRow():Cell("SetBinWidth"):Cell("No"):Cell("Yes"):Cell("No"):Cell("No"):Cell("No"):Cell("No"):Cell("No")
        TableRow():Cell("SetDonutHolePercent"):Cell("No"):Cell("No"):Cell("Yes"):Cell("No"):Cell("No"):Cell("No"):Cell("No")
        TableRow():Cell("SetLineDensity"):Cell("No"):Cell("No"):Cell("No"):Cell("Yes"):Cell("No"):Cell("No"):Cell("No")
        TableRow():Cell("SetPointDensity"):Cell("No"):Cell("No"):Cell("No"):Cell("No"):Cell("Yes"):Cell("No"):Cell("No")
        TableRow():Cell("HideOutliers"):Cell("No"):Cell("No"):Cell("No"):Cell("No"):Cell("No"):Cell("Yes"):Cell("No")
        TableRow():Cell("SetBandWidth"):Cell("No"):Cell("No"):Cell("No"):Cell("No"):Cell("No"):Cell("No"):Cell("Yes")
        TableRow():Cell("IsSplit"):Cell("No"):Cell("No"):Cell("No"):Cell("No"):Cell("No"):Cell("No"):Cell("Yes")
        Table("Description of the Chart Functions")
        TableHeader():Cell("Function"):Cell("Description")
        TableRow():Cell("StackBars"):Cell("StackBars() will stack bars on top of each other when a group contains multiple bars. They are not stacked by default.")
        TableRow():Cell("SortByBarSize"):Cell("SortByBarSize() takes in no parameters and will sort the bars from largest bar to smallest bar. Note that it only will work with one factor added.")
        TableRow():Cell("OverlayBars"):Cell("OverlayBars() will overlay bars on top of each other when a group contains multiple bars. They are not overlayed by default.")
        TableRow():Cell("SetBinWidth"):Cell("SetBinWidth() will override the auto-calculated bin width with a user determined interval.")
        TableRow():Cell("SetDonutHolePercent"):Cell("SetDonutHolePercent() takes in a decimal value which will adjust the size of the hole in relation to the size of the pie chart. Larger percentages will make the hole bigger and smaller percentages will make the hole smaller.")
        TableRow():Cell("SetLineDensity"):Cell("SetLineDensity(number size) takes in an integer as a parameter and will adjust the thickness of the lines within the chart.")
        TableRow():Cell("SetPointDensity"):Cell("This function takes in an integer that will adjust the size of the dots of the scatter plot.")
        TableRow():Cell("HideOutliers"):Cell("This function does not take any parameters and it will hide the outliers from the chart.")
        TableRow():Cell("SetBandWidth"):Cell("This function takes in an integer that will make a violin chart more or less exaggerated.")
        TableRow():Cell("IsSplit"):Cell("This function takes in a boolean that will split the violins if there are two violin charts in a group.")
    end

    private action AddingFeaturesToScatterPlot10Minutes
        Section("Adding Features to Scatter Plot (10 minutes)")
        Paragraph("Let's now try adding some features to our scatter plot from before. Scatter plots have the ability to change the point size with SetPointDensity(), as well as changing the axis limits, legend location and colors. Try increasing the point size, moving the legend to the top and changing the colors. For a comprehensive list of all the available colors, look at our "):Link("Color Accessibility", "https://quorumlanguage.com/tutorials/charts/coloraccessibility.html"):Text(" page. Besides that, you can play around with any of the numbers to see how it changes the chart.")
        CodeEditorWithCode("Scatter Plot with Features", "use Libraries.Compute.Statistics.DataFrame
use Libraries.Interface.Controls.Charts.ScatterPlot

/*
    This is an example of a simple scatter plot in quorum.
*/

// Create a dataframe to hold the data.
DataFrame frame

// Load your data file into the frame.
frame:Load(" + dq + "data/Dogs.csv" + dq + ")

// Select data from the frame that you wish to use in your scatter plot. 
// Note: In Scatter Plots, you must select at least two columns.
//      The first column will be the x-axis independent variable.
//      The second column or more will be the y-axis dependent variable.

frame:AddSelectedFactors(" + dq + "Breed Group" + dq + ")
frame:AddSelectedColumns(" + dq + "Maximum Life Span" + dq + ")
frame:AddSelectedColumns(" + dq + "Maximum Weight" + dq + ")

// Using the frame, create a ScatterPlot object.
ScatterPlot chart = frame:ScatterPlot()

// Give the chart a descriptive title.
chart:SetTitle(" + dq + "Dog Weight and Life Span" + dq + ")

// Add a subtitle for further description.
chart:SetSubtitle(" + dq + "Does weight correlate to life span for dogs?" + dq + ")

// Give the x axis a descriptive title.
chart:SetXAxisTitle(" + dq + "Years" + dq + ")

// Give the y axis a descriptive title.
chart:SetYAxisTitle(" + dq + "Pounds" + dq + ")

// Give the legend a descriptive title.
chart:SetLegendTitle(" + dq + "Breed Group" + dq + ")

// You can show linear regression line trends.
chart:ShowLinearRegression(true) 

// You can switch the x-axis and the y-axis.
chart:FlipOrientation()

// If needed, you can change the color palette to a predefined palette or create a custom one.
// Disturbing color palette contains yellows, oranges, browns, and greens
chart:SetColorPaletteToDisturbing()

// change point size
chart:SetPointDensity(15)

// Display your scatter plot.
chart:Display()
")
    end

    private action SeparateByFactorAndSeparateBySeries30Minutes
        Section("Separate by Factor and Separate by Series (30 Minutes)")
        Paragraph("In this part of the tutorial we will be discussing two ways of separating the charts from one another. These functions are SeparateByFactor() and SeparateBySeries(). SeparateByFactor() will separate the chart into a grid of subcharts based on the bar groups. It takes in an integer as the number of columns in the grid. If empty, it results in a single-column grid. SeparateBySeries() will separate the chart into a grid of subcharts based on the legend (series). It takes in an integer as the number of columns in the grid. If empty, it results in a single-column grid.")
        Paragraph("To learn more about which inputs can be used for each function, read our "):Link("Chart Separation tutorial", "https://quorumlanguage.com/tutorials/charts/chartSeparation.html"):Text(".")
    end

    private action SeriesSeparationForScatterPlot10Minutes
        Section("Series Separation For Scatter Plot (10 Minutes)")
        Paragraph("We have 2 columns (numerical) and 1 factor in this plot. By following the table above, we know that we can use SeparateBySeries. Without SeparateBySeries, the data can be less clear, since the only other way to show it is color coding.")
        Paragraph("Here we can use SeparateBySeries to present the data clearly, and 10 showcases a separation that is easy to understand and not cluttered. It will split the interval into 10 units, and there will be 10 elements in each row.")
        CodeEditorWithCode("Split Scatter Plot", "
use Libraries.Compute.Statistics.DataFrame
use Libraries.Interface.Controls.Charts.ScatterPlot

/*
    This is an example of a simple scatter plot in quorum.
*/

// Create a dataframe to hold the data.
DataFrame frame

// Load your data file into the frame.
frame:Load(" + dq + "data/Dogs.csv" + dq + ")

// Select data from the frame that you wish to use in your scatter plot. 
// Note: In Scatter Plots, you must select at least two columns.
//      The first column will be the x-axis independent variable.
//      The second column or more will be the y-axis dependent variable.

frame:AddSelectedFactors(" + dq + "Breed Group" + dq + ")
frame:AddSelectedColumns(" + dq + "Maximum Life Span" + dq + ")
frame:AddSelectedColumns(" + dq + "Maximum Weight" + dq + ")

// Using the frame, create a ScatterPlot object.
ScatterPlot chart = frame:ScatterPlot()

// Give the chart a descriptive title.
chart:SetTitle(" + dq + "Dog Weight and Life Span" + dq + ")

// Add a subtitle for further description.
chart:SetSubtitle(" + dq + "Does weight correlate to life span for dogs?" + dq + ")

// Give the x axis a descriptive title.
chart:SetXAxisTitle(" + dq + "Years" + dq + ")

// Give the y axis a descriptive title.
chart:SetYAxisTitle(" + dq + "Pounds" + dq + ")

// Give the legend a descriptive title.
chart:SetLegendTitle(" + dq + "Breed Group" + dq + ")

// You can show linear regression line trends.
chart:ShowLinearRegression(true) 

// You can switch the x-axis and the y-axis.
chart:FlipOrientation()

// If needed, you can change the color palette to a predefined palette or create a custom one.
// Disturbing color palette contains yellows, oranges, browns, and greens
chart:SetColorPaletteToDisturbing()

// change point size
chart:SetPointDensity(15)

//split into multiple scatter plots
chart:SeparateBySeries(4)

// Display your scatter plot.
chart:Display()
")
    end

    private action FinalChart
        Section("Final Chart")
        Chart("media/epiq/datascience/split.svg")
    end

    private action RelevantCommonCoreStandards
        Section("Relevant Common Core Standards")
        Paragraph("We use the following "):Link("website", "https://corestandards.org/wp-content/uploads/2023/09/ADA-Compliant-Math-Standards.pdf"):Text(" for common core standards in relation to histograms and measurements of distribution."):Link("CCSS.MATH.CONTENT.HSS.ID.A.1", "https://corestandards.org/wp-content/uploads/2023/09/ADA-Compliant-Math-Standards.pdf"):Text(": Represent data with plots on the real number line (dot plots, histograms, and box plots)."):Link("CCSS.MATH.CONTENT.HSS.ID.B.6", "https://corestandards.org/wp-content/uploads/2023/09/ADA-Compliant-Math-Standards.pdf"):Text(": Represent data on two quantitative variables on a scatter plot, and describe how the variables are related.")
    end
end
