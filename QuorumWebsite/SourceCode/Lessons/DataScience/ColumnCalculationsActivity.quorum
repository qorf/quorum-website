use Libraries.Web.Page.QuorumPage

/*
    Column Calculations Activity.
    Converted from the old Lesson page by plan 13's generator: the same
    words, now without Tailwind.
*/
class ColumnCalculationsActivity is QuorumPage

    on create
        SetLocation("lessons/DataScience/columnCalculationsActivity.html")
        // The name lists and links use, and the series and track it belongs
        // to: its section and picture.
        SetShortTitle("Column Calculations Activity")
        SetSectionName("Data Science")
        // For search engines and link previews, and what lists of pages say.
        SetDescription("Column Calculations Activity")
        SetSummary("Understanding how to filter, split and create columns.")
    end

    action Setup
        SetWebPageTitle("Column Calculations Activity")
        Title("Column Calculations Activity")
        Paragraph("Understanding how to filter, split and create columns")
        LearningObjectives()
        ObtainAndExaminingOurDatasets5Minutes()
        CalculatingColumns25Minutes()
        ColumnSplitting25Minutes()
        WrapUpWithDataTransformations5Minutes()
    end

    private action LearningObjectives
        Section("Learning Objectives")
        Paragraph("The student will learn:")
        BulletList()
        ListItem("Students will be able to independently filter their datasets by sub-groups.")
        ListItem("Students will be able to learn how to create new columns")
        ListItem("Student will be able to separate columns and add them as a new heading")
    end

    private action ObtainAndExaminingOurDatasets5Minutes
        Section("Obtain and Examining Our Datasets (5 Minutes)")
        Paragraph("For this lesson, we will be using two different datasets, one is a "):Link("numerical dataset", "https://raw.githubusercontent.com/qorf/curriculum/main/Reference/DataScience/Charts%20(New)/Data/Miscellaneous/random.csv"):Text(" filled with arbitrary values and one is more a "):Link("'real world' dataset", "https://raw.githubusercontent.com/qorf/curriculum/main/Reference/DataScience/Charts%20(New)/Data/Culture%20and%20Entertainment/league.csv"):Text(" with numerical and nonnumerical values. The significance of this dataset is to show how well users perform in a game.")
        Paragraph("Our numerical dataset will be used on calculating columns because for those functions, it requires us to form equations, making numerical data much easier to work with. Our 'real world' dataset will be used to split up columns.")
    end

    private action CalculatingColumns25Minutes
        Section("Calculating Columns (25 Minutes)")
        Paragraph("Let us say we have two or more columns of numerical data in which we want to calculate something such as the sum. We are able to do that by forming equations by adding up our desired headers and our calculations would modify the DataFrame and insert a new column with the new values.")
        Paragraph("Firstly, let us load the file and create a copy of the original frame. Next, we add the columns on the frame, and the heading title, 'total games' and insert the equation we have (Wins + Losses) as the second parameter. Finally, we will output both the original frame (copy) and the newly modified frame (frame). Now we have created a new column with a name 'total games' that is essential in a gamer world.")
        Paragraph("If you would like more detailed steps, we have "):Link("the column calculation tutorial", "https://quorumlanguage.com/tutorials/Transformations/CalcColumns.html"):Text(" with the "):Link("'random.csv'", "https://raw.githubusercontent.com/qorf/curriculum/main/Reference/DataScience/Charts%20(New)/Data/Miscellaneous/random.csv"):Text(" dataset on our website. As a reminder, these values are arbitrary and for learning purposes to construct our equations in a simple manner.")
    end

    private action ColumnSplitting25Minutes
        Section("Column Splitting (25 Minutes)")
        Paragraph("Column splitting occurs when we have data that needs to be separated. As an example, let us view an example column:")
        Table("Ice Cream CSV")
        TableHeader():Cell("Ice Cream")
        TableRow():Cell("Vanilla-$5")
        TableRow():Cell("Chocolate-$5.50")
        TableRow():Cell("Strawberry-$5.50")
        TableRow():Cell("Ube-$6")
        Paragraph("We see that there are ice cream flavors listed and immediately following, we have their prices listed. In a sense, we could say we are trying to make our data Tidy. Suppose we wanted to Tidy up our data automatically by making new columns for 'Ice Cream' and 'Price.'")
        Table("Formmated Ice Cream CSV")
        TableHeader():Cell("Ice Cream"):Cell("Price")
        TableRow():Cell("Vanilla"):Cell("$5")
        TableRow():Cell("Chocolate"):Cell("$5.50")
        TableRow():Cell("Strawberry"):Cell("$5.50")
        TableRow():Cell("Ube"):Cell("$6")
        Paragraph("We can achieve this separation by column splitting. For this section, we will be modifying our "):Link("'League.csv' dataset", "https://raw.githubusercontent.com/qorf/curriculum/main/Reference/DataScience/Charts%20(New)/Data/Culture%20and%20Entertainment/league.csv"):Text(" dataset and we will be working on separating various factors. For this, we will be following "):Link("this tutorial on column splitting", "https://quorumlanguage.com/tutorials/Transformations/ColumnSplit.html"):Text(". Notice how there are two major sections on, where the second section is a more complicated way to column split using Inheritance. In computer science, inheritance is when we create a new object that is based on another class.")
    end

    private action WrapUpWithDataTransformations5Minutes
        Section("Wrap-up with Data Transformations (5 Minutes)")
        Paragraph("Let us recall the two previous sections with cleaning up our data and focus on why data transformations are important. Again, let us refer back to our "):Link("original AskAManager dataset", "https://github.com/qorf/quorum-website/blob/main/QuorumWebsite/html/data/AskAManager.csv"):Text(" and talk about what can be modified or removed to make this a Tidy dataset.")
    end
end
