use Libraries.Web.Page.QuorumPage

/*
    Loading Tidy Data Frames.
    Converted from the old Lesson page by plan 13's generator: the same
    words, now without Tailwind.
*/
class TidyDataFrames is QuorumPage
    // A double quote, for code and words that hold one.
    text dq = ""

    on create
        SetLocation("lessons/DataScience/tidyDataFrames.html")
        // The name lists and links use, and the series and track it belongs
        // to: its section and picture.
        SetShortTitle("Loading Tidy DataFrames")
        SetSectionName("Data Science")
        // For search engines and link previews, and what lists of pages say.
        SetDescription("Loading Tidy DataFrames")
        SetSummary("learn about the tidy data format with dataframes.")
    end

    action Setup
        dq = dq:GetDoubleQuote()
        SetWebPageTitle("Loading Tidy Data Frames - Quorum Programming Language")
        Title("Loading Tidy Data Frames")
        Paragraph("Learn about Tidy format and DataFrames in Quorum")
        LearningObjectives()
        DiscussDataFrame25Minutes()
        ObtainASampleCommaSeparatedValueCSVFileFromTheQu()
        CreateAQuorumStudioProjectToRunTheSameCodeOfflin()
    end

    private action LearningObjectives
        Section("Learning Objectives")
        Paragraph("In this tutorial, students will learn:")
        BulletList()
        ListItem("Students will be able to run a Quorum program online")
        ListItem("Students will be able to obtain a Comma Separated Value (CSV) file from the Quorum server")
        ListItem("Students will understand how to create a Data Frame")
        ListItem("Students will be able to explain the purpose of Tidy format, where rows and columns are variables and observations and there is one data point per cell")
    end

    private action DiscussDataFrame25Minutes
        Section("Discuss DataFrame (25 minutes)")
        Paragraph("A DataFrame in Quorum is a library designed to load in and manipulate data. We are going to begin our discussion by looking at the "):Link("reference page for DataFrame", "https://quorumlanguage.com/tutorials/SavingAndLoading/IntroDataFrames.html"):Text(". In this session, we will discuss each line of code and run the program online.")
    end

    private action ObtainASampleCommaSeparatedValueCSVFileFromTheQu
        Section("Obtain a sample Comma Separated Value (CSV) file from the Quorum Server and Examine it (20 minutes)")
        Paragraph("Notice that when running a program on the Quorum website, it is getting the data from somewhere. We have a clue about where from the code and the relevant line is this one:")
        CodeExample("frame:Load(" + dq + "data/Height of Male and Female by Country 2022.csv" + dq + ")")
        Paragraph("If we look at the Load action, it is telling us where on the Internet the file lives, which means that if we type that exact phrase with quorumlanguage.com at the front, it will find the file. As such, we can "):Link("download the height file", "https://quorumlanguage.com/data/Height%20of%20Male%20and%20Female%20by%20Country%202022.csv"):Text(" from this link or by copying the information inside of Load. Note that the data is written in a "):Link("Tidy", "https://quorumlanguage.com/tutorials/SavingAndLoading/TidyData.html"):Text(" format.")
    end

    private action CreateAQuorumStudioProjectToRunTheSameCodeOfflin
        Section("Create a Quorum Studio project to Run the same code Offline (15 minutes)")
        Paragraph("Now that we have discussed DataFrame, Tidy, and run our program online, we will now make a project in Quorum Studio and run the identical program offline. To do this, we can reference the "):Link("Getting started tutorial", "https://quorumlanguage.com/tutorials/language/gettingStarted.html"):Text(" if we need to when making the project. Once we do, we place the file we downloaded into a folder, named data, inside of where we created the project. After we have created it, we will run the program and make sure we get the same output as the online version. The goal here is to be able to take a program written online and run it there or on our desktops. This is important, as many kinds of software in data science are too complex to be run in the browser, which is especially true as data sets get large. A rule of thumb might be that in the browser, a few hundreds lines of data is fine, but if we have millions or billions, running our code on the desktop will make it go much faster.")
    end
end
