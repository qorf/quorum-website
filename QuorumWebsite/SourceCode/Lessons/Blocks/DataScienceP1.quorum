use Libraries.Web.Page.QuorumPage

/*
    Hour 6: Data Science, Part 1 - Working with Data.
    Converted from the old Lesson page by plan 13's generator: the same
    words, now without Tailwind.
*/
class DataScienceP1 is QuorumPage
    // A double quote, for code and words that hold one.
    text dq = ""

    on create
        SetLocation("tutorials/blocks/DataScienceP1.html")
        // The name lists and links use, and the series and track it belongs
        // to: its section and picture.
        SetShortTitle("Data Science Part 1")
        SetSectionName("Quorum Blocks")
        SetCardImage("/media/gettingStarted.png")
        // For search engines and link previews, and what lists of pages say.
        SetDescription("Learn how to load data and calculate its properties")
        SetSummary("data science in Quorum")
    end

    action Setup
        dq = dq:GetDoubleQuote()
        SetWebPageTitle("Data Science, Part 1: Working with Data - Quorum Programming Language")
        Title("Hour 6: Data Science, Part 1 - Working with Data")
        Paragraph("This lesson will teach you about the basics of working with data in Quorum.")
        Overview()
        WarmUp()
        Explore()
        Engage()
    end

    private action Overview
        Section("Overview")
        Paragraph("Computer science is not just a thing you learn, but a practical skill that can be applied to many facets of everyday life. One of those facets is learning about and understanding data. Data is everywhere, from medical studies that teach you about your health, evidence on public policy, and even data in sports or how people watch television. In this lesson, you will learn about the budding field of data science and how you can use scaffolded block programming to use and understand data.")
        Subsection("Goals")
        Paragraph("You have the following goals for this lesson:")
        BulletList()
        ListItem("Learn about comma-separated value (CSV) files.")
        ListItem("Learn about the internal computer representation of a spreadsheet: the DataFrame.")
        ListItem("Tinker with the actions in DataFrame and explore the operations that can be used.")
    end

    private action WarmUp
        Section("Warm up")
        Paragraph("At its core, data science is the art and science of extracting meaningful insights from raw data. It combines techniques from statistics, computer science, and domain knowledge to make sense of complex datasets. Whether it is analyzing customer behavior, optimizing business processes, or predicting future trends, data science empowers organizations to unlock the value hidden within their data.")
        Paragraph("As data science's role in society has grown in importance, how do you think it has impacted these fields?")
        BulletList()
        ListItem("Healthcare")
        ListItem("Education")
        ListItem("Finance")
        Table("Vocabulary")
        TableHeader():Cell("Term"):Cell("Definition")
        TableRow():Cell("Data"):Cell("A collection of values that convey information, discussion, and calculation.")
        TableRow():Cell("Data Science"):Cell("The study of organizing and analyzing massive amounts of data to make meaningful and data-driven decisions.")
        TableRow():Cell("Tidy Data"):Cell("A method used to keep data in a consistent format for analysis. The three properties for Tidy Data are: variables must be in columns, observations must be in rows, and individual cells must represent only one value.")
        TableRow():Cell("Comma-Separated Value (CSV) File"):Cell("A text file that uses commas to separate values and new lines to separate records.")
        Table("New Code to Learn")
        TableHeader():Cell("Quorum Code"):Cell("Code Example"):Cell("Explanation")
        TableRow():Cell("use LIBRARY_NAME"):Cell("use Libraries.Compute.Statistics.DataFrame"):Cell("A use statement lets you use a type of Object in your program. In this case, you are using the DataFrame object.")
        TableRow():Cell("DataFrame NAME"):Cell("DataFrame frame"):Cell("A variable declaration that makes a new DataFrame. Unlike primitive variables, DataFrame variables don't need the " + dq + "=" + dq + " sign.")
        TableRow():Cell("NAME:Load(FILE_NAME)"):Cell("frame:Load(" + dq + "data/Dogs.csv" + dq + ")"):Cell("Loads the CSV file from your computer onto Quorum Studio. The file should exist in a path that the system can identify such as within the project folder.")
        TableRow():Cell("NAME:AddSelectedColumn(COLUMN_INDEX)"):Cell("frame:AddSelectedColumn(3)"):Cell("Adds a column via index into the DataFrame object.")
        TableRow():Cell("NAME:AddSelectedColumnRange(INDEX_1, INDEX_2)"):Cell("frame:AddSelectedColumnRange(3,6)"):Cell("Adds a range of columns via index into the DataFrame object.")
        TableRow():Cell("NAME:ToText()"):Cell("frame:ToText()"):Cell("Outputs the entire loaded file into the console.")
        TableRow():Cell("NAME:Mean()"):Cell("frame:Mean()"):Cell("Calculates the mean of a selected column of a DataFrame.")
        TableRow():Cell("NAME:Median()"):Cell("frame:Median()"):Cell("Calculates the median of a selected column of a DataFrame.")
        TableRow():Cell("NAME:StandardDeviation()"):Cell("frame:StandardDeviation()"):Cell("Calculates the Standard Deviation of a selected column of a DataFrame.")
        TableRow():Cell("NAME:Variance()"):Cell("frame:Variance()"):Cell("Calculates the Variance of a selected column of a DataFrame.")
        TableRow():Cell("NAME:Kurtosis()"):Cell("frame:Kurtosis()"):Cell("Calculates the Kurtosis of a selected column of a DataFrame.")
        Subsection("CSTA Standards")
        Paragraph("This lesson covers the following "):Link("standards", "https://csteachers.org/k12standards/interactive/"):Text(":")
        BulletList()
        ListItem():Strong("3A-DA-10"):Text(": Evaluate the tradeoffs in how data elements are organized and where data is stored.")
        ListItem():Strong("3A-DA-12"):Text(": Create computational models that represent the relationships among different elements of data collected from a phenomenon or process.")
    end

    private action Explore
        Section("Explore")
        Paragraph():Strong("Data science"):Text(" is a budding and relatively young field that takes elements from computer science and statistics as part of its overall foundation. In some sense, data science is like computer science in the sense that you often program statistics formulas and visualizations. In some sense it is like statistics in the sense that it requires a rather formal and complicated understanding of probabilities and equations to get right. As of the time of this writing, there are no unified and agreed upon standards for what data science really is, or what should be taught, although many groups are putting on their thinking caps.")
        Paragraph("While learning about data science is a big and complicated topic, this lesson will give you practice in exploring some of the basics. These include some programming with the concept of a DataFrame, a strange concept called "):Strong("Tidy Data"):Text(", and in the next lesson accessible visualizations. Before you can do anything in data science, however, you need to learn to load data.")
        Subsection("Loading Data using Comma Separated Value (CSV) Files")
        Paragraph("The term "):Strong("Comma Separated Value (CSV)"):Text(" is literal. While computer science often names things somewhat poorly, in this case the name of the file is what it sounds like: data separated by a comma. You can make these by hand, but it is much easier to use Excel, Google Sheets, Numbers, or any number of other applications to do so.")
        Paragraph("This is an example of what a CSV may look like:")
        CodeExample("daniel, seattle, purple, rocky road
brandon, las vegas, blue, vanilla
brianna, san francisco, black, oreo
rebecca, reno, gold, chocolate
kristine, washington dc, lilac, birthday cake")
        Paragraph("This CSV example has 5 rows and 4 columns, with each entry separated by commas. The contents of this data are arbitrary, however it is important to recognize what a common CSV file may look like. When you think of columns and rows in this context, notice that names like "):DoubleQuote():Text("kristine"):DoubleQuote():Text(" or "):DoubleQuote():Text("rebecca"):DoubleQuote():Text(" are text, not numbers. This fact is important and can be used by any language that supports data science to mean many sorts of things.")
        Subsection("Tidy Data")
        Paragraph("The concept of Tidy Data is used when trying to create consistent formats of data for analysis. Having readable and consistent data is easier for humans to read and allows for computers to run data more efficiently.")
        Paragraph("Tidy Data typically contains these properties:")
        BulletList()
        ListItem("Variables must be in columns.")
        ListItem("Observations must be in rows.")
        ListItem("Individual cells must represent only one value.")
        Paragraph("Below shows an example of what data would look like in Tidy format:")
        Table("Tidy Data Example")
        TableHeader():Cell("y"):Cell("x1"):Cell("x2"):Cell("x3")
        TableRow():Cell("1"):Cell("4"):Cell("-8"):Cell("23")
        TableRow():Cell("3"):Cell("73"):Cell("3"):Cell("5")
        TableRow():Cell("5"):Cell("12"):Cell("67"):Cell("20")
        TableRow():Cell("67"):Cell("4"):Cell("2"):Cell("2")
        TableRow():Cell("53"):Cell("7"):Cell("5"):Cell("6")
        Paragraph("In this example, y, x1, x2, and x3 are all variables and the first row is a header representing the name of those variables. The remaining rows contain all of the data points for each variable. Each cell contains only one value.")
        Subsection("Data Frames")
        Paragraph("The key component in loading data with Quorum Language is to use a DataFrame. A DataFrame is a series of rows and columns, like a table or spreadsheet. DataFrame objects can contain many kinds of things. For example, one column might contain text, another might contain numbers, and another might contain integers. DataFrames can have selections, kind of like selecting a row or column in a spreadsheet, and can do operations on top of that selection.")
        Paragraph("While you would use them all pretty rarely, here are some examples of the types of data that you can load into a DataFrame by default:")
        Table("DataFrame Columns")
        TableHeader():Cell("y"):Cell("x1")
        TableRow():Cell("AudioColumn"):Cell("Loads audio samples, for example from an MP3 file.")
        TableRow():Cell("BigIntegerColumn"):Cell("Loads really large integers, for values greater than 2,147483,647 or smaller than -2,147,483,648.")
        TableRow():Cell("BooleanColumn"):Cell("Loads boolean values that are true or false.")
        TableRow():Cell("IntegerColumn"):Cell("Loads integer values.")
        TableRow():Cell("NumberColumn"):Cell("Loads number values (integers with a decimal point).")
        TableRow():Cell("TextColumn"):Cell("Loads raw text as values.")
        TableRow():Cell("VectorColumn"):Cell("A mathematical optimization for number values used internally for matrix computations.")
        Subsection("Loading Data and Selecting Columns")
        Paragraph("When you want to use a DataFrame, you create a DataFrame object and call load. As code, this would be the following:")
        CodeExample("use Libraries.Compute.Statistics.DataFrame
DataFrame frame")
        Paragraph("If you place "):Code("DataFrame frame"):Text(", or some other name, into the editor, you can then press ALT+ENTER to have it automatically find the appropriate use statement. You can also right click, or use a keyboard shortcut for your operating system, to pull up the context menu, to have it insert the right line of code. From there, you can type into the Filter and look for actions that may be related to loading. There are several, but the one you want is "):Code("frame:Load(location)"):Text(".")
        Image("media/Blocks/DataScience1/FindLoad.png", "A snippet of code that reads:
use Libraries.Compute.Statistics.DataFrame
DataFrame frame")
        Paragraph("When you load this value though, something funny happens: you receive an error. The reason is because the word "):DoubleQuote():Text("location"):DoubleQuote():Text(" is a hint to the human from the block, but the computer cannot determine what you likely mean from your current context. The bottom line is the scaffolded block is guessing (and not guessing particularly well in this case). It thinks there is a variable called location, but this was a placeholder the blocks system put in place to provide the human a hint for what to provide.")
        Image("media/Blocks/DataScience1/BadGuesser.png", "A snippet of code that reads:
use Libraries.Compute.Statistics.DataFrame
DataFrame frame
frame:Load(location)

Location is a placeholder that still needs to be set which is causing the initial error")
        Paragraph("What you should input into this "):DoubleQuote():Text("location"):DoubleQuote():Text(" placeholder is typically a file path of the CSV you want to load into the system. A best practice when loading CSV data is to ensure you save the CSV in your project folder to quickly access it in your program.")
        Subsection("Select Columns")
        Paragraph("Once you have loaded data, you can tinker to find how to select columns as well. Selecting a column is kind of like clicking a column header in a spreadsheet application. It tells the system you want to do some kind of operation on an entire region. The action you want can be found by looking for words like select or column. The actual action you want would be "):Code("AddSelectedColumn(n)"):Text(" where n is the column index you are adding.")
        Image("media/Blocks/DataScience1/ToText.png", "A snippet of code that reads:
use Libraries.Compute.Statistics.DataFrame
DataFrame frame
frame:Load(''Data.csv'')
frame:AddSelectedColumnRange(0,2)")
        Paragraph("There are two ways to add a selected column to the selection list in DataFrame. One approach is to add it by an index, starting at 0, which is from the left hand side in a spreadsheet. The other is to use its name, like "):DoubleQuote():Text("Dog"):DoubleQuote():Text(" or "):DoubleQuote():Text("Cat"):DoubleQuote():Text(", as a text value. As a non-obvious rule, this name may not contain spaces. You may also select a range of columns using "):Code("AddSelectedColumnRange(n1,n2)"):Text(" where the n-parameters indicate the column index ranges you are trying to add.")
        Subsection("Outputting a DataFrame")
        Paragraph("Sometimes when using DataFrame objects, you want to get a sense for whether you have loaded it correctly. All DataFrame objects can output themselves to the console for this purpose using an action called "):Code("ToText()"):Text(". There are three versions, "):Code("ToText"):Text(" and two others with parameters related to printing out only pieces of the system.")
        Paragraph("For example, the following shows the output of 5 rows from "):DoubleQuote():Text("Dogs.csv"):DoubleQuote():Text(". It is important to note that although you have "):DoubleQuote():Text("selected"):DoubleQuote():Text(" the columns, the action "):Code("ToText()"):Text(" will output the entire DataFrame. Your selection becomes useful when you are manipulating or transforming data such as adding your data to a chart.")
        Image("media/Blocks/DataScience1/ToTextExample.png", "A snippet of code that reads:
use Libraries.Compute.Statistics.DataFrame
DataFrame frame
frame:Load(''Data.csv'')
frameLAddSelectedColumn(0)
frame:ToText()

The console output shows the CSV file. The content of this file is not important, but it contains about 10 columns of material.")
        Subsection("Blocks in Disguise")
        Paragraph("While up until now, you have used only the blocks system for programming, under the hood, you have been programming in text. All blocks, with no exceptions, are automatically translated from text and on disk, all of the code can be examined in raw text. This means that any code used can be copy pasted as text into text editors, used on websites as text (e.g., Stack Overflow, Github) and sent to each other in emails without pasting pictures. It can also be pasted back into the block editor in the same way. In many block languages, there is an academic debate about blocks or text, but in Quorum blocks they are the same thing. When blocks are on, the system uses the exact same code, in exactly the same way, for exactly the same reason. The only difference, for the user, is that if they choose to have them on, they look different and the searchable palette is available. Using them is personal preference.")
        Paragraph("As an example, the final code for this DataFrame example was copy pasted from the blocks environment and lives as text below:")
        CodeExample("use Libraries.Compute.Statistics.DataFrame
DataFrame frame
frame:Load(" + dq + "data/Dogs.csv" + dq + ")
frame:AddSelectedColumnRange(0, 2)
frame:ToText(10)")
        Paragraph("You can copy paste this example back and it would convert itself back to blocks. The number 10, in the final line of code, means to output only the first 10 lines of the DataFrame.")
        Subsection("Finding Central Tendencies")
        Paragraph("Finding operations that can be done in data science is explored through the palette. On the left-hand side where you go to click and drag all the blocks, or use the keyboard to do the same operation, notice that there is a filter search. If you know the name of the operation you want, like mean, it will try to find supported actions. In this case, that is "):Code("frame:Mean()"):Text(".")
        Image("media/Blocks/DataScience1/DataFrameMean.png", "Screenshot of filtering the DataFrame object by finding the Mean action and filters out actions without the keyword: mean")
        Paragraph("Now that you have placed your block, you will probably want to output the calculation. The nifty feature using Quorum blocks is that you are directly able to edit the text on the block therefore when you have your mean action called, you can modify the block to be: "):Code("output frame:Mean()"):Text(". You can do the exact same operation in text and under the hood it really is identical. The difference is you do not get the palette in text mode.")
    end

    private action Engage
        Section("Engage")
        Paragraph("Data science has historically been complex and can be daunting to understand. The language used by statisticians was often designed, written, and implemented by other statisticians that likely could not have predicted data science would exist in the future, let alone that it might be programmed on a seemingly magical box that can do seemingly magical calculations. In this activity, you will participate in statistical calculations, but unlike traditional statistics, you will achieve this through exploring DataFrame actions.")
        Subsection("Introduction")
        Paragraph("The broad idea in statistics is that tests are conducted to try to determine what is true or false. So far, you have selected a column, or a set of columns in a data set. Now you are going to practice extracting and analyzing data. To start, "):Link("download the National Weekly Pfizer Allocations for COVID-19 dataset.", "https://data.cdc.gov/Vaccinations/National-Weekly-Pfizer-Allocations/sxbq-3sid")
        Paragraph("Load the dataset into the system, then work with the two columns that contain numbers. The CSV file should go in the project folder where you made the project. For consistency, use the name "):DoubleQuote():Text("Data.csv"):DoubleQuote():Text(". If you are unsure about the code, you may use the code from the explore section as a guide, and just change which columns are selected.")
        Paragraph("With your loaded dataset, you will be performing some statistical calculations with the DataFrame object. Here are some of the calculations you can perform by calling actions on the object:")
        BulletList()
        ListItem("Mean")
        ListItem("Median")
        ListItem("Standard Deviation")
        ListItem("Variance")
        ListItem("Kurtosis")
        Paragraph("Use each of these statistical calculations on the dataset provided. Be sure to properly read in your CSV file and select a column to perform your calculations on.")
        Paragraph("If you want extra practice, try formatting your output to make your results readable using the following format:")
        CodeExample("Central Tendencies of the following Column: [Column Header]
Mean: [DATA CALCULATION]
Median: [DATA CALCULATION]
Standard Deviation: [DATA CALCULATION]
Variance: [DATA CALCULATION]
Kurtosis: [DATA CALCULATION]")
        Paragraph("If you have time, calculate the same tendencies with a different column after the first output. For this second calculation, you will need to duplicate your steps and create an additional DataFrame object and repeat the load, or else you will encounter an error. However, this method seems a little inefficient. See if you can look through the available actions inside of the blocks tab to "):DoubleQuote():Text("empty"):DoubleQuote():Text(" your DataFrame.")
        Paragraph("When you properly completed the calculations, double check your answers with the output below:")
        CodeExample("Central Tendencies of the following Column: 1st Dose Allocations
Mean: 62061.63265306125
Median: 38025.0
Standard Deviation: 81206.03894539685
Variance: 6.59442076120131E9
Kurtosis: 14.60309669876606

Central Tendencies of the following Column: 2nd Dose Allocations
Mean: 61923.45238095237
Median: 38025.0
Standard Deviation: 81217.91840322685
Variance: 6.596350269753216E9
Kurtosis: 14.611164710632751")
        Subsection("Wrap up")
        Paragraph("Reflect on what you have worked on in some applications of Data Science. Though you have scratched the surface, the operations have many more operations available. For example, you can calculate regression formulas, create charts, and many other things. How do you imagine you could use such libraries in your setting? How would these libraries benefit a student wanting to explore career paths in Data Science?")
    end
end
