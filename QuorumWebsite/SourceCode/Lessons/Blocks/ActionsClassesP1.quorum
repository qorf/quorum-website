use Libraries.Web.Page.QuorumPage
use Libraries.Web.Page.TableRowWriter

/*
    Hour 11: Actions and Classes - Part 1.
    Converted from the old Lesson page by plan 13's generator: the same
    words, now without Tailwind.
*/
class ActionsAndClassesP1 is QuorumPage
    // A double quote, for code and words that hold one.
    text dq = ""
    // The table row being written, when its cells hold more than words.
    TableRowWriter row = undefined

    on create
        SetLocation("tutorials/blocks/ActionsAndClassesP1.html")
        // The name lists and links use, and the series and track it belongs
        // to: its section and picture.
        SetShortTitle("Actions and Classes Part 1")
        SetSectionName("Quorum Blocks")
        SetCardImage("/media/gettingStarted.png")
        // For search engines and link previews, and what lists of pages say.
        SetDescription("Learn how to create actions in Quorum")
        SetSummary("how to create actions")
    end

    action Setup
        dq = dq:GetDoubleQuote()
        SetWebPageTitle("Actions and Class, Part 1 - Quorum Programming Language")
        Title("Hour 11: Actions and Classes - Part 1")
        Paragraph("This lesson will introduce you to the basics of actions and classes in Quorum.")
        Overview()
        WarmUp()
        Explore()
        Engage()
    end

    private action Overview
        Section("Overview")
        Paragraph("In previous lessons, you have seen how to use objects from libraries and how to call actions from those objects. In this lesson, you will learn how to make your own. The first part will focus on learning how to create and use actions.")
        Subsection("Goals")
        Paragraph("You have the following goals for this lesson:")
        BulletList()
        ListItem("Learn how to use "):DoubleQuote():Text("action"):DoubleQuote():Text(" blocks to create an action")
        ListItem("Learn about the optional properties of actions: parameters and return values")
        ListItem("Discuss how "):DoubleQuote():Text("scope"):DoubleQuote():Text(" impacts variables declared in and out of actions")
    end

    private action WarmUp
        Section("Warm up")
        Paragraph("Actions allow programs the ability to perform a task. In the previous lesson, while you were working on Form apps, recall when you were using block commands:")
        CodeExample("page:AddBanner(" + dq + "banner1" + dq + ", " + dq + "About me!" + dq + ", " + dq + "Welcome reader to my about me page!" + dq + ")
page:AddButton(" + dq + "Click me!" + dq + ")")
        Paragraph("Each of these calls are an action. Why might programmers write these for us instead of having us write them all ourselves?")
        Subsection("Vocabulary")
        Paragraph("You will be learning about the following vocabulary words:")
        Table("Vocabulary")
        TableHeader():Cell("Term"):Cell("Definition")
        TableRow():Cell("Action"):Cell("A named sequence of code that can be reused later in a program.")
        TableRow():Cell("Action Call"):Cell("Code that tells an action to run.")
        TableRow():Cell("Parameter"):Cell("A special variable inside an action. It must be provided as an input when the action is called.")
        TableRow():Cell("Return Value"):Cell("The result of an action, which can be used like a variable.")
        TableRow():Cell("Scope"):Cell("The area where a variable exists and can be used.")
        TableRow():Cell("Class"):Cell("A structure that defines a custom Object type. It can contain variables and actions.")
        Subsection("Code")
        Paragraph("You will be using the following new pieces of code:")
        Table("New Code to Learn")
        TableHeader():Cell("Quorum Code"):Cell("Code Example"):Cell("Explanation")
        row = TableRow()
        row:Cell():Text("action "):Code("NAME"):NewLine():Text("end")
        row:Cell():Text("action AddNumbers"):NewLine():Text("end")
        row:Cell():Text("Creates an action/function inside of Quorum.")
        row = TableRow()
        row:Cell():Text("action "):Code("NAME"):Text("("):Code("TYPE VARIABLE_NAME"):Text(")"):NewLine():Text("end")
        row:Cell():Text("action AddNumbers(integer a, integer b)"):NewLine():Text(" value = a + b"):NewLine():Text("end")
        row:Cell():Text("Creates an action that uses parameters, letting you pass in values from the main program to be used in the action.")
        row = TableRow()
        row:Cell():Text("action "):Code("NAME"):Text(" returns "):Code("TYPE"):NewLine():Text("end")
        row:Cell():Text("action AddNumbers(integer a, integer b) returns integer"):NewLine():Text(" value = a + b"):NewLine():Text(" return value"):NewLine():Text("end")
        row:Cell():Text("Creates an action inside of Quorum that returns a value back once the function is finished.")
        row = TableRow()
        row:Cell():Text("return "):Code("VALUE")
        row:Cell():Text("return myVariable")
        row:Cell():Text("Code that reports the result of an action. The given value is sent back to the code that called the action.")
        row = TableRow()
        row:Cell():Text("class "):Code("NAME"):NewLine():Text("end")
        row:Cell():Text("class Calculator"):NewLine():Text("end")
        row:Cell():Text("Creates a class, which can contain variables and actions.")
        Subsection("CSTA Standards")
        Paragraph("This lesson covers the following "):Link("standards", "https://csteachers.org/k12standards/interactive/"):Text(":")
        BulletList()
        ListItem():Strong("3A-AP-17"):Text(": Decompose problems into smaller components through systematic analysis, using constructs such as procedures, modules, and/or objects.")
        ListItem():Strong("3A-AP-15"):Text(": Justify the selection of specific control structures when tradeoffs involve implementation, readability, and program performance, and explain the benefits and drawbacks of choices made.")
    end

    private action Explore
        Section("Explore")
        Paragraph("As you grow more comfortable with programming, you start to pick up ways to reuse code. So far, you have learned how to shorten repetitive commands by using loops and conditionals using "):DoubleQuote():Text("repeat"):DoubleQuote():Text(" and "):DoubleQuote():Text("if"):DoubleQuote():Text(" statements. This lets you reuse concepts, but as code increases in complexity, you need to reuse bigger pieces.")
        Paragraph("You have already seen that you can instruct "):Strong("objects"):Text(" to execute named pieces of code. Unfortunately, the field of computer science never really settled on standardized terms, but common ones include "):DoubleQuote():Text("function"):DoubleQuote():Text(", "):DoubleQuote():Text("procedure"):DoubleQuote():Text(", "):DoubleQuote():Text("method"):DoubleQuote():Text(", or "):DoubleQuote():Text("action"):DoubleQuote():Text(". In Quorum, they are called "):DoubleQuote():Text("actions"):DoubleQuote():Text(", because evidence in the academic literature suggests this name is reasonable [1]. Regardless of the language, this concept is a core feature of modern programming and you really cannot avoid it.")
        Paragraph("An "):Strong("action"):Text(" is a chunk of code that has a name. Just like you saw when using objects before, you can run the code in an action by calling its name. Actions are essential, especially as your programs start to become more complicated.")
        Paragraph("Here are a few of the benefits of using actions:")
        BulletList()
        ListItem("Actions allow you to reuse code.")
        ListItem("Actions can abstract code, letting you focus on what task an action performs without worrying about how it does it.")
        ListItem("Actions can break up a program into smaller pieces, which can make it easier to divide responsibilities between different people on a team.")
        ListItem("Actions can allow others to tap into functionality that they might not know how to write themselves.")
        Paragraph("Actions are very important. So important, in fact, that you have been using them in every program you have written so far, even if it was not obvious. When you write a Quorum program that does not include any actions, one is secretly generated behind the scenes for you. This secret action is called "):DoubleQuote():Text("Main"):DoubleQuote():Text(", and it wraps around all the code you have written. This action is important because a program always starts at the beginning of the special "):DoubleQuote():Text("Main"):DoubleQuote():Text(" action, even if you have other actions.")
        Paragraph("The image below shows a simple Quorum program, and what it secretly converts to under the hood. These two programs are functionally identical.")
        Image("media/Blocks/ActionsClasses1/SecretMainAction.png", "This is a diagram showing how an output hello style block is secretly wrapped by an action behind the scenes. Visually, it is a flowchart with the output going to an action main wrapping the action. The visual is not a metaphor. Quorum literally does this behind the scenes.")
        Paragraph("Although evidence in the literature is not definitive, it is at least plausible that Quorum's automatic hiding of this feature is beneficial for some [2]. Once you start to write more complex programs, though, you will need to identify where you want to start your program. This requires you to define your Main function, which you can do with the following lines of code:")
        CodeExample("action Main 
end")
        Paragraph("Any program that includes actions must have a "):DoubleQuote():Text("Main"):DoubleQuote():Text(" action. A sample program that includes a Main and another action would be the following:")
        Image("media/Blocks/ActionsClasses1/ExampleMainAction.png", "A snippet of Quorum block code with 6 lines that read:
action Main
    SayGreeting()
end
action SayGreeting()
    output ''Hello Friend!''
end")
        Paragraph("In this code example, the program starts at the Main action and runs each command in order until the program reaches the Main action's end. Look at how the program executes, step by step:")
        BulletList()
        ListItem("The program always begins on the first line inside the Main action. In this case, it starts on line 2.")
        ListItem("The SayGreeting action is called. The program jumps to the first line inside the SayGreeting action, on line 5.")
        ListItem("The code on line 5 executes. The program outputs "):DoubleQuote():Text("Hello Friend!"):DoubleQuote()
        ListItem("The program advances to line 6. Because this is the end of the action, the program returns to where it was before the action was called, back to line 2.")
        ListItem("The program advances to line 3. Since this is the end of the "):DoubleQuote():Text("Main"):DoubleQuote():Text(" action, there is no more code left to run, so the program terminates.")
        Subsection("Actions and the Block Palette")
        Paragraph("In the block palette, the "):DoubleQuote():Text("Actions"):DoubleQuote():Text(" tab has several different action blocks available. While they all function similarly, some of the action blocks have additional properties.")
        Image("media/Blocks/ActionsClasses1/ActionPalette.png", "A screenshot of part of the Action tab. It shows the three types of actions, as well as the return block.")
        Subsection("Actions without Additional Properties")
        Paragraph("The first block in the palette is the simplest form of action. This is the kind of action you saw in the previous examples so far. It does not have parentheses, extra values (called "):Strong("parameters"):Text("), or a "):DoubleQuote():Text("return"):DoubleQuote():Text(" label. The "):DoubleQuote():Text("Main"):DoubleQuote():Text(" action must always be in this format. It cannot take additional parameters.")
        Subsection("Actions with Parameters")
        Paragraph("The second option in the block palette has parentheses, along with a type and a variable name. This action uses what is known as a "):Strong("parameter"):Text(". Parameters are special variables that are between parentheses in action blocks. These variables only exist in the scope of an action and their value is set to whatever value you use when you call the action.")
        Paragraph("Parameters provide a way to give input to your actions. This is useful when the action is intended to perform a task on something that could vary. For example, if your action performs math operations, you might need a parameter to specify what value you are performing math on.")
        Paragraph("The example below shows a program using an action with a parameter. When the code executes, it runs the "):DoubleQuote():Text("PrintValue"):DoubleQuote():Text(" action twice. The first time, the provided parameter is 2, so the "):DoubleQuote():Text("value"):DoubleQuote():Text(" variable is set to 2 inside of "):DoubleQuote():Text("PrintValue"):DoubleQuote():Text(". The second time it is run, the provided parameter is 4, so the "):DoubleQuote():Text("value"):DoubleQuote():Text(" variable is set to 4.")
        Image("media/Blocks/ActionsClasses1/PrintValueExample.png", "A screenshot of a Quorum program, that reads as follows:

action Main
PrintValue(2)
PrintValue(4)
end
action PrintValue(integer value)
output value
end")
        Paragraph("Actions can have multiple parameters. To do so, you need to separate each parameter with a comma, like so:")
        CodeExample("action DefaultAction(type name1, type name2, type name3)
    // code
end")
        Paragraph("Then, calling that action needs the same number of parameters, separated by commas. The order matters -- the first provided parameter always sets the first variable, the second parameter the second variable, and so on. In the example below, the passed parameters are 10 and 6, and the output of the program is 4.")
        Image("media/Blocks/ActionsClasses1/PrintDifferenceExample.png", "A screenshot of a Quorum program that reads:

action Main
PrintDifference(10, 6)
end
action PrintDifference(integer value1, integer value2)
output value1 - value2
end")
        Subsection("Actions with Returns")
        Paragraph("So far you have created actions that can change their output based on a parameter, but actions can also give back a value. This is where the third block in the action palette comes in. It has a property called a "):Strong("return value"):Text("."):DoubleQuote():Text(" Return values can be thought of as the result of an action. If an action has a return value, you can use the action to set the value of a variable, output to the console, or use the returned value in basically any way that you could use a variable.")
        Paragraph("The image below shows an example using a return value. On line 2, the action is called, and its return value is assigned to the "):DoubleQuote():Text("result"):DoubleQuote():Text(" variable. The return value itself is on line 6, using a special block called "):DoubleQuote():Text("return."):DoubleQuote():Text(" The return block indicates what value is the result of the action. Different programming languages do it different ways, but typically return values must have a type and evidence suggests that forcing people to declare a type is, counterintuitively, helpful [3]. In this case, the return type is a number. This means the value in the "):DoubleQuote():Text("return"):DoubleQuote():Text(" block must match the type in the action. When the program in the example runs, it gets the result from the action, assigns it to a variable, then outputs it. The output is 7.")
        Image("media/Blocks/ActionsClasses1/ReturnExample.png", "A screenshot of a Quorum program. It reads:

action Main
number result = GetLuckyNumber()
output result
end
action GetLuckyNumber returns number
return 7
end")
        Subsection("Scope and Classes")
        Paragraph("In previous lessons, you have learned how multiple line blocks (like repeat and if blocks) have "):Strong("scope"):Text(", which means that variables declared inside of them cannot be used outside of them. Action blocks also follow this rule, so variables declared inside an action block cannot be used outside of them.")
        Paragraph("You can also share variables between actions. Since you cannot use a variable declared in one action in another, it would make sense to declare a variable outside of it instead. If you try to do that, though, you will encounter an error. In order to resolve this problem, you will need to use another new block: a "):Strong("class.")
        Paragraph("An example is shown below, once with blocks and then with code. It shows a program with a class, two actions, and a variable declared outside of the actions. You will learn more about classes later, but for now, you can think of a class as a container that holds actions and variables. For now, all that is important to know about class blocks is that they allow you to share variables across different actions.")
        Paragraph("The program begins with a variable called "):DoubleQuote():Text("globalVariable"):DoubleQuote():Text(" set to 4. When the program runs, it calls the "):DoubleQuote():Text("Double"):DoubleQuote():Text(" action, which sets the variable to 8. After the action concludes, the program returns to the Main action and outputs the variable. The output of the program is 8.")
        Image("media/Blocks/ActionsClasses1/ClassExample.png", "This demonstrates a class. The code is

class Main
   integer globalVariable = 4
   action Main
      Double()
      output globalVariable
   end

   action Double
      globalVariable = globalVariable * 2
   end
end")
        CodeExample("class Main
   integer globalVariable = 4
   action Main
      Double()
      output globalVariable
   end
   action Double
      globalVariable = globalVariable * 2
   end
end")
        Paragraph():Strong("[1]"):Text(" Andreas Stefik and Susanna Siebert. 2013. An Empirical Investigation into Programming Language Syntax. ACM Transactions on Computing Education 13, 4, Article 19 (November 2013), 40 pages."):Strong("[2]"):Text(" C. L. Corritore and S. Wiedenbeck, "):DoubleQuote():Text("Direction and scope of comprehension-related activities by procedural and object-oriented programmers: an empirical study,"):DoubleQuote():Text(" Proceedings IWPC 2000. 8th International Workshop on Program Comprehension, Limerick, Ireland, 2000, pp. 139-148, doi: 10.1109/WPC.2000.852488."):Strong("[3]"):Text(" Stefan Endrikat, Stefan Hanenberg, Romain Robbes, and Andreas Stefik. 2014. How do API documentation and static typing affect API usability?. In Proceedings of the 36th International Conference on Software Engineering (ICSE 2014). ACM, New York, NY, USA, 632-642.")
    end

    private action Engage
        Section("Engage")
        Paragraph("Now that you have learned the basics of actions, you will make a program that uses them. You will use actions to solve puzzles. While perhaps a bit cheesy, you may learn some magic along the way. Or, well, at least something magic adjacent.")
        Image("media/Blocks/ActionsClasses1/WizardTable.png", "A cluttered table with candles, potion flasks, and a leatherbound tome. The window shows a snowy scene outside. This looks like a wizard's study.")
        Paragraph():Link("Photo by Amandine BATAILLE", "https://unsplash.com/photos/a-wooden-table-topped-with-a-bottle-of-wine-next-to-a-window-31mUw23QL74")
        Subsection("Directions")
        Paragraph("Welcome to Bogmort's School of Mathcraft and Calculatry. As a new, uh, wizard, you are given four spells that can reshape the very fabric of reality (by performing simple arithmetic on a number). These are the four spells you learn:")
        BulletList()
        ListItem("Incremento: Add 1 to a value.")
        ListItem("Subtractio: Subtract 3 from a value.")
        ListItem("Multifour: Multiply a value by 4.")
        ListItem("Dividenadd: Divide a value by 2, then add 10.")
        Paragraph("You will undergo four different trials at the school. At the beginning of each trial, you start with 0 magic points. You must use your new spells to increase your magic points to exactly the required number for each trial. For example:")
        Paragraph("Example Trial: Get your magic points to 9.")
        Paragraph("You could solve the trial using these spells:")
        BulletList()
        ListItem("You start the trial with 0 magic points.")
        ListItem("You cast Incremento, increasing your magic points to 1.")
        ListItem("You cast Multifour, increasing your points to 4.")
        ListItem("You cast Dividenadd. Your points are halved to 2, then you add 10, so you have 12 points.")
        ListItem("You cast Subtractio, bringing your points down to 9.")
        Paragraph("To complete the trials:")
        BulletList()
        ListItem("Make a program with integer variables to track your magic points.")
        ListItem("Create an action for each of your four spells. You may want to create actions that take in parameters and return values in order for your program to work.")
        ListItem("Because it is proper wizard etiquette to announce your spells when you cast them, you should say or output the spell's name as part of each action (exclamation points optional, but encouraged).")
        ListItem("In your Main action, use your spells to complete the trials. Output your magic points at the end of each trial to see your result.")
        Paragraph():Strong("Trial 1:"):Text(" Get your magic points to 13.")
        Paragraph():Strong("Trial 2:"):Text(" Using each spell exactly once, get your magic points to 38.")
        Paragraph():Strong("Trial 3:"):Text(" Using only one spell as many times as you need, get your magic points to 963.")
        Paragraph():Strong("Trial 4:"):Text(" Get your magic points to 61 by casting 5 spells or fewer.")
        Subsection("Wrap up")
        Paragraph("Consider what your program would have looked like if you did not use actions. Did having actions make this program easier or harder to write? What if these so-called spells actually did some very complex math instead (e.g., calculate a sine, run a statistical test), would they then be more useful?")
    end
end
