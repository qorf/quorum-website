use Libraries.Web.Page.QuorumPage

/*
    Solutions Guide.
    Converted from the old Lesson page by plan 13's generator: the same
    words, now without Tailwind.
*/
class BlocksSolutions is QuorumPage

    on create
        SetLocation("tutorials/blocks/Solutions.html")
        // The name lists and links use, and the series and track it belongs
        // to: its section and picture.
        SetShortTitle("Guide Solutions")
        SetSectionName("Quorum Blocks")
        SetCardImage("/media/gettingStarted.png")
        // For search engines and link previews, and what lists of pages say.
        SetDescription("Take a look at the solutions guide for the lessons")
        SetSummary("access solutions to the PD lessons")
    end

    action Setup
        SetWebPageTitle("Solutions Guide - Quorum Programming Language")
        // Its editors and charts use the charts script.
        UseCharts()
        Title("Solutions Guide")
        Paragraph("In this section, you will be able to see and run all the correct solutions that are a part of this PD Course.")
        AboutTheSolutions()
    end

    private action AboutTheSolutions
        Section("About the Solutions")
        Paragraph("Once you have completed this course or at any time want to view the correct solution, this section is the place to find the answers to these problems. If you need any additonal assistance in explaining the solutions, feel free to contact the Quorum team.")
        Subsection("Hour 1: Introduction to Computer Science")
        Paragraph("Below is the solution for the following Blocks lesson 1. Press the run button to see the output.")
        CodeEditorFromProject("Say and Output", "Main.quorum", "examples/Blocks/H1.quorum")
        Subsection("Hour 3: Variables and Operators")
        Paragraph("Below is the solution for the following Blocks lesson 3. Press the run button to see the output.")
        CodeEditorFromProject("Farm Life", "Main.quorum", "examples/Blocks/H3.quorum")
        Subsection("Hour 6: Data Science Part 1")
        Paragraph("Below is the solution for the following Blocks lesson 6. Press the run button to see the output.")
        CodeEditorFromProject("Statistics Calculations", "Main.quorum", "examples/Blocks/H6.quorum")
        Subsection("Hour 7: Data Science Part 2")
        Paragraph("Below is the solution for the following Blocks lesson 7. Press the run button to see the output.")
        CodeEditorFromProject("Penguin Chart", "Main.quorum", "examples/Blocks/H7.quorum")
        Subsection("Hour 8: Loops")
        Paragraph("Below is the solution for the following Blocks lesson 8. Press the run button to see the output.")
        CodeEditorFromProject("Robot Loop Requests", "Main.quorum", "examples/Blocks/H8.quorum")
        Subsection("Hour 9: Conditionals")
        Paragraph("Below is the solution for the following Blocks lesson 9. Press the run button to see the output.")
        CodeEditorFromProject("Restaurant Menu", "Main.quorum", "examples/Blocks/H9.quorum")
        Subsection("Hour 10: Accessible Apps Part 1")
        Paragraph("Below is the solution for the following Blocks lesson 10. Press the run button to see the output.")
        CodeEditorFromProject("Form App Intro", "Main.quorum", "examples/Blocks/H10.quorum")
        Subsection("Hour 11: Actions and Classes Part 1")
        Paragraph("Below is the solution for the following Blocks lesson 11. Press the run button to see the output.")
        CodeEditorFromProject("Bogmort's Spell Challenge", "Main.quorum", "examples/Blocks/H11.quorum")
        Subsection("Hour 13: Actions and Classes Part 2")
        Paragraph("Below is the solution for the following Blocks lesson 13. Press the run button to see the output.")
        CodeEditorFromProject("Bogmort's Spellbook")
        EditorFileFromProject("Main.quorum", "examples/Blocks/H13.quorum")
        EditorFileFromProject("Spellbook.quorum", "examples/Blocks/Spellbook.quorum")
        Subsection("Hour 14: Accessible Apps Part 2")
        Paragraph("Below is the solution for the following Blocks lesson 14. Press the run button to see the output.")
        CodeEditorFromProject("Tempurature App")
        EditorFileFromProject("Main.quorum", "examples/Blocks/H14.quorum")
        EditorFileFromProject("TemperatureBehavior.quorum", "examples/Blocks/TempuratureBehavior.quorum")
    end
end
