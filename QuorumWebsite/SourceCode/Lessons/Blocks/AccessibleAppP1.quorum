use Libraries.Web.Page.QuorumPage

/*
    Hour 10: Create an Accessible App - Part 1.
    Converted from the old Lesson page by plan 13's generator: the same
    words, now without Tailwind.
*/
class AccessibleAppP1 is QuorumPage
    // A double quote, for code and words that hold one.
    text dq = ""

    on create
        SetLocation("tutorials/blocks/AccessibleAppP1.html")
        // The name lists and links use, and the series and track it belongs
        // to: its section and picture.
        SetShortTitle("Create Accessible Apps Part 1")
        SetSectionName("Quorum Blocks")
        SetCardImage("/media/gettingStarted.png")
        // For search engines and link previews, and what lists of pages say.
        SetDescription("Learn how to create an app in Quorum")
        SetSummary("how to learn about design and create apps in Quorum")
    end

    action Setup
        dq = dq:GetDoubleQuote()
        SetWebPageTitle("Creating an Accessible App - Quorum Programming Language")
        Title("Hour 10: Create an Accessible App - Part 1")
        Paragraph("This lesson is to teach you about the Forms library to make an accessible app.")
        Overview()
        WarmUp()
        Explore()
        Engage()
    end

    private action Overview
        Section("Overview")
        Paragraph("In this lesson, you will bring together the concepts you have learned to build an app using Forms. As you learn how to build Form apps, you will learn the importance of user interface design.")
        Subsection("Goals")
        Paragraph("You have the following goals for this lesson:")
        BulletList()
        ListItem("Create a Form")
        ListItem("Learn about the different kinds of items you can add to forms")
        ListItem("Build the interface for an app with at least 1 button")
        ListItem("Understand the purpose for user interface design")
    end

    private action WarmUp
        Section("Warm up")
        Paragraph("Think about apps or websites you have used in the past. Can you think of examples of apps or sites that were easy or hard to use? What kinds of things made the difference for you between a good or bad experience?")
        Subsection("Vocabulary")
        Paragraph("You will be learning about the following vocabulary words:")
        Table("Vocabulary")
        TableHeader():Cell("Term"):Cell("Definition")
        TableRow():Cell("Forms"):Cell("A library for creating interactive user interfaces")
        TableRow():Cell("User Interface"):Cell("A product’s appearance, interactivity, usability, behavior, and feel.")
        TableRow():Cell("User Interface Design"):Cell("A person's perceptions and responses that result from the use or anticipated use of a product, system or service.")
        TableRow():Cell("Design"):Cell("A plan or prototype that demonstrates the look or function of a product before it is built")
        TableRow():Cell("Button"):Cell("A control element that provides a way for a user to trigger an event")
        Subsection("Code")
        Paragraph("You will be using the following new pieces of code:")
        Table("New Code to Learn")
        TableHeader():Cell("Quorum Code"):Cell("Code Example"):Cell("Explanation")
        TableRow():Cell("use NAME"):Cell("use Libraries.Interface.Forms.Form"):Cell("A use statement for the Form object, which is the primary window for an app.")
        TableRow():Cell("use NAME"):Cell("use Libraries.Interface.Forms.Page"):Cell("A use statement for the Page object. A form can flip between pages as part of an app.")
        TableRow():Cell("use NAME"):Cell("use Libraries.Interface.Controls.Button"):Cell("A use statement for the Button object. A button can be selected to take an action.")
        TableRow():Cell("Form NAME"):Cell("Form form"):Cell("A variable declaration that makes a new Form.")
        TableRow():Cell("Page NAME"):Cell("Page page"):Cell("A variable declaration that makes a new Page. You can use the assignment operator on page with a Form")
        TableRow():Cell("Button NAME"):Cell("Button button"):Cell("A variable declaration that makes a new Button. You can use the assignment operator on page with a Form.")
        TableRow():Cell("FormObject:GetMainPage()"):Cell("form:GetMainPage()"):Cell("Assigns the main page of the form app. This is a formality and typically used for navigational purposes.")
        TableRow():Cell("FormObject:AddButton(title)"):Cell("form:AddButton(" + dq + "Click me!" + dq + ")"):Cell("Inserts a button into the interface of the Form app")
        TableRow():Cell("FormObject:Display()"):Cell("form:Display()"):Cell("When run, the program displays the running app via a Game window.")
        Subsection("CSTA Standards")
        Paragraph("This lesson covers the following "):Link("standards", "https://csteachers.org/k12standards/interactive/"):Text(":")
        BulletList()
        ListItem():Strong("2-CS-01"):Text(": Recommend improvements to the design of computing devices, based on an analysis of how users nteract with the devices.")
        ListItem():Strong("1B-CS-02"):Text(": Model how computer hardware and software work together as a system to accomplish tasks.")
    end

    private action Explore
        Section("Explore")
        Paragraph("When you hear the term "):DoubleQuote():Text("design"):DoubleQuote():Text(" you might think of the interior design of someone’s home, paintings in a gallery, or something related to art. Design is a much broader term, however, with applications that venture into technology and many other areas.")
        Paragraph("Many programmers methodically design code and programs to make the most sense to human comprehension. A growing field in the industry is Human Computer Interaction, where their role is to plan, strategize, and design apps and physical products for consumers or ensure a product fits a business’s needs.")
        Paragraph("Think about many of the apps you have used on your smartphone. Often, teams of developers and designers have worked together to produce a refined version of these apps which cater to what users want. This concept is called “user experience”, or sometimes shortened to "):DoubleQuote():Text("UX"):DoubleQuote():Text(" design. The basic idea is you want the user to feel like their needs were taken into account in the design.")
        Subsection("Accessibility in Design")
        Paragraph("Accessible design is an important concept for designers to make sure products can be used by everyone. A major consideration that designers should follow as applicable are the "):Link("Web Content Accessibility Guidelines (WCAG)", "https://www.w3.org/WAI/standards-guidelines/wcag/"):Text(", which focuses on accessible design on digital products (especially websites). WCAG is unusual in that it dovetails ideas in design, like how a web page is structured, but also serves as legal guidelines from the U.S. Department of Justice as of 2024 [1]. The changes made by this rule are significant, arguably a sea change, in that they require accessibility to be the default under certain conditions. There is plenty of nuance to be considered, but here are some examples of the type of information related to WCAG:")
        BulletList()
        ListItem():Link("ARIA Labels", "https://www.w3.org/TR/wai-aria/"):Text(": Providing adequate information for screen readers and other accessibility tools, sometimes including the use of ARIA or app structure.")
        BulletList()
        ListItem("Alternative Text (Alt-Text) on images and diagrams.")
        ListItem("Requiring appropriate color contrast for readability by anyone, but especially those with low or limited vision")
        ListItem("Providing transcripts for audio resources and subtitles for video resources.")
        Paragraph("When you begin programming your own apps, one thing you can do to make your apps feel more accessible is to ensure that all of your labels and buttons have meaningful, clear, names. This allows any user to understand what is happening in your programs, even if they are using accessibility tools like a screen reader.")
        Paragraph("Most programming languages support libraries for accessibility, in one form or another, but they vary considerably. Sometimes, features that may not seem accessibility related are. For example, languages must support keyboard navigation, present information to screen readers, and support some method for interacting with the operating system's accessibility layer. Further, languages can make it easier or harder to make applications accessible. With color, another common issue in accessibility, if a language makes non-WCAG compatible choices with color contrast, some or many users may find an application harder to read.")
        Subsection("Creating an App")
        Paragraph("Most programming languages have some mechanism for creating applications or apps, but what that even means varies. For Quorum specifically, apps are coded in one language and in one way, then generated for each platform you are on. The idea is you can write an app once, then run it on desktop, on the web, or on your phone.")
        Paragraph("The library you will be focusing on for this lesson is the "):Strong("Form"):Text(" library. The Form library lets you add "):Strong("buttons"):Text(", input fields, banners, images, etc. and program all these features so that they work with one another. In this lesson, you will learn about the structure and some basic elements within the Form library.")
        Subsubsection("Accessing the Form Library")
        Paragraph("There are two ways to access the Form library. The first is to create a new project and use the default template. For this, you go to the File Menu and select the New Project button. Similar to how you have been creating console projects, the "):DoubleQuote():Text("App"):DoubleQuote():Text(" project will provide a template for how the program should be structured. Give your project a name and press the "):DoubleQuote():Text("Ok"):DoubleQuote():Text(" button once you are ready to start.")
        Image("media/Blocks/AccessibleAppP1/CreateProject.png", "This shows the new project dialog with the App button selected. There are console, app, game, scene, and mobile options here. There is also a project name, location, browse information, and finally an ok and cancel button.")
        Paragraph("On first glance, notice that your project already has code provided. This template creates a default, puts a button labeled Hi on it, and loads it. Notice you do not need to embed any additional accessibility information. The application is automatically born accessible.")
        Image("media/Blocks/AccessibleAppP1/FormTemplate.png", "This application shows the default template for an app. It also shows the palette for the Form object.")
        Paragraph("The first two lines, "):Code("use Libraries.Interface.Forms.Form"):Text(" and "):Code("use Libraries.Interface.Forms.Page"):Text(" are the libraries that contain all the objects required to create the form app. The next line, "):Code("Form form"):Text(", creates your form object. The Form object is a graphical display that will open a window for your app to run in. Forms are also in charge of storing and keeping track of the different pages in your app. Some users prefer to give an object a different name (e.g., not "):DoubleQuote():Text("form"):DoubleQuote():Text(" to avoid it being the same), but this falls well within personal preference.")
        Paragraph("The next line reads "):Code("Page page = form:GetMainPage()"):Text(". A Page is a single screen on your app, including all of the buttons, labels, and other elements that will be on that screen. Just like viewing people’s profiles on Instagram or TikTok, the new displays are new pages.")
        Paragraph("When you use "):Code("form:GetMainPage()"):Text(", you are requesting that the system gives you the first Page that will be displayed when the app starts, otherwise known as the main Page. Any kind of interactive "):Strong("user interface"):Text(" component, like buttons, text boxes, fields, lists, trees, or other items, are added to a page.")
        Paragraph("Now that you have a Page, you add elements directly to it. This will make your elements appear on the screen. You can see the next line is "):Code("page:AddButton(" + dq + "Hi" + dq + ")"):Text(". This will add a button with a label that says "):DoubleQuote():Text("Hi"):DoubleQuote():Text(" on the first page of the app. Screen readers and other accessibility clients will read that the button is named "):DoubleQuote():Text("Hi."):DoubleQuote():Text(" If you prefer, you can change the name of the item or the description, which alters what accessibility devices would obtain.")
        Paragraph("The text form of this code is as follows:")
        CodeExample("use Libraries.Interface.Forms.Form
use Libraries.Interface.Forms.Page
Form form
Page page = form:GetMainPage()

page:AddButton(" + dq + "Hi" + dq + ")
form:Display()")
        Paragraph("Finally, in order to actually use the app, you use "):Code("form:Display()"):Text(". This will make the Form open the window and display the main Page.")
        Image("media/Blocks/AccessibleAppP1/RunApp.png", "This image shows Quorum Studio, but with your app inside it. It shows that app plus the Hi button in the middle. The button is blue with white text inside it.")
        Paragraph("While the template is convenient for creating a Form, it is not required. You could also choose to begin with a blank project and manually type out the libraries and the objects. While this method might be more tedious, all the information is the same. The key elements you should always include in your Form programs should be:")
        CodeExample("use Libraries.Interface.Forms.Form
use Libraries.Interface.Forms.Page 

Form form 
Page page = form:GetMainPage()

form:Display()")
        Paragraph("These five lines of code will be in most Form programs you create. All the other pieces of code are for you to explore and learn to practice creating user interfaces.")
        Subsubsection("Adding a Button")
        Paragraph("In order to add a button to your app, you must add it using the Page object by using "):Code("page:AddButton(name)"):Text(". The button’s label (and also the button’s name) will match the text you provide to the action.")
        Paragraph("Alternatively, if you have an image file (such as one with the extension JPG or png), you can make a button using that image. In this case, you can use "):Code("page:AddButton(name, filename)"):Text(", where the filename is a path to where the image is located. The path is always relative to your project’s location on your computer, so if you use this option, it is highly recommended you store your image files in your project folder.")
        Image("media/Blocks/AccessibleAppP1/Button.png", "Code blocks from the blocks tab with the page object that read:
page:AddButton(name)
page:AddButton(name, fileName)")
        Subsubsection("Adding Labels")
        Paragraph("To add text labels to your app, you need to add a label to the Page by using "):Code("page:AddLabel(name)"):Text(". The provided text will be both the label’s name as well as the text that it displays. By default, labels can be navigated by a screen reader.")
        Image("media/Blocks/AccessibleAppP1/Label.png", "Code block from the blocks tab with the page object that read:
        page:AddLabel(name)")
        Subsubsection("Adding a Banner")
        Paragraph("A Banner is a more complex element that can include multiple parts. How many parts are present in your app depends on how much information you give the action to make it. If you provide just a single piece of information using "):Code("page:AddBanner(title)"):Text(", the banner will have a single label with your given text.")
        Paragraph("Alternatively, if you give a second piece of text using "):Code("page:AddBanner(title, label)"):Text(", the banner will have both a title label and a secondary label beneath it. Finally, the third option, "):Code("page:AddBanner(name, title, label)"):Text(" works similarly to the previous option. In this case, the first value is the name, which will be read by screen readers and other accessibility technologies. Then, the second and third values are the title text and secondary label, respectively. You can use this option if you want to fine-tune the accessibility information separate from the text of the title.")
        Image("media/Blocks/AccessibleAppP1/Banner.png", "This shows a snippet from the palette for actions related to the banner. There are three AddBanner actions, the first with just a title. The second has name, title, and label. The third is title and label.")
        Paragraph():Strong("[1]"):Text(" U.S. Department of Justice. Fact Sheet: New Rule on the Accessibility of Web Content and Mobile Apps Provided by State and Local Governments. April 2024. https://www.ada.gov/resources/2024-03-08-web-rule/")
    end

    private action Engage
        Section("Engage")
        Paragraph("So far, you have learned about user interfaces and how to set up a basic app in Quorum Studio. Your task now is to become more comfortable in your design skills and start to add elements to your app. Your goals for this activity are to:")
        BulletList()
        ListItem("Properly set up a Form app")
        ListItem("Add at least one button")
        ListItem("Add text")
        ListItem("Add a banner")
        Subsection("Directions")
        Paragraph("With your first app, work on making an "):DoubleQuote():Text("About Me"):DoubleQuote():Text(" page. You should include a banner, at least 1 button, and at least 3 labels. You can also feel free to explore the other elements and add more, if you want to. Your app is accessible by default, so no additional work is required unless you want to customize the experience, visually or otherwise.")
        Paragraph("On your app, your banner should say something such as "):DoubleQuote():Text("About Me!"):DoubleQuote():Text(" and include a subtitle of your choice that describes you. Your labels might include a few sentences about yourself, your hobbies, your favorite foods, etc. Lastly, your button should have a label – it might include an invitation to learn more, or it could just say your favorite word.")
        Paragraph("You can use the following template to get you started:")
        CodeExample("use Libraries.Interface.Forms.Form
use Libraries.Interface.Forms.Page

Form form
Page page = form:GetMainPage()

form:Display()")
        Paragraph("When you finish your project and run it, your app might look something similar to this screenshot below:")
        Image("media/Blocks/AccessibleAppP1/Form.png", "This is an example about page about the person that wrote this example app, Kristine Monsada. She is a UX designer, graduated from UNLV in 2022, likes math and LEGOS. She also just got engaged, but don't tell her I told you, as it is not in the image. ")
        Paragraph("Note that this app is a static application. Although you are adding a button, it technically does not do anything yet. In a future lesson, you will learn how to add functionality to your apps.")
        Subsection("Wrap up")
        Paragraph("So far, you have only scratched the surface on app design, but you can invent whatever you want. What kind of app do you think you, or people you know, might want invented?")
    end
end
