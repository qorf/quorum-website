use Libraries.Web.Page.QuorumPage

/*
    Hour 9: Conditionals.
    Converted from the old Lesson page by plan 13's generator: the same
    words, now without Tailwind.
*/
class BlocksConditionals is QuorumPage
    // A double quote, for code and words that hold one.
    text dq = ""

    on create
        SetLocation("tutorials/blocks/BlocksConditionals.html")
        // The name lists and links use, and the series and track it belongs
        // to: its section and picture.
        SetShortTitle("Conditionals")
        SetSectionName("Quorum Blocks")
        SetCardImage("/media/gettingStarted.png")
        // For search engines and link previews, and what lists of pages say.
        SetDescription("Learn how to create conditional statements in Quorum")
        SetSummary("how to create conditionals in Quorum")
    end

    action Setup
        dq = dq:GetDoubleQuote()
        SetWebPageTitle("Learn Conditionals - Quorum Programming Language")
        Title("Hour 9: Conditionals")
        Paragraph("This lesson is to teach you about conditionals.")
        Overview()
        WarmUp()
        Explore()
        Engage()
    end

    private action Overview
        Section("Overview")
        Paragraph("So far, you have made programs that are sequential, meaning they always follow the same set of instructions from start to finish. In practice, programs are rarely so linear. Often, you need to do different things depending on different circumstances. In this lesson, you will learn how you can use conditional statements to change what code you run.")
        Subsection("Goals")
        Paragraph("You have the following goals for this lesson:")
        BulletList()
        ListItem("Learn how to use "):DoubleQuote():Text("if"):DoubleQuote():Text(" statements to control program execution")
        ListItem("Learn how to further control code with "):DoubleQuote():Text("else"):DoubleQuote():Text(" and "):DoubleQuote():Text("elseif"):DoubleQuote():Text(" blocks")
        ListItem("Learn how "):DoubleQuote():Text("scope"):DoubleQuote():Text(" affects variables created inside "):DoubleQuote():Text("if"):DoubleQuote():Text(" statements")
    end

    private action WarmUp
        Section("Warm up")
        Paragraph("Traveling somewhere new can be fun, but it can also require planning. When you plan for a vacation or other travel, what are some factors that you consider when you start to pack your suitcase? How do you decide what to bring? Now, consider your decision making process. Can you formalize your decision making into rules (e.g. if X, then I will bring Y)?")
        Subsection("Vocabulary")
        Paragraph("You will be learning about the following vocabulary words:")
        Table("Vocabulary")
        TableHeader():Cell("Term"):Cell("Definition")
        TableRow():Cell("Conditional Statements"):Cell("Block programming is a style where visual blocks represent pieces of the computer code that can be manipulated through various forms of user input.")
        TableRow():Cell("Boolean Expression"):Cell("An expression in programming that evaluates to either true or false.")
        TableRow():Cell("Conditional"):Cell("An expression a program will check if true or false before proceeding to an action")
        Subsection("Code")
        Paragraph("You will be using the following new pieces of code:")
        Table("New Code to Learn")
        TableHeader():Cell("Quorum Code"):Cell("Code Example"):Cell("Explanation")
        TableRow():Cell("if (condition) end"):Cell("if weather = " + dq + "sunny" + dq + " //execute A end"):Cell("The if statement is a conditional statement. If the program evaluates the condition to be true, it will run the block of code contained inside.")
        TableRow():Cell("elseif"):Cell("if weather = " + dq + "sunny" + dq + " // execute A elseif weather = " + dq + "snowy" + dq + " // execute B end"):Cell("The elseif block is a conditional that is only checked if the previous conditions in the structure were false. If the previous conditions were false and the elseif’s condition is true, it will execute the code contained within the elseif.")
        TableRow():Cell("else"):Cell("if weather = " + dq + "sunny" + dq + " // execute A elseif weather = " + dq + "snowy" + dq + " // execute B else // execute C end"):Cell("This is the default case in a chained if statement. This code will always run if all another above if statements evaluate to false")
        Subsection("CSTA Standards")
        Paragraph("This lesson covers the following "):Link("standards", "https://csteachers.org/k12standards/interactive/"):Text(":")
        BulletList()
        ListItem():Strong("3A-DA-10"):Text(": Evaluate the tradeoffs in how data elements are organized and where data is stored.")
    end

    private action Explore
        Section("Explore")
        Paragraph("In previous lessons, you have worked with using an if statement to get started with learning about the different coding structures. In this lesson, you will learn how and why to use them. If statements are the key to making complex programs, as they represent a program’s ability to make decisions.")
        Image("media/Blocks/Conditionals/ConditionalBlocks.png", "A screenshot code blocks Quorum studio showing the conditionals available that read:
if true
end

elseif true

if true
else
end

else")
        Paragraph("Imagine that you are playing a simple video game. For example, perhaps you are facing an enemy and you have two decisions of what your next move would be: fight or flight. You could decide to formalize your decision making process with some rules. It might look something like this:")
        CodeExample("if creature = “monster”
	if health >= 50
		output “time to attack!”
		fightXP = fightXP + 1
	else 
		output “run away!”
	end
end")
        Paragraph("Using these rules, you can determine whether you have encountered a monster and whether you have enough health. Otherwise, you choose to run away. Just like you can formalize rules for your decision making, you can also make rules for the computer to follow. If statements allow you to control what code the computer executes depending on the rules or conditions you set.")
        Paragraph("There are 3 major parts of a conditional: the")
        BulletList()
        ListItem("if statement (plus conditional),")
        ListItem("0 or more elseif statements (plus conditional), and then an")
        ListItem("optional else statement.")
        Table("Parts of the If Statement")
        TableHeader():Cell("Quorum Code"):Cell("Code"):Cell("Explanation")
        TableRow():Cell("if condition end"):Cell("if true output " + dq + "hello world!" + dq + " end"):Cell("If there is only one action being tested, it will run the command if condition is true")
        TableRow():Cell("condition"):Cell("integer score = 87 score >= 90"):Cell("Typically a boolean statement used to test a condition and will execute code if condition is met with true")
        TableRow():Cell("if condition elseif condition end"):Cell("integer score = 87 if score >= 90 output " + dq + "excellent work!" + dq + " elseif score >= 80 output " + dq + "good job!" + dq + " end"):Cell("If there are two conditions one action being tested, it will run the command if initial condition is true, if false, it will test the next condition")
        TableRow():Cell("if condition elseif condition else end"):Cell("integer score = 87 if score >= 90 output " + dq + "excellent work!" + dq + " elseif score >= 80 output " + dq + "good job!" + dq + " else output " + dq + "keep practicing!" + dq + " end"):Cell("If there are two conditions, one action being tested, it will run the command if the initial condition is true, if false, it will test the next condition. If the 2nd test is false, it will run a default case (the else).")
        Subsection("Creating a Conditional Statement")
        Paragraph("Creating a conditional statement involves using the "):DoubleQuote():Text("if"):DoubleQuote():Text(" structure to define actions based on certain conditions.")
        Paragraph("In programming, the actual code for conditional statements varies between languages. For instance, in Quorum, it would look like this:")
        CodeExample("if conditional
   // perform action A
else
  // perform action B
end")
        Paragraph("When you think about how to write a conditional, it is often broken down into decision making where event A happens if the condition is true and event B happens if the condition is false.")
        Image("media/Blocks/Conditionals/conditional.png", "A flow chart format asking the question: Is it raining
If true, then you play indoors
If false, then you play outside")
        Paragraph("The "):DoubleQuote():Text("condition"):DoubleQuote():Text(" typically is a boolean statement that will run either true or false. These conditionals again use any or all of the following boolean operators:")
        BulletList()
        ListItem():Strong("Equality"):Text(" (=): Checks if two values are equal.")
        ListItem():Strong("Inequality"):Text(" (not=): Checks if two values are not equal.")
        ListItem():Strong("Greater than"):Text(" (>): Checks if one value is greater than another.")
        ListItem():Strong("Less than"):Text(" (<): Checks if one value is less than another.")
        ListItem():Strong("Greater than or equal to "):Text("(>=): Checks if one value is greater than or equal to another.")
        ListItem():Strong("Less than or equal to"):Text(" (<=): Checks if one value is less than or equal to another.")
        Paragraph("Additionally, there are logical operators that are often used with conditional operators to combine multiple conditions:")
        BulletList()
        ListItem():Strong("Logical AND"):Text(" (and): True if both conditions are true.")
        ListItem():Strong("Logical OR"):Text(" (or): True if at least one of the conditions is true.")
        ListItem():Strong("Logical NOT"):Text(" (not): Inverts the truth value of a condition.")
        Paragraph("You can use different types of variables with these conditional operators. For example: "):DoubleQuote():Text("5 < 10"):DoubleQuote():Text(" would result in "):Strong("true"):Text(" and "):DoubleQuote():Text("4 < 10 and 7 >= 15"):DoubleQuote():Text(" would result in "):Strong("false"):Text(".")
        Subsection("Nested Conditionals and " + dq + "elseif" + dq)
        Paragraph("It is possible (and sometimes useful) to place conditionals inside of other conditionals. Be careful when nesting them. Doing so is commonplace in programming, but some discretion to keep your code from getting confusing is warranted.")
        Image("media/Blocks/Conditionals/NestedLoops.png", "A 16 line code block in Quorum that reads: 
integer testScore = 75
text grade = 

if testScore > 90
    grade = A
else
    if testScore > 80
        grade = B
    else
        if testScore > 70
            grade = C
        else
            grade = D
        end
    end
end

output Students grade: + grade
")
        Paragraph("In this example, you have to think more carefully about what is going on in this piece of code because the testScores are so nested. In this example:")
        BulletList()
        ListItem("If the testScore is greater than 90, it gets an "):DoubleQuote():Text("A."):DoubleQuote()
        ListItem("Otherwise, it checks if the score is greater than 80 for a "):DoubleQuote():Text("B."):DoubleQuote()
        ListItem("If not, it looks at scores above 70 for a "):DoubleQuote():Text("C."):DoubleQuote()
        ListItem("Finally, anything below 70 gets a "):DoubleQuote():Text("D."):DoubleQuote()
        Paragraph("Scoping can be determined multimodally. Visually, some multi-line blocks are inside of each other and shoved to the right. This means they are self-contained in that region. Aurally, for screen reader users, although screen readers vary slightly in what they read, they tend to say first the line of code, in addition to the nesting level and the number of top level blocks inside that region. The idea is that you can get a sense of scope in different ways.")
        Paragraph("In this particular case, instead of nesting conditionals, you can use the "):DoubleQuote():Text("elseif"):DoubleQuote():Text(" block to test extra conditions. Examine the revised example below:")
        Image("media/Blocks/Conditionals/FixNested.png", "A screenshot of a Quorum program. It reads:
integer testScore = 75
text grade = 
if testScore > 90
    grade = A
elseif testScore > 80
    grade = B
elseif testScore > 70
    grade = C
else
    grade = D
end
output Students grade:  + grade")
        Paragraph():DoubleQuote():Text("Elseif"):DoubleQuote():Text(" statements are optional extra pieces you can add to an "):DoubleQuote():Text("if"):DoubleQuote():Text(" statement. They act as extra conditionals that are only tested if the conditions before them were false. Conditions are always evaluated in order, from top to bottom, and the if statement will never check or run other conditionals or their code if a previous condition was true.")
        Subsection("Nothing else worked, so else")
        Paragraph("As one final block, you can add an else block to an if statement. In text, this might be as follows:")
        CodeExample("if condition
   //do something
elseif condition2
  //do a different something
elseif condition3
  //do an even more different something
else
   //condition, condition2, and condition3 were all false
end")
        Paragraph("The basic idea is that the computer checks the condition in the "):DoubleQuote():Text("if"):DoubleQuote():Text(" first. If it is true, the block executes and then jumps to the final end. If it is false, it then checks condition 2, with the same procedure. The idea is that one, and only one, of the blocks runs.")
    end

    private action Engage
        Section("Engage")
        Paragraph("Now that you are more familiar with conditionals, it is time to practice using conditionals. Before you make your own program, start by guessing some of the outputs of these conditionals.")
        Subsection("Directions")
        Paragraph("This activity is divided into two parts.")
        Subsubsection("Task 1: Logic it out")
        Paragraph("When you are creating your conditional statements, you are essentially creating "):Strong("boolean expressions"):Text(" that are either true or false. Practice a few statements for you to determine what the output will be.")
        Paragraph():Emphasis("1. Does this statement result in true or false?")
        Image("media/Blocks/Conditionals/Phone.png", "A block of Quorum code that reads:
text q = ''What is your favorite phone?''
text answer = ''Android Phone''
if answer = ''Apple''
output ''I like the iPhone too!''
end")
        Paragraph():Emphasis("2. What does this code output?")
        Image("media/Blocks/Conditionals/BooleanExp.png", "A block of Quorum code that reads:
integer a = 5
integer b = 10
if a < b
output ''a is less than b.''
else
output ''b is greater than or equal to a.''
end")
        Paragraph():Emphasis("3. What does this code output?")
        Image("media/Blocks/Conditionals/Class.png", "A block of Quorum code that reads:
text class_choice = ''mage''
if class_choice = ''warrior''
    output ''strong and tough!''
elseif class_choice = ''mage''
    output ''magic spells!''
elseif class_choice = ''ranger''
    output ''bows and arrows!''
elseif class_choice = ''thief''
    output ''stealthiness''
else
    output ''please choose a class''
end")
        Paragraph():Emphasis("4. How could you change this program in order to make the output statement on line 3 run?")
        Image("media/Blocks/Conditionals/Vote.png", "A block of Quorum code that reads:
integer age = 17
if age >= 21
    output ''you can vote!''
end
    output ''you are old enough to vote!''")
        Subsubsection("Task 2: Restaurant Menu")
        Paragraph("In this activity, you will simulate a restaurant, where you will be creating and ordering off of a menu. Your menu should include 4 main courses, 3 drink options, and 2 dessert options.")
        Paragraph("In your code, you will use a series of "):DoubleQuote():Text("if"):DoubleQuote():Text(" statements to evaluate variables containing food orders. To choose your order, assign the food choice in a variable like so:")
        Image("media/Blocks/Conditionals/AccessoryVar.png", "A block of Quorum code that reads:
        text accessoryType = ''earrings''
output accessoryType")
        Paragraph("Using your assigned variables and "):DoubleQuote():Text("if"):DoubleQuote():Text(" statements, your computer will be your virtual waiter and ask what you would like to eat for dinner tonight. Try changing the values of your main course, drink, and dessert to see how the "):DoubleQuote():Text("if"):DoubleQuote():Text(" statements react. Bon appetit!")
        Paragraph("You are required to include "):DoubleQuote():Text("if"):DoubleQuote():Text(" statements, "):DoubleQuote():Text("elseif"):DoubleQuote():Text(" statements, and a default "):DoubleQuote():Text("else"):DoubleQuote():Text(" statement if a person orders an item not on the menu. At the end, be sure to output all the items that you are ordering.")
        Image("media/Blocks/Conditionals/RobotServer.jpg", "An image of a robot server inside of a restaurant next to an empty table.")
        Paragraph():Link("Restaurant delivery robot waiter by restaurant_robots", "https://unsplash.com/photos/white-and-black-air-cooler-hnNPdAt8u2k")
        Paragraph("You can use this code sample as a reference:")
        Image("media/Blocks/Conditionals/Accessory.png", "A block of Quorum code that reads:
        text accessory = ''necklace''
if accessory = ''hair clips''
    output ''the best hairclips are clips with bears on them!''
elseif accessory = ''earrings''
    output ''how many ear piercings do you have?''
elseif accessory = ''headband''
    output ''i love the mickey mouse headbands from disneyland!''
elseif accessory = ''necklace''
    output ''the best necklaces are always handmade''
elseif accessory = ''bracelet''
    output ''disney pandora bracelets are super cute!''
else
    output ''i'm not familiar with that accessory but i am sure it is beautiful!''
end
output ''your favorite accessory is '' + accessory")
        Paragraph("The code example of this below reads:")
        CodeExample("text accessory = " + dq + "necklace" + dq + "
if accessory = " + dq + "hair clips" + dq + "
    output " + dq + "the best hairclips are clips with bears on them!" + dq + "
elseif accessory = " + dq + "earrings" + dq + "
    output " + dq + "how many ear piercings do you have?" + dq + "
elseif accessory = " + dq + "headband" + dq + "
    output " + dq + "i love the mickey mouse headbands from disneyland!" + dq + "
elseif accessory = " + dq + "necklace" + dq + "
    output " + dq + "the best necklaces are always handmade" + dq + "
elseif accessory = " + dq + "bracelet" + dq + "
    output " + dq + "disney pandora bracelets are super cute!" + dq + "
else
    output " + dq + "i'm not familiar with that accessory but i am sure it is beautiful!" + dq + "
end
output " + dq + "your favorite accessory is " + dq + " + accessory")
        Subsection("Wrap up")
        Paragraph("Trade programs with a partner of your choice and have them order off your virtual restaurant. Have a short discussion and answer the following: How do you think an ordering kiosk, such as one in a fast food restaurant, processes orders?")
    end
end
