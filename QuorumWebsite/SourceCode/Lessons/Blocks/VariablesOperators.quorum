use Libraries.Web.Page.QuorumPage

/*
    Hour 3: Variables and Operators.
    Converted from the old Lesson page by plan 13's generator: the same
    words, now without Tailwind.
*/
class VariablesAndOperators is QuorumPage
    // A double quote, for code and words that hold one.
    text dq = ""

    on create
        SetLocation("tutorials/blocks/VariablesAndOperators.html")
        // The name lists and links use, and the series and track it belongs
        // to: its section and picture.
        SetShortTitle("Variables and Operators")
        SetSectionName("Quorum Blocks")
        SetCardImage("/media/gettingStarted.png")
        // For search engines and link previews, and what lists of pages say.
        SetDescription("Learn how create variables and use variable operatoes in Quorum")
        SetSummary("how create variables in Quorum")
    end

    action Setup
        dq = dq:GetDoubleQuote()
        SetWebPageTitle("Learn Variables and Operators - Quorum Programming Language")
        Title("Hour 3: Variables and Operators")
        Paragraph("This lesson is to teach you about variables and operators.")
        Overview()
        WarmUp()
        Explore()
        Engage()
    end

    private action Overview
        Section("Overview")
        Paragraph("When writing programs, you give the computer a set of instructions to perform. As part of these instructions, you can give it specific data, called "):Strong("variables"):Text(", at each step. When you hear the term variables, you might relate this topic to saving information. Your computer might save items you download, data you are keeping track of, or information about how you login to a website. In this lesson, you will learn about how to store information in a program using variables. You will also learn how to use operators, like math symbols, to change and combine this stored information.")
        Subsection("Goals")
        Paragraph("You have the following goals for this lesson:")
        BulletList()
        ListItem("Learn how to store information with variables")
        ListItem("Use the four "):DoubleQuote():Text("primitive"):DoubleQuote():Text(" variable types in Quorum")
        ListItem("Use operators to modify variables")
    end

    private action WarmUp
        Section("Warm up")
        Paragraph("Consider a few examples of technology in your life. For each of the examples below, what kinds of data do you think are being stored or changed?")
        BulletList()
        ListItem("Calculator")
        ListItem("Car speedometer")
        ListItem("Digital light switch")
        ListItem("e-Book")
        ListItem("Microwave")
        Paragraph("Can you think of other examples of technology that needs to store and change data?")
        Subsection("Vocabulary")
        Paragraph("You will be learning about the following vocabulary words:")
        Table("Vocabulary")
        TableHeader():Cell("Term"):Cell("Definition")
        TableRow():Cell("Variable"):Cell("A variable is a storage container. It has a name, a data type, and a value.")
        TableRow():Cell("integer"):Cell("Integers are whole numbers. They can never have a decimal point.")
        TableRow():Cell("number"):Cell("A number is a numerical value with a decimal point.")
        TableRow():Cell("text"):Cell("Text is any combination of written symbols, like letters or numbers.")
        TableRow():Cell("boolean"):Cell("A boolean variable can be only true or false.")
        TableRow():Cell("Primitive Variable"):Cell("A primitive variable is a variable that stores one of the four basic types of information: integers, numbers, booleans, or text.")
        TableRow():Cell("Operator"):Cell("An operator is a symbol that changes or combines pieces of data. The most common operators are math symbols like +, -, *, or /.")
        Subsection("Code")
        Paragraph("You will be using the following new pieces of code:")
        Table("New Code to Learn")
        TableHeader():Cell("Quorum Code"):Cell("Code Example"):Cell("Explanation")
        TableRow():Cell("integer NAME = VALUE"):Cell("integer a = 0"):Cell("Creates a new variable called NAME that can store integers, and puts VALUE in the container.")
        TableRow():Cell("number NAME = VALUE"):Cell("number b = 1.8"):Cell("Creates a new variable called NAME that can store numbers, and puts VALUE in the container.")
        TableRow():Cell("text NAME = VALUE"):Cell("text string = " + dq + "McDonald’s" + dq):Cell("Creates a new variable called NAME that can store text, and puts VALUE in the container.")
        TableRow():Cell("boolean NAME = VALUE"):Cell("boolean bool = true"):Cell("Creates a new variable called NAME that can store booleans, and puts VALUE in the container.")
        Subsection("CSTA Standards")
        Paragraph("This lesson covers the following "):Link("standards", "https://csteachers.org/k12standards/interactive/"):Text(":")
        BulletList()
        ListItem():Strong("2-AP-11"):Text(": Create clearly named variables that represent different data types and perform operations on their values.")
        ListItem():Strong("3A-DA-09"):Text(": Translate between different bit representations of real-world phenomena, such as characters, numbers, and images.")
        ListItem():Strong("3A-DA-10"):Text(": Evaluate the tradeoffs in how data elements are organized and where data is stored.")
    end

    private action Explore
        Section("Explore")
        Paragraph("Before you begin, you will need to make a new project to work on. As a reminder, you can make a new project by going to the File Menu and selecting the New Project button. For the project type, select "):DoubleQuote():Text("Console."):DoubleQuote():Text(" A console project really means that it is a blank canvas and you can then have it create whatever you like. Once you have made your project, open the "):DoubleQuote():Text("Main.quorum"):DoubleQuote():Text(" file in the project tree on the left. Then, open the "):DoubleQuote():Text("Blocks"):DoubleQuote():Text(" tab in the left pane. For this lesson, open the "):DoubleQuote():Text("Basic"):DoubleQuote():Text(" tab. Your project should look like the picture below.")
        Image("media/Blocks/Variables and Operators/HelloWorld.png", "A picture of Quorum Studio in dark mode. The left pane shows the Blocks tab with the Basic options selected. The right side has a hello world style output statement.")
        Paragraph("In previous lessons, when you have given instructions to the computer, like "):DoubleQuote():Text("output"):DoubleQuote():Text(" or "):DoubleQuote():Text("say"):DoubleQuote():Text(", you have given it specific words or other data to use on that line of code. You can tell an output or say statement to interact with a constant, like the integer 5, but you can also use variables.")
        Paragraph("A variable is a container for information. You can think of it like a box. The box has a label on it that describes what kind of stuff can go inside. The box also has a name written on it, so you can tell different boxes apart.")
        Paragraph("There are several blocks on the left side for variables. To start, think about one:")
        Image("media/Blocks/Variables and Operators/IntegerA.png", "A block that reads: integer a = 0")
        Paragraph("First, while the representation above is visual, computer programming often distinguishes between code and such visuals, like blocks. In the Quorum programming language, this distinction does not exist. The above is exactly, mathematically, identical to the line of code:")
        CodeExample("integer a = 0")
        Paragraph("Point being, throughout this lesson and the rest, just consider that while the language allows a block or text mode, what they both do is identical. It is purely personal preference which you or your students use. Both are accessible and any program can be written with either. In fact, when Quorum sends a block to be processed for creating the program you are writing, it is not using blocks at all. It just uses the text, but happens to have a visual representation that looks like a block and has extra information embedded for accessibility devices like screen readers. If the word block is referenced, thus, in this material, it is interchangeable with text.")
        Paragraph("This block creates a variable, and it has four parts. The first box reads "):DoubleQuote():Text("integer"):DoubleQuote():Text(", which describes the type of information that can be stored in the variable. The second box reads "):Strong(dq + "a" + dq):Text(", which is the variable's name. After the second box is an equal sign, which indicates "):Emphasis("assignment"):Text(" (which is just a fancy term for putting something in the variable box). The last box reads "):DoubleQuote():Text("0"):DoubleQuote():Text(", which is the value of the variable, or in other words, the data being put in the box. For screen reader users, note that this type, name, value terminology is embedded into the screen reader cues, but varies slightly depending on platform and which screen reader is used.")
        Subsection("An Introduction to Variables")
        Paragraph("Now consider how to make "):Strong("primitive variables"):Text(", which in this context means one of the four basic types: integer, number, boolean, or text. To start, place the "):DoubleQuote():Text("integer a = 0"):DoubleQuote():Text(" block at the top of your program. Then, place a "):DoubleQuote():Text("say"):DoubleQuote():Text(" or "):DoubleQuote():Text("output"):DoubleQuote():Text(" block after it.")
        Image("media/Blocks/Variables and Operators/CreateInteger.png", "A picture showing a program in Quorum Studio. The first block reads ")
        Paragraph("Your program now has a variable, but you are not doing anything with it yet. If you place the name of the variable into the info box on your statement, the result would look like this:")
        Image("media/Blocks/Variables and Operators/OutputInteger.png", "A picture showing a program in Quorum Studio. The first block reads integer a = 0 and the second block reads output a which will output our variable")
        Paragraph("If you run your program, it will still output or say the integer 0, but it will do that by looking up what the value of the variable a is in memory, then use that. Remember, you can run your program from the Run menu by selecting the Run option, or by clicking the green "):DoubleQuote():Text("play"):DoubleQuote():Text(" button on the toolbar, or by using the hotkey (Ctrl+R on Windows, or COMMAND+R on Mac).")
        Paragraph("When you run the program, it should output the value of the variable, which is 0.")
        Subsection("Valid and Invalid Variable Names")
        Paragraph("In order to make your output statement use your variable, you have to give it a name. In big programs, there are often many variables, so giving them meaningful names that represent the kind of purpose they hold can be helpful to human readers. A variable name can be almost anything, but there a few rules:")
        BulletList()
        ListItem("Variable names must start with a letter.")
        ListItem("A name can be made of lowercase letters, uppercase letters, numbers, and the underscore symbol, "):DoubleQuote():Text("_"):DoubleQuote():Text(".")
        ListItem("Names cannot contain spaces or other special characters.")
        ListItem("While quirky, variables cannot end with the underscore character.")
        Subsection("Variable Types")
        Paragraph("The first box of your variable block describes the "):DoubleQuote():Text("type"):DoubleQuote():Text(" of the variable. The block palette on the left side has four kinds of variables:")
        BulletList()
        ListItem():Strong("Integer"):Text(" are whole numbers. They can be positive or negative, but they never have a decimal point.")
        ListItem():Strong("Number"):Text(" are numerical values with a decimal point.")
        ListItem():Strong("Text"):Text(" is any sequence of text, including letters, numbers, special characters, etc. To indicate that something is text information instead of code, text is wrapped in quotation marks.")
        ListItem():Strong("Boolean"):Text(" are data with exactly two possible values: true or false.")
        Paragraph("These four data types are the building blocks of data and sometimes called "):Strong("primitive types"):Text(". The reason is a bit complex, but has to do with how the computer stores certain kinds of data in memory as a program executes. In Quorum, it is also somewhat misleading, because text values are not stored this way. In any case, these are at least common types. The following shows a larger example of using several types of variables:")
        Image("media/Blocks/Variables and Operators/DefaultVarBlocks.png", "A picture of a Quorum program with 9 blocks, as follows:
integer wholeNumber = 0
number decimalNumber = 0.0
boolean myBooleanValue = true
text greetings = ''words''
blank block
say wholeNumber
say decimalNumber
say myBooleanValue
say greetings")
        Paragraph("While the above is an image with an alternative description, in code, because the blocks are exactly equivalent to text, if you were to select all blocks and copy paste, you would have the following text:")
        CodeExample("integer wholeNumber = 0
number decimalNumber = 0.0
boolean myBooleanValue = true
text greetings = " + dq + "words" + dq + "

say wholeNumber
say decimalNumber
say myBooleanValue
say greetings")
        Subsection("Operators")
        Paragraph("While programming, you often need to use math to run calculations. Fortunately, the operators young people learn are largely very similar to what programming languages do. The kind of operators you can use, and what they do, does, however, depend on the data type.")
        Paragraph("The "):Strong("operators"):Text(" described here all work in the same way. One value is placed on the left, another on the right, and an operator is placed in the middle. For example, "):DoubleQuote():Text("1 + 2"):DoubleQuote():Text(" is a mathematical expression with the "):DoubleQuote():Text("plus"):DoubleQuote():Text(" operator placed between the integers 1 and 2. The expression calculates how you might expect with an answer of 3.")
        Subsubsection("Numerical Operators")
        Paragraph("For integers and numbers, you can use the four basic operations of math: addition (+), subtraction (-), multiplication (*), division (/). Integers also have modulus (mod), which calculates the remainder after integer division.")
        Paragraph("In your program, change the values of your integer and number variables or make a math expression in each using operators to calculate a new value. The image below shows one possible way of doing this.")
        Image("media/Blocks/Variables and Operators/NumberOps.png", "A screenshot of code in Quorum Studio. Two blocks are shown, which read:
integer wholeNumber = 7 + 5
number decimalNumber = 10 / 4")
        Paragraph("Again copy pasting from these blocks reveals is it identical to text, giving the following:")
        CodeExample("integer wholeNumber = 7 + 5
number decimalNumber = 10 / 4")
        Subsubsection("Boolean Operators")
        Paragraph("You can also use comparison operators on integers and numbers. These are equals (=), less than (<), greater than (>), less than or equal to (<=), greater than or equal to (>=), and not equal (not=). These operations produce boolean values. For example, "):DoubleQuote():Text("5 < 6"):DoubleQuote():Text(" produces the boolean value "):DoubleQuote():Text("true"):DoubleQuote():Text(".")
        Paragraph():Strong("Boolean"):Text(" values also use equal (=) and not equal (not=). They also use the logical operators "):DoubleQuote():Text("and"):DoubleQuote():Text(" and "):DoubleQuote():Text("or"):DoubleQuote():Text(" to combine values. The "):DoubleQuote():Text("and"):DoubleQuote():Text(" operator produces the boolean value true only if both the left and right value are also true, or produces false if either of them are false. "):DoubleQuote():Text("or"):DoubleQuote():Text(" produces the boolean value true if at least one of the two values are true, and only produces false if both values are false.")
        Paragraph("Booleans also have a special operator, called "):DoubleQuote():Text("not"):DoubleQuote():Text(". Unlike the other operators discussed here, "):DoubleQuote():Text("not"):DoubleQuote():Text(" only takes one value, not two. "):DoubleQuote():Text("not"):DoubleQuote():Text(" flips the value of true or false. For example, "):DoubleQuote():Text("not true"):DoubleQuote():Text(" produces false, and "):DoubleQuote():Text("not false"):DoubleQuote():Text(" produces true.")
        Image("media/Blocks/Variables and Operators/BoolValue.png", "A snippet of a Quorum Studio program, showing the third block in the program. It reads: boolean myBooleanValue = true or false")
        Paragraph("Again, while the above looks like a block, it is identical to the following text:")
        CodeExample("boolean myBooleanValue = true or false")
        Subsubsection("Text Operators")
        Paragraph():Strong("Text"):Text(" values only use one operator, which is the plus symbol (+). When used for text, the plus symbol performs concatenation, or in other words, it adds one piece of text to the end of another. For example, "):DoubleQuote():Text("hello "):DoubleQuote():Text(" + "):DoubleQuote():Text("world"):DoubleQuote():Text(" would produce "):DoubleQuote():Text("hello world"):DoubleQuote():Text(". This idea of concatenation is a higher level topic when it comes to text variable management, but the main idea to note is that you use it to combine text. Here is an example:")
        Image("media/Blocks/Variables and Operators/Greeting.png", "A snippet of a Quorum Studio program showing a text variable block. It reads: text greetings = ")
        Paragraph("The text equivalent is identical:")
        CodeExample("text greeting = ''Hi '' + ''there!''")
        Paragraph("Here is one more example with:")
        Image("media/Blocks/Variables and Operators/AllVariables.png", "A screenshot of a Quorum Studio program with 8 blocks. They read, in order:
integer wholeNumber = 7 + 5
number decimalNumber = 10 / 4
boolean myBooleanValue = true or false
text greetings =  ''Hi  '' +  ''there! ''
say wholeNumber
say decimalNumber
say myBooleanValue
say greetings")
        Paragraph("The text is again equivalent:")
        CodeExample("integer wholeNumber = 7 + 5
number decimalNumber = 10 / 4
boolean myBooleanValue = true or false
text greetings =  " + dq + "Hi  " + dq + " +  " + dq + "there!" + dq + "
say wholeNumber
say decimalNumber
say myBooleanValue
say greetings")
        Subsubsection("Inputs and Typecasting")
        Paragraph("In some circumstances, perhaps you want to retrieve user input for a variable to do something with it. The input() command allows you to take user input and save it into a text variable. This block is available for you to use within the "):DoubleQuote():Text("Basics"):DoubleQuote():Text(" category.")
        Image("media/Blocks/Variables and Operators/Input.png", "A quorum block template that reads:
        text string = input()")
        Paragraph("Inside of the parentheses of input, you are able to put a command or question in which the answer you type out will be saved into the text string variable. For example:")
        Image("media/Blocks/Variables and Operators/MilkFlavor.png", "A quorum block template that reads:
        text milkFlvaor = input(''What is your favorite flavor of milk?'')")
        Paragraph("When you run this piece of code and input your answer into the console, whatever answer you send into Quorum saves the value into the milkFlavor variable. Regardless if your answer is a numerical value or text value, by default, it saves as a text value. Therefore, another operator to know is learning how to convert text variables to integers or numbers using cast().")
        Paragraph("Typecasting is a useful method to convert these numbers into their correct types. In this block of code, the program is asking how many hours of sleep you get via the input method.")
        Image("media/Blocks/Variables and Operators/Sleep.png", "A Quorum code snippet that reads:
         text sleep = input(''How many hours of sleep do you get?'')
integer hours = cast(integer, sleep)

integer need8hours = 8 - hours
output ''You get '' + hours + '' of sleep. You need '' + need8hours + '' hours to get the full 8 hours of sleep!''
")
        Paragraph("The lines of this program read in plain text:")
        CodeExample("text sleep = input(" + dq + "How many hours of sleep do you get?" + dq + ")
integer hours = cast(integer, sleep)

integer need8hours = 8 - hours
output " + dq + "You get " + dq + " + hours + " + dq + " of sleep. You need " + dq + " + need8hours + " + dq + " hours to get the full 8 hours of sleep!" + dq)
        Paragraph("Notice how the input saves as a text variable, although you are asking for an integer. You can use the action, cast(type, variableToCast) to convert the text value into an integer as it is shown in line 2. The program saves the value as an integer and can be used in calculations to get the answer in the output. Feel free to copy this code snippet onto Quorum Studio to see how it works.")
    end

    private action Engage
        Section("Engage")
        Paragraph("After learning how to create variables and use these variables when working with operators, you will practice these skills on your own. You will be creating variables for each Quorum data type and outputting them into the console:")
        BulletList()
        ListItem("Integer")
        ListItem("Number")
        ListItem("Text")
        ListItem("Boolean")
        Paragraph("Additionally, with all the datatypes you will also be practicing how to use the operators specific to each type. This section is a bit rote, but practice like this, even if brief, can help get a shared understanding of an extremely important concept in computer science.")
        Subsection("Directions")
        Paragraph("One day out of the blue you and a partner leave your corporate life and want to move to country life. The hustle culture you have faced prior just became too much and now you suddenly want to live a slower and simple life. Using the money you had in the bank, you buy a small farm and want to grow vegetables and fruits. It is the start of spring and you have to plan out your whole season to grow vegetables effectively. You are going to write a small program to document your farm.")
        Image("media/Blocks/Variables and Operators/Farm.png", "Picture of a Farm")
        Paragraph():Link("Barn by Frances Gunn", "https://unsplash.com/photos/barn-surrounded-by-trees-QcBAZ7VREHQ")
        Paragraph("To get started on this program, "):Link("you will need to download the following template to get started", "/files/blocks/ANewFarm.zip"):Text(". Please note that if you run this program, it will lead to an error because variables that you need have not been created yet.")
        Subsubsection("Task 1: Name Your Farm")
        Paragraph("You will first want to name your farm, so create a text variable, saving the value with the name. You can also practice using the text variable operation to add two words together. For example:")
        CodeExample("text name =  " + dq + "Mickey " + dq + " + " + dq + "Mouse " + dq + " + " + dq + "Farm" + dq)
        Paragraph("Output your farm name with a little greeting to practice your text operations.")
        Subsubsection("Task 2: Grow Your Crops")
        Paragraph("On your farm you have the choice to grow these or other types of fruits and vegetables:")
        BulletList()
        ListItem("Apricots")
        ListItem("Apples")
        ListItem("Garlic")
        ListItem("Pineapples")
        ListItem("Strawberries")
        ListItem("Broccoli")
        ListItem("Lettuce")
        ListItem("Onions")
        ListItem("Mushrooms")
        ListItem("Turnips")
        Paragraph("You have 10 plots available on your land to grow your produce. You will then create integer variables and decide how much of each product you want to grow. After deciding what to grow, add up all the fruit and veggie variables in order to verify you have all 10 plots filled and save this in a new variable named total.")
        Paragraph("Then, use the output or say statement to display all your crops. You may follow the following format when outputting the crop amounts.")
        Image("media/Blocks/Variables and Operators/Lettuce.png", "A snippet of Quorum code that reads: 
         say 'Lettuce Amount: ' + lettuce")
        Subsubsection("Task 3: Check Your Plots")
        Paragraph("Lastly, create 1 boolean variable: "):Strong("isPlotFilled"):Text(" and set it to false. Using the 1st if statement block provided and check if total = 10. If "):Strong("total = 10 set isPlotFilled equal to true"):Text(" and then output a statement saying the plot has been filled. Otherwise, if the plot has not been filled, modify the output inside of the else block to say that plot has not been filled.")
        Paragraph("When isPlotFilled is set to true, it will run the additional output statement in the template provided.")
        Subsubsection("Sample Output")
        Paragraph("The following shows two sample outputs from the program.")
        Paragraph():Strong("Sample output when all plots are filled:")
        CodeExample("Welcome to Mango Girl Farm. In this farm you will find the following fruits and vegetables: 
Apricots: 2
Broccoli: 5
Mushrooms: 3
You filed up all your plots!
Your hard work has been paid off! By fall you should have many crops to harvest!")
        Paragraph():Strong("Sample output when not all the plots are filled:")
        CodeExample("Welcome to Mango Girl Farm. In this farm you will find the following fruits and vegetables: 
Apricots: 2
Broccoli: 5
Mushrooms: 2
You need to grow more crops!")
        Subsection("Wrap up")
        Paragraph("Once you are finished with your program, discuss what you think might be common misunderstandings with students and variables. Are some harder than others? Are some operations easier to understand, or more important, than others?")
    end
end
