use Libraries.Web.Page.QuorumPage
use Libraries.Web.Page.TableRowWriter

/*
    Hour 8: Loops.
    Converted from the old Lesson page by plan 13's generator: the same
    words, now without Tailwind.
*/
class BlocksLoops is QuorumPage
    // A double quote, for code and words that hold one.
    text dq = ""
    // The table row being written, when its cells hold more than words.
    TableRowWriter row = undefined

    on create
        SetLocation("tutorials/blocks/BlocksLoops.html")
        // The name lists and links use, and the series and track it belongs
        // to: its section and picture.
        SetShortTitle("Loops")
        SetSectionName("Quorum Blocks")
        SetCardImage("/media/gettingStarted.png")
        // For search engines and link previews, and what lists of pages say.
        SetDescription("Learn how to use loops and multiple line blocks in Quorum")
        SetSummary("how to use loop blocks in Quorum")
    end

    action Setup
        dq = dq:GetDoubleQuote()
        SetWebPageTitle("Learn Loops - Quorum Programming Language")
        Title("Hour 8: Loops")
        Paragraph("This lesson will teach you how to use loops with blocks in Quorum.")
        Overview()
        WarmUp()
        Explore()
        Engage()
    end

    private action Overview
        Section("Overview")
        Paragraph("Perhaps one of the most common aspects of programming is automation. Computers often excel not just at fast number crunching, but also repetition and decision making. In this lesson, you will explore how to tell computers to repeat themselves. There are many reasons for using repetition. It is a hallmark and fundamental skill in computer science.")
        Subsection("Goals")
        Paragraph("You have the following goals for this lesson:")
        BulletList()
        ListItem("Learn how to use "):DoubleQuote():Text("repeat ... times"):DoubleQuote():Text(" statements.")
        ListItem("Learn about "):DoubleQuote():Text("repeat while"):DoubleQuote():Text(" and "):DoubleQuote():Text("repeat until"):DoubleQuote():Text(" statements.")
        ListItem("Discuss how "):DoubleQuote():Text("scope"):DoubleQuote():Text(" impacts variables defined inside loops.")
    end

    private action WarmUp
        Section("Warm up")
        Paragraph("One of the big benefits of computers is that they can do repetitive tasks that would be tedious or difficult for humans to do. What are some examples of repetitive tasks that technology can handle? What do you think the code for those kinds of tasks might look like?")
        Subsection("Vocabulary")
        Paragraph("You will be learning about the following vocabulary words:")
        Table("Vocabulary")
        TableHeader():Cell("Term"):Cell("Definition")
        TableRow():Cell("Loop"):Cell("A structure that contains code to be run repeatedly. It runs a certain number of times, or so long as a condition is met.")
        TableRow():Cell("Multiple Line Block"):Cell("A block that takes up more than one line in the editor, and has multiple parts that can be moved and adjusted.")
        TableRow():Cell("Scope"):Cell("The area where a variable exists and can be used.")
        Subsection("Code")
        Paragraph("You will be using the following new pieces of code:")
        Table("New Code to Learn")
        TableHeader():Cell("Quorum Code"):Cell("Code Example"):Cell("Explanation")
        row = TableRow()
        row:Cell():Text("repeat "):Code("INTEGER"):Text(" times")
        row:Cell():Text("repeat 10 times"):NewLine():Text(" output "):DoubleQuote():Text("hello!"):DoubleQuote():NewLine():Text("end")
        row:Cell():Text("Runs the code inside the repeat block "):Code("INTEGER"):Text(" times.")
        row = TableRow()
        row:Cell():Text("repeat while "):Code("BOOLEAN")
        row:Cell():Text("repeat while i < 10"):NewLine():Text(" output "):DoubleQuote():Text("hello!"):DoubleQuote():NewLine():Text(" i = i + 1"):NewLine():Text("end")
        row:Cell():Text("Repeatedly runs the code inside the repeat block as long as the "):Code("BOOLEAN"):Text(" value is true.")
        row = TableRow()
        row:Cell():Text("repeat until "):Code("BOOLEAN")
        row:Cell():Text("repeat until i < 10"):NewLine():Text(" output "):DoubleQuote():Text("hello!"):DoubleQuote():NewLine():Text(" i = i + 1"):NewLine():Text("end")
        row:Cell():Text("Repeatedly runs the code inside the repeat block as long as the "):Code("BOOLEAN"):Text(" value is true.")
        row = TableRow()
        row:Cell():Text("end")
        row:Cell():Text("repeat 8 times"):NewLine():Text(" output "):DoubleQuote():Text("hello!"):DoubleQuote():NewLine():Text("end")
        row:Cell():Text("Marks the end of a multiple line block, like repeat blocks. Repeat blocks run code between the start of the block and the end.")
        Subsection("CSTA Standards")
        Paragraph("This lesson covers the following "):Link("standards", "https://csteachers.org/k12standards/interactive/"):Text(":")
        BulletList()
        ListItem():Strong("3A-DA-12"):Text(": Create computational models that represent the relationships among different elements of data collected from a phenomenon or process.")
    end

    private action Explore
        Section("Explore")
        Paragraph("When making programs, you often want to run code multiple times. Sometimes it is more convenient to run the same code over and over again instead of writing out duplicate code by hand. In other cases, you do not know ahead of time how many times the code will need to run.")
        Paragraph("In computer science, you can run code multiple times by using "):DoubleQuote():Text("repeat"):DoubleQuote():Text(" blocks. While the exact terms vary across the discipline, sometimes these structures are known as "):Strong("loops.")
        Image("media/Blocks/Loops/LoopFlowchart.png", "A flowchart showing how loops work. It begins at the Start Loop step, goes to Initialize Expression, and then to Test Condition. Here, it has two branches: the first is IF TEST = TRUE. This branch goes to Execute Action, then ncrement, then returns to Test Condition. The second branch is IF TEST = FALSE, which goes to Stop Loop.")
        Subsection("The " + dq + "Control" + dq + " Category")
        Paragraph("In Quorum Studio, the block palette has a category labeled "):DoubleQuote():Text("Control."):DoubleQuote():Text(" In this category, there are three different kinds of loops: the "):DoubleQuote():Text("repeat times"):DoubleQuote():Text(" block, the "):DoubleQuote():Text("repeat while"):DoubleQuote():Text(" block, and the "):DoubleQuote():Text("repeat until"):DoubleQuote():Text(" block.")
        Image("media/Blocks/Loops/RepeatTypes.png", "A snippet from Quorum Studio, showcasing the three kinds of repeat blocks in the block palette. In order, they show:
repeat 1 times
end

repeat until true
end

repeat while false
end")
        Paragraph("The navigation pane on the left side of Quorum Studio has several tabs, including both the project view and the block palette. To reach the control category using only the keyboard in Quorum Studio, you will need to first to focus the palette, then use the hotkeys to change categories. The table below shows the hotkeys for moving through both the navigation tabs and the block palette with the keyboard on Windows and Mac.")
        Table("Hotkeys for Tab and Category Navigation")
        TableHeader():Cell("Action"):Cell("Keys"):Cell("Description")
        TableRow():Cell("Focus Navigation Pane"):Cell("CTRL + 1 (Window) or CMD + 1 (Mac)"):Cell("Focus the navigation pane. This pane has tabs for the project tree as well as the block palette.")
        TableRow():Cell("Go to Next Tab/Category"):Cell("CTRL + Tab (Windows) or CTRL + ] (Mac)"):Cell("If you are in the block palette, go to the next block category. If not, go to the next tab in the navigation pane.")
        TableRow():Cell("Go to Previous Tab/Category"):Cell("SHIFT + CONTROL + Tab (Windows) or CTRL + [ (Mac)"):Cell("If you are in the block palette, go to the previous block category. If not, go to the previous tab in the navigation pane.")
        TableRow():Cell("(From Block Palette) Focus Navigation Pane Tabs"):Cell("ESCAPE x2"):Cell("While in the block palette, pressing escape once will focus the categories, so they can be tabbed through. Pressing escape twice will focus the navigation tabs so they can be tabbed through instead.")
        Paragraph("Repeat blocks are a little different from the other kinds of blocks you have used so far. Previously, each block you have used has been a single line of code. These blocks have two parts on two different lines.")
        Paragraph("These are "):Strong("multiple line blocks"):Text(". Besides taking up more than one line, the important part of these blocks is that other blocks can go inside of them, between the first and the last line. The picture below shows an example of a "):DoubleQuote():Text("repeat times"):DoubleQuote():Text(" block with something inside of it. In computer science, this is often called a "):Strong("scope"):Text(".")
        Image("media/Blocks/Loops/RepeatTimesExample.png", "A snippet of a Quorum Studio program. It spans three lines. The first and third line are visually connected, and the second line is inside the other two. The lines read:
repeat 2 times
output ''Hello world!''
end")
        Paragraph("The "):DoubleQuote():Text("repeat times"):DoubleQuote():Text(" block is the simplest repeat block. It will run any code inside of it as many times as requested. In the program above, for example, the block will run its code two times. In contrast, the "):DoubleQuote():Text("repeat while"):DoubleQuote():Text(" block does not run a fixed number of times. Instead, it checks a boolean condition. If the condition is true, it runs the code. The example below shows some code using a "):DoubleQuote():Text("repeat while"):DoubleQuote():Text(" block.")
        Image("media/Blocks/Loops/RepeatWhileExample.png", "A Quorum Studio program with 5 lines. The second and fourth line are a single repeat while block. The text of the program is:
integer value = 1
repeat while value < 3
value = value + 1
end
output value")
        Paragraph("In this example, you start with a variable called "):DoubleQuote():Text("value"):DoubleQuote():Text(" that starts at 1. When the code reaches the "):DoubleQuote():Text("repeat while"):DoubleQuote():Text(" block, it checks the condition. Because 1 is less than 3, the code executes, and increases the value by 1. Then it checks the condition again.")
        Paragraph("Since 2 is still less than 3, it runs again, and the value increases by 1 up to 3. When it checks the condition this time, 3 is not less than 3, so it stops. It then outputs the value, which is 3.")
        Paragraph("The "):DoubleQuote():Text("repeat until"):DoubleQuote():Text(" block is the opposite of the "):DoubleQuote():Text("repeat while"):DoubleQuote():Text(" block. The "):DoubleQuote():Text("repeat while"):DoubleQuote():Text(" block will run if the condition is true, but the "):DoubleQuote():Text("repeat until"):DoubleQuote():Text(" block runs if the condition is false. Otherwise, they work the same way. It is always possible to phrase the condition in a way that either block will work. Which one to use is personal preference.")
        Subsection("Scope in a Loop")
        Paragraph("When working with multiple line blocks, you can move blocks in or out of the multiple line block by dragging them with the mouse, or by using cut and paste with the keyboard. Try moving the output block just above the "):DoubleQuote():Text("end"):DoubleQuote():Text(" using either the mouse or cut and paste. The picture below shows an example.")
        Paragraph("When working with multiple line blocks, you can move blocks in or out of the multiple line block by dragging them with the mouse. Alternatively, you can select a block and use cut (CTRL + X on Windows or CMD + X on Mac) and paste (CTRL + V on Windows or CMD + V on Mac) with the keyboard. When pasting a block, the cut block will appear directly after the currently selected block.")
        Paragraph("Try moving the output block just above the "):DoubleQuote():Text("end"):DoubleQuote():Text(" using either the mouse or cut and paste. The picture below shows an example.")
        Image("media/Blocks/Loops/ScopeP1.png", "A 5-line Quorum program. It reads:
integer value = 1
repeat 6 times
value = value * 2
output value
end")
        Paragraph("Similarly, you can move blocks into the beginning of the repeat block. In fact, so long as the top part of the repeat block remains above the "):DoubleQuote():Text("end"):DoubleQuote():Text(" portion, you can arrange code inside and outside of it however you would like -- though the positioning of code will make a difference. Try moving or cutting and pasting the variable so that it is now created inside the loop, like in the example below.")
        Image("media/Blocks/Loops/ScopeP2.png", "A 5-line Quorum program. It reads:
repeat 6 times
integer value = 1
value = value * 2
output value
end")
        Paragraph("In the example above, the program should now output "):DoubleQuote():Text("2"):DoubleQuote():Text(" six times. Now, move the output back down again, out of the repeat block. It now flashes red, and your program has an error.")
        Image("media/Blocks/Loops/ScopeP3.png", "A 5-line Quorum program. The last line, the output block, flashes red because it is an error. The program reads:
repeat 6 times
integer value = 1
value = value * 2
end
output value")
        Paragraph("When a variable is created inside a multiple line block like a "):DoubleQuote():Text("repeat"):DoubleQuote():Text(" block, it only exists inside that block. The output statement is now an error because, outside of the repeat statement, there is no variable with that name available.")
        Paragraph("The area that a variable exists in is called its "):Strong("scope."):Text(" In other words, the scope is the part of the program where a variable is allowed to be used. One of the most common types of scope you may run into is "):Strong("local scope."):Text(" This occurs when variables are contained within control structures (like "):DoubleQuote():Text("repeat"):DoubleQuote():Text(" blocks) and can only be accessed within that code block. If you call that variable anywhere else outside the structure, it will result in an error. This is what you saw earlier with the "):DoubleQuote():Text("output value"):DoubleQuote():Text(" statement. Because of this, you must pay careful attention to where your variables are being made and used while working with multiple line blocks.")
    end

    private action Engage
        Section("Engage")
        Paragraph("Now that you have spent some time learning about loops, it is time to try them yourself. Loops are an important concept in programming. This is also your first time working with multiple line blocks. You will start by interpreting the output of some example loops, and then you will make a program from scratch that uses the different types of loops to solve problems.")
        Subsection("Directions")
        Paragraph("One morning you suddenly wake up and you immediately hear the sound of clanking metal. Weird... you look in your bathroom to discover a small robot. They seem to have gotten stuck reading the "):DoubleQuote():Text("Rinse, Lather, Repeat"):DoubleQuote():Text(" instructions on the back of your shampoo bottle over and over.")
        Image("media/Blocks/Loops/Robot.png", "An image of a small toy robot.")
        Paragraph():Link("A little Robot by Rock'n Roll Monkey", "https://unsplash.com/photos/blue-plastic-robot-toy-R4WCbazrD1g")
        Paragraph("While neither you or the robot know where they came from, they seem harmless, aside from some acute memory issues. You figure that some mental exercises should jog their memory -- or at least keep them from getting stuck reading your shampoo bottle.")
        Subsubsection("Part 1: Identifying Loop Output")
        Paragraph("In this section, you will step your new robot friend through some examples of loops. Look at each one carefully and determine what the output of the program is. Please write the entire output as if you are running the program. If you need to recreate the loop to see the output, feel free to do so.")
        Paragraph():Emphasis("1. What is the output of this program using a " + dq + "repeat times" + dq + " block?")
        Image("media/Blocks/Loops/PizzaTime.png", "A 3-line Quorum Studio program. It reads:
repeat 3 times
output ''Pizza Time''
end")
        Paragraph():Emphasis("2. What is the output of this program using a " + dq + "repeat while" + dq + " block?")
        Image("media/Blocks/Loops/EngageQ2.png", "A 5-line Quorum Studio program. It reads:
integer counter = 10
repeat while counter > 3
counter = counter - 2
output counter
end")
        Paragraph():Emphasis("3. What happens in this program where the condition is never met?")
        Image("media/Blocks/Loops/NoFreeTime.png", "A 5-line Quorum Studio program. It reads:
integer freeTime = 0
repeat while freeTime >= 30
output ''Time for a break!''
freeTime = freeTime - 30
end")
        Paragraph():Emphasis("4. What happens in this program where the condition is always true?")
        Image("media/Blocks/Loops/TimeLoop.png", "A 3-line Quorum Studio program. It reads:
repeat while true
output ''Help I'm trapped in a time loop''
end")
        Subsubsection("Part 2: Creating Loops")
        Paragraph("In this next part, you will practice creating loops on your own to solve some repetitive tasks.")
        Paragraph("Your robot friend has 4 oddly specific requests they would like help solving using loops:")
        BulletList()
        ListItem("Output every number between 1 and 8.")
        ListItem("Output every odd number between 1 and 16.")
        ListItem("Calculate 2 to the 11th power.")
        ListItem("Compute 9! (9 * 8 * 7 * ... * 2 * 1)")
        Paragraph("Use each of the three types of loops at least once while solving the requests.")
        Subsection("Wrap up")
        Paragraph("Take a few minutes to consider the three kinds of loops. While it might seem on the surface important to teach or understand all three, in practice there is significant overlap between them. In fact, you can write any program using only "):DoubleQuote():Text("repeat while"):DoubleQuote():Text(" or "):DoubleQuote():Text("repeat until"):DoubleQuote():Text(" loops. Given that, what are the pros and cons of teaching students all three right when they are first learning the concept?")
    end
end
