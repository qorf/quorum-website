use Libraries.Web.Page.QuorumPage

/*
    Hour 14: Create an Accessible App - Part 2: Behaviors.
    Converted from the old Lesson page by plan 13's generator: the same
    words, now without Tailwind.
*/
class AccessibleAppP2 is QuorumPage
    // A double quote, for code and words that hold one.
    text dq = ""

    on create
        SetLocation("tutorials/blocks/AccessibleAppP2.html")
        // The name lists and links use, and the series and track it belongs
        // to: its section and picture.
        SetShortTitle("Create Accessible Apps Part 2")
        SetSectionName("Quorum Blocks")
        SetCardImage("/media/gettingStarted.png")
        // For search engines and link previews, and what lists of pages say.
        SetDescription("Learn how to add Behaviors in your Form app in Quorum")
        SetSummary("how to add behaviors in a Form app in Quorum")
    end

    action Setup
        dq = dq:GetDoubleQuote()
        SetWebPageTitle("Creating an Accessible App - Quorum Programming Language")
        Title("Hour 14: Create an Accessible App - Part 2: Behaviors")
        Paragraph("This lesson is to teach you about adding functionality using Behaviors in a Form app.")
        Overview()
        WarmUp()
        Explore()
        Engage()
    end

    private action Overview
        Section("Overview")
        Paragraph("In a previous lesson, you created the interface for an app. While designing the user interface of an app is important, apps that do nothing are not particularly useful. In this lesson, you will learn how to make an app respond when the user interacts with it.")
        Subsection("Goals")
        Paragraph("You have the following goals for this lesson:")
        BulletList()
        ListItem("Learn how to create a Behavior")
        ListItem("Add a Behavior to a Button in your app")
        ListItem("Think about programming in teams")
    end

    private action WarmUp
        Section("Warm up")
        Paragraph("Imagine you recently acquired funds to create a tech startup. Your focus could be on anything. It could be education focused, or maybe it is based on a hobby or interest of yours. Maybe your focus is on an issue you wish there was a better solution for.")
        Paragraph("You need to form a team to start working on a product. What would your product cater towards, and who might use it? As for your team, what kinds of people would you want to work with? How do you think this team would work together while creating this product?")
        Subsection("Vocabulary")
        Paragraph("You will be learning about the following vocabulary words:")
        Table("Vocabulary")
        TableHeader():Cell("Term"):Cell("Definition")
        TableRow():Cell("Pair Programming"):Cell("A technique in software engineering where two programmers work together.")
        TableRow():Cell("Event Driven Programming"):Cell("A style of programming where code runs in response to user input.")
        TableRow():Cell("Inheritance"):Cell("A system where a " + dq + "child" + dq + " class gains the properties of a " + dq + "parent" + dq + " class.")
        TableRow():Cell("Behaviors"):Cell("Inside a Form app, behaviors represent code that will run in response to an event occurring.")
        Subsection("Code")
        Paragraph("You will be using the following new pieces of code:")
        Table("New Code to Learn")
        TableHeader():Cell("Quorum Code"):Cell("Code Example"):Cell("Explanation")
        TableRow():Cell("use NAME"):Cell("use Libraries.Interface.Controls.Button"):Cell("A use statement for the Button object. A button is a selectable user interface component.")
        TableRow():Cell("Button buttonObject"):Cell("Button button"):Cell("Creates a button object on the form")
        TableRow():Cell("use NAME"):Cell("use Libraries.Interface.Events.BehaviorEvent"):Cell("A use statement for the BehaviorEvent object. A BehaviorEvent is sent to you when a button is clicked.")
        TableRow():Cell("use NAME"):Cell("use Libraries.Interface.Forms.FormBehavior"):Cell("A use statement for the FormBehavior object. FormBehavior is a special class for handling events.")
        TableRow():Cell("action Run(BehaviorEvent event) end"):Cell("action Run(BehaviorEvent event) // behavior code runs in this action end"):Cell("This action is the heart of a Behavior. It will run if a Button is clicked with this Behavior attached to it.")
        TableRow():Cell("GetForm()"):Cell("Form form = GetForm()"):Cell("Returns a Form object representing the form in the app.")
        TableRow():Cell("GetPage()"):Cell("Page page = GetPage()"):Cell("Returns a Page object representing the current page of the app.")
        TableRow():Cell("behaviorEvent:GetItem()"):Cell("event:GetItem()"):Cell("Identifies the element (perhaps a button) that triggered a Behavior.")
        TableRow():Cell("buttonObject:SetBehavior()"):Cell("button:SetBehavior(behave)"):Cell("Attaches a behavior to a button. When the button is clicked, the behavior runs.")
        TableRow():Cell("buttonObject:GetName()"):Cell("text typeOfButton = button:GetName()"):Cell("Retrieves the specific button name from the button click in order to perform a specific action.")
        Subsection("CSTA Standards")
        Paragraph("This lesson covers the following "):Link("standards", "https://csteachers.org/k12standards/interactive/"):Text(":")
        BulletList()
        ListItem():Strong("2-CS-01"):Text(": Recommend improvements to the design of computing devices, based on an analysis of how users nteract with the devices.")
        ListItem():Strong("1B-CS-02"):Text(": Model how computer hardware and software work together as a system to accomplish tasks.")
        ListItem():Strong("3A-AP-15"):Text(": Justify the selection of specific control structures when tradeoffs involve implementation, readability, and program performance, and explain the benefits and drawbacks of choices made.")
    end

    private action Explore
        Section("Explore")
        Paragraph("Over the past several lessons, you have learned a variety of different concepts and techniques, including how to store and modify data, how to use conditional statements to change what code is run, and how to write actions and classes. In a previous lesson, you learned how to design the user interface of an app. Now it is time to bring all of your knowledge together to make an app respond to your input.")
        Subsection("Using Behaviors in the Form Library")
        Paragraph("Recall in your previous Form app where you learned how to create an app. You developed the user interface, adding text, a banner, and buttons. The app itself was not functional yet, though. If you pressed the button on the app, nothing happened.")
        Paragraph("Now that you have learned about actions and classes, you are ready to add Behaviors to your app. "):Strong("Behaviors"):Text(" are special classes in Quorum that handle the actions your app takes when a user interacts with it. Behaviors are an example of "):Strong("event-driven programming"):Text(", meaning code will run when users trigger an event.")
        Paragraph("Behaviors work using a concept called "):Strong("inheritance"):Text(". In computer science, the term "):DoubleQuote():Text("inheritance"):DoubleQuote():Text(" means that a class gains the properties of a different class. The custom behaviors you will write for your apps will inherit from the "):Link("FormBehavior class", "https://quorumlanguage.com/Libraries/Interface/Forms/FormBehavior.html"):Text(", which handles complicated event handling. You do not need to know exactly how this class works, or the fine details of inheritance. For now, you only need to know that inheritance will let you use the event handling functionality of Behaviors without having to write it all yourself.")
        Paragraph("You will need Behaviors to make your app respond to user input. Like any class, your custom Behavior class will need to go in a separate file from your Main form app. Consider the following example:")
        Image("media/Blocks/AccessibleAppP2/FormBehavior.png", "This shows the following code:

use Libraries.Interface.Events.BehaviorEvent
use Libraries.Interface.Forms.FormBehavior
class MyBehaviorNew is FormBehavior
   action Run(BehaviorEvent event)
      say ''When you click me I perform an action!''
   end
end")
        BulletList()
        ListItem():Strong("Line 1"):Text(": This line contains a use statement that gives you access to the BehaviorEvent library. BehaviorEvent objects include information about the event that caused the Behavior to run.")
        ListItem():Strong("Line 2"):Text(": This line contains a use statement that gives you access to the FormBehavior library. Inheriting from the FormBehavior library will let your class respond to events.")
        ListItem():Strong("Line 3"):Text(": This line creates a custom class that "):Strong("inherits"):Text(" from FormBehavior, using the "):DoubleQuote():Text("is"):DoubleQuote():Text(" keyword. Your new behavior will gain the properties of the "):DoubleQuote():Text("parent"):DoubleQuote():Text(" class it is inheriting from.")
        ListItem():Strong("Line 4"):Text(": This line creates a new action. Importantly, the name "):Strong("must"):Text(" be “"):Strong("Run"):Text("”, and it "):Strong("must"):Text(" take exactly one BehaviorEvent parameter. The class you are inheriting from expects an action with exactly this name and parameters to use when events occur.")
        ListItem():Strong("Line 5"):Text(": When the action is run, it will say the text "):DoubleQuote():Text("When you click me I perform an action."):DoubleQuote()
        ListItem():Strong("Line 6"):Text(": This line encloses the action block.")
        ListItem():Strong("Line 7"):Text(": This line encloses the class block.")
        Paragraph("All behaviors follow the same code format, so if you have one Behavior written, you can reuse it as a template when you want to add more functionality to your apps. The only parts you need to change are the class name and the code inside the "):DoubleQuote():Text("Run"):DoubleQuote():Text(" action.")
        Subsubsection("Creating an App with Behaviors")
        Paragraph("Examine the example below. It shows the Main file of a Form program, which includes two buttons named "):DoubleQuote():Text("Hi"):DoubleQuote():Text(" and "):DoubleQuote():Text("Bye."):DoubleQuote():Text(" You have already seen how to create an interface using Forms before, but there are a few important additions on lines 8 to 14.")
        Paragraph("First, when the buttons are created on lines 8 and 12, they are now assigned to variables. Since you need to store the Button objects, you also need a use statement for them on line 3, "):DoubleQuote():Text("use Libraries.Interface.Controls.Button."):DoubleQuote()
        Paragraph("Second, on lines 9, 10, 13, and 14, the program creates new "):DoubleQuote():Text("MyBehavior"):DoubleQuote():Text(" objects, and then associates those behaviors with the buttons. Now, when a button is clicked, the behavior will run.")
        Image("media/Blocks/AccessibleAppP2/Behavior.png", "A screenshot of a Quorum program. The code reads:

use Libraries.Interface.Forms.Form
use Libraries.Interface.Forms.Page
use Libraries.Interface.Controls.Button

Form form
Page page = form:GetMainPage()

Button button1  = page:AddButton(''Hi'')
MyBehavior hiBehavior
button1:SetBehavior(hiBehavior)

Button button2 = page:AddButton(''Bye'')
MyBehavior byeBehavior
button2:SetBehavior(byeBehavior)

form:Display()")
        Paragraph("Now, examine the code for the "):DoubleQuote():Text("MyBehavior"):DoubleQuote():Text(" class:")
        Image("media/Blocks/AccessibleAppP2/BehaviorTemplate.png", "A screenshot of a Quorum file. It reads:

use Libraries.Interface.Events.BehaviorEvent
use Libraries.Interface.Forms.FormBehavior
use Libraries.Interface.Forms.Form
use Libraries.Interface.Forms.Page
use Libraries.Interface.Item
class MyBehavior is FormBehavior
action Run(BehaviorEvent event)
Form form = GetForm()
Page page = GetPage()
// retrieve the specific action from our button click
Item button = event:GetItem()
text typeOfButton = button:GetName()
// ADD CODE HERE
end")
        Paragraph("The code in this example is a template, and is incomplete, marked by the "):DoubleQuote():Text("ADD CODE HERE"):DoubleQuote():Text(" comment at the end of the action. Still, there are several important things happening in the "):DoubleQuote():Text("Run"):DoubleQuote():Text(" action.")
        Paragraph("First, the "):DoubleQuote():Text("Run"):DoubleQuote():Text(" action uses the "):DoubleQuote():Text("GetForm"):DoubleQuote():Text(" and "):DoubleQuote():Text("GetPage"):DoubleQuote():Text(" actions. These return the objects that represent the Form and the currently displayed Page, respectively. These are helpful if you need to get or modify any values in the app or in the user interface.")
        Paragraph("Second, the action uses "):DoubleQuote():Text("GetItem"):DoubleQuote():Text(" from the BehaviorEvent parameter. The BehaviorEvent is a special object that contains lots of information about the input that triggered your behavior. In this case, "):DoubleQuote():Text("GetItem"):DoubleQuote():Text(" returns an object representing whatever interface element triggered the behavior. In practice, this will be a Button.")
        Paragraph("The action also gets the button's name and stores it in a variable. A button's name will be the text that you provided when you made it in the Form. In the current example, because there are only two buttons, the name will either be "):DoubleQuote():Text("Hi"):DoubleQuote():Text(" if the first button was clicked, or "):DoubleQuote():Text("Bye"):DoubleQuote():Text(" if the second button was clicked. You can use this information to decide how your behavior should react, depending on which button it is. The end of the template, with the comment that reads "):DoubleQuote():Text("ADD CODE HERE,"):DoubleQuote():Text(" is where you will add more code to determine what your behavior actually does.")
        Subsubsection("Code Templates")
        Paragraph("Here are another set of templates for a form and its behavior file. Notice that if you were to copy and paste these two files of code into Quorum Studio and try running the program, it would automatically turn into blocks from text if you are in that mode. If the name of the button was hi, it would then say hello.")
        Paragraph():Strong("Main.quorum")
        CodeExample("use Libraries.Interface.Forms.Form
use Libraries.Interface.Forms.Page
use Libraries.Interface.Controls.Button

Form form
MyBehavior behave
Page page = form:GetMainPage()

Button button  = page:AddButton(" + dq + "Hi" + dq + ")
button:SetBehavior(behave)")
        Paragraph():Strong("MyBehavior.quorum")
        CodeExample("use Libraries.Interface.Events.BehaviorEvent
use Libraries.Interface.Forms.FormBehavior
use Libraries.Interface.Forms.Form
use Libraries.Interface.Forms.Page
use Libraries.Interface.Item
class MyBehavior is FormBehavior
    action Run(BehaviorEvent event)
        Form form = GetForm()
        Page page = GetPage()
        // retrieve the specific action from our button click
        Item button = event:GetItem()
        text typeOfButton = button:GetName()
        // ADD CODE HERE
        if typeOfButton = " + dq + "Hi" + dq + "
            say " + dq + "Hello" + dq + "
        end
        
    end
end")
        Subsection("Collaborating with Code")
        Paragraph("As code becomes more complex, collaborating with others becomes increasingly important. When dealing with commercial software, there are often large teams of software engineers that work together on the same project. This often means splitting up work across multiple people, but team members are also often encouraged to collaborate and work together to solve difficult problems.")
        Paragraph("A practice that is common among software engineers is a collaboration method known as "):Strong("pair programming"):Text(". To Pair Program means that two programmers work together on a single computer. It is a similar practice in learning how to drive: one person writes the code (referred as the driver) and the other person reviews the teammate's code and offers feedback (referred as the navigator).")
    end

    private action Engage
        Section("Engage")
        Paragraph("Previously, you designed the interface of an app, but it was not yet interactive. Now, you will work together with a partner to make a thermostat app respond to your input.")
        Subsection("Directions")
        Paragraph("You are an app developer and you want to build a product that allows you to control your home thermostat from your phone. A friend has sent you their work in progress. Their draft has the app's look and feel handled, but when you try to interact with the buttons, they do not do anything yet. Your friend has some ideas of where there is code missing, though, and they have marked the spots. Your job is to examine the existing code with a partner and add code so the buttons work.")
        Paragraph("Start by selecting a partner to work with, if one is available. Decide who will start as the “driver” (who is writing code) and the "):DoubleQuote():Text("navigator"):DoubleQuote():Text(" (who is providing feedback and guidance). Make sure to periodically swap roles as you are working on your project.")
        Image("media/Blocks/AccessibleAppP2/Thermostat.png", "Image of a thermostat at 63 degrees")
        Paragraph():Link("Thermostat by Dan LeFebvre", "https://unsplash.com/photos/gray-nest-thermostat-displaying-at-63-RFAHj4tI37Y")
        Paragraph():Link("Download the folder with the code before starting", "/files/blocks/ThermostatApp.zip"):Text(". Inside of Quorum Studio, open the project inside the File menu once you are ready to work. Before trying to modify the code, run the program first to examine what it does at a high level..")
        Subsubsection("Examine the Code Template")
        Paragraph("Luckily, your friend has already worked on this app and given you most of the structure you will need. You should have two files in this project: "):Strong("Main.quorum"):Text(" and "):Strong("TemperatureBehavior.quorum"):Text(". Take a few minutes to familiarize yourself with the code by running it and seeing how it works. Notice the areas that are marked with "):DoubleQuote():Text("YOUR CODE GOES HERE."):DoubleQuote():Text(" While there are many new parts to this code, you only need to modify small parts of this project. You do not need to change anything outside of the marked areas.")
        Paragraph():Strong("Main.quorum")
        CodeExample("use Libraries.Interface.Forms.Form
use Libraries.Interface.Forms.Page
use Libraries.Interface.Forms.Grouping
use Libraries.Interface.Forms.Banner
use Libraries.Interface.Controls.Button
use Libraries.Game.Graphics.Label

// Create the Form app and get the main page.
Form form
Page homePage = form:GetMainPage() // Just an example using page instead of form for things. Anything you can do to a form you can do to a page, basically.
Banner banner = homePage:AddBanner(" + dq + "Home Thermostat App" + dq + ", " + dq + "Press the buttons to raise or lower the temperature!" + dq + ")

// Add the icons in a single row.
Grouping imageGroup = homePage:AddGrouping(" + dq + "images" + dq + ")
imageGroup:AddIcon(" + dq + "Sun" + dq + "," + dq + "Images/sun.png" + dq + ")
imageGroup:AddIcon(" + dq + "Thermometer" + dq + "," + dq + "Images/thermometer.png" + dq + ")
imageGroup:AddIcon(" + dq + "Cloud" + dq + "," + dq + "Images/angyCloud.png" + dq + ")
imageGroup:SetDescription(" + dq + "Image of a sun, a thermometer, and a cloud" + dq + ")

// Creates a variable inside the Form for modifying the temperature.
// Forms can store variables in a special way that lets other classes access them.
integer temperature = 70
form:SetInteger(" + dq + "temperature" + dq + ", 70)

// Make a Label to display the current temperature.
Label currTemp =  homePage:AddLabel(" + dq + "CurrentTemperature" + dq + ")
currTemp:SetText(temperature + " + dq + " F" + dq + ")
currTemp:SetFontSize(24)

/*
	TemperatureBehavior objects can be used to make the Raise and Lower
	buttons react when they are clicked.
*/
Button up = homePage:AddButton(" + dq + "Raise" + dq + ")
// YOUR CODE GOES HERE

Button down = homePage:AddButton(" + dq + "Lower" + dq + ")
// YOUR CODE GOES HERE

form:Display()")
        Paragraph():Strong("TemperatureBehavior.quorum")
        CodeExample("use Libraries.Interface.Events.BehaviorEvent
use Libraries.Interface.Forms.FormBehavior
use Libraries.Interface.Forms.Form
use Libraries.Interface.Forms.Page
use Libraries.Game.Graphics.Label
use Libraries.Interface.Item

class TemperatureBehavior is FormBehavior
	action Run(BehaviorEvent event)
    	// Get the Form and Page for our app.
    	Form form = GetForm()
    	Page page = GetPage()
// Get the specific button that was triggered.
    	Item button = event:GetItem()
    	text typeOfButton = button:GetName()
    	// Get the temperature variable stored in the Form.
    	integer temp = form:GetInteger(" + dq + "temperature" + dq + ")
    	// Check which button was clicked, then change the temp as needed.
   	 
    	// YOUR CODE GOES HERE
   	 
    	// After we set the variable, it is essential to update the variable stored in the Form too.
    	form:SetInteger(" + dq + "temperature" + dq + ", temp)

    	// Update the temperature label.
    	Label label = page:GetLabel(" + dq + "CurrentTemperature" + dq + ")
    	label:SetText(temp+ " + dq + " F" + dq + ")
	end
end")
        Subsubsection("Fill in the Code")
        Paragraph("There are three spots marked "):DoubleQuote():Text("YOUR CODE GOES HERE"):DoubleQuote():Text(" in the project. Two of them are in Main.quorum, and one is in TemperatureBehavior.quorum. Fill in the three spots, making sure to periodically swap who is acting as driver and navigator in your pair. In Main.quorum, create your behaviors and set them on the buttons.")
        Paragraph("In TemperatureBehavior.quorum, add code to control what happens when a button is pressed. When you click the "):DoubleQuote():Text("Raise"):DoubleQuote():Text(" button, increase the temperature value by 1. If you click the "):DoubleQuote():Text("Lower"):DoubleQuote():Text(" button, reduce the temperature value by 1 instead.")
        Subsubsection("Bonus: I'm Feeling Lucky")
        Paragraph("If you want an extra challenge, once you have completed the rest of your app, try adding a new feature to your app:")
        BulletList()
        ListItem("Add a new button to your app named "):DoubleQuote():Text("I’m Feeling Lucky"):DoubleQuote()
        ListItem("When the button is pressed, use the "):Code("Libraries.Compute.Random"):Text(" library to randomly set the temperature to an integer between 60 and 90 degrees.")
        Subsection("Wrap up")
        Paragraph("This completes the entire chapter of learning block-based Quorum Language. Reflect on how you have used Quorum and working with the development environment. What was most successful while you were working and what do you think could have improved while tinkering?")
        Paragraph("Have a discussion with a partner next to you and discuss these questions in further detail: If you were a student, what pieces of Quorum would stick with a student? Where would you see students struggling the most?")
    end
end
