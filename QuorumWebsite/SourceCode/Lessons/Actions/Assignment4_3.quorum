        SetDescription("Learn how to code your own dialog trees using actions in a computer game with the Quorum programming language.")
        SetSummary("an introduction to creating trees of dialog in games.")
    end

    action Setup
        SetWebPageTitle("Assignment 4.3: Dialog Trees - 3D Games")
        Title("Assignment 4.3: Dialog Trees - 3D Games")
