use Libraries.Web.Page.QuorumPage

/*
    Challenge 4.1: Line Following.
    Converted from the old Lesson page by plan 13's generator: the same
    words, now without Tailwind.
*/
class Challenge4_1 is QuorumPage

    on create
        SetLocation("lessons/chapter4/challenge4_1.html")
        // The name lists and links use, and the series and track it belongs
        // to: its section and picture.
        SetShortTitle("Challenge 4.1")
        SetSectionName("Actions")
        // For search engines and link previews, and what lists of pages say.
        SetDescription("Learn how to write a line following algorithm for LEGO Mindstorms robots using the Quorum programming language.")
        SetSummary("an introduction to line following with robots.")
    end

    action Setup
        SetWebPageTitle("Challenge 4.1: Line Following")
        Title("Challenge 4.1: Line Following")
        Paragraph("Using Actions with Robots")
        LineFollowing()
        Overview()
    end

    private action LineFollowing
        Section("Line Following")
        Subsection("Goals")
        Paragraph("In this challenge you will practice the following computer science concepts in a team or small group environment:")
        BulletList()
        ListItem("Creating Objects")
        ListItem("Using multiple conditional statements and looping statements")
        ListItem("Creating and Using variables")
        Subsection("Computer Science Principles Curriculum")
        BulletList()
        ListItem():Strong("Big Idea: Creativity: "):Text("EU 1.2, LO 1.2.3, EK 1.2.3A, EU 1.3, LO 1.3.1, EK 1.3.1A")
        ListItem():Strong("Big Idea: Algorithms: "):Text("EU 4.1, LO 4.1.1, EK 4.1.1B")
        ListItem():Strong("Big Idea: Programming: "):Text("EU 5.1, LO 5.1.1, EK 5.1.1B, EU 5.2, LO 5.2.1, EK 5.2.1C, EK 5.2.1D")
        Subsection("Common Core Standards")
        BulletList()
        ListItem():Strong("English Language Arts Standards » Science & Technical Subjects: "):Text("CCSS.ELA-Literacy.RST.9-10.2, CCSS.ELA-Literacy.RST.9-10.3, CCSS.ELA-Literacy.RST.9-10.4, CCSS.ELA-Literacy.RST.9-10.5, CCSS.ELA-Literacy.RST.9-10.6, CCSS.ELA-Literacy.RST.11-12.2, CCSS.ELA-Literacy.RST.11-12.3, CCSS.ELA-Literacy.RST.9-10.1, CCSS.ELA-Literacy.RST.9-10.2, CCSS.ELA-Literacy.RST.9-10.7, CCSS.ELA-Literacy.RST.9-10.8, CCSS.ELA-Literacy.RST.9-10.9")
        ListItem():Strong("Standards For Mathmatical Practice: "):Text("CCSS.Math.Practice.MP1, CCSS.Math.Practice.MP2, CCSS.Math.Practice.MP5, CCSS.Math.Practice.MP6, CCSS.Math.Practice.MP7, CCSS.Math.Practice.MP8, CCSS.Math.Content.HSF.IF.A.1")
        Subsection("Vocabulary")
        BulletList()
        ListItem("Variables")
        ListItem("Control Structures")
        ListItem("Conditional Statements")
        ListItem("If Statement")
        ListItem("Loops")
        ListItem("Color Sensor")
    end

    private action Overview
        Section("Overview")
        Paragraph("This challenge will use several libraries such as the Motor, ColorSensor, Utility, Screen and Sound library. You will use different conditions with the Color Sensor for the purpose of following the line. There are multiple ways to approach this task, so feel free to try some other ways once you finish this lab!")
        Paragraph("This project requires you to download this"):Text(" "):Link("program template", "/files/lessons/chapter4/Challenge4_1Template.zip"):Text(", which will be completed in this assignment.")
        Subsection("Goal 1: Creating objects")
        Paragraph("First you will need to unzip your template and open the project in Sodbeans. Open the main.quorum file. In the top of the file you should have the appropriate code for using the Quorum ColorSensor and the Motor libraries inside the Lego library.")
        Subsection("Activity : Instantiate the Motor and the ColorSensor objects")
        Paragraph("Call the Motor object motor and the ColorSensor object colorSensor.")
        Paragraph("Now you must set the port to work with. This will be the port that the Color Sensor is connected to on the robot. You will do that using the SetPort statement.")
        Subsubsection("Example : Tell the port your Color Sensor is connected")
        CodeExample("//This line of code will set the port to work with in parenthesis
colorSensor:SetPort(1)", "")
        Paragraph("You can change the port at any time. If you add other sensors you may want to rearrange to get the best fit.")
        Paragraph("Just remember to double check that the ports you are connected to are the ones you have set in your code!")
        Subsection("Goal 2: Using conditional and looping statements")
        Paragraph("Your code should work like this: the robot will go forward if the color sensor detects the colored line. If the sensor does not detect the colored line, it will first turn to the right in search of that color. If it does not detect that color after turning a certain number of degrees to the right, it will turn to the left. You will have to consider how much the robot turned to the right, so when it turns back left it will check far enough in that direction.")
        Paragraph("Let’s start with the conditions now. In order to get the color of the line, you will use the GetColor() command. You may have to experiment to find the setting that the color sensor will respond to best.")
        Subsection("Activity : Write the proper code to set the condition of the motors A and D to move forward")
        CodeExample("//This line is the looping condition; once the condition doesn’t match anymore the program stops
repeat until", "")
        Paragraph("Try experimenting with the Color Sensor. Let's move the Lego Robot forward when it finds the color blue (we suggest using blue tape). Then, if the Lego Robot finds another color (it goes off the tape), it will stop immediatly.")
        Paragraph("Don't forget to set the speed of the motors. Look back at earlier robot lessons if you don't remember how to do this.")
        Subsubsection("Example : Conditions in case the color line isn’t forward")
        CodeExample("//Before the conditions, to make it easier, let's call 'color' the values the sensor will get
color = colorSensor:GetColor() 

 if //the color is equal to anything besides blue
    //The Lego Robot will turn to the right in search of blue
    if 
        //The right wheel will rotate a certain number of degrees backward
        //The left wheel will rotate the same number of degrees forward (creating a turn)
    //After the time you decided, the Lego Robot will change direction and turn to the left side
    elseif    
        //The Lego Robot will turn to the left to find the color line 
    end
 end", "")
        Paragraph("If the robot finds the blue line again, you will want it to go back to moving forward, starting the whole process again. A condition should move your program back to the beginning again in this case.")
        Subsection("Activity : Creating and changing variables in many loops")
        Paragraph("To achieve this, you will have four loops. The robot will take each step in an effort to find the blue line and then start moving forward again.")
        Paragraph("You will need to add one more loop between the two in the previoius example. You will also need one before the end.")
        Subsubsection("Example : Conditions in case the color line isn’t forward")
        CodeExample("//The car will try to find the line to the RIGHT 
if condition = condition1 //turn to the right
   condition = condition2

//After a certain amount of time, the car will change its direction to the LEFT
elseif condition = condition2 
   condition = condition3

//The car will then try to find the line to the LEFT
elseif condition = condition3 
   condition = condition4

//After a certain amount of time, the car changes its direction back to the RIGHT
elseif condition = condition4 
   condition = condition1
end", "")
        Paragraph("Don't forget to write the conditions after the objects have been created.")
        Subsection("Activity : Call the actions")
        Paragraph("Your program should work just fine now, but to make it better let’s add this line after the end in order to tell the program to wait 250 milliseconds before it stops.")
        CodeExample("utility:DelayMilliseconds(250)", "")
    end
end
