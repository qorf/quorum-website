use Libraries.Web.Page.QuorumPage

/*
    Assignment 4.1: Frogger.
    Converted from the old Lesson page by plan 13's generator: the same
    words, now without Tailwind.
*/
class Assignment4_1 is QuorumPage
    // A double quote, for code and words that hold one.
    text dq = ""

    on create
        SetLocation("lessons/chapter4/assignment4_1.html")
        // The name lists and links use, and the series and track it belongs
        // to: its section and picture.
        SetShortTitle("Assignment 4.1")
        SetSectionName("Actions")
        // For search engines and link previews, and what lists of pages say.
        SetDescription("Learn to code actions while creating a Frogger-style computer game with the Quorum programming language.")
        SetSummary("an introduction to actions.")
    end

    action Setup
        dq = dq:GetDoubleQuote()
        SetWebPageTitle("Assignment 4.1: Frogger")
        Title("Assignment 4.1: Frogger")
        Paragraph("Making a Frogger-like game")
        GoalsPart()
        ComputerSciencePrinciplesCurriculum()
        CommonCoreStandards()
        Overview()
        Goal1MovingACharacterUsing4Actions()
        Goal2AddBoxesAndMoveThem()
        Goal3WinOrLoseTheGame()
        Collaborate()
    end

    private action GoalsPart
        Section("Goals")
        Paragraph("The goals of this assignment are to learn to do the following:")
        BulletList()
        ListItem("Move a character using different actions")
        ListItem("Load a Model (in this case a box) on a scene and move it")
        ListItem("Use conditional statements in actions to manage collision between a box and a model")
    end

    private action ComputerSciencePrinciplesCurriculum
        Section("Computer Science Principles Curriculum")
        BulletList()
        ListItem():Strong("Big Idea: Data and Information:"):Text("EU 3.3, LO 3.3.1, EK 3.3.1G, EK 3.3.1H")
        ListItem():Strong("Big Idea: Programming:"):Text("EU 5.1, LO 5.1.3, EK 5.1.3B, EK 5.1.3D")
        ListItem():Strong("Big Idea: Global Impact:"):Text("EU 7.1, LO 7.1.1, EK 7.1.1C, EK 7.1.1H")
    end

    private action CommonCoreStandards
        Section("Common Core Standards")
        BulletList()
        ListItem():Strong("English Language Arts Standards » Science & Technical Subjects: "):Text("CCSS.ELA-Literacy.RST.9-10.2, CCSS.ELA-Literacy.RST.9-10.3, CCSS.ELA-Literacy.RST.9-10.4, CCSS.ELA-Literacy.RST.9-10.5, CCSS.ELA-Literacy.RST.9-10.6, CCSS.ELA-Literacy.RST.11-12.2, CCSS.ELA-Literacy.RST.11-12.3, CCSS.ELA-Literacy.RST.9-10.1, CCSS.ELA-Literacy.RST.9-10.2, CCSS.ELA-Literacy.RST.9-10.7, CCSS.ELA-Literacy.RST.9-10.8, CCSS.ELA-Literacy.RST.9-10.9")
        ListItem():Strong("Standards For Mathmatical Practice: "):Text("CCSS.Math.Practice.MP1, CCSS.Math.Practice.MP2, CCSS.Math.Practice.MP5, CCSS.Math.Practice.MP6, CCSS.Math.Practice.MP7, CCSS.Math.Practice.MP8, CCSS.Math.Content.HSF.IF.A.1")
    end

    private action Overview
        Section("Overview")
        Paragraph("This project requires you to download this"):Text(" "):Link("program template for the Frogger game", "/files/lessons/chapter4/Assignment4_1Template.zip"):Text(", which will be completed in this assignment.")
        Paragraph("In this assignment, you will learn the basics of loading models on a scene, and how you can make them move using actions. We will take the example of a Frogger-style game (if you don't know Frogger, check out this "):Link("Frogger information page", "https://en.wikipedia.org/wiki/Frogger"):Text(". In this game, you can control (move) a character in order to reach a goal. On the way, you will encounter rows of moving obstacles. If you collide with one of the obstacles, you come back to the starting point and lose a life. When you lose all your lives, it is a Game Over. In our case, one mistake will be a Game Over.")
        Paragraph("Start this assignment by opening the given project template. We will look at the code that is given, and then complete the game by: making a given model move, loading and moving more obstacles, and setting the win conditions by managing collisions.")
    end

    private action Goal1MovingACharacterUsing4Actions
        Section("Goal 1 : Moving a character using 4 actions")
        Subsection("Example")
        Paragraph("To move our character, we will write actions. In the template, the action MoveForward() has already been written. Right beneath the MoveForward() action, you will find headers for the actions MoveBackward(), StrafeRight(), and StrafeLeft(). Each of these actions, including MoveForward() has one parameter: a number called speed. Let's take a look at the MoveForward() more closely:")
        Paragraph("Navigate to the MoveForward() action toward the end of the program template.")
        CodeExample("action MoveForward() 
    positionX = speed       //By setting the X position, we move the character forward
    positionY = 0
    positionZ = 0
end")
        Paragraph("This action is responsible for updating 3 variables that are used to move the characters. Right now, our character can only move forward. We need to finish the remaining 3 movement actions.")
        Subsection("Activity")
        Paragraph("Finish the 3 others actions: MoveBackward(number speed), StrafeLeft(number speed), and StrafeRight(number speed) based on the MoveForward(number speed) action. Think about which coordinates (x, y, or z) should be changed to move the character backward, to the left and to the right. Remember, we are looking down the x-axis. Imagine the character is moving in a positive direction on the x-axis as you have him move forward.")
    end

    private action Goal2AddBoxesAndMoveThem
        Section("Goal 2 : Add boxes and move them")
        Paragraph("After the character, we need to add the obstacles. We will use the primitive boxes from the Model class to do it.")
        Subsection("Example")
        Paragraph("This example comes from the program template. Right now, there is only one obstacle. The first step to load one of these box obstacles is threefold. We have to")
        BulletList()
        ListItem("Instantiate a model (Our box)")
        ListItem("Instantiate a color object (to apply to our box)")
        ListItem("Instantiate an Audio3D object (the sound of our box)")
        CodeExample("// The box we are using
Model box1

// We have to choose a color for the box
Color colorBox1

// We put a sound on a model
Audio3D soundCar")
        Subsection("Activity")
        Paragraph("To make our Frogger game better we need to add more obstacles. Following the example above, let's instantiate 3 more boxes. Don't forget to instantiate an Audio3D object and a Color for each box we add.")
        Subsection("Example")
        Paragraph("The next step in creating an obstacle is to load the model (the box in our case). The action LoadBox() from the model class requires three parameters: the width, height, and depth of our box and the color we want our box to be.")
        Paragraph("When we load a box, we must do the following:")
        BulletList()
        ListItem("Set the color of our color object")
        ListItem("Load a box into our model object")
        ListItem("Add the model to the game")
        ListItem("Set the position of the box")
        Paragraph("When we set the color of our color objects, we call the color action")
        CodeExample("SetColor(number redValue, number blueValue, number greenValue, number alphaValue)", "")
        Paragraph():Code("SetColor(number redValue, number blueValue, number greenValue, number alphaValue)")
        Paragraph("Each parameter should be a decimal value between 0 and 1. 0 means that the color (red, blue, or green) is totally absent. 1 means the complete presence of that color. The fourth number, the alpha value, sets the color transparency, but we should leave this as 1 for this project.")
        Paragraph("Navigate to the CreateGame() action to see the example where we load our first box.")
        CodeExample("// in CreateGame

/* Position, color of a box */
colorBox1:SetColor(0, 0, 255, 1)
box1:LoadBox(2,2,2,colorBox1) // width, height, depth = 2
Add(box1) // we add it to scene
box1:SetPosition(10, -2, 0)")
        Subsection("Activity")
        Paragraph("Following the example of our first box, load, add, and set the position of our 9 new boxes. Set the positions so that two boxes exist on the same row (horizontal line across the screen) but not the same place. This should create 5 rows of obstacles.")
        Subsection("Example")
        Paragraph("The next step is adding the sound to our boxes. We can add the Audio3D directly to our model so that the sound will have the same position as our obstacle. When an Audio3D object is added to a model, the following steps must be done:")
        BulletList()
        ListItem("Load the sound file (to stream) into the Audio3D object")
        ListItem("Set the volume")
        ListItem("Tell the sound to begin playing")
        ListItem("Enable Looping")
        ListItem("Add the sound to our model")
        Paragraph("In the CreateGame action, find the code below. This is our example which adds our first Audio3D object to our first model.")
        CodeExample("// in CreateGame 

// Enable the audio file and attach it to the box
soundCar:LoadToStream(" + dq + "Sound/carSound.wav" + dq + ")
soundCar:SetVolume(0.3)
soundCar:Play()
soundCar:EnableLooping()
box1:Add(soundCar)")
        Subsection("Activity")
        Paragraph("Following the example above, add one Audio3D object to each of the boxes we have created.")
        Subsection("Example")
        Paragraph("The last thing we need to do for our obstacles is make them move. This is done in the Update(number seconds) action. When a box hits one wall, it should be moved back to the starting position (z-value 10 or -10).")
        Paragraph("Navigate to the Update action and let's look at the code to move our obstacle across the screen.")
        CodeExample("// every update, we move the boxes along the z-axis
box1:Move(0, 0, seconds * -5)

// when a box hits the other wall, we have to put it back to the original position 
if box1:GetZ() < -10 // -10 is the Z-Axis position of the left wall 
    Remove(box1) // we remove it from the scene temporarily
    box1:SetZ(10) // the starting point
    Add(box1) // we put it again on the scene
end")
        Paragraph("In this example, we make the box move from 10 to -10 on the Z-axis (where our walls are located). Now we need to move the rest of our obstacles. You can try varying the speed of your different obstacles as well to make your game a bit more challenging.")
        Subsection("Activity")
        Paragraph("Following the above example, in the Update action, call the Move action of each box and write a conditional to reset the position when it reaches the wall. Try making the two different rows of boxes go opposite directions.")
        Paragraph("The final aim of this section is to have 2 rows with 2 boxes on each (with different colors if possible) that are moving from one wall to another. For the first row, the boxes should go from left to right. For the second row, they should go from right to left.")
    end

    private action Goal3WinOrLoseTheGame
        Section("Goal 3 : Win or lose the game")
        Paragraph("Now we have to set the win/lose conditions of our game. The program template has some of the code written for us.")
        Subsection("Example")
        Paragraph("Our game has two possible endings: we hit a box and we lose the game or we reach the goal and we win the game. The template manages the win condition (collision with the goal), and manages collisions with our first box. The template uses the action")
        Paragraph():Code("IsColliding(Model character, Model box)")
        Paragraph("which returns a boolean value indicating whether the two parameters are colliding.")
        Paragraph("We can use an action that returns a boolean value in our conditional statements. In this case, we want to call the action Lose() if the character is colliding with the box. Let's look at the win/lose conditional statement in our template. This is in the Update action of our program.")
        Paragraph("The general idea of this conditional statement is: if there is a collision with a box, you lose the game. Otherwise, if there is a collision with the goal, you win the game. If neither of those things has happened, the game should play normally. This is what that looks like in the template:")
        CodeExample("if IsColliding(character, box1) // if the player is hit by a box, GAME OVER
    Lose()
//elseif {check box 2 collision and then check for the remaining boxes}
elseif IsColliding(character, goal)// if he hit the goal, victory
    Win()
else
    //this is where the code to move the boxes is (from Goal #2)

    //this is where the audio management code is (completed in the next activity)

end")
        Subsection("Activity")
        Paragraph("Following the above example, modify the conditional statement (by adding more elseif statements) to check the collision for the new boxes you have added. Each time you call the")
        Paragraph():Code("IsColliding(Model character, Model box)")
        Paragraph("action, be sure to pass the character and the box you are checking. If any of them return true, call the Lose() action.")
        Subsection("Example")
        Paragraph("The last thing that must be done in order to play the game, is managing the Audio for our boxes. When our character is near a box, we need to stream the car sound for that box. Our program template has an action")
        Paragraph():Code("IsNearCar(Model character, Model box, Audio3D soundCar) returns boolean")
        Paragraph("which, like the previous IsColliding action, returns a boolean value that indicates if the character is near the box. If the character is near box1, we Stream the audio attached to box1 (soundCar1). This is what the code to do this for box1 look like:")
        CodeExample("// every update we check if the character is near a box
if IsNearCar(character, box1, soundCar1)
    // if the character is near a box we play the sound car
    soundCar1:Stream()
//elseif {check nearness for box 2 and then for the rest of the boxes}
end ")
        Subsection("Activity")
        Paragraph("Following the above example, and using the IsNearCar action, modify the conditional statement to manage the audio for the boxes you have created. Remember to pass the character, the box you are checking, and the audio for that box.")
        Paragraph("Now, you have a basic Frogger style game. To make this game even better, you can add more rows of boxes.")
    end

    private action Collaborate
        Section("Collaborate")
        Paragraph("Collaboration is an important part of programming. When you work with other programmers, you get other points-of-view that make your programs even better. The final part of this assignment requires you to learn how to use Git, a great tool for collaborating. Head over to the "):Link("Teams and Version Control Tutorial", "/tutorials/language/teamsAndVersionControl.html"):Text(" "):Text("if you need to know how to use Git.")
        Subsection("Optional Collaboration Activity")
        Paragraph("Social media has changed the way that we communicate. It has provided a simple way to disseminate or broadcast information. It continues to develop new ways to communicate. Take advantage of this modern form of communication by creating a social media account (if you are older than 13) and sharing your Quorum Game. Invite your friends to download and play your game.")
    end
end
