use Libraries.Web.Page.QuorumPage

/*
    Assignment 4.2: Files and Overloading.
    Converted from the old Lesson page by plan 13's generator: the same
    words, now without Tailwind.
*/
class Assignment4_2 is QuorumPage
    // A double quote, for code and words that hold one.
    text dq = ""

    on create
        SetLocation("lessons/chapter4/assignment4_2.html")
        // The name lists and links use, and the series and track it belongs
        // to: its section and picture.
        SetShortTitle("Assignment 4.2")
        SetSectionName("Assignments")
        // For search engines and link previews, and what lists of pages say.
        SetDescription("Learn how to code programs that save files using action overloading with the Quorum programming language.")
        SetSummary("an introduction to file saving and action overloading.")
    end

    action Setup
        dq = dq:GetDoubleQuote()
        SetWebPageTitle("Assignment 4.2: Introducing File Saving and Action Overloading")
        Title("Assignment 4.2: Files and Overloading")
        Paragraph("Save/load files and overload actions")
        Paragraph("You will need a "):Link("template", "/files/lessons/chapter4/Assignment4_2Template.zip"):Text(". The template adds on the scene a blue cube and a red cylinder (with buttons on them). The user can choose between one of them, or load a Model that was already chosen in a previous run. When the choice is made, both Models are removed from the scene, and a KeyboardListener is added, so the game can save and load the chosen model. Once the model is loaded, the player can make it move using the directional keys, and save its last positions in a file (using the S key), to load it later (using the L key).")
        Paragraph("If there is already a model, then we want to load the last position we saved in position.txt. You will write the code that allows you to get the three coordinates of the Model. Since the values get the text type, we have to cast them into number using the "):Code("ParseNumber()"):Text(" action from the text class."):NewLine():NewLine():Strong("Example: Use "):Code("ParseNumber()"):Strong(" action to load a position."):NewLine():Text("Add this code after the else to start reading the saved position.")
        Objectives()
        ComputerSciencePrinciplesCurriculum()
        CommonCoreStandards()
        Vocabulary()
        Overview()
        Goal1SaveTextOrANumberInAFile()
        Goal2LoadANumberOrATextFromAFile()
        Goal3LoadAPathForTheModel()
    end

    private action Objectives
        Section("Objectives")
        Paragraph("The goal of this assignment is to learn the following:")
        BulletList()
        ListItem("Save number or text in a file (and overloading)")
        ListItem("Load the saved number or text (and overloading)")
        ListItem("Load a path")
    end

    private action ComputerSciencePrinciplesCurriculum
        Section("Computer Science Principles Curriculum")
        BulletList()
        ListItem():Strong("Big Idea: Creativity: "):Text("EU 1.2, LO 1.2.1, EK 1.2.1A, EK 1.2.1B, EK 1.2.1C, EK 1.2.1E")
        ListItem():Strong("Big Idea: Algorithms: "):Text("EU 4.1, LO 4.1.1, EK 4.1.1A, EK 4.1.1B, EK 4.1.1C, EK 4.1.1D, EK 4.1.1E, EK 4.1.1F, EK 4.1.1G, EK 4.1.1H, EK 4.1.1I")
        ListItem():Strong("Big Idea: Algorithms: "):Text("EU 4.1, LO 4.1.2, EK 4.1.2A, EK 4.1.2C, EK 4.1.2G, EK4.1.2I")
        ListItem():Strong("Big Idea: Programming: "):Text("EU 5.2, LO 5.2.1, EK 5.2.1A, EK 5.2.1B, EK 5.2.1C, EK 5.2.1D, EK 5.2.1E, EK 5.2.1F, EK 5.2.1G, EK 5.2.1H")
        ListItem():Strong("Big Idea: Programming: "):Text("EU 5.5, LO 5.5.1, EK 5.5.1A, EK 5.5.1B, EK 5.5.1D, EK 5.5.1F, EK 5.5.1G, EK 5.5.1H, EK 5.5.1J")
    end

    private action CommonCoreStandards
        Section("Common Core Standards")
        BulletList()
        ListItem():Strong("English Language Arts Standards » Science & Technical Subjects: "):Text("CCSS.ELA-Literacy.RST.9-10.2, CCSS.ELA-Literacy.RST.9-10.3, CCSS.ELA-Literacy.RST.9-10.4, CCSS.ELA-Literacy.RST.9-10.5, CCSS.ELA-Literacy.RST.9-10.6, CCSS.ELA-Literacy.RST.11-12.2, CCSS.ELA-Literacy.RST.11-12.3, CCSS.ELA-Literacy.RST.9-10.1, CCSS.ELA-Literacy.RST.9-10.2, CCSS.ELA-Literacy.RST.9-10.7, CCSS.ELA-Literacy.RST.9-10.8, CCSS.ELA-Literacy.RST.9-10.9")
        ListItem():Strong("Standards For Mathmatical Practice: "):Text("CCSS.Math.Practice.MP1, CCSS.Math.Practice.MP2, CCSS.Math.Practice.MP5, CCSS.Math.Practice.MP6, CCSS.Math.Practice.MP7, CCSS.Math.Practice.MP8")
    end

    private action Vocabulary
        Section("Vocabulary")
        BulletList()
        ListItem("Action")
        ListItem("Casting")
        ListItem("Class")
        ListItem("File")
        ListItem("Overload")
    end

    private action Overview
        Section("Overview")
        Paragraph("In this assignment, you will learn how to use the File class in order to open a file and use Read() and Write() actions on it. You will also take advantage of a technique known as action overloading, which allows you to define multiple actions with the same name that differ in their parameters.")
    end

    private action Goal1SaveTextOrANumberInAFile
        Section("Goal 1: Save text or a number in a file")
        Paragraph():Strong("Example: Write to a file"):NewLine():Text("First, create an empty file where we will save the data. Create a file called form.txt. In "):Code("action Save"):Text(", you will use objects from the "):Code("File"):Text(", and"):Code("FileWriter"):Text(" classes to open form.txt.")
        CodeExample("action Save(text objectForm)    
    File f
    f:SetPath(" + dq + "File/form.txt" + dq + ")
    FileWriter writer
    writer:OpenForWrite(f)
end")
        Paragraph("To write in the file, we will use the WriteLine(text yourText) from the FileWriter class.")
        CodeExample("writer:WriteLine(objectForm)
writer:Close()")
        Paragraph("This retrieves the model the player chose, and writes it to the form.txt file.")
        Paragraph():Strong("Activity: Write to the position.txt file."):NewLine():Text("Use the same code from the example above in "):Code("action Save()"):Text(". Make sure you use the action with no parameters. Also, pass "):DoubleQuote():Text("f"):DoubleQuote():Text("to the "):Code("OpenForWrite"):Text(" action, and replace form.txt with position.txt, to write to the position file.")
        Paragraph("Now, you will try to save the X, Y and Z coordinates of the Model, so that we can load it on its previous place. Since these coordinates are number, you need to use GetText() action from the number class when you write it on the file. We will overload the Save() action, since we write in a different file and save more than one line.")
        Paragraph():Strong("Example: Save the X coordinate of the Model"):NewLine():Text("Write the following line of code in "):Code("action Save()"):Text(" after "):Code("OpenForWrite"):Text(".")
        CodeExample("writer:WriteLine(finalChoice:GetX():GetText())")
        Paragraph():Strong("Activity: Add code to save the Y and Z coordinates, and to tell players the posiiton was saved."):NewLine():Text("Use the example to add code to save the Y and Z coordinates. Use a "):Code("Say"):Text(" action on the "):Code("talk"):Text(" object to tell the player the position was saved.")
    end

    private action Goal2LoadANumberOrATextFromAFile
        Section("Goal 2 : Load a number or a text from a file.")
        Paragraph("The action "):Code("Load()"):Text(" is called when the player presses the L key after choosing one of the two Models. You now have to write what it should do. Like the Save action, you need a object from the "):Code("File"):Text("class. Instead of the "):Code("FileWriter"):Text(" object, we will use the "):Code("FileReader"):Text(". The following code is already in your template.")
        CodeExample("File file
file:SetPath(" + dq + "File/form.txt" + dq + ")
FileReader reader
reader:OpenForRead(file)")
        Paragraph("The FileReader class works the same as the FileWriter one, you can read a file line per line using the ReadLine() action.")
        CodeExample("action Save(text objectForm)    
    File f
    f:SetPath(" + dq + "File/form.txt" + dq + ")
    FileWriter writer
    writer:OpenForWrite(f)
end")
        Paragraph("The table is a HashTable field we used to stock the two Models, and the keys are "):DoubleQuote():Text("cube"):DoubleQuote():Text(" and "):DoubleQuote():Text("cylinder"):DoubleQuote():Text(" which are on the buttons. We saved one of them in a file with the previous activity. So if the user clicked on cube, this code will take the Model which is associated to the keyword "):DoubleQuote():Text("cube"):DoubleQuote():Text(" in the HashTable. We choose to set its position. Finally, we have to add on the scene the chosen Model.")
        Subsection("Activity: Add a conditional to handle choices")
        Paragraph("The example above is called when a Model is not load yet. Add the conditional to handle this.")
        CodeExample("action Save(text objectForm)    
    File f
    f:SetPath(" + dq + "File/form.txt" + dq + ")
    FileWriter writer
    writer:OpenForWrite(f)
end")
        CodeExample("//These two lines set the path for the FileReader to read the postion.txt file.
file:SetPath(" + dq + "File/position.txt" + dq + ")
reader:OpenForRead(file)
//This line will set a variable for the X coordinate.
number positionX = reader:ReadLine():ParseNumber()
//These set the position, and add a Say statement to let the user know the position was loaded.
finalChoice:SetPosition(positionX, positionY, positionZ)
talk:Say(" + dq + "Last position loaded" + dq + ")")
        Paragraph():Strong("Activity: Add code to read the Y and Z coordinates."):NewLine():Text("Use the example above to add code for the Y and Z coordinates.")
        Paragraph("There is the case where the user chooses to load a previous model. In this case, the Load action will have to be a bit different, since we will look into both txt files without conditions. To do that, you will overload the Load action. Find this action:")
        CodeExample("action Load(text fileName1, text fileName2)
    // TO DO
end")
        Paragraph():Strong("Example: Overlaod the "):Code("Load()"):Strong(" action to read two files."):NewLine():Text("Add this code to the new "):Code("Load()"):Text(" action.")
        CodeExample("File f1
File f2
f1:SetPath(" + dq + "File/" + dq + "+fileName1)
f2:SetPath(" + dq + "File/" + dq + "+fileName2)
FileReader reader
reader:OpenForRead(f1)
finalChoice = table:GetValue(reader:ReadLine())
Add(finalChoice)
isLoaded = true
reader:OpenForRead(f2)
number positionX = reader:ReadLine():ParseNumber()

reader:Close()")
        Paragraph():Strong("Actvitiy: Add code for the Y and Z coordinates, as well as to set the position."):NewLine():Text("Use what you know to complete the action.")
    end

    private action Goal3LoadAPathForTheModel
        Section("Goal 3: Load a path for the Model.")
        Paragraph("Now we will load a path which is defined in a file called path.txt. We call this action LoadPath(). First of all, we add these fields in the program above the Main action.")
        CodeExample("integer indexOfTab = 0
integer tabSize = 56 // number of line in path.txt")
        Paragraph("Then, in the Update action, add the following lines :")
        CodeExample("if isLoaded
    if not pIsPressed
        finalChoice:Move(positionX*seconds, positionY*seconds, positionZ*seconds)
    else
        if indexOfTab < tabSize // 56 = number of line in path.txt
            LoadPath(indexOfTab)
            indexOfTab = indexOfTab + 1
        end
    end
end")
        Paragraph("The LoadPath action will read the same file line by line each time it is called, and will set the position of the Model using the coordinates got from the indexOfTab-th line. Use this method because it would be too fast in a loop in the LoadPath action, and you wouldn't see the Model moving.")
        CodeExample("action LoadPath(integer index)
    File file
    file:SetPath(" + dq + "File/path.txt" + dq + ")
    FileReader reader
    reader:OpenForRead(file)
    // TO DO
end")
        Paragraph():Strong("Activity: Finish the action."):NewLine():Text("Add the following code to finish the action."):NewLine()
        CodeExample("Array tab
// 56 is the number of line in the path_copy.txt file
repeat 56 times
     tab:Add(reader:ReadLine())
end
integer waitCounter = 0
Array position = tab:Get(index):Split(" + dq + " " + dq + ")
finalChoice:SetPosition(position:Get(0):ParseNumber(), position:Get(1):ParseNumber(), position:Get(2):ParseNumber())
if index = 55
    pIsPressed = false
    talk:Say(" + dq + "Path loading finished" + dq + ")
end")
    end
end
