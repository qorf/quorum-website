use Libraries.Web.Page.QuorumPage

/*
    Quiz for Actions.
    Converted from the old Lesson page by plan 13's generator: the same
    words, now without Tailwind.
*/
class Chapter4Actions is QuorumPage

    on create
        SetLocation("lessons/chapter4.html")
        // The name lists and links use, and the series and track it belongs
        // to: its section and picture.
        SetShortTitle("Actions")
        SetSectionName("Chapter 4")
        SetCardImage("/media/basics/actions.png")
        // For search engines and link previews, and what lists of pages say.
        SetDescription("Read some possible exam questions on actions are used in the Quorum programming language.")
        SetSummary("how work actions in Quorum.")
    end

    action Setup
        SetWebPageTitle("Actions Quiz - Quorum Programming Language")
        Title("Quiz for Actions")
        Paragraph("This is a short quiz about concepts related to control flow and control structures.")
        ActionsQuiz()
        EssayQuestions()
    end

    private action ActionsQuiz
        Section("Actions Quiz")
        NumberedList()
        ListItem("What is an action?")
        ListItem("In practice, programmers write many actions. What are actions useful for?")
        ListItem("We often talk about 'calling' actions. What does this mean?")
        ListItem("Describe the concept of code reuse and how it relates to actions.")
        ListItem("What is a Main action?")
        ListItem("When students learn to program, it is sometimes common to see programs written that are all within Main, instead of being broken into actions. What is the disadvantage of this?")
        ListItem("What is a parameter?")
        ListItem("List three general rules for naming actions.")
        ListItem("What is a return type and why is it important?")
        ListItem("Describe two legal names for actions and two illegal ones.")
        ListItem("What is an argument to an action and how does it differ from a parameter?")
        ListItem("What would happen if an action did nothing but call itself?")
        ListItem("What is the concept of static typing and why is it important?")
        ListItem("An action can technically have as many parameters as we want. Why might it be reasonable to keep that number low?")
        ListItem("What is action overloading?")
    end

    private action EssayQuestions
        Section("Essay Questions")
        NumberedList()
        ListItem("For the game of paper, rock, scissors, write an essay at a high level about how such a program could be broken into actions. Describe the actions, their parameters, and what they would do.")
        ListItem("Describe the concept of an action signature. What is it and what does it consist of? Why is the concept of a signature important?")
    end
end
