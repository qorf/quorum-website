use Libraries.Web.Page.QuorumPage

/*
    Lab 4.3: Robotic Actions.
    Converted from the old Lesson page by plan 13's generator: the same
    words, now without Tailwind.
*/
class Lab4_3 is QuorumPage
    // A double quote, for code and words that hold one.
    text dq = ""

    on create
        SetLocation("lessons/chapter4/lab4_3.html")
        // The name lists and links use, and the series and track it belongs
        // to: its section and picture.
        SetShortTitle("Lab 4.3")
        SetSectionName("Actions")
        // For search engines and link previews, and what lists of pages say.
        SetDescription("Learn about actions while coding LEGO Mindstorms robots using the Quorum programming language.")
        SetSummary("creating actions for robots.")
    end

    action Setup
        dq = dq:GetDoubleQuote()
        SetWebPageTitle("Lab 4.3: Robotic Actions")
        Title("Lab 4.3: Robotic Actions")
        Paragraph("Using Actions with Robots")
        RoboticActions()
        Overview()
    end

    private action RoboticActions
        Section("Robotic Actions")
        Subsection("Goals")
        Paragraph("In this lab you will practice the following computer science concepts in a team or small group environment:")
        BulletList()
        ListItem("Creating actions")
        ListItem("Using actions")
        Subsection("Computer Science Principles Curriculum")
        BulletList()
        ListItem():Strong("Big Idea: Creativity: "):Text("EU 1.2, LO 1.2.3, EK 1.2.3A, EU 1.3, LO 1.3.1, EK 1.3.1A")
        ListItem():Strong("Big Idea: Algorithms: "):Text("EU 4.1, LO 4.1.1, EK 4.1.1B")
        ListItem():Strong("Big Idea: Programming: "):Text("EU 5.1, LO 5.1.1, EK 5.1.1B, EU 5.2, LO 5.2.1, EK 5.2.1C, EK 5.2.1D")
        Subsection("Common Core Standards")
        BulletList()
        ListItem():Strong("English Language Arts Standards » Science & Technical Subjects: "):Text("CCSS.ELA-Literacy.RST.9-10.2, CCSS.ELA-Literacy.RST.9-10.3, CCSS.ELA-Literacy.RST.9-10.4, CCSS.ELA-Literacy.RST.9-10.5, CCSS.ELA-Literacy.RST.9-10.6, CCSS.ELA-Literacy.RST.11-12.2, CCSS.ELA-Literacy.RST.11-12.3, CCSS.ELA-Literacy.RST.9-10.1, CCSS.ELA-Literacy.RST.9-10.2, CCSS.ELA-Literacy.RST.9-10.7, CCSS.ELA-Literacy.RST.9-10.8, CCSS.ELA-Literacy.RST.9-10.9")
        ListItem():Strong("Standards For Mathmatical Practice: "):Text("CCSS.Math.Practice.MP1, CCSS.Math.Practice.MP2, CCSS.Math.Practice.MP5, CCSS.Math.Practice.MP6, CCSS.Math.Practice.MP7, CCSS.Math.Practice.MP8, CCSS.Math.Content.HSF.IF.A.1")
        Subsection("Vocabulary")
        BulletList()
        ListItem("Actions")
        ListItem("Color Sensor")
        ListItem("Conditionals")
        ListItem("Control Structures")
        ListItem("If Statement")
        ListItem("Loops")
        ListItem("Parameter")
    end

    private action Overview
        Section("Overview")
        Paragraph("This lab demonstrates how to create and use actions with robots. You will move the robot and use the Color Sensor to tell what color it is reading, indicating that on the screen and with different sounds.")
        Paragraph("First, open the provided template and click on the main.quorum file. You will see that the libraries are all declared and also a "):Code("ColorSensor"):Text(" object called "):Code("colorSensor"):Text(". The "):Code("ColorSensor"):Text(" object is before the action because all the objects that are going to be used in more than one action should be declared in the class before all the actions. Inside the "):Code("class Main"):Text(", is the action called "):Code("Main"):Text(" and two other actions that you are going to created.")
        Paragraph():Strong("Activity: Declare a "):Code("Motor"):Strong(", "):Code("Sound"):Strong(", "):Code("Screen"):Strong(" objects under the "):Code("ColorSensor"):Strong(" object. "):NewLine():Text("You will use these objects later in your program.")
        Subsection("Goal 1: Creating Actions")
        Paragraph("The Main action is where the principal code is going to be, so we will leave it for after you've created the other two actions. We will start creating the second action, on line 21, that we will call Move and it will take two text parameters, that we will call motor1 and motor2.")
        Subsubsection("Example: Create the action Move and declare the parameters")
        CodeExample("//This line will create an action called Move.
//The parentheses declare two parameters
action Move(text motor1, text motor2)")
        Paragraph("We will call this action to move the robot, so you will have to write the code to move the robot inside "):Code("action Move"):Text(".")
        Paragraph():Strong("Activity: Write the proper code to move the robot forward."):NewLine():Text("Use the "):Code("RotateByDegrees"):Text(" statement to move your robot.")
        Paragraph("The robot should stop before reading the color. Add this line to your action, so the program will wait for the motor to stop before continuing.")
        CodeExample("motor:Wait(motor1)", "")
        Paragraph("You have completed the first action. Let's create the "):Code("action ColorSensor"):Text(". This action won't take a parameter.")
        Paragraph():Strong("Activity: Create "):Code("action ColorSensor"):Strong("."):NewLine():Text("Create the action. Remember to use an "):Code("end"):Text(".")
        Paragraph("To read the colors using the Color Sensor we will need to use the "):Code("GetColor"):Text(" command. Remember that the sensor can return only 8 colors options: none, black, white, brown, red, green, blue and yellow. In the example below you can see the first two conditional statements.")
        Paragraph():Strong("Example: Start the conditional statements.")
        CodeExample("//This line gives the text returned from GetColor to the variable color
text color = colorSensor:GetColor()
//This is the first conditional statement. It checks the color " + dq + "none." + dq + "
if color = " + dq + "none" + dq + "
     sound:Buzz()
     screen:Output(" + dq + "No color read!" + dq + "
//This line is a second conditional statement to check if the color is " + dq + "black" + dq + ".
elseif color = " + dq + "black" + dq + "
     sound:PlayTone(20, 250)
     screen:Output(" + dq + "The color is:" + dq + " + color, 4)")
        Paragraph():Strong("Activity: Write six more conditional statements."):NewLine():Text("Add "):Code("elseif"):Text(" statements for the six other color possibilities. Make each sound unique, and remember to output information to the screen. Also, remember to "):Code("end"):Text(" the conditional.")
        Paragraph():Strong("Activity: Create a "):Code("Utility"):Strong(" object. Also use "):Code("SetPort"):Strong(" to set the Color Sensor.")
        Subsection("Goal 2: Using Actions")
        Paragraph("Go to "):Code("action Main"):Text(" to write the code to run the robot. You will use actions to make the robot move, stop, read and tell the color 5 times."):NewLine():Text("To call an action, you write the action name with any parameters in the parentheses. If there are no parameters, you leve the parentheses empty. () Use the name of your "):Code("Motor"):Text(" objects in the parentheses of the Move action. You can use a "):Code("repeat"):Text(" statement to simplify your program.")
        Paragraph():Strong("Activity: Use actions to make the robot move, stop, read and report color five times."):NewLine():Text("You may want to use the "):Code("Utility"):Text(" object with the "):Code("DelayMilliseconds()"):Text(" action to make your robot pause.")
    end
end
