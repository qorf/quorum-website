use Libraries.Web.Page.QuorumPage

/*
    Lab 4.2: Rock, Paper, Scissors with Actions.
    Converted from the old Lesson page by plan 13's generator: the same
    words, now without Tailwind.
*/
class Lab4_2 is QuorumPage
    // A double quote, for code and words that hold one.
    text dq = ""

    on create
        SetLocation("lessons/chapter4/lab4_2.html")
        // The name lists and links use, and the series and track it belongs
        // to: its section and picture.
        SetShortTitle("Lab 4.2")
        SetSectionName("Actions")
        // For search engines and link previews, and what lists of pages say.
        SetDescription("Learn about actions while coding a rock, paper, scissors game using the Quorum programming language.")
        SetSummary("an introduction to parameters.")
    end

    action Setup
        dq = dq:GetDoubleQuote()
        SetWebPageTitle("Lab 4.2: Rock, Paper, Scissors with Actions")
        Title("Lab 4.2: Rock, Paper, Scissors with Actions")
        Paragraph("An introduction to parameters")
        GoalsPart()
        ComputerSciencePrinciplesCurriculum()
        CommonCoreStandards()
        Overview()
        Task1GettingStarted()
        Task2CreateAGameWithActions()
        SampleOutput()
    end

    private action GoalsPart
        Section("Goals")
        Paragraph("The goals of this lab are to learn the following:")
        BulletList()
        ListItem("How to implement actions without parameters and return types")
        ListItem("How to read and understand requirements to write basic actions")
    end

    private action ComputerSciencePrinciplesCurriculum
        Section("Computer Science Principles Curriculum")
        BulletList()
        ListItem():Strong("Big Idea: Algorithms: "):Text("EK 4.1.1A, EK 4.1.1B, EK 4.1.1C, EK 4.1.1D, EK 4.1.1E, EK 4.1.1F, EK 4.1.1G, EK 4.1.1H, EK 4.2.1A, EK 4.2.1B")
        ListItem():Strong("Big Idea: Programming: "):Text("EK 5.1.2A, EK 5.1.2B, EK 5.2.1A, EK 5.2.1B, EK 5.2.1C, EK 5.2.1D, EK 5.2.1E, EK 5.5.1A, EK 5.5.1D")
    end

    private action CommonCoreStandards
        Section("Common Core Standards")
        BulletList()
        ListItem():Strong("English Language Arts Standards » Science & Technical Subjects: "):Text("CCSS.ELA-Literacy.RST.9-10.3, CCSS.ELA-Literacy.RST.9-10.4, CCSS.ELA-Literacy.RST.9-10.5, CCSS.ELA-Literacy.RST.9-10.7, CCSS.ELA-Literacy.RST.9-10.10, CCSS.ELA-Literacy.RST.11-12.2, CCSS.ELA-Literacy.RST.11-12.3, CCSS.ELA-Literacy.RST.11-12.4, CCSS.ELA-Literacy.RST.11-12.5, CCSS.ELA-Literacy.RST.11-12.10")
        ListItem():Strong("Mathematics Content: High School Functions » Building Functions: "):Text("CCSS.Math.Content.HSF.BF.1A")
        ListItem():Strong("Standards For Mathmatical Practice: "):Text("CCSS.Math.Practice.MP1, CCSS.Math.Practice.MP2, CCSS.Math.Practice.MP4, CCSS.Math.Practice.MP5, CCSS.Math.Practice.MP6, CCSS.Math.Practice.MP7, CCSS.Math.Practice.MP8")
    end

    private action Overview
        Section("Overview")
        Paragraph("In this lab, you will be writing a Rock Paper Scissors game. In this game a human player will be competing with the computer. The human player will choose rock, paper, or scissors and then the computer will randomly select one of the options. Then your program will tell the player who won the round. The use of actions will allow you to organize the game and make the program look organized.")
        CodeEditorWithCode("Activity:", "//You can use this IDE (Integrated Development Environment) for all your coding in this lesson instead of using Quorum Studio:")
    end

    private action Task1GettingStarted
        Section("Task 1: Getting Started")
        Paragraph("If you're using Quroum Studio. Create a new "):DoubleQuote():Text("Main"):DoubleQuote():Text(" project, and name it RockPaperScissors. As in the previous labs, this will leave you with a skeleton Main.quorum file, containing a Main class and Main action. After your project is created, you can use the following code skeleton(replace the code in your project with the following code):")
        CodeExample("use Libraries.Compute.Random
class Main
    /* Action Main has no parameters or return value.
       This is where the program begins executing. Within this method you should
       give the instructions to the user and then play the game.
    */
    action Main
    end

    /* Action GiveInstructions has no parameters or return value.
        It handles giving all game rules and instructions to the user before
        the game begins.
    */
    action GiveInstructions
    end

    /* Action PlayGame has no parameters or return value.
       It handles anything involving playing the game. This includes asking the player
       for their choice, generating the computer's choice, determining the winner,
       and determining if the player wishes to quit the game or continue playing.
    */
    action PlayGame
    end

    /* Action PlayersTurn has no parameters and returns an integer value.
       This action handles asking the user for their choice of rock, paper, or
       scissors. It also checks the input for errors. Then it returns the valid
       user choice.
    */
    action PlayersTurn returns integer
       integer choice = 1
       //your code goes here
       return choice
    end

    /* Action ComputersTurn has no parameters and returns an integer value.
       This action handles randomly generating the computer's choice. Then it
       returns that value.
    */
    action ComputersTurn returns integer
       integer choice = 1
       //your code goes here
       return choice
    end

    /* Action DetermineWinner has two parameters and no return value. The first
       parameter is the player's choice and the second is the computer's choice.
       This action handles determining the winner of a round in the game. It
       also says who won the round
    */
    action DetermineWinner(integer playerChoice, integer computerChoice)
    end
end")
        Paragraph("Pay close attention to the comments in the given code. They give you a good idea of how your program will be controlled. You will start by writing the GiveInstructions action. In this action you should say or output the rules and instructions for the rock, paper, scissors game. That message might be something like the following:")
        CodeExample("Welcome to the Rock Paper Scissors game!
Here are the rules:
The player and the computer will pick rock, paper, or scissors.
Paper beats rock.
Rock beats scissors.
Scissors beat paper.
Enter a 1 for rock, a 2 for paper, or a 3 for scissors.", "")
        Paragraph("Once the GiveInstructions action is written, call the action in the Main action. Remember Main is where your program begins executing or running and the end following the Main action is where it ends. Run the program and it should give the instructions you wrote in the GiveInstructions action.")
    end

    private action Task2CreateAGameWithActions
        Section("Task 2: Create A Game with Actions")
        Paragraph("You are going to create a game with actions. You will separate each action so that they serve their own purpose. The first of these actions will be the PlayersTurn action. This action should ask the user to choose rock, paper, or scissors and it should continue to ask the user this until a valid input is given.")
        Paragraph("Go to the PlayersTurn action. Within that action start writing code at the comment that says "):DoubleQuote():Text("your code goes here"):DoubleQuote():Text(". You will need your code to do the following:")
        BulletList()
        ListItem("Declare a boolean and initialize it to false to track valid input.")
        ListItem("Create a loop that loops until the input is valid.")
        ListItem("Within that loop, ask the user to choose rock, paper, or scissors.")
        ListItem("Cast the input from the user to an integer and store it in the choice variable(has already been declared in this action).")
        ListItem("Check if the input is valid; if it is valid the loop should stop.")
        Paragraph("The existing code then returns the user's choice from the action, return choice, is already written into the action. Don't worry about calling and testing this action right now. You will come back to this when you write the PlayGame action. Instead move onto writing the ComputersTurn action.")
        Paragraph("Go to the ComputersTurn action. Within that action start writing code at the comment that says "):DoubleQuote():Text("your code goes here"):DoubleQuote():Text(". You will need your code to do the following:")
        BulletList()
        ListItem("Declare a Random object. e.g. Random random.")
        ListItem("Generate a random integer between 1 and 3, including 1 and 3.")
        ListItem("Assign the random integer to the choice variable.")
        Paragraph("The computers choice is then returned(the code for this is already included).")
        Paragraph("The next action you are going to write is the DetermineWinner action. This action has two parameters: playerChoice and computerChoice. For this to be a general solution you won't worry about the value of each parameter; those are determined when you call the DetermineWinner action. In this action you want to use conditional statements to determine if there is a tie, if the computer won, or if the player won.")
        Paragraph("To start writing this action you can use the following code:")
        CodeExample("if playerChoice = computerChoice then
   say " + dq + "It's a tie!" + dq + "
end")
        Paragraph("Add onto this conditional so that, if:")
        BulletList()
        ListItem("Player chooses rock and computer chooses paper the output is, "):DoubleQuote():Text("Paper beats rock - the computer wins!"):DoubleQuote()
        ListItem("Player chooses rock and computer chooses scissors the output is, "):DoubleQuote():Text("Rock beats scissors - you win!"):DoubleQuote()
        ListItem("Player chooses paper and computer chooses rock the output is, "):DoubleQuote():Text("Paper beats rock - you win!"):DoubleQuote()
        ListItem("Player chooses paper and computer chooses scissors the output is, "):DoubleQuote():Text("Scissors beats paper - the computer wins!"):DoubleQuote()
        ListItem("Player chooses scissors and computer chooses paper the output is, "):DoubleQuote():Text("Scissors beats paper - you win!"):DoubleQuote()
        ListItem("Player chooses scissors and computer chooses rock the output is, "):DoubleQuote():Text("Rock beat scissors - the computer wins!"):DoubleQuote()
        Paragraph("The next action you will write is the PlayGame action. This action handles all of the game play, including getting the player's choice, randomly generating the computer's choice, determining a winner of the round, and asking the player if they want to continue playing or stop the game.")
        Paragraph("In this action, start by defining a text variable called playAgain and initialize it to "):DoubleQuote():Text("Y"):DoubleQuote():Text(". Create a loop that will continue to loop when playAgain is equal to "):DoubleQuote():Text("Y"):DoubleQuote():Text(" or "):DoubleQuote():Text("y"):DoubleQuote():Text(". Inside this loop you need to call the PlayersTurn action and store the returned value in a variable named player with a type of integer. Then do the same with the ComputersTurn action. Store the returned value in a variable named computer with a type of integer. Call DetermineWinner passing the arguments player and computer. Finally, ask the user, "):DoubleQuote():Text("Would you like to play again (Y/N)?"):DoubleQuote():Text(", and assign the result to the playAgain variable.")
        Paragraph("When you are done the PlayGame action should look like the following code:")
        CodeExample("action PlayGame
    text playAgain = " + dq + "Y" + dq + "
    repeat while playAgain = " + dq + "Y" + dq + " or playAgain = " + dq + "y" + dq + "
        integer player = PlayersTurn()
        integer computer = ComputersTurn()
        DetermineWinner(player, computer)
        playAgain = input(" + dq + "Would you like to play again (Y/N)?" + dq + ")
    end
end")
        Paragraph("The final step is to finish writing the Main action. The Main action should give the instructions, play the game, and say "):DoubleQuote():Text("Game over"):DoubleQuote():Text(" when the game is done.")
    end

    private action SampleOutput
        Section("Sample Output")
        Paragraph("The following is sample output from the game:")
        CodeExample("Welcome to the Rock Paper Scissors game!
Here are the rules:
