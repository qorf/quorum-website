    private action Overview
        Section("Overview")
        Paragraph("In this lesson, you will practice creating and calling actions using parameters and return types. You will write a random noise generator. This program will use objects "):Code("Audio"):Text(" and "):Code("AudioSample"):Text(" libraries. As well as the "):Code("Random"):Text(" library.")
    end

    private action GettingStarted
        Section("Getting Started")
        Paragraph("Either use the IDE that will open in another window, or Quorum Studio to write your program. If using Quorum Studio, create a new project using "):DoubleQuote():Text("Blank. "):DoubleQuote():Text("Add the three libraries mentioned above at the top of your program. You will also need at add "):Code("class Main"):Text(" and "):Code("action Main"):Text(". Try to write these yourself, then check the sample code under the online IDE.")
        CodeEditorWithCode("Write Your Program Here", "//You can use this IDE for all your coding in this lesson instead of using Quorum Studio")
        Paragraph("When your project opens in Sodbeans, "):Code("main.quourm"):Text(" will contain the most of code listed below. You need to add the libraries.")
        CodeExample("use Libraries.Sound.Audio
use Libraries.Sound.AudioSamples
use Libraries.Compute.Random

class Main
//You will declare objects here
action Main
//You will write the majority of the code in this action.
end
//You will add new actions here, between the end of the main action and the main class.
end")
    end

    private action Goal1WriteActionsWithDifferentReturnTypes
        Section("Goal 1: Write actions with different return types")
        Paragraph():Strong("Example: Create "):Code("action SamplesPerSecond()"):Strong("."):NewLine():Text("The following code creates an action that "):Code("returns"):Text(" an integer. You will use this action to fill in the parameter of the "):Code("SetSamplesPerSecond()"):Text(" action. This action will be called on the "):Code("AudioSample"):Text(" object.")
        CodeExample("//First, you must create the action, then add " + dq + "returns integer" + dq + ".
//This will allow the action to pass an integer on to whatever calls it.

action SamplesPerSecond() returns integer

    //This line creates a variable and uses the Random object to create a random integer between 1 and 44100.
    //This integer will be used to define how many samples will be used in a second. The default is 44100.

integer sample = random:RandomIntegerBetween(1, 44100)

    //This line declares what variable will be returned.

    return sample

    //As with control stuctures, remember that all actions have to have an end.

end")
        Paragraph():Strong("Activity: Create "):Code("Seconds()"):Strong("."):NewLine():Text("The "):Code("Seconds()"):Text(" needs to return a number. You will need to declare a variable and instantiate it to a random number. Write your action under the "):Code("action SamplesPerSecond()"):Text(" action.")
    end

    private action Goal2UseActionsWithParameters
        Section("Goal 2: Use actions with parameters")
        Paragraph("You have written two actions to be used a parameters for other actions. What are parameters? Parameters are a kind of variable that is part of an action. Parameters go in the (). Some actions do not need parameters, others do. You will be using the "):Code("AudioSample"):Text(" library to create audio samples. These samples can use different channels, gather different numbers of samples, and play the for different lengths of time. The actions you have written will be used to randomize the number of samples, and the length of time it plays. The example below will show you several actions with parameters, as well as help set up the rest of your program."):NewLine()
        Paragraph():Strong("Example: Write actions with parameters."):NewLine():Text("You will need to add a new variable, and use the "):Code("samples"):Text(" and "):Code("noise"):Text(" actions. You will write the rest of your program in "):Code("action Main"):Text("."):NewLine()
        CodeExample("//First, declare a variable to hold the return from the SamplesPerSecond action.

integer sample = SamplesPerSecond()

//Setting the number of channels used take a parameter.
// The example sets it to 1, but you can experiment, and see how it changes the function.

 samples:SetChannels(1)

//This line uses the variable sample as the parameter for the number of samples gathered per second.

samples:SetSamplesPerSecond(sample)
//The next line creates a counter, so the number of samples stays within the size set above.

integer counter = 0

//The loop that uses the counter you just made to gather the right number of samples.
//It then sets the sample, so it can be loaded and played.

repeat while counter < samples:GetSize()
    samples:Set(counter, random:RandomNumber() * 2 - 1, 0)
    counter = counter + 1
end")
        Paragraph():Strong("Activity: Use actions with parameters to finish your prgram."):NewLine():Text("Use the example above to add an number variable that will hold the return from "):Code("Seconds()"):Text(". Then call "):Code("SetSizeInSeconds()"):Text(" on the "):Code("AudioSample"):Text(" object. You will also have to "):Code("Load()"):Text(" the samples to the "):Code("Audio"):Text(" object. To hear the entire sample, you will also need to use "):Code("PlayUntilDone()"):Text(".")
    end

    private action Extension
        Section("Extension")
        Paragraph("After you have created your Random Noise Generator, try adding control structures to load and play multiple noises. To use the same "):Code("Audio"):Text(" object, you need to also use the "):Code("Dispose()"):Text(" action. Have fun!")
    end
end
