use Libraries.Web.Page.QuorumPage

/*
    Chapter 6: Inheritance.
    Converted from the old Lesson page by plan 13's generator: the same
    words, now without Tailwind.
*/
class Chapter6Inheritance is QuorumPage

    on create
        SetLocation("lessons/chapter6.html")
        // The name lists and links use, and the series and track it belongs
        // to: its section and picture.
        SetShortTitle("Inheritance")
        SetCardImage("/media/basics/inheritance.png")
        // For search engines and link previews, and what lists of pages say.
        SetDescription("Read some possible exam questions on how inheritance is used in the Quorum programming language.")
        SetSummary("how work inheritance in Quorum.")
    end

    action Setup
        SetWebPageTitle("Chapter 6 - Quorum Programming Language")
        Title("Chapter 6: Inheritance")
        Paragraph("This page contains questions, assignments, programs, and essays for learning about classes in Quorum.")
        Questions()
        EssayQuestions()
        InClassLabAssignments()
        ShortProgrammingProjects()
        ChallengeProgrammingProjects()
    end

    private action Questions
        Section("Questions")
        Paragraph("1. What is the keyword used to inherit a class?")
        Paragraph("2. List at least three pros of inheritance.")
        Paragraph("3. Create a class that inherits another class.")
        Paragraph("4. What is the difference between a derived class and a base class(a child and parent class)?")
        Paragraph("5. What is a blueprint and what does it do?")
        Paragraph("6. What is the keyword for creating a blueprint, and where does it go in an action?")
        Paragraph("7. Are you able to instantiate an object of a class with only blueprint actions? Why or why not?")
        Paragraph("8. What's the keyword "):DoubleQuote():Text("parent"):DoubleQuote():Text(" used for?")
        Paragraph("9. What's the keyword "):DoubleQuote():Text("me"):DoubleQuote():Text(" used for?")
        Paragraph("10. What is polymorphism?")
        Paragraph("11. Give a small example of polymorphism in action.")
        Paragraph("12. How is it that polymorphism enables you to program "):DoubleQuote():Text("in the general"):DoubleQuote():Text(" rather than "):DoubleQuote():Text("in the specific"):DoubleQuote():Text("?")
        Paragraph("13. What is the difference between inheritance and instantiation?")
        Paragraph("14. What is the advantage of creating a class with blueprint actions?")
        NumberedList()
        ListItem("Mammal can have subclasses.")
        ListItem("Mammal can have other parents than Animal.")
        ListItem("Animal can have only one subclass.")
        ListItem("Mammal can have siblings.")
    end

    private action EssayQuestions
        Section("Essay Questions")
        Paragraph("1. Explain some of the uses inheritance has and why programmers use it.")
        Paragraph("2. Explain what polymorphism is and how it benefits coders. How does polymorphism relate to and work with inheritance?")
    end

    private action InClassLabAssignments
        Section("In Class Lab Assignments")
        Paragraph():Link("Lab Manual 6.1", "/lessons/chapter6/lab6_1.html")
        BulletList()
        ListItem("Introduce the fundamentals of Inheritance")
        ListItem("Inheriting actions from a parent class")
        ListItem("Write actions for a class that uses inherited variables")
        Paragraph():NewLine():Link("Lab Manual 6.2", "/lessons/chapter6/lab6_2.html")
        BulletList()
        ListItem("Learn about blueprints")
        ListItem("Create and use blueprints")
        ListItem("Create classes that use multiple blueprint actions")
        Paragraph():NewLine():Link("Lab Manual 6.3", "/lessons/chapter6/lab6_3.html")
        BulletList()
        ListItem("Learn about polymorphism")
        ListItem("Apply the concept of inheritance across multiple classes")
        ListItem("Create and use a class hierarchical system")
        Paragraph():NewLine():Link("Lab Manual 6.4", "/lessons/chapter6/lab6_4.html")
        BulletList()
        ListItem("Learn about inheritance")
        ListItem("Learn about the Libraries.Accessibility classes")
        ListItem("Build a screen reader that reads keystrokes")
        Paragraph():NewLine():Link("Lab Manual 6.5", "/lessons/chapter6/lab6_5.html")
        BulletList()
        ListItem("Use blueprint actions")
        ListItem("Learn about the Libraries.Accessibility classes")
        ListItem("Build a screen reader that identifies a change in focus")
    end

    private action ShortProgrammingProjects
        Section("Short Programming Projects")
        Paragraph():Link("Assignment Manual 6.1", "/lessons/chapter6/assignment6_1.html")
        BulletList()
        ListItem("Creating Class actions and using derived actions")
        ListItem("Using Inheritance")
        Paragraph():NewLine():Link("Assignment Manual 6.2", "/lessons/chapter6/assignment6_2.html")
        BulletList()
        ListItem("Creating and using blueprint actions")
        ListItem("Using derived actions with blueprint actions")
        Paragraph():NewLine():Link("Assignment Manual 5.3", "/lessons/chapter6/assignment6_3.html")
        BulletList()
        ListItem("Using inheritance")
        ListItem("Using polymorphism")
        ListItem("Creating class actions and using derived actions")
    end

    private action ChallengeProgrammingProjects
        Section("Challenge Programming Projects")
        Paragraph():Link("Challenge Project 6.1", "/lessons/chapter6/challenge6_1.html")
        BulletList()
        ListItem("Build an interactive battle simulator")
        ListItem("Use the Libraries.Sound.Audio library")
        ListItem("Use inheritance and blueprint actions")
    end
end
