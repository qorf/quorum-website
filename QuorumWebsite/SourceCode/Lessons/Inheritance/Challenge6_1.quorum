use Libraries.Web.Page.QuorumPage

/*
    Challenge 6.1: Battle Simulator.
    Converted from the old Lesson page by plan 13's generator: the same
    words, now without Tailwind.
*/
class Challenge6_1 is QuorumPage
    // A double quote, for code and words that hold one.
    text dq = ""

    on create
        SetLocation("lessons/chapter6/challenge6_1.html")
        // The name lists and links use, and the series and track it belongs
        // to: its section and picture.
        SetShortTitle("Challenge 6.1")
        // For search engines and link previews, and what lists of pages say.
        SetSummary("an audio environment for battles using inheritance.")
    end

    action Setup
        dq = dq:GetDoubleQuote()
        SetWebPageTitle("Challenge 6.1: Battle Simulator")
        Title("Challenge 6.1: Battle Simulator")
        Paragraph("Use inheritance to simulate battle")
        Objectives()
        Overview()
        Requirements()
        ClassEquipment()
        ClassStats()
        ClassSounds()
        ClassRanger()
        ClassWarrior()
        ClassWizard()
        ClassMain()
        SampleOutput()
    end

    private action Objectives
        Section("Objectives")
        Paragraph("The goal of this assignment is to learn the following:")
        BulletList()
        ListItem("How to use inheritance")
        ListItem("How to create class actions and use derived actions")
        ListItem("How to use the audio library to record and play sounds")
    end

    private action Overview
        Section("Overview")
        Paragraph("In this assignment you will create an interactive battle simulator. Users will be given the chance to record their own sound effects. They will be given a description of three different types of champions, and will get to choose their champion and their opponent. Then, the two will fight to the death, with the user's own sound effects detailing each hit and miss in this epic battle.")
    end

    private action Requirements
        Section("Requirements")
        Paragraph("You will need six classes: Equipment, Sounds, Stats, Warrior, Wizard, and Ranger. Class Stats will be your base class, and will contain actions and blueprint actions to be used in each class that inherits from Stats.")
        Paragraph("To do : You have to put your own record (.wav) in the good files. And only after, you can run this project. When it's implemented, each of the records should last no more than 2 seconds.")
    end

    private action ClassEquipment
        Section("Class Equipment")
        Paragraph("In this class, you will implement a getter and a setter a class variable of type text called name:")
        BulletList()
        ListItem("action SetEquipment(text equipment): Setter for name.")
        ListItem("action GetEquipment returns text: Getter for name.")
    end

    private action ClassStats
        Section("Class Stats")
        Paragraph("This class will need the following library: use Libraries.Containers.Array. As you did in Lab 6.2, you will need to create an array of type Equipment. Name this array inventory. Class Stats will use the following actions:")
        BulletList()
        ListItem("action AddEquipment(Equipment item): This action adds the input parameter to the array inventory.")
        ListItem("action SayInventory: This action should iterate through inventory until it reaches the end and say to the user each item held in it.")
        ListItem("blueprint action BuildCharacter: This is a blueprint that will be later implemented in classes Warrior, Wizard, and Ranger.")
    end

    private action ClassSounds
        Section("Class Sounds")
        Paragraph("This class will contain several actions to record your own sound effects to be used in the simulator. Implement the following actions:")
        BulletList()
        ListItem("action RecordHit: Records for 2 seconds a "):DoubleQuote():Text("hit"):DoubleQuote():Text(" sound. To be used when your champion or your enemy successfully makes a hit.")
        ListItem("action RecordMiss: Records for 2 seconds a "):DoubleQuote():Text("miss"):DoubleQuote():Text(" sound. To be used when your champion or your enemy misses a hit.")
        ListItem("action RecordOuch: Records for 2 seconds an "):DoubleQuote():Text("ouch"):DoubleQuote():Text(" sound. To be used when you champion or your enemy gets hit.")
        ListItem("action RecordTaunt:Records for 2 seconds a taunting sound. To be used when you champion misses the enemy, or the enemy misses your champion.")
        ListItem("action RecordVictory: Records for 2 seconds a victory song. To be used if your champion deafeats the enemy.")
        ListItem("action RecordDefeat: Records for 2 seconds a "):DoubleQuote():Text("defeat"):DoubleQuote():Text(" sound. To be used if your enemy defeats your champion.")
    end

    private action ClassRanger
        Section("Class Ranger")
        Paragraph("Class Ranger will inherit from class Stats. It will have one action: action BuildCharacter. Similar to Lab 6.2, BuildCharacter will describe the Ranger in terms of his equipment and weapons. Using the inherited actions from class Stats, add at least 5 items to describe the Ranger. Example:")
        CodeExample("action BuildCharacter
    Equipment bow
    bow:SetEquipment(" + dq + "uses a two hand bow with steel arrows" + dq + ")
    parent:Stats:AddEquipment(bow)
end", "")
    end

    private action ClassWarrior
        Section("Class Warrior")
        Paragraph("Class Warrior will inherit from class Stats. It will have one action: action BuildCharacter. BuildCharacter will do the same in class Warrior as it did in class Ranger.")
    end

    private action ClassWizard
        Section("Class Wizard")
        Paragraph("Class Wizard will inherit from class Stats. It will have one action: action BuildCharacter. BuildCharacter will do the same in class Wizard as it did in class Warrior.")
    end

    private action ClassMain
        Section("Class Main")
        Paragraph("Class Main will have two actions:")
        BulletList()
        ListItem("action Damage(integer HP) returns integer Damage will use a random number generator (named value to generate integers no larger than 50). It will then follow this format: if value is between 0 and 10, decrement HP by 10. if value is between 10 and 20, decrement HP by 20. //Continue this up until 50, then return HP.")
        CodeExample("if value is between 0 and 10, decrement HP by 10.
if value is between 10 and 20, decrement HP by 20.
//Continue this up until 50, then return HP.", "")
        BulletList()
        ListItem("action Main: Mainshould call all the actions to describe the three champions. It should also call all of the actions so the user can record their own sound effects. After this, the user should be prompted to choose a champion. If the user selects the warrior, tell them they selected the warrior, and using the audio files that came with this project, play "):DoubleQuote():Text("Warrior.wav"):DoubleQuote():Text(". Do the same if the user selects the Ranger or the Wizard, playing the appropriate files for each.")
        Paragraph("Next, prompt the user to choose an opponent. Do the same for the opponent selection as you did for the champion selection: telling the user which opponent they selected, and playing the appropriate sound. Now you will simulate a battle between the champion and the opponent. Create a random number generator (named decider) that will generate integers between 0 and 3. Repeat the following until either the champion or the opponent has less than or equal to 0 hp:")
        CodeExample("if decider = 0
Play " + dq + "Hit.wav" + dq + ". Decrement the opponent's hp.  Play " + dq + "Ouch.wav" + dq + ". Tell the user
their champion made a successful hit, and tell them the enemies current hp.

if decider = 1
Tell the user their champion missed the enemy. Play " + dq + "Miss.wav" + dq + ". Play " + dq + "Taunt.wav" + dq + ".

if decider = 2
Play " + dq + "Hit.wav" + dq + ". Decrement the champion's hp. Play " + dq + "Ouch.wav" + dq + ". Tell the user
their champion was successfully hit by their opponent, and tell them the champions current hp.

if decider = 3
Tell the user the opponent missed their attack on the champion. Play " + dq + "Miss.wav" + dq + ". Play " + dq + "Taunt.wav" + dq, "")
        Paragraph("Lastly, check to see if either the champion or the opponent has died. If the champion died, play "):DoubleQuote():Text("Defeat.wav"):DoubleQuote():Text(" and tell the user the opponent was the victor. If the opponent died, play "):DoubleQuote():Text("Victory.wav"):DoubleQuote():Text(" and tell the user the champion was the victor.")
    end

    private action SampleOutput
        Section("Sample Output")
        Paragraph("When run, the program should describe the three champions to the user. Then, the user will select a champion and an opponent. The battle will ensue, and the user will be told who the victor was in the end. The following is an example of when the program is run after the champions are described:")
        CodeExample("Choose a Champion: Enter 1 for the Warrior, 2 for the Ranger, or 3 for the Wizard
1
You have chosen the Warrior as your champion.
*Play Warrior.wav*
Choose an opponent: Enter 1 for the Warrior, 2 for the Ranger, or 3 for the Wizard
2
You have chosen the Ranger as your opponent
*Play Ranger.wav*

*Play Hit.wav*
*Play Ouch.wav*
Successfully hit the enemy! His HP is 50

Your opponent missed their attack on you.
*Play Miss.wav*
*Play Taunt.wav*

*Play Hit.wav*
*Play Ouch.wav*
Successfully hit the enemy! His HP is 0

Your champion is the victor!!!
*Play Victory.wav*", "")
    end
end
