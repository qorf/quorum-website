use Libraries.Web.Page.QuorumPage

/*
    Assignment 6.3: Inheritance Practice.
    Converted from the old Lesson page by plan 13's generator: the same
    words, now without Tailwind.
*/
class Assignment6_3 is QuorumPage

    on create
        SetLocation("lessons/chapter6/assignment6_3.html")
        // The name lists and links use, and the series and track it belongs
        // to: its section and picture.
        SetShortTitle("Assignment 6.3")
        // For search engines and link previews, and what lists of pages say.
        SetSummary("another practice session with inheritance")
    end

    action Setup
        SetWebPageTitle("Assignment 6.3: Inheritance Practice")
        Title("Assignment 6.3: Inheritance Practice")
        Paragraph("An employee system")
        Objectives()
        Overview()
        Requirements()
        ClassEmployee()
        ClassSalariedEmployee()
        ClassHourlyEmployee()
        ClassCommissionEmployee()
        ClassMain()
        SampleOutput()
    end

    private action Objectives
        Section("Objectives")
        Paragraph("The goal of this assignment is to learn the following:")
        BulletList()
        ListItem("How to use inheritance")
        ListItem("How to create class actions and use derived actions")
        ListItem("How to use Polymorphism")
    end

    private action Overview
        Section("Overview")
        Paragraph("In this assignment you will create a program that tells the user the different amounts an employee can make, depending on what kind of employee they are. There are three different kinds of employees: a salaried employee, an hourly employee, and a commissioned employee. Each one will require different inputs and will require a different method for calculating earnings.")
    end

    private action Requirements
        Section("Requirements")
        Paragraph("You will need five classes: Employee, SalariedEmployee, HourlyEmployee, CommissionEmployee, and Main. Class Employee will be your base class, and will contain actions and blueprint actions to be used in each class that inherits from Employee.")
    end

    private action ClassEmployee
        Section("Class Employee")
        Paragraph("In this class, you will implement several setters and getters for variables that will be used in each class that inherits from Employee. Since every employee, regardless of how they are paid, share some common information (they have a name and a social security number), this class will obtain and provide that information. Class Employee will have the following actions:")
        BulletList()
        ListItem("blueprint action Earnings returns number")
        Paragraph("Each class will have a separate implementation for Earnings, so a blueprint action will work well here.")
        BulletList()
        ListItem("action SetFirstName(text name): Setter for the text variable firstName")
        ListItem("action GetFirstName returns text: Getter for the first name of an employee.")
        ListItem("action SetLastName(text name): Setter for the text variable lastName")
        ListItem("action GetLastName returns text: Getter for the last name of an employee.")
        ListItem("action SetSSN(integer value): Setter for the integer variable ssn")
        ListItem("action GetSSN returns integer: Getter for the social security number of an employee.")
        ListItem("action Print: The Print action will be generic in this class, with only a say statement to tell the user the first and last name and social security number. In other classes, you will use polymorphism to implement a more custom print action.")
    end

    private action ClassSalariedEmployee
        Section("Class SalariedEmployee")
        Paragraph("This class will inherit from Employee. It needs the following actions:")
        BulletList()
        ListItem("action SetWeeklySalary(number salary): Setter for the number variable weeklySalary.")
        ListItem("action GetWeeklySalary returns number: Getter for the weekly salary of an employee.")
        ListItem("action ReportSalariedEmployee(text first, text last, integer ssn, number salary): ReportSalariedEmployee should call the setters for the name(first and last), ssn, and weekly salary of an employee.")
        ListItem("action Earnings returns number: Earnings should return the weekly salary of an employee by making a call to action GetWeeklySalary. It should look similar to the following:")
        CodeExample("action Earnings returns number
    return GetWeeklySalary()
end", "")
        Paragraph("Since action GetWeeklySalary returns a value, you can call the action in a return statement, as seen above.")
    end

    private action ClassHourlyEmployee
        Section("Class HourlyEmployee")
        Paragraph("This class also inherits from Employee. It needs the following actions:")
        BulletList()
        ListItem("action SetWage(number wage): Setter for the number variable hourlyWage.")
        ListItem("action GetWagereturns number: Getter for the hourly wage of an employee.")
        ListItem("action SetHours(number hours): Setter for the number variable hoursWorked.")
        ListItem("action GetHours returns number: Getter for the hours worked by an employee.")
        ListItem("action ReportHourlyEmployee(text first, text last, integer ssn, number wage, number hours): ReportHourlyEmployee does the same thing ReportSalariedEmployee does, only it should call the setters for wage and hours instead.")
        ListItem("action Earnings returns number: Earnings should return the weekly earnings of an hourly employee. If the hourly employee has worked over 40 hours, then make sure that action Earnings is giving the employee the proper overtime(overtime is 1.5x the normal pay).")
    end

    private action ClassCommissionEmployee
        Section("Class CommissionEmployee")
        Paragraph("This class also inherits from Employee. It needs the following actions:")
        BulletList()
        ListItem("action SetCommissionRate(number rate): Setter for the number variable commissionRate")
        ListItem("action GetCommissionRate returns number: Getter for the commission rate of an employee.")
        ListItem("action SetSales(number value): Setter for the number variable sales")
        ListItem("action GetSales returns number: Getter for the number of sales an employee makes.")
        ListItem("action ReportCommissionEmployee(text first, text last, integer ssn, number commissionRate, number sales): ReportCommissionEmployee will do as the previous "):DoubleQuote():Text("Report"):DoubleQuote():Text(" actions do, except it will call the setters for commission rate and sales.")
        ListItem("action Earnings returns number: Earnings should return the earnings of a commissioned employee. This values can be calculated by commission rate * number of sales.")
    end

    private action ClassMain
        Section("Class Main")
        Paragraph("In class Main, create variables that will satisfy all the arguments for each class. Then call the appropriate actions from each class to satisfy the requirements in the Sample Output section.")
    end

    private action SampleOutput
        Section("Sample Output")
        Paragraph("When run, the program should report to the user the name of the employee, what kind of employee they are, and what their earnings are. For the hourly employee, tell the user what their hourly wage and number of hours worked are, in addition to their name, earnings, and type of employee. For a commissioned employee, tell the user their commission rate and the number of sales they made, in addition to their name, earnings, and type of employee. Output should be similar to the following:")
        CodeExample("Salaried employee Brandon Spencer. Total earnings for this salaried employee is 60,000 dollars.
Commission employee Brandon Spencer. Gross sales is 20 sales at 4 dollars per a sale. Total earnings for this commissioned employee is 80 dollars.
Hourly employee Brandon Spencer. Hourly wage is 16.0 and number of hours worked is 40. Total earnings for this hourly employee is 640 dollars.", "")
    end
end
