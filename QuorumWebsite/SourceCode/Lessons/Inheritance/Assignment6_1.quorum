use Libraries.Web.Page.QuorumPage

/*
    Assignment 6.1: Using Derived Actions.
    Converted from the old Lesson page by plan 13's generator: the same
    words, now without Tailwind.
*/
class Assignment6_1 is QuorumPage

    on create
        SetLocation("lessons/chapter6/assignment6_1.html")
        // The name lists and links use, and the series and track it belongs
        // to: its section and picture.
        SetShortTitle("Assignment 6.1")
        // For search engines and link previews, and what lists of pages say.
        SetSummary("an introduction to using derived actions")
    end

    action Setup
        SetWebPageTitle("Assignment 6.1: Using Derived Actions")
        Title("Assignment 6.1: Using Derived Actions")
        Paragraph("How to use actions we have inherited")
        Objectives()
        Overview()
        DesignCriteria()
        SampleOutput()
        RelevantFormulas()
    end

    private action Objectives
        Section("Objectives")
        Paragraph("The goal of this assignment is to learn the following concepts:")
        BulletList()
        ListItem("How to create inheritance")
        ListItem("Creating class actions and using derived actions")
        ListItem("How to work with source code in multiple files")
    end

    private action Overview
        Section("Overview")
        Paragraph("In this assignment you will create a program that computes area, volume, and other geometric attributes for a variety of 2D and 3D shapes. To do this, you will create a class hierarchy through inheritance. Your base class, Shape, will have derived classes TwoDShape and ThreeDShape. TwoDShape will have derived classes Circle, Square, Triangle, and 3DShape will have derived classes Sphere, Cube, and Pyramid. Because the 2D shapes and 3D shapes require many of the same things to complete the area and volume formulas, you can use inheritance to reuse the same variables and actions, thus creating a more robust program. In computer science, a robust program is one that that will perform well under undesirable conditions, such as low memory, or receiving invalid input.")
    end

    private action DesignCriteria
        Section("Design Criteria")
        BulletList()
        ListItem("Create a new assignment and label it Assignment6_1")
        ListItem("Create a source file named Shape.quorum")
        ListItem("Create a source file named TwoDShape.quorum")
        ListItem("Create a source file named ThreeDShape.quorum")
        ListItem("Create a source file named Circle.quorum")
        ListItem("Create a source file named Square.quorum")
        ListItem("Create a source file named Triangle.quorum")
        ListItem("Create a source file named Sphere.quorum")
        ListItem("Create a source file named Cube.quorum")
        ListItem("Create a source file named Pyramid.quorum")
        Subsection("Class Shape")
        Paragraph("Class Shape will contain Getter and Setter actions for the following variables:")
        BulletList()
        ListItem("number side - the length of a side of a square or cube.")
        ListItem("number height - the height of a triangle")
        ListItem("number radius - half the diameter of a circle")
        ListItem("number base - the length of the base of a triangle")
        Paragraph("This class should also have a static variable, number pi = 3.1415.")
        Subsection("Class TwoDShape")
        Paragraph("Class TwoDShape will contain actions that will ask for user input and use that input as the arguments for the Setter actions from base class Employee. Note: you will need to cast the input as type number, otherwise you will receive a compiler error.")
        Subsection("Class ThreeDShape")
        Paragraph("Class ThreeDShape will do the same as class TwoDShape, except that the user should be queried to enter input for cube, pyramid, and sphere, instead of for square, triangle, and circle.")
        Subsection("Class Circle")
        Paragraph("Class Circle is a derived class from class TwoDShape. It will have two actions:")
        CodeExample("action CalculateArea(number radius) returns number", "")
        Paragraph("and")
        CodeExample("action CalculateCircumference(number radius) returns number", "")
        Subsection("Class Square")
        Paragraph("Class Square is a derived class from TwoDShape. It will have two actions:")
        CodeExample("action CalculateArea(number side) returns number", "")
        Paragraph("and")
        CodeExample("action CalculatePerimeter(number side) returns number", "")
        Subsection("Class Triangle")
        Paragraph("Class Triangle is a derived class from TwoDShape. It will have one action:")
        CodeExample("action CalculateArea(number base, number height) returns number", "")
        Subsection("Class Cube")
        Paragraph("Class Cube is derived from ThreeDShape. It will have two actions, one to calculate the volume of a cube, and one to calculate surface area of a cube.")
        Subsection("Class Sphere")
        Paragraph("Class Sphere is derived from ThreeDShape. It will have two actions, one to calculate the volume of a sphere, and one to calculate the surface area of a sphere. Note: the variable pi that you made in class Shape can be accessed using the parent: keyword.")
        Subsection("Class Pyramid")
        Paragraph("Class Pyramid is derived from ThreeDShape. It will have one action that calculates the volume of a pyramid.")
        Subsection("Class Main")
        Paragraph("Class Main will have three actions. One will call all the actions from Circle, Square, and Triangle, and will report the calculations of each to the user. The second action will do the same as above, except will call the Sphere, Cube, and Pyramid actions, and report those calculations to the user. The third is action Main, which will call the previous two actions. When run, the program should prompt the user to input numbers for the variables created in class Shape. After receiving input, the program will do the various calculations, then output (say) the results to the user.")
    end

    private action SampleOutput
        Section("Sample Output")
        Paragraph("Report the calculations from all six classes. For example, the actions from Circle, Square, and Triangle may look similar to this:")
        CodeExample("The area of a square with side lengths of 5 is 25
The perimeter of a square with side lengths of 5 is 20
The area of a triangle with a base of 10 and a height of 5 is 25
The area of a circle with radius of 10 is 314
The circumference of a circle with a diameter of 10 is 31", "")
    end

    private action RelevantFormulas
        Section("Relevant Formulas")
        BulletList()
        ListItem("Area of a square: side * side")
        ListItem("Area of a circle: pi * radius2")
        ListItem("Circumference of a circle: pi * 2 * radius")
        ListItem("Area of a triangle: 1/2base * height")
        ListItem("Volume of a cube: side3")
        ListItem("Surface area of a cube: 6 * side2")
        ListItem("Volume of a sphere: 4/3 * pi * radius3")
        ListItem("Surface area of a sphere: 4 * pi * radius2")
        ListItem("Volume of a pyramid: 1/3 * (area of the base) * height")
    end
end
