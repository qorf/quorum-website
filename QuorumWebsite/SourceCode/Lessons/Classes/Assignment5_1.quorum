use Libraries.Web.Page.QuorumPage

/*
    Assignment 5.1: Input Validation and Multiple Files.
    Converted from the old Lesson page by plan 13's generator: the same
    words, now without Tailwind.
*/
class Assignment5_1 is QuorumPage
    // A double quote, for code and words that hold one.
    text dq = ""

    on create
        SetLocation("lessons/chapter5/assignment5_1.html")
        // The name lists and links use, and the series and track it belongs
        // to: its section and picture.
        SetShortTitle("Assignment 5.1")
        SetSectionName("Classes")
        // For search engines and link previews, and what lists of pages say.
        SetDescription("Learn how to write programs with multiple files and to validate user input with the Quorum programming language.")
        SetSummary("an introduction to validating input and using multiple files.")
    end

    action Setup
        dq = dq:GetDoubleQuote()
        SetWebPageTitle("Assignment 5.1: Input Validation and Multiple Files")
        Title("Assignment 5.1: Input Validation and Multiple Files")
        Paragraph("How to use multiple files and validate input")
        GoalsPart()
        ComputerSciencePrinciplesCurriculum()
        CommonCoreStandards()
        Overview()
        ClassMain()
        ClassStation()
        UsingSeparateFiles()
        OtherInformation()
        SampleOutput()
    end

    private action GoalsPart
        Section("Goals")
        Paragraph("The goals of this assignment are to learn the following:")
        BulletList()
        ListItem("How to validate user input")
        ListItem("How to create class methods")
        ListItem("How to place source code in multiple files")
    end

    private action ComputerSciencePrinciplesCurriculum
        Section("Computer Science Principles Curriculum")
        BulletList()
        ListItem():Strong("Big Idea: Programming: "):Text("EK 5.1.2B, EK 5.1.2E, EK 5.2.1F, EK 5.1.2J, EK 5.2.1C, EK 5.3.1D, EK 5.3.1I, EK 5.4.1")
    end

    private action CommonCoreStandards
        Section("Common Core Standards")
        BulletList()
        ListItem():Strong("English Language Arts Standards » Science & Technical Subjects: "):Text("CCSS.ELA-Literacy.RST.9-10.2, CCSS.ELA-Literacy.RST.9-10.3, CCSS.ELA-Literacy.RST.9-10.4, CCSS.ELA-Literacy.RST.9-10.5, CCSS.ELA-Literacy.RST.9-10.6, CCSS.ELA-Literacy.RST.11-12.2, CCSS.ELA-Literacy.RST.11-12.3")
        ListItem():Strong("Standards For Mathmatical Practice: "):Text("CCSS.Math.Practice.MP1, CCSS.Math.Practice.MP2, CCSS.Math.Practice.MP5, CCSS.Math.Practice.MP6, CCSS.Math.Practice.MP7, CCSS.Math.Practice.MP8")
    end

    private action Overview
        Section("Overview")
        Paragraph("In this assignment you will be creating a program that mimics a radio. The user will be able to select from 1 of 4 stations and each station will play a different tune. The user will also be able to set how long the tune plays for.")
        Paragraph("The duration and station input from the user must be checked for correctness. These values will be verified in the Main class, and then passed to the Station class. The Station class will be responsible for playing the music after receiving the station and duration input. The Main class will be responsible for asking the user for these values. You will learn about how to use separate files, and how to utilize the classes you define in them. Create a new assignment and label it Assignment 5_1.")
    end

    private action ClassMain
        Section("Class Main")
        Paragraph("Class Main should have the following actions:")
        BulletList()
        ListItem("action StationCheck(integer station) returns boolean: StationCheck should check to make sure the integer value passed in is between 1 and 4, inclusively. This means the value can be either 1, 2, 3, or 4. If the value passed in is valid, then this action should return true. If the value is not valid, it should output an error message and then return false.")
        ListItem("action GetStation returns integer: GetStation should ask the user to input a station (1-4) and then return the integer they enter. It should continue to ask for a station until the user enters a valid station number.")
        ListItem("action TimeCheck(integer time) returns boolean: TimeCheck will do the same things that StationCheck does: it should check if the integer passed in is between 1 and 20, inclusively. If it is, then it should return true. If not, output an error message and return false.")
        ListItem("action GetTime() returns integer: GetTime should ask the user to input an integer between 1 and 20 inclusively, and then return that integer value. It should continue to ask the user for a value until a valid one is given.")
    end

    private action ClassStation
        Section("Class Station")
        Paragraph("Class Station should have the following actions:")
        BulletList()
        ListItem("private action Play(integer time, integer note) Play should use the Play action from the Music library to play the note passed for the duration of time(the first integer passed in).")
        ListItem("action Station(integer note, integer time): Station should use action Play from above using the parameters passed in to Station as the parameters needed for Play.")
    end

    private action UsingSeparateFiles
        Section("Using Separate Files")
        BulletList()
        ListItem("Make sure to include "):DoubleQuote():Text("package Music.Players"):DoubleQuote():Text(" at the top of the Station.quorum file. package Music.Players")
        CodeExample("package Music.Players", "")
        BulletList()
        ListItem("Include the following use statement: "):DoubleQuote():Text("use Music.Players.Station"):DoubleQuote():Text(" at the top of the main.quorum file.")
        CodeExample("use Music.Players.Station", "")
        BulletList()
        ListItem("The first statement is saving the class Station into the Music.Players library.")
        ListItem("The second statement is responsible for making that specific class available to the main.quorum file. This way the user can call the class by simply typing the class name, then a variable name: 'Station radio'")
        CodeExample("Station radio", "")
        BulletList()
        ListItem("Now any public methods of the Station class can be called by typing the variable of the Station class, in this case radio, like so: radio:(parameter(s))")
        CodeExample("radio:(parameter(s))", "")
    end

    private action OtherInformation
        Section("Other Information")
        BulletList()
        ListItem("Before you begin, think about how you might change the note that's played based only on the user's input")
        ListItem("If you use a repeat statement, and don't change the variable you're using for the note, it will play the same sound for as long as the user specified")
        ListItem("Within the repeat structure you're able to change the variable, so consider how you might change it to make it a more complex sound, rather than playing one note over and over again")
        ListItem("Another consideration is that you want to make unique sounds for each station selected, but the human ear has a limited range of pitches that it is able to hear. It might take some tinkering, but try to make it so that every station played produces an audible sound.")
        ListItem("Reminder: when you want to speak a word in the Sodbeans environment, you can use the say statement. However, if you want to output a word to the Sodbeans output window, you must use an output statement. Be aware of these differences when completing this assignment.")
    end

    private action SampleOutput
        Section("Sample Output")
        Paragraph("Entering an invalid time")
        CodeExample(dq + "Please select your station (1-4):" + dq + "
" + dq + "3" + dq + "
" + dq + "How long do you want to play? (1-20):" + dq + "
" + dq + "0" + dq + "
" + dq + "Incorrect input. Please try again." + dq + "
" + dq + "How long do you want to play? (1-20):" + dq + dq + "
" + dq + "6" + dq, "")
        Paragraph("Entering an invalid station")
        CodeExample(dq + "Please select your station (1-4):" + dq + "
" + dq + "5" + dq + "
" + dq + "Incorrect input. Please try again." + dq + "
" + dq + "Please select your station (1-4):" + dq + "
" + dq + "4" + dq + "
" + dq + "How long do you want to play? (1-20):" + dq + "
" + dq + "10" + dq, "")
        Paragraph("Entering valid information")
        CodeExample(dq + "Please select your station (1-4):" + dq + "
" + dq + "2" + dq + "
" + dq + "How long do you want to play? (1-20):" + dq + "
" + dq + "19" + dq, "")
    end
end
