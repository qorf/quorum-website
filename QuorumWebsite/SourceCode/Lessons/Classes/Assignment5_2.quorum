" + dq + "3" + dq + "
" + dq + "How long do you want to play? (1-20):" + dq + "
" + dq + "0" + dq + "
" + dq + "Incorrect input. Please try again." + dq + "
" + dq + "How long do you want to play? (1-20):" + dq + dq + "
" + dq + "6" + dq, "")
        Paragraph("Entering an invalid station")
        CodeExample(dq + "Please select your station (1-4):" + dq + "
" + dq + "5" + dq + "
" + dq + "Incorrect input. Please try again." + dq + "
output] " + dq + "Please select your station (1-4):" + dq + "
" + dq + "4" + dq + "
" + dq + "How long do you want to play? (1-20):" + dq + "
" + dq + "10" + dq, "")
        Paragraph("Entering valid information")
        CodeExample(dq + "Please select your station (1-4):" + dq + "
" + dq + "2" + dq + "
" + dq + "How long do you want to play? (1-20):" + dq + "
" + dq + "19" + dq, "")
    end
end
