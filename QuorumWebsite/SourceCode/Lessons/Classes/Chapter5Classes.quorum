use Libraries.Web.Page.QuorumPage

/*
    Chapter 5: Classes.
    Converted from the old Lesson page by plan 13's generator: the same
    words, now without Tailwind.
*/
class Chapter5Classes is QuorumPage

    on create
        SetLocation("lessons/chapter5.html")
        // The name lists and links use, and the series and track it belongs
        // to: its section and picture.
        SetShortTitle("Classes")
        SetSectionName("Chapter 5")
        SetCardImage("/media/basics/classes.png")
        // For search engines and link previews, and what lists of pages say.
        SetDescription("Read some possible exam questions on how classes and arrays are used in the Quorum programming language.")
        SetSummary("how work classes in Quorum.")
    end

    action Setup
        SetWebPageTitle("Chapter 5 - Quorum Programming Language")
        Title("Chapter 5: Classes")
        Paragraph("This page contains questions, assignments, programs, and essays for learning about classes in Quorum.")
        ControlStructuresQuiz()
        EssayQuestions()
    end

    private action ControlStructuresQuiz
        Section("Control Structures Quiz")
        NumberedList()
        ListItem("Explain the relationship between classes and objects")
        ListItem("What is an array and what do we use them for?")
        ListItem("What is the difference between an action and a class and what do you use each for?")
        ListItem("What are generics and what do we use them for?")
        ListItem("Describe the concepts of public or private in relation to fields and actions.")
        ListItem("What statement do you have to have in order to create an Array?")
        ListItem("If the words public or private are left off, what is the default for actions and fields? Why might that be the default?")
        ListItem("What is the integer value for the first index in an array?")
        ListItem("What's the difference between class variables and local variables?")
        ListItem("What is autoboxing?")
        ListItem("Explain how lexical scoping works for variables with the same name with fields and nested conditionals.")
        ListItem("Where can the package statement go in a file?")
        ListItem("Describe the concept of packages and give two examples of classes and what packages they live in.")
        ListItem("Describe why packages are useful.")
        ListItem("What is the purpose of"):DoubleQuote():Text("on create"):DoubleQuote():Text("?")
    end

    private action EssayQuestions
        Section("Essay Questions")
        NumberedList()
        ListItem("Describe in a paragraph or two the concept of information hiding. In your description, state how this might relate to the concepts of public or private.")
        ListItem("Describe the concept of auto-boxing and how it relates to using arrays with generics. Give examples of auto-boxing with integers and numbers.")
    end
end
