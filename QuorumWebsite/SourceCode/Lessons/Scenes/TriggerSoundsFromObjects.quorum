use Libraries.Web.Page.QuorumPage

/*
    Trigger Sound from Objects.
    Converted from the old Lesson page by plan 13's generator: the same
    words, now without Tailwind.
*/
class TriggerSoundsFromObjects is QuorumPage

    on create
        SetLocation("lessons/Scenes/sounds.html")
        // The name lists and links use, and the series and track it belongs
        // to: its section and picture.
        SetShortTitle("Trigger Sound from Objects")
        SetSectionName("Experience Programming in Quorum (EPIQ)")
        // For search engines and link previews, and what lists of pages say.
        SetDescription("Learn to Trigger Sounds from Objects with the Quorum programming language.")
        SetSummary(" trigger sounds on objects.")
    end

    action Setup
        SetWebPageTitle("Trigger Sound from Objects - Quorum Programming Language")
        Title("Trigger Sound from Objects")
        Paragraph("Why trigger output statements when you can make noise?")
        CodeExample("integer a = 0
integer b = 1
integer c = 2

//versus

Array array
array:Add(0)
array:Add(1)
array:Add(2)")
        LearningObjectives()
        FindSoundEffectsAndHookThemIn10Minutes()
        PlaySoundsOnCollisionAndRemovePotions20Minutes()
        IntroductionToArrays20Minutes()
        WrapUp10Minutes()
    end

    private action LearningObjectives
        Section("Learning Objectives")
        Paragraph("To make our game both more fun and accessible, we are now going to add more sound to our game. In the first part of this lesson, we are going to be looking online for sound effects. Once complete, we are going to download an effect and hook it into our game.")
        Paragraph("You will:")
        BulletList()
        ListItem("Learn about hooking in sound effects")
        ListItem("Learn how to remove items from a game after a collision")
        ListItem("Learn about arrays")
    end

    private action FindSoundEffectsAndHookThemIn10Minutes
        Section("Find Sound Effects and Hook them In (10 minutes)")
        Paragraph("For sound effects, any source is fine, but one that can be used for simple sound effects is "):Link("https://freesound.org/", "https://freesound.org/"):Text(". This site allows us to create and download a variety of effects in different styles, like coins, explosions, lasers, or other audio. Again like before, we will use "):Link("Audacity", "https://www.audacityteam.org/"):Text(" to convert the files to "):Link("Ogg", "https://wiki.audacityteam.org/wiki/OGG"):Text(" format for use. We need a free account to use the site.")
    end

    private action PlaySoundsOnCollisionAndRemovePotions20Minutes
        Section("Play Sounds on Collision and Remove Potions (20 minutes)")
        Paragraph("Instead of outputting text to the console when we collide with an item, we will now convert our output statement to an audio object we will tell to play. We will use the "):Link("sound tutorial", "/tutorials/dsp/audiointro.html"):Text(" to learn how to do that. Finding the objects still may be difficult from an accessibility perspective and we encourage thinking about how we might fix that for users of our game. Finally, when a player collides with a potion, we will remove it from the game.")
    end

    private action IntroductionToArrays20Minutes
        Section("Introduction to Arrays (20 minutes)")
        Paragraph("While so far we have used variables whenever we had multiple items, like potions or something else, this can be tedious when we have many items. To fix this in a future tutorial, we first need to learn about arrays. In this part of the session, we will go over the "):Link("arrays tutorial", "/tutorials/language/arrays.html"):Text(" and practice with the concept.")
    end

    private action WrapUp10Minutes
        Section("Wrap-up (10 minutes)")
        Paragraph("The concept of arrays can be confusing to people, so in a classroom it makes sense to spend a reasonable amount of time on it. It is also a very important concept in computer science, because storing data is a commonplace thing we want to do. In groups, discuss the difference between the following two ways of writing variables:")
        Paragraph("Here are two questions each group should consider: 1) the second program is storing the same information as the first, so why even bother to use an array?, 2) What do the funny greater and less than symbols mean? Once your group has answered these two questions, there is one final activity. The "):Link("Array class", "/Libraries/Containers/Array.html"):Text(" has many actions available. Choose two actions from the documentation and put what those actions do in your own words.")
    end
end
