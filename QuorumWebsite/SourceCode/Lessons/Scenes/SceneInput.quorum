use Libraries.Web.Page.QuorumPage

/*
    Learning about Input.
    Converted from the old Lesson page by plan 13's generator: the same
    words, now without Tailwind.
*/
class SceneInput is QuorumPage

    on create
        SetLocation("lessons/Scenes/input.html")
        // The name lists and links use, and the series and track it belongs
        // to: its section and picture.
        SetShortTitle("Learning about Input")
        // For search engines and link previews, and what lists of pages say.
        SetDescription("Learn to input in the Quorum programming language.")
        SetSummary(" learning about user input.")
    end

    action Setup
        SetWebPageTitle("Learning about Input - Quorum Programming Language")
        Title("Learning about Input")
        Paragraph("Learn to get input from the keyboard")
        LearningObjectives()
        ConceptsOfKeyboardListenersAndKeyboardEvents10Mi()
        CreateAKeyboardListenerAndListenForEvents40Minut()
        WrapUp10Minutes()
    end

    private action LearningObjectives
        Section("Learning Objectives")
        Paragraph("Now that we have learned how to get information from a running scene, we now move to user input. Input in this context means largely from the keyboard or the mouse and in this lesson we focus on the keyboard.")
        Paragraph("You will:")
        BulletList()
        ListItem("Learn about KeyboardListeners")
        ListItem("Learn about Keyboard Events")
        ListItem("Learn how to code user input")
    end

    private action ConceptsOfKeyboardListenersAndKeyboardEvents10Mi
        Section("Concepts of Keyboard Listeners and Keyboard Events (10 minutes)")
        Paragraph("Computers have to be told to process user input. In most programming languages, including Quorum, this process involves "):Link("Keyboard Events and Keyboard Listeners", "/tutorials/games/events.html"):Text(". In this section, we will discuss these ideas broadly.")
    end

    private action CreateAKeyboardListenerAndListenForEvents40Minut
        Section("Create a Keyboard Listener and Listen for Events (40 minutes)")
        Paragraph("Next, we will program our KeyboardListener and respond to the events. Specifically, in the next 40 minutes, we will learn how to tell our game to listen for these events, register our game as a listener, and output the key that was pressed by the user. Keys use special codes to indicate what the user was pressing. These are generally not memorized by anyone and, as such, we will demonstrate how to look them up as they are needed.")
    end

    private action WrapUp10Minutes
        Section("Wrap-up (10 minutes)")
        Paragraph("For this wrap-up, we are going to have online discussions about the concepts in this lesson. Each group in their breakout should try to answer the following questions: 1) What does it mean to register a Keyboard Listener, 2) What is a Keyboard event and what kind of information can we obtain from them, and 3) Imagine we want to get input from the mouse instead. How do we imagine a MouseListener might work?")
    end
end
