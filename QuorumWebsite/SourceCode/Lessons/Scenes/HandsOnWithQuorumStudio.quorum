use Libraries.Web.Page.QuorumPage

/*
    Hands on with Quorum Studio.
    Converted from the old Lesson page by plan 13's generator: the same
    words, now without Tailwind.
*/
class HandsOnWithQuorumStudio is QuorumPage

    on create
        SetLocation("lessons/Scenes/intro.html")
        // The name lists and links use, and the series and track it belongs
        // to: its section and picture.
        SetShortTitle("Hands on with Quorum Studio")
        SetSectionName("Experience Programming in Quorum (EPIQ)")
        // For search engines and link previews, and what lists of pages say.
        SetDescription("Hands on with Quorum Studio")
        SetSummary("an introduction to Quorum Studio.")
    end

    action Setup
        SetWebPageTitle("Hands on with Quorum Studio - Quorum Programming Language")
        Title("Hands on with Quorum Studio")
        Paragraph("Get comfortable and learn the major features")
        LearningObjectives()
        WarmUp10Minutes()
        TinkerWithQuorumStudio40Minutes()
        WrapUp10Minutes()
    end

    private action LearningObjectives
        Section("Learning Objectives")
        Paragraph("In this session, our goal is to get up and running with Quorum Studio. We expect everyone to come in with Quorum Studio "):Link("installed", "/tutorials/language/gettingStarted.html"):Text(". The goal is to go over how we use and navigate this technology.")
        Paragraph("You will:")
        BulletList()
        ListItem("Learn about development environments and Quorum Studio")
        ListItem("Learn the major features of Quorum Studio")
        ListItem("Learn about navigation and hokeys")
        Paragraph("Throughout this project, while we encourage readers to experiment and learn on their own, we have provided the answer keys for lessons where it is relevant. Readers should feel free to reference the "):Link("answer keys", "https://github.com/qorf/epiq"):Text(" if they get stuck or even if they want to say how someone else solved the problem. (The first project is called Build A Role-Playing Game)")
    end

    private action WarmUp10Minutes
        Section("Warm Up (10 minutes)")
        Paragraph("As a first step, we are going to create a new project in Quorum Studio called a scene project. A scene project allows us to use a scene editor to create visual and auditory experiences for a user. For this, we are going to first follow the tutorial on "):Link("creating a scene project.", "/tutorials/Scenes/create.html")
    end

    private action TinkerWithQuorumStudio40Minutes
        Section("Tinker with Quorum Studio (40 minutes)")
        Paragraph("Once we have created a scene project, we are going to spend some time learning about and navigating Quorum Studio. This will include learning how to use the mouse, or the keyboard, to navigate the software. In addition, we will learn about the basic functions that Quorum Studio can perform, including compiling, running, and debugging a scene. Finally, we will introduce the scene editor, discuss the parts that it has, and learn how to navigate it.")
    end

    private action WrapUp10Minutes
        Section("Wrap Up (10 minutes)")
        Paragraph("In this portion, we are going to partner up in breakout rooms. The goal is to promote group discussions and let people ask questions of each other, while also being social. Specifically, each group will have 5 minutes to do a 3-2-1. As a group, come up with 3 things you learned, 2 things you already knew, and 1 question that your group has. In the second five minutes, we will come back to the main session and we will share with each other.")
    end
end
