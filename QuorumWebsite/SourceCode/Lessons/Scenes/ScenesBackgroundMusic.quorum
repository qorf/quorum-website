use Libraries.Web.Page.QuorumPage

/*
    Add Background Music.
    Converted from the old Lesson page by plan 13's generator: the same
    words, now without Tailwind.
*/
class ScenesBackgroundMusic is QuorumPage

    on create
        SetLocation("lessons/Scenes/music.html")
        // The name lists and links use, and the series and track it belongs
        // to: its section and picture.
        SetShortTitle("Add Background Music")
        SetSectionName("Experience Programming in Quorum (EPIQ)")
        // For search engines and link previews, and what lists of pages say.
        SetDescription("Learn how to Add Background Music with the Quorum programming language.")
        SetSummary(" finding and adding background music.")
    end

    action Setup
        SetWebPageTitle("Add Background Music - Quorum Programming Language")
        Title("Add Background Music")
        Paragraph("Games need a cool jam")
        LearningObjectives()
        WarmUp20Minutes()
        Activity30Minutes()
        WrapUp10Minutes()
    end

    private action LearningObjectives
        Section("Learning Objectives")
        Paragraph("Making games fun and accessible often involves visual and auditory features. In the next three lessons, we will be adding sound to our game. In this one, we focus on streamed sound, which we use for background music.")
        Paragraph("You will:")
        BulletList()
        ListItem("Learn about sound programming")
        ListItem("Learn about music streaming")
        ListItem("Learn about Audacity and audio formats")
    end

    private action WarmUp20Minutes
        Section("Warm up (20 minutes)")
        Paragraph("First, we need to find a cool jam. Use whatever is appropriate for you, but one source for license free music is "):Link("https://freepd.com/", "https://freepd.com/"):Text(". To the best of our knowledge, all of this work is under the "):Link("CC0 license", "https://creativecommons.org/share-your-work/public-domain/cc0/"):Text(". This means that no rights are reserved and that the music is in the public domain.Once we have found our perfect song, we need to convert it into a form suitable for Quorum to use. This is called "):Link("Ogg", "https://wiki.audacityteam.org/wiki/OGG"):Text(". Ogg is an open source format commonly used in games. We recommend using "):Link("Audacity", "https://www.audacityteam.org/"):Text(" for the conversion.")
    end

    private action Activity30Minutes
        Section("Activity (30 minutes)")
        Paragraph("Once we have our sound, we need to place our converted file into our game folder on disk. We do not do this in Quorum Studio and can use plain old Finder on Mac or Windows Explorer on Windows. For the sake of this tutorial, we placed the file at /Resources/Funshine.ogg. Once we have our sound in a place of our choosing, we will use the "):Link("streaming tutorial", "/tutorials/dsp/audioplaylongeraudiotutorial.html"):Text(" to learn how to add background music.")
    end

    private action WrapUp10Minutes
        Section("Wrap-up (10 minutes)")
        Paragraph("When streaming, we have to do a weird thing: call an action named Stream inside of another action named Update. There are three parts to this wrap-up that we encourage each group to attempt: 1) Describe in your own words to your group what stream does, 2) because Stream is in the Update action, it is called for every frame of animation. Try to reason out why that is, and 3) Explore other actions that are available in the Audio class and explain which you think might be useful for accessibility to your group.")
    end
end
