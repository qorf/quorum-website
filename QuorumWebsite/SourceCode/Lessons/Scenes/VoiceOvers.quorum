use Libraries.Web.Page.QuorumPage

/*
    Trigger Recorded Voice Over for Quests.
    Converted from the old Lesson page by plan 13's generator: the same
    words, now without Tailwind.
*/
class VoiceOvers is QuorumPage

    on create
        SetLocation("lessons/Scenes/voices.html")
        // The name lists and links use, and the series and track it belongs
        // to: its section and picture.
        SetShortTitle("Trigger Recorded Voice Over for Quests")
        SetSectionName("Experience Programming in Quorum (EPIQ)")
        // For search engines and link previews, and what lists of pages say.
        SetDescription("Learn to Trigger Recorded Voice Overs for Quests with the Quorum programming language.")
        SetSummary(" trigger recorded voice overs.")
    end

    action Setup
        SetWebPageTitle("Trigger Recorded Voice Over for Quests - Quorum Programming Language")
        Title("Trigger Recorded Voice Over for Quests")
        Paragraph("Add some flare through voice overs")
        LearningObjectives()
        RecordYourVoiceOver15Minutes()
        TriggerTheSoundForTheNonplayerCharacter15Minutes()
        AddAField5Minutes()
        IncreaseTheCount10Minutes()
        TriggerTheEndOfTheQuest15Minutes()
    end

    private action LearningObjectives
        Section("Learning Objectives")
        Paragraph("We are nearing completion of our game. At this point, we have sounds that are triggering, we have considered issues related to accessibility, and have our first quest nearly complete. We are now going to add some flare by adding a recorded voice over into our game.")
        Paragraph("You will:")
        BulletList()
        ListItem("Learn about recording voice overs")
        ListItem("Learn more about scope and fields")
        ListItem("Practice using the Audio class")
    end

    private action RecordYourVoiceOver15Minutes
        Section("Record Your Voice Over (15 minutes)")
        Paragraph("As a first step, use Audacity again, this time to record yourself saying the lines of your non-player character. Feel free to ask friends or family to record other voices, or a back and forth, if it makes sense for your game.")
    end

    private action TriggerTheSoundForTheNonplayerCharacter15Minutes
        Section("Trigger the sound for the nonplayer character (15 minutes)")
        Paragraph("Once you have recorded your voice over, using the same code we used for sound previously, remove the output statement from the NPC code and replace it with a call to play your voice over. This should provide a sound when you press the key instead, adding a level of immersion for your game. It is not required, but consider adding the spatial audio commands to move the sound for the NPC to one channel or another.")
    end

    private action AddAField5Minutes
        Section("Add a Field (5 minutes)")
        Paragraph("In order to keep track of how many items we have collected, we need to use an integer field variable and place it into our game. This field should go write under the line of code for the class, which tells Quorum it is available in all actions. This field might look something like:")
        CodeExample("class MyGame is //etc
    integer itemsCollected = 0")
    end

    private action IncreaseTheCount10Minutes
        Section("Increase the Count (10 minutes)")
        Paragraph("Whenever an item is collected, we need to increase the value of this variable by one. In our collision listener, we should add code that increases this value.")
    end

    private action TriggerTheEndOfTheQuest15Minutes
        Section("Trigger the End of the Quest (15 minutes)")
        Paragraph("Once the count of the variable is equal to the number of items in your scene, the quest is done. Complete the following to finish the basic template for our game:")
        BulletList()
        ListItem("Use a conditional to check if the quest is completed in each collision.")
        ListItem("If the quest is completed for the first time, trigger a second voice over and make the monster appear")
        ListItem("If you wish, have the monster use a second voice over with hideous laughter at the insidious fool that tried to complete the unholy quest of doom.")
    end
end
