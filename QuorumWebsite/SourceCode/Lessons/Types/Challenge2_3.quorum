use Libraries.Web.Page.QuorumPage

/*
    Challenge 2.3: Animation Sheets.
    Converted from the old Lesson page by plan 13's generator: the same
    words, now without Tailwind.
*/
class Challenge2_3 is QuorumPage
    // A double quote, for code and words that hold one.
    text dq = ""

    on create
        SetLocation("lessons/chapter2/challenge2_3.html")
        // The name lists and links use, and the series and track it belongs
        // to: its section and picture.
        SetShortTitle("Challenge 2.3")
        // For search engines and link previews, and what lists of pages say.
        SetDescription("Learn about using 2D animation sheets for game programming in the Quorum programming language.")
        SetSummary("how work Animation Sheets in Quorum.")
    end

    action Setup
        dq = dq:GetDoubleQuote()
        SetWebPageTitle("Challenge 2.3: Animation Sheets - Quorum Programming Language")
        Title("Challenge 2.3: Animation Sheets")
        GoalsPart()
        ComputerSciencePrinciplesCurriculum()
        CommonCoreStandards()
        Overview()
        Goal1CreatingAndUsingObjects()
        SampleOutput()
    end

    private action GoalsPart
        Section("Goals")
        Paragraph("In this assignment, you will practice the following computer science concepts:")
        BulletList()
        ListItem("Creating and Using Objects")
    end

    private action ComputerSciencePrinciplesCurriculum
        Section("Computer Science Principles Curriculum")
        BulletList()
        ListItem():Strong("Big Idea: Creativity: "):Text("EU 1.1, LO 1.1.1, EK 1.1.1B, EU 1.2, LO 1.2.2, EK 1.2.2A, EK 1.2.2B")
    end

    private action CommonCoreStandards
        Section("Common Core Standards")
        BulletList()
        ListItem():Strong("English Language Arts Standards » Science & Technical Subjects: "):Text("CCSS.ELA-Literacy.RST.9-10.2, CCSS.ELA-Literacy.RST.9-10.3, CCSS.ELA-Literacy.RST.9-10.4, CCSS.ELA-Literacy.RST.9-10.5, CCSS.ELA-Literacy.RST.9-10.6, CCSS.ELA-Literacy.RST.11-12.2, CCSS.ELA-Literacy.RST.11-12.3, CCSS.ELA-Literacy.RST.9-10.1, CCSS.ELA-Literacy.RST.9-10.2, CCSS.ELA-Literacy.RST.9-10.7, CCSS.ELA-Literacy.RST.9-10.8, CCSS.ELA-Literacy.RST.9-10.9")
        ListItem():Strong("Standards For Mathmatical Practice: "):Text("CCSS.Math.Practice.MP1, CCSS.Math.Practice.MP2, CCSS.Math.Practice.MP5, CCSS.Math.Practice.MP6, CCSS.Math.Practice.MP7, CCSS.Math.Practice.MP8, CCSS.Math.Content.HSF.IF.A.1")
    end

    private action Overview
        Section("Overview")
        Paragraph("In this assignment, you will write a program that positions images in the game window to create a scene. Download this "):Link("zip folder", "/files/lessons/chapter2/Challenge2_3Template.zip"):Text(" for a template to help you get started.")
    end

    private action Goal1CreatingAndUsingObjects
        Section("Goal 1: Creating and Using Objects")
        Paragraph("Open the provided template and navigate to the "):Strong("main.quorum"):Text(" file. There are five different image files included in the project template. They contain images of a bush, a rabbit, a log, a rock, and some trees. We will use these images as well as some "):Code("Drawable"):Text(" shapes, setting their positions in the game window, to create a nature scene.")
        Paragraph():Strong("Activity: Declare the "):Code("Drawable"):Strong(" objects we will need.")
        Paragraph("Since there are five image files, we will need five "):Code("Drawable"):Text(" objects. In addition to these five objects, we will need an additional three "):Code("Drawable"):Text(" objects, two that will load rectangles and one that will load a circle. The first rectangle will represent the green grass in the scene and the second rectangle will represent the blue sky. The circle will represent the sun. Finally, we will need a "):Code("Color"):Text(" object in order to load our rectangles and circle with colors other than the default of black. Declare these objects below the line that begins with "):Code("Class Main is Game"):Text(" and above the line that begins with "):Code("action Main"):Text(".")
        Paragraph("Once we have declared our objects, we need to load images to them. Navigate to the "):Code("action CreateGame"):Text(" action. This is where we will write our code to load images to the "):Code("Drawable"):Text(" objects and position them on the screen.")
        Paragraph():Strong("Example: Load two rectangles and a circle to "):Code("Drawable"):Strong(" objects and set their position")
        CodeExample("action CreateGame
   // this line loads a filled rectangle of width 800 and height 300 and 
   // colors it green
   ground:LoadFilledRectangle(800, 300, color:Green())

   // this line loads a filled rectangle of width 800 and height 300 and
   // colors it cyan (light blue)
   sky:LoadFilledRectangle(800, 300, color:Cyan())

   // this line loads a filled circle of radius 50 and colors it yellow
   sun:LoadFilledCircle(50, color:Yellow())

   // this line sets the position of our sky to the top half of the game
   // window
   sky:SetPosition(0, 300)

   // this line sets the position of our sun to the top right of the game
   // window
   sun:SetPosition(570, 450)

   // these lines add the objects to our game
   Add(ground)
   Add(sky)
   Add(sun)
end")
        Paragraph():Strong("Activity: Declare an "):Code("ImageSheet"):Strong(" object.")
        Paragraph("This assignment makes use of a "):Link("texture atlas", "https://en.wikipedia.org/wiki/Texture_atlas"):Text(" (also known as image sheets in Quorum). To get an introduction to using image sheets, refer to "):Link("this tutorial", "/tutorials/games/drawing2D.html"):Text(" . An image sheet has been provided for you in the template, called "):DoubleQuote():Text("forrest.atlas"):DoubleQuote():Text(". To find this image sheet, look in the folder labeled "):DoubleQuote():Text("resources"):DoubleQuote():Text(" in our project. To make use of our image sheet, we had to declare the use statement at the top of our program to let Quorum know that we want access to image sheets. Notice the statement "):Code("use Libraries.Game.Graphics.ImageSheet"):Text(" has already been included at the top of our program. Declare an "):Code("ImageSheet"):Text(" object in the same place we declared our other "):Code("Drawable"):Text(" objects.")
        Paragraph("Now that we have our "):Code("ImageSheet"):Text(" declared, we can begin using it to load images to our "):Code("Drawable"):Text(" objects. Navigate back down to the "):Code("action CreateGame"):Text(" action.")
        Paragraph():Strong("Example: Load an image sheet to our "):Code("ImageSheet"):Strong(" object")
        CodeExample("// this line tells our ImageSheet object which image sheet we want to load
sheet:Load(" + dq + "resources/forrest.atlas" + dq + ")")
        Paragraph("Once we have our "):Code("ImageSheet"):Text(" loaded, we can use it to get images for our "):Code("Drawable"):Text(" object. We do this by calling the "):Code("GetDrawable(text name)"):Text(" action on our "):Code("ImageSheet"):Text(". Images in "):Code("ImageSheet"):Text(" objects are named and accessed by the file name of the image minus the extension. For example, if our ImageSheet contains "):DoubleQuote():Text("dog.png"):DoubleQuote():Text(" and we wanted to get the image represented by "):DoubleQuote():Text("dog.png"):DoubleQuote():Text(", we get it by asking the "):Code("ImageSheet"):Text(" for "):DoubleQuote():Text("dog"):DoubleQuote():Text(".")
        Paragraph():Strong("Example: Use an "):Code("ImageSheet"):Strong(" to load an image to a "):Code("Drawable")
        CodeExample("// this line tells our Drawable bush to load the image received from
// the image sheet called " + dq + "bush" + dq + ". " + dq + "bush.png" + dq + " was an image file included
// in the ImageSheet
bush:Load(sheet:GetDrawable(" + dq + "bush" + dq + "))")
        Paragraph():Strong("Activity: Load images to the other Drawables from the "):Code("ImageSheet"):Strong(" and set their positions on the screen.")
        Paragraph():Code("sheet:GetDrawable(" + dq + "bush" + dq + ")"):Text(" returns a "):Code("Drawable"):Text(" object with the image of a bush loaded to it. We use this Drawable to load the bush image to our bush Drawable. Each statement to load images to Drawables from ImageSheets will look similar to the above line of code. Drawables loaded from image files act the exact same way as drawables loaded from ImageSheets. Once images have been loaded to our "):Code("Drawable"):Text(" objects, recall that the positions of our Drawables can be set by using the "):Code("SetX(number x)"):Text(", "):Code("SetY(number y)"):Text(" or "):Code("SetPositon(number x, number y)"):Text(" actions. Don't forget to add the Drawables to the game so that they appear on the screen!")
        Paragraph("Now, it's your turn to be creative! Create a scene by moving the "):Code("Drawable"):Text(" objects to different positions on the screen. Do you want the trees to appear as if they are in the foreground or the background? Do you want the bunny to be on top of the rock? It's all up to you!")
    end

    private action SampleOutput
        Section("Sample Output")
        Paragraph("Each student will produce a slightly different image. An example image is shown below.")
        Image("media/lessons/chapter2/challenge2_3screenshot.png", "This is an image of the example image.")
    end
end
