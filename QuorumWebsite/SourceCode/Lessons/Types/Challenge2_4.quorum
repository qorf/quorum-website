use Libraries.Web.Page.QuorumPage

/*
    Challenge 2.4: Choose your own patter.
    Converted from the old Lesson page by plan 13's generator: the same
    words, now without Tailwind.
*/
class Challenge2_4 is QuorumPage
    // A double quote, for code and words that hold one.
    text dq = ""

    on create
        SetLocation("lessons/chapter2/challenge2_4.html")
        // The name lists and links use, and the series and track it belongs
        // to: its section and picture.
        SetShortTitle("Challenge 2.4")
        SetSectionName("Types")
        // For search engines and link previews, and what lists of pages say.
        SetDescription("Learn about programming LEGO Mindstorms robots on a team in the Quorum programming language.")
        SetSummary("how work Choose your own pattern in Quorum.")
    end

    action Setup
        dq = dq:GetDoubleQuote()
        SetWebPageTitle("Challenge 2.4: Choose your own pattern - Quorum Programming Language")
        Title("Challenge 2.4: Choose your own patter")
        ChooseYourOwnPatter()
        Overview()
        ActivityCombineBothStatementsToDoYourPattern()
        ExampleTurnOnTheLED()
    end

    private action ChooseYourOwnPatter
        Section("Choose your own patter")
        Subsection("Goals")
        Paragraph("In this assignment you will practice the following computer science concepts in a team or small group environment:")
        BulletList()
        ListItem("Calling Actions on Objects")
        ListItem("Using the Quorum Lego Library to move the robot, play sounds and turn on the L.E.D.")
        ListItem("Practice solving technical problems together in a group.")
        Subsection("Computer Science Principles Curriculum")
        BulletList()
        ListItem():Strong("Big Idea: Creativity: "):Text("EU 1.1, LO 1.1.1, EK 1.1.1B, EU 1.2, LO 1.2.1, EK 1.2.1E, EK 1.2.4 A,C,D")
        ListItem():Strong("Big Idea: Algorithms: "):Text("EU 4.1, LO 4.1.1, EK 4.1.1H")
        ListItem():Strong("Big Idea: Programming: "):Text("EU 5.1, LO 5.1.2, EK 5.1.2I")
        Subsection("Common Core Standards")
        BulletList()
        ListItem():Strong("English Language Arts Standards » Science & Technical Subjects: "):Text("CCSS.ELA-Literacy.RST.9-10.3, CCSS.ELA-Literacy.RST.9-10.4, CCSS.ELA-Literacy.RST.9-10.5, CCSS.ELA-Literacy.RST.9-10.7, CCSS.ELA-Literacy.RST.9-10.10, CCSS.ELA-Literacy.RST.11-12.3, CCSS.ELA-Literacy.RST.11-12.4, CCSS.ELA-Literacy.RST.11-12.5, CCSS.ELA-Literacy.RST.11-12.10")
        ListItem():Strong("Standards For Mathmatical Practice: "):Text("CCSS.Math.Practice.MP1, CCSS.Math.Practice.MP2, CCSS.Math.Practice.MP4, CCSS.Math.Practice.MP5, CCSS.Math.Practice.MP6, CCSS.Math.Practice.MP7, CCSS.Math.Practice.MP8")
    end

    private action Overview
        Section("Overview")
        Paragraph("In this challenge students will move their robot through an obstacle course of thier own creation while meeting certain minimum requirements.")
        Subsection("Goal 1: Learn how to play a .WAV file on the robot")
        Paragraph("In order to play a .WAV file on your computer, follow these instructions:")
        NumberedList()
        ListItem("Instantiate a sound object as you've learned in previous lessons.")
        ListItem("Upload a .WAV file to the SD card on the robot.")
        ListItem("Use the PlayAudio action to play a wave file")
        Paragraph("Use this code template for your file, changing the path name to the location of the .WAV file on your PC. In this example, our WAV file is located in a directory called "):DoubleQuote():Text("assets"):DoubleQuote():Text(" in our main project folder.")
        CodeExample("use Libraries.Robots.Lego.Sound
use Libraries.System.File

Sound soundCtrl
File soundFile

soundFile:SetPath(" + dq + "assets/" + dq + ")
soundCtrl:PlayAudio(soundFile)")
        Paragraph("In your pattern, you must use at least one "):Code("RotateToDegree"):Text(" statement and one "):Code("RotateByDegrees"):Text(" statement. You can combine them as you want to what better fits your pattern.")
        Subsection("Example: One way to combine both statements")
        CodeExample("motor:SetSpeed(" + dq + "B" + dq + ", 600)
motor:SetSpeed(" + dq + "C" + dq + ", 600)
motor:RotateToDegree(" + dq + "B" + dq + ", -1080)
motor:RotateToDegree(" + dq + "C" + dq + ", -1080)
motor:Wait(" + dq + "B" + dq + ")
motor:RotateToDegree(" + dq + "B" + dq + ", -3700)
motor:Wait(" + dq + "B" + dq + ")")
    end

    private action ActivityCombineBothStatementsToDoYourPattern
        Section("Activity: Combine both statements to do your pattern")
        Paragraph("Read the checklist and use both statements the way you prefer to complete all the movements parts of it.")
        Subsection("Goal 2: Using the Quorum Lego Library to wait the button to be pressed to perform a task")
        Paragraph("To wait for the button to be pressed you will need to use the "):Code("Button"):Text(" library that is also inside the "):Code("Lego"):Text(" library and you also need to instantiate a new "):Code("Button"):Text(" object called "):Code("button"):Text(". You will use the "):Code("WaitForButtonPress"):Text(" statement to wait for button to be pressed. The "):Code("WaitForButtonPress"):Text(" doesn't take any parameters.")
        Paragraph():Strong("Example: Use the "):Code("WaitForButtonPress"):Strong(".")
        CodeExample("// This line waits the button to be pressed 
button:WaitforButtonPress()")
        Paragraph("Use this example to wait for the button to be pressed to run the code given early in this challenge.")
        Paragraph():Strong("Activity: Use the "):Code("WaitForButtonPress"):Strong(" statement.")
        Paragraph("Indicate when the program is waiting for the button to be pressed by using the LED and the tones. To do it you will use the "):Code("Button"):Text(" library and the "):Code("Sound"):Text(" library that are inside the "):Code("Lego"):Text(" library and instantiate a new "):Code("Sound"):Text(" object called "):Code("sound"):Text(". The command to turn on the LED is the "):Code("SetLightPattern"):Text(" that takes one parameter, the number of the pattern.")
    end

    private action ExampleTurnOnTheLED
        Section("Example: Turn on the LED")
        CodeExample("// This line turns the LED on
button:SetLightPattern(1)")
        Paragraph("This example is turning the LED on in the pattern 1, that is the LED green and solid.")
        Subsection("Activity: Turn the LED on, and make it blink")
        Paragraph("In this activity you will have to choose one pattern to your LED. You can choose the color but it must blink while waiting, so it must be the patterns 4(green), 5(red) or 6(orange).")
        Paragraph("The command to play tones is the "):Code("PlayTone"):Text(" that takes two parameters, the frequency and the duration of the tone.")
        Subsection("Example: Play a tone")
        CodeExample("// This line plays a tone
sound:PlayTone(710, 100)")
        Paragraph("This example is playing a tone in the frequency of 710 Hertz with duration of 100 milliseconds.")
        Subsection("Activity: Add tones")
        Paragraph("In this activity you will have to choose one tone to play while waiting for the button. Now you should insert these lines of code right before the lines with the command to wait for the button. And because you want the LED to be on just while waiting, right after the wait for the button command you should add a line to leave the LED without any color. The pattern that represents that is the pattern number 0.")
        Subsection("Example: Turn off the LED")
        CodeExample("// This turns off the LED
button:SetLightPattern(0)")
        Subsubsection("Sample Output")
        Paragraph("Each student will have a different pattern but all of them must include:")
        BulletList()
        ListItem("At least one RotateByDegrees and one RotateToDegree")
        ListItem("At least one movement backward")
        ListItem("At least one clockwise revolution")
        ListItem("At least one counterclockwise revolution")
        ListItem("It has to wait until the button is pressed to begin and between each move")
        ListItem("And it must have the LED and the tone to indicate while it’s waiting")
    end
end
