use Libraries.Web.Page.QuorumPage

/*
    Quiz for Variables and Types.
    Converted from the old Lesson page by plan 13's generator: the same
    words, now without Tailwind.
*/
class Chapter2VariablesTypes is QuorumPage

    on create
        SetLocation("lessons/chapter2.html")
        // The name lists and links use, and the series and track it belongs
        // to: its section and picture.
        SetShortTitle("Variables and Types")
        SetSectionName("Chapter 2")
        SetCardImage("/media/basics/variables.png")
        // For search engines and link previews, and what lists of pages say.
        SetDescription("Read some possible exam questions on how variables and types are used in the Quorum programming language.")
        SetSummary("how work variables and types in Quorum.")
    end

    action Setup
        SetWebPageTitle("Variables and Types Quiz - Quorum Programming Language")
        Title("Quiz for Variables and Types")
        Paragraph("This is a short quiz about concepts with variables and types")
        VariablesAndTypesQuiz()
        EssayQuestions()
    end

    private action VariablesAndTypesQuiz
        Section("Variables and Types Quiz")
        NumberedList()
        ListItem("What is the difference between a primitive type and an object?")
        ListItem("What is an integer and what are its legal values?")
        ListItem("What is a number and what are its legal values?")
        ListItem("What is a boolean and what are its legal values?")
        ListItem("Discuss the concept of binary and explain why it is important in computer science.")
        ListItem("What does it mean to call an action on an object? Give 2 examples.")
        ListItem("What is modulus? Give an example of what it could be used for.")
        ListItem("Which operator is used to call actions?")
        ListItem("Describe the concept of instantiating an object in your own words. Give at least one example in code.")
        ListItem("Give two examples of legal variable names in Quorum. Similarly, give two examples of illegal names.")
        ListItem("What is a compiler error and what do they tell us?")
        ListItem("What does it mean to build a program?")
        ListItem("What is a debugger and what do we use it for?")
        ListItem("What is the difference between a runtime error and a compile time error?")
    end

    private action EssayQuestions
        Section("Essay Questions")
        NumberedList()
        ListItem("Discuss each data type and explain when they should be used. Be sure to include all primitive types and several different kinds of objects.")
        ListItem("Write a paragraph explaining why the concept of variables is important in computer science. Write a second paragraph explaining the broader concept of types.")
    end
end
