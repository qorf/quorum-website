use Libraries.Web.Page.QuorumPage

/*
    Challenge 2.1: Musical Piece.
    Converted from the old Lesson page by plan 13's generator: the same
    words, now without Tailwind.
*/
class Challenge2_1 is QuorumPage

    on create
        SetLocation("lessons/chapter2/challenge2_1.html")
        // The name lists and links use, and the series and track it belongs
        // to: its section and picture.
        SetShortTitle("Challenge 2.1")
        // For search engines and link previews, and what lists of pages say.
        SetDescription("Learn about coding MIDI based music using the Quorum programming language.")
        SetSummary("how a Musical Piece works in Quorum.")
    end

    action Setup
        SetWebPageTitle("Challenge 2.1: Musical Piece - Quorum Programming Language")
        Title("Challenge 2.1: Musical Piece")
        Objectives()
        ComputerSciencePrinciplesCurriculum()
        CommonCoreStandards()
        Overview()
        Task1()
        Task2Analysis()
        SampleOutput()
    end

    private action Objectives
        Section("Objectives")
        Paragraph("The goal of this assignment is to learn the following:")
        BulletList()
        ListItem("How to use the Music library to play chords")
        ListItem("How to use multiple non-primitive data types in a single program")
    end

    private action ComputerSciencePrinciplesCurriculum
        Section("Computer Science Principles Curriculum")
        BulletList()
        ListItem():Strong("Big Idea: Creativity: "):Text("EU 1.2, LO 1.2.3, EK 1.2.3A")
        ListItem():Strong("Big Idea: Algorithms: "):Text("EU 4.1, LO 4.1.1, EK 4.1.1B")
        ListItem():Strong("Big Idea: Programming: "):Text("EU 5.2, LO 5.2.1, EK 5.2.1A, EK 5.2.1B, EK 5.2.1C, EK 5.2.1D, EK 5.2.1E, EK 5.2.1F")
    end

    private action CommonCoreStandards
        Section("Common Core Standards")
        BulletList()
        ListItem():Strong("English Language Arts Standards » Science & Technical Subjects: "):Text("CCSS.ELA-Literacy.RST.9-10.2, CCSS.ELA-Literacy.RST.9-10.3, CCSS.ELA-Literacy.RST.9-10.4, CCSS.ELA-Literacy.RST.9-10.5, CCSS.ELA-Literacy.RST.9-10.6, CCSS.ELA-Literacy.RST.11-12.2, CCSS.ELA-Literacy.RST.11-12.3, CCSS.ELA-Literacy.RST.9-10.1, CCSS.ELA-Literacy.RST.9-10.2, CCSS.ELA-Literacy.RST.9-10.7, CCSS.ELA-Literacy.RST.9-10.8, CCSS.ELA-Literacy.RST.9-10.9")
        ListItem():Strong("Standards For Mathmatical Practice: "):Text("CCSS.Math.Practice.MP1, CCSS.Math.Practice.MP2, CCSS.Math.Practice.MP5, CCSS.Math.Practice.MP6, CCSS.Math.Practice.MP7, CCSS.Math.Practice.MP8, CCSS.Math.Content.HSF.IF.A.1")
    end

    private action Overview
        Section("Overview")
        Paragraph("In this assignment, you will write a program that plays music with a combination of notes and chords. This assignment allows you to create your own songs by combining single notes and chords. Create a new project and name it "):Strong("Challenge2_1"):Text(".")
        Paragraph("So far, you have focused on using the "):Code("Play"):Text(" feature in the "):Code("Music"):Text(" class to play single notes. This feature can also be used to play multiple notes at once, called chords. In this assignment, you will create a piece of music utilizing both single notes and chords to create a piece of music that lasts at least one minute.")
    end

    private action Task1
        Section("Task 1")
        Paragraph("To play chords in Quorum, you must use the "):Code("Chord"):Text(" type. To include this type for use in your program, use the following "):Code("use"):Text(" statement:")
        CodeExample("use Libraries.Sound.Chord")
        Paragraph("To create a chord, you might use code like the following. This code creates a C Major chord.")
        CodeExample("Chord c
c:Add(60)
c:Add(64)
c:Add(67)")
        Paragraph("Once the chord has been created make sure the chord is played.")
        Paragraph():Strong("Activity: Play chords in Quorum.")
    end

    private action Task2Analysis
        Section("Task 2: Analysis")
        BulletList()
        ListItem("Compose a piece of music consisting of notes and chords.")
        BulletList()
        ListItem("The piece of music must last at least one minute.")
        BulletList()
        ListItem("Use the "):Code("chord"):Text(" type.")
        Paragraph():Strong("Activity: Compose a piece of music consisting of notes and chords.")
    end

    private action SampleOutput
        Section("Sample Output")
        Paragraph("Your output should be a song of at least 1 minute in length. All students' outputs will be different, since you all have different creative inspirations!")
    end
end
