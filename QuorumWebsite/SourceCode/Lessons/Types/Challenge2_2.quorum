use Libraries.Web.Page.QuorumPage

/*
    Challenge 2.2: 3D Sound.
    Converted from the old Lesson page by plan 13's generator: the same
    words, now without Tailwind.
*/
class Challenge2_2 is QuorumPage

    on create
        SetLocation("lessons/chapter2/challenge2_2.html")
        // The name lists and links use, and the series and track it belongs
        // to: its section and picture.
        SetShortTitle("Challenge 2.2")
        // For search engines and link previews, and what lists of pages say.
        SetDescription("Learn about about how to code your own 3D sound-based jungle environment using the Quorum programming language.")
        SetSummary("how work 3D Sound in Quorum.")
    end

    action Setup
        SetWebPageTitle("Challenge 2.2: 3D Sound - Quorum Programming Language")
        Title("Challenge 2.2: 3D Sound")
        GoalsPart()
        ComputerSciencePrinciplesCurriculum()
        CommonCoreStandards()
        Overview()
        Goal1CreatingAndUsingObjects()
        SampleOutput()
    end

    private action GoalsPart
        Section("Goals")
        Paragraph("In this assignment, you will practice the following computer science concepts:")
        BulletList()
        ListItem("Creating and Using Objects")
    end

    private action ComputerSciencePrinciplesCurriculum
        Section("Computer Science Principles Curriculum")
        BulletList()
        ListItem():Strong("Big Idea: Creativity: "):Text("EU 1.1, LO 1.1.1, EK 1.1.1B, EU 1.2, LO 1.2.2, EK 1.2.2A, EK 1.2.2B")
    end

    private action CommonCoreStandards
        Section("Common Core Standards")
        BulletList()
        ListItem():Strong("Standards For Mathmatical Practice: "):Text("CCSS.Math.Practice.MP1, CCSS.Math.Practice.MP2, CCSS.Math.Practice.MP4, CCSS.Math.Practice.MP5, CCSS.Math.Practice.MP6, CCSS.Math.Practice.MP7, CCSS.Math.Practice.MP8")
    end

    private action Overview
        Section("Overview")
        Paragraph("In this assignment, you will write a program that simulates the sounds of a 3D environment. You will play sounds associated with a jungle, setting their positions in 3D space in order to create an "):DoubleQuote():Text("audio scene."):DoubleQuote():Text(" Download this "):Link("zip folder", "/files/lessons/chapter2/Challenge2_2Template.zip"):Text(" for a template to help you get started.")
    end

    private action Goal1CreatingAndUsingObjects
        Section("Goal 1: Creating and Using Objects")
        Paragraph("Open the provided template and navigate to the main.quorum file. There are five different sound files included in the project template. They contain sounds that represent birds, crickets, frogs, water, and wind. We will use these sounds and position them in 3D space to create the illusion of standing in the middle of a jungle.")
        Paragraph("Since there are five audio files, we need to create five "):Code("Audio"):Text(" objects. Before we can create the Audio objects, though, we must tell Quorum that we want access to the "):Code("Audio"):Text(" library by adding the "):Code("use"):Text(" statement for that library. Create the five "):Code("Audio"):Text(" objects and use the "):Code("Load"):Text(" action to load the audio files to those objects. Some of the audio files are louder than the others. We may want to adjust the volumes of the audio objects based on this. Adjusting the volume can also help make the sounds appear to be coming from further away. Experiment with different volumes to discover what sounds best.")
        Paragraph("In order to make the sounds appear to be coming from different points in space, we need to set their positions in a virtual 3D space that the Quorum Audio Library supports. Quorum "):Code("Audio"):Text(" objects have variables that help determine their positions in a virtual 3D space, including the x, y, and z coordinates of the sound. We can set the x, y, and z coordinates of the "):Code("Audio"):Text(" objects by using the "):Code("SetX"):Text(", "):Code("SetY"):Text(" and "):Code("SetZ"):Text(" actions on each of our "):Code("Audio"):Text(" objects.")
        Subsection("Example: Using the SetX, SetY, and SetZ action on an Audio Object")
        CodeExample("// this line sets the x position of our birds audio object.
// the sound will be coming from our right
birds:SetX(0.60)

// this line sets the y position of our birds audio object.
// the sound will be coming from above our heads
birds:SetY(0.9)

// this line sets the z position of our birds audio object
// the sound will be coming from slightly behind us
birds:SetZ(-0.2)")
        Paragraph("In the above example, we set the position of the bird sound. With respect to the x-axis, where a value of 0 represents the "):DoubleQuote():Text("middle"):DoubleQuote():Text(" of the scene, our bird sound will originate from the right of us, the listeners, in the scene. With respect to the y-axis, the bird sounds originate from near the top of the scene. This makes sense for birds, because birds live in trees and fly around, so bird chirping noises will come from above our head. With respect to the z-axis, our bird sounds will come from slightly behind us.")
        Paragraph():Strong("Activity: Set the x, y, and z positions for the other "):Code("Audio"):Strong(" objects")
        Paragraph("Set the 3D positions for the audio objects representing the crickets, frogs, water, and wind sounds. Set the positions in a way that makes sense for the scene. For example, the water sound should be coming from below us while the wind sound should be heard above our heads. The frogs sound may come from close to the water sound. Play around with different positions.")
    end

    private action SampleOutput
        Section("Sample Output")
        Paragraph("Each student may position his or her sounds differently, so each program will produce a unique overall sound.")
    end
end
