use Libraries.Web.Page.QuorumPage

/*
    Lab 2.1: Types.
    Converted from the old Lesson page by plan 13's generator: the same
    words, now without Tailwind.
*/
class Lab2_1 is QuorumPage
    // A double quote, for code and words that hold one.
    text dq = ""

    on create
        SetLocation("lessons/chapter2/lab2_1.html")
        // The name lists and links use, and the series and track it belongs
        // to: its section and picture.
        SetShortTitle("Lab 2.1")
        SetSectionName("Types")
        // For search engines and link previews, and what lists of pages say.
        SetDescription("Learn about declaring variables and concatenation in the Quorum programming language.")
        SetSummary("how types work in Quorum.")
    end

    action Setup
        dq = dq:GetDoubleQuote()
        SetWebPageTitle("Lab 2.1: Types - Quorum Programming Language")
        Title("Lab 2.1: Types")
        Types()
        Overview()
        ExampleDeclareAVariableWithTheIntegerTypeCalledM()
        ExampleConcatenation()
    end

    private action Types
        Section("Types")
        Subsection("Goals")
        Paragraph("The goal of this lab is to learn the following")
        BulletList()
        ListItem("Declaring variables")
        ListItem("Naming rules for variable declarations")
        ListItem("How to concatenate text using the + operator")
        Subsection("Computer Science Principles Curriculum")
        BulletList()
        ListItem():Strong("Big Idea: Programming: "):Text("EK 5.1.2B, EK 5.1.2E, EK 5.2.1F, EK 5.1.2J, EK 5.2.1C, EK 5.3.1D, EK 5.3.1I, EK 5.4.1")
        Subsection("Common Core Standards")
        BulletList()
        ListItem():Strong("English Language Arts Standards » Science & Technical Subjects: "):Text("CCSS.ELA-Literacy.RST.9-10.2, CCSS.ELA-Literacy.RST.9-10.3, CCSS.ELA-Literacy.RST.9-10.4, CCSS.ELA-Literacy.RST.9-10.5, CCSS.ELA-Literacy.RST.9-10.6, CCSS.ELA-Literacy.RST.11-12.2, CCSS.ELA-Literacy.RST.11-12.3")
        ListItem():Strong("Standards For Mathmatical Practice: "):Text("CCSS.Math.Practice.MP1, CCSS.Math.Practice.MP2, CCSS.Math.Practice.MP5, CCSS.Math.Practice.MP6, CCSS.Math.Practice.MP7, CCSS.Math.Practice.MP8")
        Subsection("Vocabulary")
        BulletList()
        ListItem("Projects window")
        ListItem("Quorum Studio Output window")
        ListItem("Editor")
        ListItem("Declare")
        ListItem("Initialize")
        ListItem("Variable type")
        ListItem("Integer")
        ListItem("Text")
        ListItem("Boolean")
        ListItem("Number")
        ListItem("Concatenation")
        Subsection("Hotkeys")
        BulletList()
        ListItem("Build Project")
        ListItem("Editor Window")
        ListItem("Output Window")
        ListItem("Projects Window")
        ListItem("Run Project")
        Paragraph("A list of Hotkeys can be found on the "):Link("Getting Started with Quorum Studio", "/tutorials/language/gettingStarted.html"):Text(" page if the online system is not being used for this lesson.")
    end

    private action Overview
        Section("Overview")
        Paragraph("This lab will guide you through declaring variables with the appropriate name, primitive data type and matching value. In addition to declaring variables you will also be learning the rules to name a variable and how to initialize them. Then, you will learn to use the say and output commands and how to concatenate using the "):DoubleQuote():Text("+"):DoubleQuote():Text(" operator. This lesson can be done online in the editors or offline in Quorum Studio. References to both are included.")
        Subsection("Goal 1: Declaring Variables")
        Paragraph("Start by opening Quorum Studio and creating a new project. In the New Project dialog, make sure "):DoubleQuote():Text("Quorum"):DoubleQuote():Text(" is selected in the Categories list. Then select the "):DoubleQuote():Text("Blank Application"):DoubleQuote():Text(" project in the Projects list and press Enter. On the next step, name the new project "):DoubleQuote():Text("Lab2_1"):DoubleQuote():Text(" in the Project Name text field. Press Enter or click the Finish button to create a new project. Before you begin writing any code, be sure to check the new project is the main project.")
        Paragraph("For this lab, you will use the following windows in Quorum Studio: 1) the Projects window, 2) the Quorum Studio Output window, and 3) the Editor. The Projects window holds a list of folders and files that allows you to organize and navigate the project. This is where source files and other files will be found. The Sodbeans Output window displays any compiler errors you may have and it displays any output statements executed during the programs runtime. Finally, the Editor window is where you will write your code.")
        Paragraph("There are four types of primitive data types that you can use in Quorum:")
        BulletList()
        ListItem():Code("integer"):Text(": a positive or negative number (including 0) that does not have a decimal. Examples: 1, 0, -10")
        ListItem():Code("number"):Text(": a numerical value with a decimal. Examples: 1.0, 0.0, -10.35")
        ListItem():Code("boolean"):Text(": a true/false value. Example: true, false")
        ListItem():Code("text"):Text(": a literal string/text value enclosed in quotes. Examples: "):DoubleQuote():Text("Hello World"):DoubleQuote():Text(", "):DoubleQuote():Text("5"):DoubleQuote():Text(", "):DoubleQuote():Text("true"):DoubleQuote()
        Paragraph("To initialize a variable, the format of the code is: "):Code("type variableName = value"):Text(".")
    end

    private action ExampleDeclareAVariableWithTheIntegerTypeCalledM
        Section("Example: Declare a variable with the integer type called myInteger")
        Paragraph("In the example below we declare a variable called myInteger with the "):Code("integer"):Text(" type and assign the variable the value of 4.")
        CodeExample("integer myInteger = 4")
        Paragraph("Whenever we initialize a variable we are doing three things:")
        BulletList()
        ListItem("reserving a location in memory of the type declared")
        ListItem("assigning a name to the memory location that we can use in our program")
        ListItem("storing a value in the memory location")
        CodeEditorWithCode("Activity: Declaring Variables", "// Assign the variable myText the value of 'Hello!'? to do the activity. Once this variable 
            is declared build your project and check for any compiler errors. 
            Nothing in the output window? Did you output your variable?")
        Subsection("Goal 2: Naming rules for variable declarations")
        Paragraph("Each variable has to have an unique name. If you want more than one variable to have similar names you should insert something to differentiate from the other.")
        Subsection("Example: Declare two variables with similar names")
        CodeExample("integer myInteger = 4
integer myInteger2 = 6")
        Paragraph("Notice that the names are similar but we add the 2 in the end to differentiate from the first one. The name of the variable must start with a letter, with can be upper or lower case. It can have more than one word in the name but it cannot have space between them. Camel case is a common format used for easy readability. Although it is not required, by convention, variable names usually begin with a lower case letter and class names usually start with a capital letter. The following is an example of this convention.")
        Subsection("Example: Declare variables using camel case")
        CodeExample("text myFirstText = " + dq + "Hi!?" + dq + "
boolean whatIsBoolean = true")
        Paragraph("There are some characters that you cannot use to name a variable. You cannot use a number or a symbol as the beginning of the name. In addition, you cannot use certain words that are reserved for specific functions in Quorum.")
        Subsection("Example: Declaring variables that break the naming rules")
        CodeExample("// This code generates an ERROR
number 2number = 4.6
boolean boolean = false")
        Paragraph("The message in the Output window should give you a clue as to what went wrong. In addition, Quorum will automatically display a line under the code that has an error so that you will know where something went wrong. Once all of the compiler errors are gone, run the program by going to Run -> Run Main Project or by pressing F6. When the project runs, nothing will be in the output window because all you have done is declared the variable.")
        CodeEditorWithCode("Activity: Declaring Similar Variables", "// Declare two variables of each type with similar names. Do not forget to follow the naming rules")
        Subsection("Goal 3: How to concatenate text using the + operator")
        Paragraph("Add more variables and types to the program. Do the following steps to add types:")
        BulletList()
        ListItem("Define an "):Code("integer"):Text(" type and assign it the name firstInteger. Assign 4 to firstInteger.")
        ListItem("Define a "):Code("number"):Text(" type and assign it the name secondNumber. Assign 8.9 to secondNumber.")
        ListItem("Define a "):Code("boolean"):Text(" type and assign it the name checkResult. Assign true to checkResult.")
        ListItem("Define a "):Code("text"):Text(" type and assign it the name quorumText. Assign "):DoubleQuote():Text(" You just wrote your first program. "):DoubleQuote():Text(" to quorumText.")
        CodeEditorWithCode("Activity: Adding more types", "// Complete adding the types")
        Paragraph("Now that you have defined these four new variables, have Quorum output and say each variable to the user.")
        Subsubsection("Example: Output and say the variable firstInteger to the user.")
        Paragraph("Use the following code as an example to output and say each of the variables that you just initialized.")
        CodeExample("output firstInteger
say firstInteger")
        Paragraph("Notice that each of the commands need a separate line, so for 4 variables we need 8 lines of code to output and say everything.")
        CodeEditorWithCode("Activity: Output and Say", "// Write for each variable one line to output the variable and one line to say it, as in the example above")
    end

    private action ExampleConcatenation
        Section("Example: Concatenation")
        Paragraph("You can use concatenation to combine two or more variables or phrases using the operator. The following code shows how to construct an output statement using concatenation:")
        CodeExample("output secondNumber + " + dq + " is greater than " + dq + " + firstInteger
say secondNumber + " + dq + " is greater than " + dq + " + firstInteger")
        Paragraph("When using text make sure you put space inside the quotes, otherwise there will not be the space between the last word and the variable or between the variable and the first word.")
        Paragraph("Now have your program output the following sentence using the variable names above:"):NewLine():Code("If the second number is 8.9 and the first number is 4, then checkResult is true.")
        CodeEditorWithCode("Activity: Putting it all together", "// Finish the lab")
        Paragraph("To check your output statement, change the value assigned to firstInteger to "):Code("10"):Text(" and checkResult to "):Code("false"):Text(" and then run your program again. If you wrote your output statement correctly, your program should display this line:"):NewLine():Code("If the second number is 8.9 and the first number is 10, then checkResult is false.")
        Paragraph("Once you have completed this, you are done! Show your work to the instructor.")
    end
end
