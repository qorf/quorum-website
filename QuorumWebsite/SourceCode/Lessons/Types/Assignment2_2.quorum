    private action Overview
        Section("Overview")
        Paragraph("In this assignment, you will write a program to compute the average of the distance a mouse runs during trials in an experiment. The experiment data is provided to calculate the average distance in terms of yards. In addition, you will write code to convert yards to different units of measurement. Create a new project and name it "):Strong("Assignment2_2"):Text(".")
    end

    private action Goal1UseATableToWriteMathCalculations
        Section("Goal 1: Use a table to write math calculations")
        Paragraph("An experiment was conducted to determine how far a mouse could run before encountering roadblocks or becoming exhausted. Six trials were conducted. The results of the experiment are shown in the table below:")
        Table("Trials and Distance")
        TableHeader():Cell("Trials"):Cell("Distance (yards)")
        TableRow():Cell("1"):Cell("98.2")
        TableRow():Cell("2"):Cell("85.4")
        TableRow():Cell("3"):Cell("76.7")
        TableRow():Cell("4"):Cell("64.4")
        TableRow():Cell("5"):Cell("89.9")
        TableRow():Cell("6"):Cell("82.5")
        Paragraph("Your program should add all of the trial distances together and compute the average distance in yards. The average is then converted into different measurement units. The table below shows the conversion of the yard into various units.")
        Table("Unit Conversion")
        TableHeader():Cell("Units"):Cell("Centimeters (cm)"):Cell("Feet (ft)"):Cell("Inches (in)"):Cell("Meters (m)"):Cell("Miles (mi)")
        TableRow():Cell("Yard (yd)"):Cell("91.44"):Cell("3"):Cell("36"):Cell("0.9144"):Cell("1/1760")
        Subsection("Example: Find the average distance in yards.")
        CodeExample("number totalDistance = 98.2 + 85.4 + 76.7 + 64.4 + 89.9 + 82.5
number aveYards = totalDistance/6
output aveYards")
        Paragraph("After you run the example you should have in the output window the number 82.85.")
        CodeEditorWithCode("Activity: Convert the average in yards to each of the provided units", "//(centimeters, feet, inches, meters, and miles)"):HideDisplay()
    end

    private action Goal2UseTheMathLibraryToCreateAnObjectAndRoundNu
        Section("Goal 2: Use the Math library to create an object and round numbers")
        BulletList()
        ListItem("Round each result to the nearest tenth. For this, you will need to use the "):Code("Math"):Text(" library. The "):Code("Math"):Text(" library requires the following "):Code("use"):Text(" statement:"):NewLine():Code("use Libraries.Compute.Math")
        Paragraph():Strong("Example: Round answers to the nearest tenth.")
        Paragraph("Use the example code below to create a "):Code("Math"):Text(" object. Then use the "):Code("Round"):Text(" action to round each answer to the nearest tenth. The number after the "):DoubleQuote():Text(","):DoubleQuote():Text(" is the number of decimal places you want the answer rounded to.")
        CodeExample("use Libraries.Compute.Math
Math math
number totalDistance = 98.2 + 85.4 + 76.7 + 64.4 + 89.9 + 82.5
number aveYards = math:Round(totalDistance/6, 1)
output aveYards")
        Paragraph("After you run the example you should have in the output window the number 82.9.")
        CodeEditorWithCode("Activity: Convert the average in yards to each of the provided units", "//(centimeters, feet, inches, meters, and miles)"):HideDisplay()
    end
end
