        ListItem("Use a table to write math calculations")
        ListItem("Use the Math library to create an object and round numbers")
    end

    private action ComputerSciencePrinciplesCurriculum
        Section("Computer Science Principles Curriculum")
        BulletList()
        ListItem():Strong("Big Idea: Data and Information: "):Text("EK 3.1.1A, EK 3.1.1B, EK 3.1.1D, EK 3.1.1E, EK 3.1.2A, EK 3.1.2B, EK 3.1.2C, EK 3.1.2D, EK 3.1.2E, EK 3.1.2F, EK 3.2.1A, EK 3.2.1B, EK 3.2.1C, EK 3.2.1F, EK 3.2.2A, EK 3.2.2B, EK 3.2.2C, EK 3.2.2G")
