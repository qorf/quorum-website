use Libraries.Web.Page.QuorumPage

/*
    Assignment 2.5: More Movement, Tones and L.E.D..
    Converted from the old Lesson page by plan 13's generator: the same
    words, now without Tailwind.
*/
class Assignment2_5 is QuorumPage
    // A double quote, for code and words that hold one.
    text dq = ""

    on create
        SetLocation("lessons/chapter2/assignment2_5.html")
        // The name lists and links use, and the series and track it belongs
        // to: its section and picture.
        SetShortTitle("Assignment 2.5")
        SetSectionName("Types")
        // For search engines and link previews, and what lists of pages say.
        SetDescription("Learn how to use tones, LED lights, and movement in LEGO Mindstorms robots using the Quorum programming language.")
        SetSummary("how work More Movement, Tones and L.E.D. in Quorum.")
    end

    action Setup
        dq = dq:GetDoubleQuote()
        SetWebPageTitle("Assignment 2.5: More Movement, Tones and L.E.D. - Quorum Programming Language")
        Title("Assignment 2.5: More Movement, Tones and L.E.D.")
        MoreMovementTonesAndLED()
        Overview()
        ExampleTurnTheRobot()
        ExamplePlayATone()
    end

    private action MoreMovementTonesAndLED
        Section("More Movement, Tones and L.E.D.")
        Subsection("Goals")
        Paragraph("In this assignment you will practice the following computer science concepts:")
        BulletList()
        ListItem("Creating Objects and Calling Actions on Objects")
        ListItem("Using the Quorum Lego Library to play tones and turn on the L.E.D.")
        Subsection("Computer Science Principles Curriculum")
        BulletList()
        ListItem():Strong("Big Idea: Creativity: "):Text("EU 1.2, LO 1.2.3, EK 1.2.3A, EU 1.3, LO 1.3.1, EK 1.3.1A")
        ListItem():Strong("Big Idea: Algorithms: "):Text("EU 4.1, LO 4.1.1, EK 4.1.1B")
        ListItem():Strong("Big Idea: Programming: "):Text("EU 5.1, LO 5.1.1, EK 5.1.1B, EU 5.2, LO 5.2.1, EK 5.2.1C, EK 5.2.1D")
        Subsection("Common Core Standards")
        BulletList()
        ListItem():Strong("English Language Arts Standards » Science & Technical Subjects: "):Text("CCSS.ELA-Literacy.RST.9-10.2, CCSS.ELA-Literacy.RST.9-10.3, CCSS.ELA-Literacy.RST.9-10.4, CCSS.ELA-Literacy.RST.9-10.5, CCSS.ELA-Literacy.RST.9-10.6, CCSS.ELA-Literacy.RST.11-12.2, CCSS.ELA-Literacy.RST.11-12.3, CCSS.ELA-Literacy.RST.9-10.1, CCSS.ELA-Literacy.RST.9-10.2, CCSS.ELA-Literacy.RST.9-10.7, CCSS.ELA-Literacy.RST.9-10.8, CCSS.ELA-Literacy.RST.9-10.9")
        ListItem():Strong("Standards For Mathmatical Practice: "):Text("CCSS.Math.Practice.MP1, CCSS.Math.Practice.MP2, CCSS.Math.Practice.MP5, CCSS.Math.Practice.MP6, CCSS.Math.Practice.MP7, CCSS.Math.Practice.MP8, CCSS.Math.Content.HSF.IF.A.1")
        Subsection("Vocabulary")
        BulletList()
        ListItem("Library")
        ListItem("Object")
        ListItem("Instantiation")
        ListItem("Action Call")
        ListItem("Parameters")
        ListItem("Parameter Passing")
        ListItem("Robot")
        ListItem("Motor")
        ListItem("Brick")
        ListItem("Port")
    end

    private action Overview
        Section("Overview")
        Paragraph("In this assignment you will write a program that combines the "):Code("RotateByDegrees"):Text("and the "):Code("RotateToDegree"):Text(" statements to make the robot move in a L shape and come back. At the same time you will make the tone and the L.E.D. color change when moving forward or rotating.")
        Subsection("Goal 1: Calling Actions on Objects")
        Paragraph("Begin by typing the appropriate code to use the "):Code("Motor"):Text(" library in the Quorum "):Code("Lego"):Text(" Library at the top of the file. Don’t forget to instantiate a new "):Code("Motor"):Text(" object called "):Code("motorControl"):Text(".")
        Paragraph("To move the robot in this assignment you will combine the "):Code("RotateToDegree"):Text(" and the "):Code("RotateByDegrees"):Text(" statements. Both of these actions work with two parameters, the name of the motor you want to rotate and the amount of degrees you want to rotate "):Strong("to"):Text(", or rotate "):Strong("by"):Text(". You will also need to remember to use the "):Code("Wait"):Text(" statement.")
        Paragraph("The difference between how these two actions work is:")
        BulletList()
        ListItem():Code("RotateByDegrees"):Text(" will add the new rotation on to it's current position and turn the motor as far as you specify. For example, if your motor has already been rotated one quarter turn and you issue a RotateByDegrees(90) instruction, the motor will now be rotated 180 degrees from it's original position.")
        BulletList()
        ListItem():Code("RotateToDegree"):Text(" will rotate the motor to an absolute position like a compass heading, regardless of its last position. For example, no matter what the position of the motor, a RotateToDegree(180) will move the motor to the due south position (one half turn from it's base position).")
    end

    private action ExampleTurnTheRobot
        Section("Example: Turn the robot")
        CodeExample("//This line sets the speed of the motor
//This value goes from 0 to 100 and max speed indicates two rotations per second with a full battery
//Let's set it to 50, or one rotation per second.
motorControl:SetSpeed(" + dq + "B" + dq + ", 50)
//This line of code tells the Motor object named motorControl
//that it should rotate the motor one full rotation (backward)
//Note: This does NOT turn the robot by 360 degrees backward, it turns the motor.
motorControl:RotateToDegree(" + dq + "B" + dq + ",-360)
//This line tells the program to wait the motor to finish the action
motorControl:Wait(" + dq + "B" + dq + ")")
        Subsection("Activity 1: Lift the robot arm using the small motor")
        Paragraph("After the robot is in it's position, use the RotateToDegree() action to raise the arm. Experiment with different positions.")
        Subsection("Activity 2: Turn the robot around and return to the starting position")
        Paragraph("In this activity, our goal is to tell the motor object that you want to move the motor C in the same way that we are moving motor B. We do this by using the "):Code("RotateToDegree"):Text(" command. After the turn, rotate your robot to head back over the same path it came from. When the robot is "):DoubleQuote():Text("home"):DoubleQuote():Text(" turn it back around to prepare to run it again. You can put tape or a mark on the floor to remember the position if it helps. You can use a whichever Rotate action you prefer to use. Lower the arm to it's starting position.")
        Subsection("Goal 2: Using the Quorum Lego Library to play tones and to turn on the L.E.D.")
        Paragraph("To play tones you will need to use the "):Code("Sound"):Text(" library in "):Code("Libraries.Lego"):Text(", so you need to include the use statement at the top of the file. The full path of the library is "):Code("Libraries.Robots.Lego.Sound"):Text(". After the library inclusion, you will need to instantiate a new "):Code("Sound"):Text(" object called "):Code("soundControl"):Text(".")
        Paragraph("Instantiate a new Sound object called soundControl.")
        CodeExample("Sound soundControl")
        Paragraph("To turn on the L.E.D. you will need to include the "):Code("Button"):Text(" library and instantiate a "):Code("Button"):Text(" object called "):Code("buttonControl"):Text(".")
    end

    private action ExamplePlayATone
        Section("Example: Play a tone")
        Paragraph("Once you have done this, you will use the "):Code("PlayTone"):Text(" statement to play the tones. The "):Code("PlayTone"):Text(" statement takes two parameters, frequency and duration.")
        Paragraph("You can change the frequency and duration of the tone. The frequency is between 200 and 20000 and different values will have different tones. You won't be able to hear differences between values that are too close to each other. Experiment with different tones to understand how they change.")
        Subsection("Example: Turn the L.E.D. green and solid")
        Paragraph("Use the "):Code("SetLightPattern"):Text(" statement to turn on the L.E.D. The "):Code("SetLightPattern"):Text(" statement takes one parameter, the pattern. The pattern that represents an orange and solid pattern is number 3. A list of the "):Link("patterns for the LED lights is located here", "/tutorials/robots/legoButtons.html"):Text(".")
        CodeExample("// This line turns on the L.E.D. 
buttonControl:SetLightPattern(1)")
        Subsection("Activity: Insert some sounds and lights into your code from Goal 1")
        Paragraph("Insert lines like these to play the tones and change lights at different points while your robot is moving. The instruction to play a tone when the robot is moving forward must be on the line before the commands to move forward and the line with a different tone must be on the line before of the commands to rotate.")
        Paragraph("To complete the activity, you must move the robot in the L shape again but now with the tones and the L.E.D. You can use the sounds and lights to mark the times when the robot is changing to a new instruction.")
        CodeExample("//This line plays a tone in a frequency of 820 Hertz with a duration of 200 milliseconds
//To give a reference, a frequency of 440 would be an " + dq + "A" + dq + " in music.
soundControl:PlayTone(820, 200)")
    end
end
