use Libraries.Web.Page.QuorumPage

/*
    Lab 2.4: Playing Audio.
    Converted from the old Lesson page by plan 13's generator: the same
    words, now without Tailwind.
*/
class Lab2_4 is QuorumPage
    // A double quote, for code and words that hold one.
    text dq = ""

    on create
        SetLocation("lessons/chapter2/lab2_4.html")
        // The name lists and links use, and the series and track it belongs
        // to: its section and picture.
        SetShortTitle("Lab 2.4")
        SetSectionName("Types")
        // For search engines and link previews, and what lists of pages say.
        SetDescription("Learn about creating objects and actions while coding an audio application in the Quorum programming language.")
        SetSummary("how work playing audio in Quorum.")
    end

    action Setup
        dq = dq:GetDoubleQuote()
        SetWebPageTitle("Lab 2.4: Playing Audio - Quorum Programming Language")
        Title("Lab 2.4: Playing Audio")
        PlayingAudio()
        Overview()
        ExampleAccessQuorum()
        Resources()
    end

    private action PlayingAudio
        Section("Playing Audio")
        Subsection("Goals")
        Paragraph("In this lab, we will learn the following computer science concepts:")
        BulletList()
        ListItem("Accessing the Quorum Standard Library")
        ListItem("Creating Objects")
        ListItem("Calling Actions on Objects")
        Subsection("Computer Science Principles Curriculum")
        BulletList()
        ListItem():Strong("Big Idea: Creativity: "):Text("EU 1.2, LO 1.2.1, EK 1.2.1A, EK 1.2.1B, EK 1.2.1C, EU 1.3, LO 1.3.1, EK 1.3.1A, EK 1.3.1B")
        ListItem():Strong("Big Idea: Programming: "):Text("EU 5.1, LO 5.1.1, EK 5.1.1A")
        Subsection("Common Core Standards")
        BulletList()
        ListItem():Strong("English Language Arts Standards » Science & Technical Subjects: "):Text("CCSS.ELA-Literacy.RST.9-10.2, CCSS.ELA-Literacy.RST.9-10.3, CCSS.ELA-Literacy.RST.9-10.4, CCSS.ELA-Literacy.RST.9-10.5, CCSS.ELA-Literacy.RST.9-10.7, CCSS.ELA-Literacy.RST.9-10.10, CCSS.ELA-Literacy.RST.11-12.2, CCSS.ELA-Literacy.RST.11-12.3, CCSS.ELA-Literacy.RST.11-12.4, CCSS.ELA-Literacy.RST.11-12.5")
        ListItem():Strong("Standards For Mathmatical Practice: "):Text("CCSS.Math.Practice.MP1, CCSS.Math.Practice.MP2, CCSS.Math.Practice.MP4, CCSS.Math.Practice.MP5, CCSS.Math.Practice.MP6, CCSS.Math.Practice.MP7, CCSS.Math.Practice.MP8")
        Subsection("Vocabulary")
        BulletList()
        ListItem("Library")
        ListItem("Instantiation")
        ListItem("Action Call")
        ListItem("Parameters")
        ListItem("Parameter Passing")
        ListItem("Samples")
        ListItem("OGG file extension")
        ListItem("WAV file extension")
    end

    private action Overview
        Section("Overview")
        Paragraph("This lab demonstrates the use of the "):Code("Audio"):Text(" library in Quorum. The "):Code("Audio"):Text(" library can be used to play music files in the "):Link(dq + ".ogg" + dq, "https://en.wikipedia.org/wiki/Ogg"):Text(" or the "):Link(dq + ".wav" + dq, "https://en.wikipedia.org/wiki/WAV"):Text(" formats. You will write a program that plays a music file that can be shared with classmates. Download this "):Link(dq + "zip file" + dq, "/files/lessons/chapter2/Lab2_4Template.zip"):Text(" for a template to help you get started. To open the template, follow these steps:")
        Paragraph("1. Download and extract the zip file")
        Paragraph("2. Open Quorum Studio")
        Paragraph("3. Under "):Strong("File"):Text(", click "):Strong("Open Project")
        Paragraph("4. Navigate to where you downloaded the zip file")
        Paragraph("5. Select your project and click "):Strong("Open Project")
        Paragraph("You may also use the online versions of the development environment to test your code. For this, we have stored the song file at media/song.ogg.")
        Subsection("Goal 1: Accessing the Quorum Standard Library")
        Paragraph("Open the provided template and navigate to the "):Strong("main.quorum"):Text(" file.")
        Paragraph("This assignment makes use of the Quorum "):Code("Audio"):Text(" Library in the Quorum Standard Library. You need to type code at the very top of the "):Strong("main.quorum"):Text(" file that lets Quorum know you want to use this library. Begin by typing the appropriate code to use the Quorum "):Code("Audio"):Text(" Library in your project. The "):Code("Audio"):Text(" Library is called "):Code("Libraries.Sound.Audio"):Text(".")
    end

    private action ExampleAccessQuorum
        Section("Example: Access Quorum")
        Paragraph():Strong("Example: Tell Quorum we want access to "):Code("Audio"):Strong(".")
        CodeExample("// this line tells Quorum we will use the Audio library
use Libraries.Sound.Audio")
        Paragraph("Any time you want to use a Quorum library, you need to include a statement like this at the top of your program code that lets Quorum know that you will be using that library.")
        Paragraph("In order to work with files, you also need to use the "):Code("File"):Text(" library. The "):Code("File"):Text(" library is called "):Code("Libraries.System.File"):Text(". Add a statement to your project that allows you to use the Quorum "):Code("File"):Text(" library, below the other "):Code("use"):Text("statement.")
        CodeEditorWithCode("Activity: Add Statement", "")
        Paragraph("You now are able to use these Quorum libraries in your program.")
        Subsection("Goal 2: Creating Object")
        Paragraph("To put the "):Code("Audio"):Text(" and "):Code("File"):Text(" libraries to use, instantiate a new "):Code("Audio"):Text(" object, calling it "):Code("audio"):Text(".")
        Paragraph():Strong("Example: Instantiate an "):Code("Audio"):Strong(" object.")
        CodeExample("// this creates an Audio object and calls it " + dq + "audio" + dq + "
Audio audio")
        Paragraph("Now, in order for the "):Code("Audio"):Text(" object to be able to play your song, it needs the file that contains the song. Create a new "):Code("File"):Text(" object, naming it "):Code("file"):Text(".")
        CodeEditorWithCode("Activity: Instantiate a File object", "")
        Paragraph("In order to use the "):Code("File"):Text(" object, you need to tell the "):Code("File"):Text(" object what file it is. Since this file will represent the sound file for your "):Code("Audio"):Text(" object, your file should be an audio file. Audio files save data that represents all the samples of a sound. The file formats that the Quorum "):Code("Audio"):Text(" Library supports are "):Link(dq + ".ogg" + dq, "https://en.wikipedia.org/wiki/Ogg"):Text(" or the "):Link(dq + ".wav" + dq, "https://en.wikipedia.org/wiki/WAV"):Text(" formats.")
        Paragraph("To set the name of your file, you use the "):Code("SetPath"):Text(" action. The "):Code("SetPath"):Text(" action takes a text parameter that represents the name of the file.")
        Paragraph():Strong("Example: Tell the "):Code("File"):Strong(" object the file path.")
        CodeExample("//This line of code sets the path in the file to media/song.ogg
file:SetPath(" + dq + "media/song.ogg" + dq + ")")
        Paragraph("Now that you have your file set up, you can now tell the "):Code("Audio"):Text(" object what to do. The "):Code("Audio"):Text(" object needs to load a file, the file you just set up! Use the "):Code("Load"):Text(" action to give the "):Code("Audio"):Text(" object the file you created in your program.")
        Paragraph():Strong("Example: Load the file to the "):Code("Audio"):Strong(" object.")
        CodeExample("//This line loads a file into the audio object
audio:Load(file)")
        Paragraph("You are now ready to play your audio file. You can do this by calling the "):Code("PlayUntilDone"):Text(" action for your "):Code("Audio"):Text(" object. The "):Code("PlayUntilDone"):Text(" plays your "):Code("Audio"):Text(" object until it is done, ensuring that your program does not end until the audio file is done playing.")
        CodeEditorWithCode("Activity: Call the PlayUntilDone Action", "")
        Paragraph("You can now run your program. There should be no errors, and your audio file should play. If your program does not compile, fix any errors and try again.")
        Subsection("Goal 3: Calling Actions on Objects")
        Paragraph("When playing audio files, you may want the audio to play in only the right ear or the left ear. You can do this in Quorum by calling the "):Code("SetBalance"):Text(" action on your "):Code("Audio"):Text(" object.")
        Paragraph("The "):Code("SetBalance"):Text(" action takes one parameter, a "):Code("number"):Text(" . The values for this "):Code("number"):Text(" can be between -1 and 1. Each has the following behavior:")
        BulletList()
        ListItem("A value of -1 sets the audio to play in only the left ear")
        ListItem("A value between -1 and 0 sets the audio to play from the left, moving increasingly to the left as the number gets closer to -1")
        ListItem("A value of 0 sets the audio to play in both ears")
        ListItem("A value between 0 and 1 sets the audio to play from the right, moving increasingly to the right as the number gets closer to 1")
        ListItem("A value of 1 sets the audio to play in only the right ear")
        Paragraph("0 is the default value for the balance of "):Code("Audio"):Text(" objects. If you never call the "):Code("SetBalance"):Text(" action, the audio will automatically play in both ears.")
        Paragraph():Strong("Example: Change the balance of your "):Code("Audio"):Strong(" object to the left ear.")
        CodeExample("// this line of code tells your audio object that its balance should be the 
// number you are passing to it.
audio:SetBalance(-1)")
        Paragraph("Play around with the balance options by changing the parameter of the "):Code("SetBalance"):Text(" action.")
        CodeEditorWithCode("Activity: Right Ear Only", "")
        Paragraph("You can compile and run your program to hear the differences.")
    end

    private action Resources
        Section("Resources")
        Paragraph("The music used for this lab is Beachfront Celebration by Kevin MacLeod (incompetech.com). Licensed under Creative Commons: By Attribution 3.0 License.")
    end
end
