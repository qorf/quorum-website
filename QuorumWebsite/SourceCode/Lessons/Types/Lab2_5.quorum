use Libraries.Web.Page.QuorumPage

/*
    Lab 2.5: Displaying an Image.
    Converted from the old Lesson page by plan 13's generator: the same
    words, now without Tailwind.
*/
class Lab2_5 is QuorumPage
    // A double quote, for code and words that hold one.
    text dq = ""

    on create
        SetLocation("lessons/chapter2/lab2_5.html")
        // The name lists and links use, and the series and track it belongs
        // to: its section and picture.
        SetShortTitle("Lab 2.5")
        SetSectionName("Chapter 2")
        // For search engines and link previews, and what lists of pages say.
        SetDescription("Learn about creating objects and actions while coding an image manipulation application in the Quorum programming language.")
        SetSummary("how work displaying an image in Quorum.")
    end

    action Setup
        dq = dq:GetDoubleQuote()
        SetWebPageTitle("Lab 2.5: Displaying an Image - Quorum Programming Language")
        Title("Lab 2.5: Displaying an Image")
        GoalsPart()
        ComputerSciencePrinciplesCurriculum()
        CommonCoreStandards()
        Vocabulary()
        Overview()
        Goal1AccessingTheQuorumStandardLibrary()
        Goal2CreatingObjects()
        Goal3CallingActionsOnObjects()
    end

    private action GoalsPart
        Section("Goals")
        Paragraph("In this lab, we will learn the following computer science concepts:")
        BulletList()
        ListItem("Accessing the Quorum Standard Library")
        ListItem("Creating Objects")
        ListItem("Calling Actions on Objects")
    end

    private action ComputerSciencePrinciplesCurriculum
        Section("Computer Science Principles Curriculum")
        BulletList()
        ListItem():Strong("Big Idea: Creativity: "):Text("EU 1.2, LO 1.2.1, EK 1.2.1A, EK 1.2.1B, EK 1.2.1C, EU 1.3, LO 1.3.1, EK 1.3.1A, EK 1.3.1C")
        ListItem():Strong("Big Idea: Programming: "):Text("EU 5.1, LO 5.1.1, EK 5.1.1A")
    end

    private action CommonCoreStandards
        Section("Common Core Standards")
        BulletList()
        ListItem():Strong("English Language Arts Standards » Science & Technical Subjects: "):Text("CCSS.ELA-Literacy.RST.9-10.2, CCSS.ELA-Literacy.RST.9-10.3, CCSS.ELA-Literacy.RST.9-10.4, CCSS.ELA-Literacy.RST.9-10.5, CCSS.ELA-Literacy.RST.9-10.6, CCSS.ELA-Literacy.RST.11-12.2, CCSS.ELA-Literacy.RST.11-12.3, CCSS.ELA-Literacy.RST.9-10.1, CCSS.ELA-Literacy.RST.9-10.2, CCSS.ELA-Literacy.RST.9-10.7, CCSS.ELA-Literacy.RST.9-10.8, CCSS.ELA-Literacy.RST.9-10.9")
        ListItem():Strong("Standards For Mathmatical Practice: "):Text("CCSS.Math.Practice.MP1, CCSS.Math.Practice.MP2, CCSS.Math.Practice.MP5, CCSS.Math.Practice.MP6, CCSS.Math.Practice.MP7, CCSS.Math.Practice.MP8,")
    end

    private action Vocabulary
        Section("Vocabulary")
        BulletList()
        ListItem("Library")
        ListItem("Object")
        ListItem("Instantiation")
        ListItem("Action Call")
        ListItem("Parameters")
        ListItem("Parameter Passing")
        ListItem("Pixels")
        ListItem("PNG file extension")
        ListItem("JPG file extension")
    end

    private action Overview
        Section("Overview")
        Paragraph("This lab demonstrates the use of the "):Code("Game"):Text(" library in Quorum. The "):Code("Game"):Text(" library can be used to display graphics to the screen, which is an important first step in making games. The Quorum Game Engine supports image files with the "):Link(dq + ".png" + dq, "https://en.wikipedia.org/wiki/Portable_Network_Graphics"):Text(" or the "):Link(dq + ".jpg" + dq, "https://en.wikipedia.org/wiki/JPEG"):Text(" file extensions. You will write a program that displays an image to the screen. This lab can be completed in Sodbeans or online. For Sodbeans, download this "):Link(dq + "zip file" + dq, "/files/lessons/chapter2/Lab2_5Template.zip"):Text(" for the template to help you get started. To open the template, follow these steps:")
        Paragraph("1. Download and extract the zip file")
        Paragraph("2. Open NetBeans")
        Paragraph("3. Under "):Strong("File"):Text(", click "):Strong("Open Project")
        Paragraph("4. Navigate to where you downloaded the zip file")
        Paragraph("5. Select your project and click "):Strong("Open Project")
        Paragraph("You may also use this IDE to write and test your code.")
        CodeEditorWithCode("Displaying an Image", "use Libraries.Game.Game

/*
    This is a default class for creating a game in Quorum. Note that the Main 
    action begins by calling StartGame(), which loads a window a game can 
    be displayed in. The action CreateGame is where the game should load any 
    assets, like images to be displayed, frames of animation, or sounds to be
    played. 
*/

class Main is Game

    /*
        This action, Main, starts our computer program. In Quorum, programs always
        begin from Main.
    */

    action Main
        StartGame()
    end

    /*
        This action sets up the default values for a game. For example, we might
        use the Libraries.Game.Graphics.Drawable class to load up an image or 
        a shape. Or, we might add a Libraries.Interface.Button for making something clickable
        or a Libraries.Interface.TextBox for gathering user input in a game.
    */

    action CreateGame
    end

    /*
        The update action is called on every " + dq + "frame" + dq + "of animation in a game. This
        action should be used to do operations on items. So, for example, we 
        might use this action to change frames of animation, to rotate items, 
        or to make creatures jump.
    */

    action Update(number seconds)
    end
end")
    end

    private action Goal1AccessingTheQuorumStandardLibrary
        Section("Goal 1: Accessing the Quorum Standard Library")
        Paragraph("Open the provided template and navigate to the "):Strong("main.quorum"):Text(" file.")
        Paragraph("This assignment makes use of the Quorum "):Code("Game"):Text(" Library in the Quorum Standard Library. You need to type the code to include these libraries at the very top of the "):Strong("main.quorum"):Text(" file, above the line that starts with "):Code("class Main is Game"):Text(" on line 11 of the file.")
        Paragraph("Begin by typing the appropriate code to use the Quorum Game Engine Libraries in your project. The "):Code("Drawable"):Text(" Library is called "):Code("Libraries.Game.Graphics.Drawable"):Text(" and is used to draw objects on the screen.")
        Subsection("Example: Tell Quorum you want access to graphics.")
        CodeExample("// this line tells Quorum we will be using the Graphics library to draw images to the screen
use Libraries.Game.Graphics.Drawable")
        Paragraph("Any time you want to use a Quorum library, you need to include a statement like this at the top of your program code that lets Quorum know that you will be using that library.")
        Paragraph("In order to work with files, you also need to use the "):Code("File"):Text(" library. The "):Code("File"):Text(" library is called "):Code("Libraries.System.File"):Text(". Add a statement to your project that allows you to use the Quorum "):Code("File"):Text(" library, below the other "):Code("use"):Text("statements.")
        Paragraph("You now are able to use these Quorum libraries in your program.")
    end

    private action Goal2CreatingObjects
        Section("Goal 2: Creating Objects")
        Paragraph("Look for the lines that look like the following around lines 19-20 of the file:")
        CodeExample("action CreateGame
end")
        Paragraph("You write your code between the line that starts with "):Code("action CreateGame"):Text(" and the line that starts with "):Code("end"):Text(".")
        Paragraph("To put the"):Code("Game"):Text(" and "):Code("File"):Text(" libraries to use, instantiate a new "):Code("Drawable"):Text(" object, calling it "):Code("bunny"):Text(". Add this code between the "):Code("action CreateGame"):Text(" line and the "):Code("end"):Text(" line.")
        Paragraph():Strong("Example: Instantiate an "):Code("Drawable"):Strong(" object.")
        CodeExample("action CreateGame
   // this line of code creates the Drawable object called " + dq + "bunny" + dq + "
   Drawable bunny
end")
        Paragraph("Now, in order for the "):Code("Drawable"):Text(" object to be able to display your image, it needs the file that contains the image. Create a new "):Code("File"):Text(" object, naming it "):Code("file"):Text(".")
        Paragraph("In order to use the "):Code("File"):Text(" object, you need to tell the "):Code("File"):Text(" object what file it is. Since this file will represent the image file for your "):Code("Drawable"):Text(" object, your file should be an image file. Image files save data that represent all the pixels of an image. The file formats that the Quorum Game Engine supports are "):Link(dq + ".png" + dq, "https://en.wikipedia.org/wiki/Portable_Network_Graphics"):Text(" or the "):Link(dq + ".jpg" + dq, "https://en.wikipedia.org/wiki/JPEG"):Text(" formats.")
        Paragraph("To set the name of your file, you use the "):Code("SetPath"):Text(" action. The "):Code("SetPath"):Text(" action takes a text parameter that represents the name of the file.")
        Paragraph():Strong("Example: Tell the "):Code("File"):Strong(" object the name of the file it should represent.")
        CodeExample("// this line of code tells the File object that the file it should
// represent is the file called " + dq + "media/bunny.png" + dq + "
file:SetPath(" + dq + "media/bunny.png" + dq + ")")
        Paragraph("Now that you have your file set up, you can tell the "):Code("Drawable"):Text(" object what to do. The "):Code("Drawable"):Text(" object needs to load a file, the file you just set up! Use the "):Code("Load"):Text(" action to give the "):Code("Drawable"):Text(" object the file you created in your program.")
        Paragraph():Strong("Example: Tell the "):Code("File"):Strong(" object the name of the file.")
        CodeExample("// this line of code passes the file you created and set the path to the bunny
// Drawable. The bunny now knows which image it should display.
bunny:Load(file)")
        Paragraph("You are now ready to display your image. You can do this by calling the "):Code("Add"):Text(" action, passing your "):Code("Drawable"):Text(" object as a parameter.")
        Paragraph():Strong("Activity: Add your bunny to the game by calling the "):Code("Add"):Strong(" action, passing it your bunny object.")
        Paragraph("You can now compile and run your program. There should be no errors and your image should display on the screen in a separate window. If your program does not compile, fix any errors and try again.")
    end

    private action Goal3CallingActionsOnObjects
        Section("Goal 3: Calling Actions on Objects")
        Paragraph("When displaying your image, you may have noticed that it was placed in the lower left-hand corner of the screen. You may want to change this position so that it can appear in another part of the screen. You can do this in Quorum by calling the"):Code("SetPosition"):Text(" action on your "):Code("Drawable"):Text(" object.")
        Paragraph("The "):Code("SetPosition"):Text(" action takes two parameters, both "):Code("number"):Text(" variables. These "):Code("number"):Text(" s represent coordinates that tell the "):Code("Drawable"):Text(" object where to appear on the screen. Coordinates of (0, 0) represent the lower left-hand corner of the screen. To move the image to the right, increase the x-coordinate (the first parameter). To move the image up, increase the y-coordinate (the second parameter).")
        Paragraph("The default values for the coordinates of the "):Code("Drawable"):Text(" object are (0, 0). If you never call the "):Code("SetPosition"):Text(" action, the "):Code("Drawable"):Text(" bject will automatically appear at the lower left corner of the screen.")
        Paragraph():Strong("Example: Change the position of the bunny "):Code("Drawable"):Strong(" on the screen.")
        CodeExample("// this line of code tells the bunny to appear at the location (500, 500) on the screen.
bunny:SetPosition(500, 500)")
        Paragraph("Play around with setting the position by changing the parameters of the "):Code("SetPosition"):Text(" action. What happens when the coordinates go off of the screen?")
        Paragraph("Compile and run your program again to see the change.")
    end
end
