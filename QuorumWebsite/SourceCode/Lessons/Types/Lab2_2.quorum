use Libraries.Web.Page.QuorumPage

/*
    Lab 2.2: Math, Output and User Input.
    Converted from the old Lesson page by plan 13's generator: the same
    words, now without Tailwind.
*/
class Lab2_2 is QuorumPage
    // A double quote, for code and words that hold one.
    text dq = ""

    on create
        SetLocation("lessons/chapter2/lab2_2.html")
        // The name lists and links use, and the series and track it belongs
        // to: its section and picture.
        SetShortTitle("Lab 2.2")
        SetSectionName("Change this later")
        // For search engines and link previews, and what lists of pages say.
        SetDescription("Learn about math and getting user input in the Quorum programming language.")
        SetSummary("how work math in Quorum.")
    end

    action Setup
        dq = dq:GetDoubleQuote()
        SetWebPageTitle("Lab 2.2: Math, Output and User Input - Quorum Programming Language")
        Title("Lab 2.2: Math, Output and User Input")
        GoalsPart()
        ComputerSciencePrinciplesCurriculum()
        CommonCoreStandards()
        Vocabulary()
        Overview()
    end

    private action GoalsPart
        Section("Goals")
        Paragraph("The goal of this lab is to learn the following:")
        BulletList()
        ListItem("Using basic mathematical operations in Quorum")
        ListItem("Getting input from the user")
    end

    private action ComputerSciencePrinciplesCurriculum
        Section("Computer Science Principles Curriculum")
        BulletList()
        ListItem():Strong("Big Idea: Abstraction: "):Text("EK 2.1.2C")
    end

    private action CommonCoreStandards
        Section("Common Core Standards")
        BulletList()
        ListItem():Strong("English Language Arts Standards » Science & Technical Subjects: "):Text("CCSS.ELA-Literacy.RST.9-10.2, CCSS.ELA-Literacy.RST.9-10.3, CCSS.ELA-Literacy.RST.9-10.4, CCSS.ELA-Literacy.RST.9-10.5, CCSS.ELA-Literacy.RST.9-10.7, CCSS.ELA-Literacy.RST.9-10.10, CCSS.ELA-Literacy.RST.11-12.2, CCSS.ELA-Literacy.RST.11-12.3, CCSS.ELA-Literacy.RST.11-12.4, CCSS.ELA-Literacy.RST.11-12.5")
        ListItem():Strong("Mathematics Content: High School Functions » Building Functions: "):Text("CCSS.Math.Content.HSF.BF.A1")
        ListItem():Strong("Standards For Mathmatical Practice: "):Text("CCSS.Math.Practice.MP1, CCSS.Math.Practice.MP2, CCSS.Math.Practice.MP4, CCSS.Math.Practice.MP5, CCSS.Math.Practice.MP6, CCSS.Math.Practice.MP7, CCSS.Math.Practice.MP8")
    end

    private action Vocabulary
        Section("Vocabulary")
        BulletList()
        ListItem("Operations")
        ListItem("Addition")
        ListItem("Subtraction")
        ListItem("Multiplication")
        ListItem("Division")
        ListItem("Modulus")
        ListItem("User Input")
    end

    private action Overview
        Section("Overview")
        Paragraph("In this lab you will write a program in Quorum that performs basic mathematical operations and solves written math problems. You will demonstrate how to work with numbers by performing addition, subtraction, multiplication, division, and remainder operations in Quorum. You will also learn how to get input from the users.")
        Subsection("Goal 1: Using basic mathematical operations in Quorum")
        Paragraph("You will concentrate on performing basic mathematical operations in Quorum. Then, you will move onto solving problem statements. Start by opening Sodbeans and creating a new blank Quorum project. Name the project Lab2_2.")
        Paragraph("Declare and initialize two "):Code("integer"):Text(" variables: a to 7 and b to 4. Next, declare and initialize two "):Code("number"):Text(" variables: c to 8.5 and d to 9.2. You will use these variables to perform mathematical operations and output the results to the Sodbeans Output window. We will start with addition, let's add a and b.")
        Subsubsection("Example: Assign the result of adding a and b to the variable sum1.")
        CodeExample("integer a = 7
integer b = 4
integer sum1 = a + b
output sum1")
        Paragraph("After you run the example you should have in the output window the number 11.")
        CodeEditorWithCode("Activity: Assign the result", "//Assign the result of adding a, b, c and d to the variable sum2. Do not forget to output your answer."):HideDisplay()
        Paragraph("If you are going to perform a mathematical operation that includes at least one number variable, your answer should also be a number. You will apply the same concepts to the other mathematical operations.")
        Paragraph("To perform the subtraction you will use the minus sign (-) and for multiplication you should use the asterisk (*). Output all your answers.")
        Paragraph("Now move onto division by dividing a by b and assigning the result in the variable called divide1.")
        Subsubsection("Example: Divide a by b and run the program.")
        CodeExample("integer divide1 = a/b
output divide1")
        Paragraph("Why was divide1 assigned the value of 1 when it should be 1.75? That happens because the variables are integers, so the result is going to be an integer. To see the difference, declare two new "):Code("number"):Text(" variables called e and f with the same values of a and b, respectively.")
        CodeEditorWithCode("Activity: Divide a by b.", "//You should have as output 1.75 if you declare the types correctly. Always run and output the operations."):HideDisplay()
        Paragraph("The final mathematical operation available in Quorum is the modulus or remainder. This is written using the keyword mod. You will use the "):Strong("mod"):Text(" operation to get the remainder of a division.")
        CodeExample("number remainder = 10 mod 6")
        Paragraph("In this example, remainder would contain the value of 4 because 10 divide by 6 equals 1 with the remainder of 4.")
        Subsubsection("Example: Using mod get the remainder of dividing c by b.")
        CodeExample("number remainder1 = c mod b 
output remainder1")
        Paragraph("You will have in the output window the value of 0.5. The example above shows that you can use mod with decimal numbers, but it is not usually done.")
        Paragraph("Let's wrap up what you have done with the mathematical operations. Write code that combines all four operations into one statement: addition, subtraction, multiplication and division. Name a variable result and perform the following operations:")
        CodeExample("(a + b) * (c - b) + (d / b) ")
        CodeEditorWithCode("Activity: Output the answer to the operations above.", "//Compute this answer for yourself, given the values you have assigned to the variables a, b, c, and d."):HideDisplay()
        Paragraph("Then, check your answer by adding another output statement for the result variable. The output for this operation should be 51.8.")
        Subsection("Goal 2: Getting input from the user")
        Paragraph("When you write programs, you don't always merely perform computation on data you already know, as in the first part of this lab. Most of the time, you need to get input from the user to perform your calculations. As an example, a desktop calculator is a program taking input from the user (via the keypad), and providing output (the answer to the equation you entered)")
        Paragraph("You may get input from the user in Quorum using the input keyword. The code below asks the user for their name; inside the parenthesis, you tell the user what information you are requesting.")
        Subsubsection("Example: Ask and output the user name.")
        CodeExample("text name = input(" + dq + "Please enter your first name:" + dq + ")
output name")
        Paragraph("When you run this program, "):DoubleQuote():Text("Please enter your name."):DoubleQuote():Text(" will appear in the output window. Enter your name and press Enter, or click the "):DoubleQuote():Text("OK"):DoubleQuote():Text(" button. Your name will appear in the output window.")
        Paragraph("It can do more than ask for input such as a name. You can also request numerical values. Let's create a second input statement that asks us to enter an integer value. The code should look something like the following:")
        CodeExample("text ageInput = input(" + dq + "How old are you?" + dq + ")")
        Paragraph("Notice, input will always be of type "):Code("text"):Text(". However, you can convert the "):Code("text"):Text(" value of the "):Code("ageInput"):Text(" variable to any other type you desire, such as "):Code("integer"):Text(" or "):Code("number"):Text(". You do this using the "):Code("cast"):Text(" statement, as below. Here, you desire to have the age as a whole number, so you will use the "):Code("integer"):Text(" type.")
        CodeExample("integer age = cast(integer, ageInput)")
        CodeEditorWithCode("Activity: Write the code to speak the age result.", "//It should say " + dq + "Hi," + dq + " followed by the name entered by the user."):HideDisplay()
        Paragraph("Next, concatenate on the words, "):DoubleQuote():Text("you are "):DoubleQuote():Text(" followed by the age variable and finally the words "):DoubleQuote():Text(" years old."):DoubleQuote()
    end
end
