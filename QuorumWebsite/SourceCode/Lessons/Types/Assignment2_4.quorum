use Libraries.Web.Page.QuorumPage

/*
    Assignment 2.4: Tortoise vs. the Hare.
    Converted from the old Lesson page by plan 13's generator: the same
    words, now without Tailwind.
*/
class Assignment2_4 is QuorumPage
    // A double quote, for code and words that hold one.
    text dq = ""

    on create
        SetLocation("lessons/chapter2/assignment2_4.html")
        // The name lists and links use, and the series and track it belongs
        // to: its section and picture.
        SetShortTitle("Assignment 2.4")
        SetSectionName("Chapter 2")
        // For search engines and link previews, and what lists of pages say.
        SetDescription("Create a tortoise and the hare racing game while learning the Quorum programming language.")
        SetSummary("how work Tortoise vs. the Hare in Quorum.")
    end

    action Setup
        dq = dq:GetDoubleQuote()
        SetWebPageTitle("Assignment 2.4: Tortoise vs. the Hare - Quorum Programming Language")
        Title("Assignment 2.4: Tortoise vs. the Hare")
        GoalsPart()
        ComputerSciencePrinciplesCurriculum()
        CommonCoreStandards()
        Overview()
        UnderstandingTheProvidedTemplate()
        Goal1CallingActionsOnObjects()
    end

    private action GoalsPart
        Section("Goals")
        Paragraph("In this assignment we will practice the following computer science concepts:")
        BulletList()
        ListItem("Calling Actions on Objects")
    end

    private action ComputerSciencePrinciplesCurriculum
        Section("Computer Science Principles Curriculum")
        BulletList()
        ListItem():Strong("Big Idea: Creativity: "):Text("EU 1.2, LO 1.2.3, EK 1.2.3A")
        ListItem():Strong("Big Idea: Algorithms: "):Text("EU 4.1, LO 4.1.1, EK 4.1.1B")
        ListItem():Strong("Big Idea: Programming: "):Text("EU 5.2, LO 5.2.1, EK 5.2.1A, EK 5.2.1B, EK 5.2.1C, EK 5.2.1D, EK 5.2.1E, EK 5.2.1F")
    end

    private action CommonCoreStandards
        Section("Common Core Standards")
        BulletList()
        ListItem():Strong("English Language Arts Standards » Science & Technical Subjects: "):Text("CCSS.ELA-Literacy.RST.9-10.2, CCSS.ELA-Literacy.RST.9-10.3, CCSS.ELA-Literacy.RST.9-10.4, CCSS.ELA-Literacy.RST.9-10.5, CCSS.ELA-Literacy.RST.9-10.7, CCSS.ELA-Literacy.RST.9-10.10, CCSS.ELA-Literacy.RST.11-12.2, CCSS.ELA-Literacy.RST.11-12.3, CCSS.ELA-Literacy.RST.11-12.4, CCSS.ELA-Literacy.RST.11-12.5")
        ListItem():Strong("Mathematics Content: High School Geometry » Congruence: "):Text("CCSS.Math.Content.HSG.CO.12, CCSS.Math.Content.HSG.CO.13")
        ListItem():Strong("Mathematics Content: High School Geometry » Modeling with Geometry: "):Text("CCSS.Math.Content.HSG.MG.1, CCSS.Math.Content.HSG.MG.3")
        ListItem():Strong("Standards For Mathmatical Practice: "):Text("CCSS.Math.Practice.MP1, CCSS.Math.Practice.MP2, CCSS.Math.Practice.MP4, CCSS.Math.Practice.MP5, CCSS.Math.Practice.MP6, CCSS.Math.Practice.MP7, CCSS.Math.Practice.MP8")
    end

    private action Overview
        Section("Overview")
        Paragraph("In this assignment, you will write a program that plays a simple race between a tortoise and a hare. You will tell the tortoise and the hare where to run to during the race. Download this "):Link("zip folder", "/files/lessons/chapter2/Assignment2_4Template.zip"):Text(" for a template to help you get started.")
    end

    private action UnderstandingTheProvidedTemplate
        Section("Understanding the Provided Template")
        Paragraph("Open the provided template and navigate to the "):Strong("main.quorum"):Text(" file.")
        Paragraph("There is an action already defined for you. This action begins on the line that starts with "):Code("action Update(number seconds)"):Text(". This action updates your game window on each frame of the game.")
        Paragraph("Here is what the action looks like in its entirety on lines 44 through 47.")
        CodeExample("action Update(number seconds)
 hare:Update(seconds)
 tortoise:Update(seconds)
end")
        Paragraph("You write your code to move the tortoise and the hare around the race track in the action labeled "):Code("action CreateGame"):Text(". You can find this action starts on line 18 through line 22.")
        Paragraph("Here is what the action looks like, on lines 34 through 35.")
        CodeExample("action CreateGame
end")
    end

    private action Goal1CallingActionsOnObjects
        Section("Goal 1: Calling Actions on Objects")
        Paragraph("Navigate to the CreateGame action on line 18. You write your code here. The first thing you need to do is to set up the background and "):Code("Sprite"):Text(" objects for the race.")
        Paragraph():Strong("Example: Load and add the background "):Code("Drawable"):Strong(".")
        CodeExample("racetrack:Load(" + dq + "racetrack.png" + dq + ")
Add(racetrack)")
        Paragraph():Strong("Activity: Load and add the tortoise and hare "):Code("Sprite"):Strong(" objects.")
        Paragraph("Once you load and add the objects, you can set the initial position. This is done using the "):Code("SetInitialPosition"):Text(" action, passing the starting coordinates. Since the race starts at the bottom left corner, or (0, 0), this should be the initial position.")
        Paragraph():Strong("Example: Set the initial position for the hare "):Code("Sprite"):Strong(".")
        CodeExample("// this line of code tells the hare that its initial position is the coordinate (0, 0)
hare:SetInitialPosition(0, 0)")
        Paragraph():Strong("Activity: Set the initial position for the tortoise.")
        Paragraph("Once you have set up your "):Code("Sprite"):Text(" objects, give each a speed by using the "):Code("SetSpeed"):Text(" actions. The "):Code("SetSpeed"):Text(" action takes a "):Code("number"):Text(" parameter to set as the speed. The speed of the "):Code("Sprite"):Text(" objects is represented by how many pixels they will move across the screen in a second. This means that if the number you pass is too small, then you may have a hard time noticing the movement. If the value is too large, your image will appear to jump across the screen rather than have a smooth movement. Good values to choose are between 50 and 300.")
        Paragraph():Strong("Example: Set the speed for the hare by calling "):Code("SetSpeed(number)"):Strong(".")
        CodeExample("//This gives your hare an initial speed of 100 pixels per second
hare:SetSpeed(100)")
        Paragraph():Strong("Activity: Set the speed for the tortoise.")
        Paragraph("Your "):Code("Sprite"):Text(" objects are now ready to begin racing! But they need to be told where to go. The race is to go counter-clockwise starting from the lower left corner to the lower right corner, to the upper right corner, to the upper left corner, and back to the bottom left corner.Tell the "):Code("Sprite"):Text(" objects which coordinates to move to by using a series of "):Code("MoveTo(x, y)"):Text(" commands, passing the x and y coordinates of the screen location they should run to.")
        Paragraph():Strong("Example: Tell the hare and tortoise "):Code("Sprite"):Strong(" objects to go to the position (1440, 770).")
        CodeExample("// this line tells the hare to move to the coordinate (1440, 0)
hare:MoveTo(1440, 0)
// this line tells the tortoise to move to the coordinate (1440, 0)
tortoise:MoveTo(1440, 0)")
        Paragraph():Strong("Activity: Write the additional "):Code("MoveTo"):Strong(" commands to finish the race.")
        Paragraph("The "):Code("MoveTo"):Text(" actions take place in the order you give them in your program, so you should give them in the correct order so that the race goes in the proper direction for the tortoise and hare. Make sure that the tortoise and hare do not go off the screen and that they do not cut across the grassy part of the track. They should stick to the rectangular dirt border along the edge of the screen.")
        Paragraph("You can now compile and run your program. The race should pop up in a separate window. If there are any errors, fix them and try again.")
    end
end
