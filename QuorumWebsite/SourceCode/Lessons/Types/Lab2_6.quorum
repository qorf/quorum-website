use Libraries.Web.Page.QuorumPage

/*
    Lab 2.6: Moving the Robot.
    Converted from the old Lesson page by plan 13's generator: the same
    words, now without Tailwind.
*/
class Lab2_6 is QuorumPage
    // A double quote, for code and words that hold one.
    text dq = ""

    on create
        SetLocation("lessons/chapter2/lab2_6.html")
        // The name lists and links use, and the series and track it belongs
        // to: its section and picture.
        SetShortTitle("Lab 2.6")
        SetSectionName("Types")
        // For search engines and link previews, and what lists of pages say.
        SetDescription("Learn about creating objects and actions while coding an LEGO Robotics application in the Quorum programming language.")
        SetSummary("how work moving the Robot in Quorum.")
    end

    action Setup
        dq = dq:GetDoubleQuote()
        SetWebPageTitle("Lab 2.6: Moving the Robot - Quorum Programming Language")
        Title("Lab 2.6: Moving the Robot")
        MovingTheLegoRobot()
        Overview()
        LargeMotors()
    end

    private action MovingTheLegoRobot
        Section("Moving the Lego Robot")
        Subsection("Goals")
        Paragraph("In this lab, we will learn the following computer science concepts:")
        BulletList()
        ListItem("Accessing the Quorum Standard Library")
        ListItem("Creating Objects and Calling Actions on Objects")
        Subsection("Computer Science Principles Curriculum")
        BulletList()
        ListItem():Strong("Big Idea: Creativity: "):Text("EU 1.2, LO 1.2.1, EK 1.2.1A, EK 1.2.1B, EU 1.3, LO 1.3.1, EK 1.3.1E")
        ListItem():Strong("Big Idea: Programming: "):Text("EU 5.1, LO 5.1.1, EK 5.1.1A, EK 5.1.1C")
        Subsection("Common Core Standards")
        BulletList()
        ListItem():Strong("English Language Arts Standards » Science & Technical Subjects: "):Text("CCSS.ELA-Literacy.RST.9-10.2, CCSS.ELA-Literacy.RST.9-10.3, CCSS.ELA-Literacy.RST.9-10.4, CCSS.ELA-Literacy.RST.9-10.5, CCSS.ELA-Literacy.RST.9-10.7, CCSS.ELA-Literacy.RST.9-10.10, CCSS.ELA-Literacy.RST.11-12.2, CCSS.ELA-Literacy.RST.11-12.3, CCSS.ELA-Literacy.RST.11-12.4, CCSS.ELA-Literacy.RST.11-12.5")
        ListItem():Strong("Standards For Mathmatical Practice: "):Text("CCSS.Math.Practice.MP1, CCSS.Math.Practice.MP2, CCSS.Math.Practice.MP4, CCSS.Math.Practice.MP5, CCSS.Math.Practice.MP6, CCSS.Math.Practice.MP7, CCSS.Math.Practice.MP8")
        Subsection("Vocabulary")
        BulletList()
        ListItem("Library")
        ListItem("Object")
        ListItem("Instantiation")
        ListItem("Action Call")
        ListItem("Parameters")
        ListItem("Parameter Passing")
        ListItem("Robot")
        ListItem("Motor")
        ListItem("Brick")
        ListItem("Port")
    end

    private action Overview
        Section("Overview")
        Paragraph("This lab demonstrates the use of the"):Code("Lego"):Text(" library in Quorum. The "):Code("Lego"):Text(" library can be used to control every part of the robot but in this lab we’re going to use just the motor part. You will write a program that moves forward the robot and rotate the robot 360 degrees while the third motor not connected to the wheels will keep working the whole time. Before you start with the programming part you need to build the robot, in all the lessons we use the EV3MEG, you can find the tutorial on "):Link(dq + "Lego website" + dq, "http://www.lego.com/en-us/mindstorms/build-a-robot/ev3meg"):Text(". If you never worked with robots or if you don't remember how it works you should read this tutorial before start:")
        Subsection("Goal 1: Accessing the Quorum Standard Library")
        Paragraph("You will start by creating a new blank Robot project. Name the project "):Strong("Lab2_6"):Text(". Open the "):Strong("main.quorum"):Text(" file in the editor.")
        Paragraph("This assignment makes use of the Quorum "):Code("Motor"):Text(" Library in the Quorum "):Code("Lego"):Text(" Library. You will need to type code at the beginning of the "):Strong("main.quorum"):Text(" file that lets Quorum know you want to use this library. Begin by typing the appropriate code to use the Quorum "):Code("Lego"):Text(" Library in your project. The "):Code("Lego"):Text(" Library is called "):Code("Libraries.Robots.Lego"):Text(". To use the "):Code("Motor"):Text(" Library inside the "):Code("Lego"):Text(" Library you add .Motor add the end.")
        Paragraph():Strong("Example: Tell Quorum we want access to "):Code("Motor"):Strong(".")
        CodeExample("// this line tells Quorum to use the Motor library
use Libraries.Robots.Lego.Motor")
        Paragraph("You must include a statement like this at the top of the file every time you want to use a Quorum library.")
        Subsection("Goal 2: Creating Objects and Calling Actions on Objects")
        Paragraph("To be able to call actions that are in the "):Code("Motor"):Text(" library, instantiate a new "):Code("Motor"):Text(" object, calling it "):Code("motorControl"):Text(".")
        Paragraph():Strong("Example: Instantiate a "):Code("Motor"):Strong(" object.")
        CodeExample("// this line creates (instantiates) a new Motor object called motor
Motor motorControl")
        Paragraph("Now you can call actions to send commands to the motors. To do that you will use the "):Code("RotateByDegrees"):Text(" command that has two parameters, the name of the motor you want to activate and the number of degrees you want to rotate the motor. After you send a movement command to a motor you should use the "):Code("Wait"):Text(" command after to allow the motor time to complete its action before the next action begins.")
    end

    private action LargeMotors
        Section("Large Motors")
        Paragraph("We will start with the large motors, which are most frequently used for moving the wheels. For these examples we have the right motor plugged into port "):DoubleQuote():Text("B"):DoubleQuote():Text(" and the left motor plugged into port "):DoubleQuote():Text("C."):DoubleQuote():Text(" This simple example code will move the robot forward 5 turns and then move it backward 5 turns.")
        Subsection("Example: Moving the Robot Forward and Backward")
        CodeExample("// We use our motorControl object to issue instructions to the motor
//First, set the speed of the motor as a number between 0 and 100, which represents the 
//percentage of power applied to the motor. If your robot is 
//low on power, or doing too many other things, speed may be affected.
motorControl:SetSpeed(" + dq + "B" + dq + ", 50)
motorControl:SetSpeed(" + dq + "C" + dq + ", 50)
//Next, tell the motors to move forward using degrees.
//Use a variable to represent one full revolution of 360 degrees.
integer turn = 360
motorControl:RotateByDegrees(" + dq + "B" + dq + ", turn * 5)
motorControl:RotateByDegrees(" + dq + "C" + dq + ", turn * 5)
//After a motor instruction, you must also tell Quorum to wait to complete the movement.
motorControl:Wait(" + dq + "B" + dq + ")
motorControl:Wait(" + dq + "C" + dq + ")")
        Paragraph():Strong("Activity: Move the robot backward")
        Paragraph("Expand the program you started to move the robot back to its starting position.")
        Paragraph("(Hint: a positive number moved the motors forward.)")
        Subsubsection("Small Motor")
        Paragraph("We can use the small motor with the same basic commands. For this example, the small motor is in port "):DoubleQuote():Text("A"):DoubleQuote():Text(". Our robot is configured to raise and lower an arm, but the basic code concept will work on other robot builds.")
        CodeExample("// First set the speed of the motor
motorControl:SetSpeed(" + dq + "A" + dq + ", 50)
// Move the small motor 90 degrees (one quarter turn)
motorControl:RotateByDegrees(" + dq + "A" + dq + ", 90)
motorControl:Wait(" + dq + "A" + dq + ") ")
        Paragraph():Strong("Activity: Move the small motor on your own")
        Paragraph("Experiment with ways to move your motor by changing speeds, degrees, and executing several commands in a row. For example, raise and then lower an arm, or open or close pincers, if that is how your robot is built.")
    end
end
