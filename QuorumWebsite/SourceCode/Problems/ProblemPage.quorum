use Libraries.Web.Page.QuorumPage
use Libraries.Web.Page.Division
use Libraries.Web.Page.Heading
use Libraries.Web.Page.Paragraph
use Libraries.Web.Page.StrongText
use Libraries.Web.Page.Link
use Libraries.Web.Page.Button
use Libraries.Web.Page.WebTag
use Libraries.Containers.Array
use Libraries.Containers.Iterator
use Libraries.Web.Problem
use Libraries.Web.Problems
use Libraries.Web.Styles.QuorumSiteOptions

/*
    One practice problem (problems/<set>/<problem>.html): the problems in
    its set as numbered steps, the problem, the block editor with its code,
    a hint and Previous, Check (or Hint) and Next. Check compares the
    program's output with the answer and says whether it is right.
    Converted from the old Lesson page by plan 13 (phase 6): the same words
    and ids, now without Tailwind; its parts start hidden with the hidden
    attribute, which Check removes.
*/
class ProblemPage is QuorumPage
    QuorumSiteOptions quorumOptions
    Problem problem = undefined
    text answerElement = "answerElement"
    text hasAnswerElement = "hasAnswerElement"
    text hintElement = "hintElement"

    // Check (or Hint): shows the hint, and when the problem has an answer,
    // whether the console's output (after "Build Successful") matches it.
    constant text CHECK_SCRIPT = "
var hint = document.getElementById('hintElement');
hint.hidden = false;
hint.setAttribute('aria-disabled', 'false');
const element = document.getElementById('hasAnswerElement');
const value = element.textContent.trim().toLowerCase();
const hasAnswer = value === 'true';
var remove = 'Build Successful';
var console = document.getElementById('QuorumUIOutput').textContent;
if(console !== null) {
    console = console.substring(remove.length);
}
var correct = document.getElementById('answerElement').textContent;
var wrong = document.getElementById('wrongAnswerElement');
var right = document.getElementById('rightAnswerElement');
if(hasAnswer) {
    if(console === correct) {
        wrong.hidden = true;
        wrong.setAttribute('aria-disabled', 'true');
        right.hidden = false;
        right.setAttribute('aria-disabled', 'false');
    } else {
        wrong.hidden = false;
        wrong.setAttribute('aria-disabled', 'false');
        right.hidden = true;
        right.setAttribute('aria-disabled', 'true');
    }
}
"

    action Setup
        SetWebPageTitle("Learn Quorum - Quorum Programming Language")
        ColorBanner("Do Practice Problems in Quorum", "Learn code through small examples.", "media/userInterface/quorumAssets/learnHeader.png", "Two cartoon rabbits wearing glasses. The rabbit on the left is holding a game controller, while the rabbit on the right is holding up a paper with a pie chart on it.")
        if problem = undefined
            return now
        end
        Problems problems = problem:GetProblems()

        // "Actions Problems": the set's name, capitalized.
        text title = problems:GetTitle()
        text firstLetter = title:GetSubtext(0, 1)
        firstLetter = firstLetter:ToUpperCase()
        Section(firstLetter + title:GetSubtext(1) + " Problems")
        Steps("Problems")
        integer i = 0
        Iterator<Problem> iterator = problems:GetProblemIterator()
        repeat while iterator:HasNext()
            Problem next = iterator:Next()
            Step("" + (i + 1), next:GetId(), next:GetId() + ".html", i = problem:GetIndex())
            i = i + 1
        end

        Section(problem:GetTitle())
        // The description is HTML (paragraphs, code, links), written as it
        // is, as the old page did.
        Division description
        description:AddText(problem:GetDescription())
        Include(description)
        Section("Coding:")
        i = 1
        repeat while i < problem:GetCodeSize()
            BlockEditorFile(problem:GetCodeName(i), problem:GetCode(i))
            i = i + 1
        end
        BlockEditor("Main.quorum", problem:GetMainCode(), problem:GetTray(), true, true)

        Include(MakeHint())
        Include(MakeButtons())
        Include(MakeAnswer())
        Include(MakeHasAnswer())
    end

    // Whether the problem has an answer to check against, for the script.
    private action MakeHasAnswer returns Division
        Division division
        division:SetIdentifier(hasAnswerElement)
        division:AddAttribute("hidden", "")
        division:AddAttribute("aria-disabled", "true")
        Array<text> answers = problem:GetAnswer()
        if answers:IsEmpty()
            division:AddText("false")
        else
            division:AddText("true")
        end
        return division
    end

    // The hint, hidden until Check: a dark blue heading over the hint, with
    // "Great job!" or "Try again" above it once checked.
    private action MakeHint returns Division
        Division division
        division:SetIdentifier(hintElement)
        division:AddAttribute("hidden", "")
        division:AddAttribute("aria-disabled", "true")
        division:SetTabIndex("0")
        Division heading
        SetStyle(heading, quorumOptions:GetHintHeading())
        Heading words
        words:SetScale(2)
        words:AddText("Hint")
        heading:AddNestedTag(words)
        division:AddNestedTag(heading)

        Division hintDivision
        SetStyle(hintDivision, quorumOptions:GetHintBody())
        Paragraph right
        StrongText rightWords
        rightWords:AddText("Great job!")
        right:AddNestedTag(rightWords)
        right:SetIdentifier("rightAnswerElement")
        right:AddAttribute("hidden", "")
        right:AddAttribute("aria-disabled", "true")
        hintDivision:AddNestedTag(right)
        Paragraph wrong
        StrongText wrongWords
        wrongWords:AddText("Try again")
        wrong:AddNestedTag(wrongWords)
        wrong:SetIdentifier("wrongAnswerElement")
        wrong:AddAttribute("hidden", "")
        wrong:AddAttribute("aria-disabled", "true")
        hintDivision:AddNestedTag(wrong)
        Paragraph hint
        hint:AddText(problem:GetHint())
        hintDivision:AddNestedTag(hint)
        division:AddNestedTag(hintDivision)
        return division
    end

    // The answer, one line each, hidden: what the script compares with.
    private action MakeAnswer returns Division
        Division division
        division:SetIdentifier(answerElement)
        division:AddAttribute("hidden", "")
        division:AddAttribute("aria-disabled", "true")
        Array<text> answers = problem:GetAnswer()
        integer i = 0
        repeat while i < answers:GetSize()
            text answer = answers:Get(i)
            answer = answer + answer:GetLineFeed()
            division:AddText(answer)
            i = i + 1
        end
        return division
    end

    // Previous (unavailable on the first problem), Check (Hint when there
    // is no answer to check), and Next (the problems page after the last).
    private action MakeButtons returns Division
        Division row
        SetStyle(row, quorumOptions:GetProblemButtonsBox())
        SetLayout(row, quorumOptions:GetProblemButtons())

        Link previousButton
        SetButtonLook(previousButton)
        previousButton:AddText("Previous")
        previousButton:SetAddress("")
        Problem previousProblem = problem:GetPreviousProblem()
        if previousProblem not= undefined
            previousButton:SetAddress(previousProblem:GetId() + ".html")
        else
            previousButton:AddAttribute("aria-disabled", "true")
        end

        Link nextButton
        SetButtonLook(nextButton)
        Problem nextProblem = problem:GetNextProblem()
        if nextProblem not= undefined
            nextButton:SetAddress(nextProblem:GetId() + ".html")
            nextButton:AddText("Next")
        else
            nextButton:SetAddress("/problems.html")
            nextButton:AddText("Problems Page")
        end

        Button checkButton
        SetButtonLook(checkButton)
        Array<text> answers = problem:GetAnswer()
        if answers:IsEmpty()
            checkButton:AddText("Hint")
        else
            checkButton:AddText("Check")
        end
        checkButton:SetOnClick(CHECK_SCRIPT)

        row:AddNestedTag(previousButton)
        row:AddNestedTag(checkButton)
        row:AddNestedTag(nextButton)
        return row
    end

    // A light blue button, faded while unavailable (aria-disabled).
    private action SetButtonLook(WebTag button)
        SetStyle(button, quorumOptions:GetProblemButton())
        SetStyleWhenUnavailable(button, quorumOptions:GetProblemButtonUnavailable())
    end

    action GetProblem returns Problem
        return problem
    end

    // The problem, and the page's address and descriptions from it.
    action SetProblem(Problem problem)
        me:problem = problem
        SetLocation("problems/" + problem:GetProblems():GetId() + "/" + problem:GetId() + ".html")
        SetShortTitle(problem:GetTitle())
        SetSectionName("Practice Problems")
        SetDescription(problem:GetTitle())
        SetSummary(problem:GetDescription())
    end
end
