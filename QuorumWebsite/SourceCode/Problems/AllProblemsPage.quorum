use Libraries.Web.Page.QuorumPage
use Libraries.Containers.Array
use Libraries.Web.Problems

/*
    The practice problems page (problems.html): a card for each set of
    problems, linked to its page. Converted from the old Lesson page by
    plan 13 (phase 6): the same words, now without Tailwind.
*/
class AllProblemsPage is QuorumPage
    ProblemGenerator generator = undefined

    on create
        SetLocation("problems.html")
        SetShortTitle("Page for working problems")
        SetDescription("Try doing practice problems in the Quorum programming language.")
        SetSummary("Problem page")
    end

    action Setup
        SetWebPageTitle("Learn Quorum - Quorum Programming Language")
        ColorBanner("Do Practice Problems in Quorum", "Learn code through small examples.", "media/userInterface/quorumAssets/learnHeader.png", "Two cartoon rabbits wearing glasses. The rabbit on the left is holding a game controller, while the rabbit on the right is holding up a paper with a pie chart on it.")
        Array<Problems> allProblems = generator:GetAllProblemsArray()
        if allProblems:IsEmpty()
            return now
        end

        Section("Practice Problems")
        Paragraph("Work through small problems of increasing difficulty.")
        CourseCards()
        integer i = 0
        repeat while i < allProblems:GetSize()
            Problems problems = allProblems:Get(i)
            text picture = ""
            text pictureDescription = ""
            if problems:GetImage() not= undefined
                picture = "problems/" + problems:GetId() + "/" + problems:GetImage()
                pictureDescription = problems:GetAlternativeDescription()
            end
            CourseCard(problems:GetTitle(), problems:GetDefaultLink(), picture, pictureDescription, problems:GetDescription())
            CourseCardLink("View Problems", problems:GetDefaultLink())
            i = i + 1
        end
    end

    action GetGenerator returns ProblemGenerator
        return generator
    end

    action SetGenerator(ProblemGenerator generator)
        me:generator = generator
    end
end
