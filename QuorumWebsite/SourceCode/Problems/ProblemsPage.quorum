use Libraries.Web.Page.QuorumPage
use Libraries.Containers.Iterator
use Libraries.Web.Problems
use Libraries.Web.Problem

/*
    A set of practice problems (problems/<set>.html): a card for each
    problem, linked to its page. Converted from the old Lesson page by plan
    13 (phase 6): the same words, now without Tailwind.
*/
class ProblemsPage is QuorumPage
    Problems problems = undefined

    action Setup
        SetWebPageTitle("Learn Quorum - Quorum Programming Language")
        ColorBanner("Do Practice Problems in Quorum", "Learn code through small examples.", "media/userInterface/quorumAssets/learnHeader.png", "Two cartoon rabbits wearing glasses. The rabbit on the left is holding a game controller, while the rabbit on the right is holding up a paper with a pie chart on it.")
        if problems = undefined
            return now
        end

        Section(problems:GetTitle())
        Paragraph(problems:GetDescription())
        // Each problem as a numbered row: its title and Practice (design B;
        // the descriptions are on the problems' own pages).
        NumberedRows()
        Iterator<Problem> iterator = problems:GetProblemIterator()
        repeat while iterator:HasNext()
            Problem problem = iterator:Next()
            NumberedRow(problem:GetTitle(), problems:GetId() + "/" + problem:GetId() + ".html", "Practice")
        end
    end

    action GetProblems returns Problems
        return problems
    end

    // The set, and the page's address and descriptions from it.
    action SetProblems(Problems problems)
        me:problems = problems
        SetLocation("problems/" + problems:GetId() + ".html")
        SetShortTitle(problems:GetTitle())
        SetDescription(problems:GetDescription())
        SetSummary(problems:GetDescription())
    end
end
