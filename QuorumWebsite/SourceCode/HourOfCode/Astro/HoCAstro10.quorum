use Libraries.Web.Page.QuorumPage

/*
    Astronomy Hour of Code.
    Converted from the old Lesson page by plan 13's generator: the same
    words, now without Tailwind.
*/
class HoCAstro10 is QuorumPage
    // A double quote, for code and words that hold one.
    text dq = ""

    on create
        SetLocation("hourofcode/astro10.html")
        // The name lists and links use, and the series and track it belongs
        // to: its section and picture.
        SetShortTitle("Part 10: Turning a text value to an integer")
        SetSectionName("Astronomy")
        // For search engines and link previews, and what lists of pages say.
        SetDescription("Try an accessible astronomy themed Hour of Code in the Quorum programming language.")
        SetSummary("Accessible astronomy themed Hour of Code")
    end

    action Setup
        dq = dq:GetDoubleQuote()
        SetWebPageTitle("Astronomy Hour of Code Activity 10 | Quorum Programming Language")
        Title("Astronomy Hour of Code")
        Paragraph("Activity 10: Turning a text value to an integer")
        Instructions()
        ExplorationChallengeOptional()
    end

    private action Instructions
        Section("Instructions:")
        Paragraph("The type of a variable can sometimes be changed to another type. For example, we might want to turn a text value, like "):DoubleQuote():Text("5"):DoubleQuote():Text(" to an integer value, like 5. In order to do this, we have to use the "):Strong("cast"):Text(" command and then tell the computer a) what type to convert the variable to and b) which variable to convert.")
        Paragraph("The cast command looks like this:")
        Paragraph():Emphasis("integer value = cast(integer, " + dq + "5" + dq):Text(")")
        Paragraph("When we ask the user a question using the "):Strong("input"):Text(" command, the type of the user's response is always "):Strong("text"):Text(", so if we want to use input from a user in a numeric formula, we must convert it to a number first. To complete this activity, ask the user to enter an integer and store the value in an "):Strong("integer"):Text(" variable called "):Strong("value"):Text(" and then "):Strong("output"):Text(" the variable "):Strong("value"):Text(". The first line will look like this:")
        CodeExample("integer minutes = cast(integer, input(" + dq + "How many minutes: " + dq + "))")
        Paragraph("Next, turn the minutes into seconds by multiplying minutes by seconds like this:")
        CodeExample("integer seconds = minutes * 60")
        Paragraph("On the final line, use the "):Strong("output"):Text(" command to display the user's answer:")
        CodeExample("output seconds")
        Paragraph("When you are ready, select the green Run Program button below the editor on the right (second in the tab order).")
    end

    private action ExplorationChallengeOptional
        Section("Exploration Challenge (Optional):")
        Paragraph("Add code to get values for hours and seconds from the user like you did for minutes. Then output the total in a user friendly format like: "):Emphasis("There are 6503 seconds in 1 hours and 48 minutes and 23 seconds."):Text(" (Hint: you will have to be careful to make sure you do not write over the user's response for seconds when you calculate the total seconds.)")
        CodeEditor("Type your code below...", "hourofcode/astro/code10.quorum")
    end
end
