use Libraries.Web.Page.QuorumPage

/*
    Astronomy Hour of Code.
    Converted from the old Lesson page by plan 13's generator: the same
    words, now without Tailwind.
*/
class HoCAstro14 is QuorumPage
    // A double quote, for code and words that hold one.
    text dq = ""

    on create
        SetLocation("hourofcode/astro14.html")
        // The name lists and links use, and the series and track it belongs
        // to: its section and picture.
        SetShortTitle("Part 14: Astronomy - Learn About Declination")
        SetSectionName("Astronomy")
        // For search engines and link previews, and what lists of pages say.
        SetDescription("Try an accessible astronomy themed Hour of Code in the Quorum programming language.")
        SetSummary("Accessible astronomy themed Hour of Code")
    end

    action Setup
        dq = dq:GetDoubleQuote()
        SetWebPageTitle("Astronomy Hour of Code Activity 14 | Quorum Programming Language")
        Title("Astronomy Hour of Code")
        Paragraph("Activity 14: Astronomy - Learn About Declination")
        Instructions()
        ExplorationChallengeOptional()
    end

    private action Instructions
        Section("Instructions:")
        Paragraph("The other measure that we need to point our telescope is called Declination, which is comparable to latitude. Declination is measured in degrees and can be a maximum of 90 degrees for the north pole to -90 degrees to the south pole. A line straight out from the center of the earth through the equator is 0 degrees. In this activity, we will collect the value for Declination from the user and store the value in a number variable and then output the answer. We'll use it later for our virtual telescope.")
        Paragraph("The code should look like this:")
        CodeExample("number declination = cast(number, input(" + dq + "Enter declination in degrees: " + dq + "))
output " + dq + "Declination: " + dq + " + declination")
        Paragraph("When you are ready, select the green Run Program button below the editor on the right (second in the tab order).")
    end

    private action ExplorationChallengeOptional
        Section("Exploration Challenge (Optional):")
        Paragraph("When we perform division on integers, if the dividend does not divide evenly by the divisor there is a remainder. In computer programming, if we want to get the value of the remainder, we use the modulus operator, which in Quorum is: "):Strong("mod"):Text(". So if we divide 10 by 3 using the division operator "):Strong("(10 / 3)"):Text(" we get 3. If we use the modulus operator instead "):Strong("(10 mod 3)"):Text(" we get the remainder 1. Write code to use these operators with "):Strong("integer"):Text(" variables. What will the modulus be if the numbers divide evenly?")
        CodeEditor("Type your code below...", "hourofcode/astro/code14.quorum")
    end
end
