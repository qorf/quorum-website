use Libraries.Web.Page.QuorumPage

/*
    Astronomy Hour of Code.
    Converted from the old Lesson page by plan 13's generator: the same
    words, now without Tailwind.
*/
class HoCAstro12 is QuorumPage
    // A double quote, for code and words that hold one.
    text dq = ""

    on create
        SetLocation("hourofcode/astro12.html")
        // The name lists and links use, and the series and track it belongs
        // to: its section and picture.
        SetShortTitle("Part 12: Astronomy - Learn About Right Ascension")
        SetSectionName("Astronomy")
        // For search engines and link previews, and what lists of pages say.
        SetDescription("Try an accessible astronomy themed Hour of Code in the Quorum programming language.")
        SetSummary("Accessible astronomy themed Hour of Code")
    end

    action Setup
        dq = dq:GetDoubleQuote()
        SetWebPageTitle("Astronomy Hour of Code Activity 12 | Quorum Programming Language")
        Title("Astronomy Hour of Code")
        Paragraph("Activity 12: Astronomy - Learn About Right Ascension")
        Instructions()
        ExplorationChallengeOptional()
    end

    private action Instructions
        Section("Instructions:")
        Paragraph("Now it is time to take our computer knowledge to learn about Right Ascension, which is a set of numbers that tells a telescope how much to rotate when you are telling it where to point. In this activity, we will collect these numbers and "):Strong("output"):Text(" the values to start. Right Ascension is a measure of rotation, like longitude, and it is measured in hours, minutes and seconds from a fixed zero point on the celestial equator where the Sun crosses the celestial equator at the March equinox.")
        Paragraph("A full rotation is equivalent to one rotation of the earth in a 24 hour period, so a Right Ascension of 24h 0m 0s is one full circle. The variables "):DoubleQuote():Text("hours"):DoubleQuote():Text(" and "):DoubleQuote():Text("minutes"):DoubleQuote():Text(" are always whole numbers, so they are of type "):Strong("integer"):Text(" but "):DoubleQuote():Text("seconds"):DoubleQuote():Text(" can have a decimal place so it is of type "):Strong("number"):Text(". Ask the user for values for variables named "):Strong("hours"):Text(", "):Strong("minutes"):Text(" and "):Strong("seconds"):Text(" and then "):Strong("output"):Text(" the answers each on separate lines with 3 "):Strong("output"):Text(" statements. Your solution should have 6 lines of code. To get you started, here is the first line:")
        CodeExample("integer hours = cast(integer, input(" + dq + "Enter hours: " + dq + "))")
        Paragraph("On the next line, use the "):Strong("output"):Text(" command to display the variable's value. We can combine a text string with a variable name using the "):Strong("+"):Text(" operator to output a nicely formatted answer, like this:")
        CodeExample("output " + dq + "Hours: " + dq + " + hours")
        Paragraph("Remember that in astronomy calculation "):Strong("minutes"):Text(" has to be an "):Strong("integer"):Text(" and "):Strong("seconds"):Text(" has to be a "):Strong("number"):Text(".")
    end

    private action ExplorationChallengeOptional
        Section("Exploration Challenge (Optional):")
        Paragraph("When you write a computer program for other people to use, you will often want to check the user's input to make sure it makes sense for your computer program. In this case, if a user enters a number over 24 or less than 0 when your program asks for hours, it does not make sense for our calculation. If you want to be sure that the user's input is correct you can use an "):Link("if / else", "https://quorumlanguage.com/tutorials/language/if.html"):Text(" statement to decide if you should output an answer or give an error message. For this Exploration Challenge, create a conditional statement in your code that either outputs the hours or an error message. If you want to go further, put the error checking code in a "):Link("repeat", "https://quorumlanguage.com/tutorials/language/repeat.html"):Text(" loop so that the program keeps asking the user for input until the input is valid.")
        CodeEditor("Type your code below...", "hourofcode/astro/code12.quorum")
    end
end
