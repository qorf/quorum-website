use Libraries.Web.Page.QuorumPage

/*
    Astronomy Hour of Code.
    Converted from the old Lesson page by plan 13's generator: the same
    words, now without Tailwind.
*/
class HoCAstro8 is QuorumPage
    // A double quote, for code and words that hold one.
    text dq = ""

    on create
        SetLocation("hourofcode/astro8.html")
        // The name lists and links use, and the series and track it belongs
        // to: its section and picture.
        SetShortTitle("Part 8: Conditional Statements")
        SetSectionName("Astronomy")
        // For search engines and link previews, and what lists of pages say.
        SetDescription("Try an accessible astronomy themed Hour of Code in the Quorum programming language.")
        SetSummary("Accessible astronomy themed Hour of Code")
    end

    action Setup
        dq = dq:GetDoubleQuote()
        SetWebPageTitle("Astronomy Hour of Code Activity 8 | Quorum Programming Language")
        Title("Astronomy Hour of Code")
        Paragraph("Activity 8: Conditional Statements")
        Instructions()
        ExplorationChallengeOptional()
    end

    private action Instructions
        Section("Instructions:")
        Paragraph("Now we are going to use a "):Strong("boolean"):Text(" variable in our program to make a decision about what we want the program to do next. In programming, we call these kind of statements "):DoubleQuote():Text("conditional statements"):DoubleQuote():Text(" and we use them to control the branch we take in our program. In Quorum we use an "):Strong("if"):Text(" statement to start a conditional, followed by a "):Strong("boolean"):Text(" condition to be evaluated. If we want to check the status of the dome in the observatory, we will use the following conditional statement for our next line of code.")
        CodeExample("if domeIsOpen")
        Paragraph("If the condition "):Strong("domeIsOpen"):Text(" is "):Strong("true"):Text(", then whatever code we put on the next lines will be executed by the computer. For now, let's just "):Strong("output"):Text(" a message notifying the user that the dome of the observatory is open. We often indent the next lines to make our code easier to read so that we can quickly see that this line will only be executed if the condition is "):Strong("true"):Text(".")
        CodeExample("    output " + dq + "Dome is open. Ready to take images." + dq)
        Paragraph("Now if the dome is not open, we need to tell the computer what alternative instructions to execute. This statement is optional and you don't have to include it if you are not going to do anything if the condition is "):Strong("false"):Text(". The statement is only one word, "):Strong("else"):Text(", and we will include it without indenting it since it is not part of the "):Strong("true"):Text(" condition statements. In our case, we want to "):Strong("output"):Text(" a different message so we are going to use it.")
        CodeExample("else")
        Paragraph("For now, let's "):Strong("output"):Text(" a message to notify the user that the dome of the observatory is closed, and let's indent this line to make it easier to read.")
        CodeExample("    output " + dq + "Dome is closed. Telescope is not ready to take images." + dq)
        Paragraph("Finally, to close the if statement, we need to tell the computer that the block is finished. we do this with the word "):Strong("end"):Text(".")
        CodeExample("end")
        Paragraph("When you are ready, select the green Run Program button below the editor on the right (second in the tab order).")
    end

    private action ExplorationChallengeOptional
        Section("Exploration Challenge (Optional):")
        Paragraph("Change the value of the "):Strong("domeIsOpen"):Text(" variable using one of the two methods you learned in the last Exploration Challenge so that the "):Strong("else"):Text(" branch of your conditional statement is executed and the computer outputs: "):Emphasis("Dome is closed. Telescope is not ready to take images.")
        CodeEditor("Type your code below...", "hourofcode/astro/code8.quorum")
    end
end
