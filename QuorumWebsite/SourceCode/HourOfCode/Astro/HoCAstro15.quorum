use Libraries.Web.Page.QuorumPage

/*
    Astronomy Hour of Code.
    Converted from the old Lesson page by plan 13's generator: the same
    words, now without Tailwind.
*/
class HoCAstro15 is QuorumPage
    // A double quote, for code and words that hold one.
    text dq = ""

    on create
        SetLocation("hourofcode/astro15.html")
        // The name lists and links use, and the series and track it belongs
        // to: its section and picture.
        SetShortTitle("Part 15: Playing an Audio File from the Server")
        SetSectionName("Astronomy")
        // For search engines and link previews, and what lists of pages say.
        SetDescription("Try an accessible astronomy themed Hour of Code in the Quorum programming language.")
        SetSummary("Accessible astronomy themed Hour of Code")
    end

    action Setup
        dq = dq:GetDoubleQuote()
        SetWebPageTitle("Astronomy Hour of Code Activity 15 | Quorum Programming Language")
        Title("Astronomy Hour of Code")
        Paragraph("Activity 15: Playing an Audio File from the Server")
        Instructions()
        ExplorationChallengeOptional()
    end

    private action Instructions
        Section("Instructions:")
        Paragraph("Now we are going to learn how to add sounds to our program. Audio can be very useful to provide the user feedback about what the computer is doing, particularly to non-sighted users. To begin, we are just going to create an "):Strong("Audio"):Text(" object, load a sound and then play it. Before we can start working with Audio objects though, we need to tell the compiler where to find the object in a library. In Quorum, the library is located at "):Strong("Libraries.Sound.Audio"):Text(" and we reference it with the "):Strong("use"):Text(" command. We always need to put the "):Strong("use"):Text(" commands at the top of the program before we try to reference any objects in the library. So, the first statement in our program should look like this:")
        CodeExample("use Libraries.Sound.Audio")
        Paragraph("Next, we will create an "):Strong("Audio"):Text(" object by declaring it, similar to how we created a variable with a type and a name. Let's create an "):Strong("Audio"):Text(" object called "):Strong("clicksound"):Text(" like this:")
        CodeExample("Audio clickSound")
        Paragraph("Before we can do anything with the "):Strong("clickSound"):Text(" object, we need to load an audio file into it. We do that with the "):Strong("Load"):Text(" command. We call the "):Strong("Load"):Text(" command by putting a "):DoubleQuote():Text(":"):DoubleQuote():Text(" after the name of the object and typing "):Strong("Load"):Text(" with the path of the file in parenthesis. There is a sound called "):Strong("click.wav"):Text(" on the webserver located at the path "):Strong(dq + "media/astro/" + dq):Text(" so to load it into the "):Strong("clickSound"):Text(" object, we can use this command:")
        CodeExample("clickSound:Load( " + dq + "media/astro/click.wav" + dq + ")")
        Paragraph("Now all we have to do is tell the sound to play. To do that, we can call the "):Strong("Play"):Text(" action of our "):Strong("Audio"):Text(" object. If we call an action on an object it always needs to have parenthesis after the name of the action and the action name is capitalized, like this:")
        CodeExample("clickSound:Play()")
        Paragraph("When you are done, click the green Run Program button and listen to the sound.")
    end

    private action ExplorationChallengeOptional
        Section("Exploration Challenge (Optional):")
        Paragraph("For this Exploration Challenge, put the Play() statement in a repeat loop to play the audio more than once. If you want to make your program more interactive, get input from the user to ask how many times the sound should play.")
        CodeEditor("Type your code below...", "hourofcode/astro/code15.quorum")
    end
end
