use Libraries.Web.Page.QuorumPage

/*
    Astronomy Hour of Code.
    Converted from the old Lesson page by plan 13's generator: the same
    words, now without Tailwind.
*/
class HoCAstro17 is QuorumPage
    // A double quote, for code and words that hold one.
    text dq = ""

    on create
        SetLocation("hourofcode/astro17.html")
        // The name lists and links use, and the series and track it belongs
        // to: its section and picture.
        SetShortTitle("Part 17: Loading a Skybox")
        SetSectionName("Astronomy")
        // For search engines and link previews, and what lists of pages say.
        SetDescription("Try an accessible astronomy themed Hour of Code in the Quorum programming language.")
        SetSummary("Accessible astronomy themed Hour of Code")
    end

    action Setup
        dq = dq:GetDoubleQuote()
        SetWebPageTitle("Astronomy Hour of Code Activity 17 | Quorum Programming Language")
        Title("Astronomy Hour of Code")
        Paragraph("Activity 17: Loading a Skybox")
        Instructions()
        ExplorationChallengeOptional()
    end

    private action Instructions
        Section("Instructions:")
        Subsection("(Advanced Lesson)")
        Paragraph("In this activity, we are going to load up a skybox in the game engine. A skybox is basically a cube with image files on each of the 6 faces of the cube with a camera in the center. The viewpoint for the game user is through the camera.")
        Paragraph("Note that this lesson is not accessible for unsighted users since the output will be displayed visually, but we will add accessibility in the next lesson. We have left the audio sound from the previous lesson so you can hear when the skybox is loaded.")
        Paragraph("The first thing that we need to do is load the 6 images for the faces of the cube for the skybox. We do this by calling the "):Strong("Load"):Text(" action of the skybox object and give it the file names of images for the right, left, top, bottom, front and back of the skybox in that order.")
        Paragraph("The image files we will use for this first skybox are:")
        CodeExample(dq + "media/astro/right.jpg" + dq + "
" + dq + "media/astro/left.jpg" + dq + "
" + dq + "media/astro/top.jpg" + dq + "
" + dq + "media/astro/bottom.jpg" + dq + "
" + dq + "media/astro/front.jpg" + dq + "
" + dq + "media/astro/back.jpg" + dq)
        Paragraph("So our first line of code in the "):Strong("CreateGame"):Text(" action will look like this:")
        CodeExample("skybox:Load(" + dq + "media/astro/right.jpg" + dq + ", " + dq + "media/astro/left.jpg" + dq + ", " + dq + "media/astro/top.jpg" + dq + ", " + dq + "media/astro/bottom.jpg" + dq + ", " + dq + "media/astro/front.jpg" + dq + ", " + dq + "media/astro/back.jpg" + dq + ")")
        Paragraph("Then to display the skybox around the camera, we just need to call the "):Strong("SetSkybox"):Text(" command like this:")
        CodeExample("SetSkybox(skybox)")
        Paragraph("When you are done, click the green Run Program button and the skybox will come up. You can't move around and do anything yet, but you the front image should be displayed.")
    end

    private action ExplorationChallengeOptional
        Section("Exploration Challenge (Optional):")
        Paragraph("For this Exploration Challege, experiment with the actions that you can call from the reference page on the "):Link("Skybox", "https://quorumlanguage.com/Libraries/Game/Graphics/Skybox.html"):Text(" class. Try to use the "):Strong("Rotate()"):Text(" or "):Strong("InvertSkybox()"):Text(" actions to see what happens.")
        CodeEditor("Type your code below...", "hourofcode/astro/code17.quorum")
    end
end
