use Libraries.Web.Page.QuorumPage

/*
    Astronomy Hour of Code.
    Converted from the old Lesson page by plan 13's generator: the same
    words, now without Tailwind.
*/
class HoCAstro5 is QuorumPage

    on create
        SetLocation("hourofcode/astro5.html")
        // The name lists and links use, and the series and track it belongs
        // to: its section and picture.
        SetShortTitle("Part 5: Create an integer variable")
        SetSectionName("Astronomy")
        // For search engines and link previews, and what lists of pages say.
        SetDescription("Try an accessible astronomy themed Hour of Code in the Quorum programming language.")
        SetSummary("Accessible astronomy themed Hour of Code")
    end

    action Setup
        SetWebPageTitle("Astronomy Hour of Code Activity 5 | Quorum Programming Language")
        Title("Astronomy Hour of Code")
        Paragraph("Activity 5: Create an integer variable")
        Instructions()
        ExplorationChallengeOptional()
    end

    private action Instructions
        Section("Instructions:")
        Paragraph("As we just learned variables are containers in the memory of a computer to hold values. There are different types of containers though to hold different types of values. We already learned about text variables, but there are other kinds of variables as well. In this activity, we are going to learn how to create an integer variable which can be used to hold a numeric value. An integer is any number which is positive or negative, including zero which does not have any decimal places. Variables types like "):Strong("integer"):Text(" that can hold numeric values are important in computers because we use them to calculate formulas and to change values. Later we will learn about numeric values that have decimal places and about how to you can change the type of a variable in some cases.")
        Paragraph("One of the things astronomers need to communicate to a robotic telescope is how long to take an image. In Skynet, we specify this time in the number of seconds. For the next activity, let's create an "):Strong("integer"):Text(" variable called "):Strong("seconds"):Text(" and assign it a value of 5, like this:")
        CodeExample("integer seconds = 5")
        Paragraph("On the final line, use the "):Strong("output"):Text(" command to display the variable's value:")
        CodeExample("output seconds")
        Paragraph("When you are ready, select the green Run Program button below the editor on the right (second in the tab order).")
    end

    private action ExplorationChallengeOptional
        Section("Exploration Challenge (Optional):")
        Paragraph("In the previous Exploration Challenges, we have added text variables and strings in quotations in the output line. We can also mix different types of variables in output statements as well as use more than two variables in the same line. For this challenge, create two more integer variables called hours and minutes and assign values to them like you did with seconds in this activity. In the output line, use the variables and text strings with colons ("):DoubleQuote():Text(":"):DoubleQuote():Text(") to output them in a typical time format like: "):Emphasis("1:48:23"):Text(".")
        CodeEditor("Type your code below...", "hourofcode/astro/code5.quorum")
    end
end
