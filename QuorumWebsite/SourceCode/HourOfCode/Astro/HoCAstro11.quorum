use Libraries.Web.Page.QuorumPage

/*
    Astronomy Hour of Code.
    Converted from the old Lesson page by plan 13's generator: the same
    words, now without Tailwind.
*/
class HoCAstro11 is QuorumPage
    // A double quote, for code and words that hold one.
    text dq = ""

    on create
        SetLocation("hourofcode/astro11.html")
        // The name lists and links use, and the series and track it belongs
        // to: its section and picture.
        SetShortTitle("Part 11: Creating a number variable from user input")
        SetSectionName("Astronomy")
        // For search engines and link previews, and what lists of pages say.
        SetDescription("Try an accessible astronomy themed Hour of Code in the Quorum programming language.")
        SetSummary("Accessible astronomy themed Hour of Code")
    end

    action Setup
        dq = dq:GetDoubleQuote()
        SetWebPageTitle("Astronomy Hour of Code Activity 11 | Quorum Programming Language")
        Title("Astronomy Hour of Code")
        Paragraph("Activity 11: Creating a number variable from user input")
        Instructions()
        ExplorationChallengeOptional()
    end

    private action Instructions
        Section("Instructions:")
        Paragraph("There is another type of numeric variable with decimal places called a "):Strong("number"):Text(". A "):Strong("number"):Text(" variable can hold a positive or negative numeric value or zero which can have decimal places. We can ask a user for a decimal number and cast the answer to a "):Strong("number"):Text(" variable in the same way we did with an "):Strong("integer"):Text(" previously by using the "):Strong("cast"):Text(" command, like this:")
        CodeExample("number seconds = cast(number, input(" + dq + "How many seconds: " + dq + "))")
        Paragraph("On the next line, use the "):Strong("output"):Text(" command to display the variable's value:")
        CodeExample("output seconds")
        Paragraph("When you are ready, select the green Run Program button below the editor on the right (second in the tab order).")
    end

    private action ExplorationChallengeOptional
        Section("Exploration Challenge (Optional):")
        Paragraph("Notice that a "):Strong("number"):Text(" variable always displays at least one decimal point in an "):Strong("output"):Text(" statement. If you want to display the whole number without any decimal places, use "):Strong("cast"):Text(" to change the type of a "):Strong("number"):Text(" to an "):Strong("integer"):Text(". Try different values when you run your program to see the result. Notice that the computer cuts off the decimal places, it does not round the number up, so 2.9 becomes 2 if you cast it to "):Strong("integer"):Text(". (Hint: if you try to assign the cast variable back to a "):Strong("number"):Text(" variable, it will cut the decimal points off, but still display the number with zero in an output statement.")
        CodeEditor("Type your code below...", "hourofcode/astro/code11.quorum")
    end
end
