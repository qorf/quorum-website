use Libraries.Web.Page.QuorumPage

/*
    Astronomy Hour of Code.
    Converted from the old Lesson page by plan 13's generator: the same
    words, now without Tailwind.
*/
class HoCAstro1 is QuorumPage
    // A double quote, for code and words that hold one.
    text dq = ""

    on create
        SetLocation("hourofcode/astro1.html")
        // The name lists and links use, and the series and track it belongs
        // to: its section and picture.
        SetShortTitle("Part 1: Using Output")
        SetSectionName("Astronomy")
        // For search engines and link previews, and what lists of pages say.
        SetDescription("Try an accessible astronomy themed Hour of Code in the Quorum programming language.")
        SetSummary("Accessible astronomy themed Hour of Code")
    end

    action Setup
        dq = dq:GetDoubleQuote()
        SetWebPageTitle("Astronomy Hour of Code Activity 1 | Quorum Programming Language")
        Title("Astronomy Hour of Code")
        Paragraph("Activity 1: Using Output")
        Instructions()
        ExplorationChallengeOptional()
    end

    private action Instructions
        Section("Instructions:")
        TrackingImage("https://code.org/api/hour/begin_quorum_astronomy.png")
        Paragraph("Professional astronomers use computer controlled robotic telescopes today for the majority of their observations. These telescopes are controlled by computer software which can take images with little or no human intervention. One network of these computerized telescopes is the "):Link("Skynet Robotic Telescope Network", "https://skynet.unc.edu/"):Text(" which offers astronomers the ability to take images at telescopes around the world. "):Link("Skynet Junior Scholars", "https://skynetjuniorscholars.org/"):Text(" is an educational program that engages students in activities which use these research-grade robotic telescopes and software tools to learn about astronomy and science. In this Hour of Code, we are going to learn about computer programming and by the end of activity 20 work with a virtual telescope in your browser to search for astronomical objects in a 3D virtual world.")
        Paragraph("In this first activity, we are going to learn how to output information to the screen. It is a first step toward creating our virtual telescope. The command to do this is called "):Strong("output"):Text(" and whatever we type after that word will be sent to the terminal output window. If you are using a screen reader, the console window will read the text that you output there. For example, if we want the word "):DoubleQuote():Text("telescope"):DoubleQuote():Text(" to appear in the output window, we will type:")
        CodeExample("output " + dq + "telescope" + dq)
        Paragraph("in the online code window below and then select the green Run Program button below the editor on the right (second in the tab order).")
    end

    private action ExplorationChallengeOptional
        Section("Exploration Challenge (Optional):")
        Paragraph("Use the "):Strong("output"):Text(" command to make the computer print the name of our galaxy to the console window.")
        CodeEditor("Type your code below...", "hourofcode/astro/code1.quorum")
    end
end
