use Libraries.Web.Page.QuorumPage

/*
    Astronomy Hour of Code.
    Converted from the old Lesson page by plan 13's generator: the same
    words, now without Tailwind.
*/
class HoCAstro16 is QuorumPage
    // A double quote, for code and words that hold one.
    text dq = ""

    on create
        SetLocation("hourofcode/astro16.html")
        // The name lists and links use, and the series and track it belongs
        // to: its section and picture.
        SetShortTitle("Part 16: Using the Game Engine")
        SetSectionName("Astronomy")
        // For search engines and link previews, and what lists of pages say.
        SetDescription("Try an accessible astronomy themed Hour of Code in the Quorum programming language.")
        SetSummary("Accessible astronomy themed Hour of Code")
    end

    action Setup
        dq = dq:GetDoubleQuote()
        SetWebPageTitle("Astronomy Hour of Code Activity 16 | Quorum Programming Language")
        Title("Astronomy Hour of Code")
        Paragraph("Activity 16: Using the Game Engine")
        Instructions()
        ExplorationChallengeOptional()
    end

    private action Instructions
        Section("Instructions:")
        Subsection("(Advanced Lesson)")
        Paragraph("Our overall goal in this Hour of Code is to create a virtual telescope in our browser that we can control like a real robotic telescope. Now that we've learned some of the basics of computer programming we are going to start putting the pieces together. In order to have a virtual world environment we are going to use the Quorum Game Engine. The first thing we will do is to create our "):Strong("Audio"):Text(" object inside a program that runs the Game Engine.")
        Paragraph("We don't need to get into all the details of how the Game Engine works in order to take this first step, so we will use the "):DoubleQuote():Text("skeleton"):DoubleQuote():Text(" of a Game Engine to allow us to play our sound file. The starting code in the code window marks two places where we need to insert code to make our sound play. At the top, we'll put in our library reference:")
        CodeExample("use Libraries.Sound.Audio")
        Paragraph("The "):Strong("CreateGame"):Text(" action in the starting code is automatically called by the Game Engine when the program runs, so any code we put in that section is run one time when the program starts. This is the section where we will create our "):Strong("Audio"):Text(" object and play it. We can use the code that we wrote in the previous section:")
        CodeExample("Audio clickSound
clickSound:Load(" + dq + "media/astro/click.wav" + dq + ")
clickSound:Play()")
        Paragraph("When you finish and click the Run Program button, you should hear the click sound play once automatically.")
    end

    private action ExplorationChallengeOptional
        Section("Exploration Challenge (Optional):")
        Paragraph("There is another different click sound on the server at: "):Strong("media/astro/click2.wav"):Text(". Create another "):Strong("Audio"):Text(" object with a different name and play that sound also. Then write the code to ask the user which sound they want to hear (1 or 2) and play the correct one by using an "):Strong("if/else"):Text(" statement. If you want to go further, use an "):Link("if/elseif/else", "https://quorumlanguage.com/tutorials/language/if.html"):Text(" statement to either play a sound or display an error if the user did not type a 1 or 2 when you asked for input.")
        CodeEditor("Type your code below...", "hourofcode/astro/code16.quorum")
    end
end
