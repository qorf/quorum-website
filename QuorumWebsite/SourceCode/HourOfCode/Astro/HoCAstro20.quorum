use Libraries.Web.Page.QuorumPage

/*
    Astronomy Hour of Code.
    Converted from the old Lesson page by plan 13's generator: the same
    words, now without Tailwind.
*/
class HoCAstro20 is QuorumPage
    // A double quote, for code and words that hold one.
    text dq = ""

    on create
        SetLocation("hourofcode/astro20.html")
        // The name lists and links use, and the series and track it belongs
        // to: its section and picture.
        SetShortTitle("Part 20: Adding the Stars")
        SetSectionName("Astronomy")
        // For search engines and link previews, and what lists of pages say.
        SetDescription("Try an accessible astronomy themed Hour of Code in the Quorum programming language.")
        SetSummary("Accessible astronomy themed Hour of Code")
    end

    action Setup
        dq = dq:GetDoubleQuote()
        SetWebPageTitle("Astronomy Hour of Code Activity 20 | Quorum Programming Language")
        Title("Astronomy Hour of Code")
        Paragraph("Activity 20: Adding the Stars")
        Instructions()
        ExplorationChallengeOptional()
    end

    private action Instructions
        Section("Instructions:")
        Subsection("(Advanced Lesson)")
        Paragraph("For the final step, now we are going to set the images for our skybox to images of the night sky. In our starting code below, identify the "):Strong("skybox:Load"):Text(" method call and change the name of the image files to the night sky images.")
        Paragraph("The night sky images with the path are:")
        CodeExample(dq + "media/astro/star-right.png" + dq + "
" + dq + "media/astro/star-left.png" + dq + "
" + dq + "media/astro/star-top.png" + dq + "
" + dq + "media/astro/star-bottom.png" + dq + "
" + dq + "media/astro/star-front.png" + dq + "
" + dq + "media/astro/star-back.png" + dq)
        Paragraph("Notice that the file extension for the new image files are "):Strong(".png"):Text(" and not "):Strong(".jpg")
        Paragraph("Now you are ready to Run your program and move your telescope around the sky.")
    end

    private action ExplorationChallengeOptional
        Section("Exploration Challenge (Optional):")
        Paragraph("You have the code below for a working virtual telescope. We have hidden images of three planets, a supernova, a galaxy and the Pillars of Creation at random coordinates in the night sky. Explore the sky using the movement keys and as you pass over one, the console output will alert you. You can zoom in and out of the image with the Z key and see or hear what you have found. After you complete the activity, look at the code to find the coordinates and change them for a friend.")
        Paragraph("The links below provide more information on the images, which were all taken from the Hubble Space Telescope. We selected the Right Ascension and Declination coordinates for these objects randomly. Professional astronomers use charts and computer programs to find these coordinates as well as when the objects are visible from their location.")
        BulletList()
        ListItem():Link("Crab Nebula", "http://hubblesite.org/image/4027/gallery"):Text(" (100, 45)")
        ListItem():Link("Jupiter", "http://hubblesite.org/image/4012/gallery"):Text(" (264, 15)")
        ListItem():Link("Supernova 1987a", "http://hubblesite.org/image/3991/gallery"):Text(" (322, 82)")
        ListItem():Link("Neptune", "http://hubblesite.org/image/3748/gallery"):Text(" (201, 58)")
        ListItem():Link("Mars", "http://hubblesite.org/image/3733/gallery"):Text(" (25, 33)")
        ListItem():Link("Pillars of Creation", "http://hubblesite.org/image/3471/gallery"):Text(" (148, 70)")
        Paragraph("If you want to learn more about astronomy and robotic telescopes, you can visit the "):Link("Skynet Robotic Telescope Network", "https://skynet.unc.edu/"):Text(" or the "):Link("Skynet Junior Scholars", "https://skynetjuniorscholars.org/"):Text(" websites.")
        CodeEditor("Type your code below...", "hourofcode/astro/code20.quorum")
    end
end
