use Libraries.Web.Page.QuorumPage

/*
    Astronomy Hour of Code.
    Converted from the old Lesson page by plan 13's generator: the same
    words, now without Tailwind.
*/
class HoCAstro2 is QuorumPage
    // A double quote, for code and words that hold one.
    text dq = ""

    on create
        SetLocation("hourofcode/astro2.html")
        // The name lists and links use, and the series and track it belongs
        // to: its section and picture.
        SetShortTitle("Part 2: Using Output")
        SetSectionName("Astronomy")
        // For search engines and link previews, and what lists of pages say.
        SetDescription("Try an accessible astronomy themed Hour of Code in the Quorum programming language.")
        SetSummary("Accessible astronomy themed Hour of Code")
    end

    action Setup
        dq = dq:GetDoubleQuote()
        SetWebPageTitle("Astronomy Hour of Code Activity 2 | Quorum Programming Language")
        Title("Astronomy Hour of Code")
        Paragraph("Activity 2: Using Output")
        Instructions()
        ExplorationChallengeOptional()
    end

    private action Instructions
        Section("Instructions:")
        Paragraph("In the second activity, we are going to learn how to make the computer talk using a command called "):Strong("say"):Text(". We use "):Strong("say"):Text(" exactly like we use the "):Strong("output"):Text(" command, except that it causes the computer to talk. Note that not all browsers support talking, so you need to be in Chrome or Safari. To make the computer say the words "):DoubleQuote():Text("Robotic telescope"):DoubleQuote():Text(", we will type:")
        CodeExample("say " + dq + "Robotic telescope" + dq)
        Paragraph("in the online code window below and then select the green Run Program button below the editor on the right (second in the tab order).")
    end

    private action ExplorationChallengeOptional
        Section("Exploration Challenge (Optional):")
        Paragraph("In four lines of code, use separate "):Strong("say"):Text(" commands to make the computer say the names of the four planets closest to the sun.")
        CodeEditor("Type your code below...", "hourofcode/astro/code2.quorum")
    end
end
