use Libraries.Web.Page.QuorumPage

/*
    Astronomy Hour of Code.
    Converted from the old Lesson page by plan 13's generator: the same
    words, now without Tailwind.
*/
class HoCAstro3 is QuorumPage
    // A double quote, for code and words that hold one.
    text dq = ""

    on create
        SetLocation("hourofcode/astro3.html")
        // The name lists and links use, and the series and track it belongs
        // to: its section and picture.
        SetShortTitle("Part 3: Creating a text variable")
        SetSectionName("Astronomy")
        // For search engines and link previews, and what lists of pages say.
        SetDescription("Try an accessible astronomy themed Hour of Code in the Quorum programming language.")
        SetSummary("Accessible astronomy themed Hour of Code")
    end

    action Setup
        dq = dq:GetDoubleQuote()
        SetWebPageTitle("Astronomy Hour of Code Activity 3 | Quorum Programming Language")
        Title("Astronomy Hour of Code")
        Paragraph("Activity 3: Creating a text variable")
        Instructions()
        ExplorationChallengeOptional()
    end

    private action Instructions
        Section("Instructions:")
        Paragraph("In this activity, we are going to learn how to assign a value to a variable, which is like a container in the computer's memory. After we put a value in the variable, we will output the contents of the variable to the output window. This requires two lines of code. In the first line, we will create a variable of the the type: "):Strong("text"):Text(" , give it the name "):Strong("phrase"):Text(" and give it a value of "):DoubleQuote():Text("Welcome to the Skynet Robotic Telescope Network."):DoubleQuote():Text(" which is done within quotation marks. The format for this command is:")
        Paragraph():Emphasis("variableType variableName = " + dq + "variableValue" + dq)
        Paragraph("In our example, the first line of code you need to enter should look like this:")
        CodeExample("text phrase = " + dq + "Welcome to the Skynet Robotic Telescope Network." + dq)
        Paragraph("On the next line, we will output the variable in the terminal output window like this:")
        CodeExample("output phrase")
        Paragraph("Notice that the variable "):Strong("phrase"):Text(" in the output line is typed exactly like it is on the first line of code (including capitalization) and that there are no quotation marks around it. Now you are ready to select the green Run Program button below the editor on the right (second in the tab order).")
    end

    private action ExplorationChallengeOptional
        Section("Exploration Challenge (Optional):")
        Paragraph("Make the computer combine two variables together in the console output. To do this, start by creating two "):Strong("text"):Text(" variables with different names and assigning values to them. Next, add them together in your "):Strong("output"):Text(" statement with the "):Strong("+"):Text(" symbol. For example, make two variables called "):Strong("phrase1"):Text(" and "):Strong("phrase2"):Text(" with the values: "):DoubleQuote():Text("My favorite planet is "):DoubleQuote():Text(" and "):DoubleQuote():Text("Neptune"):DoubleQuote():Text(" so that when you output phrase1 + phrase2, the computer puts: "):Emphasis("My favorite planet is Neptune"):Text(" in the console.")
        CodeEditor("Type your code below...", "hourofcode/astro/code3.quorum")
    end
end
