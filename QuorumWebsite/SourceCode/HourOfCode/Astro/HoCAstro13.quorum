use Libraries.Web.Page.QuorumPage

/*
    Astronomy Hour of Code.
    Converted from the old Lesson page by plan 13's generator: the same
    words, now without Tailwind.
*/
class HoCAstro13 is QuorumPage
    // A double quote, for code and words that hold one.
    text dq = ""

    on create
        SetLocation("hourofcode/astro13.html")
        // The name lists and links use, and the series and track it belongs
        // to: its section and picture.
        SetShortTitle("Part 13: Convert Right Ascension to Degrees")
        SetSectionName("Astronomy")
        // For search engines and link previews, and what lists of pages say.
        SetDescription("Try an accessible astronomy themed Hour of Code in the Quorum programming language.")
        SetSummary("Accessible astronomy themed Hour of Code")
    end

    action Setup
        dq = dq:GetDoubleQuote()
        SetWebPageTitle("Astronomy Hour of Code Activity 13 | Quorum Programming Language")
        Title("Astronomy Hour of Code")
        Paragraph("Activity 13: Convert Right Ascension to Degrees")
        Instructions()
        ExplorationChallengeOptional()
    end

    private action Instructions
        Section("Instructions:")
        Paragraph("In order for us to give our virtual telescope movement commands in the computer, we have to convert the Right Ascension numbers into degrees. Since a full turn of a circle is 360 degrees we can translate the hours and minutes and seconds to degrees. We can construct a formula for this by converting the hours and minutes and seconds that the user input into the total number of hours using decimal values and then converting the total number of hours to degrees.")
        Paragraph("Let's start by creating a "):Strong("totalHours"):Text(" variable of type "):Strong("number"):Text(" (since we will need decimal places) and assign it the value contained in "):Strong("hours"):Text(" from the user input:")
        CodeExample("number totalHours = hours")
        Paragraph("Next, we know that there are 60 minutes in every hour, so we can convert minutes to hours by dividing the value contained in the variable "):Strong("minutes"):Text(" by 60 and adding it to "):Strong("totalHours"):Text(". We will put parentheses around the minutes calculation to tell the computer to do that part first.")
        Paragraph("We can also use the variable "):Strong("totalHours"):Text(" twice in the same equation (on the left and right side of the equation) because the computer will use the original value in the computer's memory in the calculation on the right side of the equation first and then write the new value into memory on the left side of the equation after the calculation is complete. The next line in the conversion will look like this:")
        CodeExample("totalHours = totalHours + (minutes / 60)")
        Paragraph("We can finish our calculation for "):Strong("totalHours"):Text(" by converting seconds to hours and adding that to "):Strong("totalHours"):Text(". Since there are 60 minutes in an hour and 60 seconds in a minute, there are 3600 seconds per hour, so we can make this calculation like this:")
        CodeExample("totalHours = totalHours + (seconds / 3600)")
        Paragraph("Now "):Strong("totalHours"):Text(" contains the total number of hours as a decimal value and we can convert that number to degrees. Since there are 360 degrees in a circle and 24 hours in a day, we can calculate the number of degrees per hour by dividing 360 by 24, which gives us 15. So if we multiply "):Strong("totalHours"):Text(" by 15, we have the number of degrees. We can write this in code like this:")
        CodeExample("number degrees = totalHours * 15")
        Paragraph("To output the answer, we can combine the value of degrees with a text string to make our answer in a nice format. We do that like this:")
        CodeExample("output " + dq + "The number of degrees are: " + dq + " + degrees")
        Paragraph("When you are ready, select the green Run Program button below the editor on the right (second in the tab order).")
    end

    private action ExplorationChallengeOptional
        Section("Exploration Challenge (Optional):")
        Paragraph("The code we wrote in this activity has more lines than we need to use. Try to re-write the code to put the formula on a single line without using the variable "):Strong("totalHours"):Text(".")
        CodeEditor("Type your code below...", "hourofcode/astro/code13.quorum")
    end
end
