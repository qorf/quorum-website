use Libraries.Web.Page.QuorumPage

/*
    Astronomy Hour of Code.
    Converted from the old Lesson page by plan 13's generator: the same
    words, now without Tailwind.
*/
class HoCAstro4 is QuorumPage
    // A double quote, for code and words that hold one.
    text dq = ""

    on create
        SetLocation("hourofcode/astro4.html")
        // The name lists and links use, and the series and track it belongs
        // to: its section and picture.
        SetShortTitle("Part 4: Getting user input")
        SetSectionName("Astronomy")
        // For search engines and link previews, and what lists of pages say.
        SetDescription("Try an accessible astronomy themed Hour of Code in the Quorum programming language.")
        SetSummary("Accessible astronomy themed Hour of Code")
    end

    action Setup
        dq = dq:GetDoubleQuote()
        SetWebPageTitle("Astronomy Hour of Code Activity 4 | Quorum Programming Language")
        Title("Astronomy Hour of Code")
        Paragraph("Activity 4: Getting user input")
        Instructions()
        ExplorationChallengeOptional()
    end

    private action Instructions
        Section("Instructions:")
        Paragraph("In this activity, we are going to learn how to ask the user a question and assign their answer to a variable. After we put a value in the variable, we will output the contents of the variable to the output window. This requires two lines of code. In the first line, create a "):Strong("text"):Text(" variable called "):Strong("telescope"):Text(" and then use the "):Strong("input"):Text(" function to ask the user a question. A function in a programming language is like a "):DoubleQuote():Text("mini program"):DoubleQuote():Text(" that accepts a value from your program and then returns a value to your program after it runs. The value that your program provides to the function is called a parameter and it must be inside parenthesis.")
        Paragraph("In this case, the "):Strong("input"):Text(" function will accept a text value from your program and then create a dialog box on the user's screen with your programs text value, a box for the user to type some value and buttons for "):DoubleQuote():Text("OK"):DoubleQuote():Text(" and "):DoubleQuote():Text("cancel"):DoubleQuote():Text(". When the user clicks the "):DoubleQuote():Text("OK"):DoubleQuote():Text(" button, the value that she typed in the box is returned to your program.")
        Paragraph("Remember to use quotation marks around your text inside the parenthesis so that the computer knows you are sending a text value to the function.")
        Paragraph("In our program we will assign the value returned from the input function to a text variable called telescope like this:")
        CodeExample("text telescope = input(" + dq + "What telescope would you like to use?" + dq + ")")
        Paragraph("On the next line, use the "):Strong("output"):Text(" command to display the user's answer like usual:")
        CodeExample("output telescope")
        Paragraph("Now you are ready to select the green Run Program button below the editor on the right (second in the tab order).")
    end

    private action ExplorationChallengeOptional
        Section("Exploration Challenge (Optional):")
        Paragraph("Modify your "):Strong("output"):Text(" statement so that the computer outputs a more user-friendly response. You can do this by inserting a text string in your statement and then adding the telescope variable with a "):Strong("+"):Text(" sign similar to the previous Exploration Challenge. For example, if the user answered the input question with the telescope Yerkes-41, make the computer output the line: "):Emphasis("You have selected the telescope Yerkes-41"):Text(".")
        CodeEditor("Type your code below...", "hourofcode/astro/code4.quorum")
    end
end
