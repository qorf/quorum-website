use Libraries.Web.Page.QuorumPage

/*
    Astronomy Hour of Code.
    Converted from the old Lesson page by plan 13's generator: the same
    words, now without Tailwind.
*/
class HoCAstro6 is QuorumPage

    on create
        SetLocation("hourofcode/astro6.html")
        // The name lists and links use, and the series and track it belongs
        // to: its section and picture.
        SetShortTitle("Part 6: Adding a value to a variable")
        SetSectionName("Astronomy")
        // For search engines and link previews, and what lists of pages say.
        SetDescription("Try an accessible astronomy themed Hour of Code in the Quorum programming language.")
        SetSummary("Accessible astronomy themed Hour of Code")
    end

    action Setup
        SetWebPageTitle("Astronomy Hour of Code Activity 6 | Quorum Programming Language")
        Title("Astronomy Hour of Code")
        Paragraph("Activity 6: Adding a value to a variable")
        Instructions()
        ExplorationChallengeOptional()
    end

    private action Instructions
        Section("Instructions:")
        Paragraph("Now that we know about "):Strong("integer"):Text(" variables, we are going to use one in a computation. In this activity, we are going to create an "):Strong("integer"):Text(" variable, add 1 to it and then output the answer to our screen. The solution will use 3 lines of code. On the first line, create an "):Strong("integer"):Text(" called "):Strong("seconds"):Text(" and assign it a value of 5 to start with.")
        CodeExample("integer seconds = 5")
        Paragraph("On the next line, add 1 to "):Strong("seconds"):Text(" by assigning "):Strong("seconds + 1"):Text(" to it. Notice we can use the variable "):Strong("seconds"):Text(" twice in the same equation (on the left and right side of the equation) because the computer will use the original value in the computer's memory in the calculation on the right side of the equation first and then write the new value into memory on the left side of the equation after the calculation is complete. So we can add one to a variable value like this:")
        CodeExample("seconds = seconds + 1")
        Paragraph("On the next line, use the "):Strong("output"):Text(" command to display the variable's value:")
        CodeExample("output seconds")
        Paragraph("When you are ready, select the green Run Program button below the editor on the right (second in the tab order).")
    end

    private action ExplorationChallengeOptional
        Section("Exploration Challenge (Optional):")
        Paragraph("Output the values from 1 to 5 by incrementing the seconds variable each time and then sending the value to the console. You can do this in five separate output statements or by using a "):Strong("repeat"):Text(" loop. For more information on repeat loops in Quorum look at the "):Link("Repeat Tutorial", "https://quorumlanguage.com/tutorials/language/repeat.html"):Text(".")
        CodeEditor("Type your code below...", "hourofcode/astro/code6.quorum")
    end
end
