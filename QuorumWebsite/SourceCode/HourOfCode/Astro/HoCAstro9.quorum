use Libraries.Web.Page.QuorumPage

/*
    Astronomy Hour of Code.
    Converted from the old Lesson page by plan 13's generator: the same
    words, now without Tailwind.
*/
class HoCAstro9 is QuorumPage

    on create
        SetLocation("hourofcode/astro9.html")
        // The name lists and links use, and the series and track it belongs
        // to: its section and picture.
        SetShortTitle("Part 9: Using more than one variable in a formula")
        SetSectionName("Astronomy")
        // For search engines and link previews, and what lists of pages say.
        SetDescription("Try an accessible astronomy themed Hour of Code in the Quorum programming language.")
        SetSummary("Accessible astronomy themed Hour of Code")
    end

    action Setup
        SetWebPageTitle("Astronomy Hour of Code Activity 9 | Quorum Programming Language")
        Title("Astronomy Hour of Code")
        Paragraph("Activity 9: Using more than one variable in a formula")
        Instructions()
        ExplorationChallengeOptional()
    end

    private action Instructions
        Section("Instructions:")
        Paragraph("We can also use more than one variable in a formula or mix variables and numbers. In this activity, we are going to set up a formula to calculate the total number of seconds when we are given a certain number of "):Strong("minutes"):Text(" and "):Strong("seconds"):Text(". To do this, start by creating two integer variables: minutes and seconds and assigning values to them. Let's assign a value of 3 to minutes and 23 to seconds like this:")
        CodeExample("integer minutes = 3
integer seconds = 23")
        Paragraph("Now we can output the total number of seconds by using a formula to compute the answer by multiplying minutes by 60 (since there are 60 seconds in a minute) and then adding seconds. Our formula will look like this:")
        CodeExample("output minutes * 60 + seconds")
        Paragraph("When you click the green Run Program button, the number 203 should display in the output console.")
    end

    private action ExplorationChallengeOptional
        Section("Exploration Challenge (Optional):")
        Paragraph("Modify the output statement so that the computer gives you a user-friendly message like: "):Emphasis("There are 203 seconds in 3 minutes and 23 seconds"):Text(". You will have to put your formula in parenthesis in your output statement to get the correct answer...can you guess why this is necessary? After you have the friendly message working, change the variable values to find out how many seconds are in 5 minutes and 10 seconds without changing your output statement. (Hint: you must use the integer variables in the output statement.)")
        CodeEditor("Type your code below...", "hourofcode/astro/code9.quorum")
    end
end
