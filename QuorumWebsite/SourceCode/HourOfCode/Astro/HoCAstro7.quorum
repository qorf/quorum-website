use Libraries.Web.Page.QuorumPage

/*
    Astronomy Hour of Code.
    Converted from the old Lesson page by plan 13's generator: the same
    words, now without Tailwind.
*/
class HoCAstro7 is QuorumPage

    on create
        SetLocation("hourofcode/astro7.html")
        // The name lists and links use, and the series and track it belongs
        // to: its section and picture.
        SetShortTitle("Part 7: Using a Boolean Variable")
        SetSectionName("Astronomy")
        // For search engines and link previews, and what lists of pages say.
        SetDescription("Try an accessible astronomy themed Hour of Code in the Quorum programming language.")
        SetSummary("Accessible astronomy themed Hour of Code")
    end

    action Setup
        SetWebPageTitle("Astronomy Hour of Code Activity 7 | Quorum Programming Language")
        Title("Astronomy Hour of Code")
        Paragraph("Activity 7: Using a Boolean Variable")
        Instructions()
        ExplorationChallengeOptional()
    end

    private action Instructions
        Section("Instructions:")
        Paragraph("Another type of variable we need to understand is called a "):Strong("boolean"):Text(" variable. A "):Strong("boolean"):Text(" variable is like a switch and can only have one of two values: true or false. We create a "):Strong("boolean"):Text(" variable in the same way we have created other variables, we specify the type of the variable, the variable name and the initial value.")
        Paragraph("When astronomers want to control a telescope, they need to check if the dome of the observatory is open or closed before they can take a picture. Let's create a boolean variable called "):Strong("domeIsOpen"):Text(" to hold a value we can check to see if the dome is open at the current time. If we start by saying the dome of the observatory is open, we will give our variable a value of true and our first line of code should look like this:")
        CodeExample("boolean domeIsOpen = true")
        Paragraph("Now put a simple "):Strong("output"):Text(" statement to display the value of the variable in the console.")
        CodeExample("output domeIsOpen")
        Paragraph("When you are ready, select the green Run Program button below the editor on the right (second in the tab order).")
    end

    private action ExplorationChallengeOptional
        Section("Exploration Challenge (Optional):")
        Paragraph("Add two lines of code to switch the value of the "):Strong("domeIsOpen"):Text(" variable to "):Strong("false"):Text(" and then output the new value. To get the opposite of the current value of a "):Strong("boolean"):Text(" variable, you can also use the logical operator "):Strong("not"):Text(" if you prefer. Try to use "):Strong("not"):Text(" keyword in an output statement to get the opposite value of your variable.")
        CodeEditor("Type your code below...", "hourofcode/astro/code7.quorum")
    end
end
