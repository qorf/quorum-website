use Libraries.Web.Page.QuorumPage

/*
    Hour of Code: Code with Mary.
    Converted from the old Lesson page by plan 13's generator: the same
    words, now without Tailwind.
*/
class HoCPart3 is QuorumPage

    on create
        SetLocation("hourofcode/part3.html")
        // The name lists and links use, and the series and track it belongs
        // to: its section and picture.
        SetShortTitle("Part 3: This or That")
        SetSectionName("Code With Mary")
        // For search engines and link previews, and what lists of pages say.
        SetDescription("Join Mary in her adventure learning the Quorum programming language.")
        SetSummary("first steps in Quorum")
    end

    action Setup
        SetWebPageTitle("Hour of Code: Part 3 | Quorum Programming Language")
        Title("Hour of Code: Code with Mary")
        TrackingImage("http://code.org/api/hour/begin_quorum.png/")
        Part3ThisOrThat()
        BooleanVariablesAndConditionals()
        TryItYourself()
    end

    private action Part3ThisOrThat
        Section("Part 3: This or That")
        Video("//www.youtube.com/embed/EKOXMt2FeTc?rel=0", "Coding Quorum with Mary (Day 3)")
    end

    private action BooleanVariablesAndConditionals
        Section("Boolean Variables and Conditionals")
        Slides()
        Slide("Boolean Variables")
        Paragraph("A boolean variable is a special type of variable that contains one of two possible values: true or false.")
        Paragraph("By themselves, boolean variables don't seem to do too much, but they are a powerful tool when working with control structures, as we will soon see.")
        Paragraph("Try it!")
        Paragraph("Make a boolean variable and assign it a value of true: boolean sayStatement = false.")
        Paragraph("Create a text variable named "):DoubleQuote():Text("greeting"):DoubleQuote():Text(" and assign it a string you like in double quotes: text greeting = "):DoubleQuote():Text("Hello!"):DoubleQuote()
        Paragraph("We will use these variables in a couple slides.")
        Slide("Control Structures: If (Structure)")
        Paragraph("One powerful ability of a computer is to evaluate a condition and make a decision about which instructions to execute. These decisions can be made with a simple conditional statement, which in Quorum uses the keyword if.")
        Paragraph("An if statement has three parts: the keyword if followed by a condition, followed by the block of code to execute if the condition is true, followed by end.")
        Paragraph("boolean variables are often used to specify the condition.")
        Paragraph("Try it!")
        Paragraph("Create an if statement using the boolean from the last slide: if sayStatement = true and then type end on a new line and then move to the next slide.")
        Slide("Control Structures: If (Conditional Logic)")
        Paragraph("When determining whether to execute the block of code within the if statement the computer checks the condition part of the statement to see whether it is true or false.")
        Paragraph("You can specify the condition using a boolean variable or any other expression that evaluates to true or false")
        Paragraph("For example, if you typed if 1 + 1 = 4 the condition 1 + 1 = 4 evaluates to false, so the code is skipped.")
        Paragraph("If code is skipped, the computer jumps to the end keyword for the next instruction.")
        Paragraph("Try it!")
        Paragraph("Inside the previous if block type: say greeting and then Run your code.")
        Slide("Control Structures: If (elseif)")
        Paragraph("You can also specify an alternatve condition to evaluate if the condition in the first part of the if statement is false by using the keyword elseif before the end.")
        Paragraph("We can include as many elseif conditions as we want and include code blocks to execute in each case.")
        Paragraph("There is a single end statement at the conclusion.")
        Paragraph("Try it!")
        Paragraph("Continuing the example from the last slide, insert a new condition before the line end and then a line containing the code to execute: elseif sayStatement = false"):NewLine():Text("output greeting and then Run your code.")
        Slide("Control Structures: If (else)")
        Paragraph("There is one other optional part of an if statement called the default condition, which will execute if no other condition in the statement is true. In Quorum, this block is designated with the keyword else")
        Paragraph("In our example, there are only two states: true and false, so there are no other possible conditions, although the elseif line could be converted to an else without a second condition.")
        Paragraph("In other cases, you might have a list of conditions like: "):NewLine():Text(" if x = 1 {code block}"):NewLine():Text("elseif x = 2 {code block}"):NewLine():Text("else {code block}"):NewLine():Text("end"):NewLine():Text(" (You can experiment or move on when ready)")
        Slide("If Statements: Additional Information")
        Paragraph("More documentation on if statements can be found "):Link("here", "http://quorumlanguage.com/documents/syntax/if.php"):Text(".")
    end

    private action TryItYourself
        Section("Try it Yourself")
        CodeEditorWithCode("Type your Code Here!", "")
    end
end
