use Libraries.Web.Page.QuorumPage

/*
    Hour of Code: Code with Mary.
    Converted from the old Lesson page by plan 13's generator: the same
    words, now without Tailwind.
*/
class HoCPart6 is QuorumPage

    on create
        SetLocation("hourofcode/part6.html")
        // The name lists and links use, and the series and track it belongs
        // to: its section and picture.
        SetShortTitle("Part 6: Mutate the Bugs")
        SetSectionName("Code With Mary")
        // For search engines and link previews, and what lists of pages say.
        SetDescription("Join Mary in her adventure learning the Quorum programming language.")
        SetSummary("first steps in Quorum")
    end

    action Setup
        SetWebPageTitle("Hour of Code: Part 6 | Quorum Programming Language")
        Title("Hour of Code: Code with Mary")
        TrackingImage("http://code.org/api/hour/begin_quorum.png/")
        Part6MutateTheBugs()
        Actions()
        TryItYourself()
    end

    private action Part6MutateTheBugs
        Section("Part 6: Mutate the Bugs")
        Video("//www.youtube.com/embed/qIvXHEhIQI8?rel=0", "Coding Quorum with Mary (Day 6)")
    end

    private action Actions
        Section("Actions")
        Slides()
        Slide("Actions")
        Paragraph("Often times inside a program, we want to run the same code sections many times in different places. We usually want to eliminate this duplicate code to save time, reduce errors and make things easier to change.")
        Paragraph("We do this by writing procedures that we call whenever we want code to run. In Quorum, these are called actions.")
        Paragraph("You didn't realize it, but we have already been using an action called Main. The computer always starts running our program from our Main action. We haven't had to use it so far, because Quorum automatically puts our code inside a Main action if we don't use any other actions.")
        Paragraph("Now that we are going to use other actions though, we always need to include it.")
        Slide("Creating Actions: Part 1")
        Paragraph("In Quorum to create an action, we use the keyword action followed by the name of the action. We usually capitalize the first letter of an action name, but it is not required. Naming rules for actions are the same as variables, it must start with a letter.")
        Paragraph("Since we are going to have a code block inside the action, we also need to include an end to mark where the action ends.")
        Paragraph("Try it!")
        Slide("Creating Actions: Part 2")
        Paragraph("You can put any type of code that you've learned so far inside the Main action or call other actions from it.")
        Paragraph("We are going to create another action now that we will call from the Main action.")
        Paragraph("To do this, just create a new action after the end statement of the Main action.")
        Paragraph("Try it!")
        Slide("Creating Actions: Part 3")
        Paragraph("At the moment, we have two actions in our program, but no code to run inside the actions. We'll learn how to call an action in a moment, but first, let's write some code inside the PrintMsg action.")
        Paragraph("To keep our example simple, we are going to write a simple output message to the screen.")
        Paragraph("Try it!")
        Slide("Calling Actions")
        Paragraph("Now, in order to complete this program we need to call our PrintMsg action from our Main action so that it will execute.")
        Paragraph("In Quorum, this is very easy to do, we just insert a line of code in the Main action that redirects the computer to the other action. We do this adding the line PrintMsg() to the Main action.")
        Paragraph("The parentheses are necessary after the action name to notify the computer that it should run an action.")
        Paragraph("Try it!")
        Slide("Actions: More Information")
        Paragraph("Here is our full example:")
        Paragraph("Actions are an important and useful concept in programming, but we've only covered the basics so far. You can also do things like pass variables to an action and return values from an action.")
        Paragraph("For more information on actions, click "):Link("here", "http://quorumlanguage.com/documents/syntax/actions.php")
        Paragraph("Mary's project covering actions can be found "):Link("here", "projects/actions_and_classes.zip"):Text(".")
    end

    private action TryItYourself
        Section("Try it Yourself")
        CodeEditorWithCode("Type your Code Here!", "")
    end
end
