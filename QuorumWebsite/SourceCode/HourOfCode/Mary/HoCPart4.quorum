use Libraries.Web.Page.QuorumPage

/*
    Hour of Code: Code with Mary.
    Converted from the old Lesson page by plan 13's generator: the same
    words, now without Tailwind.
*/
class HoCPart4 is QuorumPage

    on create
        SetLocation("hourofcode/part4.html")
        // The name lists and links use, and the series and track it belongs
        // to: its section and picture.
        SetShortTitle("Part 4: Clothing Picker")
        SetSectionName("Code With Mary")
        // For search engines and link previews, and what lists of pages say.
        SetDescription("Join Mary in her adventure learning the Quorum programming language.")
        SetSummary("first steps in Quorum")
    end

    action Setup
        SetWebPageTitle("Hour of Code: Part 4 | Quorum Programming Language")
        Title("Hour of Code: Code with Mary")
        TrackingImage("http://code.org/api/hour/begin_quorum.png/")
        Part4ClothingPicker()
        Repeat()
        TryItYourself()
    end

    private action Part4ClothingPicker
        Section("Part 4: Clothing Picker")
        Video("//www.youtube.com/embed/j4Bjfu1TaEE?rel=0", "Coding Quorum with Mary (Day 4)")
    end

    private action Repeat
        Section("Repeat")
        Slides()
        Slide("Control Structures: Repeat")
        Paragraph("If we want the computer to repeat a task multiple times, we can use a loop in our program. This is usually a lot less work than typing the instruction repeatedly and more flexible because we can have the instructions executed a variable number of times.")
        Paragraph("In Quorum, we create a loop using the keyword "):Code("repeat"):Text(".")
        Paragraph("We mark the end of a loop in the same way we marked the end of an "):Code("if"):Text(" statement, by using the keyword "):Code("end"):Text(".")
        Paragraph("In this example, we will explore three different ways to control loops using the statements: "):Code("repeat {number} times"):Text(", "):Code("repeat while {condition}"):Text(" and "):Code("repeat until {condition}"):Text(".")
        Slide("Control Structures: Repeat Times")
        Paragraph("The most basic type of loop involves just telling the computer how many times to repeat something.")
        Paragraph("In Quorum, if we want to do something 5 times, we can type: "):Code("repeat 5 times"):Text(" or if we have a numeric variable, we can place that in the "):DoubleQuote():Text("5"):DoubleQuote():Text(" position like: "):Code("repeat x times"):Text(".")
        Paragraph("Try it!")
        Slide("Control Structures: Repeat While")
        Paragraph("An alternative type of loop is to repeat a block of code while a certain condition is met.")
        Paragraph("In Quorum we do this by using a "):Code("repeat while"):Text(" statement. After the keyword "):Code("while"):Text(", we include a condition, just like we did with an "):Code("if"):Text(" statement.")
        Paragraph("If we want to mimic the last example, we could just repeat while our variable is less than or equal to 10.")
        Paragraph("Note that the value of the variable will be 12, but the output statement is skipped when the repeat condition is false.")
        Paragraph("Try it!")
        Slide("Control Structures: Repeat Until")
        Paragraph("The final way of representing a loop in Quorum is to use a "):Code("repeat until"):Text(" statement, which is very similar to the "):Code("repeat while"):Text(" loop.")
        Paragraph("The difference is that the "):Code("repeat until"):Text(" loop stops when a specific condition is met instead of repeating while a condition is met.")
        Paragraph("You can represent the same logical control with either format, so it is your choice which one you use, but sometimes one is more natural than the other.")
        Paragraph("Try it!")
        Slide("Control Structures: Additional Information")
        Paragraph("More documentation on "):Code("repeat"):Text(" can be found "):Link("here", "http://quorumlanguage.com/documents/syntax/repeat.php"):Text(".")
    end

    private action TryItYourself
        Section("Try it Yourself")
        CodeEditorWithCode("Type your Code Here!", "")
    end
end
