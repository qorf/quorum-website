use Libraries.Web.Page.QuorumPage

/*
    Hour of Code: Code with Mary.
    Converted from the old Lesson page by plan 13's generator: the same
    words, now without Tailwind.
*/
class HoCPart7 is QuorumPage

    on create
        SetLocation("hourofcode/part7.html")
        // The name lists and links use, and the series and track it belongs
        // to: its section and picture.
        SetShortTitle("Part 7: The End of the World")
        SetSectionName("Code With Mary")
        // For search engines and link previews, and what lists of pages say.
        SetDescription("Join Mary in her adventure learning the Quorum programming language.")
        SetSummary("first steps in Quorum")
    end

    action Setup
        SetWebPageTitle("Hour of Code: Part 7 | Quorum Programming Language")
        Title("Hour of Code: Code with Mary")
        TrackingImage("http://code.org/api/hour/begin_quorum.png/")
        Part7TheEndOfTheWorld()
        QuorumReview()
        TryItYourself()
    end

    private action Part7TheEndOfTheWorld
        Section("Part 7: The End of the World")
        Video("//www.youtube.com/embed/6G5Vou8oojQ?rel=0", "Coding Quorum with Mary (Day 7)")
    end

    private action QuorumReview
        Section("Quorum Review")
        Slides()
        Slide("Hour of Code Review - Variables")
        Paragraph("Variables are containers for information.")
        Paragraph("To create a variable, declare the type of the variable followed by the name.")
        Paragraph("To assign a value into a variable, use the "):Code("="):Text(" operator.")
        Paragraph("There are four main types of variables in Quorum, each for specific kinds of data:")
        Paragraph():Code("text"):Text(" for any number of characters")
        Paragraph():Code("integer"):Text(" for positive and negative whole numbers")
        Paragraph():Code("number"):Text(" for values with a demical point")
        Paragraph():Code("boolean"):Text(" for true or false values.")
        Paragraph("When creating a variable name, always start it with a letter (usually lower case, but this is not required).")
        Paragraph("More information on variables can be found "):Link("here", "http://quorumlanguage.com/documents/syntax/types.php"):Text(".")
        Slide("Hour of Code Review - Output/Say Statements")
        Paragraph("An "):Code("output"):Text(" statement will print text on the screen.")
        Paragraph("A "):Code("say"):Text(" statements will instruct the computer to speak the expression aloud.")
        Paragraph("Note that some browsers do not support the "):Code("say"):Text(" feature in Quorum's online mode.")
        Slide("Hour of Code Review - If Statements")
        Paragraph("Use an "):Code("if"):Text(" statement to have the computer decide whether or not to run certain code.")
        Paragraph("An "):Code("if"):Text(" statement requires a condition to be evaluated (variable > 5, variable = 5, etc.) and an "):Code("end"):Text(" statement to mark the end of the code block.")
        Paragraph("An "):Code("if"):Text(" statement can optionally contain an "):Code("elseif"):Text(" statement to test another condition or a default "):Code("else"):Text(" statement (or both) to handle any other possibility not listed.")
        Paragraph("More information on "):Code("if"):Text(" statements can be found "):Link("here", "http://quorumlanguage.com/documents/syntax/if.php"):Text(".")
        Slide("Hour of Code Review - Repeat")
        Paragraph("When we want to run a section of code repeatedly, we use a "):Code("repeat"):Text(" statement to create a loop.")
        Paragraph("Like an "):Code("if"):Text(" statement, a "):Code("repeat"):Text(" statement requires a condition for stopping and an "):Code("end"):Text(" statement.")
        Paragraph("We specify the condition for stopping the loop by using one of these formats:")
        Paragraph():Code("repeat {number} times"):Text(",")
        Paragraph():Code("repeat while {condition}"):Text(" or")
        Paragraph():Code("repeat until {condition}"):Text(".")
        Paragraph("More information on repeat loops can be found "):Link("here", "http://quorumlanguage.com/documents/syntax/repeat.php"):Text(".")
        Slide("Hour of Code Review - Actions")
        Paragraph("Actions are used to reduce the amount of duplicate code in a program and to make it easier to read.")
        Paragraph("To create an action, use the keyword "):Code("action"):Text(" followed by the action's name, which usually starts with a capital letter.")
        Paragraph("The computer always starts executing a program at the "):Code("Main"):Text(" action, but if the program has only one action, Quorum will automatically insert the program code into a "):Code("Main"):Text(" action.")
        Paragraph("If a program has actions besides "):Code("Main"):Text(", the action "):Code("Main"):Text(" must be defined somewhere in the program.")
        Paragraph("To execute an action at a particular point in the program, type the name of the action followed by parentheses.")
        Paragraph("More information on actions can be found "):Link("here", "http://quorumlanguage.com/documents/syntax/actions.php"):Text(".")
    end

    private action TryItYourself
        Section("Try it Yourself")
        CodeEditorWithCode("Type your Code Here!", "")
    end
end
