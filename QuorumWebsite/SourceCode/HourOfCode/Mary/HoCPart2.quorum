use Libraries.Web.Page.QuorumPage

/*
    Hour of Code: Code with Mary.
    Converted from the old Lesson page by plan 13's generator: the same
    words, now without Tailwind.
*/
class HoCPart2 is QuorumPage
    // A double quote, for code and words that hold one.
    text dq = ""

    on create
        SetLocation("hourofcode/part2.html")
        // The name lists and links use, and the series and track it belongs
        // to: its section and picture.
        SetShortTitle("Part 2: Sayin' Stuff")
        SetSectionName("Code With Mary")
        // For search engines and link previews, and what lists of pages say.
        SetDescription("Join Mary in her adventure learning the Quorum programming language.")
        SetSummary("first steps in Quorum")
    end

    action Setup
        dq = dq:GetDoubleQuote()
        SetWebPageTitle("Hour of Code: Part 2 | Quorum Programming Language")
        Title("Hour of Code: Code with Mary")
        TrackingImage("http://code.org/api/hour/begin_quorum.png/")
        Part2SayinStuff()
        NumberVaribles()
        TryItYourself()
    end

    private action Part2SayinStuff
        Section("Part 2: Sayin' Stuff")
        Video("//www.youtube.com/embed/jiBoy-YndQw?rel=0", "Coding Quorum with Mary (Day 2)")
    end

    private action NumberVaribles
        Section("Number Varibles")
        Slides()
        Slide("Number Variables")
        Paragraph("Another type of variable often used in programming is a real (or decimal) number. In Quorum to create this type of variable we use the keyword "):Code("number"):Text(".")
        Paragraph("A "):Code("number"):Text(" variable holds numeric values that can include decimal places such as 8.3439 or 42.0 or even 19.")
        Paragraph("Unlike text variables, we never use double quotes when storing a number, we just type it.")
        Paragraph("Create a number variable with the following code: "):Code("number pi = 3.14159"):Text(" then move to the next slide.")
        Slide("Arithmetic with Number Variables")
        Paragraph("We can do arithmetic calculations with "):Code("number"):Text(" variables, just like we would on the numbers themselves.")
        Paragraph("The computer substitutes the actual number in the variable into the formula and performs the calculation.")
        Paragraph("For example, if we make a new variable that holds the radius of a circle, then we can calculate its area using the formula area = pi X radius X radius. On a computer, the multiplication operator is the "):Code("*"):Text(".")
        Paragraph("Create a variable to hold your circle's radius: "):Code("number radius = 3"):Text(" and then calculate the area: "):Code("number area = pi * radius * radius")
        Slide("Make the Computer Talk with: Say")
        Paragraph("Quorum has a built in feature to instruct the computer to say things out loud. This is done by using the keyword "):Code("say"):Text(" followed by whatever we want it to say.")
        Paragraph("Just like with output statements, the computer can say the contents of a variable or a string that we type in.")
        Paragraph("Note: Say statements may not work with all web browsers.")
        Paragraph("Tell the computer to say the result of the area calculation you just completed by typing a new line: "):Code("say " + dq + "The area is " + dq + " + area"):Text(" followed by "):Code("output " + dq + "The area is " + dq + " + area"):Text(" and then Run your code.")
        Slide("Additional Information")
        Paragraph("There are 5 main operators when using numbers: "):Code("+"):Text(" (addition), "):Code("-"):Text(" (subtraction), "):Code("*"):Text(" (multiplication), "):Code("/"):Text(" division and "):Code("mod"):Text(" (modulus).")
        Paragraph("The modulus operator is used for finding the remainder of a division operation, for example: "):Code("15 mod 10"):Text(" will give us a result of 5.")
        Paragraph("One example of how to use the modulus operator is to deterimine if a number is even or odd: "):Code("evenNum mod 2"):Text(" equals 0 and "):Code("oddNum mod 2"):Text(" equals 1.")
        Paragraph("When using "):Code("say"):Text(" or "):Code("output"):Text(" statements, you can concatenate (add) things to be output one after another using the "):Code("+"):Text(" operator, just like in the previous slide.")
    end

    private action TryItYourself
        Section("Try it Yourself")
        CodeEditorWithCode("Type your Code Here!", "")
    end
end
