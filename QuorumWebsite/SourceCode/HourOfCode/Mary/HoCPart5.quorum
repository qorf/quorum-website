use Libraries.Web.Page.QuorumPage

/*
    Hour of Code: Code with Mary.
    Converted from the old Lesson page by plan 13's generator: the same
    words, now without Tailwind.
*/
class HoCPart5 is QuorumPage
    // A double quote, for code and words that hold one.
    text dq = ""

    on create
        SetLocation("hourofcode/part5.html")
        // The name lists and links use, and the series and track it belongs
        // to: its section and picture.
        SetShortTitle("Part 5: Choose My Clothing!")
        SetSectionName("Code With Mary")
        // For search engines and link previews, and what lists of pages say.
        SetDescription("Join Mary in her adventure learning the Quorum programming language.")
        SetSummary("first steps in Quorum")
    end

    action Setup
        dq = dq:GetDoubleQuote()
        SetWebPageTitle("Hour of Code: Part 5 | Quorum Programming Language")
        Title("Hour of Code: Code with Mary")
        TrackingImage("http://code.org/api/hour/begin_quorum.png/")
        Part5ChooseMyClothing()
        PuttingItAllTogether()
        TryItYourself()
    end

    private action Part5ChooseMyClothing
        Section("Part 5: Choose My Clothing!")
        Video("//www.youtube.com/embed/xZJCkKSXmq4?rel=0", "Coding Quorum with Mary (Day 5)")
    end

    private action PuttingItAllTogether
        Section("Putting it all together!")
        Slides()
        Slide("Putting It All Together")
        Paragraph("We've learned quite a bit up to this point and now it's time use all of our new skills to write a program that will detect if a number is even or odd.")
        Paragraph("We are going to test a range of numbers, so we need to loop from a starting number to a stopping number.")
        Subsection("Try it!")
        Paragraph("First create a number variable called "):Code("testNumber"):Text(" and set it to your starting number.")
        Paragraph("Next, set up a repeat loop using "):Code("repeat until"):Text(" and for the condition specify the number to stop at.")
        Paragraph("Finally, don't forget to include "):Code("end"):Text(" to mark the end of the loop. Move on to the next slide when you're done.")
        Slide("Implementing the Logic: Part 1")
        Paragraph("Now that we have the "):Code("repeat"):Text(" loop set up, we need to complete the code block to repeat inside the loop.")
        Paragraph("We will use the modulus operator "):Code("mod"):Text(" to determine if a number is even or odd. Remember that the modulus operator returns the remainder when dividing two numbers, so any even number divided by two will have a remainder of 0 and any odd number will have a remainder of 1.")
        Subsection("Try it!")
        Paragraph("Create an "):Code("if"):Text(" statement inside the "):Code("repeat"):Text(" loop checking the modulus of the variable:")
        Paragraph():Code("if testNumber mod 2 = 0")
        Paragraph():Code("end"):Text(" "):Code("end")
        Paragraph("(Then move to the next slide)")
        Slide("Implementing the Logic: Part 2")
        Paragraph("Our "):Code("if"):Text(" statement is now set up for even numbers. If we want alternative instructions to run if the number is odd, we need some kind of "):Code("else"):Text(" condition as well.")
        Paragraph("Since there are only two possibilities (even or odd), we can use the simple default "):Code("else"):Text(" statement here.")
        Subsection("Try it!")
        Paragraph("Before the "):Code("end"):Text(" in the "):Code("if"):Text(" statement, insert a line with "):Code("else"):Text(" to set up the block for odd numbers.")
        Paragraph("Now, to increment our testing variable by one on each pass of the loop, insert a line "):Code("testNumber = testNumber + 1"):Text(" just after the end of the "):Code("if"):Text(" block. (Then move to the next slide)")
        Slide("Being Creative")
        Paragraph("So now we have a logical code structure set up to execute different instructions if a number is even or if it is odd inside a repeat loop that will test a range of numbers.")
        Paragraph("All we need to do now is write some instructions inside the code blocks!")
        Paragraph("For this example, let's just use an "):Code("output"):Text(" statement to print a message depending on whether the number is even or odd. You can also try a "):Code("say"):Text(" statement if you want to hear it. Try something like "):Code("output testNumber + " + dq + " is even." + dq):Text(" in the first block and then Run it.")
        Paragraph("The next slide has the full code for this section...experiment with other ideas yourself.")
        Slide("Example Code")
        Paragraph("number testNumber = 0")
        Paragraph("repeat until testNumber = 10")
        Paragraph("if testNumber mod 2 = 0")
        Paragraph("output testNumber + "):DoubleQuote():Text(" is even"):DoubleQuote()
        Paragraph("else")
        Paragraph("output testNumber + "):DoubleQuote():Text(" is odd"):DoubleQuote()
        Paragraph("end")
        Paragraph("testNumber = testNumber + 1")
        Paragraph("end")
        Paragraph("Mary's full version of the clothing picker can be found "):Link("here", "projects/clothing_picker.zip"):Text(".")
    end

    private action TryItYourself
        Section("Try it Yourself")
        CodeEditorWithCode("Type your Code Here!", "")
    end
end
