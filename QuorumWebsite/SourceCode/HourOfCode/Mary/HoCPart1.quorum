use Libraries.Web.Page.QuorumPage

/*
    Hour of Code: Code with Mary.
    Converted from the old Lesson page by plan 13's generator: the same
    words, now without Tailwind.
*/
class HoCPart1 is QuorumPage
    // A double quote, for code and words that hold one.
    text dq = ""

    on create
        SetLocation("hourofcode/part1.html")
        // The name lists and links use, and the series and track it belongs
        // to: its section and picture.
        SetShortTitle("Part 1: Got a New Gig")
        SetSectionName("Code With Mary")
        // For search engines and link previews, and what lists of pages say.
        SetDescription("Join Mary in her adventure learning the Quorum programming language.")
        SetSummary("first steps in Quorum")
    end

    action Setup
        dq = dq:GetDoubleQuote()
        SetWebPageTitle("Hour of Code: Part 1 | Quorum Programming Language")
        Title("Hour of Code: Code with Mary")
        TrackingImage("http://code.org/api/hour/begin_quorum.png/")
        Part1GotANewGig()
        LearnAboutVariables()
        TryItYourself()
    end

    private action Part1GotANewGig
        Section("Part 1: Got a New Gig")
        Video("//www.youtube.com/embed/pwRc8bjoACw?rel=0", "Coding Quorum with Mary (Day 1)")
    end

    private action LearnAboutVariables
        Section("Learn About Variables")
        Slides()
        Slide("Variables")
        Paragraph("In programming, a variable is a container to store information that can be used at a later time.")
        Paragraph("In Quorum, there are four types of basic variables: text, number, integer and boolean. Each type of variable holds a different kind of information.")
        Paragraph("In this first example, we will create a text variable, which holds a text string of anything you want to type in. We'll explain the other types in the next sections.")
        Paragraph("Notice that a text string is enclosed in two double quotation marks.")
        Slide("Creating Variables")
        Paragraph("To create a variable in Quorum, we start by telling the computer what type of variable we want to make, in this case it's a "):Code("text"):Text(" variable, followed by a space and a name for the variable.")
        Paragraph("The important thing to remember about naming a variable is that a variable needs to start with a letter. After that, you can have numbers or more letters in the name.")
        Slide("Storing Text in Variables: Literals")
        Paragraph("Now we have made a variable named "):Code("dna"):Text(", but we haven't stored any information in it yet, so it's empty.")
        Paragraph("To store a value into a variable we use the "):Code("="):Text(" operator, followed by the information we want stored.")
        Paragraph("For this example, let's store the text string "):DoubleQuote():Text("GATTACA"):DoubleQuote():Text(" in our "):Code("dna"):Text(" variable.")
        Paragraph("Remember to put double quotes around the string we're storing in a text variable to tell the computer we want to store exactly what we typed.")
        Paragraph("Try it!")
        Paragraph("Store the text "):DoubleQuote():Text("GATTACA"):DoubleQuote():Text(" to the "):Code("dna"):Text(" variable: "):Code("text dna = " + dq + "GATTACA" + dq):Text(" then go to the next slide.")
        Slide("Using Variables for Output")
        Paragraph("Now that we've stored something in our variable, we can refer to its contents whenever we need to by using the variable name.")
        Paragraph("To demonstrate this, let's take what we have stored in our variable and display it to the screen.")
        Paragraph("In Quorum, to output information to the screen we type the word "):Code("output"):Text(" followed by a space and then whatever we want to show up on screen.")
        Paragraph("Try it!")
        Paragraph("Output the contents of the dna variable by typing "):Code("output dna"):Text(" on a new second line and hit the green Run button to see the output.")
        Slide("Storing Text in Variables: From Variables")
        Paragraph("If we want to assign the value of one variable to another variable, we can use the "):Code("="):Text(" operator to copy the contents.")
        Paragraph("We can also use the "):Code("+"):Text(" operator to put more than one thing into a variable.")
        Paragraph("For "):Code("text"):Text(" variables putting two strings into the same variable puts them one after the other.")
        Paragraph("Try it!")
        Paragraph("Create a new variable called "):Code("text msg"):Text(" and then use the "):Code("="):Text(" operator to put the string and variable "):Code(dq + "Welcome to " + dq + " + dna"):Text(" into it. On the next line, output the msg variable: "):Code("output msg"):Text(".")
        Slide("Additional Information Regarding Variables")
        Paragraph("Names are case sensitive: dna is not the same as DNA.")
        Paragraph("When storing a string into a text variable, be sure to use double quotes.")
        Paragraph("Because variables are just containers, if we change what is stored inside of it we can still use the same output statement and get a different result on screen.")
        Paragraph("If you've been following along, you can test this by changing what is initally stored in the "):Code("dna"):Text(" variable.")
    end

    private action TryItYourself
        Section("Try it Yourself")
        CodeEditorWithCode("Type your Code Here!", "")
    end
end
