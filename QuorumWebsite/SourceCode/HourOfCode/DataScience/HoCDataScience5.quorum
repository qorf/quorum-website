use Libraries.Web.Page.QuorumPage

/*
    Data Science Hour of Code.
    Converted from the old Lesson page by plan 13's generator: the same
    words, now without Tailwind.
*/
class HoCDataScience5 is QuorumPage

    on create
        SetLocation("hourofcode/datascience5.html")
        // The name lists and links use, and the series and track it belongs
        // to: its section and picture.
        SetShortTitle("Customizing the Colors")
        SetSectionName("Data Science")
        // For search engines and link previews, and what lists of pages say.
        SetDescription("Try an accessible data science themed Hour of Code in the Quorum programming language.")
        SetSummary("how to customize the colors in the Chart.")
    end

    action Setup
        SetWebPageTitle("Data Science Hour of Code Activity 5 | Quorum Programming Language")
        Title("Data Science Hour of Code")
        Paragraph("Activity 5: Customizing the Colors")
        Scenario()
        Introduction()
        Instructions()
        Coding()
        Activity()
    end

    private action Scenario
        Section("Scenario:")
        BulletList()
        ListItem("You're a data scientist working with a group of researchers from Antarctica.")
        ListItem("They have collected a bunch of data about "):Link("penguins", "https://allisonhorst.github.io/palmerpenguins/"):Text(", but need help answering questions about it.")
        ListItem("Your job is to make some charts from the data and answer some of their questions.")
    end

    private action Introduction
        Section("Introduction:")
        Paragraph("You can select many different columns and factors at the same time. This breaks our data down into more and more groups, which each have their own color assigned so that we can differentiate them in the Chart. The first column we select is plotted against each of the other selected columns, and those sets are separated into groups based on the selected factors. So if we select Columns bill_depth and bill_length, and then we select Factors species and island, we end up getting 5 total groups of data (Note: not all of the species live on each island). Each of these comparisons is called a Series and is listed in our Legend. The points for each Series have a unique color, that way you can compare the trends. In this case, the default colors used are Dark Blue, Light Blue, Green, Teal and Purple. If you don't like these colors, there are many color palettes to choose from.")
        Table("Sample of Penguins2.CSV file")
        TableHeader():Cell("species"):Cell("island"):Cell("bill_depth"):Cell("bill_length"):Cell("flipper_length")
        TableRow():Cell("Adelie"):Cell("Torgersen"):Cell("18.7"):Cell("39.1"):Cell("181")
        TableRow():Cell("Adelie"):Cell("Biscoe"):Cell("18.3"):Cell("37.8"):Cell("174")
        TableRow():Cell("Adelie"):Cell("Dream"):Cell("18.5"):Cell("36.8"):Cell("193")
        TableRow():Cell("Gentoo"):Cell("Biscoe"):Cell("13.2"):Cell("46.1"):Cell("211")
        TableRow():Cell("Chinstrap"):Cell("Dream"):Cell("17.9"):Cell("46.5"):Cell("192")
    end

    private action Instructions
        Section("Instructions:")
        Paragraph("In the code editor below, we have a program that makes a Chart with two Series. Take code blocks from the palette and place them below where we make the Chart object but before we Display it.")
        NumberedList()
        ListItem():Strong("Use the block(s) in the palette on the left.")
        ListItem():Strong("Place the 'chart:SetColorPaletteToCalm()' block below the 'ScatterPlot chart = frame:ScatterPlot()' block in the block editor.")
        ListItem():Strong("Run the program.")
        ListItem():Strong("To try other color options: stop the program, delete the block you added to the block editor and place one of the other blocks from the palette in the same location.")
        ListItem():Strong("Use the chart in the canvas to answer the questions in the Activity section.")
    end

    private action Coding
        Section("Coding:")
        BlockEditor("Main.quorum", "html/hourofcode/datascience/datascience5.quorum", "palette/dataScience5.xml", true, true)
    end

    private action Activity
        Section("Activity:")
        Paragraph("Use the chart(s) you've created in the "):Emphasis("Coding"):Text(" section to answer a few questions.")
        Quiz("l5")
        QuizChoice("1. Which color palette was easiest to distinguish the different groups?", "")
        QuizOption("Default - Colorgorical")
        QuizOption("Calm")
        QuizOption("Disturbing")
        QuizOption("Exciting")
        QuizOption("Magma")
        QuizOption("Playful")
        QuizOption("Serious")
        QuizChoice("2. What's your favorite color palette?", "")
        QuizOption("Default - Colorgorical")
        QuizOption("Calm")
        QuizOption("Disturbing")
        QuizOption("Exciting")
        QuizOption("Magma")
        QuizOption("Playful")
        QuizOption("Serious")
        QuizChoice("3. What's your least favorite color palette?", "")
        QuizOption("Default - Colorgorical")
        QuizOption("Calm")
        QuizOption("Disturbing")
        QuizOption("Exciting")
        QuizOption("Magma")
        QuizOption("Playful")
        QuizOption("Serious")
        QuizCheck("Check Answers")
    end
end
