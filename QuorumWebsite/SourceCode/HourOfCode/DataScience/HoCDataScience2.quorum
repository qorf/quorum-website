use Libraries.Web.Page.QuorumPage

/*
    Data Science Hour of Code.
    Converted from the old Lesson page by plan 13's generator: the same
    words, now without Tailwind.
*/
class HoCDataScience2 is QuorumPage
    // A double quote, for code and words that hold one.
    text dq = ""

    on create
        SetLocation("hourofcode/datascience2.html")
        // The name lists and links use, and the series and track it belongs
        // to: its section and picture.
        SetShortTitle("Labeling a Chart")
        SetSectionName("Data Science")
        // For search engines and link previews, and what lists of pages say.
        SetDescription("Try an accessible data science themed Hour of Code in the Quorum programming language.")
        SetSummary("how to customize the labels on a Chart.")
    end

    action Setup
        dq = dq:GetDoubleQuote()
        SetWebPageTitle("Data Science Hour of Code Activity 2 | Quorum Programming Language")
        Title("Data Science Hour of Code")
        Paragraph("Activity 2: Labeling a Chart")
        Scenario()
        Introduction()
        Instructions()
        Coding()
        Activity()
    end

    private action Scenario
        Section("Scenario:")
        BulletList()
        ListItem("You're a data scientist working with a group of researchers from Antarctica.")
        ListItem("They have collected a bunch of data about "):Link("penguins", "https://allisonhorst.github.io/palmerpenguins/"):Text(", but need help answering questions about it.")
        ListItem("Your job is to make some charts from the data and answer some of their questions.")
    end

    private action Introduction
        Section("Introduction:")
        Paragraph("Now we can investigate our data using a Scatter Plot instead of just looking at columns and rows in a spreadsheet. This can be helpful in exploring the relationship between two variables by plotting them on the X and Y axes. But before we move on, we should make sure we are using good labels on our chart. Looking at the same"):Link("Penguins1.csv", "/data/Penguins1.csv"):Text(" dataset, you might notice that the headers are sort of funny to read; 'bill_depth' and 'bill_length'. These headers are used for the labels of the X and Y axes when we make our chart by default, but we can make them (and the title/subtitle at the top) say whatever we want.")
        Table("Sample of Penguins1.CSV file")
        TableHeader():Cell("bill_depth"):Cell("bill_length")
        TableRow():Cell("18.7"):Cell("39.1")
        TableRow():Cell("18.3"):Cell("37.8")
        TableRow():Cell("18.5"):Cell("36.8")
        TableRow():Cell("13.2"):Cell("46.1")
        TableRow():Cell("17.9"):Cell("46.5")
    end

    private action Instructions
        Section("Instructions:")
        Paragraph("In the code editor below, we have a program that creates a Chart with default labels. Take code blocks from the palette and place them below where we make the Chart object but before we Display it.")
        NumberedList()
        ListItem():Strong("Use the block(s) in the palette on the left.")
        ListItem():Strong("Place the 'chart:SetTitle(" + dq + "Penguins" + dq + ")' block below the 'ScatterPlot chart = frame:ScatterPlot()' block in the block editor.")
        ListItem():Strong("Place the 'chart:SetSubtitle(" + dq + "Bill Depth vs Bill Length" + dq + ")' block below the 'ScatterPlot chart = frame:ScatterPlot()' block in the block editor.")
        ListItem():Strong("Place the 'chart:SetXAxisTitle(" + dq + "Bill Depth" + dq + ")' block below the 'ScatterPlot chart = frame:ScatterPlot()' block in the block editor.")
        ListItem():Strong("Place the 'chart:SetYAxisTitle(" + dq + "Bill Length" + dq + ")' block below the 'ScatterPlot chart = frame:ScatterPlot()' block in the block editor.")
        ListItem():Strong("Run the program.")
        ListItem():Strong("Use the chart in the canvas to answer the questions in the Activity section.")
    end

    private action Coding
        Section("Coding:")
        BlockEditor("Main.quorum", "html/hourofcode/datascience/datascience2.quorum", "palette/dataScience2.xml", true, true)
    end

    private action Activity
        Section("Activity:")
        Paragraph("Use the chart(s) you've created in the "):Emphasis("Coding"):Text(" section to answer a few questions.")
        Quiz("l2")
        QuizChoice("1. What variable is shown on the X axis?", "Bill Depth")
        QuizOption("Bill Depth")
        QuizOption("Bill Length")
        QuizChoice("2. What variable is shown on the Y axis?", "Bill Length")
        QuizOption("Bill Depth")
        QuizOption("Bill Length")
        QuizCheck("Check Answers")
    end
end
