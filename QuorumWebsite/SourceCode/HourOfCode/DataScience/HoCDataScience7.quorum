use Libraries.Web.Page.QuorumPage

/*
    Data Science Hour of Code.
    Converted from the old Lesson page by plan 13's generator: the same
    words, now without Tailwind.
*/
class HoCDataScience7 is QuorumPage
    // A double quote, for code and words that hold one.
    text dq = ""

    on create
        SetLocation("hourofcode/datascience7.html")
        // The name lists and links use, and the series and track it belongs
        // to: its section and picture.
        SetShortTitle("Trying Other Charts")
        SetSectionName("Data Science")
        // For search engines and link previews, and what lists of pages say.
        SetDescription("Try an accessible data science themed Hour of Code in the Quorum programming language.")
        SetSummary("how to look at data with different Chart types.")
    end

    action Setup
        dq = dq:GetDoubleQuote()
        SetWebPageTitle("Data Science Hour of Code Activity 7 | Quorum Programming Language")
        Title("Data Science Hour of Code")
        Paragraph("Activity 7: Trying Other Charts")
        Scenario()
        Introduction()
        Instructions()
        Coding()
        Activity()
    end

    private action Scenario
        Section("Scenario:")
        BulletList()
        ListItem("You're a data scientist working with a group of researchers from Antarctica.")
        ListItem("They have collected a bunch of data about "):Link("penguins", "https://allisonhorst.github.io/palmerpenguins/"):Text(", but need help answering questions about it.")
        ListItem("Your job is to make some charts from the data and answer some of their questions.")
    end

    private action Introduction
        Section("Introduction:")
        Paragraph("There are a lot of chart types that can help us to answer different questions. Instead of making a Scatter Plot, let's try making some other chart types from the same data. Try making a Bar Chart, Box Plot, Histogram and Pie Chart. Each of these charts will show the same data from our "):Link("Penguins2.csv", "/data/Penguins2.csv"):Text(" but presents it in a different way.")
        Table("Sample of Penguins2.CSV file")
        TableHeader():Cell("species"):Cell("island"):Cell("bill_depth"):Cell("bill_length"):Cell("flipper_length")
        TableRow():Cell("Adelie"):Cell("Torgersen"):Cell("18.7"):Cell("39.1"):Cell("181")
        TableRow():Cell("Adelie"):Cell("Biscoe"):Cell("18.3"):Cell("37.8"):Cell("174")
        TableRow():Cell("Adelie"):Cell("Dream"):Cell("18.5"):Cell("36.8"):Cell("193")
        TableRow():Cell("Gentoo"):Cell("Biscoe"):Cell("13.2"):Cell("46.1"):Cell("211")
        TableRow():Cell("Chinstrap"):Cell("Dream"):Cell("17.9"):Cell("46.5"):Cell("192")
    end

    private action Instructions
        Section("Instructions:")
        Paragraph("In the code editor below, we have a similar program to the last lesson, except we've removed the code black that makes our chart a Scatter Plot. Add a code block from the palette below and place it above the other blocks that reference "):Emphasis("chart"):Text(".")
        NumberedList()
        ListItem():Strong("Use the block(s) in the palette on the left.")
        ListItem():Strong("Place the 'BarChart chart = frame:BarChart()' block below the 'frame:AddSelectedFactors(" + dq + "island" + dq + ")' block in the block editor.")
        ListItem():Strong("Run the program.")
        ListItem():Strong("Hint: You may need to try different Chart types to find the answers to the questions below.")
        ListItem():Strong("Use the chart in the canvas to answer the questions in the Activity section.")
        ListItem():Strong("To try other chart types: stop the program, delete the block you added to the block editor and place one of the other blocks from the palette in the same location.")
        ListItem():Strong("Use the new chart in the canvas to answer the questions in the Activity section.")
    end

    private action Coding
        Section("Coding:")
        BlockEditor("Main.quorum", "html/hourofcode/datascience/datascience7.quorum", "palette/dataScience7.xml", true, true)
    end

    private action Activity
        Section("Activity:")
        Paragraph("Use the chart(s) you've created in the "):Emphasis("Coding"):Text(" section to answer a few questions.")
        Quiz("l7")
        QuizChoice("1. Which island has the least combined bill length?", "Torgersen")
        QuizOption("Biscoe")
        QuizOption("Dream")
        QuizOption("Torgersen")
        QuizChoice("2. Which island has largest range of bill length values?", "Biscoe")
        QuizOption("Biscoe")
        QuizOption("Dream")
        QuizOption("Torgersen")
        QuizChoice("3. Which bin has the highest frequency for the Torgersen Bill Length subchart?", "40 to 60")
        QuizOption("0 to 20")
        QuizOption("20 to 40")
        QuizOption("40 to 60")
        QuizChoice("4. What percentage of the data was from Dream island?", "Biscoe")
        QuizOption("Biscoe")
        QuizOption("Dream")
        QuizOption("Torgersen")
        QuizCheck("Check Answers")
    end
end
