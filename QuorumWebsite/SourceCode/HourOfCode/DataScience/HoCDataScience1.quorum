use Libraries.Web.Page.QuorumPage

/*
    Data Science Hour of Code.
    Converted from the old Lesson page by plan 13's generator: the same
    words, now without Tailwind.
*/
class HoCDataScience1 is QuorumPage

    on create
        SetLocation("hourofcode/datascience1.html")
        // The name lists and links use, and the series and track it belongs
        // to: its section and picture.
        SetShortTitle("Displaying a Chart")
        SetSectionName("Data Science")
        // For search engines and link previews, and what lists of pages say.
        SetDescription("Try an accessible data science themed Hour of Code in the Quorum programming language.")
        SetSummary("how to display a Chart.")
    end

    action Setup
        SetWebPageTitle("Data Science Hour of Code Activity 1 | Quorum Programming Language")
        Title("Data Science Hour of Code")
        Paragraph("Activity 1: Displaying a Chart")
        Scenario()
        Introduction()
        Instructions()
        Coding()
        Activity()
    end

    private action Scenario
        Section("Scenario:")
        BulletList()
        ListItem("You're a data scientist working with a group of researchers from Antarctica.")
        ListItem("They have collected a bunch of data about "):Link("penguins", "https://allisonhorst.github.io/palmerpenguins/"):Text(", but need help answering questions about it.")
        ListItem("Your job is to make some charts from the data and answer some of their questions.")
    end

    private action Introduction
        Section("Introduction:")
        OutsideImage("https://code.org/api/hour/begin_quorum_penguin.png", "Tracking Pixel for Code.org")
        Paragraph("Welcome to our Data Science Hour of Code. Today, we are going to use charts to explore data and answer some questions. A dataset is typically a large set of numbers or values. Often, these would be presented in a table or spreadsheet. For example, below we have a few sample rows and columns from a file called "):Link("Penguins1.csv.", "/data/Penguins1.csv"):Text(" When you only have a few rows of data, you might be able to examine the table and find some information. However, when you have hundreds of rows, we might want to represent our data in a chart.")
        Table("Sample of Penguins1.CSV file")
        TableHeader():Cell("bill_depth"):Cell("bill_length")
        TableRow():Cell("18.7"):Cell("39.1")
        TableRow():Cell("18.3"):Cell("37.8")
        TableRow():Cell("18.5"):Cell("36.8")
        TableRow():Cell("13.2"):Cell("46.1")
        TableRow():Cell("17.9"):Cell("46.5")
    end

    private action Instructions
        Section("Instructions:")
        Paragraph("In the code editor below, we have a program that reads in this file to a DataFrame and makes a Chart. Take code blocks from the palette and place them at the bottom of the program.")
        NumberedList()
        ListItem():Strong("Use the block(s) in the palette on the left.")
        ListItem():Strong("Place the 'chart:Display()' block below the 'chart:ShowLegend(false)' block at the bottom of the block editor on the right.")
        ListItem():Strong("Run the program.")
        ListItem():Strong("Use the chart in the canvas to answer the questions in the Activity section.")
    end

    private action Coding
        Section("Coding:")
        BlockEditor("Main.quorum", "html/hourofcode/datascience/datascience1.quorum", "palette/dataScience1.xml", true, true)
    end

    private action Activity
        Section("Activity:")
        Paragraph("Use the chart(s) you've created in the "):Emphasis("Coding"):Text(" section to answer a few questions.")
        Quiz("l1")
        QuizChoice("1. What's the largest bill length?", "59.6")
        QuizOption("17")
        QuizOption("21.5")
        QuizOption("46")
        QuizOption("59.6")
        QuizChoice("2. What's the largest bill depth?", "21.5")
        QuizOption("17")
        QuizOption("21.5")
        QuizOption("46")
        QuizOption("59.6")
        QuizCheck("Check Answers")
    end
end
