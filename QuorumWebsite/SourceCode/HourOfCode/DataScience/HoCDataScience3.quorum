use Libraries.Web.Page.QuorumPage

/*
    Data Science Hour of Code.
    Converted from the old Lesson page by plan 13's generator: the same
    words, now without Tailwind.
*/
class HoCDataScience3 is QuorumPage
    // A double quote, for code and words that hold one.
    text dq = ""

    on create
        SetLocation("hourofcode/datascience3.html")
        // The name lists and links use, and the series and track it belongs
        // to: its section and picture.
        SetShortTitle("Selecting the Data")
        SetSectionName("Data Science")
        // For search engines and link previews, and what lists of pages say.
        SetDescription("Try an accessible data science themed Hour of Code in the Quorum programming language.")
        SetSummary("how to select different columns to display.")
    end

    action Setup
        dq = dq:GetDoubleQuote()
        SetWebPageTitle("Data Science Hour of Code Activity 3 | Quorum Programming Language")
        Title("Data Science Hour of Code")
        Paragraph("Activity 3: Selecting the Data")
        Scenario()
        Introduction()
        Instructions()
        Coding()
        Activity()
    end

    private action Scenario
        Section("Scenario:")
        BulletList()
        ListItem("You're a data scientist working with a group of researchers from Antarctica.")
        ListItem("They have collected a bunch of data about "):Link("penguins", "https://allisonhorst.github.io/palmerpenguins/"):Text(", but need help answering questions about it.")
        ListItem("Your job is to make some charts from the data and answer some of their questions.")
    end

    private action Introduction
        Section("Introduction:")
        Paragraph("Now that we're getting the hang of it, we can start to explore more data. Often times, data scientist have large datasets with many different columns, and they might investigate how different variables have different relationships. In the Table below, we can see a sample of "):Link("Penguins2.csv", "/data/Penguins2.csv"):Text(". This dataset is a lot like our Penguins1.csv, except it has a few more columns. For each entry, we can look at the species of the penguin (Adelie, Gentoo, Chinstrap), which island it lives on (Torgersen, Biscoe, Dream), and some measurements like bill length, bill depth and flipper length.")
        Table("Sample of Penguins2.CSV file")
        TableHeader():Cell("species"):Cell("island"):Cell("bill_depth"):Cell("bill_length"):Cell("flipper_length")
        TableRow():Cell("Adelie"):Cell("Torgersen"):Cell("18.7"):Cell("39.1"):Cell("181")
        TableRow():Cell("Adelie"):Cell("Biscoe"):Cell("18.3"):Cell("37.8"):Cell("174")
        TableRow():Cell("Adelie"):Cell("Dream"):Cell("18.5"):Cell("36.8"):Cell("193")
        TableRow():Cell("Gentoo"):Cell("Biscoe"):Cell("13.2"):Cell("46.1"):Cell("211")
        TableRow():Cell("Chinstrap"):Cell("Dream"):Cell("17.9"):Cell("46.5"):Cell("192")
    end

    private action Instructions
        Section("Instructions:")
        Paragraph("In the code editor below, we have a program that makes a Chart. Take code blocks from the palette and place them below where we Load the .csv, but before we make the Chart object.")
        NumberedList()
        ListItem():Strong("Use the block(s) in the palette on the left.")
        ListItem():Strong("Place the 'frame:AddSelectedColumns(" + dq + "bill_depth,bill_length,flipper_length" + dq + ")' block below the 'frame:Load(" + dq + "data/Penguins2.csv" + dq + ")' block in the block editor.")
        ListItem():Strong("Run the program.")
        ListItem():Strong("Use the chart in the canvas to answer the questions in the Activity section.")
    end

    private action Coding
        Section("Coding:")
        BlockEditor("Main.quorum", "html/hourofcode/datascience/datascience3.quorum", "palette/dataScience3.xml", true, true)
    end

    private action Activity
        Section("Activity:")
        Paragraph("Use the chart(s) you've created in the "):Emphasis("Coding"):Text(" section to answer a few questions.")
        Quiz("l3")
        QuizChoice("1. What's the largest flipper length?", "231")
        QuizOption("35.2")
        QuizOption("59.6")
        QuizOption("172")
        QuizOption("231")
        QuizChoice("2. What's the shortest flipper?", "172")
        QuizOption("35.2")
        QuizOption("59.6")
        QuizOption("172")
        QuizOption("231")
        QuizCheck("Check Answers")
    end
end
