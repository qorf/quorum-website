use Libraries.Web.Page.QuorumPage

/*
    Data Science Hour of Code.
    Converted from the old Lesson page by plan 13's generator: the same
    words, now without Tailwind.
*/
class HoCDataScience4 is QuorumPage
    // A double quote, for code and words that hold one.
    text dq = ""

    on create
        SetLocation("hourofcode/datascience4.html")
        // The name lists and links use, and the series and track it belongs
        // to: its section and picture.
        SetShortTitle("Selecting a Factor")
        SetSectionName("Data Science")
        // For search engines and link previews, and what lists of pages say.
        SetDescription("Try an accessible data science themed Hour of Code in the Quorum programming language.")
        SetSummary("how to split our data into groups based on Factors.")
    end

    action Setup
        dq = dq:GetDoubleQuote()
        SetWebPageTitle("Data Science Hour of Code Activity 4 | Quorum Programming Language")
        Title("Data Science Hour of Code")
        Paragraph("Activity 4: Selecting a Factor")
        Scenario()
        Introduction()
        Instructions()
        Coding()
        Activity()
    end

    private action Scenario
        Section("Scenario:")
        BulletList()
        ListItem("You're a data scientist working with a group of researchers from Antarctica.")
        ListItem("They have collected a bunch of data about "):Link("penguins", "https://allisonhorst.github.io/palmerpenguins/"):Text(", but need help answering questions about it.")
        ListItem("Your job is to make some charts from the data and answer some of their questions.")
    end

    private action Introduction
        Section("Introduction:")
        Paragraph("You may have noticed in our "):Link("Penguins2.csv", "/data/Penguins2.csv"):Text(" dataset, some of the columns have values that are numbers (bill_length, bill_depth, flipper_length) and some have values that are text (species, island). Let's say we wanted to look at the relationship between bill_depth and bill_length, like we did in Activity 1, but we also want to break that data down into smaller groups based a Factor like species. This would show us three comparisons of bill_depth versus bill_length for the Adelie, Gentoo and Chinstrap penguins.")
        Table("Sample of Penguins2.CSV file")
        TableHeader():Cell("species"):Cell("island"):Cell("bill_depth"):Cell("bill_length"):Cell("flipper_length")
        TableRow():Cell("Adelie"):Cell("Torgersen"):Cell("18.7"):Cell("39.1"):Cell("181")
        TableRow():Cell("Adelie"):Cell("Biscoe"):Cell("18.3"):Cell("37.8"):Cell("174")
        TableRow():Cell("Adelie"):Cell("Dream"):Cell("18.5"):Cell("36.8"):Cell("193")
        TableRow():Cell("Gentoo"):Cell("Biscoe"):Cell("13.2"):Cell("46.1"):Cell("211")
        TableRow():Cell("Chinstrap"):Cell("Dream"):Cell("17.9"):Cell("46.5"):Cell("192")
    end

    private action Instructions
        Section("Instructions:")
        Paragraph("In the code editor below, we have a program that makes a Chart looking at Bill Depth vs Bill Length. Take code blocks from the palette and place them below where we Load the .csv, but before we make the Chart object.")
        NumberedList()
        ListItem():Strong("Use the block(s) in the palette on the left.")
        ListItem():Strong("Place the 'frame:AddSelectedFactors(" + dq + "species" + dq + ")' block below the 'frame:Load(" + dq + "data/Penguins2.csv" + dq + ")' block in the block editor.")
        ListItem():Strong("Run the program.")
        ListItem():Strong("Use the chart in the canvas to answer the questions in the Activity section.")
    end

    private action Coding
        Section("Coding:")
        BlockEditor("Main.quorum", "html/hourofcode/datascience/datascience4.quorum", "palette/dataScience4.xml", true, true)
    end

    private action Activity
        Section("Activity:")
        Paragraph("Use the chart(s) you've created in the "):Emphasis("Coding"):Text(" section to answer a few questions.")
        Quiz("l4")
        QuizChoice("1. What's the largest bill length for the Adelie group?", "46")
        QuizOption("21.5")
        QuizOption("46")
        QuizOption("51.3")
        QuizOption("59.6")
        QuizChoice("2. What's the smallest bill length for the Chinstrap group?", "40.9")
        QuizOption("16.6")
        QuizOption("35.2")
        QuizOption("40.9")
        QuizOption("46.6")
        QuizChoice("3. What's the largest bill depth for the Gentoo group?", "17.3")
        QuizOption("15.4")
        QuizOption("17.3")
        QuizOption("19.6")
        QuizOption("21.5")
        QuizCheck("Check Answers")
    end
end
