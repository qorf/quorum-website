use Libraries.Web.Page.QuorumPage

/*
    Data Science Hour of Code.
    Converted from the old Lesson page by plan 13's generator: the same
    words, now without Tailwind.
*/
class HoCDataScience6 is QuorumPage

    on create
        SetLocation("hourofcode/datascience6.html")
        // The name lists and links use, and the series and track it belongs
        // to: its section and picture.
        SetShortTitle("Separating into Sub-Charts")
        SetSectionName("Data Science")
        // For search engines and link previews, and what lists of pages say.
        SetDescription("Try an accessible data science themed Hour of Code in the Quorum programming language.")
        SetSummary("how to separate the Chart into several Sub-Charts.")
    end

    action Setup
        SetWebPageTitle("Data Science Hour of Code Activity 6 | Quorum Programming Language")
        Title("Data Science Hour of Code")
        Paragraph("Activity 6: Separating into Sub-Charts")
        Scenario()
        Introduction()
        Instructions()
        Coding()
        Activity()
    end

    private action Scenario
        Section("Scenario:")
        BulletList()
        ListItem("You're a data scientist working with a group of researchers from Antarctica.")
        ListItem("They have collected a bunch of data about "):Link("penguins", "https://allisonhorst.github.io/palmerpenguins/"):Text(", but need help answering questions about it.")
        ListItem("Your job is to make some charts from the data and answer some of their questions.")
    end

    private action Introduction
        Section("Introduction:")
        Paragraph("In Activity 4, we made a chart separating our penguins into three groups based on their species. The chart we made had a cluster of data points for each species that didn't overlap, so it was pretty easy to see all the points in each group. Sometimes, the data can look pretty messy when we plot it. For example, if you run the program below, we are separating the penguins into three groups based on the island they live on. You'll notice that we can kind of tell where the Biscoe and Dream groups are on the plot, but the Torgersen group is overlapped and hard to examine. In this case, it can be very useful to split our groups of data into their own Sub-Charts.")
        Table("Sample of Penguins2.CSV file")
        TableHeader():Cell("species"):Cell("island"):Cell("bill_depth"):Cell("bill_length"):Cell("flipper_length")
        TableRow():Cell("Adelie"):Cell("Torgersen"):Cell("18.7"):Cell("39.1"):Cell("181")
        TableRow():Cell("Adelie"):Cell("Biscoe"):Cell("18.3"):Cell("37.8"):Cell("174")
        TableRow():Cell("Adelie"):Cell("Dream"):Cell("18.5"):Cell("36.8"):Cell("193")
        TableRow():Cell("Gentoo"):Cell("Biscoe"):Cell("13.2"):Cell("46.1"):Cell("211")
        TableRow():Cell("Chinstrap"):Cell("Dream"):Cell("17.9"):Cell("46.5"):Cell("192")
    end

    private action Instructions
        Section("Instructions:")
        Paragraph("In the code editor below, we have a program that makes a Chart looking at Bill Depth vs Bill Length divided into groups based on Island. Take code blocks from the palette and place them below where we make the Chart object and before we Display the chart.")
        NumberedList()
        ListItem():Strong("Before adding anything, try running the program and inspect the Chart.")
        ListItem():Strong("Stop the program.")
        ListItem():Strong("Use the block(s) in the palette on the left.")
        ListItem():Strong("Place the 'chart:SeparateByFactor()' block below the 'ScatterPlot chart = frame:ScatterPlot()' block in the block editor.")
        ListItem():Strong("Run the program.")
        ListItem():Strong("Use the chart in the canvas to answer the questions in the Activity section.")
    end

    private action Coding
        Section("Coding:")
        BlockEditor("Main.quorum", "html/hourofcode/datascience/datascience6.quorum", "palette/dataScience6.xml", true, true)
    end

    private action Activity
        Section("Activity:")
        Paragraph("Use the chart(s) you've created in the "):Emphasis("Coding"):Text(" section to answer a few questions.")
        Quiz("l6")
        QuizChoice("1. What's the largest bill length for the Torgersen group?", "46")
        QuizOption("21.5")
        QuizOption("46")
        QuizOption("51.3")
        QuizOption("59.6")
        QuizChoice("2. What's the smallest bill depth for the Torgersen group?", "15.9")
        QuizOption("15.4")
        QuizOption("15.9")
        QuizOption("16.6")
        QuizOption("21.5")
        QuizCheck("Check Answers")
    end
end
