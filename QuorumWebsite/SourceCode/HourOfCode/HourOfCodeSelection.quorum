use Libraries.Web.Page.QuorumPage

/*
    The Hour of Code selection page (plan 13 phase 5B): a banner and the three
    Hour of Code tutorials as picture cards.
*/
class HourOfCodeSelection is QuorumPage
    on create
        SetLocation("selection.html")
        SetShortTitle("Hour Of Code Selection Page")
        SetDescription("Learn the Quorum programming language in tracks dedicated to audio or visual games, robotics, or through core computer science principles.")
        SetSummary("This page offers a choice between the Hour of Code Tutorials available.")
    end

    action Setup
        SetWebPageTitle("Hour of Code - Quorum Programming Language")
        Banner("Hour of Code", "Select one of the Quorum Hour of Code Tutorials.", "media/epiq/Yerkes.jpg", "")
        CourseCards()
        CourseCard("Code With Mary", "/hourofcode/part1.html", "media/HourOfCodeDark.png", "", "Learn to code in Quorum with basic lessons hosted by Mary in a video log as she learns to code.")
        CourseCard("Astronomy", "/hourofcode/astro1.html", "media/astro/galaxy.png", "", "Construct a virtual telescope inside a 3D game world and learn how scientists control robotic telescopes.")
        // The old card linked to hourofcode/datascience.html, which does not
        // exist (the user, phase 4, P4-3).
        CourseCard("Data Science", "/hourofcode/datascience1.html", "media/HourOfCodeDark.png", "", "Learn to use Quorum Blocks with some introductory lessons about Data Science.")
    end
end
