use Libraries.Web.Page.QuorumPage

/*
    The block editor's test page (plan 13 phase 5C): the editor with a
    test palette and a Data Science example, across the whole width. The
    old page put the program's display and console in a column of their
    own; the editor now keeps them, as on the home page.
*/
class BlockPage is QuorumPage
    on create
        SetLocation("blocks/blocks.html")
    end

    action Setup
        SetWebPageTitle("Block Editor")
        Title("Use Blocks")
        Paragraph("Use the block editor below")
        BlockEditor("Main.quorum", "html/hourofcode/datascience/datascience1.quorum", "palette/testPalette.xml", true, true)
    end
end
