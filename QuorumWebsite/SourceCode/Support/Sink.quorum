use Libraries.Web.Page.QuorumPage

/*
    Quorum Kitchen Sink page.
    Converted from the old Lesson page by plan 13's generator: the same
    words, now without Tailwind.
*/
class Sink is QuorumPage
    // A double quote, for code and words that hold one.
    text dq = ""

    on create
        SetLocation("sink/Default.html")
        // The name lists and links use, and the series and track it belongs
        // to: its section and picture.
        // For search engines and link previews, and what lists of pages say.
    end

    action Setup
        dq = dq:GetDoubleQuote()
        SetWebPageTitle("Quorum Kitchen Sink Page")
        Title("Quorum Kitchen Sink page")
        HowToInteractWithTheGameUsingAScreenReader()
        Button()
        Checkbox()
        RadioButtons()
        List()
        Tree()
        TabPane()
        Menu()
        Dialog()
        Spreadsheet()
        ProgressBar()
    end

    private action HowToInteractWithTheGameUsingAScreenReader
        Section("How to Interact With the Game Using a Screen Reader")
        Paragraph("To interact with the game in the IDE, press Enter or Space on the 'Enter' button for that game. This will trap focus within the game, so you can use Tab and Shift+Tab to move focus between controls within the game. While in this mode, focus can't be moved away from the game because all of the keyboard input is going to the Quorum program. To move focus away from the game, press Escape; this will stop the focus trap. For example, to use the Checkbox example, run the example, tab back to the button called 'Enter Checkbox Example', press Enter or Space on that button to trap focus, then press Space to toggle the checkbox (Space is the default in Quorum). To leave the example, press Escape.")
        Paragraph("Quorum games allow the use of controls that have focus within the game itself and the default key to move between controls is Tab and Shift + Tab. Online this conflicts with the keys for moving between focus on the page. For example, without focus trapping, pressing tab on a button in the game would both move focus in the game and move you away from the game in the IDE, making interacting with the game much more difficult.")
    end

    private action Button
        Section("Button")
        Paragraph("Button IDE")
        CodeEditorWithCode("", "use Libraries.Game.Game
use Libraries.Interface.Controls.Button
use Libraries.Interface.Layouts.ManualLayout

class Main is Game
    action Main
        StartGame()
    end

    action CreateGame
        ManualLayout layout
        SetLayout(layout)
        Button button
        button:SetName(" + dq + "Click me!" + dq + ")
        button:SetPosition(50, 50)
        SetFocus(button)
        Add(button)
    end
end")
    end

    private action Checkbox
        Section("Checkbox")
        Paragraph("Checkbox IDE")
        CodeEditorWithCode("", "use Libraries.Game.Game
use Libraries.Interface.Controls.Checkbox

class Main is Game
    action Main
        StartGame()
    end

    action CreateGame
        Checkbox box
        box:SetPosition(80, 80)
        box:SetName(" + dq + "My Checkbox" + dq + ")
        box:SetFontSize(30)
        SetFocus(box)
        Add(box)
    end
end")
    end

    private action RadioButtons
        Section("Radio Buttons")
        Paragraph("Radio IDE")
        CodeEditorWithCode("", "use Libraries.Game.Game
use Libraries.Interface.Controls.ButtonGroup
use Libraries.Interface.Controls.RadioButton

class Main is Game
    action Main
        StartGame()
    end

    action CreateGame
        ButtonGroup group

        group:SetName(" + dq + "My Grouping" + dq + ")

        RadioButton button1
        RadioButton button2
        RadioButton button3
        
        group:SetPosition(100, 100)

        group:Add(button1)
        group:Add(button2)
        group:Add(button3)
        Add(group)

        group:Focus()
    end
end")
    end

    private action List
        Section("List")
        Paragraph("List IDE")
        CodeEditorWithCode("", "use Libraries.Game.Game
use Libraries.Interface.Controls.List

class Main is Game
    action Main
        StartGame()
    end

    action CreateGame
        List shoppingList
        shoppingList:SetPosition(300, 200)
    
        shoppingList:Add(" + dq + "Milk" + dq + ")
        shoppingList:Add(" + dq + "Eggs" + dq + ")
        shoppingList:Add(" + dq + "Ham" + dq + ")
        shoppingList:Add(" + dq + "Cheese" + dq + ")

        shoppingList:SetSize(80,80)
    
        SetFocus(shoppingList)
        Add(shoppingList)
    end
end")
    end

    private action Tree
        Section("Tree")
        Paragraph("Tree IDE")
        CodeEditorWithCode("", "use Libraries.Game.Game
use Libraries.Interface.Controls.Tree
use Libraries.Interface.Controls.TreeItem
use Libraries.Interface.Controls.Icon
use Libraries.Game.Graphics.Color
class Main is Game
    action Main
        StartGame()
    end
    action CreateGame
        Color color
        Icon iconA
        Icon iconA_1
        Icon iconB
        Icon iconB_1
        Icon iconB_2
        Icon iconB_2_1
        Icon iconB_2_2
        Icon iconC

        iconA:LoadFilledRectangle(10, 10, color:Red())
        iconA_1:LoadFilledCircle(10, color:CustomColor(1, 0.75, 0.75, 1))
        iconB:LoadFilledRectangle(10, 10, color:Blue())
        iconB_1:LoadFilledCircle(10, color:CustomColor(0, 1, 1, 1))
        iconB_2:LoadFilledCircle(10, color:CustomColor(0.5, 0, 0.5, 1))
        iconB_2_1:LoadFilledCircle(10, color:CustomColor(0.25, 0, 0.25, 1))
        iconB_2_2:LoadFilledCircle(10, color:CustomColor(0.75, 0, 0.75, 1))
        iconC:LoadFilledRectangle(10, 10, color:Green())

        Tree tree
        tree:SetName(" + dq + "Colors" + dq + ")

        TreeItem itemA
        TreeItem itemA_1
        TreeItem itemB
        TreeItem itemB_1
        TreeItem itemB_2
        TreeItem itemB_2_1
        TreeItem itemB_2_2
        TreeItem itemC

        itemA:SetName(" + dq + "Red" + dq + ")
        itemA_1:SetName(" + dq + "Pink" + dq + ")
        itemB:SetName(" + dq + "Blue" + dq + ")
        itemB_1:SetName(" + dq + "Cyan" + dq + ")
        itemB_2:SetName(" + dq + "Purple" + dq + ")
        itemB_2_1:SetName(" + dq + "Dark Purple" + dq + ")
        itemB_2_2:SetName(" + dq + "Light Purple" + dq + ")
        itemC:SetName(" + dq + "Green" + dq + ")

        itemA:SetIcon(iconA)
        itemA_1:SetIcon(iconA_1)
        itemB:SetIcon(iconB)
        itemB_1:SetIcon(iconB_1)
        itemB_2:SetIcon(iconB_2)
        itemB_2_1:SetIcon(iconB_2_1)
        itemB_2_2:SetIcon(iconB_2_2)
        itemC:SetIcon(iconC)

        tree:Add(itemA)
        tree:Add(itemB)
        tree:Add(itemC)

        itemA:Add(itemA_1)
        itemB:Add(itemB_1)
        itemB:Add(itemB_2)
        itemB_2:Add(itemB_2_1)
        itemB_2:Add(itemB_2_2)

        tree:SetPosition(150, 150)
        tree:Resize()
        Add(tree)
        SetFocus(tree)
    end

    action Update(number seconds)
    end
end")
    end

    private action TabPane
        Section("Tab Pane")
        Paragraph("Tab Pane IDE")
        CodeEditorWithCode("", "use Libraries.Game.Game
use Libraries.Interface.Controls.TabPane
use Libraries.Interface.Controls.Tab
use Libraries.Interface.Controls.Icon
use Libraries.Game.Graphics.Drawable
use Libraries.Game.Graphics.Color
use Libraries.Containers.Array

class Main is Game
    action Main
        StartGame()
    end

    action CreateGame
        TabPane pane
        Tab tab1
        Tab tab2
        Tab tab3
        Color color
        
        pane:SetSize(450, 450)
        pane:SetPosition(50, 100)
        Add(pane)
        
        Drawable outline
        outline:LoadRectangle(450, 425, color:Black())
        outline:SetPosition(50, 100)
        Add(outline)
        
        Drawable box
        Drawable circle
        Drawable triangle
        
        box:LoadFilledRectangle(300, 300, color:Red())
        circle:LoadFilledCircle(150, color:Blue())
        triangle:LoadFilledTriangle(0, 0, 300, 0, 150, 300, color:Green())
        
        Icon icon1
        Icon icon2
        Icon icon3
        
        icon1:LoadFilledRectangle(50, 50)
        icon2:LoadFilledCircle(25)
        icon3:LoadFilledTriangle(0, 0, 50, 0, 25, 50)
        
        tab1:SetName(" + dq + "Square" + dq + ")
        tab1:SetRelatedItem(box)
        tab1:SetIcon(icon1)
        
        tab2:SetName(" + dq + "Circle" + dq + ")
        tab2:SetRelatedItem(circle)
        tab2:SetIcon(icon2)
        
        tab3:SetName(" + dq + "Triangle" + dq + ")
        tab3:SetRelatedItem(triangle)
        tab3:SetIcon(icon3)
        
        Array<Tab> tabs
        tabs:Add(tab1)
        tabs:Add(tab2)
        tabs:Add(tab3)
        pane:Add(tabs)
        
        SetFocus(pane)
    end
end")
    end

    private action Menu
        Section("Menu")
        Paragraph("Menu IDE")
        CodeEditorWithCode("", "use Libraries.Game.Game
use Libraries.Interface.Controls.MenuBar
use Libraries.Interface.Controls.MenuItem
use Libraries.Interface.Layouts.FlowLayout
use Libraries.Containers.Array
use Libraries.Game.Graphics.Drawable
use Libraries.Game.Graphics.Color

class Main is Game
    action Main
        StartGame()
    end

    action CreateGame
        FlowLayout flow
        SetLayout(flow)
        
        Array<MenuItem> headers
        MenuBar menu
        
        Drawable triangle
        triangle:LoadFilledTriangle(0, 0, 150, 80, 200, 25)
        triangle:SetPosition(100, 100)
        Add(triangle)

        MenuItem header1        //size
        MenuItem header1_1          //increase size
        MenuItem header1_1_1            //horizontal
        MenuItem header1_1_2            //vertical
        MenuItem header1_1_3            //both
        MenuItem header1_2          //decrease size
        MenuItem header1_2_1            //horizontal
        MenuItem header1_2_2            //vertical
        MenuItem header1_2_3            //both
        
        Array <MenuItem> head1
        Array <MenuItem> head1_1
        Array <MenuItem> head1_2

        head1:Add(header1_1)
        head1:Add(header1_2)
        head1_1:Add(header1_1_1)
        head1_1:Add(header1_1_2)
        head1_1:Add(header1_1_3)
        head1_2:Add(header1_2_1)
        head1_2:Add(header1_2_2)
        head1_2:Add(header1_2_3)
        
        header1:Add(head1)
        header1_1:Add(head1_1)
        header1_2:Add(head1_2)
        headers:Add(header1)
        
        header1:SetName(" + dq + "Size" + dq + ")
        header1_1:SetName(" + dq + "Increase Size" + dq + ")
        header1_1_1:SetName(" + dq + "Horizontal Scale" + dq + ")
        header1_1_2:SetName(" + dq + "Vertical Scale" + dq + ")
        header1_1_3:SetName(" + dq + "Full Scale" + dq + ")
        header1_2:SetName(" + dq + "Decrease Size" + dq + ")
        header1_2_1:SetName(" + dq + "Horizontal Shrink" + dq + ")
        header1_2_2:SetName(" + dq + "Vertical Shrink" + dq + ")
        header1_2_3:SetName(" + dq + "Full Shrink" + dq + ")
        
        MenuItem header2        //rotation
        MenuItem header2_1          //clockwise rotation
        MenuItem header2_1_1            //30 degrees
        MenuItem header2_1_2            //45 degrees
        MenuItem header2_2          //counter-clockwise rotation
        MenuItem header2_2_1            //30 degrees
        MenuItem header2_2_2            //45 degrees
        
        headers:Add(header2)
        header2:Add(header2_1)
        header2:Add(header2_2)
        header2_1:Add(header2_1_1)
        header2_1:Add(header2_1_2)
        header2_2:Add(header2_2_1)
        header2_2:Add(header2_2_2)
        
        header2:SetName(" + dq + "Rotation" + dq + ")
        header2_1:SetName(" + dq + "Clockwise" + dq + ")
        header2_1_1:SetName(" + dq + "30 Degrees" + dq + ")
        header2_1_2:SetName(" + dq + "45 Degrees" + dq + ")
        header2_2:SetName(" + dq + "Counter-Clockwise" + dq + ")
        header2_2_1:SetName(" + dq + "30 Degrees" + dq + ")
        header2_2_2:SetName(" + dq + "45 Degrees" + dq + ")
        
        MenuItem header3        //color
        MenuItem header3_1          //red
        MenuItem header3_2          //green
        MenuItem header3_3          //blue
        
        header3:SetName(" + dq + "Color" + dq + ")
        header3_1:SetName(" + dq + "Red" + dq + ")
        header3_1:SetName(" + dq + "Green" + dq + ")
        header3_2:SetName(" + dq + "Blue" + dq + ")
        
        header3:Add(header3_1)
        header3:Add(header3_2)
        header3:Add(header3_3)
        headers:Add(header3)
        
        MenuItem header4        //reset
        MenuItem header4_1          //reset all
        
        header4:SetName(" + dq + "Reset" + dq + ")
        header4_1:SetName(" + dq + "Reset All" + dq + ")
        
        header4:Add(header4_1)
        headers:Add(header4)
        
        menu:Add(headers)
        Add(menu)
    end
end")
    end

    private action Dialog
        Section("Dialog")
        Paragraph("Dialog IDE")
        CodeEditorWithCode("", "use Libraries.Game.Game
use Libraries.Interface.Controls.Button
use Libraries.Interface.Behaviors.Behavior
use Libraries.Interface.Events.BehaviorEvent
use Libraries.Interface.Controls.Dialog
use Libraries.Interface.Controls.Control
use Libraries.Game.Graphics.Color
use Libraries.Interface.Controls.Icon
use Libraries.Interface.Behaviors.Controls.DialogHideBehavior

class Main is Game, Behavior

    Dialog dialog
    action Main
        StartGame()
    end

    action CreateGame

        // setup dialog
        Dialog dialog        
        Button close
        
        dialog:SetName(" + dq + "My Dialog" + dq + ")
        dialog:SetPixelWidth(300)
        dialog:SetModal(true)

        Color c
        Icon diaIcon
        diaIcon:LoadFilledRectangle(300, 300, c:LightGray())

        Control panel
        panel:SetPercentageWidth(1)
        panel:SetPixelHeight(300)
        panel:Add(diaIcon)
        panel:Add(close)
        dialog:Add(panel)

        DialogHideBehavior behave
        behave:SetDialog(dialog)
        close:SetBehavior(behave)

        close:SetName(" + dq + "Close" + dq + ")
        close:SetPosition(130, 140)

        me:dialog = dialog

        //make button to open dialog
        Button open
        open:SetName(" + dq + "Open Dialog" + dq + ")
        open:SetBehavior(me)
        open:SetPosition(100, 100)

        SetFocus(open)
        Add(open)
    end

    action Run(BehaviorEvent event)
        dialog:Show()
    end

    action Update(number seconds)
    end
end")
    end

    private action Spreadsheet
        Section("Spreadsheet")
        Paragraph("Spreadsheet IDE")
        CodeEditorWithCode("", "use Libraries.Game.Game
use Libraries.Interface.Controls.Spreadsheet
use Libraries.Interface.Controls.Column
use Libraries.Interface.Controls.Cell

class Main is Game

    action Main
        StartGame()
    end

    action CreateGame
    //declarations
        Spreadsheet sheets
        Column colA
        Column colB
        Cell cellA1
        Cell cellA2
        Cell cellB1
        Cell cellB2

    //setting up cells
        cellA1:SetText(" + dq + "A1" + dq + ")
        cellA2:SetText(" + dq + "A2" + dq + ")
        cellB1:SetText(" + dq + "B1" + dq + ")
        cellB2:SetText(" + dq + "B2" + dq + ")

    //position spreadsheet
        sheets:SetPosition(200, 300)

    //Add children where needed
        colA:Add(cellA1)
        colA:Add(cellA2)
        colB:Add(cellB1)
        colB:Add(cellB2)
        sheets:Add(colA)
        sheets:Add(colB)
        SetFocus(sheets)
        Add(sheets)
    end

    action Update(number seconds)
    end
end")
    end

    private action ProgressBar
        Section("Progress Bar")
        Paragraph("Progress Bar IDE")
        CodeEditorWithCode("", "use Libraries.Game.Game
use Libraries.Interface.Controls.ProgressBar
use Libraries.Interface.Layouts.ManualLayout

class Main is Game
    number timePassed = 0
    boolean done = false

    ProgressBar progress
    action Main
        StartGame()
    end

    action CreateGame
        ManualLayout layout
        SetLayout(layout)
        progress:SetPercentageWidth(0.6)
        progress:SetPercentageHeight(0.1)
        progress:SetPercentageX(0.2)
        progress:SetPercentageY(0.4)
        Add(progress)
        SetFocus(progress)
    end

    action Update(number seconds)
        if done return now end
        timePassed = timePassed + seconds
        if timePassed >= 0.1
            timePassed = 0
            progress:SetValue(progress:GetValue()+2.5)
            if progress:GetValue() > 100
                done = true
            end
        end
    end
end")
    end
end
