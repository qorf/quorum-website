use Libraries.Web.Page.QuorumPage

/*
    Run Quorum online.
    Converted from the old Lesson page by plan 13's generator: the same
    words, now without Tailwind.
*/
class StandaloneCompilerPage is QuorumPage

    on create
        SetLocation("standalone.html")
        // The name lists and links use, and the series and track it belongs
        // to: its section and picture.
        SetShortTitle("Standalone Compiler")
        // For search engines and link previews, and what lists of pages say.
        SetDescription("Use an online standalone development environment for the Quorum programming language.")
        SetSummary("running Quorum online.")
    end

    action Setup
        SetWebPageTitle("Standalone Quorum Page - Quorum Programming Language")
        Title("Run Quorum online")
        Paragraph("This is a page for running Quorum online.")
        CodeEditorWithCode("Quorum Online", "")
    end
end
