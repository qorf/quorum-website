use Libraries.Web.Page.QuorumPage

/*
    The page for an address that doesn't exist (plan 13 phase 5D): a banner
    with the rabbit hole and a Go Back tile. Its first words are its title
    (the old page had none).
*/
class Quorum404 is QuorumPage
    on create
        SetLocation("Quorum404.html")
        SetShortTitle("Page Not Found (404 Error)")
        SetSummary("this is the page we receive when there is a request for a page that does not exist.")
    end

    action Setup
        SetWebPageTitle("Page Not Found (404 Error) - Quorum Programming Language")
        Banner("Went down the wrong rabbit hole!", "Uh Oh! Looks like the page you are looking for does not exist.", "media/userInterface/quorumAssets/HOLE 2.png", "")
        BannerChoice("Go Back", "javascript:history.back()", "")
        Paragraph("404")
    end
end
