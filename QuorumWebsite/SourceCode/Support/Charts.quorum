use Libraries.Web.Page.QuorumPage

/*
    Quorum Charts Kitchen Sink Page.
    Converted from the old Lesson page by plan 13's generator: the same
    words, now without Tailwind.
*/
class Charts is QuorumPage

    on create
        SetLocation("charts/Example.html")
        // The name lists and links use, and the series and track it belongs
        // to: its section and picture.
        // For search engines and link previews, and what lists of pages say.
    end

    action Setup
        SetWebPageTitle("Quorum Charts Kitchen Sink Page")
        // Its editors and charts use the charts script.
        UseCharts()
        Title("Quorum Charts Kitchen Sink Page")
        VibrationTest()
        GraphicsObjects()
        Application()
    end

    private action VibrationTest
        Section("Vibration Test")
        Paragraph("This is a section to test a variety of vibrations. Patterns can be made by providing a frequency and time. The frequency is set by an 'on' 'off' repeating pattern (these values can be different, but for this demo they will be evenly distributed). A full cycle is being set by an on then an off and repeats for as many times as it takes to get the desired length.")
        // The two vibration testers, with their own script, as the old page
        // wrote them (a form part isn't needed for a test page).
        Demonstration("charts/vibrationDemo.html")
    end

    private action GraphicsObjects
        Section("Graphics Objects")
        Paragraph("This section includes a chart using ARIA tags for graphics objects.")
        Subsection("Chart Test 1")
        Chart("charts/bar_chart_one_factor.svg")
    end

    private action Application
        Section("Application")
        Paragraph("This section includes a chart using ARIA tags of application at the top level.")
        Subsection("Chart Test 2")
        Chart("charts/bar_chart_two_factor.svg")
    end
end
