use Libraries.Web.Page.QuorumPage

/*
    Quorum Charts: Code.org Examples.
    Converted from the old Lesson page by plan 13's generator: the same
    words, now without Tailwind.
*/
class CodeorgCharts is QuorumPage

    on create
        SetLocation("charts/Codeorg.html")
        // The name lists and links use, and the series and track it belongs
        // to: its section and picture.
        // For search engines and link previews, and what lists of pages say.
    end

    action Setup
        SetWebPageTitle("Quorum Charts Code.org Examples")
        // Its editors and charts use the charts script.
        UseCharts()
        Title("Quorum Charts: Code.org Examples")
        BarCharts()
    end

    private action BarCharts
        Section("Bar Charts")
        Paragraph("This is a section with examples of Bar Charts")
        Subsection("Bar Chart 1")
        Chart("charts/codeorg/access_by_report_year.svg")
        Subsection("Bar Chart 2")
        Chart("charts/codeorg/access_by_geography.svg")
        Subsection("Bar Chart 3")
        Chart("charts/codeorg/access_by_percent_frl_in_the_school.svg")
    end
end
