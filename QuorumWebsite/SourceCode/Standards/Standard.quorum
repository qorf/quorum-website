package Libraries.Web.Page.Standards

/*
    Standard is one standard from a set of standards: its identifier (such
    as "HS-PRO-PD-12"), what it says, and where it sits in the set (its
    level, concept and subconcept). A StandardSet makes these; pages refer
    to them through the set.

    Attribute: Example
    use Libraries.Web.Page.Standards.Standard

    Standard standard
    standard:Setup("HS-PRO-PD-12", "Create modular programs …", "High School", "Programming", "Program Development", undefined)
    output standard:GetIdentifier()
*/
class Standard
    text identifier = ""
    text words = ""
    text level = ""
    text concept = ""
    text subconcept = ""
    StandardSet set = undefined

    /*
        Sets everything about the standard. A StandardSet calls this when
        it adds the standard.

        Attribute: Parameter identifier The standard's identifier, such as "HS-PRO-PD-12".
        Attribute: Parameter words What the standard says.
        Attribute: Parameter level Who it is for, such as "High School".
        Attribute: Parameter concept Its concept or specialty, such as "Programming".
        Attribute: Parameter subconcept Its subconcept, such as "Program Development".
        Attribute: Parameter set The set it belongs to.
    */
    action Setup(text identifier, text words, text level, text concept, text subconcept, StandardSet set)
        me:identifier = identifier
        me:words = words
        me:level = level
        me:concept = concept
        me:subconcept = subconcept
        me:set = set
    end

    /*
        Returns the set the standard belongs to.

        Attribute: Returns The set.
    */
    action GetSet returns StandardSet
        return set
    end

    /*
        Returns the standard's identifier, such as "HS-PRO-PD-12".

        Attribute: Returns The identifier.
    */
    action GetIdentifier returns text
        return identifier
    end

    /*
        Returns what the standard says.

        Attribute: Returns The standard's words.
    */
    action GetText returns text
        return words
    end

    /*
        Returns who the standard is for, such as "High School".

        Attribute: Returns The level.
    */
    action GetLevel returns text
        return level
    end

    /*
        Returns the standard's concept or specialty, such as "Programming".

        Attribute: Returns The concept.
    */
    action GetConcept returns text
        return concept
    end

    /*
        Returns the standard's subconcept, such as "Program Development".

        Attribute: Returns The subconcept.
    */
    action GetSubconcept returns text
        return subconcept
    end
end
