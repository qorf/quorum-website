use Libraries.Web.Page.QuorumPage

/*
    Cybersecurity - Lesson 13: Project - Innovation Simulation Part 7.
    Converted from the old Lesson page by plan 13's generator: the same
    words, now without Tailwind.
*/
class CodeOrgUnit10Lesson13 is QuorumPage

    on create
        SetLocation("lessons/code/Cybersecurity/Lesson13.html")
        // The name lists and links use, and the series and track it belongs
        // to: its section and picture.
        SetShortTitle("Project - Part 7")
        SetSectionName("Cybersecurity and Global Impacts")
        // For search engines and link previews, and what lists of pages say.
        SetDescription("Lesson Overview")
        SetSummary("Lesson Overview")
    end

    action Setup
        SetWebPageTitle("Unit 10 Lesson 13: Project - Innovation Simulation Part 7")
        Title("Cybersecurity - Lesson 13: Project - Innovation Simulation Part 7")
        Overview()
        GettingStarted2Minutes()
        Activity40Mins()
        WrapUp5Minutes()
        StandardsAlignment()
    end

    private action Overview
        Section("Overview")
        Paragraph("Students present the group Innovation Proposal they have been working on throughout the units. After each group does a brief presentation students do a gallery walk of their classmates' projects, asking questions and reviewing any materials. Students then vote for the unified project and overall innovation they found most compelling. At the end of the lesson students will submit their projects for grading.")
        Subsection("Purpose")
        Paragraph("This lesson is an opportunity for students to share their work throughout the unit and wrap up their study of the ways computing innovations can be used to benefit society, even as they pose potential risks. Aim to make this an exciting and celebratory end to the year.")
        Subsection("Goals")
        Paragraph("Students will be able to:")
        BulletList()
        ListItem("Evaluate innovations for its potential benefits and harms based on the perspective of a specific audience")
        Subsection("Preparation")
        BulletList()
        ListItem("Ensure students have printed their one-pagers or can otherwise make their one-pagers available for their classmates to review during the gallery walk.")
        Subsection("Resources")
        Subsubsection("Supplemental code.org material")
        Paragraph("For the Teachers")
        BulletList()
        ListItem():Link("CSP Unit 10 Project Overview", "https://docs.google.com/document/d/105rBn4_ylOlRWmgxvQdMjo8v0Iwrg3Aw-9vPIVsAYpc/edit?usp=sharing")
        ListItem():Link("CSP Unit 10 - Cybersecurity and Global Impacts", "https://docs.google.com/presentation/d/1CFWhRU6Sqrj9KFjLJRDnS2CFJZ_lHufFAweKNZumlic/copy")
        Paragraph("For the Students")
        BulletList()
        ListItem():Link("CSP Innovation Simulation Project Guide - Activity Guide", "https://docs.google.com/document/d/19git_OKuw7fGJV53Xgieb0FYwrPZ3svKxHaHxwzlA-c/")
    end

    private action GettingStarted2Minutes
        Section("Getting Started (2 minutes)")
        Paragraph():Strong("Distribute:"):Text(" Pass out badges and nameplates. While you are doing this, draw students' attention to the red box in the slide header that indicates the class is in simulation mode. From this point on in the class, students are thinking from the perspective of their given character.")
        Paragraph():Strong("Group:"):Text(" Instruct students to sit with their project teams")
        Subsection("Remarks")
        BulletList()
        ListItem("Delegates today it's time for the actual convention. Each group will have a couple minutes to present their overall vision for the Future School to the entire audience. Afterwards we'll leave their proposals around the room and you'll have time to review each of them to identify the group and individual innovation (outside your group) that you believe is best. Let's get to it!")
        Subsection("Gallery Walk - 15 Mins")
    end

    private action Activity40Mins
        Section("Activity (40 mins)")
        Paragraph():Strong("Presentations - 25 mins:"):Text(" One by one have each group present to the class as a whole.")
        TeachingTip()
        Paragraph():Strong("Supporting Notes:"):Text(" Encourage students to take notes on individual presentations they want to look at more closely during the gallery walk as well as their overall impression of each of the presentations. A good rule is that by the end of the presentations students should have written down at least three individual innovations they want to look at more closely because it would be of interest to their character.")
        Paragraph():Strong("Running the Gallery Walk:"):Text(" Depending on your classroom setup you may want students to move around the room in an organized fashion, e.g. rotating through each project with their groups, or you might encourage students to move around the room as they wish.")
        EndCallout()
        Paragraph("Have groups leave their one-pagers and any presentation materials around the room, collected by team. Give students time to walk around the room, review the materials, and try to identify the overall group and individual innovation, other than their own, that they believe is best based on the perspective of their character.")
    end

    private action WrapUp5Minutes
        Section("Wrap up (5 Minutes)")
        Paragraph():Strong("Step 7 - Evaluate:"):Text(" Ask students to record the best project and best individual innovation based on what the saw in the presentations and the gallery walk.")
        Subsection("Remarks")
        BulletList()
        ListItem("Thank you delegates for an amazing convention. We will be excited to share the results of our convention next time we meet. For now thank you for your incredibly hard work to help us improve schools for all. Give yourselves a round of applause!")
    end

    private action StandardsAlignment
        Section("Standards Alignment")
        BulletList()
        ListItem():Strong("CSTA K-12 Computer Science Standards (2017):"):Text(" 3A-IC-24, 3A-IC-27, 3B-IC-25")
    end
end
