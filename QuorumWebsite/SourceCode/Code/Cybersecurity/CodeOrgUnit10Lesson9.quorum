use Libraries.Web.Page.QuorumPage

/*
    Cybersecurity - Lesson 9: Protecting Data Part 1.
    Converted from the old Lesson page by plan 13's generator: the same
    words, now without Tailwind.
*/
class CodeOrgUnit10Lesson9 is QuorumPage

    on create
        SetLocation("lessons/code/Cybersecurity/Lesson9.html")
        // The name lists and links use, and the series and track it belongs
        // to: its section and picture.
        SetShortTitle("Protecting Data Part 1")
        SetSectionName("Cybersecurity and Global Impacts")
        // For search engines and link previews, and what lists of pages say.
        SetDescription("Students gain a working knowledge of the different types of encryption.")
        SetSummary("Students investigate the different types of encryption.")
    end

    action Setup
        SetWebPageTitle("Unit 10 Lesson 9: Protecting Data Part 1")
        Title("Cybersecurity - Lesson 9: Protecting Data Part 1")
        Overview()
        GettingStarted5Minutes()
        Activity35Mins()
        WrapUp5Minutes()
        AssessmentCheckForUnderstanding()
        StandardsAlignment()
    end

    private action Overview
        Section("Overview")
        Paragraph("In this lesson students explore two different encryption widgets: The Caesar Cipher Widget and the Random Substitution Cipher. Afterwards, students watch a video that reviews these types of encryption and introduces a new concept: public key encryption.")
        Subsection("Purpose")
        Paragraph("The goal of this lesson is for students to gain a working knowledge of the different types of encryption, focusing specifically on symmetrical and asymmetrical encryption. There is a lot of challenging vocabulary in this lesson, and therefore we want students to have a tangible experience with a widget to anchor their knowledge. This lesson is the first in a pair of lessons exploring how data can be protected.")
        Subsection("Goals")
        Paragraph("Students will be able to:")
        BulletList()
        ListItem("Explain the difference between asymmetrical and symmetrical encryption.")
        ListItem("Explain how computing tools can be used for decryption.")
        ListItem("Identify why Caesar Cipher and Random Substitution Ciphers are not adequate for most encryption needs.")
        Subsection("Preparation")
        BulletList()
        ListItem("Explore the encryption widgets")
        ListItem("Watch the video.")
        Subsection("Resources")
        Paragraph("For the Students")
        BulletList()
        ListItem():Link("The Internet: Encryption & Public Keys - Video", "https://www.youtube.com/watch?v=ZghMPWGXexs")
        ListItem():Link("CSP-Widgets Repository", "https://github.com/qorf/CSP-Widgets")
    end

    private action GettingStarted5Minutes
        Section("Getting Started (5 minutes)")
        Subsection("Remarks")
        Paragraph("We have explored how our data is collected and sometimes misused. In the next two lessons, we are going to dig into protecting our data.")
        Paragraph("Many of the ideas we use to keep secrets in the digital age are far older than the Internet. The process of encoding a plain text message in some secret way is called Encryption")
        Paragraph("For example in Roman times Julius Caesar is reported to have encrypted messages to his soldiers and generals by using a simple alphabetic shift - every character was encrypted by substituting it with a character that was some fixed number of letters away in the alphabet.")
        Paragraph("As a result an alphabetic shift is often referred to as the Caesar Cipher.")
        DiscussionGoal()
        Paragraph("This message was encrypted using a Caesar Cipher (an "):DoubleQuote():Text("alphabetic shift"):DoubleQuote():Text("). Let's see how long it takes you to decode this message (remember it's just a shifting of the alphabet).")
        BulletList()
        ListItem("serr cvmmn va gur pnsrgrevn")
        ListItem("Use the Cesear Cipher Widget to see the answer")
        Image("media/lessons/csp/unit10/unit10lesson9caesarcipher.png", "a picture showing the encrypted text, the decoded text below it, the cipher key (change every letter by 13), and an example of the cipher where the letter a is encrypted to the letter n")
        EndCallout()
        Paragraph("With this simple encryption technique it only took a few minutes to decode a small message. What if the message were longer, BUT you had a computational tool to help you?")
        TeachingTip()
        Paragraph("Give students around 3-5 minutes to work on cracking the message. Resist the urget to give students a tool or device to aid in cracking this message - that's coming in the next part of the lesson! Part of the point here is that it's possible without tools. With tools it becomes trivial, as we'll see next.")
        Paragraph("If students are struggling to start, here are a few strategy suggestions:")
        BulletList()
        ListItem("Find a small word and try alphabetic shifts until it's clear that it's an English word.")
        ListItem("Remember the letters aren't randomly substituted - the alphabet is just shifted.")
        ListItem("Once you have found the amount of shift the rest comes easy.")
        Paragraph():Strong("Answer:"):Text(" "):DoubleQuote():Text("free pizza in the cafeteria"):DoubleQuote()
        EndCallout()
    end

    private action Activity35Mins
        Section("Activity (35 mins)")
        Subsection("Do This (5 mins)")
        BulletList()
        ListItem("Open a Project: Have students open the "):Strong("CaesarCipher"):Text(" project in the Unit 10 folder of the CSP-Widgets repository.")
        ListItem("Experiment with the tool - click things, poke around, figure out what it's doing.")
        ListItem("Choose one of the messages from the drop-down menu and try to crack it using the tool.")
        Subsubsection("Remarks")
        Paragraph("With the tool, cracking an alphabetic shift is easy. Once you've done one, it only takes a matter of seconds to do others.")
        Paragraph("Let's review some terminology here.")
        TeachingTip()
        Paragraph("Students do not need to write down any vocabulary terms here. This is only a review of terms they may encounter in this lesson. Discuss the terms briefly as a class and then move on to the next activity.")
        EndCallout()
        Subsubsection("Terms")
        BulletList()
        ListItem("Encryption: a process of encoding messages to keep them secret, so only "):DoubleQuote():Text("authorized"):DoubleQuote():Text(" parties can read it.")
        ListItem("Decryption: a process that reverses encryption, taking a secret message and reproducing the original plain text")
        ListItem("Cipher: the generic term for a technique (or algorithm) that performs encryption")
        ListItem("Caesar's Cipher: a technique for encryption that shifts the alphabet by some number of characters.")
        ListItem("Cracking encryption: When you attempt to decode a secret message without knowing all the specifics of the cipher, you are trying to crack the encryption.")
        Paragraph("What if instead of shifting the whole alphabet, we matched every letter of the alphabet to a random different letter of th alphabet? This is called a random substitution cipher.")
        Paragraph("Let's take a look at a new decryption challenge using a random substitution cipher.")
        Subsection("Do This (3 mins)")
        BulletList()
        ListItem("Open a Project: Have students open the "):Strong("RandomCipher"):Text(" project in the Unit 10 folder of the CSP-Widgets repository.")
        ListItem("Explore the tool: how does it work?")
        Paragraph():Strong("Prompt:"):Text(" How does the widget work? What steps would you take to crack the code?")
        Subsection("Do This (10 mins)")
        Paragraph("Take ten minutes to crack another message using the steps we just talked about.")
        TeachingTip()
        Paragraph("Use this time to clear up any confusion around how the tool works.")
        Paragraph("Move around the letters to make possible matches. The frequency meter may help you get started - especially in matching letters in short words.")
        Paragraph("Here are some steps that may be helpful for students:")
        BulletList()
        ListItem("Find the short words and "):DoubleQuote():Text("crack"):DoubleQuote():Text(" them first. How many one-letter words do you know? ("):DoubleQuote():Text("a"):DoubleQuote():Text("). A very common 3-letter word is "):DoubleQuote():Text("the"):DoubleQuote():Text(".")
        ListItem("Once you've done that, you have substitutes for some of the most common letters. You should be able to use intuition to look at other words with these partial substitutions and make good guesses.")
        ListItem("After finding only a handful of hard-fought letters, the rest will tumble quickly.")
        ListItem("Comparing the frequencies of letters gives good insight for making sensible guesses.")
        EndCallout()
        Subsubsection("Remarks")
        Paragraph("A random substitution cipher is very crackable by hand, though it might take some time. However, when aided by computational tools, a random substitution cipher can be cracked by a novice in a matter of minutes. Simple substitution ciphers give insight into encryption algorithms, but as we've seen fall way short when a potential adversary is aided with computational tools... our understanding must become more sophisticated.")
        Paragraph("If we are to create a secure Internet, we will need to develop tool and protocols which can resist the enormous computational power of modern computers.")
        Paragraph():Strong("Video:"):Text(" Watch: The Internet: Encryption and Public Keys")
        Paragraph():Link("The Internet: Encryption and Public Keys", "https://www.youtube.com/watch?v=ZghMPWGXexs")
        Video("https://www.youtube.com/embed/ZghMPWGXexs?si=DA-gl4g-s87oB7Mc", "The Internet: Encryption & Public Keys")
        Paragraph():Strong("Prompt:"):Text(" What is the difference between symmetric encryption and asymmetric (public key) encryption?")
        DiscussionGoal()
        Paragraph():Strong("Goal:"):Text(" This is the main takeaway. Students need to understand that symmetric encryption involves one key that is shared between the encoder and decoder. Asymmetric (public key) encryption uses two keys - a public and a private one. The encoder and the decoder never need to meet to exchange a key. The modern Internet is built around pulic key encryption.")
        EndCallout()
    end

    private action WrapUp5Minutes
        Section("Wrap up (5 Minutes)")
        Subsection("Journal")
        Paragraph("Students add the following vocaublary words: encryption, decryption, symmetric key encryption, public key encryption.")
        BulletList()
        ListItem():Emphasis("Encryption:"):Text(" a process of encoding messages to keep them secret, so only "):DoubleQuote():Text("authorized"):DoubleQuote():Text(" parties can read it.")
        ListItem():Emphasis("Decryption:"):Text(" a process that reverses encryption, taking a secret message and reproducing the original plain text.")
        ListItem():Emphasis("Symmetric key encryption:"):Text(" involves one key for both encryption and decryption.")
        ListItem():Emphasis("Public key encryption:"):Text(" pairs a public key for encryption and a private key for decryption. The sender does not need the receiver's private key to encrypt a message, but the receiver's private key is required to decrypt the message")
    end

    private action AssessmentCheckForUnderstanding
        Section("Assessment: Check for Understanding")
        Subsection("For Teachers")
        Paragraph("Check For Understanding Question(s) and solutions can be found in each lesson on Code Studio. These questions can be used for an exit ticket.")
        Subsection("For Students")
        Paragraph("Open a word doc or google doc and copy/paste the following question.")
        Subsection("Question")
        Paragraph("How does asymmetric (public key) encryption keep data secure?")
    end

    private action StandardsAlignment
        Section("Standards Alignment")
        BulletList()
        ListItem():Strong("CSTA K-12 Computer Science Standards (2017): "):Text("3A-NI-06,3A-NI-07,3B-NI-04")
        ListItem():Strong("CSP2021: "):Text("IOC-2.B")
    end
end
