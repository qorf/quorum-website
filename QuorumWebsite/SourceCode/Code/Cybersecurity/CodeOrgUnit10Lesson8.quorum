use Libraries.Web.Page.QuorumPage

/*
    Cybersecurity - Lesson 8: Project - Innovation Simulation Part 4.
    Converted from the old Lesson page by plan 13's generator: the same
    words, now without Tailwind.
*/
class CodeOrgUnit10Lesson8 is QuorumPage

    on create
        SetLocation("lessons/code/Cybersecurity/Lesson8.html")
        // The name lists and links use, and the series and track it belongs
        // to: its section and picture.
        SetShortTitle("Project - Part 4")
        SetSectionName("Cybersecurity and Global Impacts")
        // For search engines and link previews, and what lists of pages say.
        SetDescription("Identify and Understand how to conduct research on a computing innovation")
        SetSummary("Students to complete their innovation 1-pagers.")
    end

    action Setup
        SetWebPageTitle("Unit 10 Lesson 8: Project - Innovation Simulation Part 4")
        Title("Cybersecurity - Lesson 8: Project - Innovation Simulation Part 4")
        Overview()
        GettingStarted5Minutes()
        Activity35Mins()
        WrapUp5Minutes()
        StandardsAlignment()
    end

    private action Overview
        Section("Overview")
        Paragraph("This lesson is primarily a work day for students to complete their innovation 1-pagers. Students should work close to their teammates in case they want to discuss ways to make their proposals more aligned around a cohesive vision for the Future School. Otherwise students should have the entire class period to work independently.")
        Subsection("Goals")
        Paragraph("Students will be able to:")
        BulletList()
        ListItem("Students will have completed the majority of the one-pager for their project.")
        Subsection("Preparation")
        BulletList()
        ListItem("Make sure students will have access to the 1-pagers they started in the last project lesson.")
        Subsection("Resources")
        Paragraph("For the Students")
        Subsubsection("Supplemental Code.org material")
        BulletList()
        ListItem():Link("CSP Innovation Simulation Project Guide - Activity Guide", "https://docs.google.com/document/d/19git_OKuw7fGJV53Xgieb0FYwrPZ3svKxHaHxwzlA-c/")
    end

    private action GettingStarted5Minutes
        Section("Getting Started (5 minutes)")
        Paragraph():Strong("Distribute:"):Text(" Pass out badges and nameplates. While you are doing this, draw students' attention to the red box in the slide header that indicates the class is in simulation mode. From this point on in the class, students are thinking from the perspective of their given character.")
        Paragraph():Strong("Group:"):Text(" Instruct students to sit with their project team.")
        Subsection("Remarks")
        Paragraph("Delegates today you will have time to work on your one-pagers. The only section of your one-pager you might not be 100% ready to fill in at this point is the "):DoubleQuote():Text("Addressing Concerns"):DoubleQuote():Text(" section. Fill in as much as you can today and you'll have a little more time to fill in that section next time we meet.")
    end

    private action Activity35Mins
        Section("Activity (35 mins)")
        Paragraph():Link("Distribute: Give students back CSP Innovation Simulation Project Guide - Activity Guide if they don't already have them on hand.", "https://docs.google.com/document/d/19git_OKuw7fGJV53Xgieb0FYwrPZ3svKxHaHxwzlA-c/")
        Paragraph():Strong("Do This:"):Text(" Instruct students to continue working on their projects following the instructions in the Activity Guide. Students will be working on "):Emphasis("Step 4 - One-pager"):Text(" during this hour.")
        Paragraph():Strong("Circulate:"):Text(" Throughout the lesson circulate and provide support to students on completing their one pagers.")
    end

    private action WrapUp5Minutes
        Section("Wrap up (5 Minutes)")
        Subsection("Remarks")
        Paragraph("Great work today everyone. Next time we meet you'll have a chance to start thinking more about how to turn your individual innovation one-pagers into a unified presentation for the convention.")
        Paragraph("(Direct students to remove their simulation badges)")
        Paragraph("To end our time together, let's discuss what you've learned from researching computing innovations.")
        Paragraph():Strong("Prompt:"):Text(" Explain how a computing innovation can have an impact beyond its intended purpose. How can rapid sharing of a computing innovation affect these impacts?")
        DiscussionGoal()
        Paragraph():Strong("Goal:"):Text(" Pull out these general ideas from the discussion:")
        BulletList()
        ListItem("Computing Innovations can have a harmful impact on society, economy or culture - even when the creator did not intend for this to happen.")
        ListItem("Responsible creators of innovations should consider potential beneficial and harmful effects and how their innovations may be used in unintended ways, given that not all potential uses can be known ahead of time.")
        ListItem("Sometimes computing innovations lead to benefits in other fields.")
        ListItem("Rapid sharing of computing innovations can lead to a greater number of users which can in turn lead to more significant impacts. Consider a social media platform with thousands of users vs. millions.")
        EndCallout()
    end

    private action StandardsAlignment
        Section("Standards Alignment")
        BulletList()
        ListItem():Strong("CSTA K-12 Computer Science Standards (2017): "):Text("3A-IC-24, 3A-IC-27, 3B-IC-25")
        ListItem():Strong("CSP2021: "):Text("IOC-1.B")
    end
end
