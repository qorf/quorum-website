use Libraries.Web.Page.QuorumPage

/*
    Cybersecurity - Lesson 2: Project - Innovation Simulation Part 2.
    Converted from the old Lesson page by plan 13's generator: the same
    words, now without Tailwind.
*/
class CodeOrgUnit10Lesson2 is QuorumPage

    on create
        SetLocation("lessons/code/Cybersecurity/Lesson2.html")
        // The name lists and links use, and the series and track it belongs
        // to: its section and picture.
        SetShortTitle("Project - Part 2")
        SetSectionName("Cybersecurity and Global Impacts")
        // For search engines and link previews, and what lists of pages say.
        SetDescription("Identify and Understand how to conduct research on a computing innovation")
        SetSummary("Researching three different computer innovations")
    end

    action Setup
        SetWebPageTitle("Unit 10 Lesson 2: Project - Innovation Simulation Part 2")
        Title("Cybersecurity - Lesson 2: Project - Innovation Simulation Part 2")
        Overview()
        GettingStarted5Minutes()
        Activity35Mins()
        WrapUp5Minutes()
        AssessmentCheckForUnderstanding()
        StandardsAlignment()
    end

    private action Overview
        Section("Overview")
        Paragraph("Today is focused on researching three different computing innovations and discussing these innovations with team members.")
        Subsection("Purpose")
        Paragraph("In this lesson, students investigate computing innovations, as required by the College Board to meet the Curricular Requirement. They will add to their research throughout the unit.")
        Subsection("Goals")
        Paragraph("Students will be able to:")
        BulletList()
        ListItem("Identify benefits of a computing innovation")
        ListItem("Research computing innovations through the lens of one beneficiary")
        Subsection("Preparation")
        BulletList()
        ListItem("Organize the badges and nameplates for quick distribution at the beginning of class")
        Subsection("Resources")
        Subsubsection("Supplemental Code.org material")
        Paragraph("For the teachers")
        BulletList()
        ListItem():Link("CSP Unit 10 Project Overview - Resource", "https://docs.google.com/document/d/105rBn4_ylOlRWmgxvQdMjo8v0Iwrg3Aw-9vPIVsAYpc/edit?usp=sharing")
        Paragraph("For the Students")
        BulletList()
        ListItem():Link("CSP Innovation Simulation Project Guide - Activity Guide", "https://docs.google.com/document/d/19git_OKuw7fGJV53Xgieb0FYwrPZ3svKxHaHxwzlA-c/")
    end

    private action GettingStarted5Minutes
        Section("Getting Started (5 minutes)")
        Paragraph():Strong("Distribute:"):Text(" Pass out badges and nameplates from the previous lesson. While you are doing this, draw students' attention to the red box in the slide header that indicates the class is in simulation mode. From this point on in the class, students are thinking from the perspective of their given character.")
        Paragraph():Strong("Group:"):Text(" Instruct students to sit with their team from the previous lesson.")
        Paragraph():Strong("Remarks")
        Paragraph("Welcome back to day two of the Future School Convention. I hope you enjoyed your first day getting to know your fellow participants. Today the real work begins - you will be researching the computing innovations that you believe will benefit the Future School. I'm sure you have lots of ideas. Let's get started!")
        Paragraph():Strong("Prompt:"):Text(" Why do you believe the Future School is in need of computing innovations? What can computing innovations provide to a community?")
        DiscussionGoal()
        Paragraph():Strong("Goal:"):Text(" In the near future, we will discuss the harms that computing innovations can bring to society. For today, we want to focus on the positive benefits.")
        Paragraph("Computing Innovations can:")
        BulletList()
        ListItem("help schools run more efficiently")
        ListItem("help certain groups gain a voice and be heard")
        ListItem("make learning more fun!")
        ListItem("save time and money")
        EndCallout()
    end

    private action Activity35Mins
        Section("Activity (35 mins)")
        Paragraph():Strong("Step 5 - Preparing Your Group Presentation "):Text("In addition to each group member submitting an innovation one-pager, your group will need to create some kind of collective artifact or presentation that presents your vision for the Future School.")
        Subsection("Convention Format")
        BulletList()
        ListItem("Presentations (20-30 minutes): Each group will get between 2 and 4 minutes to present their vision for the Future School")
        ListItem("Gallery Walk (10-15 minutes):Groups will leave their presentation materials and Innovation 1-Pagers around the room and all convention attendees will circulate the room reviewing 1-Pagers that feel particularly interesting to your")
        ListItem("Voting and Feeback (5 minutes): Each attendee will vote for the Group Vision and individual innovation they believe is best and attendees may not vote for themselves or their group members")
        Subsection("Presentation Format")
        Paragraph("Your presentation can be in almost any format you want. You could make a poster or slides, but you’re also welcome to perform a skit, record a video, make a commercial, write a poem / song, or any other format that you think will be effective for communicating your vision. Aim for a presentation that is")
        BulletList()
        ListItem():Strong("Coherent:"):Text(" Explains the theme that ties your different innovations together")
        ListItem():Strong("Compelling:"):Text(" Highlight the benefits of your vision and get the audience excited")
        ListItem():Strong("Creative:"):Text(" Choose the format that will best communicate your vision")
        ListItem():Strong("Clear:"):Text(" Make it clear specifically what you’re proposing")
        ListItem():Strong("Collaborative:"):Text(" Every group member has a role, and every innovation is briefly explained")
        ListItem():Strong("Concise:"):Text(" You’ll only have a couple minutes")
        Paragraph():Strong("Presentation Vision: "):Text("What is the unifying theme of your group? What is the shared vision?")
        Paragraph():Strong("Your Innovation's Connection to the Theme: "):Text("What is the connection between your innovation and the theme or vision your team has chosen.")
        Paragraph():Strong("Step 6 - Run the Convention "):Text("During the convention, every group will have a chance to present their vision and you’ll then review individual innovations.")
        Paragraph():Strong("Step 7 - Evaluate "):Text("Vote for the group vision and individual innovation your character believes is most compelling. You may not vote for yourself, your team, or other members of your team.")
    end

    private action WrapUp5Minutes
        Section("Wrap up (5 Minutes)")
        Paragraph():Strong("Prompt:"):Text(" Which of your computing innovations would bring the most positive change to the school community? Share with your group.")
        Paragraph():Strong("Discuss:"):Text(" With your group and then with the whole class discuss the common characteristics of these computing innovations that would bring the most positive change.")
    end

    private action AssessmentCheckForUnderstanding
        Section("Assessment: Check for Understanding")
        Subsection("For Teachers")
        Paragraph("Check For Understanding Question(s) and solutions can be found in each lesson on Code Studio. These questions can be used for an exit ticket.")
        Subsection("For Students")
        Paragraph("Open a word doc or google doc and copy/paste the following question.")
        Subsection("Question")
        Paragraph("Considering your character's perspective, which computing ideas of your team members seem the best? Which ones are you concerned about?")
    end

    private action StandardsAlignment
        Section("Standards Alignment")
        BulletList()
        ListItem():Strong("CSTA K-12 Computer Science Standards (2017): "):Text("3A-IC-24, 3A-IC-27, 3B-IC-25")
    end
end
