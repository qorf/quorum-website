use Libraries.Web.Page.QuorumPage

/*
    Cybersecurity - Lesson 1: Project - Innovation Simulation Part 1.
    Converted from the old Lesson page by plan 13's generator: the same
    words, now without Tailwind.
*/
class CodeOrgUnit10Lesson1 is QuorumPage

    on create
        SetLocation("lessons/code/Cybersecurity/Lesson1.html")
        // The name lists and links use, and the series and track it belongs
        // to: its section and picture.
        SetShortTitle("Project - Part 1")
        SetSectionName("Cybersecurity and Global Impacts")
        SetCardImage("/media/userInterface/quorumAssets/cspImages/csp8.svg")
        SetCardDescription("In this unit learn how computing innovations have impacted our world in beneficial and harmful ways. ")
        // For search engines and link previews, and what lists of pages say.
        SetDescription("Identify and Understand how to conduct research on a computing innovation")
        SetSummary("Understand how to conduct research on a computing innovation")
    end

    action Setup
        SetWebPageTitle("Unit 10 Lesson 1: Project - Innovation Simulation Part 1")
        Title("Cybersecurity - Lesson 1: Project - Innovation Simulation Part 1")
        Overview()
        GettingStarted5Minutes()
        Activity30Mins()
        WrapUp5Minutes()
        AssessmentCheckForUnderstanding()
        StandardsAlignment()
    end

    private action Overview
        Section("Overview")
        Paragraph("The class begins a simulation which will continue on at different points throughout the unit. In this simulation, students take on the roles of different stakeholders in school communities converging at a convention where they eventually will deliver a proposal on the best computing innovation for the Future School. In this lesson, students explore what a computing innovation is, do a brainstorm activity, reflect on their character role, and finally learn how to research an innovation.")
        Subsection("Purpose")
        Paragraph("In this unit students will cover information related to computing innovations needed for the Curricular Requirement for the AP Computer Science Principles exam. This lesson sets the stage for the simulation.")
        Paragraph("This project is a simulation where you and your classmates role play as delegates at a convention. There are times throughout this unit when you will be in simulation mode. Look for the red"):DoubleQuote():Text("Innovation Simulation"):DoubleQuote():Text(" header at the top of slides as an indication of when the simulation is live. You should also wear your nametag and display your nameplate.")
        Subsection("Goals")
        Paragraph("Students will be able to:")
        BulletList()
        ListItem("Identify a computing innovation.")
        ListItem("Understand how to conduct research on a computing innovation.")
        ListItem("Deliver an artifact displaying your team members' innovations.")
        ListItem("Deliver a presentation of the team's top innovation")
        Subsection("Preparation")
        BulletList()
        ListItem("Prepare the role badges")
        ListItem("Review the Innovation Simulation Planning Guide")
        Subsection("Resources")
        Subsection("Supplemental Code.org material")
        Paragraph("For the teachers")
        BulletList()
        ListItem():Link("CSP Unit 10 Project Overview - Resource", "https://docs.google.com/document/d/105rBn4_ylOlRWmgxvQdMjo8v0Iwrg3Aw-9vPIVsAYpc/edit?usp=sharing")
        ListItem():Link("Computer Science is Changing Everything - Video", "https://youtu.be/QvyTEx1wyOY")
        ListItem():Link("CSP Innovation Simulation Character Bios - Handout", "https://docs.google.com/document/d/1zuGMUs7RjxxgAPf_93C1Cm5bN2TvsQ8fqveGdlzBMrg/")
        ListItem():Link("CSP Innovation Simulation Nameplates - Handout", "https://drive.google.com/file/d/1b4hIYm6CK5BUr0rdpUBtvgR_AoZxGz8c/")
        ListItem():Link("CSP Innovation Simulation Badges - Handout", "https://drive.google.com/file/d/1iTYcQ-Jqe-aCQ3Jcq0Td0xZEgreNdGVp/")
        Subsection("For the Students")
        BulletList()
        ListItem():Link("CSP Innovation Simulation Project Guide - Activity Guide", "https://docs.google.com/document/d/19git_OKuw7fGJV53Xgieb0FYwrPZ3svKxHaHxwzlA-c/")
    end

    private action GettingStarted5Minutes
        Section("Getting Started (5 minutes)")
        Subsection("Start the Simulation")
        Paragraph("Welcome to the Future School Convention. You have been chosen to attend this convention because you represent an important stakeholder in the broader school community. Together with a small group you will brainstorm and research computing innovations that you believe will have a positive impact on a the Future School. At the end of the convention, your team will pitch your best idea to a panel of judges.")
        Paragraph():Strong("Group:"):Text(" Place students in groups of 5-6.")
        Paragraph():Strong("Distribute:"):Text(" Hand out a random role card to each group. Each group should have at least one TEACHER, STUDENT, STAFF, PARENT, and ADMIN. Students will need:")
        BulletList()
        ListItem():Link("A character bio from CSP Innovation Simulation Character Bios", "https://docs.google.com/document/d/1zuGMUs7RjxxgAPf_93C1Cm5bN2TvsQ8fqveGdlzBMrg/")
        ListItem():Link("A nameplate from CSP Innovation Simulation Character Bios", "https://drive.google.com/file/d/1b4hIYm6CK5BUr0rdpUBtvgR_AoZxGz8c/")
        ListItem():Link("A badge from CSP Innovation Simulation Character Bios", "https://drive.google.com/file/d/1iTYcQ-Jqe-aCQ3Jcq0Td0xZEgreNdGVp/")
        Paragraph():Strong("Do This:"):Text(" Each students should tape their badge to their shirt and place their nameplate on their desk after folding on the marked lines. When the nameplates and badges are out, students should be in simulation mode.")
        Paragraph():Strong("Do This:"):Text(" Read over your role sheet and introduce yourself to your group.")
        TeachingTip()
        Paragraph():Strong("Small Classes:"):Text(" If you have less than ten students, you can leave out the PARENT role and divide into groups of 4-5.")
        Paragraph():Strong("Large Classes:"):Text(" More than one student can have the same character assignmnet, as long as they are not in the same group. You may also opt to use the blank badges and nameplates to create your own characters. Consider the school counselor or the bus driver.")
        EndCallout()
        DiscussionGoal()
        Paragraph("The introductory activity sets the stage for the simulation project, which will run throughout the unit. Encourage students to stay in their roles and speak from their specific points of view. For example, when talking students might say "):DoubleQuote():Text("As the art teacher, I think... "):DoubleQuote():Text("or"):DoubleQuote():Text(" As a parent, I know what is best for my student and that is... "):DoubleQuote()
        EndCallout()
    end

    private action Activity30Mins
        Section("Activity (30 mins)")
        Paragraph("Computing Innovations are created by people to solve problems. They include programs as part of how they function. They can be physical (e.g., self-driving car), non-physical computing software (e.g., picture editing software), or non-physical computing concepts (e.g., e-commerce). The way lives are lived has changed because of computing innovations. Let's rewatch a video to remind ourselves of this fact.")
        Paragraph():Link("Video: Play Computer Science is Changing Everything. (End at 4:40)", "https://youtu.be/QvyTEx1wyOY")
        Video("https://www.youtube.com/embed/QvyTEx1wyOY?si=_Dipzt_J5AoLjEZ0", "Computer Science is Changing Everything")
        TeachingTip()
        Paragraph("You role involves being the ultimate "):DoubleQuote():Text("role keeper"):DoubleQuote():Text(". If you buy-in to the simulation, your students will have a greater chance of fully participating and keeping engagement high.")
        EndCallout()
        Subsection("Innovation Simulation Project")
        Paragraph():Strong("Step 1 - Reflection (10 mins)"):Text(" Teams spend five minutes brainstorming computing innovations they believe would be beneficial to the Future School. Students should be considering if the innovations include programs as an important part of their function. If not, it's possible that it is not a computing innovation. Remind students to stay in their roles.")
        Paragraph():Link("Distribute: CSP Innovation Simulation Project Guide - Activity Guide", "https://docs.google.com/document/d/19git_OKuw7fGJV53Xgieb0FYwrPZ3svKxHaHxwzlA-c/")
        Paragraph("Students use this time to consider the wants and needs of their characters and what types of computing innovations would and would not appeal to the character they are playing. Students write their reflection in the Project Guide.")
        Paragraph():Strong("Consider:"):Text(" Is a program an important part of how the innovation works? If not, it might not be a computing innovation!")
        Subsubsection("Remarks")
        Paragraph("Before your teams get started investigating computing innovations for Future School, we want to make sure everyone understands how to conduct the necessary research. Let's examine an innovation that is not related to schools. Let's consider an innovation that would benefit long distance travel.")
        Paragraph():Strong("Step 2 - Research (10 mins)"):Text(" Choose three different computing innovations you would like to recommend for the Future School. These can be innovations that were brainstormed as a team, or new ones that you think of. Check with your team to make sure no one is researching the same innovations.")
        Paragraph("In the Project Guides they mark down")
        BulletList()
        ListItem("The name of the innovation")
        ListItem("Brief descriptions of the function and purpose of the innovation")
        ListItem("Sources")
        ListItem("What data is being collected")
        ListItem("Why their character would recommend it")
        Paragraph("Students should regularly check in with their group to make sure no one else is researching the same innovation. For each group, there should be a total of 15 (or three times the amount of group members) innovations researched.")
        TeachingTip()
        Paragraph("Doing this research may take some practice. We recommend trying a few different search terms a few times before class on your own, to assess where things may be tricky. Some example terms to search might be general terms like "):DoubleQuote():Text("New technologies for schools"):DoubleQuote():Text(" or "):DoubleQuote():Text("Technologies to change schools"):DoubleQuote():Text(". You could also model searching for technology related to specific roles such as searching for "):DoubleQuote():Text("Technology for art teachers"):DoubleQuote():Text(".")
        Paragraph("It's important to model to students how to use search terms to narrow down to a computing innovation of interest.")
        EndCallout()
        Paragraph():Strong("Step 3 - Feedback"):Text(" Record three pieces of feedback you gave to teammates about their proposed innovations and why you provided that feedback.")
        Paragraph():Strong("Step 4 - One Pager"):Text(" Based on the feedback you received, complete the one-pager for the innovation that best responds to your team's feedback and aligns with a unifying group theme or vision for the Future School.")
        Subsection("One Pager")
        BulletList()
        ListItem():Strong("Purpose and Benefits:"):Text(" write a paragraph or bullets explaining the reason the innovation exists. You should include the specific groups in the school community you believe would benefit, the specific problems or challenge that group is facing. the specific ways that group would benefit, and at least one specific reason your character would be interested in this innovation.")
        ListItem():Strong("Function: "):Text("Write a paragraph or bullets explaining how the innovation actually works. You should include: a high level description of how users interact with the innovation, what data the innovation uses or collects, and how the data is processed and stored")
        ListItem():Strong("Concerns: "):Text("Write a paragraph or bullets explaining potential concerns or risks posed by this innovation. You should include: At least one specific group that could potentially be harmed by the innovation and the way they could be harmed and at least one specific privacy or security concern that arises from collecting the data needed to run your innovation.")
        ListItem():Strong("Addressing Concerns: "):Text("Write a paragraph or bullets explaining the ways you could address potential concerns about your innovation. You should include: direct ties to the concerns raised in the previous paragraph, at least one cybersecurity technique that could be used to make the innovation more secure, and ways you would be willing to limit the innovation or alter its functionality to avoid the concerns")
        ListItem():Strong("Sources: "):Text("List all sources that you used in making this project using the format below. Make sure to cite the source of your image.")
    end

    private action WrapUp5Minutes
        Section("Wrap up (5 Minutes)")
        Paragraph("Thank you delegates for beginning the process of identifying computing innovations for The Future School. I'm looking forward to hearing your proposals soon.")
        Paragraph("As a team, you will need to work effectively together, evaluating and considering these computing innovations. Effective teams work on communication, consensus buildng, conflict resolution, and negotiation. You will address these skills throughout the project!")
        Paragraph():Strong("Do This:"):Text(" End the day by instructing students to put away their badges and nameplates. You may want to collect them so they are not lost.")
        Paragraph():Strong("Prompt:"):Text(" What is the purpose of a computing innovation?")
        Paragraph():Strong("Discuss:"):Text(" Have students think about their answers on their own, then share with a partner, and then finally discuss responses with the entire room.")
        Subsection("Journal")
        Paragraph("Students add the following vocabulary words and definitions to their journals: sequential computing, parallel computing, distributed computing, speedup")
        BulletList()
        ListItem():Emphasis("Computing Innovation:"):Text(" includes a program as an integral part of its function. Can be physical (e.g. self-driving car), non-physical computing software (e.g. picture editing software), or non-physical computing concepts (e.g., e-commerce).")
        DiscussionGoal()
        Paragraph():Strong("Goal:"):Text(" A computing innovation is designed to solve a problem.")
        EndCallout()
    end

    private action AssessmentCheckForUnderstanding
        Section("Assessment: Check for Understanding")
        Subsection("For Teachers")
        Paragraph("Check For Understanding Question(s) and solutions can be found in each lesson on Code Studio. These questions can be used for an exit ticket.")
        Subsection("For Students")
        Paragraph("Open a word doc or google doc and copy/paste the following question.")
        Subsection("Question")
        Paragraph("How has your life benefited from a computing innovation? "):Strong("Note:"):Text(" You are out of the simulation for this question! Speak from your own personal experiences.")
    end

    private action StandardsAlignment
        Section("Standards Alignment")
        BulletList()
        ListItem():Strong("CSTA K-12 Computer Science Standards (2017): "):Text("3A-IC-24, 3A-IC-27, 3B-IC-25")
        ListItem():Strong("CSP2021: "):Text("CRD-1.A, CRD-1.C")
        ListItem():Strong("CSP2021: "):Text("CRD-2.A")
        ListItem():Strong("CSP2021: "):Text("IOC-1.A")
        ListItem():Strong("CSP2021: "):Text("IOC-2.B")
    end
end
