use Libraries.Web.Page.QuorumPage

/*
    Cybersecurity - Lesson 11: Project - Innovation Simulation Part 5.
    Converted from the old Lesson page by plan 13's generator: the same
    words, now without Tailwind.
*/
class CodeOrgUnit10Lesson11 is QuorumPage

    on create
        SetLocation("lessons/code/Cybersecurity/Lesson11.html")
        // The name lists and links use, and the series and track it belongs
        // to: its section and picture.
        SetShortTitle("Project - Part 5")
        SetSectionName("Cybersecurity and Global Impacts")
        // For search engines and link previews, and what lists of pages say.
        SetDescription("Students meet with their groups to develop a shared artifact or presentation that presents their collective vision for the Future School.")
        SetSummary("Developing a shared presentaton to present their vision")
    end

    action Setup
        SetWebPageTitle("Unit 10 Lesson 11: Project - Innovation Simulation Part 5")
        Title("Cybersecurity - Lesson 11: Project - Innovation Simulation Part 5")
        Overview()
        GettingStarted3Minutes()
        Activity35Mins()
        WrapUp5Minutes()
        StandardsAlignment()
    end

    private action Overview
        Section("Overview")
        Paragraph("Students meet with their groups to develop a shared artifact or presentation that presents their collective vision for the Future School.")
        Subsection("Purpose")
        Paragraph("In this lesson students finish writing their one-pagers and meet to begin developing their group presentation. The goal of this collaborative process is to force students to think about the overall collective impact of their innovations, force them to continue to take multiple perspectives, and encourage collaboration for this last major project of the year.")
        Subsection("Goals")
        Paragraph("Students will be able to:")
        BulletList()
        ListItem("Students will have started to design a group presentation or artifact that presents their innovations and aligns them to a single theme.")
        Subsection("Preparation")
        Paragraph("Make sure students have access to their project guides if you are collecting them between classes.")
        Subsection("Resources")
        Subsubsection("Supplemental code.org material")
        Paragraph("For the Teachers")
        BulletList()
        ListItem():Link("CSP Unit 10 Project Overview", "https://docs.google.com/document/d/105rBn4_ylOlRWmgxvQdMjo8v0Iwrg3Aw-9vPIVsAYpc/edit?usp=sharing")
        ListItem():Link("CSP Unit 10 - Cybersecurity and Global Impacts", "https://docs.google.com/presentation/d/1CFWhRU6Sqrj9KFjLJRDnS2CFJZ_lHufFAweKNZumlic/copy")
        Paragraph("For the Students")
        BulletList()
        ListItem():Link("CSP Innovation Simulation Project Guide - Activity Guide", "https://docs.google.com/document/d/19git_OKuw7fGJV53Xgieb0FYwrPZ3svKxHaHxwzlA-c/")
    end

    private action GettingStarted3Minutes
        Section("Getting Started (3 minutes)")
        Paragraph():Strong("Distribute:"):Text(" Pass out badges and nameplates. While you are doing this, draw students' attention to the red box in the slide header that indicates the class is in simulation mode. From this point on in the class, students are thinking from the perspective of their given character.")
        Paragraph():Strong("Group:"):Text(" Instruct students to sit with their project teams")
        Subsection("Remarks")
        BulletList()
        ListItem("Delegates today you will have time to finish your one-pagers and work on your group presentation.")
    end

    private action Activity35Mins
        Section("Activity (35 mins)")
        Paragraph():Strong("Distribute:"):Text(" Give students back "):Link("CSP Innovation Simulation Project Guide - Activity Guide", "https://docs.google.com/document/d/19git_OKuw7fGJV53Xgieb0FYwrPZ3svKxHaHxwzlA-c/"):Text(" if they don't already have them on hand.")
        Subsection("Remarks")
        BulletList()
        ListItem("Before you start preparing for your group presentation, take a few minutes to finish filling out the "):DoubleQuote():Text("Addressing Concerns"):DoubleQuote():Text(" section in your One Pager. Once you're done, move on to Step 5.")
        Paragraph():Strong("Step 5 - Preparing Your Group Presentation - 5 mins:"):Text(" As a class review the instructions in their project guides. Highlight the fact that they have a lot of freedom to choose their presentation format.")
        TeachingTip()
        Paragraph():Strong("Time Expectations:"):Text(" Make sure to set clear expectations with your students about how much time they'll have to present. This curriculum assumes roughly 20-30 minutes for all groups to present.")
        Paragraph():Strong("Encouraging Creative Presentations:"):Text(" Depending on your students' interests and skills you may encourage a wide variety of presentation types. While students have clear expectations on making sure they present a unified theme and briefly mention all innovations in their proposal.")
        EndCallout()
        Paragraph("Have groups fill out the two reflection questions on their project guides to lock down their unified theme and also find the connections between their theme and the innovation they chose.")
        Paragraph():Strong("Work Time - 35 minutes:"):Text(" Groups should get 35 minutes to work on designing their presentation.")
    end

    private action WrapUp5Minutes
        Section("Wrap up (5 Minutes)")
        Subsection("Remarks")
        BulletList()
        ListItem("Great work today delegates. Next time we meet you'll have a chance to get feedback on your draft presentations from another group. Then you'll have work time to finish your presentations and make any final edits to your one-pagers because after that it'll be time for the big convention!")
    end

    private action StandardsAlignment
        Section("Standards Alignment")
        BulletList()
        ListItem():Strong("CSTA K-12 Computer Science Standards (2017):"):Text(" 3A-IC-24, 3A-IC-27, 3B-IC-25")
    end
end
