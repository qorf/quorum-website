use Libraries.Web.Page.QuorumPage

/*
    Cybersecurity - Lesson 12: Project - Innovation Simulation Part 6.
    Converted from the old Lesson page by plan 13's generator: the same
    words, now without Tailwind.
*/
class CodeOrgUnit10Lesson12 is QuorumPage

    on create
        SetLocation("lessons/code/Cybersecurity/Lesson12.html")
        // The name lists and links use, and the series and track it belongs
        // to: its section and picture.
        SetShortTitle("Project - Part 6")
        SetSectionName("Cybersecurity and Global Impacts")
        // For search engines and link previews, and what lists of pages say.
        SetDescription("Lesson Overview")
        SetSummary("Lesson Overview")
    end

    action Setup
        SetWebPageTitle("Unit 10 Lesson 12: Project - Innovation Simulation Part 6")
        Title("Cybersecurity - Lesson 12: Project - Innovation Simulation Part 6")
        Overview()
        GettingStarted2Minutes()
        Activity35Mins()
        WrapUp5Minutes()
        StandardsAlignment()
    end

    private action Overview
        Section("Overview")
        Paragraph("Students will get feedback on their group innovation proposal from one other group. They will then have the remainder of the class to finalize their group presentation and individual proposals which will be presented and submitted in the following class")
        Subsection("Purpose")
        Paragraph("This lesson is primarily a work day but students get some early feedback from another group to enable them to make final adjustments to their projects.")
        Subsection("Goals")
        Paragraph("Students will be able to:")
        BulletList()
        ListItem("Students will have completed designing and preparing for their group presentation.")
        Subsection("Preparation")
        BulletList()
        ListItem("Make sure students have access to their project guides if you are collecting them between classes.")
        Subsection("Resources")
        Subsubsection("Supplemental code.org material")
        Paragraph("For the Teachers")
        BulletList()
        ListItem():Link("CSP Unit 10 Project Overview", "https://docs.google.com/document/d/105rBn4_ylOlRWmgxvQdMjo8v0Iwrg3Aw-9vPIVsAYpc/edit?usp=sharing")
        ListItem():Link("CSP Unit 10 - Cybersecurity and Global Impacts", "https://docs.google.com/presentation/d/1CFWhRU6Sqrj9KFjLJRDnS2CFJZ_lHufFAweKNZumlic/copy")
        Paragraph("For the Students")
        BulletList()
        ListItem():Link("CSP Innovation Simulation Project Guide - Activity Guide", "https://docs.google.com/document/d/19git_OKuw7fGJV53Xgieb0FYwrPZ3svKxHaHxwzlA-c/")
    end

    private action GettingStarted2Minutes
        Section("Getting Started (2 minutes)")
        Paragraph():Strong("Distribute:"):Text(" Pass out badges and nameplates. While you are doing this, draw students' attention to the red box in the slide header that indicates the class is in simulation mode. From this point on in the class, students are thinking from the perspective of their given character.")
        Paragraph():Strong("Group:"):Text(" Instruct students to sit with their project teams")
        Paragraph():Strong("Remarks")
        BulletList()
        ListItem("Delegates today is primarily a work day, but to begin you'll be meeting briefly with another group. You'll share the overall theme for your presentation, the way the different innovations tie into that theme, and the way you intend to present your vision for the Future School. You'll use the feedback you share with one another to make final changes to your project before presenting.")
    end

    private action Activity35Mins
        Section("Activity (35 mins)")
        Paragraph():Strong("Distribute: "):Text("Give students back "):Link("CSP Innovation Simulation Project Guide - Activity Guide", "https://docs.google.com/document/d/19git_OKuw7fGJV53Xgieb0FYwrPZ3svKxHaHxwzlA-c/"):Text(" if they don't already have them on hand.")
        BulletList()
        ListItem():Strong("Group:"):Text(" Have 2 - 3 members of each project team meet with 2 - 3 members of another project team, forming groups of 4 - 6. Ideally groups will get feedback from multiple other groups but this may be difficult to guarantee.")
        ListItem():Strong("Feedback - 10 Mins:"):Text(" Groups should spend at most 10 minutes, 5 minutes on each project, sharing their project team's overall vision, the innovations they'll be presenting, and the high level format of their presentation. Members of the other group should provide critiques and suggestions, in particular any feedback from the perspective of their character about how they could benefit or be harmed by the proposed innovation.")
        ListItem():Strong("Work Time - 30 minutes:"):Text(" Groups should get 30 minutes to work on finish designing their presentations and making any final edits to their one-pagers.")
        TeachingTip()
        Paragraph():Strong("Time Expectations:"):Text(" Make sure to set clear expectations with your students about how much time they'll have to present. This curriculum assumes roughly 20-30 minutes for all groups to present.")
        Paragraph():Strong("Encouraging Creative Presentations: "):Text("Depending on your students' interests and skills you may encourage a wide variety of presentation types. While students have clear expectations on making sure they present a unified theme and briefly mention all innovations in their proposal,")
        EndCallout()
    end

    private action WrapUp5Minutes
        Section("Wrap up (5 Minutes)")
        Subsection("Remarks")
        BulletList()
        ListItem("Thank you delegates for your hard work today. Next time we meet it will be for the actual presentations and to decide on the strongest overall presentations in our Future School Convention. I look forward to seeing you there!")
        TeachingTip()
        Paragraph():Strong("Printing / Digital Access to One Pagers:"):Text(" Make sure students print or are ready to digitally share 1-pagers for the next class.")
        EndCallout()
    end

    private action StandardsAlignment
        Section("Standards Alignment")
        BulletList()
        ListItem():Strong("CSTA K-12 Computer Science Standards (2017):"):Text(" 3A-IC-24, 3A-IC-27, 3B-IC-25")
    end
end
