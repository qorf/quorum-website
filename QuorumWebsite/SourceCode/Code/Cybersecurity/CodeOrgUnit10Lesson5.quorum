use Libraries.Web.Page.QuorumPage

/*
    Cybersecurity - Lesson 5: Project - Innovation Simulation Part 3.
    Converted from the old Lesson page by plan 13's generator: the same
    words, now without Tailwind.
*/
class CodeOrgUnit10Lesson5 is QuorumPage

    on create
        SetLocation("lessons/code/Cybersecurity/Lesson5.html")
        // The name lists and links use, and the series and track it belongs
        // to: its section and picture.
        SetShortTitle("Project - Part 3")
        SetSectionName("Cybersecurity and Global Impacts")
        // For search engines and link previews, and what lists of pages say.
        SetDescription("Evaluate the benefits and harms that could potentially be caused by a computing innovation")
        SetSummary("Evaluate the benefits and harms that could potentially be caused by a computing innovation")
    end

    action Setup
        SetWebPageTitle("Unit 10 Lesson 5: Project - Innovation Simulation Part 3")
        Title("Cybersecurity - Lesson 5: Project - Innovation Simulation Part 3")
        Overview()
        GettingStarted10Minutes()
        Activity35Mins()
        WrapUp5Minutes()
        StandardsAlignment()
    end

    private action Overview
        Section("Overview")
        Paragraph("Students make further projects on their projects while also considering the unintended consequences their proposed innovations may have. First students watch a short video about the ways technology may have unintended consequences. Students then meet with their teams to review the different proposals for computing innovations that each team member is considering. Teams review the different ideas in character and help one another consider potential benefits and harms of each plan. Collectively they narrow down their proposals to a set that seem collectively most beneficial and present a coherent vision for the Future School. With whatever time is remaining students are able to work on one-pagers for the one innovation they chose.")
        Subsection("Purpose")
        Paragraph("In previous lessons students have been considering the ways that computing innovations may risk their privacy. This lesson further builds on those questions by asking students to think more broadly about the ways computing innovations may have unintended consequences.")
        Paragraph("The next project lesson will be spent primarily working on one-pagers. That lesson and the second half of this one are the largest chunks of class time dedicated to students completing those individual projects.")
        Subsection("Goals")
        Paragraph("Students will be able to:")
        BulletList()
        ListItem("Evaluate the benefits and harms that could potentially be caused by a computing innovation.")
        ListItem("Explain how the benefits and harms of a computing innovation may be different in the eyes of different people.")
        Subsection("Preparation")
        BulletList()
        ListItem("Ensure students have access to their project guides.")
        Subsection("Resources")
        Subsubsection("Supplemental code.org material")
        Paragraph("For the teachers")
        BulletList()
        ListItem():Link("CSP Unit 10 Project Overview - Resource", "https://docs.google.com/document/d/105rBn4_ylOlRWmgxvQdMjo8v0Iwrg3Aw-9vPIVsAYpc/edit?usp=sharing")
        Paragraph("For the Students")
        BulletList()
        ListItem():Link("CSP Innovation Simulation Project Guide - Activity Guide", "https://docs.google.com/document/d/19git_OKuw7fGJV53Xgieb0FYwrPZ3svKxHaHxwzlA-c/")
    end

    private action GettingStarted10Minutes
        Section("Getting Started (10 minutes)")
        Paragraph():Strong("Distribute:"):Text(" Pass out badges and nameplates from the previous project lesson. While you are doing this, draw students' attention to the red box in the slide header that indicates the class is in simulation mode. From this point on in the class, students are thinking from the perspective of their given character.")
        Paragraph():Strong("Group:"):Text(" Instruct students to sit with their team from the previous lesson.")
        Paragraph():Link("Display: Show the video embedded in the slides about unintended consequences of computing innovations (~6 minutes). Show the following slide which summarizes some important key points.", "https://youtu.be/POTosC2q6Hs")
    end

    private action Activity35Mins
        Section("Activity (35 mins)")
        Paragraph():Link("Ensure students have access to their copies of the CSP Innovation Simulation Project Guide - Activity Guide", "https://docs.google.com/document/d/19git_OKuw7fGJV53Xgieb0FYwrPZ3svKxHaHxwzlA-c/")
        Paragraph():Strong("Prompt:"):Text(" Remind yourself of your character's goals and motivations. What can your character's perspectives and goals bring to the table? How can you help avoid some of the unintended consequences of your innovations?")
        Paragraph():Strong("Review Proposed Innovations:"):Text(" Students should meet with their groups to discuss the different proposed innovations they researched previously. Students will need to move quickly through their different ideas and offer potential pros and cons of each innovation in character. Record feedback in "):DoubleQuote():Text("Step 3"):DoubleQuote():Text(" of the Activity Guide.")
        Paragraph("This discussion should highlight the fact that a computing innovation, and even a single effect of a computing innovation can be viewed as both beneficial and harmful by the different people, or even by the same person.")
        Paragraph("Students should aim to spend roughly half their class time discussing their different ideas with the goal of settling on one innovation that they believe will bring the most overall benefit while also making sense with the broader vision of their team.")
        Paragraph("Students should brainstorm a unifying theme for their group's vision. Each member of the team should determine which one of their three innovations will ultimately be included in their group's vision for the Future School. This innovation will be presented alongside the innovations selected by the other members in their group later in this project.")
        Paragraph():Strong("Begin working on Innovation One-Pager:"):Text(" Students should individually move to the next portion of their project guide where they will be working on their innovation one-pager. Students will need to do further research about their innovation in order to complete this guide. Students should be allowed to work on this activity for the remainder of the class period.")
        TeachingTip()
        Paragraph():Strong("Supporting Discussion: "):Text("Move around the room listening to the ways that different groups are discussing the pros and cons of their innovations. Encourage students to be comfortable disagreeing with one another while representing the needs of their character and thinking broadly about the potential consequences of the innovations they are considering.")
        Paragraph():Strong("Narrowing It Down to Fit the Theme:"):Text(" As groups focus their ideas on a single theme or vision, that will help students also narrow down which innovation they want to include. For example, if their theme is a school that is focused on social justice, that may influence which of the three innovations a student researched is included in the group's final presentation. Students may need help narrowing down their proposals - encourage them to keep the theme of the group in mind as they select the innovation they will create a one-pager on.")
        EndCallout()
    end

    private action WrapUp5Minutes
        Section("Wrap up (5 Minutes)")
        Subsection("Remarks")
        Paragraph("Good work today delegates. Next time we meet you'll have more time to work on your one-pagers. Continue to discuss with your groups the ways that your proposals will work together to form a coherent vision for the Future School.")
    end

    private action StandardsAlignment
        Section("Standards Alignment")
        BulletList()
        ListItem():Strong("CSTA K-12 Computer Science Standards (2017): "):Text("3A-IC-24, 3A-IC-27, 3B-IC-25")
        ListItem():Strong("CSP2021: "):Text("IOC-1.A")
    end
end
