use Libraries.Web.Page.QuorumPage

/*
    Cybersecurity - Lesson 10: Protecting Data Part 2.
    Converted from the old Lesson page by plan 13's generator: the same
    words, now without Tailwind.
*/
class CodeOrgUnit10Lesson10 is QuorumPage
    // A double quote, for code and words that hold one.
    text dq = ""

    on create
        SetLocation("lessons/code/Cybersecurity/Lesson10.html")
        // The name lists and links use, and the series and track it belongs
        // to: its section and picture.
        SetShortTitle("Protecting Data Part 2")
        SetSectionName("Cybersecurity and Global Impacts")
        // For search engines and link previews, and what lists of pages say.
        SetDescription("Students gain a working knowledge of the different types of encryption.")
        SetSummary("Students investigate the different types of encryption.")
    end

    action Setup
        dq = dq:GetDoubleQuote()
        SetWebPageTitle("Unit 10 Lesson 10: Protecting Data Part 2")
        Title("Cybersecurity - Lesson 10: Protecting Data Part 2")
        Overview()
        GettingStarted5Minutes()
        Activity35Mins()
        WrapUp5Minutes()
        AssessmentCheckForUnderstanding()
        StandardsAlignment()
    end

    private action Overview
        Section("Overview")
        Paragraph("This lesson is a guided tour of multifactor authentication and software updates that students can use to protect their data. Following these discussions, students are introduced to a stimulus question where they will apply their knowledge gained throughout the unit to answer questions about an innovations data, benefits and harms, effects, and security or privacy concerns.")
        Subsection("Purpose")
        Paragraph("This lesson serves two purposes. The first is to provide the final pieces of content students need to know in this unit - related to multifactor authentication and virus scanning software. These are tools students can use to protect the data. The second purpose of this lesson is to introduce students to questions that follow the same format as the questions students will encounter on the AP Multiple Choice Exam. The specific types of questions students will see in this lesson will help prepare them to answer "):DoubleQuote():Text("Single-Select Questions with Reading Passage"):DoubleQuote():Text(", or SSQRP. These types of questions show up on the AP Computer Science Principles Multiple Choice Exam and involve a series of questions about a fictitious computing innovation.")
        Subsection("Goals")
        Paragraph("Students will be able to:")
        BulletList()
        ListItem("Explain the benefits of multifactor authentication.")
        ListItem("Discuss the benefits of computer virus scanning software and the need for regular updates.")
        ListItem("Thoughtfully answer a stimulus question.")
        Subsection("Preparation")
        BulletList()
        ListItem("Preview the slides.")
        ListItem("Read through the stimulus question.")
        Subsection("Resources")
        Paragraph("For the students")
        BulletList()
        ListItem():Link("Call Center - Reading Passage", "https://docs.google.com/document/d/1ukiDCZ1tnd0CtuPl0o2H6vOLGaYbIgjbO2xHlLTuTio/edit?usp=sharing")
        Subsubsection("Supplemental Code.org material")
        BulletList()
        ListItem():Link("Code.Org Unit 10 Slides", "https://docs.google.com/presentation/d/13hzCmcAxUal2GpjNj6yjxzAtB58TPPG8tjVZRLvcwf0/edit?usp=sharing")
    end

    private action GettingStarted5Minutes
        Section("Getting Started (5 minutes)")
        Subsection("Remarks")
        Paragraph("In the previous lesson we discussed how your data is protected through encryption. Today we are going to focus on what you can personally do to keep your data protected.")
        Paragraph():Strong("Prompt:"):Text(" What strategies do you use when creating a good password?")
        BulletList()
        ListItem():Strong("Note:"):Text(" Make sure students don't reveal any of their current passwords in the discussion!")
        Paragraph("A good password is easy to remember, but hard for someone else to guess based on knowledge they have about you.")
        Paragraph("If your password is your dog's name and your birthdate, that's all personal information that someone else might be able to guess!")
        DiscussionGoal()
        Paragraph("Students should discuss good password management, building off of their knowledge from earlier in the unit. The following slide contains best practices, but your students may have some more concrete suggestions for how they craft complex but memorable passwords.")
        EndCallout()
    end

    private action Activity35Mins
        Section("Activity (35 mins)")
        Subsection("Protecting Data (15 mins)")
        Paragraph():Strong("Display:"):Text(" Use the activity slides below or with the slides included with this lessons to guide the discussion on Protecting Data")
        Table("Protecting Data Slides")
        TableHeader():Cell("Slide"):Cell("Say")
        TableRow():Cell("Protecting Data"):Cell("There are things you can do to protect your data. The first one we are going to talk about using multifactor authentication.")
        TableRow():Cell("Single Factor Authentication"):Cell("When we discussed passwords in the Warm Up, this was an example of single factor authentication. There is one layer of protection, that is centered around something you know: your password")
        TableRow():Cell("Two Factor Authentication Part 1"):Cell("Two Factor Authentication: What do you think is another way of protecting your data? In addition to something you know, another layer is something you possess like a phone. Have you ever been required to put a phone number in when getting a password authenticated? Sometimes a text will be sent to your phone with a code to enter in, proving that you are the person who has the phone. This layer means someone who just guesses your password can't get in to your account - they would also need access to your phone.")
        TableRow():Cell("Two Factor Authentication Part 2"):Cell("What are the problems with this system? How could it be hacked? Guide the discussion towards the answer that a phone could be stolen or a sim card lost")
        TableRow():Cell("Two Factor Authentication Part 3"):Cell("There's another layer that can be used to protect your data. Can anyone guess what it is? If you guessed something physical or perhaps " + dq + "biometrics" + dq + ", you are correct! A fingerprint is an example of this. A retina scan of your eye is another example. These three options: something you know, something you possess, and something you are make up multifactor authentication, which involves at least two of these options and preferably all three. If someone tried to access your account, they would be required to know your password, have access to your phone and your fingerprint!")
        TableRow():Cell("Two Factor Authentication Part 4"):Cell("Why is this better than Single Factor Authentication? What are the challenges with the system? Is it worth any of the risks? Allow students time to think through these prompts, perhaps in small groups before having a whole class discussion. Multifactor authentication can keep data more protected than single factor authentication, but it requires extra steps which add time and often money (the cost of a phone, etc.). There are also privacy concerns with having your fingerprints or retina scanned.")
        TableRow():Cell("Sofware Updates"):Cell("Another way to protect your data involves updating your software.")
        TableRow():Cell("Sofware Viruses"):Cell("Let's review. What is a virus? Give students an opportunity to glance through the notes and review computer viruses from lesson 7.")
        TableRow():Cell("Sofware Viruses"):Cell("Do you remember how to protect your device from a computer virus? Allow students to suggest different forms of protection before clicking through the animation. Two things you can do: use virus scanning software and update system software. You could also say, keep all software updated!")
        TableRow():Cell("Sofware Viruses"):Cell("Do you remember how to protect your device from a computer virus? Allow students to suggest different forms of protection before clicking through the animation.")
        TableRow():Cell("Protecting Data Summary"):Cell("Data protection is a moving target. It's not a one and done process. It's not enough to install virus protection software and never thing about it again! New viruses and threats are constantly being developed - you need to keep your software up to date and use the best authentication practices you can in order to keep your data safe!")
        Subsection("Single-Select Questions with Reading Passage (SSQRP) (20 mins)")
        Paragraph("Now we are going to shift gears and discuss Single-Select Questions with Reading Passage or SSQRP. What is SSQRP?")
        Paragraph("Over the course of this unit you've learned a lot about computing innovations. SSQRP is designed to assess how well you understand the various issues surrounding computing innovations. The good news is, you aren't expected to have any prior knowledge about the computing innovations discussed in these questions - they are all made up. You will have a short reading passage followed by five multiple choice quesions that focus on data, purpose and effect, benefits and harms, and security concerns. SSQRP is present on the AP CSP exam, and there will be two in the end of unit assessment.")
        Paragraph():Link("(Optional) Distribute: Hand out Call Center - Reading Passage - Resource", "https://docs.google.com/document/d/1ukiDCZ1tnd0CtuPl0o2H6vOLGaYbIgjbO2xHlLTuTio/edit?usp=sharing")
        Paragraph():Strong("Call Center Reading Passage: "):Text("A chain of retail stores uses software to manage telephone calls from customers. The system was recently upgraded. Customers interacted with the original system using their phone keypad. Customers interact with the upgraded system using their voice. The upgraded system (but not the original system) stores all information from the calling session in a database for future reference. This includes the customer's telephone number and any information provided by the customer (name, address, order number, credit card number, etc.). The original system and the upgraded system are described in the following flowcharts. Each flowchart uses the following blocks.")
        Subsubsection("Block 1")
        BulletList()
        ListItem("Customer hears prerecorded message with answers to common questions (e.g., store hours)")
        ListItem("Customer hears list of departments and selects one using a phone keypad.")
        ListItem("Question: Did they call during business hours?")
        ListItem("If Yes, Customer is transferred to a representative from the department they selected.")
        ListItem("If No, Customer is prompted to leave a message for a representative of the deaprtment they selected.")
        Subsubsection("Block 2")
        BulletList()
        ListItem("Customer prompted to describe the issue.")
        ListItem("Customer describes the issue by voice.")
        ListItem("Question: Can the system identify the customer's issue?")
        ListItem("If No, Did they call during business hours?")
        ListItem("If they did call during business hours, Customer is transfered to a human operator.")
        ListItem("If they did not, Customer is asked to call back during business hours.")
        ListItem("If the system COULD identify the customer's issue, Does the Issue require a human response?")
        ListItem("If it does not require a human response, System plays an appropriate recording to the customer.")
        ListItem("If it does require a human response, did the call happen during business hours?")
        ListItem("If it is during business hours, Customer is transferred to a representative from a relavant department.")
        ListItem("If it is not during business hours, Customer is prompted to leave a message, which is then routed to a representative from a relevant department.")
        Paragraph():Strong("Do This:"):Text(" Direct students to take a few minutes to read the information about the computing innovation. They do not need to memorize anything - they can look back at the paper at any time while answering the questions.")
        Paragraph():Strong("Do This:"):Text(" Read through the "):DoubleQuote():Text("Sample Questions"):DoubleQuote():Text(" slide as a class. This slide introduces the two categories from which questions will be pulled, along with common phrases. Go through the phrases, and make sure students understand what each phrase means. For example, you may want to spend time on the phrase "):DoubleQuote():Text("unintended effect"):DoubleQuote():Text(" as this may be a confusing combination of words for some students. The focus here is on understanding question types - it may be useful to have students think through what some of the possible answer options might be for some of the questions.")
        Paragraph():Strong("AP Classsroom"):Text(" Direct students to navigate to AP Classroom and complete the five practice questions relating to the Call Center. Allow students to see the answers. Following this, discuss with the class any confusion over the questions or the computing innovation.")
        Paragraph():Strong("Single-Select Questions with Reading Passage Examples"):Text("The following table lists two topics with sample questions. The text in square brackets [ ] are different question options.")
        Table("Table with sample questions from Reading Passage")
        TableHeader():Cell("Practice Topic 3: Abstraction in Program Development"):Cell("Practice Topic 5: Computing Innovations")
        TableRow():Cell("Which of the following input data [must be obtained/is needed] by the upgraded system that was NOT needed by the original system?"):Cell("Which of the following is considered a potential effect of the the application rather than a [function/purpose] of the application?")
        TableRow():Cell("Which of the following data is not [obtained/provided] directly from the user but is necessary for the upgraded system to operate as described?"):Cell("Which of the following is [LEAST/MOST] likely to be a [BENEFIT/HARM] of storing the information from each calling session in a database?")
        TableRow():Cell("Which of the following data is necessary for the Call Center to process in order to enable it to provide an answer to the caller?"):Cell("Of the following potential benefits, which is [LEAST/MOST] likely to be provided by the upgraded system?")
        TableRow():Cell("Which of the following is [LEAST/MOST] likely to be included in the directory?"):Cell("Which of the following may be an unintended effect of the use of Call Center?")
        TableRow():Cell("N/A"):Cell("Which of the following is the [LEAST/MOST] [likely/plausible] data [PRIVACY/SECURITY/STORAGE] concern of the upgraded system?")
        TableRow():Cell("N/A"):Cell("Which of the following groups is [LEAST/MOST] likely to receive targeted advertisements?")
        TableRow():Cell("N/A"):Cell("Which of the following statements is [LEAST/MOST] likely to be true about the tradeoffs of the Call Center recording the caller's phone number?")
        Paragraph("And that's SSQRP! Hopefully you saw through this example the steps of reasoning through the answers and applying your knowledge of the issues related to computing innovations.")
        TeachingTip()
        Paragraph("To assign questions to students on AP Classroom, once logged in navigate to the Question Bank. Search for the following question:")
        Paragraph():Emphasis("benefit of storing call session information")
        Image("media/lessons/csp/unit10/APClassroomexample1.png", "a picture showing the question bank search for benefit of storing call session information")
        Paragraph("Then add this question to a quiz like so:")
        Image("media/lessons/csp/unit10/APClassroomexample2.png", "a picture showing how to create a quiz by typing a name in the search bar and clicking on the button marked reate quiz")
        Paragraph("Once you have added one question, you'll see that you can easily import the other 4 practice questions into your quiz.")
        Image("media/lessons/csp/unit10/APClassroomexample3.png", "a picture of how to add question by clicking on the add question button")
        Paragraph("Click where it says "):DoubleQuote():Text("5 questions"):DoubleQuote()
        Image("media/lessons/csp/unit10/APClassroomexample4.png", "a picture showing where to click to add questions to a bank by selecting them from the question bank")
        Paragraph("And choose to add all of the questions.")
        Image("media/lessons/csp/unit10/APClassroomexample5.png", "a picture showing the final result where five questions have been added to a quiz.")
        Paragraph("Following this, you can assign the assessment to your students and they can practice the Reading Passage questions.")
        EndCallout()
        DiscussionGoal()
        Paragraph("If students are struggling with answering this question, prompt them with more specific questions:")
        BulletList()
        ListItem("How will you decide on your next password?")
        ListItem("Will you use two-factor or multifactor authentication when you have the opportunity?")
        ListItem("How often do you update your software?")
        ListItem("How up to date is the software on your devices?")
        EndCallout()
    end

    private action WrapUp5Minutes
        Section("Wrap up (5 Minutes)")
        Subsection("Remarks")
        Paragraph("In the first half of class, we discussed protecting data. Let's review that.")
        Paragraph():Strong("Prompt:"):Text(" Discuss with a partner how you plan to protect your data.")
        Paragraph():Strong("Journal: "):Text("Students add to their journals the definitions for: multifactor authentication and computer virus scanning software.")
        BulletList()
        ListItem():Emphasis("Multifactor Authentication:"):Text(" a method of computer access in which a user has to successfully provide evidence in at least two of the following categories: knowledge (something they know), possession (something they have), and inherence (something they are). Each step provides a new layer of security.")
        ListItem():Emphasis("Computer Virus Scanning Software:"):Text(" protects a computing system against infection.")
    end

    private action AssessmentCheckForUnderstanding
        Section("Assessment: Check for Understanding")
        Subsection("For Teachers")
        Paragraph("Check For Understanding Question(s) and solutions can be found in each lesson on Code Studio. These questions can be used for an exit ticket.")
        Subsection("For Students")
        Paragraph("Open a word doc or google doc and copy/paste the following question.")
        Subsection("Question")
        Paragraph("Reflection: What concerns do you have about multifactor authentication? Is it a good long term solution for data privacy?")
    end

    private action StandardsAlignment
        Section("Standards Alignment")
        BulletList()
        ListItem():Strong("CSTA K-12 Computer Science Standards (2017): "):Text("3A-NI-06,3A-NI-07,3B-NI-04")
        ListItem():Strong("CSP2021: "):Text("IOC-2.B")
    end
end
