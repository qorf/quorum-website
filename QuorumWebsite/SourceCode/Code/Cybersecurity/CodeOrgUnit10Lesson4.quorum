use Libraries.Web.Page.QuorumPage

/*
    Cybersecurity - Unit 10 Lesson 4: The Value of Privacy.
    Converted from the old Lesson page by plan 13's generator: the same
    words, now without Tailwind.
*/
class CodeOrgUnit10Lesson4 is QuorumPage

    on create
        SetLocation("lessons/code/Cybersecurity/Lesson4.html")
        // The name lists and links use, and the series and track it belongs
        // to: its section and picture.
        SetShortTitle("The Value of Privacy")
        SetSectionName("Cybersecurity and Global Impacts")
        // For search engines and link previews, and what lists of pages say.
        SetDescription("Evaluate whether the benefits to society from a given computing innovation outweigh the privacy risks it poses.")
        SetSummary("Understanding privacy risks with computer innovation")
    end

    action Setup
        SetWebPageTitle("Unit 10 Lesson 4: The Value of Privacy")
        Title("Cybersecurity - Unit 10 Lesson 4: The Value of Privacy")
        Overview()
        GettingStarted0Minutes()
        Activity35Mins()
        WrapUp5Minutes()
        AssessmentCheckForUnderstanding()
        StandardsAlignment()
    end

    private action Overview
        Section("Overview")
        Paragraph("Students develop their own opinions on the privacy tradeoffs inherent in many modern computing innovations. At the beginning of the lesson students watch a video on facial recognition technology that presents the tradeoffs between convenience and privacy and asks them to determine whether they think the tradeoff is worth it. Students respond to two videos that look at different tradeoffs between privacy, security, and convenience. Students then evaluate the website or app they investigated in the previous lesson to determine if they think the benefits of the service outweigh the privacy risks. At the end of the class students discuss whether they generally think convenience outweighs privacy concerns.")
        Subsection("Purpose")
        Paragraph("The previous lesson exposed students to much of the data that is collected by the services they use, but it didn't ask them to reflect on their own opinions of those practices. This lesson now asks students to form opinions of their own about how a digital world in which more and more important innovations seem to come at the cost of their personal privacy.")
        Subsection("Goals")
        Paragraph("Students will be able to:")
        BulletList()
        ListItem("Evaluate whether the benefits to society from a given computing innovation outweigh the privacy risks it poses.")
        ListItem("Assess a computing innovation to identify the specific privacy risks that could arise from the data it collects and stores.")
        ListItem("Explain the risks to privacy that arise from using modern computing technology")
        Subsection("Preparation")
        BulletList()
        ListItem("Review the videos to make sure you are prepared to lead the subsequent discussions")
        ListItem("Make sure you have access to the activity guides students completed in th previous lesson")
        Subsection("Resources")
        Subsubsection("Supplemental Code.org material")
        BulletList()
        ListItem():Link("Privacy, Security, and Innovation - Activity Guide", "https://docs.google.com/document/d/1v4Q2dsV0zJCh1zgcP3mwKu-iIsn9gl7v5-ZDwYMlSMs/")
    end

    private action GettingStarted0Minutes
        Section("Getting Started (0 minutes)")
        Paragraph():Link("As students walk in give them copies of their Privacy, Security, and Innovation - Activity Guide which they began filling out in the previous lesson.", "https://docs.google.com/document/d/1v4Q2dsV0zJCh1zgcP3mwKu-iIsn9gl7v5-ZDwYMlSMs/")
        Paragraph():Strong("Prompt:"):Text(" Review your work in Unit 10 Lesson 3 Activity from the last lesson. Remind yourself what your privacy concerns were for the app / website you chose.")
        TeachingTip()
        Paragraph():Strong("Move Quickly to the Main Activity:"):Text(" An optional prompt is provided but otherwise move quickly into watching and reviewing the videos so that students will have enough time to complete their activity guides.")
        EndCallout()
    end

    private action Activity35Mins
        Section("Activity (35 mins)")
        Subsection("Convenience vs Privacy - Facial Recognition - 10 mins")
        Paragraph():Strong("Prompt:"):Text(" As we watch the following video on facial recognition takes notes on:")
        Paragraph():Link("Facial Recognition - Video", "https://youtu.be/f5qgOqNQ7zY?si=pscHpPdt5y1RXfW3")
        Video("https://www.youtube.com/embed/f5qgOqNQ7zY?si=SHjcF78QEnbKcWg-", "Is Facial Recognition Invading Your Privacy?")
        BulletList()
        ListItem("What are the benefits of the technology? What does it make more convenient / fun?")
        ListItem("What are the privacy concerns that arise?")
        ListItem("Why would governments or businesses be interested in this technology?")
        Paragraph("Afterwards we'll discuss whether we think the benefits outweigh the privacy conerns.")
        Paragraph():Strong("Display:"):Text(" Show the video about facial recognition technology.")
        Paragraph():Strong("Discuss:"):Text(" Students should share notes with their partner about the three prompts and then discuss the provided question "):DoubleQuote():Text("Do you believe the privacy risks posed by facial recognition technology outweigh the privacy concerns?"):DoubleQuote():Text(" Have students share some of their thoughts as a class.")
        DiscussionGoal()
        Paragraph():Strong("Goal:"):Text(" Use this first video to focus on the tradeoffs between convenience and privacy. Students have likely used or seen new technology that uses facial recognition that might be helpful or fun, and many examples are provided in the video. The following video focuses more on the security vs. privacy balance.")
        EndCallout()
        Subsection("Security vs Privacy - Should the Government Need a Warrant? - 10 mins")
        Paragraph():Strong("Prompt:"):Text(" As we watch the following video on location data takes notes on:")
        Paragraph():Link("Location Data - Video", "https://www.youtube.com/watch?v=07YzpuDgvDM")
        Video("https://www.youtube.com/embed/07YzpuDgvDM?si=Aaz8QsE2czEHVrOI", "Cops Need A Warrant To Search Your Cell Phone’s Location History, Supreme Court Rules")
        BulletList()
        ListItem("What kind of data is being collected and shared?")
        ListItem("Who is the "):DoubleQuote():Text("third party"):DoubleQuote():Text(" in this situation?")
        ListItem("Why is this a tradeoff between privacy and security?")
        Paragraph("Afterwards we'll discuss whether we think the benefits outweigh the privacy concerns.")
        Paragraph():Strong("Display:"):Text(" Show the video about cell phone location data.")
        Paragraph():Strong("Discuss:"):Text(" Students should share notes with their partner about the three prompts and then discuss the provided question "):DoubleQuote():Text("Do you agree with the Supreme Court's ruling? Do you think it should apply to other kinds of data?"):DoubleQuote():Text(" Have students share some of their thoughts as a class.")
        Subsection("Privacy Tradeoffs - Your Innovation - 15 mins")
        Paragraph():Strong("Prompt:"):Text(" Individually fill in the last page of your activity guide.")
        Paragraph():Strong("Discuss:"):Text(" Students are given a good chunk of class time to complete this activity. Ask students to reflect quietly but as individuals or groups finish they should begin discussing with one another. If most students finish early you could begin a full-class discussion.")
        TeachingTip()
        Paragraph():Strong("Developing an Informed Opinion: "):Text("This lesson has asked students to hold off on weighing in on the innovations they researched in the previous class to develop a more nuanced and informed opinion about the tradeoffs between innovation, privacy, and security. As students move to this last activity, remind them of the more nuanced opinion they've developed, and ask them to reflect on how the different examples they've seen impact their overall opinions on this tradeoff.")
        EndCallout()
    end

    private action WrapUp5Minutes
        Section("Wrap up (5 Minutes)")
        Paragraph():Strong("Prompt:"):Text(" Based on the discussions we had today, which of the following best describes your overall feelings with sharing private data in order to power innovations or ensure security.")
        BulletList()
        ListItem("1: Totally Comfortable: "):DoubleQuote():Text("Have my data! It makes the technology I love work and I have nothing to hide!"):DoubleQuote()
        ListItem("2: Mostly Comfortable: "):DoubleQuote():Text("I want tech innovations and stronger security. Let's make sure we take care of the most damaging privacy concerns."):DoubleQuote()
        ListItem("3: Mixed: "):DoubleQuote():Text("There's a lot of this that makes me uncomfortable, but I'm still going to use technology."):DoubleQuote()
        ListItem("4: Mostly Uncomfortable: "):DoubleQuote():Text("Privacy is more important than empowering innovations or ensuring security. I would give up on some tech innovations to ensure my privacy"):DoubleQuote()
        ListItem("5: Totally Uncomfortable: "):DoubleQuote():Text("I'd give up most technology and would like to see much stronger limits on what kind of data can be collected and stored, even if it limits the introduction of new technology"):DoubleQuote()
        Paragraph():Strong("Discuss:"):Text(" Have a few people from each end of the spectrum share their reasoning.")
        Paragraph():Strong("Review:"):Text(" Review the key takeaways at the end of the lesson.")
        DiscussionGoal()
        Paragraph():Strong("Goal:"):Text(" Use this discussion to do some classwide synthesis of today's discussions about the tradeoffs between privacy and empowering new technology or ensuring security. The goal here is to move individual students to think broadly about their opinions, not force every student to have the same opinion. It's not necessary that students agree, but prompt them to think critically about this important question posed by modern technology. Some ways to do this:")
        BulletList()
        ListItem("Ask them why they hold their opinions and ask them to tie them to today's lesson")
        ListItem("Ask them why they hold their opinions and ask them to tie them to today's lesson")
        ListItem("Ask students who disagree to politely debate their opinions")
        ListItem("Ask students to tie their opinions to their own experiences")
        EndCallout()
        Subsection("Remarks")
        Paragraph("There will always be tradeoffs between privacy and new exciting technology. Think about when you use a social media site and are offered targeted advertising based on your browser history. This can be useful! You may be introduced to things you want to buy or information you want to know about. However, it can also be harmful. Targeted advertising can be used to gather data about a user or a group of useres for malicious reasons. In this case, this innovation is not being used as it was originally intended to be used.")
        Paragraph("Consider this as you research the impacts of your computing innovations for the Innovation Simulation project.")
    end

    private action AssessmentCheckForUnderstanding
        Section("Assessment: Check for Understanding")
        Paragraph():Strong("Activity Guide:"):Text(" Once again collect the activity guide about the app / computing innovation that students researched in the previous lesson. If students missed the previous lesson they should use information collected by a partner about an app. A rubric included on the bottom of the activity guide can be used for assessment.")
    end

    private action StandardsAlignment
        Section("Standards Alignment")
        BulletList()
        ListItem():Strong("CSTA K-12 Computer Science Standards (2017): "):Text("2-IC-23, 3A-IC-29, 3A-IC-30, 3B-IC-28")
        ListItem():Strong("CSP2021: "):Text("IOC-1.A, IOC-1.B, IOC-1.F")
        ListItem():Strong("CSP2021: "):Text("IOC-2.A")
    end
end
