use Libraries.Web.Page.QuorumPage

/*
    Parameters, Return, and Libraries - Lesson 2: Parameters and Return Investigate.
    Converted from the old Lesson page by plan 13's generator: the same
    words, now without Tailwind.
*/
class CodeOrgUnit7Lesson2 is QuorumPage

    on create
        SetLocation("lessons/code/ParametersReturnLibraries/Lesson2.html")
        // The name lists and links use, and the series and track it belongs
        // to: its section and picture.
        SetShortTitle("Parameters and Return Investigate")
        SetSectionName("Parameters, Return, and Libraries")
        // For search engines and link previews, and what lists of pages say.
        SetDescription("Investigate and modify sample apps that use parameters and return values.")
        SetSummary("Learn about parameters and return")
    end

    action Setup
        SetWebPageTitle("Parameters and Return Investigate")
        Title("Parameters, Return, and Libraries - Lesson 2: Parameters and Return Investigate")
        Overview()
        GettingStarted5Minutes()
        Activity35Minutes()
        WrapUp5Minutes()
        AssessmentCheckForUnderstanding()
        StandardsAlignment()
    end

    private action Overview
        Section("Overview")
        Paragraph("In this lesson students work with partners to investigate two different apps that use parameters and return values. Students are also introduced to the mod operator as part of one of the apps that they use.")
        Subsection("Goals")
        Paragraph("Students will be able to:")
        BulletList()
        ListItem("Identify situations in which a function with a parameter or return value would be necessary")
        ListItem("Explain the benefits of using a function with a parameter or return value in the context of a specific program")
        ListItem("Modify programs that use functions with parameters and return")
        ListItem("Use the modulus operator in a program")
        Subsection("Purpose")
        Paragraph("As with all Investigate lessons, this is an opportunity for students to dig into programs that use a new concept, in this case parameters and return, in the context of working apps. Encourage students to read the code carefully, discuss their findings with classmates, make connections to the Explore activity from the day before, and start making simple modifications to the program. Students will not leave this lesson as experts in writing programs with parameters and return, but they should understand the high level context and know they can refer back to the code in these investigate projects when they need help getting unstuck in the coming Practice and Make lessons.")
        Subsection("Resources")
        BulletList()
        ListItem():Link("CSP-Widgets repository", "https://github.com/qorf/CSP-Widgets")
    end

    private action GettingStarted5Minutes
        Section("Getting Started (5 minutes)")
        Subsection("Who is Clean Code For?")
        Paragraph():Strong("Prompt: "):Text("Are clean and organized programs more useful for computers or people? Why? Try to give examples from programs you've written or seen in this class.")
        Paragraph():Strong("Discuss: "):Text("Have students silently journal their response, then discuss with a partner, and finally share with the class.")
        DiscussionGoal()
        Paragraph():Strong("Goal: "):Text("Parameters and return values allow students to write programs that are more organized and cleaner. Naming functions helps students write programs that read more like descriptions of what they do, and they also help students reuse code.")
        Paragraph("This quick discussion sets up many of these realizations. Students will not leave this lesson able to "):DoubleQuote():Text("do more"):DoubleQuote():Text(" than previously. Instead they'll be able to write programs that are cleaner, better organized, and better able to be used elsewhere. Long term, writing programs like this will actually help students write more complex code, but because they as programmers will better be able to understand their programs and reuse the code they write. This quick prompt does not need to cover all of those points and should just be a reminder of things they've already seen. Clean code is for humans, but in the long term it helps them write better programs.")
        EndCallout()
        Subsection("Remarks")
        BulletList()
        ListItem("Clean programs may sometimes run "):DoubleQuote():Text("better"):DoubleQuote():Text(" but usually they're just helpful for us as we read them and write them. In other words, clean code is for people, but in the long run writing good code can help us write larger and more complicated programs because we can just read them and understand what they're doing.")
        ListItem("Today we're going to learn more about parameters and return values. Something important to notice is that they might not actually change the way that your programs run, but they definitely will change the way we read and write programs. In general they'll make programs cleaner and easier to understand, but let's go look at some examples.")
    end

    private action Activity35Minutes
        Section("Activity (35 minutes)")
        Paragraph():Strong("Do This: "):Text("Take a few minutes to review the takeaways from the previous lesson.")
        Paragraph():Strong("Group: "):Text("Place students with partners")
        Paragraph():Strong("Do This: "):Text("Students navigate to "):Strong("Lesson2_App1"):Text(" and read and respond to the questions there. If students have extra time, they can try the modify activity.")
        TeachingTip()
        Paragraph("Make sure you leave time to bring the class back together for discussion and code walkthroughs. There's a lot to dig into with these Investigations.")
        EndCallout()
        BulletList()
        ListItem("How does "):Code("Calculate()"):Text(" work?")
        ListItem("What are the arguments passed through the parameter in "):Code("Calculate()"):Text(" when it is called?")
        ListItem("What types of data does the parameter require in the "):Code("Calculate()"):Text(" function? Where can you find that information?")
        ListItem("What is returned? What type of data?")
        Paragraph():Strong("Discuss: "):Text("As a class, walk through the questions and the code. Make sure students understand the parts of the function.")
        TeachingTip()
        Paragraph("Students need to know how the MOD operator works for the AP CSP exam. The explanations here are enough to help them answer those questions.")
        Paragraph("There are many wonderful and interesting uses of MOD in apps, but students are not expected or required to use the operator themselves when programming apps for this course.")
        EndCallout()
        Paragraph():Strong("Do This:"):Text(" Now look together at lines 64-70. Students discuss with a partner how they think the MOD operator works.")
        Paragraph():Strong("Do This:"):Text(" The MOD operator is just like any other operator - it takes two numbers, processes them, and then returns a value. Click through the animations one by one as students give answers to each arithmetic statement.")
        Paragraph():Strong("Do This:"):Text(" Give students a few minutes to practice using the MOD operator with a partner, solving the problem on the screen. Then click through to see the answer.")
        Paragraph():Strong("Remarks")
        BulletList()
        ListItem("MOD can be a little tricky, but here's what you need to remember: it's the remainder that is left after a number is divided by another number.")
        ListItem("Why is this useful? A common usage is to determine if a number is even or odd. If you divide any number by two and there is no remainder, the number is even! You can also use MOD to determine if a number is divisible by another number.")
        ListItem("Now let's get back to another app investigation with functions with parameters and return values.")
        Paragraph():Strong("Do This:"):Text(" Students navigate to "):Strong("Lesson2_App2"):Text(", read lines 37-43 and lines 160-164 and discuss with their partner what's happening in these lines.")
        Paragraph():Strong("Discuss:"):Text(" Read through the lines together as a class, and clear up any misconceptions.")
        Paragraph():Strong("Do This:"):Text(" Students carefully read the function on lines 45-69 before explaining to their partners how it works. If students have extra time, they can try the modify activity.")
        Paragraph():Strong("Discuss:"):Text(" Talk through the app together as a class. Make sure students understand all the parts of the function and understand where to look in the comments for information.")
    end

    private action WrapUp5Minutes
        Section("Wrap Up (5 minutes)")
        Paragraph():Strong("Review:"):Text(" Discuss the takeaways.")
        Subsection("Takeaways")
        BulletList()
        ListItem("Extracting shared features to generalize functionality is known as "):Strong("procedural abstraction"):Text(".")
        ListItem("Using parameters allows the functions (also called procedures) to be generalized.")
        ListItem("Using procedural abstraction helps improve code readability.")
        ListItem("Procedural abstraction manages complexity by allowing for code reuse.")
        NestedBulletList()
        ListItem("For example: the function "):Code("move(id, direction)"):Text(" could be used to move an element in any direction, rather than writing separate functions for each direction.")
        EndNestedList()
    end

    private action AssessmentCheckForUnderstanding
        Section("Assessment: Check for Understanding")
        Subsection("For Students")
        Paragraph("Open a word doc or google doc and copy/paste the following question.")
        Subsection("Question")
        Paragraph("What are the benefits of writing functions that use parameters and return? Try to list at least two.")
    end

    private action StandardsAlignment
        Section("Standards Alignment")
        BulletList()
        ListItem():Strong("CSTA K-12 Computer Science Standards (2017): "):Text("2-AP-14, 3B-AP-23")
        ListItem():Strong("CSP2021: "):Text("AAP-2.C.3, AAP-3.B.4, AAP-3.B.5, AAP-3.B.6")
    end
end
