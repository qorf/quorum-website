use Libraries.Web.Page.QuorumPage

/*
    Parameters, Return, and Libraries - Lesson 8: Project - Make a Library Part 1.
    Converted from the old Lesson page by plan 13's generator: the same
    words, now without Tailwind.
*/
class CodeOrgUnit7Lesson8 is QuorumPage

    on create
        SetLocation("lessons/code/ParametersReturnLibraries/Lesson8.html")
        // The name lists and links use, and the series and track it belongs
        // to: its section and picture.
        SetShortTitle("Project - Make a Library Part 1")
        SetSectionName("Parameters, Return, and Libraries")
        // For search engines and link previews, and what lists of pages say.
        SetDescription("The first day of a three day project where students build and test their own libraries.")
        SetSummary("Learn about parameters and return")
    end

    action Setup
        SetWebPageTitle("Project - Make a Library Part 1")
        Title("Parameters, Return, and Libraries - Lesson 8: Project - Make a Library Part 1")
        Overview()
        GettingStarted5Minutes()
        Activity40Minutes()
        WrapUp0Minutes()
        StandardsAlignment()
    end

    private action Overview
        Section("Overview")
        Paragraph("In this lesson students begin a multi-day project designing a library of functions. Students will brainstorm common problems they've encountered while programming this year and begin to design functions that address those common problems.")
        Subsection("Goals")
        Paragraph("Students will be able to:")
        BulletList()
        ListItem("Select a theme for a library of functions")
        ListItem("Design the API for a library of functions, including the function names, purpose, and parameters, and types of values each function will return")
        Subsection("Purpose")
        Paragraph("This project caps off everything students have learned about programming as they head into the Create PT. Students are "):DoubleQuote():Text("building blocks"):DoubleQuote():Text(" that classmates will have access to in order to create projects of their own. This kind of thinking requires not only a mastery of programming concepts and skills, but the ability to think more abstractly about how programs are built. Students need to identify common situations or problems that they and other programmers may encounter, and help build commands to address that problem.")
        Paragraph("This project also caps off a unit that is all about abstraction. On one level students are thinking about procedural abstraction, and simply learning how to design functions. On another level, however, they're learning to think abstractly. They're not merely designing a function, but they're thinking about the entire process of how programs are developed and common problems or situations that arise. This mental approach to thinking about why to build a function is just as important as knowing the steps to design one.")
        Subsection("Resources")
        BulletList()
        ListItem():Link("CSP-Widgets repository", "https://github.com/qorf/CSP-Widgets")
        Subsubsection("Supplemental Code.org material")
        BulletList()
        ListItem():Link("Project Guide - Make a Library", "https://docs.google.com/document/d/1EO9J47qre36SGGWm-ohnXCapV2V_8fbMYLbPZv1fI74/edit")
    end

    private action GettingStarted5Minutes
        Section("Getting Started (5 minutes)")
        Paragraph():Strong("Prompt: "):Text("Think back over all the different apps you've built this year. What blocks do you wish already came with App Lab to help you build those apps?")
        Paragraph():Strong("Discuss: "):Text("Have students brainstorm either individually or with a partner. Then have a few volunteers share their ideas with the class.")
        DiscussionGoal()
        Paragraph():Strong("Goal: "):Text("This prompt foreshadows the project students will complete in which they'll be building a library of functions. Sharing this library will allow them to actually add new blocks to App Lab for themselves or their classmates.")
        EndCallout()
        Subsection("Remarks")
        BulletList()
        ListItem("Today we're going to begin our final project before the Create PT. You'll be building a library of functions that you and others will be able to import and use.")
    end

    private action Activity40Minutes
        Section("Activity (40 minutes)")
        TeachingTip()
        Paragraph():Strong("Differentiation: "):Text("The size of library is a good way to differentiate in this project. Students who are more comfortable programmers should be encouraged to develop larger libraries of functions.")
        Paragraph():Strong("Difficulty of Suggested Functions: "):Text("The functions suggested in the project guide are loosely in difficulty order. Functions that appear near the bottom of that list are actually quite difficult and will require students to build substantially upon things they've learned in the course.")
        EndCallout()
        Paragraph():Strong("Group: "):Text("Students may complete this project individually or in pairs.")
        Paragraph():Strong("Distribute: "):Text("Give students each a copy of the "):Link("Project Guide - Make a Library - Project Guide", "https://docs.google.com/document/d/1EO9J47qre36SGGWm-ohnXCapV2V_8fbMYLbPZv1fI74/edit")
        Paragraph():Strong("Project Description - 5 mins: "):Text("As a class review the project description, what they'll submit, and the steps. Make sure students are also aware that they have access to the rubric.")
        Paragraph():Strong("Step 1 - Brainstorm - 5 Mins: "):Text("Give students 5 minutes to brainstorm a theme for their library. Many specific ideas are given to students for the types of functions they could write, but ideally students will develop functions that are focused on a specific context they find interesting.")
        Paragraph():Strong("Step 2 - Design - 10 mins: "):Text("Before students start writing the code for their project they should stend 10 minutes defining the way the different functions in their library should work. This means they'll need to write out the comments that describe the function, the different parameters, and what will be returned.")
        Paragraph():Strong("Step 3 - Build - 20 mins: "):Text("Give students the remainder of time in class to work on building out their library.")
        BulletList()
        ListItem("Students should start by working on one of their functions that includes all four features. Students will need to develop a function like this as part of the Create PT and also will be answering questions about their function in the free response questions at the end of the project.")
        ListItem("Circulate the room offering support to students. If they have successfully completed step 2 of their project guides then they should be able to write a lot of code very quickly to set up their functions and comments.")
    end

    private action WrapUp0Minutes
        Section("Wrap Up (0 minutes)")
        Subsection("Remarks")
        BulletList()
        ListItem("Great work today. Next time we meet you'll have more time to work on your libraries and then you'll need to share them with another group for feedback.")
    end

    private action StandardsAlignment
        Section("Standards Alignment")
        BulletList()
        ListItem():Strong("CSTA K-12 Computer Science Standards (2017): "):Text("2-AP-14, 3A-AP-18, 3B-AP-14, 3B-AP-16")
        ListItem():Strong("CSP2021: "):Text("CRD-2.H.1, CRD-2.H.2")
    end
end
