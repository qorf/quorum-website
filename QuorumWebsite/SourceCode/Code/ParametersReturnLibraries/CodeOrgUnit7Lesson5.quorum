use Libraries.Web.Page.QuorumPage

/*
    Parameters, Return, and Libraries - Lesson 5: Libraries Explore.
    Converted from the old Lesson page by plan 13's generator: the same
    words, now without Tailwind.
*/
class CodeOrgUnit7Lesson5 is QuorumPage
    // A double quote, for code and words that hold one.
    text dq = ""

    on create
        SetLocation("lessons/code/ParametersReturnLibraries/Lesson5.html")
        // The name lists and links use, and the series and track it belongs
        // to: its section and picture.
        SetShortTitle("Libraries Explore")
        SetSectionName("Parameters, Return, and Libraries")
        // For search engines and link previews, and what lists of pages say.
        SetDescription("Develop a mental model for how libraries work.")
        SetSummary("Learn about libraries")
    end

    action Setup
        dq = dq:GetDoubleQuote()
        SetWebPageTitle("Libraries Explore")
        Title("Parameters, Return, and Libraries - Lesson 5: Libraries Explore")
        Overview()
        GettingStarted5Minutes()
        Activity35Minutes()
        WrapUp5Minutes()
        AssessmentCheckForUnderstanding()
        StandardsAlignment()
    end

    private action Overview
        Section("Overview")
        Paragraph("Students learn the basics of libraries while building upon the envelope model of a function with a folder to represent a library.")
        Subsection("Goals")
        Paragraph("Students will be able to:")
        BulletList()
        ListItem("Use appropriate vocabulary to describe libraries")
        ListItem("Explain the process of preparing a function to be added to a library")
        ListItem("Clearly write documentation for functions in a library")
        Subsection("Purpose")
        Paragraph("The mental model of a folder containing a group of functions is used to introduce the concept of a library. Throughout this lesson student explore the requirements for working with libraries and documentation.")
        Subsection("Resources")
        BulletList()
        ListItem():Link("Code.org CSP Unit 7 Presentation Slides (Optional)", "https://docs.google.com/presentation/d/1J5SBGz5EXZH1BQu_3FoARNNLadq9osgjr-IrgPuhEsw/edit?usp=sharing")
    end

    private action GettingStarted5Minutes
        Section("Getting Started (5 minutes)")
        Subsection("Preview Libraries")
        Paragraph():Strong("Prompt: "):Text("How could you share a function with another person so they could use it in their own program?")
        DiscussionGoal()
        Paragraph():Strong("Goal: "):Text("Guide student answers towards possible answers like these -")
        BulletList()
        ListItem("email code to each other")
        ListItem("used a shared document")
        ListItem("copy/paste functions from one tab to another")
        EndCallout()
        Subsubsection("Remarks")
        BulletList()
        ListItem("Today we are going to learn a new way to share code.")
    end

    private action Activity35Minutes
        Section("Activity (35 minutes)")
        Paragraph():Strong("Guided Activity:"):Text(" Today's activity introduces students to libraries. As a visual aid, you can use "):Link("Code.org's presentation slides for Unit 7, Lesson 5: Libraries Explore", "https://docs.google.com/presentation/d/1J5SBGz5EXZH1BQu_3FoARNNLadq9osgjr-IrgPuhEsw/edit#slide=id.g41b682ba82_0_0"):Text(". These slides include animations. The notes below describe when to move to the next slide or click through an animation -- if you aren't using the slides, you can ignore these prompts.")
        Subsection("Guided Activity")
        Paragraph("Follow this lesson with the supplemental slides.")
        Paragraph():Strong("Slide: "):Text("How can we easily share functions between programs?")
        Paragraph():Strong("Say: "):Text("Have you ever wanted to share some of your code with a friend so they can use it to add a cool feature in their program? Or maybe you've got a collection of functions in one program that you want to use in another program. Today we are going to explore the answer to this question: How can we easily share functions between programs?")
        Paragraph():Strong("Slide: "):Text("Take the following functions:")
        CodeExample("makeCake tiers flavor
cakeCost tiers flavor
averageCake cakeList")
        Paragraph("And imagine them in an folder named "):Code("CakeBaker")
        Paragraph("This is a "):Strong("library"):Text(" - a collection of functions that can be used in many different programs.")
        Paragraph():Strong("Click for animation: "):Text("Stop once all three envelopes are on the screen.")
        Paragraph():Strong("Say: "):Text("These are functions. We recently learned about functions with parameters and return values.")
        Paragraph():Strong("Click for animation: "):Text("Click until the library definition appears on the screen.")
        Paragraph():Strong("Say: "):Text("The envelopes have been grouped together in a folder. This represents a library. A library is a collection of functions that can be used in many different programs.")
        Paragraph():Strong("Slide:")
        Paragraph("makeCake - creates a cake")
        BulletList()
        ListItem("tiers {number} - the layers of the cake")
        ListItem("flavor {string} - the flavor of the cake")
        Paragraph("cakeCost - calculates the cost of making a cake")
        BulletList()
        ListItem("tiers {number} - the layers of the cake")
        ListItem("flavor {string} - the flavor of the cake")
        Paragraph("avgCake - calculates the most common cake")
        BulletList()
        ListItem("tiers {number} - the layers of the cake")
        ListItem("flavor {string} - the flavor of the cake")
        Paragraph():Strong("Say: "):Text("Let's take a look at what's inside the library. If we open up the folder, we see the functions and some documentation. A library should have documentation for each of the included functions. The documentation should include:")
        BulletList()
        ListItem("how each function works")
        ListItem("a complete list of the parameters")
        ListItem("what (if anything) will be returned")
        Paragraph():Strong("Say: "):Text("This detailed type of documentation is also known as "):Strong("Application Program Interface(API)"):Text(". APIs are specifications for how the functions in a library behave and can be used.")
        Paragraph():Strong("Discuss: "):Text("With a partner, review the parts of the documentation.")
        Paragraph():Strong("Slide: "):Code("averageCake cakeList")
        Paragraph():Strong("Discuss: "):Text("What potential problems could come up if I tried to use a function without knowing what it does or how to interact with it? This would be similar to looking at the front of a function envelope and having to guess:")
        BulletList()
        ListItem("what the function does")
        ListItem("what data type the parameters need")
        ListItem("what is returned")
        Paragraph():Strong("Note: "):Text("If students are struggling to come up with ideas, give a few hints:")
        BulletList()
        ListItem("what if there's an error when you run the code which calls this function?")
        ListItem("what happens to a return if you don't store it in a variable or print it to the console?")
        Paragraph():Strong("Slide:")
        CodeExample("var smallest;

findSmallest(34, 99);

function findSamllest(num1, num2){
    if(num1 < num2){
        smallest = num1;
    } else {
        smallest = num2;
    }
}")
        Paragraph():Strong("Discuss: "):Text("My friend wants to use my "):Code("findSmallest()"):Text(" function in her program. Is this function ready to be shared in a library?")
        Paragraph():Strong("Click for animation")
        Paragraph():Strong("Say: "):Text("Watch out for global variables! If a function accesses or updates a variable elsewhere in your program, that function shouldn't be shared as is.")
        Paragraph():Strong("Click for animation")
        Paragraph():Strong("Do This: "):Text("With a partner, rewrite the function so it could be shared in a library.")
        Paragraph():Strong("Click for animation")
        Paragraph():Strong("Note: "):Text("The problem here, is that the function uses a global variable. Students should try to rewrite the function so only local variables and a return are used. The answer is shown later on in the slides.")
        Paragraph():Strong("Slide: "):Text("Before adding a function to a library:")
        NumberedList()
        ListItem("Check for any use of a global variable within the function. If there is, rework the function using local variables and a return.")
        ListItem("Check if another function is called in this function. If so, both functions should be included in the library.")
        ListItem("Write the documentation for the function.")
        Paragraph():Strong("Say: "):Text("These are the things you should consider before adding a function to a library")
        Paragraph():Strong("Slide:")
        CodeExample("function findSamllest(num1, num2){
    if(num1 < num2){
        return num1;
    } else {
        return num2;
    }
}")
        Paragraph():Strong("Say: "):Text("Here's the same function, now written to be shared in a library. How does it look compared to yours? It may look a little different - and that's ok, as long as the function works as expected. Now my function is almost ready to be shared in a library. With a partner, write the API for this function:")
        BulletList()
        ListItem("how the function works")
        ListItem("all the parameters, their data types, and a short description of each")
        ListItem("what (if anything) will be returned")
        Paragraph():Strong("Click for animation: "):Text("When the class is ready, click through to see a possible answer.")
        Paragraph("findSmallest: Given two numbers, finds the smallest")
        BulletList()
        ListItem("num1 (number) - first number")
        ListItem("num2 (number) - second number")
        ListItem("return (number) - the smaller of the two numbers")
        Paragraph():Strong("Slide: "):Text("CakeBaker")
        Paragraph():Strong("Say: "):Text("A library needs a name. For our libraries in this class, we are going to follow the following rules:")
        BulletList()
        ListItem("No spaces")
        ListItem("Capitalize the first letter")
        Paragraph():Strong("Click for animation")
        Paragraph():Strong("Slide: "):Text("CakeBaker")
        Paragraph():Strong("Say: "):Text("This library can now be shared with others. They can use the functions within their own programs as long as they follow the rules set forth in the documentation.")
        Paragraph():Strong("Click for animation")
        Paragraph():Strong("Slide: "):Code("Math.round(5, 10)")
        Paragraph():Strong("Say: "):Text("You've seen libraries in action before. The Math library is built into App Lab. Notice the name of the library first, then after a dot, the name of the function and finally the parameters. This is the same formatting you will use to call functions in libraries: Library name, followed by function name, and finally the parameter(s)")
        Paragraph():Strong("Slide: "):Text("Calculator, DisplayLists, FilterDatabase")
        Paragraph():Strong("Do This: "):Text("Brainstorm with a partner a few functions that might show up in the following libraries: Calculator, DisplayLists, FiterDatabase.")
        Paragraph():Strong("Note: "):Text("Here are some ideas:")
        BulletList()
        ListItem():Strong("Calculator:"):Text(" functions similar to what you would find in a common calculator")
        ListItem():Strong("DisplayLists:"):Text(" functions that help you display a list on a screen in different ways, such as one list item per line or divided with bullet points")
        ListItem():Strong("FilterDatabase:"):Text(" functions that allow you to filter a database for different things, like all the items that start with the letter "):DoubleQuote():Text("a"):DoubleQuote()
        Subsection("Remarks")
        BulletList()
        ListItem("Let's take a look at how libraries work in Quorum.")
        Paragraph("For more information on loading and interacting with libraries in Quorum you can use the "):Link("Use Statements tutorial", "/tutorials/language/usingLibraries.html"):Text(" to learn more about the use statement and interacting with the Quorum Standard Library. If you have been programming in Quorum you might have already seen these use statements. The standard library is essential in getting apps to work so you have been using libraries this whole time and you might not have even known it!")
        Paragraph("As you will see in the Apps associated with this unit, in Quorum, when you want to make your own library the library functions will be placed in there own file within the project. Quorum also already has a large collection of functions and classes available to you and they are collectively known as the Quorum Standard Library. The standard library is included with Quorum Studio so those files won't be directly included in the project but they are available to you using a "):Code("use"):Text(" statement. Here is an example of using the Math library from the standard library:")
        CodeExample("use Libraries.Compute.Math
class Main
     action Main
          Math math
          output math:SquareRoot(6)
     end
end")
        Paragraph("From the code sample you can see that the Math library was made available to us by the line "):Code("use Libraries.Compute.Math"):Text(". To use the functions in the Math library you need a Math variable which is why we have "):Code("Math math"):Text(". With the math variable you can now use it call the functions it has like the "):Code("SquareRoot"):Text(" function.")
    end

    private action WrapUp5Minutes
        Section("Wrap Up (5 minutes)")
        Paragraph():Strong("Journal: "):Text("Have students add the following words to their journals: Library, API")
        BulletList()
        ListItem():Emphasis("Library: "):Text("a group of functions (procedures) that may be used in creating new programs")
        ListItem():Emphasis("API: "):Text("Application Program Interface - specifications for how functions in a library behave and can be used")
        Subsection("Remarks")
        BulletList()
        ListItem("Great work today! Libraries are different than other programming concepts we've explored like variables and conditions. They offer a way to organize and share your code with others.")
    end

    private action AssessmentCheckForUnderstanding
        Section("Assessment: Check for Understanding")
        Subsection("For Students")
        Paragraph("Open a word doc or google doc and copy/paste the following question.")
        Subsection("Question")
        Paragraph("Evaluate if the following function is a good candidate to be placed in a library. Why or why not?")
        CodeExample("function updateScore(player, points) {
    if(player == " + dq + "player1" + dq + "){
        player1Points = player1Points + points;
    } else {
        player2Points = player2Points + points;
    }
}")
    end

    private action StandardsAlignment
        Section("Standards Alignment")
        BulletList()
        ListItem():Strong("CSTA K-12 Computer Science Standards (2017): "):Text("2-AP-14, 3B-AP-16")
        ListItem():Strong("CSP2021: "):Text("AAP-3.D.1, AAP-3.D.2, AAP-3.D.3, AAP-3.D.4, AAP-3.D.5")
    end
end
