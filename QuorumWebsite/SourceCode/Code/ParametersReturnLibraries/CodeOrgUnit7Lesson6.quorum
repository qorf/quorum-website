use Libraries.Web.Page.QuorumPage

/*
    Parameters, Return, and Libraries - Lesson 6: Libraries Investigate.
    Converted from the old Lesson page by plan 13's generator: the same
    words, now without Tailwind.
*/
class CodeOrgUnit7Lesson6 is QuorumPage
    // A double quote, for code and words that hold one.
    text dq = ""

    on create
        SetLocation("lessons/code/ParametersReturnLibraries/Lesson6.html")
        // The name lists and links use, and the series and track it belongs
        // to: its section and picture.
        SetShortTitle("Libraries Investigate")
        SetSectionName("Parameters, Return, and Libraries")
        // For search engines and link previews, and what lists of pages say.
        SetDescription("Investigate and modify sample apps that use libraries learn how libraries help programmers simplify and reuse their code.")
        SetSummary("Learn about libraries")
    end

    action Setup
        dq = dq:GetDoubleQuote()
        SetWebPageTitle("Libraries Investigate")
        Title("Parameters, Return, and Libraries - Lesson 6: Libraries Investigate")
        Overview()
        GettingStarted5Minutes()
        Activity35Minutes()
        WrapUp5Minutes()
        AssessmentCheckForUnderstanding()
        StandardsAlignment()
    end

    private action Overview
        Section("Overview")
        Paragraph("In this lesson students work with partners to investigate two apps that use libraries as well as the code used to make a library. Through a series of guided discussions they learn how libraries help programmers simplify and reuse their code.")
        Subsection("Goals")
        Paragraph("Students will be able to:")
        BulletList()
        ListItem("Identify the use of a library within a program")
        ListItem("Explain the purpose of libraries as a way to simplify programs, allow for code reuse, and enable collaboration.")
        ListItem("Test the functions in libraries in order to understand their behavior")
        Subsection("Purpose")
        Paragraph("Students get a chance to see how libraries are used in actual apps before they begin building libraries themselves in the subsequent project. The sample apps are written in a clean and simple manner, helping students understand the usefulness of well-documented libraries.")
        Subsection("Resources")
        BulletList()
        ListItem():Link("CSP-Widgets repository", "https://github.com/qorf/CSP-Widgets")
    end

    private action GettingStarted5Minutes
        Section("Getting Started (5 minutes)")
        Paragraph():Strong("Prompt: "):Text("Today we are going to learn how to use libraries to share code with one another. Usually you do this by writing functions with parameters and return values. Why do you think it's important to use parameters and return values when writing code for other people to use")
        Paragraph():Strong("Discuss: "):Text("Have students share responses.")
        DiscussionGoal()
        Paragraph("Some points that might come up:")
        BulletList()
        ListItem("Parameters and return values allow functions to run in predictable ways without impacting other parts of the app unexpectedly")
        ListItem("Parameters and return values help communicate what the code is supposed to do.")
        ListItem("Parameters and return values make functions more flexible so that they can be used in a variety of situations.")
        EndCallout()
    end

    private action Activity35Minutes
        Section("Activity (35 minutes)")
        Paragraph():Strong("Group: "):Text("Place students in pairs.")
        Paragraph():Strong("Do this: "):Text("Get Unit7 Lesson6_App1 from the CSP-Widget repository")
        Paragraph():Strong("Do This: "):Text("Students navigate to App 1 where they should run the app and try several different inputs.")
        Paragraph():Strong("Discuss: "):Text("With their partners, students look at the project code and discuss what happens when the button is selected. After a few minutes, pull the class back together and discuss as a whole.")
        DiscussionGoal()
        Paragraph("When the button is clicked, the screen is updated by calling several functions from a library which return text and images that is displayed.")
        EndCallout()
        Paragraph():Strong("Do This: "):Text("Now students should open the library file and look specifically at each StateLibrary function. They should read the documentation for each function before discussing with a partner how these functions work.")
        Paragraph():Strong("Do This: "):Text("Students read the library code and discuss how the functions actually work. They should consider if they were accurate in their predictions before looking at the library code.")
        Paragraph():Strong("Discuss: "):Text("What are the benefits of hiding all of the code for filtering the dataset in a library? What information does the user need to know in order to use the library functions?")
        DiscussionGoal()
        Paragraph():Strong("Benefits: "):Text("The project code is neat and organized.")
        Paragraph():Strong("Information: "):Text("The end user does not have to know all the inner workings of the functions - they just need to know the documentation for the functions so they can call them correctly and understand what will be returned (if anything).")
        EndCallout()
        Paragraph():Strong("Do this: "):Text("Get Unit7 Lesson6_App2 from the CSP-Widget repository")
        Paragraph():Strong("Do This: "):Text("Students navigate to App 2 where they run the Pigify app and try several inputs.")
        Paragraph():Strong("Do This: "):Text("Again, students look at the documentation for each function, and discuss how they work.")
        Paragraph():Strong("Test the Functions: "):Text("Now students practice testing the functions to understand how they work. Here are the steps:")
        BulletList()
        ListItem("Re-read the documentation for each library function")
        ListItem("Add a output statement to the end of the program and call a function. Put in a reasonable argument in the space for the parameter.")
        NestedBulletList()
        ListItem("For example: "):Code("output stringsLibrary.FirstLetter(" + dq + "pizza" + dq + ")")
        EndNestedList()
        ListItem("Hit run to see the output.")
        ListItem("Now add "):Code("output"):Text(" statements to test the rest of the functions. Is the output what you would expect? Try several different inputs.")
        Paragraph():Strong("Prompt: "):Text("Why should we test the functions in the library? What does this help us to know?")
        DiscussionGoal()
        Paragraph():Strong("Goal: "):Text("Testing the functions allows the end user to understand the behavior of the function. It's helpful for debugging functions, in addition to looking at the code in the library.")
        Paragraph("For example: If I call a function whose documentation indicates that it will return the first letter of a string, and instead it returns the last number of a string, I know that there is a problem with the library function and not my project code.")
        EndCallout()
        Paragraph():Strong("Do This: "):Text("Now students navigate back to the States App and use "):Code("output"):Text(" to test all of the library functions there.")
        Paragraph():Strong("Prompt: "):Text("What makes a good library function? How can you make sure that the end users of your library have what they need in order to use your functions?")
        DiscussionGoal()
        Paragraph():Strong("Goal: "):Text("Hopefully through the process of testing, students will understand the importance of well-documented functions that do what they are expected to do!")
        Paragraph("A good library function contains everything it needs within the function. Beware of global variables or references to element IDs that might not be present in the end user's projects")
        EndCallout()
        Paragraph():Strong("Review: "):Text("Up to this point, students have either created their own algorithms from scratch, or modified existing ones (usually in Investigate Lessons). Now they have another tool to use: combining existing algorithms to make new algorithms. Here, this is accomplished with a library.")
        Paragraph():Strong("Prompt: "):Text("What are the benefits of using existing algorithms instead of brand new algorithms?")
        DiscussionGoal()
        Paragraph():Strong("Goal: "):Text("The benefits of using existing algorithms as building blocks for constructing other algorithms include:")
        Paragraph("We demonstrated the last two bullets in the exercise using output to test functions and isolate errors.")
        EndCallout()
        Paragraph("Examples of existing algorithms you may have seen:")
        BulletList()
        ListItem("the maximum or minimum of 2 or more numbers")
        ListItem("the sum or average of 2 or more numbers")
        ListItem("an algorithm that determines if an integer can be evenly divided by another integer")
        ListItem("a robot's path through a maze")
        Subsection("Remarks")
        BulletList()
        ListItem("Now let's review Procedural Abstraction. In Lesson 2, we learned about Procedural Abstraction, where shared features of functions (also known as procedures) are extracted in order to generalize use. Procedural Abstraction encourages code reuse and manages complexity, because generalized functions can be used to accomplish many different tasks.")
        ListItem("Now let's extend that definition. Procedural Abstraction provides a name for a process and allows the procedure to be used only knowing what it does, and not necessarily how it does it.")
        ListItem("This is how our libraries work!")
        ListItem("There's a term for using libraries or other forms of organization in a program: Modularity - the subdivision of a computer program into separate subprograms. This is what we are doing when we organize functions into a library and then call them in another program.")
        ListItem("The end user of the library only needs to know how the functions work, which they can learn through the documentation. This means that the creator of the library can update the functions for any number of reasons, such as making the functions more efficient, without having to notify the end users, as long as the function documentation does not need to be changed. The end users can expect the library to work as intended.")
        Paragraph():Strong("Do This: "):Text("Review the takeaways. These are focused on the practicalities of creating and using libraries.")
    end

    private action WrapUp5Minutes
        Section("Wrap Up (5 minutes)")
        Subsection("Synthesis")
        Paragraph():Strong("Prompt: "):Text("Based on what you saw today, add reasons why someone would argue for the following three statements")
        BulletList()
        ListItem("Libraries help programmers collaborate")
        ListItem("Libraries help programmers reuse code")
        ListItem("Libraries help programmers writer simpler programs")
        Paragraph():Strong("Discuss: "):Text("Have students discuss together before sharing with a class.")
        DiscussionGoal()
        Paragraph("As you discuss focus conversation on the following points.")
        BulletList()
        ListItem("Libraries help programmer collaborate because they can design code with the idea that other people will use them.")
        ListItem("Libraries help programmers reuse code because they can be imported into many different programs")
        ListItem("Libraries help programmers write simpler programs because library code can be used to handle many common (and sometimes complex) behavior and remove it from your core program.")
        EndCallout()
        Subsection("Journal")
        Paragraph("Students add to their journal the following word and definition: modularity. They may also want to update their definition for procedural abstraction based on earlier conversations and slides.")
        BulletList()
        ListItem():Emphasis("Modularity: "):Text("the subdivision of a computer program into separate subprograms.")
    end

    private action AssessmentCheckForUnderstanding
        Section("Assessment: Check for Understanding")
        Subsection("For Students")
        Paragraph("Open a word doc or google doc and copy/paste the following question.")
        Subsection("Question")
        Paragraph("Why is it important to use meaningful names for the functions in your library?")
    end

    private action StandardsAlignment
        Section("Standards Alignment")
        BulletList()
        ListItem():Strong("CSTA K-12 Computer Science Standards (2017): "):Text("2-AP-14, 2-AP-17, 3A-AP-18, 3B-AP-16, 3B-AP-23")
        ListItem():Strong("CSP2021: "):Text("AAP-2.M.1, AAP-2.M.2, AAP-2.M.3, AAP-3.B.1, AAP-3.B.2, AAP-3.B.3, AAP-3.B.4, AAP-3.B.5, AAP-3.B.6, AAP-3.B.7, AAP-3.D.2, AAP-3.D.3")
    end
end
