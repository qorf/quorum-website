use Libraries.Web.Page.QuorumPage

/*
    Parameters, Return, and Libraries - Lesson 1: Parameters and Return Explore.
    Converted from the old Lesson page by plan 13's generator: the same
    words, now without Tailwind.
*/
class CodeOrgUnit7Lesson1 is QuorumPage
    // A double quote, for code and words that hold one.
    text dq = ""

    on create
        SetLocation("lessons/code/ParametersReturnLibraries/Lesson1.html")
        // The name lists and links use, and the series and track it belongs
        // to: its section and picture.
        SetShortTitle("Parameters and Return Explore")
        SetSectionName("Parameters, Return, and Libraries")
        SetCardImage("/media/userInterface/quorumAssets/cspImages/csp7.svg")
        SetCardDescription("This unit introduces parameters, return, and libraries. Learn how to use these concepts to build new kinds of apps as well as libraries of code.")
        // For search engines and link previews, and what lists of pages say.
        SetDescription("Develop a mental model for how functions can be generalized using parameters and return values.")
        SetSummary("Learn about parameters and return")
    end

    action Setup
        dq = dq:GetDoubleQuote()
        SetWebPageTitle("Parameters and Return Explore")
        Title("Parameters, Return, and Libraries - Lesson 1: Parameters and Return Explore")
        Overview()
        GettingStarted5Minutes()
        Activity30Minutes()
        WrapUp10Minutes()
        AssessmentCheckForUnderstanding()
        StandardsAlignment()
    end

    private action Overview
        Section("Overview")
        Paragraph("Students work with envelopes and paper to model functions with parameters and return values. Students create their own physical function envelope for drawing a house that takes in different parameters, and then build another function to calculate and return the cost of building that house.")
        Subsection("Goals")
        Paragraph("Students will be able to:")
        BulletList()
        ListItem("Use appropriate vocabulary to describe parameters and return values.")
        ListItem("Remove specifics from a function so that it can be used in a variety of situations")
        Subsection("Purpose")
        Paragraph("In this Explore lesson, students follow a presentation and use manipulatives to understand the basics of creating a function with parameters and return values.")
        Subsection("Resources")
        Subsubsection("Supplemental Code.org material")
        Paragraph("For the students")
        BulletList()
        ListItem():Link("Code.org CSP Unit 7 Presentation Slides (Optional)", "https://docs.google.com/presentation/d/1J5SBGz5EXZH1BQu_3FoARNNLadq9osgjr-IrgPuhEsw/edit?usp=sharing")
        ListItem():Link("Activity Guide - Function Houses", "https://docs.google.com/document/d/1SdMlqfeAFtIVh3BKjRDQguOL5d4jC2nsvtdNAi0x-ts/view")
        Subsection("Preparation")
        Paragraph("If you want to use physical manipulatives for this lesson, you'll need to prepare the following:")
        BulletList()
        ListItem("Collect various sizes of sticky notes. Small sticky notes are particularly useful for this activity.")
        ListItem("Two envelopes per group")
        ListItem("Pencils/pens")
        ListItem("One baggy for a teacher demonstration (optional)")
        ListItem("Print out copies of the Activity Guide for students")
        ListItem("If you are using the slides, review Unit 7 Lesson 1 slides")
    end

    private action GettingStarted5Minutes
        Section("Getting Started (5 minutes)")
        Subsection("Preview Parameterized Functions")
        BulletList()
        ListItem("Up to this point, we've learned the basics of programming: variables, conditionals, functions, lists, loops, and traversals. As you grow in your programming skills, you'll start to notice ways that you can organize your code so that it is easier to work with. That's what this unit is all about!")
        Paragraph():Strong("Prompt: "):Text("Why would you want to make your code easier to work with or read?")
        DiscussionGoal()
        Paragraph():Strong("Goal: "):Text("This is a good time to remind students that when we write code, we aren't just writing for a computer - we are also writing for humans who will need to understand our code. Better organization can help others quickly understand our code so they can help debug or build upon the code.")
        EndCallout()
    end

    private action Activity30Minutes
        Section("Activity (30 minutes)")
        Subsection("Functions with Parameters and Return")
        Paragraph():Strong("Guided Activity:"):Text(" Today's activity introduces students to functions with paramerters and return. As a visual aid, you can use "):Link("Code.org's presentation slides for Unit 7, Lesson 1: Parameters and Return Explore", "https://docs.google.com/presentation/d/1ZQLXktxB2DkyqqmCRjKnVRQKHrAv42_5rkjlEjH8af0/copy"):Text(". These slides include animations. The notes below describe when to move to the next slide or click through an animation -- if you aren't using the slides, you can ignore these prompts.")
        Subsection("Guided Activity")
        Paragraph("Follow this lesson with the supplemental slides.")
        Paragraph():Strong("Slide: "):Text("You and your partner should have")
        BulletList()
        ListItem("Small sticky notes")
        ListItem("Regular sized sticky notes")
        ListItem("Pen/Pencil")
        ListItem("Envelopes")
        Paragraph():Strong("Distribute: "):Text("large and small sticky notes and envelopes. Hold off on distributing the Activity Guide until later in the activity.")
        Paragraph():Strong("Slide: "):Code("makeCake tiers flavor")
        Paragraph():Strong("Say: "):Text("Let's pretend that I want to make a cake. I need to decide how many tiers the cake will have, and what flavor the cake will be. I've decided to make a 3 tiered cake.")
        Paragraph():Strong("Click for animation")
        Paragraph():Code("makeCake 3 " + dq + "lemon" + dq)
        Paragraph():Strong("Slide:")
        Paragraph():Strong("Say: "):Text("If I flip over the envelope, and open it up there's a recipe inside. This recipe is going to tell me how to make the cake I've specified.")
        Paragraph():Strong("Slide:")
        CodeExample("makeCake 3 " + dq + "lemon" + dq + "
repeat tiers times:
    Bake a flavor cake
    Ice the cake.
Assemble tiers layers into one cake.
Put in box.")
        Paragraph():Strong("Say: "):Text("To do this, I'm going to replace "):Code("tiers"):Text(" with "):Code("3"):Text(" and "):Code("flavor"):Text(" with "):Code("lemon"):Text(", every time those words show up in the recipe. But notice - this recipe is pretty general. I could use it to make lots of different types and sizes of cake.")
        Paragraph():Strong("Click for animation")
        CodeExample("makeCake 3 " + dq + "lemon" + dq + "
repeat 3 times:
    Bake a " + dq + "lemon" + dq + " cake
    Ice the cake.
Assemble 3 layers into one cake.
Put in box.")
        Paragraph():Strong("Do This: "):Text("Read through the recipe as a class. Make sure everyone understands how it works before moving on.")
        Paragraph():Strong("Slide:")
        CodeExample("//instructions for baking a cake
makeCake 3 " + dq + "lemon" + dq + "
repeat 3 times:
    Bake a " + dq + "lemon" + dq + " cake
    Ice the cake.
Assemble 3 layers into one cake.
Put in box.")
        Paragraph():Strong("Say: "):Text("Ok, let's make our cake. Remember, each time I come across tiers or flavor, I'm going to replace that word with the appropriate value. Once I'm done, I will have baked a 3 layer lemon cake!")
        Paragraph():Strong("Click for animation: "):Text("There are several steps to click through here. Take it slow so students can see each part.")
        Paragraph():Strong("Slide: "):Code("makeCake 3 " + dq + "lemon" + dq)
        Paragraph():Strong("Say: "):Text("This is a function! It should look familiar, but it has a few extra parts. This function has parameters. Parameters are used as placeholders for values that will be passed through the function.")
        Paragraph():Strong("Click for animation")
        Paragraph():Strong("Say: "):Text("Those values passed to the parameter are called arguments.")
        Paragraph():Strong("Click for animation")
        Paragraph():Strong("Slide: "):Code("makeCake tiers flavor")
        Paragraph():Strong("Say: "):Text("Let's think through how changing the arguments affects the output. Now I want a four layer chocolate cake. With a partner, discuss what my arguments will look like.")
        Paragraph():Strong("Click for animation")
        Paragraph():Strong("Say: "):Text("I pass through the arguments "):Code("4"):Text(" and "):Code("chocolate"):Text(" to the parameters "):Code("tiers"):Text(" and "):Code("flavor"):Text(". Then my function is ready. What will my cake look like?")
        Paragraph():Strong("Click for animation")
        Paragraph():Code("makeCake 4 " + dq + "chocolate" + dq)
        Paragraph():Strong("Do This: "):Text("Distribute Activity Guides and direct students to Challenge #1. Students will create their own function envelopes and write a simple function that uses parameters which can be used to draw a house. When students are finished building their function envelopes, a partner tests out the code and draws the house on a spare sticky note.")
        Paragraph():Strong("Slide: "):Text("Let's look at another function, this time one that calculates the cost of making a cake.")
        Paragraph():Code("costCake tiers flavor")
        Paragraph():Strong("Say: "):Text("Here's another function. This function is used to calculate the total cost of making a cake. Take note again of the arguments and parameters.")
        Paragraph():Strong("Click for animation")
        Paragraph():Strong("Say: "):Text("Let's open the envelope and check out how this function works.")
        Paragraph():Strong("Slide:")
        CodeExample("//Cost for making a cake
var flavorCost
var toal
If flavor equals " + dq + "chocolate" + dq + ":
    flavorCost = 5
If flavor equals " + dq + "lemon" + dq + ":
    flavorCost = 4
If flavor equals " + dq + "vanilla" + dq + ":
    flavorCost = 3
total = flavorCost multiplied by tiers
return total")
        Paragraph():Strong("Say: "):Text("There are a few new things here. First, we've created two local variables. Remember, the local variables are contained within the function and can't be updated or accessed outside of the function. We learned about this when we discussed variable scope.")
        Paragraph():Strong("Click for animation")
        Paragraph("From Slide: Create two new local variables, "):Strong("flavorCost"):Text(" and "):Strong("total.")
        Paragraph("In this function, a decision (in this case, how much to charge per flavor) is made based on the argument passed through the parameter.")
        Paragraph():Strong("Click for animation")
        Paragraph("From Slide: Determine the value of "):Strong("flavorCost"):Text(" based on the argument passed through the flavor paramter.")
        Paragraph("Finally, the total is returned, but returned where? What does that mean?")
        Paragraph():Strong("Click for animation")
        Paragraph("From Slide: Calculate "):Strong("total"):Text(" using "):Strong("flavorCost"):Text(" and the argument passed through the tiers paramter.")
        Paragraph():Strong("Slide: "):Text("After running this what does flavorCost equal? What does total equal?")
        Paragraph():Strong("Say: "):Text("Before we talk more about that return, let's calculate the total cost of our original cake.")
        Paragraph():Strong("Do This: "):Text("With a partner, determine what "):Code("flavorCost"):Text(" and "):Code("total"):Text(" equal after the function is run.")
        Paragraph():Strong("Slide: "):Text("What does it mean to "):Strong("return total?")
        Paragraph("A return does two things:")
        BulletList()
        ListItem("It stops the flow of the function. If a return is inside of a conditional, if that condition is met the function ends there.")
        ListItem("It "):Strong("returns"):Text(" a value to the place where the function was called.")
        Paragraph():Strong("Say: "):Text("Now let's think about the return. If the program hits a return at any point in running a function, it will stop and a value will be "):DoubleQuote():Text("returned"):DoubleQuote():Text(". Where is it returned? To the place in the program where the function was called.")
        Paragraph():Strong("Slide: "):Text("We've called the cakeCost function. It has returned the value "):Strong("12"):Text(".")
        Paragraph("But what happens to that value?")
        Paragraph("How is it stored?")
        Paragraph():Strong("Say: "):Text("So to get back to our example, the value 12 is returned, but where is it returned to? Where is it stored?")
        Paragraph():Strong("Do This: "):Text("Take a moment to brainstorm with a partner.")
        Paragraph():Strong("Slide: "):Text("Let's return to variable baggies!")
        Paragraph("A function "):Strong("return"):Text(" value can be stored in a variable.")
        Paragraph():Strong("Say: "):Text("Let's return to variable baggies! A function return value can be stored in a variable. Notice how the envelope is placed inside of a baggie. That means that the function would be evaluated and whatever is returned would be stored in the variable "):Code("cakeCalculator")
        Paragraph():Strong("Click for animation")
        Paragraph():Strong("Slide: "):Code("var cakeCalculator = cakeCost(3, " + dq + "lemon" + dq + ");")
        Paragraph("After the expression is evaluated, "):Strong("cakeCalculator"):Text(" stores the value "):Strong("12"):Text(".")
        Paragraph():Strong("Say: "):Text("Here's how this looks in JavaScript. It's ok if it's a little confusing. For now, notice how the statement is set up. A variable is set up with the name "):Code("cakeCalculator"):Text(". This gets the value that is returned from the function "):Code("cakeCost"):Text(" which has two arguments "):Code("3"):Text(" and "):Code("lemon"):Text(" passed through the parameters. After the function is evaluated, "):Code("cakeCalculator"):Text(" now stores the value 12.")
        Paragraph():Strong("Say: "):Text("In Quorum, the code looks similar. The biggest difference is that the variable must be of the correct type. Return types will be covered later.")
        Paragraph():Code("integer cakeCalculator = CakeCost(3, " + dq + "lemon" + dq + ")")
        Paragraph():Strong("Slide: "):Code("console.log(" + dq + "Cake cost: " + dq + " + cakeCost(3, " + dq + "lemon" + dq + "));")
        Paragraph():Strong("Say: "):Text("We can also print to the console like so.")
        Paragraph():Strong("Say: "):Text("In Quorum you can use output")
        Paragraph():Code("output " + dq + "Cake cost: " + dq + " + CakeCost(3, " + dq + "lemon" + dq + ")")
        Paragraph():Strong("Slide: "):Text("Create a cost calculator function for building the house you created a function for earlier.")
        Paragraph():Strong("Do This: "):Text("Direct students to complete Challenge #2 in their Activity Guides. Students create a new envelope function which calculates the cost of the house from Challenge #1. After students are finished, they share the envelopes with a partner who tests the code.")
        BulletList()
        ListItem("Functions with parameters and return values help us simplify our code")
        ListItem("Functions can only return one value at a time")
        ListItem("A function can have:")
        NestedBulletList()
        ListItem("No parameters and no return values")
        ListItem("Parameters, but no return values")
        ListItem("Return values, but no parameters")
        ListItem("Parameters and return values")
        EndNestedList()
    end

    private action WrapUp10Minutes
        Section("Wrap Up (10 minutes)")
        Paragraph():Strong("Takeaways: "):Text("Review with the class")
        Subsection("Journal")
        Paragraph("Students should add the following words and definitions to their journals: parameter, argument, return.")
        BulletList()
        ListItem():Emphasis("Parameter: "):Text("a variable in a function definition. Used as a placeholder for values that will be passed through the function.")
        ListItem():Emphasis("Argument: "):Text("the value passed to the parameter")
        ListItem():Emphasis("Return: "):Text("used to return the flow of control to the point where the procedure (also known as a function) was called and to return the value of expression.")
    end

    private action AssessmentCheckForUnderstanding
        Section("Assessment: Check for Understanding")
        Subsection("For Students")
        Paragraph("Open a word doc or google doc and copy/paste the following question.")
        Subsection("Question")
        Paragraph("Read through the code and choose the correct answer.")
        CodeExample("output Numbers(3,2)

action Numbers(number num1, number num2) returns number
    number answer
    answer = num1 + num2
    answer = answer + num1
    return answer * num2
end")
        BulletList()
        ListItem("15")
        ListItem("16")
        ListItem("21")
        ListItem("18")
    end

    private action StandardsAlignment
        Section("Standards Alignment")
        BulletList()
        ListItem():Strong("CSTA K-12 Computer Science Standards (2017): "):Text("2-AP-14")
        ListItem():Strong("CSP2021: "):Text("AAP-3.A.1, AAP-3.A.3, AAP-3.B.4, AAP-3.B.5, AAP-3.B.6")
    end
end
