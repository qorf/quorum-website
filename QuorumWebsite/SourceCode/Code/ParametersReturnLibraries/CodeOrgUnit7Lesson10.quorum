use Libraries.Web.Page.QuorumPage

/*
    Parameters, Return, and Libraries - Lesson 10: Project - Make a Library Part 3.
    Converted from the old Lesson page by plan 13's generator: the same
    words, now without Tailwind.
*/
class CodeOrgUnit7Lesson10 is QuorumPage

    on create
        SetLocation("lessons/code/ParametersReturnLibraries/Lesson10.html")
        // The name lists and links use, and the series and track it belongs
        // to: its section and picture.
        SetShortTitle("Project - Make a Library Part 3")
        SetSectionName("Parameters, Return, and Libraries")
        // For search engines and link previews, and what lists of pages say.
        SetDescription("The third day of a three day project where students build and test their own libraries.")
        SetSummary("Learn about parameters and return")
    end

    action Setup
        SetWebPageTitle("Project - Make a Library Part 3")
        Title("Parameters, Return, and Libraries - Lesson 10: Project - Make a Library Part 3")
        Overview()
        GettingStarted2Minutes()
        Activity40Minutes()
        WrapUp3Minutes()
        AssessmentGradingTheProject()
        StandardsAlignment()
    end

    private action Overview
        Section("Overview")
        Paragraph("Students complete their library project, finalizing their code and writing written responses explaining the way one of the functions in their library works.")
        Subsection("Goals")
        Paragraph("Students will be able to:")
        BulletList()
        ListItem("Debug a library of functions based on testing and classmate feedback")
        ListItem("Explain the purpose and functionality of a function they developed")
        ListItem("Explain two different calls to a function they developed")
        Subsection("Purpose")
        Paragraph("This lesson wraps up this quick project but also gives students a chance to practice responding to questions that appear in the Create PT. This lesson and project should therefore serve as a cap on students' study of procedural abstraction and if you are teaching this class as an AP, prepare them for the Create Task that they will complete in the following unit.")
        Subsection("Resources")
        BulletList()
        ListItem():Link("CSP-Widgets repository", "https://github.com/qorf/CSP-Widgets")
        Subsubsection("Supplemental Code.org material")
        BulletList()
        ListItem():Link("Project Guide - Make a Library", "https://docs.google.com/document/d/1EO9J47qre36SGGWm-ohnXCapV2V_8fbMYLbPZv1fI74/edit")
    end

    private action GettingStarted2Minutes
        Section("Getting Started (2 minutes)")
        Subsection("Remarks")
        BulletList()
        ListItem("Today is your final day to work on your library. Based on the feedback you received from your classmates and the tests that you wrote, you should know where you need to improve your functions. Today you'll also need to finish a set of written response questions about one of your functions expxlaining how it works and describing two different calls to that function with different arguments.")
        ListItem("Let's get to it!")
    end

    private action Activity40Minutes
        Section("Activity (40 minutes)")
        TeachingTip()
        Paragraph():Strong("Scheduling Time: "):Text("Depending on where students are in the process of developing their libraries they may need to program a little more prior to starting their free response answers. Remind students that in order to finish their responses they only need to have written a single function that has a parameter, return value, loop, and conditional. As soon as students have completed a function like that they should move to free response answers. They can subsequently come back to finish developing the rest of their libraries.")
        EndCallout()
        Paragraph():Strong("Step 7 - Acknowledge Collaborators / Sources - 2 mins: "):Text("If students worked in pairs or imported some code from elsewhere they should acknowledge the sources of that code.")
        Paragraph():Strong("Step 8 - Free Response - 20 mins: "):Text("With students quickly review the questions students need to answer about one of the functions in their library. These questions are taken nearly exactly from the Create PT and should help students prepare to independently answer these questions when they complete that task.")
        Paragraph():Strong("Work Time - 18 mins: "):Text("Students should work on their free response answers early in the lesson. Once they've finished working on their responses they can go back to their project to make any final edits to their project code. Encourage students to review the Scoring Guidelines to make sure they're not missing anything in their projects.")
    end

    private action WrapUp3Minutes
        Section("Wrap Up (3 minutes)")
        Paragraph():Strong("Submit Projects: "):Text("At the end of the lesson students should submit their projects and submit their completed project guides, including free response questions.")
    end

    private action AssessmentGradingTheProject
        Section("Assessment: Grading the Project")
        Paragraph():Strong("Rubric: "):Text("Evaluate the projects using the provided rubric in the Project Guide")
    end

    private action StandardsAlignment
        Section("Standards Alignment")
        BulletList()
        ListItem():Strong("CSTA K-12 Computer Science Standards (2017): "):Text("2-AP-14, 3A-AP-18, 3B-AP-14, 3B-AP-16")
        ListItem():Strong("CSP2021: "):Text("CRD-2.H.1, CRD-2.H.2")
    end
end
