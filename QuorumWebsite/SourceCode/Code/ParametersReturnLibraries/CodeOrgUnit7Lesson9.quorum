use Libraries.Web.Page.QuorumPage

/*
    Parameters, Return, and Libraries - Lesson 9: Project - Make a Library Part 2.
    Converted from the old Lesson page by plan 13's generator: the same
    words, now without Tailwind.
*/
class CodeOrgUnit7Lesson9 is QuorumPage

    on create
        SetLocation("lessons/code/ParametersReturnLibraries/Lesson9.html")
        // The name lists and links use, and the series and track it belongs
        // to: its section and picture.
        SetShortTitle("Project - Make a Library Part 2")
        SetSectionName("Parameters, Return, and Libraries")
        // For search engines and link previews, and what lists of pages say.
        SetDescription("The second day of a three day project where students build and test their own libraries.")
        SetSummary("Learn about parameters and return")
    end

    action Setup
        SetWebPageTitle("Project - Make a Library Part 2")
        Title("Parameters, Return, and Libraries - Lesson 9: Project - Make a Library Part 2")
        Overview()
        GettingStarted2Minutes()
        Activity40Minutes()
        WrapUp3Minutes()
        StandardsAlignment()
    end

    private action Overview
        Section("Overview")
        Paragraph("Students continue to develop their library of functions. Students are encouraged to begin developing tests for their functions to make sure they return values as expected. Late in the lesson students exchange their library with a classmate for feedback.")
        Subsection("Goals")
        Paragraph("Students will be able to:")
        BulletList()
        ListItem("Write tests for functions with a library that they designed")
        ListItem("Provide feedback to their classmate about a library they designed")
        Subsection("Purpose")
        Paragraph("In this lesson students continue to write the code for their libraries, but a big focus is on making sure it works as expected. Through writing tests of their own students practice thinking through how different inputs into a function lead to expected outputs. Sharing their libraries with classmates helps check not only that their code works as expected, but that their library is clear, approachable, and useful, to someone else.")
        Subsection("Resources")
        BulletList()
        ListItem():Link("CSP-Widgets repository", "https://github.com/qorf/CSP-Widgets")
        Subsubsection("Supplemental Code.org material")
        BulletList()
        ListItem():Link("Project Guide - Make a Library", "https://docs.google.com/document/d/1EO9J47qre36SGGWm-ohnXCapV2V_8fbMYLbPZv1fI74/edit")
    end

    private action GettingStarted2Minutes
        Section("Getting Started (2 minutes)")
        Subsection("Remarks")
        BulletList()
        ListItem("Today you are going to have more time to work on your library, but you're going to focus on testing it in two very different ways. In the first half of the lesson you'll still have work time to write your library, but you should develop tests like we practiced in this unit to make sure they're working as you expect.")
        ListItem("In the second half of the lesson you'll share your library with a classmate who will try using it themselves and will give feedback. Next time we meety you'll be able to use this feedback and testing to make the final edits to your library.")
        ListItem("Let's get to it!")
    end

    private action Activity40Minutes
        Section("Activity (40 minutes)")
        Paragraph():Strong("Step 4 - Test - 20 mins: "):Text("In this section students briefly review how to write tests for functions and then actually go write them.")
        TeachingTip()
        Paragraph():Strong("Writing Tests: "):Text("Remind students of these important strategies while testing their program code.")
        BulletList()
        ListItem("They should actually call their functions with different inputs")
        ListItem("They should try out values that try out different ways their functions work, or right below, at, and after the cut offs of the conditional statements within their functions")
        Paragraph():Strong("Supporting the Feedback Process: "):Text("There are a few logistical steps involved in getting students to provide feedback to one another. They'll need to exchange project guides, navigate to a different level from the one they're working in, and import a classmate's library. Once this is done make sure you encourage good processes in testing one another's libraries by asking questions")
        BulletList()
        ListItem("Can you tell what the library is supposed to do?")
        ListItem("Do all the functions work as they're supposed to? How do you know?")
        ListItem("What are ways the library could be improved?")
        EndCallout()
        BulletList()
        ListItem():Strong("Tests Refresher:"):Text(" Briefly review with students how to use "):Code("output"):Text(" to write tests for their functions.")
        ListItem():Strong("Test:"):Text(" Give students time to write tests for their functions and then continue to program to fix any errors they encounter.")
        Paragraph():Strong("Group: "):Text("Have students find a classmate with whom to share their library and give feedback. Students should trade project guides with their classmate.")
        Paragraph():Strong("Step 5 - Feedback - 20 mins: "):Text("Students will need to go through a series of steps to share their libraries and given feedback")
        BulletList()
        ListItem():Strong("Export Your Library:"):Text(" Walk students through the steps necessary to export their own library")
        ListItem():Strong("Import a Library:"):Text(" Walk students through the steps necessary to import a library from their classmate.")
        ListItem():Strong("Give Feedback:"):Text(" Walk students through ways that they can use a classmate's library to test it out. Make sure they give feedback on their classmate's project guide under Step 5.")
        Paragraph():Strong("Step 6 - Improve: "):Text("Students should return project guides to their classmates and review the feedback. Next class they'll have time to improve their libraries and prepare to submit them.")
    end

    private action WrapUp3Minutes
        Section("Wrap Up (3 minutes)")
        Subsection("Remarks")
        BulletList()
        ListItem("Great work today. At this point you should have a good sense of how your library is working and what edits you'll need to make. Tomorrow you'll finish your library and answer some questions about them.")
    end

    private action StandardsAlignment
        Section("Standards Alignment")
        BulletList()
        ListItem():Strong("CSTA K-12 Computer Science Standards (2017): "):Text("2-AP-14, 3A-AP-18, 3B-AP-14, 3B-AP-16")
    end
end
