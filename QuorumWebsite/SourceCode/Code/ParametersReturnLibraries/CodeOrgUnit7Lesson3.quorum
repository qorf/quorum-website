use Libraries.Web.Page.QuorumPage

/*
    Parameters, Return, and Libraries - Lesson 3: Parameters and Return Practice.
    Converted from the old Lesson page by plan 13's generator: the same
    words, now without Tailwind.
*/
class CodeOrgUnit7Lesson3 is QuorumPage

    on create
        SetLocation("lessons/code/ParametersReturnLibraries/Lesson3.html")
        // The name lists and links use, and the series and track it belongs
        // to: its section and picture.
        SetShortTitle("Parameters and Return Practice")
        SetSectionName("Parameters, Return, and Libraries")
        // For search engines and link previews, and what lists of pages say.
        SetDescription("Practice programming with parameters and return values through a set of programming puzzles.")
        SetSummary("Learn about parameters and return")
    end

    action Setup
        SetWebPageTitle("Parameters and Return Practice")
        Title("Parameters, Return, and Libraries - Lesson 3: Parameters and Return Practice")
        Overview()
        GettingStarted5Minutes()
        Activity35Minutes()
        WrapUp5Minutes()
        AssessmentCheckForUnderstanding()
        StandardsAlignment()
    end

    private action Overview
        Section("Overview")
        Paragraph("Students practice writing programs with parameters and return values by creating and debugging functions that use them.")
        Subsection("Goals")
        Paragraph("Students will be able to:")
        BulletList()
        ListItem("Correctly set up a parameter in a function")
        ListItem("Correctly set up a return value in a function")
        ListItem("Write comments to explain the function purpose, parameters, and return values")
        Subsection("Purpose")
        Paragraph("This is students' opportunity to practice using parameters and return values in a variety of contexts. The progression of levels builds in complexity from students merely calling functions with parameters to designing functions and debugging complex programs that use parameters and return values. This lesson should build students familiarity with these concepts as they prepare for the Make project in the next lesson.")
        Subsection("Resources")
        BulletList()
        ListItem():Link("CSP-Widgets repository", "https://github.com/qorf/CSP-Widgets")
    end

    private action GettingStarted5Minutes
        Section("Getting Started (5 minutes)")
        Subsection("Quick Warm Up")
        Paragraph():Strong("Prompt: "):Text("What is one reason why parameters and return values are useful? What is one way you think programming with parameters and return values may make programming or debugging more challenging?")
        Paragraph():Strong("Discuss: "):Text("Have students share responses with a neighbor before discussing with the whole class.")
        DiscussionGoal()
        Paragraph():Strong("Goal: "):Text("Use this quick prompt to review what students should already have seen about parameters and return values while also prompting them to think about how they'll need to use those skills in today's lessons. You should use your remarks to review the fact that parameters and return help write neater programs, but they may be a little tricky at first to read and understand. That's why we practice!")
        Paragraph("Up to this point, students have only seen complete traversals - that is, traversals where every element of a list is accessed. Now that they've been introduced to return, students can build partial traversals where a list is only partially accessed. For example: A list could be traversed to find a specific element. Once that element is found, "):DoubleQuote():Text("found element x"):DoubleQuote():Text(" is returned, and the traversal stops. While students don't actually need to build partial traversals themselves, they now should know how it theoretically could be created.")
        EndCallout()
        Subsubsection("Remarks")
        BulletList()
        ListItem("Parameters and return values allow us to write code that is neater and works in a larger number of scenarios. We're going to have to practice reading, writing, and debugging code like this however, because it works a little a differently than the programs we've gotten used to writing. Let's dive in!")
        TeachingTip()
        Paragraph():Strong("Providing Support:"):Text(" Circulate around the room through the lesson encouraging students to use the strategies introduced at the beginning of the lesson. Students have a number of supports at their fingertips, so a big part of your role is helping build their independence in using those resources.")
        EndCallout()
    end

    private action Activity35Minutes
        Section("Activity (35 minutes)")
        Subsection("Practice Time")
        Paragraph():Strong("Group: "):Text("It is recommended that students work in pairs for this lesson.")
        Subsection("Remarks")
        BulletList()
        ListItem("Today you're mostly going to practice what we've learned about programming with parameters and return values. In general we want to use the debugging process we've practiced all year, but here's some specific things to look out for in today's lesson.")
        NestedBulletList()
        ListItem("Use "):Code("output"):Text(" to call functions with parameters with different values to see how they run")
        EndNestedList()
        Paragraph():Strong("Lesson 3 Apps 1-5: "):Text("These Apps involve functions with parameters and return values, working in the console")
        BulletList()
        ListItem("Lesson3_App1: Calling a function multiple times with a single parameter")
        ListItem("Lesson3_App2: Students follow a pattern to choose a randomCompliment from a list that is concatenated with a name passed through a parameter")
        ListItem("Lesson3_App3: This is the same as Lesseon3_App1, except now the functions use return values. Again, students follow a pattern given in another working function.")
        ListItem("Lesson3_App4: Students write a function that returns the season a month is in. By this point, students should be noticing the type of commenting that is happening above each function. This format previews how students will need to write comments for libraries later on in the unit.")
        ListItem("Lesson3_App5: This level traverses lists to find the longest and shortest words. Parameters and return values are used.")
        Paragraph():Strong("Lesson 3 Apps 7-8: "):Text("Students continue practicing, now working with apps")
        BulletList()
        ListItem("Lesson3_App6: Students debug and comment an ordering app. Completing this level will require students to read programs that use functions with parameters and return carefully.")
        ListItem("Lesson3_App7: We return to the compliment code, this time reworking it into an app. Again students write their own comments, this time including comments for a return value. Students also complete the "):Code("UpdateScreen"):Text(" function, which calls both of the functions with parameters.")
        Paragraph():Strong("Lesson3_App8: "):Text("Students do a quick practice with the MOD operator.")
        Paragraph():Strong("Extension Opportunities:")
        BulletList()
        ListItem("Lesson3_App7: Add more greeting and compliment options to the lists")
    end

    private action WrapUp5Minutes
        Section("Wrap Up (5 minutes)")
        Paragraph():Strong("Prompt: "):Text("What aspects of working with parameters and return values do you feel like clicked today? What do you still feel like you have trouble with?")
        Paragraph():Strong("Discuss: "):Text("Have students share with one another before sharing with the whole class.")
        DiscussionGoal()
        Paragraph():Strong("Goal: "):Text("Use this opportunity to address any lingering questions or misconceptions in the room. You can also use this as a source of discussion topics to kick off the following lesson. As you lead the discussion, call out the many resources students have access to help when they're getting stuck.")
        EndCallout()
        Subsection("Remarks")
        BulletList()
        ListItem("Working with parameters and return values can be tricky. We will get more practice tomorrow by making an app that uses lists to store information.")
    end

    private action AssessmentCheckForUnderstanding
        Section("Assessment: Check for Understanding")
        Subsection("For Students")
        Paragraph("Open a word doc or google doc and copy/paste the following question.")
        Subsection("Question")
        Paragraph("The procedure below will be called twice with two numbers provided as arguments to the parameter "):Code("myNumber"):Text(". Which of the following pair of numbers will "):Code("mystery"):Text(" return the same value?")
        CodeExample("PROCEDURE mystery myNumber
final <- 0
IF myNumber > 100
    final <- 100
ELSE
    IF myNumber < 0
        final <- 0
    ELSE
        final <- myNumber
return final")
    end

    private action StandardsAlignment
        Section("Standards Alignment")
        BulletList()
        ListItem():Strong("CSTA K-12 Computer Science Standards (2017): "):Text("2-AP-14")
        ListItem():Strong("CSP2021: "):Text("AAP-2.C.2, AAP-2.O.1, AAP-3.A.5, AAP-3.A.7, AAP-3.A.8, AAP-3.C.1, AAP-3.C.2")
    end
end
