use Libraries.Web.Page.QuorumPage

/*
    Parameters, Return, and Libraries - Lesson 4: Parameters and Return Make.
    Converted from the old Lesson page by plan 13's generator: the same
    words, now without Tailwind.
*/
class CodeOrgUnit7Lesson4 is QuorumPage

    on create
        SetLocation("lessons/code/ParametersReturnLibraries/Lesson4.html")
        // The name lists and links use, and the series and track it belongs
        // to: its section and picture.
        SetShortTitle("Parameters and Return Make")
        SetSectionName("Parameters, Return, and Libraries")
        // For search engines and link previews, and what lists of pages say.
        SetDescription("Make an app that uses functions with parameters and return.")
        SetSummary("Learn about parameters and return")
    end

    action Setup
        SetWebPageTitle("Parameters and Return Make")
        Title("Parameters, Return, and Libraries - Lesson 4: Parameters and Return Make")
        Overview()
        GettingStarted5Minutes()
        Activity35Minutes()
        WrapUp5Minutes()
        AssessmentGradingTheProject()
        StandardsAlignment()
    end

    private action Overview
        Section("Overview")
        Paragraph("Students use the knowledge and skills they've developed working with parameters and return values to develop a Rock Paper Scissors App. Unlike typical Make projects, students are given a significant portion of the starter code but are given three functions with parameters and return values that they'll need to develop themselves. At the end students submit their apps which can be assessed using a provided rubric.")
        Subsection("Goals")
        Paragraph("Students will be able to:")
        BulletList()
        ListItem("Write functions with parameters and return values that meet a set of specified requirements")
        ListItem("Debug programs that use functions with parameters and return")
        Subsection("Purpose")
        Paragraph("Make lessons typically ask students to take on an entirely blank screen when writing their program. In this instance students have to take on the "):DoubleQuote():Text("blank function"):DoubleQuote():Text(" which needs to fit within the larger program they're developing. This is part of a broader mindset shift that students develop in this unit. Functions with parameters and return values operate like their own "):DoubleQuote():Text("mini programs"):DoubleQuote():Text(" which can be written and tested independently. There is actually less difference than students might think between previous make projects, in which students get the user interface elements and no code, and this project, in which they get some starter code but blank functions with parameters. In each case they need to develop programs that integrate into a larger portion of the project. The focus of this unit is how functions with parameters and return values help further split programs into logical chunks like this.")
        Subsection("Resources")
        BulletList()
        ListItem():Link("CSP-Widgets repository", "https://github.com/qorf/CSP-Widgets")
        Subsubsection("Supplemental Code.org material")
        BulletList()
        ListItem():Link("CSP Parameters and Return Make - Rock Paper Scissors App (Activity Guide)", "https://docs.google.com/document/d/1SoiuvHw0tuSUZe9vL4hmRzyPrH_2IIOvD7LgkGtEph8/edit")
    end

    private action GettingStarted5Minutes
        Section("Getting Started (5 minutes)")
        Paragraph():Strong("Prompt: "):Text("How do parameters and return change the way you write programs?")
        Paragraph():Strong("Discuss: "):Text("Have students share their ideas with a partner and then discuss as a class.")
        DiscussionGoal()
        Paragraph():Strong("Goal: "):Text("This discussion should prompt students to better understand what turns out to be a slightly different make project. Today they're going to be taking on "):DoubleQuote():Text("blank functions"):DoubleQuote():Text(" rather than "):DoubleQuote():Text("blank screens"):DoubleQuote():Text(". This is because with parameters and return values you can chunk out your programs into pieces that have well-defined behavior. Remind students that this is known as procedural abstraction. If students don't land on these ideas don't aim to force it but return to this idea in the wrap up.")
        EndCallout()
        Subsection("Remarks")
        BulletList()
        ListItem("Today we're going to be working on another Make project, but this one is a little bit different than others we've done in the course. A lot of the code will already be written for us, and we'll be working on blank functions, rather than entirely blank programs. Thanks to the way that parameters and return work, it's easy to design programs this way.")
    end

    private action Activity35Minutes
        Section("Activity (35 minutes)")
        Subsection("Build the Rock Paper Scissors App")
        TeachingTip()
        Paragraph():Strong("Supporting Students: "):Text("While students are working on their apps, circulate the room and check in with students who need a little help. Encourage students to collaborate and discuss bugs with each other.")
        Paragraph():Strong("Debugging: "):Text("Review with students steps they can use to debug if they get stuck:")
        BulletList()
        ListItem("Build small parts of the program at a time and test them to make sure they work")
        ListItem("Explain the code to a friend and clarify the differences between what they expect to happen and what is actually happening in")
        EndCallout()
        Paragraph():Strong("Group: "):Text("Make a determination as to whether this project will be completed in pairs or individually. You may even choose to let students decide.")
        Paragraph():Strong("Lesson4_ExampleApp - Explore: "):Text("Have students explore the working Rock Paper Scissors app. If students are not working in pairs they should still discuss the prompts with a neighbor.")
        BulletList()
        ListItem("What does each button do")
        ListItem("How does the screen get updated after clicking each button")
        Paragraph():Strong("Review: "):Text("Quickly review what students will be doing again before they move on to the next step.")
        Paragraph():Strong("Distribute: "):Text("Give students copies of "):Link("CSP Parameters and Return Make - Rock Paper Scissors App (Activity Guide)", "https://docs.google.com/document/d/1SoiuvHw0tuSUZe9vL4hmRzyPrH_2IIOvD7LgkGtEph8/edit"):Text(" if you will be using it during the lesson.")
        Paragraph():Strong("Submit: "):Text("Encourage students to check the rubric below or on the last page of the Activity Guide before submitting.")
        Table("Rubric for assessing student projects")
        TableHeader():Cell("Category"):Cell("Extensive Evidence"):Cell("Convincing Evidence"):Cell("Limited Evidence"):Cell("No Evidence")
        TableRow():Cell("findIcon Function"):Cell("The function returns the correct values for all input values."):Cell("The function returns the correct values for most input values."):Cell("The function returns the correct values for some input values."):Cell("The function does not return correct values for any input values.")
        TableRow():Cell("randomChoose Function"):Cell("The function returns the correct values for all input values."):Cell("The function returns the correct values for most input values."):Cell("The function returns the correct values for some input values."):Cell("The function does not return correct values for any input values.")
        TableRow():Cell("decideWinner Function"):Cell("The function returns the correct values for all combinations of inputs."):Cell("The function returns the correct values for most combinations of inputs."):Cell("The function returns the correct values for some combination of inputs."):Cell("The function does not return correct values for any combination of inputs")
        TableRow():Cell("Code runs without errors."):Cell("No errors are present in the required code."):Cell("Some errors are present in the required code."):Cell("Many errors are present in the required code."):Cell("The code does not run.")
        TableRow():Cell("Coding Comments"):Cell("Comments are used to correctly explain the purpose and functionality of all functions."):Cell("Comments are used to explain the purpose and functionality of most functions."):Cell("Comments are present, but are not used to explain the purpose or functionality of any functions."):Cell("Comments are not present.")
    end

    private action WrapUp5Minutes
        Section("Wrap Up (5 minutes)")
        Paragraph():Strong("Prompt: "):Text("How could using parameters and return help you write programs collaboratively?")
        DiscussionGoal()
        Paragraph():Strong("Goal: "):Text("This prompt should help review ideas that students saw in this project, in particuarly that parameters and return help break programs into chunks. It should also help them see that this approach could be used to collaboratively design programs. If teammates agree in advance what each function should do they can go off and write them separately before coming back together to make the entire app work.")
        EndCallout()
        Subsection("Remarks")
        BulletList()
        ListItem("Parameters and return help us chunk programs into pieces. Each important piece can be made into its own function which can be written and tested separately from the others. If you and your partner agree in advance how to split up the way a program is written and are clear on what each function needs to do, you could develop a program just like this make project.")
    end

    private action AssessmentGradingTheProject
        Section("Assessment: Grading the Project")
        Paragraph():Strong("Rubric: "):Text("Use the rubric provided with the project to assess student projects.")
    end

    private action StandardsAlignment
        Section("Standards Alignment")
        BulletList()
        ListItem():Strong("CSTA K-12 Computer Science Standards (2017): "):Text("2-AP-14")
        ListItem():Strong("CSP2021: "):Text("CRD-2.F.7")
    end
end
