use Libraries.Web.Page.QuorumPage

/*
    The Internet - Lesson 3: The Need for Addressing.
    Converted from the old Lesson page by plan 13's generator: the same
    words, now without Tailwind.
*/
class CodeOrgDigitalInfoLesson3 is QuorumPage

    on create
        SetLocation("lessons/code/Digital-Information/Lesson3.html")
        // The name lists and links use, and the series and track it belongs
        // to: its section and picture.
        SetShortTitle("The Need for Addressing")
        SetSectionName("The Internet")
        // For search engines and link previews, and what lists of pages say.
        SetDescription("A lesson about protocols and sending messages on the Internet")
        SetSummary("Learn about IP addresses and how they're used")
    end

    action Setup
        SetWebPageTitle("Unit 2 Lesson 3: The Need for Addressing")
        Title("The Internet - Lesson 3: The Need for Addressing")
        Overview()
        GettingStarted5Minutes()
        Activity30Minutes()
        WrapUp10Minutes()
        AssessmentCheckForUnderstanding()
        StandardsAlignment()
    end

    private action Overview
        Section("Overview")
        Paragraph("Students complete a scheduling challenge three times to explore the need for addressing messages online. Students first complete a challenge where they are allowed to talk to one another to fill out a weekly schedule. They then complete the challenge again, but this time they can only communicate using messages which are "):DoubleQuote():Text("broadcasted"):DoubleQuote():Text(" or sent to everyone in the same group. This challenge forces students to develop shared rules for communicating to complete the scheduling activity a second and then third time. The wrap up helps students connect their experiences to real-life rules, or protocols, used on the Internet for addressing messages.")
        Subsection("Goals")
        Paragraph("Students will be able to:")
        BulletList()
        ListItem("Explain the need for open and shared protocols for communicating on the Internet")
        ListItem("Describe the way the Internet Protocol helps uniquely identify one another on the Internet")
        Subsection("Purpose")
        Paragraph("Now that students have explored what it takes to link devices on a network, they are ready to learn how devices communicate with each other. Prior to this lesson, students have only interacted with point-to-point communication. In this lesson, students will instead "):DoubleQuote():Text("broadcast"):DoubleQuote():Text(" every message to every person in the same group. This closely mimics a real life problem that computer scientists had to solve: With all the bits passing through many computers on a network, how would a computer know if it was the intended recipient? Which computer should get a reply? Internet Protocol (IP) solves a portion of this problem by assigning a unique IP address to each device and standardizing how sender and recipient are identified.")
        Subsection("Resources")
        BulletList()
        ListItem():Link("The Internet: IP Addresses and DNS (Video)", "https://youtu.be/5o8CwafCxnU")
        ListItem():Link("The Need For Addressing (Activity Guide)", "https://docs.google.com/document/d/1JbZgvlloovjaV5UfewWj-E1-S5zmwgiv-r8_5cASoPY/edit?usp=sharing")
    end

    private action GettingStarted5Minutes
        Section("Getting Started (5 minutes)")
        Subsection("Prompt")
        Paragraph("Imagine you were in a room with 5 other people, all with the same name as you. What might happen when you start communicating? How could you solve these problems?")
        Subsection("Discuss")
        Paragraph("Have students brainstorm silently, then discuss with a neighbor, and finally share with the whole class.")
        DiscussionGoal()
        Paragraph("This prompt is meant to foreshadow some of the issues students will face when they use the Internet Simulator. Key points to draw out:")
        BulletList()
        ListItem("There might be confusion about who the person is trying to talk to because everyone has the same name.")
        ListItem("Multiple people might be talking at once, making it hard to tell what people are talking about.")
        ListItem("People may stop communicating because of the confusion.")
        EndCallout()
        Subsection("Remarks")
        BulletList()
        ListItem("Yesterday, you created a network that had strengths and weaknesses. Today, we are going to use a tool where one of the strengths is that everyone is connected and can get communications quickly at the same time. From our discussion, you might be starting to understand some of the weaknesses of this type of network.")
    end

    private action Activity30Minutes
        Section("Activity (30 minutes)")
        Subsection("Challenge - Week 1 (10 minutes)")
        Paragraph():Strong("Group"):Text(": This activity works best with groups of 6, though groups of 5 and 4 are also possible. Rather than a group of 6 and a group of 4, make two groups 5.")
        Paragraph():Strong("Distribute: "):Link("The Need For Addressing (Activity Guide)", "https://docs.google.com/document/d/1JbZgvlloovjaV5UfewWj-E1-S5zmwgiv-r8_5cASoPY/edit?usp=sharing")
        TeachingTip()
        Paragraph():Strong("Running Each Week"):Text(": This lesson has students completing the same activity three times. Each time students need to create a schedule for the week that allows them to see every other member of their group on one of the days. Each time this activity should take roughly 3 - 5 minutes.")
        Paragraph():Strong("Running The First Week"):Text(": This first run of the activity gives students a feel for how it runs. This will make sure that any confusion when they do the later weeks is caused by the lack of identifying information in the messages and not simply misunderstanding what to do.")
        EndCallout()
        Paragraph():Strong("Distribute: "):Text("With your group follow the directions given in the box for Week 1")
        BulletList()
        ListItem("If you are a group of 5, everyone cross out Sunday.")
        ListItem("If you are a group of 4, everyone cross out Sunday and Saturday.")
        ListItem("Before starting to schedule each week, choose a random day of that week when you're busy and cross it out.")
        Paragraph():Strong("Run Week 1: "):Text("Have students work on filling out their schedules, agreeing with one another on the days when they will meet. This should take 3 - 5 minutes for all groups to finish. When they're done ask students to quickly check that their schedules actually line up.")
        Paragraph():Strong("Prompt: "):Text("With your group check that everyone's schedules match. Then discuss what worked well, what made this tricky, if there's anything you want to try differently in Week 2.")
        Paragraph():Strong("Discuss: "):Text("Students do not need to share out their conversations with the class but circulate the room and listen as they discuss.")
        Subsection("Challenge - Week 2 (10 minutes)")
        Paragraph():Strong("Do This: "):Text("Have students set up their boards for week two in the same way as last time:")
        BulletList()
        ListItem("If you're a group of 4 or 5 cross out Saturday and/or Sunday.")
        ListItem("Randomly cross out a day in Week 2.")
        ListItem("Once you're ready you can start on Week 2, but no talking is allowed at all.")
        Paragraph():Strong("Do This: "):Text("Complete Week 2 without talking! Instead, messages need to be "):DoubleQuote():Text("broadcasted"):DoubleQuote():Text(" to the entire group.")
        TeachingTip()
        Paragraph():Strong("Broadcasting Messages: "):Text("The important part of the challenge is making sure that any information students try to convey "):Emphasis("must"):Text(" be conveyed to the entire group simultaneously, and it isn't obvious who the sender and recipient are by the method of broadcasting. There are many ways to do this, and we've included a few examples below. Choose a way that works best for your classroom and tell your students what method they'll be using. Here are some example methods:")
        Paragraph():Strong("Week 4: "):Text("A fourth week is included on the activity guide in case your classroom wants to run the activitiy another time at some point in the lesson. If not feel free to ignore it.")
        EndCallout()
        Paragraph():Strong("Prompt: "):Text("Fill out the table on the back side of your sheet. What problems did you have when communicating this time around? What solutions did you create or would you like to try for Week 3?")
        Paragraph():Strong("Discuss: "):Text("Have students share out some of the challenges they encountered and ways they're going to try to address them the second time around.")
        Subsection("Challenge - Week 4 (10 minutes)")
        Paragraph():Strong("Do This: "):Text("Agree with your group on the set of rules you'd like to try this time around for how to communicate. Then complete Week 3 like the previous two weeks. No talking!")
        Paragraph():Strong("Do This: "):Text("Based on your experience, take 5 minutes to write down in the rules section the collective rules you and your team would advise using going forward.")
        Paragraph():Strong("Discuss: "):Text("Have a few volunteers share the rules that their group developed.")
        DiscussionGoal()
        Paragraph("Use the share out to highlight common features across multiple sets of rules. Namely that:")
        BulletList()
        ListItem("Regardless of the rule, it needs to be clear and everyone needs to agree to them")
        ListItem("The sender and receiver need to be included in all messages to be understood")
        Paragraph("The goal of this discussion should be to set up the wrap up discussion where students connect their experiences in this lesson to computer science concepts that will be introduced.")
        EndCallout()
    end

    private action WrapUp10Minutes
        Section("Wrap up (10 Minutes)")
        Subsection("Remarks")
        BulletList()
        ListItem("Today we saw a lot of really important principles that are important on the Internet. The first is that if we want to talk to each other we need to know who messages are going from and to. The other is that we all are going to need to be using the same set of rules if we want to communicate with one another. Let us watch a video about these concepts.")
        Paragraph():Strong("Display: "):Link("The Internet: IP Addresses and DNS (Video)", "https://youtu.be/5o8CwafCxnU"):Text(". You can stop the video at the 3:23 mark. We watch the second half of this video in a later lesson on DNS.")
        Subsection("Prompt")
        Paragraph("What are the similarities and differences between Internet Protocol (IP) and the addressing rules our class made? Would rules like ours or IP work if they were secret?")
        Subsection("Discuss")
        Paragraph("Have students share their responses with a neighbor before discussing with the whole class.")
        DiscussionGoal()
        Paragraph("Students should walk away with an understanding that both the class rules and IP are shared, open protocols. Key points:")
        BulletList()
        ListItem("All devices and computers on the Internet use IP to connect and communicate with each other.")
        ListItem("Devices are assigned unique numbers (converted to binary sequences) called IP addresses.")
        ListItem("All devices format the sender and receiver information the same way so that devices on different networks can still communicate.")
        ListItem("These shared rules are called protocols. The Internet as we know it is actually these sets of protocols that are used to communicate over networks.")
        EndCallout()
        Subsection("Journal")
        Paragraph("Add the following vocab words and definitions to your journal: protocol, IP address, Internet Protocol.")
        Subsection("Remarks")
        BulletList()
        ListItem("Today we took an important step in learning about the Internet. We saw that it's not just important to build a network connecting all these devices, but we need open and shared rules, or protocols, for how these devices will communicate. In coming lessons we'll be learning more about the protocols on the Internet.")
    end

    private action AssessmentCheckForUnderstanding
        Section("Assessment: Check for Understanding")
        Subsection("For Students")
        Paragraph("Open a word doc or google doc and copy/paste the following 2 questions.")
        Subsection("Question 1")
        Paragraph("Pick the two statements from the following list that are true about the Internet Protocol (IP):")
        BulletList()
        ListItem("Each device or computer on the Internet is assigned a unique IP address.")
        ListItem("Each network on the Internet uses its own protocol to address messages.")
        ListItem("In order to communicate two devices on the Internet must have the same IP address.")
        ListItem("IP is the shared way that all devices and computers label their messages with the sender and receiver's addresses.")
        ListItem("IP is a secret protocol shared between the sender and receiver.")
        Subsection("Question 2")
        Paragraph("Describe how the Internet Protocol (IP) allows devices to easily connect and communicate on the Internet.")
    end

    private action StandardsAlignment
        Section("Standards Alignment")
        BulletList()
        ListItem():Strong("CSTA K-12 Computer Science Standards (2017): "):Text("2-NI-04, 3A-NI-04")
        ListItem():Strong("CSP2021: "):Text("CSN-1.B.1, CSN-1.B.2, CSN-1.B.3, CSN-1.B.4")
    end
end
