use Libraries.Web.Page.QuorumPage

/*
    The Internet - Lesson 8: Internet Dilemmas Part 2.
    Converted from the old Lesson page by plan 13's generator: the same
    words, now without Tailwind.
*/
class CodeOrgDigitalInfoLesson8 is QuorumPage

    on create
        SetLocation("lessons/code/Digital-Information/Lesson8.html")
        // The name lists and links use, and the series and track it belongs
        // to: its section and picture.
        SetShortTitle("Project - Internet Dilemmas Part 2")
        SetSectionName("The Internet")
        // For search engines and link previews, and what lists of pages say.
        SetDescription("Part two of a two-part project exploring internet dilemmas.")
        SetSummary("Finishing a two-day project exploring internet dilemmas.")
    end

    action Setup
        SetWebPageTitle("Lesson 8: Project - Internet Dilemmas Part 2")
        Title("The Internet - Lesson 8: Internet Dilemmas Part 2")
        Overview()
        GettingStarted5Minutes()
        Activity39Minutes()
        WrapUp1Minute()
        AssessmentSubmit()
        StandardsAlignment()
    end

    private action Overview
        Section("Overview")
        Paragraph("Students finish working on a two-day project exploring a dilemma at the intersection of the Internet and society.")
        Subsection("Goals")
        Paragraph("Students will be able to:")
        BulletList()
        ListItem("Identify how an internet dilemma has the potential to benefit and harm different stakeholders")
        ListItem("Identify the ways the technical structure and design of the Internet contributes to a social dilemma")
        Subsection("Purpose")
        Paragraph("In this project, students explore a relevant Internet dilemma: Net Neutrality, Internet Censorship, or the Digital Divide. Students apply their knowledge of how the Internet works to address the core question related to their chosen dilemma. These project lessons address the "):DoubleQuote():Text("so what"):DoubleQuote():Text(" question - why is it important to learn about how the Internet works?")
        Subsection("Resources")
        BulletList()
        ListItem():Link("Internet Dilemmas - Project Guide", "https://docs.google.com/document/d/1UZ1FJDBnwLARSmP7hqFKnMLkV8c2lC6C3qO5RPulDao/edit?usp=sharing")
        ListItem():Link("EXEMPLAR: Internet Dilemmas - Project Guide Exemplar", "https://docs.google.com/document/d/1LHCRJlpBK56ynaYp5-RfiKlaAzCoh99QXUU8xbMPJS4/edit?usp=sharing")
    end

    private action GettingStarted5Minutes
        Section("Getting Started (5 minutes)")
        Subsection("Remarks")
        BulletList()
        ListItem("Yesterday you began researching for your Internet Dilemma Policy One Pager. Today you will write the One Pager and then share what you've learned.")
        TeachingTip()
        Paragraph("The warm-up is short today. Continue on to the activity as soon as possible to give students the maximum amount of time to complete their one-pagers.")
        EndCallout()
    end

    private action Activity39Minutes
        Section("Activity (39 minutes)")
        Subsection("Policy One Pager")
        Paragraph():Strong("Do This:"):Text(" Students complete each section of the Internet Dilemma Policy One Pager found in "):Link("Internet Dilemmas - Project Guide", "https://docs.google.com/document/d/1UZ1FJDBnwLARSmP7hqFKnMLkV8c2lC6C3qO5RPulDao/edit?usp=sharing")
        Subsection("Share Out")
        Subsubsection("Remarks")
        BulletList()
        ListItem("Nice work! We are going to take the rest of class to share out what we've learned about these Digital Dilemmas. I'd like to ask for a couple of volunteers for each Dilemma to quickly share what they've learned about their topic and their recommendations.")
        TeachingTip()
        Paragraph("Keep an eye on the time for the share out. Students only have a minute or two to share their thoughts. The most important thing is that each dilemma should get equal coverage.")
        EndCallout()
    end

    private action WrapUp1Minute
        Section("Wrap up (1 Minute)")
        Subsection("Remarks")
        BulletList()
        ListItem("These dilemmas are tough - that's what makes a good dilemma. But hopefully you can now understand why it is so important to understand how the Internet works. You are now prepared to thoughtfully engage in these types of conversations that you may hear politicians talking about or read about in the news.")
    end

    private action AssessmentSubmit
        Section("Assessment: Submit")
        Paragraph():Strong("Submit:"):Text(" Students turn in the Project Guide for assessment.")
    end

    private action StandardsAlignment
        Section("Standards Alignment")
        BulletList()
        ListItem():Strong("CSTA K-12 Computer Science Standards (2017): "):Text("3A-IC-24, 3A-IC-28, 3A-IC-30, 3B-IC-26, 3B-IC-28")
        ListItem():Strong("CSP2021: "):Text("IOC-1.C.1, IOC-1.C.2, IOC-1.C.3, IOC-1.C.4, IOC-1.C.5, IOC-1.F.10")
    end
end
