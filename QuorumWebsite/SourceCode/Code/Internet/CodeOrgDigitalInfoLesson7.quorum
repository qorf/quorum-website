use Libraries.Web.Page.QuorumPage

/*
    The Internet - Lesson 7: Internet Dilemmas Part 1.
    Converted from the old Lesson page by plan 13's generator: the same
    words, now without Tailwind.
*/
class CodeOrgDigitalInfoLesson7 is QuorumPage

    on create
        SetLocation("lessons/code/Digital-Information/Lesson7.html")
        // The name lists and links use, and the series and track it belongs
        // to: its section and picture.
        SetShortTitle("Project - Internet Dilemmas Part 1")
        SetSectionName("The Internet")
        // For search engines and link previews, and what lists of pages say.
        SetDescription("Part one of a two-part project exploring internet dilemmas.")
        SetSummary("Begin working on a two-day project exploring internet dilemmas.")
    end

    action Setup
        SetWebPageTitle("Unit 2 Lesson 7: Project - Internet Dilemmas Part 1")
        Title("The Internet - Lesson 7: Internet Dilemmas Part 1")
        Overview()
        GettingStarted5Minutes()
        Activity35Minutes()
        WrapUp5Minutes()
        StandardsAlignment()
    end

    private action Overview
        Section("Overview")
        Paragraph("Students begin working on a two-day project exploring a dilemma at the intersection of the Internet and society.")
        Subsection("Goals")
        Paragraph("Students will be able to:")
        BulletList()
        ListItem("Identify how an internet dilemma has the potential to benefit and harm different stakeholders")
        ListItem("Identify the ways the technical structure and design of the Internet contributes to a social dilemma")
        Subsection("Purpose")
        Paragraph("In this project, students explore a relevant Internet dilemma: Net Neutrality, Internet Censorship, or the Digital Divide. Students apply their knowledge of how the Internet works to address the core question related to their chosen dilemma. This project addresses the "):DoubleQuote():Text("so what"):DoubleQuote():Text(" question - why is it important to learn about how the Internet works?")
        Subsection("Resources")
        BulletList()
        ListItem():Link("Internet Dilemmas - Project Guide", "https://docs.google.com/document/d/1UZ1FJDBnwLARSmP7hqFKnMLkV8c2lC6C3qO5RPulDao/edit?usp=sharing")
    end

    private action GettingStarted5Minutes
        Section("Getting Started (5 minutes)")
        Subsection("Remarks")
        BulletList()
        ListItem("We started this unit by writing down our thoughts on the Internet and how it works. Let's review a few of your questions on these sticky notes, and see if we know the answers now.")
        Subsection("Discuss")
        Paragraph("Select a few sticky notes and read them to the class. Address any misconceptions.")
        TeachingTip()
        Paragraph("Keep track of time! Students need the majority of class to work on their projects. The goal here isn't for every outstanding question to be answered, but instead to remind students how much they have learned and point out how they can continue learning.")
        EndCallout()
        Subsection("Remarks")
        BulletList()
        ListItem("Look how much we've learned! We may still have a few unanswered questions, and that's ok. It's good to always want to know more - and thankfully we have the Internet available to help us answer those questions!")
        ListItem("Or at least, that's what we might think, but access to the Internet is not always guaranteed. Today we are going to start a project where you will consider a dilemma related to Internet access.")
    end

    private action Activity35Minutes
        Section("Activity (35 minutes)")
        Subsection("Remarks")
        BulletList()
        ListItem("Today, you are going to pretend that you are the Chief Technology Advisor for a candidate running for elected office. Your candidate is relying on you to help inform her about important technological dilemmas and come up with good policy ideas to address them. For this project you'll investigate a social dilemma related to the Internet and prepare a report summarizing your findings and making a policy recommendation for your candidate.")
        ListItem("Let's take a look at three of the different dilemmas: Net Neutrality, Internet Censorship, and the Digital Divide.")
        Paragraph():Strong("Distribute:"):Text(" Give students copies of "):Link("Internet Dilemmas - Project Guide", "https://docs.google.com/document/d/1UZ1FJDBnwLARSmP7hqFKnMLkV8c2lC6C3qO5RPulDao/edit?usp=sharing")
        TeachingTip()
        Paragraph("The project guide includes links to three different sources for each of the internet dilemmas that students can tackle. If you're physically printing and handing out the guide, make sure you give students links or some other way to access the online sources!")
        EndCallout()
        Table("Concept Bank")
        TableHeader():Cell("Protocol/Layesr"):Cell("Networks"):Cell("Packets and Routing"):Cell("World Wide Web"):Cell("Internet Principles")
        TableRow():Cell("Physical internet, IP, TCP, UDP, HTTP, DNS."):Cell("Fiber optic cable, copper wire, wifi, router, path, direct connection, bandwidth."):Cell("Packet metadata, IP addresses, dynamic routing."):Cell("Web pages, browsers, servers, domain, world wide web."):Cell("Redundancy, fault tolerance, scalability, open protocols.")
        Paragraph():Strong("Do This:"):Text(" Read out loud the Background & Core Question for each dilemma.")
        BulletList()
        ListItem():Strong("Step 1 - Choose (3 mins):"):Text(" Students read over the first page of the Project Guide and pick their Dilemma. At the end of this time, take a quick poll on who is doing what dilemma. You will want to ensure that the dilemmas are evenly covered by the class.")
        ListItem():Strong("Step 2 - Review the One-Pager and Rubric (5 mins):"):Text(" Students review the one pager template and rubric to make sure they understand what they'll be responsible for creating for this project and how it'll be evaluated.")
        ListItem():Strong("Step 3 - Review the Concept Bank (3 mins):"):Text(" This concept bank includes the key terms and concepts covered in this unit. Students should quickly review them before reading their articles so that they'll be ready to identify them in their articles. They can also refer to these as they complete their one-pager.")
        ListItem():Strong("Step 4 - Review Your Sources (20 mins):"):Text(" Students review the three sources provided or additional ones they find online. For each source they take notes on instances when their impacted groups are mentioned or technical details that are explained.")
    end

    private action WrapUp5Minutes
        Section("Wrap up (5 Minutes)")
        Subsection("Remarks")
        BulletList()
        ListItem("Next time you'll have most of the class to work on your one-pagers and we'll take time at the end to share what you've learned.")
        Subsection("Journal")
        Paragraph("Students add to their journal the definition for digital divide.")
        TeachingTip()
        Paragraph():Strong("Why is Digital Divide the only vocabulary word?"):Text(" Digital Divide is a term covered in the AP CSP Conceptual Framework. We want to make sure all students - even those who don't choose it as a Digital Dilemma understand the meaning of the phrase.")
        EndCallout()
    end

    private action StandardsAlignment
        Section("Standards Alignment")
        BulletList()
        ListItem():Strong("CSTA K-12 Computer Science Standards (2017): "):Text("3A-IC-24, 3A-IC-28, 3A-IC-30, 3B-IC-26, 3B-IC-28")
        ListItem():Strong("CSP2021: "):Text("IOC-1.C.1, IOC-1.C.2, IOC-1.C.3, IOC-1.C.4, IOC-1.C.5, IOC-1.F.10")
    end
end
