use Libraries.Web.Page.QuorumPage
use Libraries.Web.Page.TableRowWriter

/*
    The Internet - Lesson 6: HTTP and DNS.
    Converted from the old Lesson page by plan 13's generator: the same
    words, now without Tailwind.
*/
class CodeOrgDigitalInfoLesson6 is QuorumPage
    // The table row being written, when its cells hold more than words.
    TableRowWriter row = undefined

    on create
        SetLocation("lessons/code/Digital-Information/Lesson6.html")
        // The name lists and links use, and the series and track it belongs
        // to: its section and picture.
        SetShortTitle("HTTP and DNS")
        SetSectionName("The Internet")
        // For search engines and link previews, and what lists of pages say.
        SetDescription("A lesson exploring how HTTP and DNS are used on the Internet")
        SetSummary("Learn how the different protocols of the Internet interact")
    end

    action Setup
        SetWebPageTitle("Unit 2 Lesson 6: HTTP and DNS")
        Title("The Internet - Lesson 6: HTTP and DNS")
        Overview()
        GettingStarted5Minutes()
        Activity30Minutes()
        WrapUp10Minutes()
        AssessmentCheckForUnderstanding()
        StandardsAlignment()
    end

    private action Overview
        Section("Overview")
        Paragraph("Students conclude their study of the layers of the Internet by learning about two top-level protocols, HTTP and DNS. The lesson begins with a review of the layers students have already learned, namely the physical Internet, IP, and TCP / UDP. The lesson then dives into the core of the unit which is "):DoubleQuote():Text("What happens when I type an address into my browser?"):DoubleQuote():Text(" Students will complete a brief activity to explore how the DNS works. Students then watch videos explaining how both DNS and HTTP work, taking notes and using a provided activity guide. The lesson concludes with a review of how the different layers of the Internet work.")
        Subsection("Goals")
        Paragraph("Students will be able to:")
        BulletList()
        ListItem("Describe how HTTP is used for sharing the files and pages that make up the World Wide Web")
        ListItem("Describe how the Domain Name System helps the Internet scale by allowing devices to find the IP addresses associated with a domain name")
        ListItem("Explain how different layers of protocols on the Internet build upon and rely on one another")
        Subsection("Purpose")
        Paragraph("This lesson is designed to wrap up the series on how the Internet works and highlight the main design philosophies of openness, reliability, and scalability. However, actions taken by governments and organizations challenge some of these design philosophies and may hinder the ability of the World Wide Web to be truly worldwide. Students will begin thinking about some of the dilemmas caused by these conflicts, which they will explore further after this lesson.")
        Subsection("Resources")
        BulletList()
        ListItem():Link("CSP-Widgets repository", "https://github.com/qorf/CSP-Widgets")
        ListItem():Link("IP Address Labels - Teacher Resource", "https://docs.google.com/document/d/1IcnID2dhXrhagkJCUULO8g240NflvofUs3q23yEnUu4/edit?usp=sharing")
        ListItem():Link("The Internet: IP Addresses and DNS - Video (timestamped to the second half)", "https://youtu.be/5o8CwafCxnU?t=249")
        ListItem():Link("The Internet: HTTP and HTML - Video", "https://youtu.be/kBXQZMmiA4s")
        Subsubsection("Supplemental Code.org material")
        Paragraph("For the students")
        BulletList()
        ListItem():Link("Layers of the Internet - Activity Guide", "https://docs.google.com/document/d/1EB_y099r7Qwb3SxFhHK9wSaikoHixL85O4_YdsUBJSY/edit")
    end

    private action GettingStarted5Minutes
        Section("Getting Started (5 minutes)")
        Paragraph():Strong("Distribute:"):Text(" As students enter class, hand each of them a single IP address. You cut these out ahead of time from "):Link("IP Address Labels - Teacher Resource", "https://docs.google.com/document/d/1WqLbzqZEXHb7x2i9PmJF1-knDbxoZzeJu9ywJwcv4ow/edit"):Text(". You could also use handwritten notes or any other medium that's convenient for you and your students.")
        TeachingTip()
        Paragraph():Strong("Showing the Need for DNS:"):Text(" This quick unplugged activity helps students understand why the DNS exists in the first place. With devices joining the internet all the time it's impossible for each device to keep track of each other device's IP address.")
        Paragraph():Strong("Keep it Short:"):Text(" This activity can be done very quickly, typically in about 3 minutes, before students start to see the core challenge. If students start running away from you that's a good sign they've seen what makes this activity tricky!")
        EndCallout()
        Subsection("Do This")
        Paragraph("Your goal is to create a list in your journals of every one of your classmates IP addresses. The only rules:")
        BulletList()
        ListItem("You may walk around the room")
        ListItem("You may share information with classmates")
        ListItem("You may talk / share information with only ONE classmate at a time")
        Paragraph():Strong("Circulate:"):Text(" As students are working, circulate quietly through the room.")
        BulletList()
        ListItem("Approach a student and silently take their IP address slip away from them.")
        ListItem("Give that person a new IP address slip (or a re-used IP address).")
        ListItem("Repeat the above two steps as many times as you can, as you circulate the room.")
        Paragraph():Strong("Prompt:"):Text(" Discuss with your classmates the following prompts:")
        BulletList()
        ListItem("Why do you think I was switching IP addresses?")
        ListItem("If IP addresses can change, is there a better way for everyone to know everyone else's IP address?")
        Paragraph():Strong("Prompt:"):Text(" Discuss responses to these questions with students, using the discussion goal to guide the conversation.")
        DiscussionGoal()
        Paragraph("Main takeaways should include:")
        EndCallout()
        Subsection("Remarks")
        BulletList()
        ListItem("If we want the Internet to scale up to billions of devices, then we need a better way to figure out one another's IP addresses!")
    end

    private action Activity30Minutes
        Section("Activity (30 minutes)")
        Subsection("Video #1: DNS")
        Paragraph():Strong("Prompt:"):Text(" As we watch the following video take notes on:")
        BulletList()
        ListItem("How does the DNS solve the problem of translating domain names like example.com into IP addresses?")
        ListItem("How does the DNS help the Internet scale?")
        Paragraph():Strong("Display:"):Text(" Show "):Link("The Internet: IP Addresses and DNS - Video", "https://youtu.be/5o8CwafCxnU?t=249"):Text(" on DNS, which explains how it works. Video will automatically start playing at the introduction of DNS.")
        Video("https://www.youtube.com/embed/5o8CwafCxnU?si=ezhtLQ4E5-UMixJo", "The Internet: IP Addresses & DNS")
        Paragraph():Strong("Prompt:"):Text(" Discuss the following prompts with a partner:")
        BulletList()
        ListItem("How does the DNS solve the problem of translating domain names like example.com into IP addresses?")
        ListItem("How does the DNS help the Internet scale?")
        Paragraph():Strong("Discuss:"):Text(" Have students discuss responses with their partners, then share out with the class. Focus on the main takeaways in the discussion goal.")
        DiscussionGoal()
        Paragraph("The main takeaways from this video should be:")
        BulletList()
        ListItem("The DNS is a network of servers that track the IP addresses of different domain names like example.com")
        ListItem("When you visit a website you first ask the DNS for the IP address of the domain you want to visit. The first server to ask may have to ask other servers for this information.")
        ListItem("This system allows billions of devices to get added to the network without putting pressure on any one computer or server to know all the IP addresses in the world.")
        EndCallout()
        Subsection("Video #2: HTTP and the World Wide Web")
        Subsubsection("Remarks")
        BulletList()
        ListItem("We've got our heads wrapped around how DNS works. Let's learn about the last piece of the puzzle here, a protocol called HTTP. In this video we'll learn what happens when you actually visit a website and the language used to send those files around.")
        Paragraph():Strong("Do This:"):Text(" As we watch this video take notes on the HTTP protocol.")
        BulletList()
        ListItem("What problem is HTTP solving?")
        ListItem("What is a GET request and what are your requesting?")
        ListItem("How does HTTP rely on the other layers of the Internet?")
        ListItem("Why are SSL/TLS, and HTTPS necessary?")
        ListItem("What do certificate authorities do and why are they necessary?")
        Paragraph():Strong("Display:"):Text(" Watch "):Link("The Internet: HTTP and HTML - Video", "https://youtu.be/kBXQZMmiA4s")
        Video("https://www.youtube.com/embed/kBXQZMmiA4s?si=Vfa4mBpBBWRQKBhs", "The Internet: HTTP & HTML")
        Paragraph():Strong("Prompt:"):Text(" Review these questions with a partner about HTTP")
        BulletList()
        ListItem("What problem is HTTP solving?")
        ListItem("What is a GET request and what are your requesting?")
        ListItem("How does HTTP rely on the other layers of the Internet?")
        ListItem("Why are SSL/TLS, and HTTPS necessary?")
        ListItem("What do certificate authorities do and why are they necessary?")
        Paragraph():Strong("Discuss: "):Text("Have students share out their responses with the class to make sure students understand the key takeaways about HTTP.")
        DiscussionGoal()
        Paragraph("Here are the most important points for students to take away about HTTP and the way it works")
        BulletList()
        ListItem("When you visit a website you're actually getting sent a file by a server. HTTP is solving the problem of how to ask for that file.")
        ListItem("Your computer and that server communicate using a protocol called HTTP.")
        ListItem("HTTP is plain-text, so it literally includes the ASCII word "):DoubleQuote():Text("GET ..."):DoubleQuote():Text(" and the file name requested.")
        ListItem("All of your communications are being sent over the Internet so these requests are being sent inside TCP/IP packets and over the physical wires of the Internet.")
        ListItem("There are other secure ways of sending information online because using HTTP, all our information would otherwise be sent as plain text.")
        ListItem("Certificate authorities ensure that when you start a secure connection you're talking to the website you think you're talking to.")
        EndCallout()
    end

    private action WrapUp10Minutes
        Section("Wrap up (10 Minutes)")
        Paragraph():Strong("(Optional) Distribute:"):Text(" Give students a copy of the "):Link("Layers of the Internet - Activity Guide", "https://docs.google.com/document/d/1EB_y099r7Qwb3SxFhHK9wSaikoHixL85O4_YdsUBJSY/edit")
        Subsection("Prompt")
        Paragraph("Using your Layers of the Internet activity guide to help you, explain how each of the different layers is involved when you go to a link like example.com?")
        Subsection("Discuss")
        Paragraph("Use this final prompt as a review of everything covered in both today's lesson and those that came before. You'll actually probably want to start with the bottom of your review guide.")
        DiscussionGoal()
        Paragraph("Use this final discussion to review not just this lesson but every protocol / layer of the Internet students have learned so far. You'd aim to see responses like the following:")
        BulletList()
        ListItem("When you type in example.com, your browser will contact the DNS to find example.com's IP address")
        ListItem("When you receive the address you'll send an HTTP GET request to example.com to send you its homepage")
        ListItem("example.com's server will respond with the HTML code that makes up its web page")
        ListItem("All of the communications above happen on the Internet which means TCP or UDP will break the message into packets and then send them. If TCP is used, error checking will occur.")
        ListItem("IP will route the packets back and forth between your computer and the server")
        ListItem("All of this information is sent over the physical wires, cable, wifi networks, and routers that make up the physical network of the internet.")
        EndCallout()
        Table("A table of protocol/layers of the internet that students have studied in this lesson")
        TableHeader():Cell("Protocol/Layer"):Cell("What Problems Does It Solve"):Cell("How Does It Work")
        row = TableRow()
        row:Cell():Strong("Physical Network")
        row:Cell():Text("Physically connecting devices to one another so that information can move through the network.")
        row:Cell():Text("Fiber optic cables, wifi signals, or copper wires physically connect the computers, smart phones, servers, etc. that make up the Internet. Computers don't need to be directly connected to each other, just a single point on the network.")
        row = TableRow()
        row:Cell():Strong("IP: Internet Protocol")
        row:Cell():Text("Uniquely identifying people on the internet and routing messages between them.")
        row:Cell():Text("Each device on the internet is given a unique IP address. Packets sent on the internet include to and from IP addresses. Routers along the way use this information to move data along a path of direct connections. Routing happens dynamically, meaning the path is unpredictable and changes based on network conditions.")
        row = TableRow()
        row:Cell():Strong("TCP: Transmission Control Protocol")
        row:Cell():Text("Send large messages over the Internet when accuracy is most important. You would either use TCP or UDP.")
        row:Cell():Text("Messages are divided into packets and sent all at once. Packets are numbered so that they can be re-ordered and missing packets can be requested by the receiver. TCP is slower than UDP because error checking like this takes more time, but it is much more reliable.")
        row = TableRow()
        row:Cell():Strong("UDP: User Datagram Protocol")
        row:Cell():Text("Send large messages over the Internet when speed is most important. You would either use TCP or UDP.")
        row:Cell():Text("Messages are divided into packets and sent all at once. There is no error-checking to ensure all packets arrive or that they're in order. UDP is faster than TCP but more errors are possible. This is useful for streaming video or online gaming because having the picture displayed quickly is more important than it being displayed with a perfectly clear picture.")
        row = TableRow()
        row:Cell():Strong("DNS: Domain Name System")
        row:Cell():Text("Translate human-readable domains like code.org or example.com into IP addresses that can be used by the Internet.")
        row:Cell():Text("When you try to go to a domain like example.com, you computer first contacts a system of servers collectively called the DNS which keeps track of the IP addresses associated with each domain name. Communication with DNS servers happens over the Internet, meaning the request to and from servers are sent as TCP/ IP packets.")
        row = TableRow()
        row:Cell():Strong("HTTP: HyperText Transfer Protocol")
        row:Cell():Text("Allow computers to request and share webpages, audio, images, videos, and other file types on the Internet, collectively known as the world wide web.")
        row:Cell():Text("Computers communicate in plain text like GET to request files or send data. The server that receives the request responds with the files requested which are displayed by your browser. HTTP requests are sent between computers over the internet as part of TCP/IP packets. The world wide web is just files that are requested using HTTP and sent over the Internet.")
        Subsection("Remarks")
        BulletList()
        ListItem("At this point you all know a LOT more about the Internet then the average person. Tomorrow we're going to turn our attention to thinking through how we can use this knowledge to make good decisions about the Internet's impact on our everyday lives.")
        Subsection("Journal")
        Paragraph("Review the key takeaways of the lesson and have students add new vocabulary to their journals: scalability, DNS, World Wide Web, HTTP")
        BulletList()
        ListItem():Emphasis("Scalability:"):Text(" the capacity for the system to change in size and scale to meet new demands")
        ListItem():Emphasis("The Domain Name System (DNS):"):Text(" the system responsible for translating domain names like example.com into IP addresses")
        ListItem():Emphasis("World Wide Web:"):Text(" a system of linked pages, programs, and files")
        ListItem():Emphasis("Hypertext Transfer Protocol (HTTP):"):Text(" a protocol for computers to request and share the pages that make up the world wide web on the Internet")
    end

    private action AssessmentCheckForUnderstanding
        Section("Assessment: Check for Understanding")
        Subsection("For Students")
        Paragraph("Open a word doc or google doc and copy/paste the following 2 questions.")
        Subsection("Question 1")
        Paragraph("Choose the two statements from the following list that best describe the relationship between HTTP and the World Wide Web:")
        BulletList()
        ListItem("The World Wide Web is a protocol used for sharing HTTP messages")
        ListItem("The World Wide Web is a collection of pages and files that is shared between computers using HTTP")
        ListItem("Computers will send information using either HTTP or the World Wide Web, but not both.")
        ListItem("HTTP and the World Wide Web both rely on other layers of protocols for sending information on the Internet")
        Subsection("Question 2")
        Paragraph("In your own words explain the following 2 questions about the Domain Name System:")
        BulletList()
        ListItem("What problem does the DNS solve?")
        ListItem("How does the DNS help the world wide web scale so that billions of users can access billions of web pages?")
    end

    private action StandardsAlignment
        Section("Standards Alignment")
        BulletList()
        ListItem():Strong("CSTA K-12 Computer Science Standards (2017): "):Text("2-NI-04, 3A-NI-04, 3B-NI-03")
        ListItem():Strong("CSP2021: "):Text("CSN-1.B.7, CSN-1.D.1, CSN-1.D.2, CSN-1.D.3, IOC-2.B.6")
    end
end
