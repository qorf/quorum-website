use Libraries.Web.Page.QuorumPage

/*
    The Internet - Lesson 1: Welcome to the Internet.
    Converted from the old Lesson page by plan 13's generator: the same
    words, now without Tailwind.
*/
class CodeOrgDigitalInfoLesson1 is QuorumPage

    on create
        SetLocation("lessons/code/Digital-Information/Lesson1.html")
        // The name lists and links use, and the series and track it belongs
        // to: its section and picture.
        SetShortTitle("Welcome to the Internet")
        SetSectionName("The Internet")
        SetCardImage("/media/userInterface/quorumAssets/cspImages/csp2.svg")
        SetCardDescription("This unit reveals how the Internet was designed to connect billions of devices and people to one another. Learn how the different protocols of the Internet work together. ")
        // For search engines and link previews, and what lists of pages say.
        SetDescription("An introduction to internet concepts")
        SetSummary("Identify questions about how the Internet works")
    end

    action Setup
        SetWebPageTitle("Unit 2 Lesson 1: Welcome to the Internet")
        Title("The Internet - Lesson 1: Welcome to the Internet")
        Overview()
        GettingStarted5Minutes()
        Activity35Minutes()
        WrapUp5Minutes()
        AssessmentCheckForUnderstanding()
        StandardsAlignment()
    end

    private action Overview
        Section("Overview")
        Paragraph("After a short transition from representing information in Unit 1 to communicating information in Unit 2, students take time to think about their knowledge of the Internet and how it works.")
        Subsection("Goals")
        BulletList()
        ListItem("Identify questions students have about how the Internet works")
        Subsection("Purpose")
        Paragraph("This lesson helps transition between representing digital information in Unit 1 to communicating digital information in Unit 2. The stage is set to understand the different layers of the Internet through the sticky notes activity where students record what they know and don't know about how the Internet works. Students should leave this lesson primed to know more about the Internet.")
        Subsection("Resources")
        BulletList()
        ListItem():Link("What is the Internet? (Video)", "https://www.youtube.com/watch?v=Dxcc6ycZ73M")
    end

    private action GettingStarted5Minutes
        Section("Getting Started (5 minutes)")
        Subsection("Prompt")
        Paragraph("We've learned to represent images, text, and sound digitally - but, we haven't discussed what we do with all this digital data. How do you see people sharing this kind of data in the real world? Who do they want to share it with and why?")
        DiscussionGoal()
        Paragraph("Thinking about this unit as a whole, it is helpful to validate ideas that consider the motivations and consequences of how digital information is shared. These can be important points to return to at the end of the unit when introducing the Internet Dilemma's project.")
        EndCallout()
        Subsection("Remarks")
        BulletList()
        ListItem("So far this year, we've investigated how to represent information digitally. Today, we're going to investigate what it would take to communicate this information with others.")
    end

    private action Activity35Minutes
        Section("Activity (35 minutes)")
        Subsection("Prompt")
        Paragraph("Answer each of these prompts in your journal:")
        BulletList()
        ListItem("What is the Internet?")
        ListItem("What questions do you have about how the Internet works?")
        TeachingTip()
        Paragraph("Give students 10 minutes to write in their journals. It's ok if there are some awkward silences. We want students to have the time to really think deeply about what they know and don't know.")
        Paragraph("If students are struggling to come up with things to write down, consider asking the following:")
        BulletList()
        ListItem("When you enter a web address in a browser and hit enter, what happens? At some point you see the web page in the browser, but what happens in between? What are all the steps?")
        ListItem("Write down the series of things that you think (or have heard) happen right after you hit Enter. What happens first, second, third and so on.")
        ListItem("Don't worry if you don't know all the pieces or how they all fit together. If you don't know a step, or you are fuzzy on some details, or there's a gap, that's okay. Just write down the parts that you know.")
        EndCallout()
        Subsection("Discuss")
        Paragraph("Ask a few students to share their answers with the class.")
        DiscussionGoal()
        Paragraph("Ask for a few volunteers to share what they know about the Internet. It's ok if answers are light or even incorrect! This is the starting place for the unit.")
        EndCallout()
        Subsection("Do This")
        Paragraph("Direct students to take two sticky notes and choose one response or question to put on each sticky note. Post the sticky notes on a poster in the front of the room to refer back to throughout the unit as questions are answered.")
        Paragraph():Strong("Video:"):Text(" Play "):DoubleQuote():Link("What is the Internet", "https://www.youtube.com/watch?v=Dxcc6ycZ73M"):DoubleQuote():Text(".")
        Video("https://www.youtube.com/embed/Dxcc6ycZ73M?si=7pPLj1wTSq9LAXVa", "What is the Internet?")
        TeachingTip()
        Paragraph("Use the video to normalize students' misconceptions about how the Internet works. Over the course of the unit, we will work to address those points of confusion.")
        EndCallout()
    end

    private action WrapUp5Minutes
        Section("Wrap up (5 Minutes)")
        Subsection("Remarks")
        BulletList()
        ListItem("Why learn about how the Internet works? As Vint Cerf Says: "):DoubleQuote():Text("You can't escape from contact with the Internet. So why not get to know it?"):DoubleQuote():Text(" But you don't have to take Vint Cerf's word. Some of the largest issues facing society hinge on an understanding of how the Internet functions.")
        ListItem("At the end of this unit you will do a project focusing on a societal issues. As you go through these lessons keep you ears and eyes open for how things work.")
        ListItem("Many of the issues are related to people taking advantage of the open protocols that make the Internet function and present us with tricky dilemmas. We will learn about protocols late in this unit.")
        ListItem("For example there are two major issues to think about:")
        NestedBulletList()
        ListItem("Net Neutrality is a raging legal debate about the principle that Internet service providers should enable access to all content and applications regardless of the source, and without favoring or blocking particular products or websites.")
        ListItem("Internet Censorship is the attempt to control or suppress of what can be accessed, published, or viewed on the Internet by certain people. This can be used to protect people (i.e. to not allow access to child pornography) but can also be used to limit free speech.")
        EndNestedList()
        ListItem("To have an informed opinion though it helps to understand the technical underpinnings of how the internet works.")
        ListItem("Finally, a major issue that our society faces is that far too few people actually understand how the Internet works! We are going to change that over the next few lessons.")
    end

    private action AssessmentCheckForUnderstanding
        Section("Assessment: Check for Understanding")
        Subsection("For Students")
        Paragraph("Open a word doc or google doc and copy/paste the following question.")
        Subsection("Question")
        Paragraph("How do you use the Internet? Think about your typical day. When are you using the Internet? For what purposes? What role does it have in your life?")
    end

    private action StandardsAlignment
        Section("Standards Alignment")
        BulletList()
        ListItem():Strong("CSTA K-12 Computer Science Standards (2017): "):Text("2-NI-04, 3A-NI-04, 3B-NI-03")
    end
end
