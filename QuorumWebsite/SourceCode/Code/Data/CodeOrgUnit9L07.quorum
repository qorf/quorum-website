use Libraries.Web.Page.QuorumPage

/*
    Data - Lesson 7: Tell a Data Story Part 1.
    Converted from the old Lesson page by plan 13's generator: the same
    words, now without Tailwind.
*/
class CodeOrgUnit9L07 is QuorumPage

    on create
        SetLocation("lessons/code/Data/Lesson7.html")
        // The name lists and links use, and the series and track it belongs
        // to: its section and picture.
        SetShortTitle("Tell a Data Story Part 1")
        SetSectionName("Data")
        // For search engines and link previews, and what lists of pages say.
        SetSummary("explore innovations in everyday life")
    end

    action Setup
        SetWebPageTitle("Project - Tell a Data Story Part 1")
        Title("Data - Lesson 7: Tell a Data Story Part 1")
        Overview()
        Activity43Mins()
        WrapUp0Minutes()
        StandardsAlignment()
    end

    private action Overview
        Section("Overview")
        Paragraph("This is the first day of a project where students use the Data Analysis Process to tell a data story. Students complete the first page of the Activity Guide for this project during this lesson.")
        Subsection("Goals")
        Paragraph("Students will be able to:")
        BulletList()
        ListItem("Follow the Data Analysis Process to tell a data story")
        ListItem("Write a short explanation of a data set referencing the metadata")
        ListItem("Create an effective visualization")
        Subsection("Purpose")
        Paragraph("The goal of this lesson is for students to put into use all of the data analysis skills they have practiced throughout this unit.")
        Subsection("Resources")
        Subsubsection("Supplimental Code.org material")
        BulletList()
        ListItem():Link("CSP U9 Project Guide - Tell a Data Story", "https://docs.google.com/document/d/1my-xp5mA5le05dcPp7kVawrK0-68flRifUZcqCRjltA/edit?usp=sharing")
    end

    private action Activity43Mins
        Section("Activity (43 mins)")
        Paragraph():Strong("Distribute:"):Text(" Make sure that all students have access to the Project Guide. A link to the project guide can be found in the Resources section of this lesson.")
        TeachingTip()
        Paragraph("Choosing a dataset for the project and creating the visualization may be a cyclical process. Encourage students to explore the datasets before making a firm decision. Allow a good amount of time for this exploration.")
        Paragraph("Students should look for visualizations that lead to a compelling narrative. This will result in a more compelling and insightful written response.")
        Paragraph("Student answers on the Project Guide will vary. You might ask students to write full paragraphs or allow bullet points. You are encouraged to modify for your classroom environment.")
        EndCallout()
        Paragraph():Strong("Do This:"):Text(" Students are focusing on Page 1 of the guide today, which covers the first three parts of the Data Analysis Process.")
        Subsection("Tell a Data Story")
        BulletList()
        ListItem("Select a dataset from the Data Library. Read the metadata to understand what information is available in the table")
        NestedBulletList()
        ListItem("Dataset Name:")
        ListItem("Short Description:")
        EndNestedList()
        ListItem("Did you filter or clean the data? Why or why not?")
        ListItem("Describe the data. Does it have a shape? Can you determine a pattern.")
        Table("Rubric for Tell a Data Story Activity")
        TableHeader():Cell("Category"):Cell("Extensive Evidence"):Cell("Convincing Evidence"):Cell("Limited Evidence"):Cell("No Evidence")
        TableRow():Cell("Collect or Choose Data"):Cell("Dataset is correctly identified and description is complete."):Cell("Dataset is correctly identified and description is mostly complete."):Cell("Dataset is correctly identified and description is somewhat complete."):Cell("Dataset is not identified or description is missing.")
        TableRow():Cell("Clean/Filter Data"):Cell("Explanation for cleaning and/or filtering is complete and reasonable."):Cell("Explanation for cleaning and/or filtering is complete and mostly reasonable."):Cell("Explanation for cleaning and/or filtering is somewhat complete or somewhat reasonable."):Cell("Explanation for cleaning and/or filtering is incomplete.")
        TableRow():Cell("Description and Find Patterns"):Cell("Data Description is readable and includes a title, and citation."):Cell("Data Description is mostly readable and includes a title, and citation."):Cell("Data Description is somewhat readable and/or is missing a title or citation."):Cell("Data Description is unreadable or missing.")
        TableRow():Cell("New Information: Interpreting the Data Description"):Cell("The Data Description is thoroughly explained."):Cell("The Data Description is mostly explained."):Cell("The Data Description is somewhat explained."):Cell("The Data Description is not explained.")
        TableRow():Cell("New Information: Insights or Decisions"):Cell("Insights or decisions are reasonable and effectively linked to information displayed in the Data Description."):Cell("Insights or decisions are mostly reasonable and effectively linked to information displayed in the Data Description."):Cell("Insights or decisions are mostly reasonable and somewhat effectively linked to information displayed in the Data Description."):Cell("Insights or decisions are missing.")
        TableRow():Cell("New Information: Bias"):Cell("Possible problems with analysis or potential bias are reasonable and thoughtfully addressed."):Cell("Possible problems with analysis or potential bias are mostly reasonable and thoughtfully addressed."):Cell("Possible problems with analysis or potential bias are somewhat reasonable and addressed."):Cell("Possible problems with analysis or potential bias are not addressed.")
    end

    private action WrapUp0Minutes
        Section("Wrap up (0 Minutes)")
        Paragraph("There will be no wrap up today. Allow the full time for students to work on their projects")
    end

    private action StandardsAlignment
        Section("Standards Alignment")
        BulletList()
        ListItem():Strong("CSTA K-12 Computer Science Standards (2017): "):Text("3A-DA-11, 3B-DA-05, 3B-DA-06")
    end
end
