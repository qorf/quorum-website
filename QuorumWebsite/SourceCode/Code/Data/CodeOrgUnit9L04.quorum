use Libraries.Web.Page.QuorumPage

/*
    Data - Lesson 4: Exploring Two Columns.
    Converted from the old Lesson page by plan 13's generator: the same
    words, now without Tailwind.
*/
class CodeOrgUnit9L04 is QuorumPage

    on create
        SetLocation("lessons/code/Data/Lesson4.html")
        // The name lists and links use, and the series and track it belongs
        // to: its section and picture.
        SetShortTitle("Exploring Two Columns")
        SetSectionName("Data")
        // For search engines and link previews, and what lists of pages say.
        SetDescription("This lesson tackles cross tabs, scatterplots, and generally looking at two-column data.")
        SetSummary("explore innovations in everyday life")
    end

    action Setup
        SetWebPageTitle("Exploring Two Columns")
        Title("Data - Lesson 4: Exploring Two Columns")
        Overview()
        Activity30Mins()
        WrapUp10Minutes()
        AssessmentCheckForUnderstanding()
        StandardsAlignment()
    end

    private action Overview
        Section("Overview")
        Paragraph("Students will practice making conclusions from charts and learn to use Quorum Studio for two different kinds of charts, a cross tab, and a scatterplot. Students will practice reading each type of chart before learning to make them. Students will track their work using a provided activity guide. The lesson concludes with a review of key takeaways.")
        Subsection("Goals")
        Paragraph("Students will be able to:")
        BulletList()
        ListItem("Create a crosstab and scatter charts in Quorum Studio")
        ListItem("Draw conclusions by reading crosstab and scatter charts")
        ListItem("Explain the reasons that someone would create either a crosstab and scatter chart in order to explore two columns of data")
        Subsection("Purpose")
        Paragraph("This lesson introduces students to two new ways of make visualizations. The crosstab and scatter chart are new in that they allow students to see patterns across multiple variables, noticing how one might seem to change (or correlate) with another. This is good preparation for their unit project in which they'll need to make and interpret a data visualization of their own.")
        Subsection("Goals")
        BulletList()
        ListItem():Link("CSP-Widgets repository", "https://github.com/qorf/CSP-Widgets")
        ListItem():Link("Teachers: CSP Unit 9 - Data", "https://docs.google.com/presentation/d/1MhiMuy55XgoRgKCTk6vS_ZXoCVH_Qr2soOVBuipc3eU/copy")
        ListItem():Link("Students: Exploring Two Columns Activity Guide", "https://docs.google.com/document/d/12GkfXmELZiGPppfigSKRlgbPuizaYpXniW0lAFu8A08/edit")
        Subsection("Preparation")
        Paragraph("Review how to make crosstab and scatter charts in Quorum Studio")
    end

    private action Activity30Mins
        Section("Activity (30 mins)")
        Subsection("Reading Crosstab Charts")
        Paragraph():Strong("Discuss: "):Text("How many 'Herding' breeds live a maximum of 12 years? What is the most common maximum life span for 'Working' breeds? Which breed group lives the shortest? Which breed group lives the longest? How do you know? How confident are you in your answers?")
        Paragraph():Strong("Do This: "):Text("Run a short discussion and help students read the chart together. They will hopefully note the following:")
        BulletList()
        ListItem("4 herding breeds live a maximum of 12 years")
        ListItem("The most common maximum lifespan of working breeds is 12 years")
        ListItem("Toy breeds seem to live the longest")
        ListItem("Working breeds seem to be the shortest")
        ListItem("Students can see the spread of life expectancies for different breeds but it's not cut and dry.")
        TeachingTip()
        Paragraph():Strong("Understanding Crosstab: "):Text("Understanding Crosstab: Give students some time to think and discuss why a crosstab chart might be a good choice for finding patterns like the ones indicated on this slide. Further reinforce the fact that if either column has too many values you may end up with an enormous chart.")
        EndCallout()
        Paragraph():Strong("Display: "):Text("Open the file LifeVsBreed.csv, which is in the folder Lesson4_App1 in Excel or another spreadsheet program. Examine this to introduce cross tab charts and how they work.")
        Subsection("Making Crosstab Charts")
        Paragraph():Strong("Distribute: "):Text("Give students access to "):Link("Exploring Two Columns - Activity Guide", "https://docs.google.com/document/d/12GkfXmELZiGPppfigSKRlgbPuizaYpXniW0lAFu8A08/edit")
        TeachingTip()
        Paragraph():Strong("Fill Out the Activity Guide Digitally: "):Text("We can access data in many different ways. Code.org's Data Visualizer is one, but using Quorum to output a Crosstab to a file, and opening it in Microsoft Excel, is another.")
        EndCallout()
        Paragraph():Strong("Do This: "):Text("Have students go to the Lesson4_App1 in the Unit9 folder of the CSP Widgets and use both the 'Words' and the 'Favorite Classes' data sets to complete page 1 of the Activity Guide.")
        Paragraph():Strong("Discuss: "):Text("Optionally have students share their progress and discuss the conclusions they reached on side one of the activity guide.")
        Subsection("Reading Scatter Charts")
        Paragraph("Have students go to the Lesson4_App2 in the Unit9 folder of the CSP Widgets. This app generates an accessible scatter plot related to when states were admitted to the United States and their land mass in square miles.")
        Paragraph():Strong("Do This: "):Text("Is there a pattern? How can you tell?")
        Paragraph():Strong("Discuss: "):Text("Have students share whether they think there's pattern between the order in which states were admitted and their size.")
        DiscussionGoal()
        Paragraph():Strong("Goal: "):Text("Students will hopefully notice later states are relatively larger than earlier added ones. The trend does not necessarily reflect any causation, but there is a slight uptick in state size as more are added.")
        EndCallout()
        Paragraph():Strong("Display: "):Text("Have students run the code in Lesson4_App2 and examine the chart produced.")
        Subsection("Making Scatter Charts")
        Paragraph():Strong("Do This: "):Text("Have students fill in page 2 of their activity guides practicing making scatter charts.")
        Paragraph():Strong("Discuss: "):Text("Have students share our their responses and talk through their conclusions.")
    end

    private action WrapUp10Minutes
        Section("Wrap up (10 Minutes)")
        Paragraph("The key takeaway is that the Data Analysis process has four key steps. First, we collect or choose the data. Second, we clean and filter it. Third, we try to find patterns in the data, through creating charts or using statistics. Finally, we try to find new information.")
        Paragraph("For charts, we decide how to create them via the information we know about the data and by thinking about what we want to learn. For example, if we have 1 column of numerical data, we might use a bar chart or a histogram to view it. If we have two columns, cross tabs can be useful if we have strings and few items, while scatterplots can be useful if we have a lot of numerical data.")
        BulletList()
        ListItem("Students know a lot of different ways to find patterns in data")
        ListItem("Review the chart showing how the can decide the type of chart to create")
        ListItem("Have students record key takeaways in their journal")
    end

    private action AssessmentCheckForUnderstanding
        Section("Assessment: Check for Understanding")
        Subsection("For Students")
        Paragraph("Open a word doc or google doc and copy/paste the following question.")
        Subsection("Question")
        Paragraph("How are the questions you can investigate with scatter or crosstab charts different from the ones you can investigate with bar charts or histograms?")
    end

    private action StandardsAlignment
        Section("Standards Alignment")
        BulletList()
        ListItem():Strong("CSTA K-12 Computer Science Standards (2017) "):Text("3A-DA-11, 3B-DA-05, 3B-DA-06")
        ListItem():Strong("CSP2021: "):Text("DAT-2.E.4, DAT-2.E.5")
    end
end
