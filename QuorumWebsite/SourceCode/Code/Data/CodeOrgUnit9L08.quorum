use Libraries.Web.Page.QuorumPage

/*
    Data - Lesson 8: Tell a Data Story Part 2.
    Converted from the old Lesson page by plan 13's generator: the same
    words, now without Tailwind.
*/
class CodeOrgUnit9L08 is QuorumPage

    on create
        SetLocation("lessons/code/Data/Lesson8.html")
        // The name lists and links use, and the series and track it belongs
        // to: its section and picture.
        SetShortTitle("Tell a Data Story Part 2")
        SetSectionName("Data")
        // For search engines and link previews, and what lists of pages say.
        SetSummary("explore innovations in everyday life")
    end

    action Setup
        SetWebPageTitle("Tell a Data Story Part 2")
        Title("Data - Lesson 8: Tell a Data Story Part 2")
        Overview()
        Activity35Mins()
        WrapUp10Minutes()
        AssessmentProject()
        StandardsAlignment()
    end

    private action Overview
        Section("Overview")
        Paragraph("This is the second day of a project where students use the Data Analysis Process to tell a data story. Students complete the second page of the Activity Guide for this project during this lesson.")
        Subsection("Goals")
        Paragraph("Students will be able to:")
        BulletList()
        ListItem("Follow the Data Analysis Process to tell a data story")
        ListItem("Explain information in a visualization")
        ListItem("Describes new insights or decisions that can be made based on a visualization")
        ListItem("Recognize and explain potential bias in a dataset or interpretation")
        Subsection("Purpose")
        Paragraph("The goal of this lesson is for students to put into use all of the data analysis skills they have practiced throughout this unit.")
        Subsection("Resources")
        Subsubsection("Supplimental Code.org material")
        BulletList()
        ListItem():Link("CSP U9 Project Guide - Tell a Data Story", "https://docs.google.com/document/d/1my-xp5mA5le05dcPp7kVawrK0-68flRifUZcqCRjltA/edit?usp=sharing")
    end

    private action Activity35Mins
        Section("Activity (35 mins)")
        Paragraph():Strong("Do This:"):Text(" Students work on Page 2 of the Project Guide that covers the "):DoubleQuote():Text("New Information"):DoubleQuote():Text(" step of the Data Analysis Process. Encourage students to be thorough in their answers. If they are struggling to answer the prompts, they may want to reconsider their Data Description.")
        BulletList()
        ListItem("What information does your data description show: What new insights or decisions can be made based on this determination of data? & What are the possible problems with your analysis including potential bias in the dataset or your interpretation?")
    end

    private action WrapUp10Minutes
        Section("Wrap up (10 Minutes)")
        Paragraph():Strong("Review:"):Text(" Review the rubric found in the previous lesson.")
        Paragraph():Strong("Do This:"):Text(" Collected completed Project Guides from students.")
    end

    private action AssessmentProject
        Section("Assessment: Project")
        Paragraph("Assess using the rubric on the previous lesson or on final page of the Project Guide.")
    end

    private action StandardsAlignment
        Section("Standards Alignment")
        BulletList()
        ListItem():Strong("CSTA K-12 Computer Science Standards (2017): "):Text("3A-DA-11, 3B-DA-05, 3B-DA-06")
    end
end
