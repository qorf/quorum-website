use Libraries.Web.Page.QuorumPage

/*
    Data - Lesson 5: Big, Open, Crowdsourced Data.
    Converted from the old Lesson page by plan 13's generator: the same
    words, now without Tailwind.
*/
class CodeOrgUnit9L05 is QuorumPage

    on create
        SetLocation("lessons/code/Data/Lesson5.html")
        // The name lists and links use, and the series and track it belongs
        // to: its section and picture.
        SetShortTitle("Big, Open, and Crowdsourced Data")
        SetSectionName("Data")
        // For search engines and link previews, and what lists of pages say.
        SetDescription("This lesson describes using big, open, and crowdsourced data.")
        SetSummary("explore innovations in everyday life")
    end

    action Setup
        SetWebPageTitle("Big, Open, and Crowdsourced Data")
        Title("Data - Lesson 5: Big, Open, Crowdsourced Data")
        Overview()
        Activity30Mins()
        WrapUp5Minutes()
        AssessmentCheckForUnderstanding()
        StandardsAlignment()
    end

    private action Overview
        Section("Overview")
        Paragraph("Students will complete a jigsaw of three different topics at the intersection of data, computing, and global impacts. These are topics, big data, crowdsourcing, and open data. Students will watch videos or listen to audio recordings about the different topics. Groups will each complete an activity guide about their topic before having individuals from each group share out their findings. The lesson concludes with a review of key points.")
        Subsection("Goals")
        Paragraph("Students will be able to:")
        BulletList()
        ListItem("Define and explain the impacts of crowdsourcing, crowdfunding, and citizen science")
        ListItem("Explain why in some contexts large amounts of data need to be analyzed in parallel and scalable systems")
        ListItem("Explain the impact of open data on scientific research and discovery")
        Subsection("Purpose")
        Paragraph("This lesson zooms back out from the data analysis process to the ways that is applied in a wide variety of contexts. Students learn how big data, open data, and crowdsourcing apply this process in interesting ways that cleverly modify this process. For a summary of key points of this lesson review the key takeaways in the slides. In short however:")
        BulletList()
        ListItem("Big data: "):DoubleQuote():Text("Collect huge amounts of data so we can learn even more from it"):DoubleQuote()
        ListItem("Open data: "):DoubleQuote():Text("sharing data with others so they can can analyze it"):DoubleQuote()
        ListItem("Crowdsourcing: "):DoubleQuote():Text("collecting data from others so you can analyze it"):DoubleQuote()
        Paragraph("This lesson further builds towards the following lesson on machine learning which explores a different application of the data analysis process.")
        Subsection("Resources")
        BulletList()
        ListItem():Link("Teachers: CSP Unit 9 - Data", "https://docs.google.com/presentation/d/1MhiMuy55XgoRgKCTk6vS_ZXoCVH_Qr2soOVBuipc3eU/copy")
        ListItem():Link("Big, Open, and Crowdsourced Data Activity Guide", "https://docs.google.com/document/d/11MgQaSrHA9FgQuXpasyEuO5zSDVLxiCZFU6uoz5Hy6A/edit")
    end

    private action Activity30Mins
        Section("Activity (30 mins)")
        Paragraph():Strong("Group:"):Text(" Place students in pairs")
        TeachingTip()
        Paragraph():Strong("Complete the Activity Digitally: "):Text("Students will have a much easier time accessing articles and videos if they complete the activity digitally. Digital activities can be more accessible.")
        Paragraph():Strong("Supporting the Jigsaw: "):Text("In this lesson students do a jigsaw of a number of different topics. Students will need access to computers and should spend roughly 10 minutes in each group listening to audio / video content. During this period circulate the room encouraging them to focus on the questions they've been asked to respond to. This will also help you anticipate or even specifically ask different students to participate during the discussion.")
        EndCallout()
        Paragraph():Strong("Distribute:"):Text(" Give each pair a copy of the Big, Open, and Crowdsourced Data - Activity Guide")
        Paragraph():Strong("Prompt:"):Text(" With a partner Choose one of the topics Watch the related videos / listen to the podcasts * Take notes and be ready to share responses to the questions on your activity guide")
        Paragraph():Strong("Discuss:"):Text(" Have members from each topic share the conclusions from their watching and research. Make sure that students from each group have time to share")
        Subsection("Vocabulary List")
        BulletList()
        ListItem("Scalability")
        ListItem("Parallel Systems")
        ListItem("Citizen Science")
        ListItem("Crowdsource")
        ListItem("Open Data")
        ListItem("Open Access")
        Subsection("Tasks to Complete")
        Paragraph("Take some time to review the terms from the vocabulary list and be prepared to take notes regarding these subjects.")
        BulletList()
        ListItem("What the topic is")
        ListItem("The key vocabulary they were responsible for researching in the vocab list above")
        ListItem("How this concept uses or modifies the data analysis process")
        ListItem("Examples of the problems this technique is being used to solve")
        Subsection("Video Links")
        BulletList()
        ListItem():Link("AI and Parallel Systems", "https://www.youtube.com/watch?v=1XGo8K1boH4")
        ListItem():Link("Big Data and Medicine", "https://www.youtube.com/watch?v=bMrDHtGHFR4")
        ListItem():Link("How Pokemon Inspired A Citizen Science Project", "https://www.npr.org/2018/04/20/597972310")
        ListItem():Link("What is Citizen Science?", "https://youtu.be/81hhecI0p5k")
        ListItem():Link("What is Open Data?", "https://www.youtube.com/watch?v=qSD9ob8rGcs")
        ListItem():Link("The Case for Open Data", "https://www.youtube.com/watch?v=iOrPK7p2AwI")
    end

    private action WrapUp5Minutes
        Section("Wrap up (5 Minutes)")
        Paragraph("Review the key takeaways")
        Subsection("Open Data")
        BulletList()
        ListItem("Sharing data with others so they can can analyze it")
        ListItem("Open data is publicly available data shared by governments, organizations, and others")
        ListItem("Making data open help spread useful knowledge or creates opportunities for others to use it to solve problems")
        Subsection("Citizen Science and Crowdsourcing")
        BulletList()
        ListItem("Collecting data from others so you can analyze it")
        ListItem("Crowdsourcing is the practice of obtaining input or information from a large number of people via the Internet.")
        ListItem("Citizen science is research where some of the data collection is done by members of the public using own computing devices which leads to solving scientific problems")
        ListItem("Crowdsourcing offers new models for collaboration, such as connecting businesses or social causes with funding")
        ListItem("Both are examples of how human capabilities can be enhanced by collaboration via computing")
        Subsection("Big Data")
        BulletList()
        ListItem("Collect huge amounts of data so we can learn even more from it")
        ListItem("The size of the datasets we analyzed impacts how much information can be extracted")
        ListItem("As a result, in business, science, and many other contexts people are working with increasingly big data sets")
        ListItem("When data gets too big it can no longer be processed on one computer. Cloud computing or parallel systems are sometimes used to help process all that information.")
        ListItem("In general scalability of your system is important to consider when working with big data. You want your system to be able to work even as you're using more and more data.")
    end

    private action AssessmentCheckForUnderstanding
        Section("Assessment: Check for Understanding")
        Subsection("For Teachers")
        Paragraph():Strong("Assess: "):Text("You can collect and evaluate students' activity guides.")
    end

    private action StandardsAlignment
        Section("Standards Alignment")
        BulletList()
        ListItem():Strong("CSTA K-12 Computer Science Standards (2017): "):Text("3A-DA-10")
        ListItem():Strong("CSP2021: "):Text("DAT-2.C.6, DAT-2.C.7, DAT-2.C.8")
        ListItem():Strong("CSP2021: "):Text("IOC-1.E.1, IOC-1.E.2, IOC-1.E.3, IOC-1.E.4, IOC-1.E.5, IOC-1.E.6")
    end
end
