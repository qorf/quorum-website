use Libraries.Web.Page.QuorumPage

/*
    Data - Lesson 2: Exploring One Column.
    Converted from the old Lesson page by plan 13's generator: the same
    words, now without Tailwind.
*/
class CodeOrgUnit9L02 is QuorumPage

    on create
        SetLocation("lessons/code/Data/Lesson2.html")
        // The name lists and links use, and the series and track it belongs
        // to: its section and picture.
        SetShortTitle("Exploring One Column")
        SetSectionName("Data")
        // For search engines and link previews, and what lists of pages say.
        SetSummary("explore innovations in everyday life")
    end

    action Setup
        SetWebPageTitle("Exploring One Column")
        Title("Data - Lesson 2: Exploring One Column")
        Overview()
        GettingStarted5Minutes()
        Activity30Mins()
        WrapUp5Minutes()
        AssessmentCheckForUnderstanding()
        StandardsAlignment()
    end

    private action Overview
        Section("Overview")
        Paragraph("Students will practice making conclusions from charts and learn to use the Accessible Data Science Libraries in Quorum to create two different kinds of charts: 1) a bar chart, and 2) a histogram. The lesson begins with a quick prompt to review the reasons charts are useful for looking at data. Students then practice reading a bar chart and review the kinds of questions it is and is not useful for answering. Afterwards they build different bar charts in Quorum and discuss why some are or are not useful. Afterwards they learn how to make histograms for building charts in instances where bar charts may not be useful. Students record their work on an activity guide. The lesson concludes with a brief review of what they learned.")
        Subsection("Goals")
        Paragraph("Students will be able to:")
        BulletList()
        ListItem("Create a bar chart and a histogram in Quorum")
        ListItem("Draw conclusions by reading bar charts and histograms")
        ListItem("Explain the reasons that someone would create either a bar chart or a histogram in order to explore a single column of data")
        Subsection("Purpose")
        Paragraph("This lesson introduces students to using Quorum to make Charts as well as two important chart types, a bar chart, and a histogram. Students will build skills in using this tool and reading data that they will continue to develop throughout the unit.")
        Paragraph("In the Wrap Up of this lesson students are introduced to the Data Analysis Process, a set of steps that can be used to use data to answer questions. Students will continue to refer to this process throughout the remainder of the unit.")
        Subsection("Resources")
        BulletList()
        ListItem():Link("CSP-Widgets repository", "https://github.com/qorf/CSP-Widgets")
        ListItem():Link("Teacher Presentation: CSP Unit 9 - Data", "https://docs.google.com/presentation/d/1MhiMuy55XgoRgKCTk6vS_ZXoCVH_Qr2soOVBuipc3eU/copy")
        ListItem():Link("Student Activity Guide: Exploring One Column", "https://docs.google.com/document/d/11X6ythWM_CSVlE0XrqrMAfHK63QMS8VCysCUiuIfQjw/edit")
        Subsection("Preparation")
        Paragraph("Try using Quorum to make some of the charts students will create as part of completing the lesson")
    end

    private action GettingStarted5Minutes
        Section("Getting Started (5 minutes)")
        Paragraph():Strong("Discuss:"):Text(" Why do people make charts out of data?")
        Paragraph():Strong("Prompt:"):Text(" Have students brainstorm silently on their own, then have them share with neighbors, and finally have them share out with the room.")
        DiscussionGoal()
        Paragraph():Strong("Goal:"):Text(" This discussion should be a quick prompt to kick off today's activity. Students spent the previous class making charts and looking at data sets, but they didn't think about how to make charts with the data. Try to quickly guide conversation towards some of the takeaways, then move on to the day's activity.")
        EndCallout()
        Subsection("Remarks")
        BulletList()
        ListItem("When looking at the datasets, the table format may be familiar to you. You may have seen data layed out and organized in a spreadsheet. Once the data is organized, we can now find trends and patterns. This is where visualizations are useful!")
        ListItem("People make visualizations for a number of reasons. They help humans see lots of data at once and help us find patterns that might otherwise be 'invisible.' Today we're going to learn how to make two new types of charts.")
        Paragraph():Strong("Display:"):Text(" Display the slide showing the Data Analysis Process. Students will continue to refer to this throughout the unit, including at the end of today's lesson. Simply make students aware of it as a framework and then quickly move on to the main activity.")
    end

    private action Activity30Mins
        Section("Activity (30 mins)")
        Subsection("Reading a Bar Chart")
        Paragraph():Strong("Prompt:"):Text(" Load Lesson2_App1 and run it. This will provide a visual and accessible version of the chart in the code.org slides. Which of these questions does this chart answer? Be ready to discuss with a classmate.")
        Paragraph():Strong("Discuss:"):Text(" Run a short discussion, asking students to share which of the five questions they believe could be answered with the chart. Students should hopefully notice:")
        BulletList()
        ListItem("Only question 1 and 3 could be answered by the chart")
        ListItem("They may have additional questions about how the chart was created or what it means. Hold those questions for the following slide")
        Paragraph():Strong("Display:"):Text(" What information can we get out of bar charts?")
        BulletList()
        ListItem("What value(s) are most common in this column?")
        ListItem("What value(s) are least common in this column?")
        ListItem("What is the unique list of values in this column?")
        Subsection("Making Bar Charts")
        Paragraph():Strong("Distribute:"):Text(" Give students access to Exploring One Column - Activity Guide, ideally in digital form.")
        TeachingTip()
        Paragraph():Strong("Fill Out the Activity Guide Digitally:"):Text(" Charts can allows students to quickly copy and paste visuals into documents and slide shows. However, whenever we do this, for accessibility, we want to provide alternative descriptions for the charts as a bare minimum. If at all possible in your classroom environment, have students complete this activity guide programmatically using Quorum charts so it is accessible to all.")
        EndCallout()
        Paragraph():Strong("Do This:"):Text(" Have students use Quorum charts and recreate the chart they just examined together. This can be modified how they wish using the Lesson2_App1 project as a guide. Use this as an opportunity to make sure every student understands how to use it. Change the columns displayed in the bar chart and navigate them accessibly using a screen reader.")
        Paragraph():Strong("Do This:"):Text(" Have students complete side one of the activity guide, making a bar chart for each column in the Dogs table and deciding if it is useful or not. They will also need to paste in one chart they find is useful and answer a pair of prompts. They can do this by taking a screen shot of the chart. Have students additionally write a small alternative description for the chart.")
        Paragraph():Strong("Discuss:"):Text(" Optionally discuss the different columns that students chose as useful.")
        DiscussionGoal()
        Paragraph():Strong("Goal:"):Text(" Use this discussion for two purposes. First, use it to build a shared comfort with what a bar chart shows. Have students share out which charts they think are useful and what pieces of information they read from them. Remind students that bar charts are particularly good at finding how common a value is in a column. The second goal is to prepare students to see the value of a histogram. Many bar charts are not at all useful because they have too many unique values. Using a histogram to group these values can help make more useful charts.")
        EndCallout()
        Subsection("Reading a Histogram")
        Paragraph():Strong("Display:"):Text(" Show the slide explaining why some bar charts are not useful.")
        Paragraph():Strong("Prompt:"):Text(" In Quorum, change project Lesson2_App1 to make a Histogram for 'Maximum Weight' with a Bucket Size of 20. This can be done by modifying the Histogram(5) action to have the value of 20 in it instead.")
        BulletList()
        ListItem("Which of these makes it easier to understand the data?")
        ListItem("What do you think the 'histogram' is doing to visualize the data differently?")
        Paragraph():Strong("Discuss:"):Text(" Discuss how the histogram seems to be displaying the data differently from the bar chart.")
        DiscussionGoal()
        Paragraph():Strong("Goal:"):Text(" Use this discussion to start exploring the differences between a bar chart and a histogram. For example, students should note that there seem to be 'fewer but wider' bars in the histogram. They should also notice that values are sorted correctly. This makes the chart overall easier to read.")
        EndCallout()
        Paragraph():Strong("Display:"):Text(" Show the slide explaining what a histogram is useful for")
        Paragraph():Strong("Prompt:"):Text(" Have students complete side 2 of their activity guide.")
        Paragraph():Strong("Discuss:"):Text(" Optionally have students share out the results of their work on side 2 of the activity guide.")
        DiscussionGoal()
        Paragraph():Strong("Goal:"):Text(" Use this discussion to have students share out how they are designing histograms based on the columns in the dogs data set. Things to look for:")
        BulletList()
        ListItem("Students are only creating histograms for numeric columns")
        ListItem("Students are picking columns that have a number of unique values")
        ListItem("Students are picking good bucket sizes to group their data in a way that makes it possible to interpret")
        ListItem("Students are correctly reading charts to understand what they are showing")
        EndCallout()
        DiscussionGoal()
        Paragraph():Strong("Goal:"):Text(" This is the first opportunity for students to talk through the Data Analysis Process, a framework they will return to many times throughout this course. Use this discussion to review some key points")
        BulletList()
        ListItem("Students in today's lesson may not have "):DoubleQuote():Text("cleaned and processed"):DoubleQuote():Text(" data but they should've seen every other step.")
        ListItem("Students answered questions and carefully made conclusions")
        ListItem("Students created visualization and used them to find patterns.")
        ListItem("Students chose the datasets that would best answer their question. In other instances they might've gone off to find the data themselves but the Data Library in the CSP-Widgets repository helps avoid them needing to do that. Another great source is data.gov.")
        EndCallout()
    end

    private action WrapUp5Minutes
        Section("Wrap up (5 Minutes)")
        Paragraph():Strong("Discuss:"):Text(" Which steps of the Data Analysis Process did you see in today's activity? Where did you see them?")
        Paragraph():Strong("Discuss:"):Text(" Have students share their reflections and lead a quick discussion about where they saw each step.")
        Paragraph():Strong("Review:"):Text(" Review the key takeaways from the lesson")
        BulletList()
        ListItem("Programs can help process data so we can understand it and learn.")
        ListItem("Charts and other visualizations can help both find and communicate what we've learned from data")
        ListItem("Bar charts and histograms are two common chart types for exploring one column of data in a table.")
    end

    private action AssessmentCheckForUnderstanding
        Section("Assessment: Check for Understanding")
        Subsection("For Students")
        Paragraph("Open a word doc or google doc and copy/paste the following question.")
        Subsection("Question")
        Paragraph("Why would someone make a histogram instead of a bar chart?")
    end

    private action StandardsAlignment
        Section("Standards Alignment")
        BulletList()
        ListItem():Strong("CSTA K-12 Computer Science Standards (2017) "):Text("3A-DA-11, 3B-DA-05, 3B-DA-06")
        ListItem():Strong("CSP2021: "):Text("DAT-2.D.1, DAT-2.D.2, DAT-2.D.5, DAT-2.D.6")
    end
end
