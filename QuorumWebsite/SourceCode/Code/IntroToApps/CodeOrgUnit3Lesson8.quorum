use Libraries.Web.Page.QuorumPage

/*
    Intro to Programming - Lesson 8: Designing an App Part 3.
    Converted from the old Lesson page by plan 13's generator: the same
    words, now without Tailwind.
*/
class CodeOrgUnit3Lesson8 is QuorumPage

    on create
        SetLocation("lessons/code/Algorithm-Programming/Lesson8.html")
        // The name lists and links use, and the series and track it belongs
        // to: its section and picture.
        SetShortTitle("Project - Designing an App Part 3")
        SetSectionName("Intro to App Design")
        // For search engines and link previews, and what lists of pages say.
        SetDescription("Use pair programming to write code and develop your app")
        SetSummary("Continue designing your app")
    end

    action Setup
        SetWebPageTitle("Unit 3 Lesson 8: Project - Designing an App Part 3")
        Title("Intro to Programming - Lesson 8: Designing an App Part 3")
        Overview()
        GettingStarted5Minutes()
        Activity35Minutes()
        WrapUp5Minutes()
        StandardsAlignment()
    end

    private action Overview
        Section("Overview")
        Paragraph("Students learn about Pair Programming by watching a video and then practicing it themselves while working on their project apps. At this stage, students are adding their first lines of code to make their app interactive using debugging skills from the previous lesson.")
        Subsection("Goals")
        Paragraph("Students will be able to:")
        BulletList()
        ListItem("Effectively use pair programming while designing the features of an app")
        ListItem("Create the code and user interface of an app based on a program specification")
        Subsection("Purpose")
        Paragraph("Pair Programming is an effective collaboration strategy both inside the classroom and in professional settings. As this is the first opportunity students have to program starting from a blank screen, this is a good opportunity to explore the usefulness of Pair Programming.")
        Subsection("Resources")
        Paragraph("For the students")
        BulletList()
        ListItem():Link("App Development Planning Guide", "https://docs.google.com/document/d/1JXIaQGRKzsw9UvZh58yLfkriV2QH7fTE51Omr8OJ1aM/edit?usp=sharing")
        ListItem():Link("Pair Programming - Video", "https://youtu.be/q7d_JtyCq1A")
    end

    private action GettingStarted5Minutes
        Section("Getting Started (5 minutes)")
        Paragraph():Strong("Important context for teachers:"):Text(" Students will continue to work on adding behavior and code to their app in following lessons, specifically Lessons 9 and 10. We recommend you take a look at Lessons 9 and 10 as well when you are preparing for this lesson to get an idea of where students should be at the end of this lesson and what tasks and activities take place during future lessons.")
        Subsection("What makes a good partner?")
        Paragraph():Strong("Prompt:"):Text(" What makes a good partner?")
        DiscussionGoal()
        Paragraph("Make this a quick discussion and just aim to get a few ideas from around the room. For example, a good partner...")
        EndCallout()
        BulletList()
        ListItem("listens")
        ListItem("contributes")
        ListItem("shares the work evenly")
        ListItem("and so on...")
        Subsubsection("Remarks")
        BulletList()
        ListItem("Now you've got the skills you'll need for your project, but we'll need a minute to talk about how to use them when working in teams. Today you're mostly going to have work time, but you're going to be practicing a new skill called pair programming.")
    end

    private action Activity35Minutes
        Section("Activity (35 minutes)")
        Paragraph():Strong("Group:"):Text(" Place students in pairs with their project partner")
        TeachingTip()
        Paragraph():Strong("Taking on the Blank Screen:"):Text(" This is the first time students are adding interactive code without an existing base to build from. Some students may need assistance. Direct them back to their Planning Guides to help students understand the events they need to code in their project.")
        Paragraph():Strong("Supporting Pair Programming:"):Text(" Your biggest role in supporting pair programming will be encouraging students to use it early on and helping enforce the switching. Run the timer in the slides and have left and right partners switch roles. You may opt to increase the time to longer periods as time goes on.")
        Paragraph():Strong("Debugging Practices:"):Text(" Students learned a lot of debugging practices in the previous lesson. Encourage students to use these and record bugs they find as they program today. Continue to normalize and celebrate debugging as a normal and fun part of programming.")
        EndCallout()
        Paragraph():Strong("Do This:"):Text(" List all of the Event Handlers in their programs. They should be able to determine these based on the Program Specification they designed. Include the element ID, action, and explain what happens.")
        Paragraph():Strong("Display:"):Text(" Play the "):Link("Pair Programming video", "https://youtu.be/q7d_JtyCq1A"):Text(". Then, review the two roles in pair programming:")
        BulletList()
        ListItem():Strong("The Driver"):Text(" manipulates the keyboard and the mouse.")
        ListItem():Strong("The Navigator"):Text(" keeps track of the big picture and guides towards the goal.")
        Video("https://www.youtube.com/embed/q7d_JtyCq1A?si=E3NIjS7kBH1dY6do", "Pair Programming")
        Subsection("Remarks")
        BulletList()
        ListItem("Today we're going to use the pair programming as you work on your app with your partner. To begin we'll make the partner sitting on the left the driver and the one on the right the navigator. Every few minutes I'll ask you to switch roles.")
        Paragraph():Strong("Project:"):Text(" Students work on their projects. Remind them of the requirements for the app:")
        BulletList()
        ListItem("Uses at least three pages")
        ListItem("Includes examples of images, audio, and text")
        ListItem("A clear and easy to navigate user interface")
        ListItem("Clearly communicates information about your topic")
        ListItem("Code is cleanly written and free of errors")
        Paragraph():Strong("Circulate:"):Text(" Give students time to work on their project. As they do so circulate the room encouraging them to use debugging practices they've learned in previous lessons. Every few minutes ask left and right partners to switch being drivers and navigators.")
    end

    private action WrapUp5Minutes
        Section("Wrap up (5 Minutes)")
        Paragraph():Strong("Discuss:"):Text(" How does Pair Programming help when working on a project? How does it help with the debugging process in particular?")
        DiscussionGoal()
        Paragraph("Use this prompt to reinforce not only the value of pair programming and collaboration while programming, but also to remind students of debugging practices they learned in the previous lesson. Possible answers include:")
        BulletList()
        ListItem("Talking through my code with another person helps me figure out what to do")
        ListItem("When I get stuck, there's someone there to help brainstorm a solution")
        ListItem("There's more than one set of eyes to find bugs")
        ListItem("Different partners bring different perspectives to a project")
        EndCallout()
        Subsection("Journal")
        Paragraph("Have students add "):DoubleQuote():Text("Pair Programming"):DoubleQuote():Text(" to their journals.")
        BulletList()
        ListItem():Emphasis("Pair Programming"):Text(": a collaborative programming style in which two programmers switch between the roles of writing code and tracking or planning high level progress")
    end

    private action StandardsAlignment
        Section("Standards Alignment")
        BulletList()
        ListItem():Strong("CSTA K-12 Computer Science Standards (2017): "):Text("3A-AP-16, 3A-AP-19, 3A-AP-21, 3A-AP-22, 3A-AP-23")
        ListItem():Strong("CSTA K-12 Computer Science Standards (2021): "):Text("CRD-1.B.2")
    end
end
