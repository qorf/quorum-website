use Libraries.Web.Page.QuorumPage

/*
    Intro to App Design - Lesson 7: Debugging.
    Converted from the old Lesson page by plan 13's generator: the same
    words, now without Tailwind.
*/
class CodeOrgUnit3Lesson7 is QuorumPage
    // A double quote, for code and words that hold one.
    text dq = ""

    on create
        SetLocation("lessons/code/Algorithm-Programming/Lesson7.html")
        // The name lists and links use, and the series and track it belongs
        // to: its section and picture.
        SetShortTitle("Debugging")
        SetSectionName("Intro to App Design")
        // For search engines and link previews, and what lists of pages say.
        SetDescription("Explore and practice debugging techniques")
        SetSummary("Learn about debugging")
    end

    action Setup
        dq = dq:GetDoubleQuote()
        SetWebPageTitle("Unit 3 Lesson 7: Debugging")
        Title("Intro to App Design - Lesson 7: Debugging")
        Overview()
        GettingStarted5Minutes()
        Activity30Minutes()
        WrapUp10Minutes()
        AssessmentCheckForUnderstanding()
        StandardsAlignment()
    end

    private action Overview
        Section("Overview")
        Paragraph("In this lesson students practice using the different programming concepts that they were introduced to in the last lesson. To begin, however, they are introduced to the concept of debugging and are encouraged to use and reflect on this practice throughout the lesson. At the end of the lesson students share their experiences debugging as well as an new realizations about programming.")
        Subsection("Goals")
        Paragraph("Students will be able to:")
        BulletList()
        ListItem("Debug simple sequential and event-driven programs")
        ListItem("Use the debugging process and Identify specific best practices for debugging programs")
        Subsection("Purpose")
        Paragraph("This lesson serves a number of roles. Even if students had modified programs in the previous lesson, this continues to be an introduction to many of the skills of programming. Students are also introduced to debugging as a skill they'll need to use and develop as programmers. A huge goal of this lesson, however, is attitudinal.")
        Subsection("Resources")
        Paragraph("For the students")
        BulletList()
        ListItem():Link("How to Debug - Video", "https://youtu.be/auv10y-dN4s")
        ListItem():Link("CSP-Widgets Repository", "https://github.com/qorf/CSP-Widgets")
    end

    private action GettingStarted5Minutes
        Section("Getting Started (5 minutes)")
        Paragraph():Strong("Discuss:"):Text(" Your friend calls you and says "):DoubleQuote():Text("I can't get music to come out of my speakers, can you help?"):DoubleQuote():Text(" Write a quick list of everything you'd ask them or have them check to try to fix the problem.")
        Paragraph():Strong("Optional Warmup Discussion:"):Text(" This discussional is optional and included for instances where you need a warm up prompt on the board when students walk in. If your classroom is able to move directly to main activity you should feel free to skip this prompt in the interest of time.")
        DiscussionGoal()
        Paragraph("This discussion should help get students in the mindset of debugging. If students ask for more details tell them that this is all the information they have and that they should work with what they know-- or figure out what questions they could use to learn more information about the problem.")
        EndCallout()
        Subsection("Remarks")
        BulletList()
        ListItem("Today we're going to practice programming, but we're also going to practice a very important skill in programming called "):DoubleQuote():Text("debugging"):DoubleQuote():Text(". Let's see what it looks like.")
    end

    private action Activity30Minutes
        Section("Activity (30 minutes)")
        Subsection("Understanding the Debugging Process")
        Paragraph():Strong("Display:"):Text(" Show the"):Text(" "):Link("How to Debug Video", "https://youtu.be/auv10y-dN4s"):Text(". Then, share the 4 steps of the debugging process:")
        Video("https://www.youtube.com/embed/auv10y-dN4s?si=O-_JPNqkV9PlDtzo", "How To Debug")
        NumberedList()
        ListItem():Strong("Describe the Problem")
        NestedBulletList()
        ListItem("- What do you expect it to do?")
        ListItem("- What does it actually do?")
        ListItem("- Does it always happen?")
        EndNestedList()
        ListItem():Strong("Hunt for Bugs")
        NestedBulletList()
        ListItem("- What do you expect it to do?")
        ListItem("- What does it actually do?")
        ListItem("- Does it always happen?")
        EndNestedList()
        ListItem():Strong("Try Solutions")
        NestedBulletList()
        ListItem("- What do you expect it to do?")
        ListItem("- What does it actually do?")
        ListItem("- Does it always happen?")
        EndNestedList()
        ListItem():Strong("Document as You Go")
        NestedBulletList()
        ListItem("- What do you expect it to do?")
        ListItem("- What does it actually do?")
        ListItem("- Does it always happen?")
        EndNestedList()
        Subsubsection("Remarks")
        BulletList()
        ListItem("We're going to use this process to help us fix programs. I want you to use this process as you fix issues you find in code today. At the end of the lesson we'll talk more about this process and any specific strategies you document along the way.")
        Subsection("Practice Time")
        Paragraph():Strong("Group:"):Text(" Place students in pairs.")
        Subsubsection("App #1")
        Paragraph():Strong("Open a Project:"):Text(" Have students open the "):Strong(dq + "Lesson7_App1" + dq):Text(" project. In the SourceCode folder, students should open "):DoubleQuote():Text("Main.quorum"):DoubleQuote():Text(".")
        Paragraph():Strong("Activity:"):Text(" There's an error in the code that stops this code from running. Students should debug this program by fixing the error.")
        Subsubsection("App #2")
        Paragraph():Strong("Open a Project:"):Text(" Have students open the "):Strong(dq + "Lesson7_App2" + dq):Text(" project. In the SourceCode folder, students should open "):DoubleQuote():Text("Main.quorum"):DoubleQuote():Text(".")
        Paragraph():Strong("Activity:"):Text(" This program also doesn't run. Debug the program.")
        Subsubsection("App #3")
        Paragraph():Strong("Open a Project:"):Text(" Have students open the "):Strong(dq + "Lesson7_App3" + dq):Text(" project. In the SourceCode folder, students should open "):DoubleQuote():Text("Main.quorum"):DoubleQuote():Text(".")
        Paragraph():Strong("Activity:"):Text(" Run this app to see how it works. Then debug the program to use the correct sound and text when the user selects each animal button.")
        Subsubsection("App #4")
        Paragraph():Strong("Open a Project:"):Text(" Have students open the "):Strong(dq + "Lesson7_App4" + dq):Text(" project. In the SourceCode folder, students should open "):DoubleQuote():Text("Main.quorum"):DoubleQuote():Text(".")
        Paragraph():Strong("Activity:"):Text(" Run this program to see how it works. Then debug the program so that the smiley face doesn't go off the screen when the user uses either the mouse or keyboard.")
        Subsubsection("App #5")
        Paragraph():Strong("Open a Project:"):Text(" Have students open the "):Strong(dq + "Lesson7_App5" + dq):Text(" project. In the SourceCode folder, students should open "):DoubleQuote():Text("Main.quorum"):DoubleQuote():Text(".")
        Paragraph():Strong("Activity:"):Text(" Run this program to see how it works. Then add code to the program so that the "):DoubleQuote():Text("Go Back"):DoubleQuote():Text(" button takes the user back to the home page.")
        Subsubsection("App #6")
        Paragraph():Strong("Open a Project:"):Text(" Have students open the "):Strong(dq + "Lesson7_App6" + dq):Text(" project. In the SourceCode folder, students should open "):DoubleQuote():Text("Main.quorum"):DoubleQuote():Text(".")
        Paragraph():Strong("Activity:"):Text(" Run this program to see how it works. Then add code to the app to make the "):DoubleQuote():Text("Excited"):DoubleQuote():Text(" button work.")
        BulletList()
        ListItem("Pick a song, image, and text to show when the button is selected")
        ListItem("Change the color of the "):DoubleQuote():Text("Excited"):DoubleQuote():Text(" button when it's selected, and change the other buttons to their original colors")
        ListItem("You can use the code for the other buttons for ideas on how to write the code")
    end

    private action WrapUp10Minutes
        Section("Wrap up (10 Minutes)")
        Paragraph():Strong("Discuss:"):Text(" If you were using the debugging process then you should have some notes of good debugging tips. Share those with your neighbor and add any new ones you forgot to add. Be ready to share with the class.")
        DiscussionGoal()
        Paragraph("This discussion should help reinforce the fact that debugging is a skill that can be learned and that it is made up of many little steps and understandings. Give the room an opportunity to share as many ideas as they can before sharing the recommended steps.")
        EndCallout()
        Paragraph():Strong("Do This:"):Text(" Share these best practices in addition to those students may have mentioned:")
        BulletList()
        ListItem():Strong("Keep your code clean")
        NestedBulletList()
        ListItem("- User clear, meaningful IDs for your elements")
        ListItem("- Keep your code organized in chunks that do the same thing")
        ListItem("- Use comments to explain your code")
        EndNestedList()
        ListItem():Strong("Run your code")
        NestedBulletList()
        ListItem("- Run your code a lot, every time you add a command or two")
        ListItem("- Use output statements throughout your code to get feedback on what parts are running.")
        EndNestedList()
        ListItem():Strong("Use classmates and resources")
        NestedBulletList()
        ListItem("- Talk out the problems with a partner or classmate")
        ListItem("- Compare your code to examples that you know work")
        ListItem("- Read documentation to know how code is supposed to work")
        ListItem("- Hand trace your code to track what's happening")
        EndNestedList()
        Subsection("Remarks")
        BulletList()
        ListItem("Debugging is an important and entirely normal part of programming. Your code won't always work the first time, and that's OK! Debugging is a skill that you can practice and get better at. Using documentation and leaving comments for yourself are important skills, but so is working with classmates or learning to more effectively search for bugs. We'll keep using these skills.")
        Subsection("Journal")
        Paragraph("Have students add the following vocabulary words and definitions to their journals:")
        BulletList()
        ListItem():Emphasis("Documentation:"):Text(" a written description of how a command or piece of code works or was developed")
        ListItem():Emphasis("Comment:"):Text(" Form of program documentation written into the program to be read by people and which do not affect how a program runs.")
        BulletList()
        ListItem("Let's take a minute to talk more about comments and documentation. Comments help explain the code, but do not affect how the program runs. They are meant to be read by people! When we write code, we don't only write for the computer we also write for other people. It's important that others can understand our code, so write your code clearly using the practices we discussed and comments.")
        ListItem("Not all programming environments support comments, so other forms of documentation may be important like keeping a separate document with information about your program. The key takeaway here, is no matter what the format, comments and documentation are important!")
        ListItem("As you grow in your programming skills, you will start to appreciate how valuable comments can be. You don't have to wait until a program is complete to write the comments. You should be doing this as you develop the project. There will be opportunities to write comments in the App project you are currently working on.")
    end

    private action AssessmentCheckForUnderstanding
        Section("Assessment: Check for Understanding")
        Subsection("For Students")
        Paragraph("Open a word doc or google doc and copy/paste the following question.")
        Subsection("Question 1")
        Paragraph("What is one thing you really enjoyed about today's activity?")
        Subsection("Question 2")
        Paragraph("Is there anything that you found confusing or need extra help with?")
    end

    private action StandardsAlignment
        Section("Standards Alignment")
        BulletList()
        ListItem():Strong("CSTA K-12 Computer Science Standards (2017): "):Text("3A-CS-03")
        ListItem():Strong("CSP2021: "):Text("CRD-2.G.1, CRD-2.G.2, CRD-2.G.3, CRD-2.G.4, CRD-2.G.5")
        ListItem():Strong("CSP2021: "):Text("CRD-2.I.5")
    end
end
