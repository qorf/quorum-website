use Libraries.Web.Page.QuorumPage

/*
    Intro to App Design - Lesson 2: Introduction to Interface Design.
    Converted from the old Lesson page by plan 13's generator: the same
    words, now without Tailwind.
*/
class CodeOrgUnit3Lesson2 is QuorumPage
    // A double quote, for code and words that hold one.
    text dq = ""

    on create
        SetLocation("lessons/code/Algorithm-Programming/Lesson2.html")
        // The name lists and links use, and the series and track it belongs
        // to: its section and picture.
        SetShortTitle("Introduction to Interface Design")
        SetSectionName("Intro to App Design")
        // For search engines and link previews, and what lists of pages say.
        SetDescription("Explore how a user interface is designed")
        SetSummary("Learn about interface design")
    end

    action Setup
        dq = dq:GetDoubleQuote()
        SetWebPageTitle("Unit 3 Lesson 2: Introduction to Interface Design")
        Title("Intro to App Design - Lesson 2: Introduction to Interface Design")
        Overview()
        GettingStarted5Minutes()
        Activity30Minutes()
        WrapUp10Minutes()
        AssessmentCheckForUnderstanding()
        StandardsAlignment()
    end

    private action Overview
        Section("Overview")
        Paragraph("Students work through a progression of levels to build an understanding of how to layout an app. The final challenge has students setting up the screen of an app by attempting to copy an image of an app.")
        Subsection("Goals")
        Paragraph("Students will be able to:")
        BulletList()
        ListItem("Use meaningful names for element ids")
        ListItem("Set up the User Interface of an app including buttons, text, and images")
        Subsection("Purpose")
        Paragraph("This lesson introduces students to the code used to build apps, as well as the different kinds of screen elements and properties at their disposal. This lesson not only builds up skills in designing a user interface but also sets students up to begin designing an app of their own in the following lesson.")
        Subsection("Resources")
        BulletList()
        ListItem():Link("Getting Started with CSP Widgets", "https://quorumlanguage.com/lessons/code/CodeOrgWidgetTutorial.html")
        ListItem():Link("CSP-Widgets Repository", "https://github.com/qorf/CSP-Widgets")
    end

    private action GettingStarted5Minutes
        Section("Getting Started (5 minutes)")
        Paragraph():Strong("Discuss:"):Text(" What is a common app that you use? Take a minute to sketch the User Interface of the main screen. Note how the user interacts with the app.")
        TeachingTip()
        Paragraph("Students who are blind or visually impaired may not be able to sketch a user interface, but they can still engage with the core lesson. Emphasize the question of how users interact with the app. What kind of elements does the user interact with? How do they move between them? Have students describe or list the process of using the app.")
        EndCallout()
        Paragraph():Strong("Do This:"):Text(" Compare your sketch with a partner and discuss common elements that both of your apps share.")
        DiscussionGoal()
        Paragraph("This prompt is designed to bring out students' prior experiences working with apps. If students aren't sure what app to choose, you can even ask them to pick a website, such as")
        Paragraph():Link("Code.org", "https://code.org/"):Text(". This discussion can pull out the fact that most apps contain images, buttons, and text that help users find and interact with information and content.")
        EndCallout()
        Subsection("Remarks")
        BulletList()
        ListItem("Yesterday we took a look at a few different apps and talked about input and output. We also discussed the User Interface. Today we are going to learn how to build a user interface ourselves.")
    end

    private action Activity30Minutes
        Section("Activity (30 minutes)")
        Subsection("Running the Challenges")
        Paragraph("For today's activity, students will use a number of apps from the "):Link("CSP-Widgets Repository", "https://github.com/qorf/CSP-Widgets"):Text(". Unlike the previous lesson, this time students will inspect and modify the code of the apps. Each app is a carefully scaffolded challenge that teaches a small portion of the overall tools that will be used later.")
        Paragraph("For full instructions on downloading and running the apps, including downloading the Quorum Studio environment, see the "):Link("Getting Started with CSP Widgets", "https://quorumlanguage.com/lessons/code/CodeOrgWidgetTutorial.html"):Text(" help page.")
        Subsection("Challenge #1: Review an App")
        Paragraph():Strong("Open a Project:"):Text(" Have students open the "):Strong(dq + "Lesson2_App1" + dq):Text(" project. In the SourceCode folder, students should open "):DoubleQuote():Text("Main.quorum"):DoubleQuote():Text(".")
        Paragraph():Strong("Challenge:"):Text(" This project is one of the apps from the last lesson. This time, we'll explore the code. Spend some time looking around and change some of the properties.")
        Paragraph():Strong("Discuss:"):Text(" After the students have had some time to explore, pull the class back together to discuss their findings. What did they discover? Was there anything they found interesting or wanted to know more about?")
        Paragraph():Strong("Discussion Goals:"):Text(" There's lots of code in the app, and students won't understand all of it yet. When discussing their observations, here's a few things they might notice:")
        BulletList()
        ListItem("The app is organized into pages, where different elements are put into different pages.")
        ListItem("Each element has different properties that can be changed depending on the type of element. For example, a label element supports text, icons need to be loaded from images, etc.")
        ListItem("Other properties are available on every element, like SetName or SetPixelX.")
        Subsection("Challenge #2: Changing App Properties")
        Paragraph():Strong("Open a Project:"):Text(" Have students open the "):Strong(dq + "Lesson2_App2" + dq):Text(" project. In the SourceCode folder, students should open "):DoubleQuote():Text("Main.quorum"):DoubleQuote():Text(".")
        Paragraph():Strong("Challenge:"):Text(" Read the comments (the grayed out text) in the code starting on line 17. Then follow the instructions to change some of the app's properties.")
        Subsection("Challenge #3: Changing Colors")
        Paragraph():Strong("Open a Project:"):Text(" Have students open the "):Strong(dq + "Lesson2_App3" + dq):Text(" project. In the SourceCode folder, students should open "):DoubleQuote():Text("Main.quorum"):DoubleQuote():Text(".")
        Paragraph():Strong("Challenge:"):Text(" Read the directions beginning on line 22 in the code. Then follow the instructions to change the colors of the components in the app.")
        Subsection("Challenge #4: Using Custom Assets")
        Paragraph():Strong("Open a Project:"):Text(" Have students open the "):Strong(dq + "Lesson2_App4" + dq):Text(" project. In the SourceCode folder, students should open "):DoubleQuote():Text("Main.quorum"):DoubleQuote():Text(".")
        Paragraph():Strong("Challenge:"):Text(" Read the instructions on line 7. Then, upload a custom image into the app by following the instructions on line 26, or upload a custom sound by following the instructions on line 48.")
        Subsection("Challenge #5: Making and Positioning Elements")
        Paragraph():Strong("Open a Project:"):Text(" Have students open the "):Strong(dq + "Lesson2_App5" + dq):Text(" project. In the SourceCode folder, students should open "):DoubleQuote():Text("Main.quorum"):DoubleQuote():Text(".")
        Paragraph():Strong("Challenge:"):Text(" Follow the instructions on line 39 to update the properties of an icon in the app. Then follow the instructions on line 64 to create a brand new icon and set its properties.")
        Subsection("Challenge #6: Setting Useful Names and Descriptions")
        Paragraph():Strong("Open a Project:"):Text(" Have students open the "):Strong(dq + "Lesson2_App6" + dq):Text(" project. In the SourceCode folder, students should open "):DoubleQuote():Text("Main.quorum"):DoubleQuote():Text(".")
        Paragraph():Strong("Challenge:"):Text(" Read the instructions on line 25. Then, change the name of each item in the app, and set meaningful descriptions on the icons.")
        Subsection("Challenge #7: Putting it Together -- Recreate an App")
        Paragraph():Strong("Open a Project:"):Text(" Have students open the "):Strong(dq + "Lesson2_App7" + dq):Text(" project. In the SourceCode folder, students should open "):DoubleQuote():Text("Main.quorum"):DoubleQuote():Text(".")
        Paragraph():Strong("Challenge:"):Text(" Now that we've spent some time exploring how these apps work, it's time to build one from scratch. Read the instructions starting on line 33. Then, using the comments and everything you've learned so far, create an app that looks like this picture.")
        Image("media/lessons/csp/unit3/Unit3-2_Example_App.png", "A picture of an example app. It has a light blue background, and a dark blue banner at the top. There is a label on top of the banner which reads ")
        TeachingTip()
        Paragraph():Strong("Looking Back:"):Text(" If students are having trouble putting together the code for this challenge, encourage them to reference the code in the previous challenges. Understanding how to copy and modify existing code is a useful tool for students and professionals alike!")
        Paragraph():Strong("Teaching Accessibly:"):Text(" For blind students, rather than using the picture to recreate the app, you can have them build off of the "):DoubleQuote():Text("feature list"):DoubleQuote():Text(" on line 45 of the app template. Alternatively, you can have all of the students work from the feature list without seeing the picture -- students' apps will look different when they're done, which can make for an interesting point of discussion later.")
        EndCallout()
    end

    private action WrapUp10Minutes
        Section("Wrap up (10 Minutes)")
        Paragraph():Strong("Discuss:"):Text(" Have students answer the following:")
        BulletList()
        ListItem("What elements collect input?")
        ListItem("What elements display output?")
        ListItem("Do you think there are elements that can do both?")
    end

    private action AssessmentCheckForUnderstanding
        Section("Assessment: Check for Understanding")
        Subsection("For Students")
        Paragraph("Open a word doc or google doc and copy/paste the following question.")
        Subsection("Question")
        Paragraph("Why is it important for element IDs to have meaningful names?")
    end

    private action StandardsAlignment
        Section("Standards Alignment")
        BulletList()
        ListItem():Strong("CSTA K-12 Computer Science Standards (2017): "):Text("3A-AP-16")
    end
end
