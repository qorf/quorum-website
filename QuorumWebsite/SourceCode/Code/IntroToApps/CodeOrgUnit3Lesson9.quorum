use Libraries.Web.Page.QuorumPage

/*
    Intro to App Design - Lesson 9: Project - Designing an App Part 4.
    Converted from the old Lesson page by plan 13's generator: the same
    words, now without Tailwind.
*/
class CodeOrgUnit3Lesson9 is QuorumPage

    on create
        SetLocation("lessons/code/Algorithm-Programming/Lesson9.html")
        // The name lists and links use, and the series and track it belongs
        // to: its section and picture.
        SetShortTitle("Project - Designing an App Part 4")
        SetSectionName("Intro to App Design")
        // For search engines and link previews, and what lists of pages say.
        SetDescription("Learn how loops and random numbers work, and how to use them in the 
                Quorum Programming Language")
        SetSummary("Learn about Loops and Random Numbers")
    end

    action Setup
        SetWebPageTitle("Unit 3 Programming Lesson 9: Project - Designing an App Part 4")
        Title("Intro to App Design - Lesson 9: Project - Designing an App Part 4")
        Overview()
        GettingStarted5Minutes()
        Activity30Minutes()
        WrapUp10Minutes()
        StandardsAlignment()
    end

    private action Overview
        Section("Overview")
        Paragraph("Students continue working on their apps. Halfway through class the focus of the lesson shifts to getting feedback. Students watch other groups test their apps and collect feedback that will be used to make updates.")
        Subsection("Goals")
        Paragraph("Students will be able to:")
        BulletList()
        ListItem("Test an app's functionality by attempting to use features and behavior described in a program specification")
        ListItem("Provide effective feedback on the functionality or usability of an app")
        ListItem("Iteratively improve an app based on feedback")
        Subsection("Purpose")
        Paragraph("This lesson reinforces the importance of feedback in the process of developing software. Feedback and testing help make sure that an app actually works for lots of people and in the context in which it will be used. This process also reinforces the importance of making iterative improvements in making software.")
        Subsection("Resources")
        Paragraph("For the students")
        BulletList()
        ListItem():Link("App Development Planning Guide", "https://docs.google.com/document/d/1JXIaQGRKzsw9UvZh58yLfkriV2QH7fTE51Omr8OJ1aM/edit?usp=sharing")
    end

    private action GettingStarted5Minutes
        Section("Getting Started (5 minutes)")
        Paragraph():Strong("Prompt:"):Text(" Think of times when you've received helpful feedback on school work, a hobby, or a sport.")
        BulletList()
        ListItem("What makes good feedback?")
        ListItem("What makes bad feedback?")
        DiscussionGoal()
        Paragraph("This is an optional prompt if your class situation requires it. If you believe your students need more time to work on their apps then move right into work time. This prompt, however is designed to get students thinking early about the differences between useful and unhelpful feedback. For example, students may note that...")
        BulletList()
        ListItem("Good feedback:")
        NestedBulletList()
        ListItem("- Specific information beyond "):DoubleQuote():Text("it's great"):DoubleQuote():Text(".")
        ListItem("- Explains why something needs work")
        EndNestedList()
        ListItem("Bad feedback:")
        NestedBulletList()
        ListItem("- Is overly negative without constructive feedback")
        ListItem("- Does not go into enough detail")
        EndNestedList()
        EndCallout()
        Subsection("Remarks")
        BulletList()
        ListItem("Today we're going to keep working on our apps, but we're also going to be getting feedback from our classmates. Let's get to it!")
    end

    private action Activity30Minutes
        Section("Activity (30 minutes)")
        Paragraph():Strong("Group:"):Text(" Place students back in pairs with their project partners.")
        Subsection("Work Time")
        BulletList()
        ListItem("For the next twenty five minutes, you and your partner will use Pair Programming to continue working on your app. After this is done, you will get feedback from another group.")
        TeachingTip()
        Paragraph():Strong("Review Pair Programming:"):Text(" You may want to review the Pair Programming roles from the previous lesson before students begin working.")
        Paragraph():Strong("Encourage Debugging Practices:"):Text(" Continue to encourage students to use the debugging practices they learned in previous lessons and normalize and celebrate debugging as a part of programming.")
        EndCallout()
        Paragraph():Strong("Circulate:"):Text(" Direct students to continue working on their apps.")
        Subsection("Testing and Feedback (10 minutes)")
        Paragraph():Strong("Do This:"):Text(" Groups swap apps and gather feedback. It is ok to move ahead to this section even if students are not done with their apps yet.")
        Paragraph("Here's what you should observe:")
        BulletList()
        ListItem("Group A lets Group B test their app.")
        ListItem("Group A watches Group B use the app, and writes down improvements that come to mind.")
        ListItem("Group A interviews Group B asking for specific improvements Group A can make. This may be different than what Group A came up with during the observation.")
        ListItem("Group A and B swap and now Group A tests Group B's app while Group B watches.")
        ListItem("After this, mix up the group pairings and repeat the steps above.")
        Image("media/lessons/csp/unit3/Unit3-9_Student_Feedback.png", "A sketch showing Group A observing Group B using their app, then the two groups switching.")
    end

    private action WrapUp10Minutes
        Section("Wrap up (10 Minutes)")
        BulletList()
        ListItem("Now return to your stations and pick at least one improvement to make to your app based on feedback. Write this down in the Planning Guide in Step 7.")
        Paragraph():Strong("Discuss:"):Text(" Why is it important to get feedback from others while building your app? What is the value of getting this feedback even if you aren't finished with your app?")
        DiscussionGoal()
        Paragraph():Strong("Discussion Goal:"):Text(" Use this prompt as time allows. The goal is to reinforce the importance of feedback in the development of good software. Possible answers include:")
        BulletList()
        ListItem("Another person may find a bug that you have been overlooking")
        ListItem("Something that seems obvious to you is not obvious to the user")
        ListItem("Even if the app isn't finished, feedback can help guide the next steps")
        EndCallout()
        Subsection("Remarks")
        BulletList()
        ListItem("Feedback and testing are important parts of making good software. They ensure that our apps actually work the way we designed them, and they help us make gradual improvements. Tomorrow you'll have a chance to make some final touches on your app before we submit them!")
    end

    private action StandardsAlignment
        Section("Standards Alignment")
        BulletList()
        ListItem():Strong("CSTA K-12 Computer Science Standards (2017): "):Text("3A-AP-16, 3A-AP-19, 3A-AP-21, 3A-AP-22, 3A-AP-23")
        ListItem():Strong("CSP2021: "):Text("CRD-1.A.5")
        ListItem():Strong("CSP2021: "):Text("CRD-1.B.1")
        ListItem():Strong("CSP2021: "):Text("CRD-2.E.3")
        ListItem():Strong("CSP2021: "):Text("CRD-2.J.1")
        ListItem():Strong("CSP2021: "):Text("CRD-2.J.3")
    end
end
