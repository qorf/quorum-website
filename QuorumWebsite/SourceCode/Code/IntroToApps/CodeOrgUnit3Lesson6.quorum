use Libraries.Web.Page.QuorumPage

/*
    Intro to App Design - Lesson 6: Intro to Programming.
    Converted from the old Lesson page by plan 13's generator: the same
    words, now without Tailwind.
*/
class CodeOrgUnit3Lesson6 is QuorumPage
    // A double quote, for code and words that hold one.
    text dq = ""

    on create
        SetLocation("lessons/code/Algorithm-Programming/Lesson6.html")
        // The name lists and links use, and the series and track it belongs
        // to: its section and picture.
        SetShortTitle("Intro to Programming")
        SetSectionName("Intro to App Design")
        // For search engines and link previews, and what lists of pages say.
        SetDescription("Learn to write actions and about top-down design in the Quorum Programming Language")
        SetSummary("Learn actions and top-down design")
    end

    action Setup
        dq = dq:GetDoubleQuote()
        SetWebPageTitle("Unit 3 Lesson 6: Intro to Programming")
        Title("Intro to App Design - Lesson 6: Intro to Programming")
        Overview()
        GettingStarted0Minutes()
        Activity30Minutes()
        WrapUp1Minute()
        AssessmentCheckForUnderstanding()
        StandardsAlignment()
    end

    private action Overview
        Section("Overview")
        Paragraph("Students use and modify a series of simple apps to get familiar with a small set of programming commands. They observe the way the code and compare programs that run all at once to those that respond to user actions like buttons selections. At the end of the lesson students discuss what they observed and are introduced to some key vocabulary for describing the running of programs.")
        Subsection("Goals")
        Paragraph("Students will be able to:")
        BulletList()
        ListItem("Define a program as a sequence of commands that are executed or run by a computer")
        ListItem("Explain the differences between how sequential and event-driven programs execute")
        ListItem("Define comments as notes or documentation into a program that do not affect how the program executes")
        Subsection("Purpose")
        Paragraph("This lesson is written in an Investigate style, a common format of lesson that will be used in the remainder of the programming units. In this kind of lesson students are encouraged to investigate working code and make simple modifications to understand how it works.")
        Paragraph("This lesson introduces a number of concepts and vocabulary around what programs are and how they run that will need to be reinforced in future lessons.")
        Subsection("Resources")
        BulletList()
        ListItem():Link("CSP-Widgets Repository", "https://github.com/qorf/CSP-Widgets")
    end

    private action GettingStarted0Minutes
        Section("Getting Started (0 minutes)")
        Subsection("Remarks")
        BulletList()
        ListItem("Yesterday we learned that we need to create a new kind of language, a programming language, in order to clearly communicate instructions. Today we're going to take a deeper look at what programming looks like, and we'll see different ways we can use these tools to communicate our instructions to a computer.")
        TeachingTip()
        Paragraph():Strong("Get to the Activity:"):Text(" There's a lot to do in this lesson. Get to the main activity as quickly as you can.")
        Paragraph():Strong("Prompt Ideas:"):Text(" If you need a prompt for when students come in consider asking them to list 2-3 differences between a natural language and programming language and why those differences need to exist.")
        EndCallout()
    end

    private action Activity30Minutes
        Section("Activity (30 minutes)")
        Paragraph():Strong("Group:"):Text(" Place students in pairs. One student per group should open the projects as they're needed for today's lesson, beginning with "):DoubleQuote():Text("Lesson6_App1"):DoubleQuote():Text(".")
        TeachingTip()
        Paragraph():Strong("Prepping for this lesson:"):Text(" The best way to prepare for this lesson is to go through the experience yourself. Check out each of the Lesson6 apps to get a sense for how they work. Then actually try to answer all the questions for each app.")
        Paragraph():Strong("Show code at the front:"):Text(" If your room allows it, display the code at the front of the room. When students mentions specific lines of code actually scroll to that line and read through it together.")
        Paragraph():Strong("Discuss specific lines of code:"):Text(" As you run discussions, model talking about programs by specifically calling out lines of code, as in "):DoubleQuote():Text("I can see that when the output code on line 2 runs, it produces a message in the console..."):DoubleQuote()
        Paragraph():Strong("Save modifications for the end:"):Text(" This lesson can be tight on time. Rather than have students modify the code all at once, you can save modifications for the end of the Code Investigation and have students pick a single app they wish to modify.")
        Paragraph():Strong("OK to Break Things:"):Text(" When using the widgets in earlier units it's not really possible to "):DoubleQuote():Text("break things"):DoubleQuote():Text(". That's a little different than how things work here where it is possible to write code that may not run at all. Encourage students that this is normal programming practice. It maybe a good idea to have students save a backup version or use some kind of version control.")
        EndCallout()
        Paragraph():Strong("Display:"):Text(" If possible in your room, display the projects at the front of the class.")
        Paragraph():Strong("Accessing the Projects:"):Text(" Just like earlier lessons, the apps for this lesson are available via the "):Link("CSP-Widgets Repository", "https://github.com/qorf/CSP-Widgets"):Text(". If you want a refresher on downloading and running the projects, check out the "):Link("Getting Started with CSP Widgets", "https://quorumlanguage.com/lessons/code/CodeOrgWidgetTutorial.html"):Text(" help page.")
        TeachingTip()
        Paragraph():Strong("SP Widget Guide:"):Text("Most activities using the CSP Widgets will require students to modify parts of the code. Navigate to the //START HERE comment in the code to find where to get started with the lesson. If a student needs to add code, they should do it after the //YOUR CODE GOES HERE comment in the code.")
        EndCallout()
        Subsection("App #1")
        Paragraph():Strong("Open a Project:"):Text(" Have students open the "):Strong(dq + "Lesson6_App1" + dq):Text(" project. In the SourceCode folder, students should open "):DoubleQuote():Text("Main.quorum"):DoubleQuote():Text(".")
        Paragraph():Strong("Activity:"):Text(" In their groups, students should do these tasks. Circulate the room making sure that pairs are actually discussing the prompt and are collaborating to modify the program. Once it seems all groups have had a chance to do this bring the class together.")
        NumberedList()
        ListItem():Strong("Run:"):Text(" Run the program to see what it does.")
        ListItem():Strong("Discuss:"):Text(" Why do you think some of the information is in quotes and some is not?")
        ListItem():Strong("Modify:"):Text(" Add two lines of code, one that displays a string and one that displays a number.")
        Paragraph():Strong("Discuss:"):Text(" Have students share the results of their discussions with the class. You do not need to use formal vocabulary yet, but make sure all students are seeing the same things.")
        Subsection("App #2")
        Paragraph():Strong("Open a Project:"):Text(" Have students open the "):Strong(dq + "Lesson6_App2" + dq):Text(" project. In the SourceCode folder, students should open "):DoubleQuote():Text("Main.quorum"):DoubleQuote():Text(".")
        Paragraph():Strong("Activity:"):Text(" Students should do these tasks in the same way as last time. Once students have completed all three prompts bring the class together for a discussion.")
        NumberedList()
        ListItem():Strong("Run:"):Text(" Run this program to see how it works.")
        ListItem():Strong("Discuss:"):Text(" With a neighbor discuss the differences between "):Code("SetScreenSize"):Text(" and "):Code("AddPage"):Text(". Be as specific as possible.")
        ListItem():Strong("Modify:"):Text(" Add one "):Code("output"):Text(" command and one button property changing command to this program. (The property changing command can be one of the commands already used in this program or a command that students learned while designing their project apps.)")
        Paragraph():Strong("Discuss:"):Text(" Have students share the results of their discussions with the class. You do not need to use formal vocabulary yet, but make sure all students are seeing the same things.")
        Subsection("App #3")
        Paragraph():Strong("Open a Project:"):Text(" Have students open the "):Strong(dq + "Lesson6_App3" + dq):Text(" project. In the SourceCode folder, students should open "):DoubleQuote():Text("Main.quorum"):DoubleQuote():Text(".")
        Paragraph():Strong("Activity:"):Text(" Have students complete these tasks, then bring the class together after a few minutes for another discussion.")
        NumberedList()
        ListItem():Strong("Run:"):Text(" Run the program to see how it works. Make sure you select the button on the screen.")
        ListItem():Strong("Discuss:"):Text(" How does the "):Code("ButtonActivated"):Text(" section of code work? Be as specific as possible.")
        ListItem():Strong("Discuss:"):Text(" How do commands inside "):Code("ButtonActivated"):Text(" run differently from commands in "):Code("Start"):Text("?")
        ListItem():Strong("Modify:"):Text(" Add one command inside "):Code("Start"):Text(" and one command inside "):Code("ButtonActivated"):Text(".")
        Paragraph():Strong("Discuss:"):Text(" Have students share the results of their discussions with the class. You do not need to use formal vocabulary yet, but make sure all students are seeing the same things.")
        Subsection("App #4")
        Paragraph():Strong("Open a Project:"):Text(" Have students open the "):Strong(dq + "Lesson6_App4" + dq):Text(" project. In the SourceCode folder, students should open "):DoubleQuote():Text("Main.quorum"):DoubleQuote():Text(".")
        Paragraph():Strong("Activity:"):Text(" Have students complete these tasks, and then bring the class together after a few minutes for a discussion.")
        NumberedList()
        ListItem():Strong("Run:"):Text(" Run this program to see how it works. Make sure you select both buttons.")
        ListItem():Strong("Discuss:"):Text(" How does the "):Code("PlaySound"):Text(" command work?")
        ListItem():Strong("Discuss:"):Text(" How do lines that start with "):Code("//"):Text(" run differently from the others")
        ListItem():Strong("Discuss:"):Text(" What's the difference between lines that start with "):Code("//"):Text(" and lines that are between "):Code("/*"):Text(" and "):Code("*/"):Text("?")
        ListItem():Strong("Modify:"):Text(" Add code so the dog button makes sound too.")
        ListItem():Strong("Modify:"):Text(" Change the messages when each button is selected.")
        Paragraph():Strong("Discuss:"):Text("Have students share the results of their discussions with the class. You do not need to use formal vocabulary yet, but make sure all students are seeing the same things.")
        Subsection("App #5")
        Paragraph():Strong("Open a Project:"):Text(" Have students open the "):Strong(dq + "Lesson6_App5" + dq):Text(" project. In the SourceCode folder, students should open "):DoubleQuote():Text("Main.quorum"):DoubleQuote():Text(".")
        Paragraph():Strong("Activity:"):Text(" Have students complete these tasks, and then bring the class together after a few minutes for a discussion.")
        NumberedList()
        ListItem():Strong("Run:"):Text(" Run this program to see how it works.")
        ListItem():Strong("Discuss:"):Text(" How do you think the "):Code("RandomNumber"):Text(" command works? Each time "):Code("RandomNumber"):Text(" runs, there's a possibility of a different result!")
        ListItem():Strong("Discuss:"):Text(" Why do the birds move even if they're not selected? Are there other options?")
        ListItem():Strong("Discuss:"):Text(" What happens when you press the space bar? Why does it happen?")
        ListItem():Strong("Modify:"):Text(" Make the birds move around the entire screen, not just the top left corner.")
        ListItem():Strong("Modify:"):Text(" Experiment with the other event actions besides "):Code("MousedOver"):Text(" and "):Code("KeyPressed"):Text(". Which ones still make the game work?")
        Paragraph():Strong("Discuss:"):Text(" Have students share the results of their discussions with the class. You do not need to use formal vocabulary yet, but make sure all students are seeing the same things.")
    end

    private action WrapUp1Minute
        Section("Wrap up (1 Minute)")
        Paragraph():Strong("Discuss:"):Text(" Think about your experiences today and in the previous lesson. How is a programming language different from natural language?")
        DiscussionGoal()
        Paragraph("Make this a quick discussion to help connect the previous lesson to this one. Help bring out some of the following points.")
        BulletList()
        ListItem("Programming languages are much more precise than natural language")
        ListItem("Programming languages have very strict rules")
        ListItem("Programming languages may feel a little awkward at first.")
        EndCallout()
        Subsection("Remarks")
        BulletList()
        ListItem("Awesome job! Today was our first chance to really explore what programming is like. So far we've only learned a few commands but we've already seen they'll let us make a wide variety of types of programs. We're going to get a lot more time to practice using them, but before we do let's get some vocabulary in your journal to make sure we're using the same words to talk about what we saw today.")
        Subsection("Journal")
        Paragraph("Go through each of these vocabulary words and give students a chance to record each piece of information:")
        BulletList()
        ListItem():Emphasis("Program Statement:"):Text(" A command or instruction. Sometimes also referred to as a code statement.")
        ListItem():Emphasis("Program:"):Text(" A collection of program statements. Programs run (or "):DoubleQuote():Text("execute"):DoubleQuote():Text(") one command at a time.")
        ListItem():Emphasis("Sequential Programming:"):Text(" A way for programs to run where statements run in order, from top to bottom. There is no user interaction and the code runs the same way every time.")
        ListItem():Emphasis("Event Driven Programming:"):Text(" Another way for program to run where some statements run when triggered by an event, like a mouse click or a key press. Programs run differently each time depending on user interactions.")
        TeachingTip()
        Paragraph():Strong("Reinforcing Vocabulary:"):Text(" A lot of the vocabulary introduced here is taken straight from the AP framework. The images are designed to help connect the definitions to the experiences they had in this lesson. Help students make these connections by not only writing down definitions but talking through how it's connected to what they saw.")
        EndCallout()
        BulletList()
        ListItem("Great job today! You've learned a lot so far about programs. It's important to remember that programs need to work for a variety of inputs and outputs. That's what makes programming interactive apps so fun! Today, you also learned how to describe the behavior of a program, or how the program works when it's run and how the user interacts with it.")
        ListItem("When we talk about how programs run, we can describe both what the program does and specifically how the program statements accomplish this goal.")
        ListItem("We're going to keep practicing using these words and going forward you're going to get more chance to practice programming. Start thinking about how you might want to use what you learned today in your project.")
    end

    private action AssessmentCheckForUnderstanding
        Section("Assessment: Check for Understanding")
        Subsection("For Students")
        Paragraph("Open a word doc or google doc and copy/paste the following question.")
        Subsection("Question")
        Paragraph("What is the difference between a sequential program and an event-driven program?")
    end

    private action StandardsAlignment
        Section("Standards Alignment")
        BulletList()
        ListItem():Strong("CSTA K-12 Computer Science Standards (2017): "):Text("3A-AP-16")
        ListItem():Strong("CSP 2021: "):Text("AAP-2.B.2, AAP-2.B.6")
        ListItem():Strong("CSP 2021: "):Text("AAP-3.E.2")
        ListItem():Strong("CSP 2021: "):Text("CRD-2.B.1, CRD-2.B.3, CRD-2.B.4, CRD-2.B.5")
        ListItem():Strong("CSP 2021: "):Text("CRD-2.C.2, CRD-2.C.3, CRD-2.C.5")
    end
end
