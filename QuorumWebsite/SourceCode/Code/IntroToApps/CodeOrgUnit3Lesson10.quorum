use Libraries.Web.Page.QuorumPage

/*
    Intro to App Design - Lesson 10: Project - Designing an App Part 5.
    Converted from the old Lesson page by plan 13's generator: the same
    words, now without Tailwind.
*/
class CodeOrgUnit3Lesson10 is QuorumPage

    on create
        SetLocation("lessons/code/Algorithm-Programming/Lesson10.html")
        // The name lists and links use, and the series and track it belongs
        // to: its section and picture.
        SetShortTitle("Project - Designing an App Part 5")
        SetSectionName("Intro to App Design")
        // For search engines and link previews, and what lists of pages say.
        SetDescription("Finish designing your apps and consider the steps you've taken along the way")
        SetSummary("Complete and submit your project")
    end

    action Setup
        SetWebPageTitle("Unit 3 Lesson 10: Project - Designing an App Part 5")
        Title("Intro to App Design - Lesson 10: Project - Designing an App Part 5")
        Overview()
        GettingStarted5Minutes()
        Activity30Minutes()
        WrapUp10Minutes()
        AssessmentProject()
        StandardsAlignment()
    end

    private action Overview
        Section("Overview")
        Paragraph("Students complete their apps, making any final adjustments based on feedback from their peers. Students spend some time reviewing other apps that classmates made and then complete a short set of reflection prompts before submitting their projects.")
        Subsection("Goals")
        Paragraph("Students will be able to:")
        BulletList()
        ListItem("Reflect on the value of different stages of a development process in creating an app")
        Subsection("Purpose")
        Paragraph("This lesson concludes the project students have been working on throughout the unit. Students will have a chance to respond to any feedback they received and incorporate that into their project. The reflection prompts in the activity help students synthesize their overall experience with a focus on how collaboration within their team and within their classroom impacted the final projects they designed.")
        Subsection("Resources")
        Paragraph("For the students")
        BulletList()
        ListItem():Link("App Development Planning Guide", "https://docs.google.com/document/d/1JXIaQGRKzsw9UvZh58yLfkriV2QH7fTE51Omr8OJ1aM/edit?usp=sharing")
    end

    private action GettingStarted5Minutes
        Section("Getting Started (5 minutes)")
        BulletList()
        ListItem("Your apps are almost done and soon will be ready to share with the world. Let's get back to work.")
        TeachingTip()
        Paragraph():Strong("Teaching Tip:"):Text(" Quickly move the class to the activity where the bulk of their time should be spent today.")
        EndCallout()
    end

    private action Activity30Minutes
        Section("Activity (30 minutes)")
        Paragraph():Strong("Group:"):Text(" Place students back in pairs with their project partner.")
        Subsection("Finish Building Apps")
        BulletList()
        ListItem("For the next thirty minutes, you and your partner will work on finishing your app. Don't forget to consider the suggestions your classmates made. Check the rubric before submitting your app.")
        Paragraph():Strong("Activity:"):Text(" Direct students to continue working on their app. When they are finished, they should submit it via a method you choose (e.g., email).")
        TeachingTip()
        Paragraph("If you choose to have students submit their projects via email, some email providers may try to block projects from being sent if they have executable files inside them. To avoid this, just before they submit their projects, you can have students "):DoubleQuote():Text("Clean"):DoubleQuote():Text(" their projects in Quorum Studio via the Run menu, or by right-clicking the project and selecting it from the pop-up menu. This will delete the executables so the project can be safely sent via email.")
        EndCallout()
    end

    private action WrapUp10Minutes
        Section("Wrap up (10 Minutes)")
        Paragraph():Strong("Reflection:"):Text(" Direct students to the Reflection Section in the Planning Guide. There are two questions for students to complete.")
        Paragraph():Strong("Submit Projects:"):Text(" Students should submit their final projects including both a link to the app and their planning guide.")
    end

    private action AssessmentProject
        Section("Assessment: Project")
        Paragraph("Use the rubric to assess student projects. The rubric can be found on the last page of the "):Link("App Development Planning Guide - Activity Guide.", "https://docs.google.com/document/d/1JXIaQGRKzsw9UvZh58yLfkriV2QH7fTE51Omr8OJ1aM/edit?usp=sharing")
    end

    private action StandardsAlignment
        Section("Standards Alignment")
        BulletList()
        ListItem():Strong("CSTA K-12 Computer Science Standards (2017): "):Text("3A-AP-16, 3A-AP-19, 3A-AP-21, 3A-AP-22, 3A-AP-23")
    end
end
