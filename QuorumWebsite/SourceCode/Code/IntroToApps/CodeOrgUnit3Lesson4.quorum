use Libraries.Web.Page.QuorumPage

/*
    Intro to App Design - Lesson 4: Project - Designing an App Part 2.
    Converted from the old Lesson page by plan 13's generator: the same
    words, now without Tailwind.
*/
class CodeOrgUnit3Lesson4 is QuorumPage
    // A double quote, for code and words that hold one.
    text dq = ""

    on create
        SetLocation("lessons/code/Algorithm-Programming/Lesson4.html")
        // The name lists and links use, and the series and track it belongs
        // to: its section and picture.
        SetShortTitle("Project - Designing an App Part 2")
        SetSectionName("Intro to App Design")
        // For search engines and link previews, and what lists of pages say.
        SetDescription("Continue designing an app by translating a prototype into code")
        SetSummary("Translate a prototype to code")
    end

    action Setup
        dq = dq:GetDoubleQuote()
        SetWebPageTitle("Unit 3 Lesson 4: Project - Designing an App Part 2")
        Title("Intro to App Design - Lesson 4: Project - Designing an App Part 2")
        Overview()
        GettingStarted5Minutes()
        Activity30Minutes()
        WrapUp5Minutes()
        AssessmentPlanningGuide()
        StandardsAlignment()
    end

    private action Overview
        Section("Overview")
        Paragraph("Students continue working on the unit projects in this lesson that is primarily designed to be work time. Students continue to follow the app development process outlined in their App Development Guide by transferring their user interfaces designs from their planning guides into code.")
        Subsection("Goals")
        Paragraph("Students will be able to:")
        BulletList()
        ListItem("Create a user interface based on a prototype")
        Subsection("Resources")
        Paragraph():Strong("Supplemental Code.org material")
        Paragraph("For the students")
        BulletList()
        ListItem():Link("App Development Planning Guide - Activity Guide", "https://docs.google.com/document/d/1JXIaQGRKzsw9UvZh58yLfkriV2QH7fTE51Omr8OJ1aM/edit?usp=sharing")
    end

    private action GettingStarted5Minutes
        Section("Getting Started (5 minutes)")
        TeachingTip()
        Paragraph():Strong("Important context for teachers:"):Text(" During this lesson students will only be using code to design the screens (or pages) of their app. Students will "):Strong("NOT"):Text(" be programming the interactive behavior of their app at this point.")
        Paragraph("The following three lessons (5,6, and 7) teach students how to use event handlers and debugging strategies. Then, in Lessons 8, 9, and 10, students will add responsive code to their app to make their ideas come to life! The purpose of this lesson, Lesson 4, is only to get the design of individual pages in place.")
        EndCallout()
        BulletList()
        ListItem("In the last lesson, you developed a prototype of an app with a partner. It's important to remember that other people will be using your app and need to understand how to use it!")
        Paragraph():Strong("Discuss:"):Text(" Why is it important to plan out the design of an app?")
        DiscussionGoal()
        BulletList()
        ListItem("Planning can save time so the developers don't spend time designing faulty user interfaces")
        ListItem("Planning can help the developers talk through and test out ideas with the users of the app")
        EndCallout()
    end

    private action Activity30Minutes
        Section("Activity (30 minutes)")
        Subsection("Remarks")
        BulletList()
        ListItem("The design you sketched out is a prototype of your app. A prototype helps you plan the looks and features of your app before you program it.")
        Paragraph():Strong("Open a Project:"):Text(" Have students open the "):Strong(dq + "Lesson3_SampleApp" + dq):Text(" project.")
        Paragraph():Strong("Display:"):Text(" Show students the prototype picture for the sample app. Have them compare the prototype to the finished app.")
        Image("media/lessons/csp/unit3/Unit3-3_App_Prototype.png", "A sketch featuring all 6 of the pages of the Bird Quiz sample app. Every page has every screen element from the app, and every button has flowchart-style arrows pointing to what screen the button takes you to.")
        TeachingTip()
        Paragraph("Students should explore the app and the prototype for a few minutes, noting how different elements are represented on the prototype.")
        Paragraph():Strong("Encourage Collaboration:"):Text(" Reinforce a collaborative classroom environment in which students share responsibilities for designing screens and discuss with one another the choices they're making. Students should be communicating their ideas with one another as they build.")
        Paragraph():Strong("Waiting for Programming:"):Text(" Some students may be eager to start programming their apps rather than simply build screens. Let students know that they'll be able to start programming their apps in the coming lessons and that the first half of the unit focuses more heavily on design.")
        Paragraph():Strong("Non-Visual Prototyping:"):Text(" While it's often convenient to sketch out a prototype, it can be useful to break it down into a non-visual representation. (This can be useful for any student, but it's especially important when teaching visually impaired students.) You could represent each page in the sketch as a list of components, where each component has a simple description or directions indicating what it does when you interact with it. You could deconstruct the prototype even more by putting specific values, like pixel coordinates, for each listed component. Students may notice that the more you break down the prototype, the more closely it resembles the code that produces the app.")
        EndCallout()
        Subsection("Explore the Prototype")
        BulletList()
        ListItem("After looking at this app and the prototype, you may want to make a few adjustments to your own prototypes. Take a few minutes to update your design.")
        ListItem("When you are finished, we'll open the project template where you will start creating your user interfaces!")
        Paragraph():Strong("Open a Project:"):Text(" Have students open the "):Strong(dq + "ProjectTemplate" + dq):Text(" project. (NOTE: Until pages are added you will get a compiler error if you try to compile in Quorum Studio)")
        Paragraph():Strong("Activity:"):Text(" Students will work on transferring their prototypes to pages in the project template. Partners can work together sharing a computer, or they can divide the pages between themselves and work individually. After they are done, the code for the individual screens can be copied into a single file to create a complete project.")
    end

    private action WrapUp5Minutes
        Section("Wrap up (5 Minutes)")
        Paragraph():Strong("Discuss:"):Text(" Were there any changes you had to make to your original design once you transferred it to a screen?")
        TeachingTip()
        Paragraph("The Wrap-up is short today to allow students the maximum amount of time to work on their apps.")
        Paragraph("Often times students will discover that their design is too complicated on paper and simplify it when they transfer it to the screen. This is ok! Sometimes the best designs are simple designs.")
        EndCallout()
    end

    private action AssessmentPlanningGuide
        Section("Assessment: Planning Guide")
        Paragraph("This is a good opportunity to look over student's work in the "):Link("App Development Planning Guide - Activity Guide", "https://docs.google.com/document/d/1JXIaQGRKzsw9UvZh58yLfkriV2QH7fTE51Omr8OJ1aM/edit?usp=sharing"):Text(" as a formative assessment.")
    end

    private action StandardsAlignment
        Section("Standards Alignment")
        BulletList()
        ListItem():Strong("CSTA K-12 Computer Science Standards (2017): "):Text("3A-AP-16, 3A-AP-19, 3A-AP-21, 3A-AP-22, 3A-AP-23")
    end
end
