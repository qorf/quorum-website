use Libraries.Web.Page.QuorumPage

/*
    Intro to App Design - Lesson 5: The Need for Programming Languages.
    Converted from the old Lesson page by plan 13's generator: the same
    words, now without Tailwind.
*/
class CodeOrgUnit3Lesson5 is QuorumPage

    on create
        SetLocation("lessons/code/Algorithm-Programming/Lesson5.html")
        // The name lists and links use, and the series and track it belongs
        // to: its section and picture.
        SetShortTitle("The Need for Programming Languages")
        SetSectionName("Intro to App Design")
        // For search engines and link previews, and what lists of pages say.
        SetDescription("Explore how natural languages can be ambiguous, and why we need different language for programming")
        SetSummary("Learn about why we need programming languages")
    end

    action Setup
        SetWebPageTitle("Unit 3 Lesson 5: The Need for Programming Languages")
        Title("Intro to App Design - Lesson 5: The Need for Programming Languages")
        Overview()
        GettingStarted5Minutes()
        Activity30Minutes()
        WrapUp10Minutes()
        AssessmentCheckForUnderstanding()
        StandardsAlignment()
    end

    private action Overview
        Section("Overview")
        Paragraph("In this lesson students explore the challenges of clearly communicating instructions. They build a small arrangement of blocks (e.g. LEGO™ pieces or paper cutouts) and then create text instructions a classmate could follow to construct the same arrangement. Groups then trade instructions to see if they were clear enough to allow reconstruction of the original arrangement. The wrap-up discussion is used to highlight the inherent ambiguities of human language and call out the need for the creation of a programming language which leaves no room for interpretation.")
        Subsection("Preparation")
        BulletList()
        ListItem("Prepare either a small set of LEGO™ blocks or paper cutouts for each pair of students")
        Subsection("Goals")
        Paragraph("Students will be able to:")
        BulletList()
        ListItem("Justify the existence of programming languages to precisely communicate instructions")
        ListItem("Explain the qualities that differentiate natural languages and programming languages")
        Subsection("Purpose")
        Paragraph("This lesson is students' first introduction to the concept of a programming language. It helps them understand why programming languages exist by giving them a first-hand experience with the problems that programming languages are designed to address. Natural language is usually too ambiguous for giving precise instructions that can be followed correctly 100% of the time. We need to create more structured and precise programming languages in order to accomplish this.")
    end

    private action GettingStarted5Minutes
        Section("Getting Started (5 minutes)")
        Subsection("Remarks")
        BulletList()
        ListItem("Today we're going to look at what it takes to write "):DoubleQuote():Text("good"):DoubleQuote():Text(" instructions. We all use instructions all the time, whether it's directions to get somewhere, instructions to fill out a form, or even instructions from teachers. To help us get started, let's brainstorm what "):DoubleQuote():Text("bad"):DoubleQuote():Text(" instructions look like.")
        Paragraph():Strong("Discuss:"):Text(" Write down three different reasons you would call a set of instructions "):DoubleQuote():Text("bad"):DoubleQuote():Text(". Be ready to share with a neighbor.")
        DiscussionGoal()
        Paragraph():Strong("Discussion Goal:"):Text(" Aim to hear a few different students share reasons that instructions are "):DoubleQuote():Text("bad"):DoubleQuote():Text(". The point here is just to get students thinking and there's no specific answer you're driving towards. Some possible ideas, however, might include:")
        BulletList()
        ListItem("Instructions are not clear on what to do")
        ListItem("Instructions use confusing words")
        ListItem("Instructions don't actually accomplish what they're supposed to")
        EndCallout()
        BulletList()
        ListItem("Alright, so we have an idea of what "):DoubleQuote():Text("bad"):DoubleQuote():Text(" instructions look like. Let's see if we can use this brainstorm to help us write good instructions in the next activity!")
    end

    private action Activity30Minutes
        Section("Activity (30 minutes)")
        Subsection("Remarks")
        Paragraph():Strong("Group:"):Text(" Place students in groups of two, optionally forming a group of three.")
        Paragraph():Strong("Distribute:"):Text(" Give each group a small set of blocks (either LEGO™ or paper cutouts). Also have each group use a blank sheet of paper or a blank page in a journal.")
        Subsection("Step 1: Design")
        Paragraph():Strong("Activity:"):Text(" Give students a couple minutes to create their design following these rules. (Keep this quick since the bigger focus should be on the instructions.)")
        NumberedList()
        ListItem("Put 5-6 pieces together")
        ListItem("All pieces must be connected")
        Subsection("Step 2: Record")
        Paragraph():Strong("Activity:"):Text(" Either have students sketch their design or take a picture. Make sure the image is on a separate piece of paper or the back side of a sheet of paper.")
        Subsection("Step 3: Write Instructions")
        Paragraph():Strong("Activity:"):Text(" This is the most important step and should be given about 5 minutes. Encourage students to be as clear as possible while only using words (no drawings, diagrams, or pictures). Encourage them to think about their brainstorm of "):DoubleQuote():Text("bad"):DoubleQuote():Text(" instructions this morning to see if it can inspire them to make "):DoubleQuote():Text("good"):DoubleQuote():Text(" ones.")
        Subsection("Step 4: Trade")
        Paragraph():Strong("Activity:"):Text(" Have students take apart their design, and then trade instructions with another group. Make sure they keep their recording of the design hidden.")
        Subsection("Step 5: Build")
        Paragraph():Strong("Activity:"):Text(" Give students 3 minutes to follow the instructions from another group.")
        Subsection("Step 6: Compare")
        Paragraph():Strong("Activity:"):Text(" Give students 2 minutes to compare what they built with the picture of the actual target. In their groups they should discuss what they think went wrong or anything they're surprised worked out.")
        Subsection("Step 7: Repeat")
        Paragraph():Strong("Activity:"):Text(" Depending on how much time you have, encourage students to trade with one or two other groups. Make sure to save time for the wrap up.")
        TeachingTip()
        Paragraph():Strong("Make it a Gallery Walk:"):Text(" Depending on your room set-up you may be able to have students run this activity in a more open-ended way. Students should leave their unconstructed blocks and instructions at their table with the target image face down. They can then make their way to a few different groups' instructions over the course of 10-15 minutes.")
        Paragraph():Strong("Mark What's Confusing:"):Text(" You may optionally have students leave suggestions on instructions when they use them explaining where they were confused or wanted more detail. This is a good way to practice giving and receiving feedback. It also forces groups to think more clearly about what is causing their confusion since they'll have to leave it in writing.")
        EndCallout()
    end

    private action WrapUp10Minutes
        Section("Wrap up (10 Minutes)")
        Paragraph():Strong("Discuss:"):Text(" When you or your classmates made mistakes following instructions today what "):DoubleQuote():Text("went wrong"):DoubleQuote():Text("? Try to be as specific as possible.")
        DiscussionGoal()
        Paragraph("This wrap up includes two sets of prompts and should be run as back-to-back discussions. The first set helps students synthesize the challenges they encountered during the main activity. The second set prompts students to think about how they might design a new language that avoids these challenges.")
        Paragraph("When running the first discussion ask students to share specific experiences during the lesson and prompt them to think about what went wrong. They might say things like "):DoubleQuote():Text("if we'd just been more clear"):DoubleQuote():Text(" or "):DoubleQuote():Text("we just need to include more detail"):DoubleQuote():Text(". This might be true, but eventually you should point out that human language is often ambiguous. In other words, it's not their fault! It's hard to do a good job with bad tools!")
        Paragraph("When running the second discussion push students to think about what a language designed for giving instructions would look like. While specific answers aren't important, you should push them to build on their experiences in the main activity. For example, if they saw that words having two meanings was confusing in the main activity, they should suggest redesigning the language so each word has a single well-understood meaning.")
        EndCallout()
        Subsection("Remarks")
        BulletList()
        ListItem("Even trying to be as clear as possible we struggled to write clear instructions. There are things we could do to improve, but the core challenge here is that everyday human language is bad for giving clear instructions. Words can have two or three meanings! Instructions that seem clear turn out to be vague when we actually go follow them. If we want to give clear instructions, we need to fundamentally change the language we use. We need to create a new kind of language.")
        Paragraph():Strong("Discuss:"):Text(" Imagine we were going to redesign human language to be really good for giving clear instructions. What types of changes would we need to make?")
        BulletList()
        ListItem("Today we talked a lot about instructions because soon we're going start programming your apps. When you write a program you're just giving instructions to a computer for what it should do to run your app. As you'll see, the programming language we use to give these instructions sometimes looks like English, but then has a lot of weird (and sometimes confusing) differences. This is because it needs to be more precise and unambiguous than normal human language. We'll dive into this more next time we meet!")
    end

    private action AssessmentCheckForUnderstanding
        Section("Assessment: Check for Understanding")
        Subsection("For Students")
        Paragraph("Open a word doc or google doc and copy/paste the following question.")
        Subsection("Question")
        Paragraph("What is the difference between a programming language and natural (every-day) language?")
    end

    private action StandardsAlignment
        Section("Standards Alignment")
        BulletList()
        ListItem():Strong("CSTA K-12 Computer Science Standards (2017): "):Text("2-AP-17, 3A-AP-13, 3A-AP-21, 3A-AP-22, 3A-AP-23")
    end
end
