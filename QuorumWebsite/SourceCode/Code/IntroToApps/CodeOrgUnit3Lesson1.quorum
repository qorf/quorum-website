use Libraries.Web.Page.QuorumPage

/*
    Intro to App Design - Lesson 1: Introduction to Apps.
    Converted from the old Lesson page by plan 13's generator: the same
    words, now without Tailwind.
*/
class CodeOrgUnit3Lesson1 is QuorumPage

    on create
        SetLocation("lessons/code/Algorithm-Programming/Lesson1.html")
        // The name lists and links use, and the series and track it belongs
        // to: its section and picture.
        SetShortTitle("Introduction to Apps")
        SetSectionName("Intro to App Design")
        SetCardImage("/media/userInterface/quorumAssets/cspImages/csp3.svg")
        SetCardDescription("This unit is an introduction to programming and app design with a heavy focus on skills like debugging, pair programming, and user testing.")
        // For search engines and link previews, and what lists of pages say.
        SetDescription("Learn about apps and the ideas behind them.")
        SetSummary("Learn about app basics")
    end

    action Setup
        SetWebPageTitle("Unit 3 Lesson 1: Introduction to Apps")
        Title("Intro to App Design - Lesson 1: Introduction to Apps")
        Overview()
        GettingStarted5Minutes()
        Activity35Minutes()
        WrapUp10Minutes()
        AssessmentCheckForUnderstanding()
        StandardsAlignment()
    end

    private action Overview
        Section("Overview")
        Paragraph("Students explore and investigate what makes an app an app. They begin by looking at and discussing several different apps. Following this, students watch a video explaining the basics of how computers work. Finally students return to the apps and consider the various inputs and outputs.")
        Subsection("Goals")
        Paragraph("Students will be able to:")
        BulletList()
        ListItem("Identify the inputs of an app")
        ListItem("Identify the outputs of an app")
        ListItem("Identify the purpose of an app")
        Subsection("Purpose")
        Paragraph("This lesson is an introduction to a unit that introduces programming through the broader context of designing apps that help people. This lesson is designed to build excitement about the skills that students will develop throughout the unit and get them thinking early about the ways programming can help others. This lesson also establishes shared vocabulary for talking about apps in a generic sense, for example its inputs, outputs, and overall user interface.")
        Subsection("Resources")
        BulletList()
        ListItem():Link("How Computers Work - What Makes a Computer, a Computer - Video", "https://www.youtube.com/watch?v=mCq8-xTH7jA&feature=youtu.be")
        ListItem():Link("Getting Started with CSP Widgets", "/lessons/code/CodeOrgWidgetTutorial.html")
        ListItem():Link("CSP-Widgets Repository", "https://github.com/qorf/CSP-Widgets")
        ListItem():Link("Quorum Studio Shortcut Tips", "https://quorumlanguage.com/tutorials/language/development.html")
    end

    private action GettingStarted5Minutes
        Section("Getting Started (5 minutes)")
        Subsection("Remarks")
        BulletList()
        ListItem("Now that we've learned how to represent information digitally and how the Internet works, it's time to think about creating digital content for others to interact with.")
        Paragraph():Strong("Discuss:"):Text(" What are apps? How do we interact with them? What kinds of things do apps do?")
        DiscussionGoal()
        Paragraph("Apps are designed to solve a problem by providing a service")
        BulletList()
        ListItem("Entertainment: images, movies, tv shows, etc.")
        ListItem("Social: social media, chatting")
        ListItem("Commerce: marketplaces")
        ListItem("Finding Information: search engines, maps")
        Paragraph("Apps have screens or User Interfaces to display and collect information to and from users")
        BulletList()
        ListItem("These things collect information: Buttons, sliders, text boxes, etc.")
        ListItem("This is the type of information that can be displayed: Sounds, images, video, text")
        EndCallout()
    end

    private action Activity35Minutes
        Section("Activity (35 minutes)")
        Subsection("App Exploration")
        Paragraph("For today's activity, students will explore a number of apps which can be found in the "):Link("CSP-Widgets Repository", "https://github.com/qorf/CSP-Widgets"):Text(". Each app is a Quorum Studio project in the "):DoubleQuote():Text("Unit 3"):DoubleQuote():Text(" folder. For full instructions on downloading and running the apps, including downloading the Quorum Studio environment, see the "):Link("Getting Started with CSP Widgets", "/lessons/code/CodeOrgWidgetTutorial.html"):Text(" help page.")
        Paragraph():Strong("Group:"):Text(" Organize students in groups of two. Students should open the apps used for this lesson, starting with "):DoubleQuote():Text("Lesson1_App1"):DoubleQuote():Text(".")
        TeachingTip()
        Paragraph():Strong("Teaching Tip:"):Text(" There are several different sample apps. Depending on time, students might not explore all of them right now.")
        Paragraph("During this activity, make sure students are running and exploring the apps and not focusing on the code. Students will have opportunities to inspect and work with code in later lessons.")
        EndCallout()
        Paragraph():Strong("Prompt:"):Text(" With a partner, discuss the following and note down in your journal:")
        BulletList()
        ListItem("How does the user interact with the app?")
        ListItem("What is the overall purpose of this app?")
        ListItem("Who is the target audience?")
        Paragraph():Strong("Share Out:"):Text(" As a class, discuss student answers to the discussion questions.")
        DiscussionGoal()
        Paragraph():Emphasis("App #1: Water Conservation Tips")
        BulletList()
        ListItem("The user selects through the different screens and makes choices about the correct ways to conserve water. When the user makes choices, images or sounds are played to indicate if a choice is the right one.")
        ListItem("The purpose of the app is to teach people about ways to conserve water.")
        ListItem("The target audience is young people who are interested in the topic")
        Paragraph():Emphasis("App #2: Bird Quiz")
        BulletList()
        ListItem("The user answers trivia questions about birds. If the answer is correct, they go to the next question. If wrong, they are taken to a losing screen, and then start the quiz again. If three questions are answered correctly the user is taken to the winning screen.")
        ListItem("The purpose of the app is to teach users different facts about birds")
        ListItem("The target audience is anyone interested in birds")
        Paragraph():Emphasis("App #3: Hamilton Township")
        BulletList()
        ListItem("The user selects through a few different screens to learn about township efforts to beautify the town")
        ListItem("The purpose of the app is to educate users on steps the town is taking to improve the town")
        ListItem("The target audience is people who live in Hamilton Township")
        EndCallout()
        Subsubsection("Remarks")
        BulletList()
        ListItem("In developing apps, which are a kind of computing innovation, it's important to understand both their purpose and function. The purpose helps the developer focus on creating an app with specific goals in mind.")
        ListItem("Now let's dig in to how the user interacts with the apps.")
        Subsection("Input & Output")
        Paragraph():Strong("Display:"):Text("Show")
        Paragraph():Link("How Computers Work - What Makes a Computer, a Computer - Video", "https://www.youtube.com/watch?v=mCq8-xTH7jA&feature=youtu.be")
        Subsubsection("Remarks")
        BulletList()
        ListItem("The video explained Input, Storage, Processing, and Output. Today we are going to focus on input and output. An app on a phone gets input in many different ways from a user or from another program and displays (or in the case of sound: plays) output. The output of a program is usually based on inputs or the initial way the program was set up. For example, you could program an app to play a song as soon as it runs.")
        Subsection("App Exploration")
        Paragraph():Strong("Do This:"):Text(" With your partner, take another look at the sample apps you explored before. Consider what the inputs and outputs are for the apps. Note these down in your journal.")
        TeachingTip()
        Paragraph("After students are finished writing in their journals, discuss as a class or collect the journals to review student answers.")
        BulletList()
        ListItem("An input could be a user selecting a button or tapping the screen")
        ListItem("An output could be an image displayed or a sound played")
        EndCallout()
    end

    private action WrapUp10Minutes
        Section("Wrap up (10 Minutes)")
        Subsection("Remarks")
        BulletList()
        ListItem("Apps solve a problem for a target audience. Apps take in input from users and output information in various ways. Users interact with apps through the user interface.")
        Paragraph():Strong("Discuss:"):Text(" Think of your favorite app. Discuss with a partner what the user interface looks like and the inputs and outputs.")
        DiscussionGoal()
        Paragraph():Strong("Goal:"):Text(" After students have shared with a partner, bring the class back together and discuss a few examples.")
        EndCallout()
        Subsection("Journal")
        Paragraph("Add to your journal the following terms along with your own definitions:")
        BulletList()
        ListItem():Emphasis("User Interface:"):Text(" The inputs and outputs that allow a user to interact with a piece of software. User interfaces can include a variety of forms such as buttons, menus, images, text, and graphics.")
        ListItem():Emphasis("Input:"):Text(" Data that are sent to a computer for processing by a program. Can come in a variety of forms, such as tactile interaction, audio, visuals, or text.")
        ListItem():Emphasis("Output:"):Text(" Any data that are sent from a program to a device. Can come in a variety of forms, such as tactile interaction, audio, visuals, or text.")
    end

    private action AssessmentCheckForUnderstanding
        Section("Assessment: Check for Understanding")
        Subsection("For Students")
        Paragraph("Open a word doc or google doc and copy/paste the following question.")
        Subsection("Question")
        Paragraph("Match each term from the definition list to an entry in the example list:")
        Subsection("Definitions")
        NumberedList()
        ListItem("Output")
        ListItem("Input")
        ListItem("User Interface")
        Subsection("Examples")
        BulletList()
        ListItem("A song is played")
        ListItem("The user selects a button")
        ListItem("A screen with buttons, images, and text")
    end

    private action StandardsAlignment
        Section("Standards Alignment")
        BulletList()
        ListItem():Strong("CSP2021: "):Text("CRD-2.A.2, CRD-2.C.1, CRD-2.C.4, CRD-2.C.6, CRD-2.D.1, CRD-2.D.2")
    end
end
