use Libraries.Web.Page.QuorumPage

/*
    Intro to App Design - Lesson 3: Designing an App Part 1.
    Converted from the old Lesson page by plan 13's generator: the same
    words, now without Tailwind.
*/
class CodeOrgUnit3Lesson3 is QuorumPage

    on create
        SetLocation("lessons/code/Algorithm-Programming/Lesson3.html")
        // The name lists and links use, and the series and track it belongs
        // to: its section and picture.
        SetShortTitle("Project - Designing an App Part 1")
        SetSectionName("Intro to App Design")
        // For search engines and link previews, and what lists of pages say.
        SetDescription("Develop an app from scratch and respond to feedback")
        SetSummary("Begin designing your own app")
    end

    action Setup
        SetWebPageTitle("Unit 3 Lesson 3: Designing an App Part 1")
        Title("Intro to App Design - Lesson 3: Designing an App Part 1")
        Overview()
        GettingStarted5Minutes()
        Activity30Minutes()
        WrapUp5Minutes()
        AssessmentCheckForUnderstanding()
        StandardsAlignment()
    end

    private action Overview
        Section("Overview")
        Paragraph("This is the first in a series of lessons where students will make progress on building their own functional app. In this lesson, students brainstorm app ideas and sketch out user interfaces in preparation for the next lesson where they will begin building the apps with code.")
        Subsection("Goals")
        Paragraph("Students will be able to:")
        BulletList()
        ListItem("Brainstorm and choose a topic to develop into an app")
        ListItem("Use feedback to help guide the design of an app")
        ListItem("Design the user interface of an app")
        Subsection("Purpose")
        Paragraph("This lesson kicks off a project that students will complete throughout the unit. The framing of this project is also important for how programming is presented overall. Students are encouraged to collaboratively design their projects, choose topics of personal interest, and build an app to meet the needs of other people. All of this is important as part of framing programming as a collaborative, creative, and socially situated pursuit.")
        Subsection("Resources")
        Paragraph():Strong("Supplemental Code.org material")
        Paragraph("For the students")
        BulletList()
        ListItem():Link("App Development Planning Guide - Activity Guide", "https://docs.google.com/document/d/1JXIaQGRKzsw9UvZh58yLfkriV2QH7fTE51Omr8OJ1aM/edit?usp=sharing")
    end

    private action GettingStarted5Minutes
        Section("Getting Started (5 minutes)")
        Paragraph():Strong("Discuss:"):Text(" People design user interfaces to meet a user's needs, but they don't always get it right.")
        BulletList()
        ListItem("Have you ever used an app where the user interface didn't actually meet your needs?")
        ListItem("What was the problem?")
        ListItem("What do you think the designers didn't understand about you or your needs?")
        DiscussionGoal()
        Paragraph("The goal here is to help students understand the importance of considering the end user when designing an app.")
        Paragraph("Some points that may come up:")
        BulletList()
        ListItem("Some apps have too much guidance on how to use them, and others too little.")
        ListItem("An app may be designed for a phone, but the user wants to use it on a tablet.")
        ListItem("Apps that are designed for teenagers may make assumptions about language usage or interests that aren't accurate.")
        EndCallout()
    end

    private action Activity30Minutes
        Section("Activity (30 minutes)")
        Subsection("Remarks")
        BulletList()
        ListItem("Yesterday we learned all about Design Mode. Today you're going to start developing your own app that educates a user on a topic. This is a project that will continue through the rest of the unit.")
        Subsection("Distribute")
        BulletList()
        ListItem("For this project you will work with a partner. Together you will create an app that teaches your classmates about any topic you both find interesting. Along the way you'll learn how to use many of the features of App Lab as well as skills that will help you when building more apps throughout this class.")
        ListItem("You will submit: Your final app and this completed project-planning guide")
        ListItem("App Requirements: Uses at least three screens, includes examples of images, audio, and text, a clear and easy to navigate user interface, clearly communicates information about your topic, code is cleanly written and free of errors")
        ListItem("Steps: Collaborate with your partner to pick a topic you are both interested in, interview classmates to identify what they already know about the topic, design your app's user interface using this planning guide, design and program your app in App Lab, collect feedback from your classmates and update your app, share your final app with the class")
        Subsection("Step 1: Brainstorm Topic Ideas")
        Paragraph():Strong("Group:"):Text(" Organize students into pairs.")
        BulletList()
        ListItem("You will work with a partner on this project. Collaboration is a big part of app development. Your team's diverse ideas will help make your app even better, because each partner can keep a lookout for bias.")
        ListItem("Here's an example: A team member puts in their app the phrase: "):DoubleQuote():Text("All teenagers work after school to earn spending money"):DoubleQuote():Text(" because this is their experience - they work after school themselves. However, the other team member may not have an after school job, and because of this can point out the bias in that statement.")
        ListItem("Collaboration is key to catching bias in your work!")
        ListItem("Here's another example, this time in the design of an app. A team wants to make an app to encourage girls to sign up for a summer camp. One team member assumes that because this app is aimed at girls, the background should be pink. A girl on the team points out that she does not like pink, and using that color in the design may represent bias.")
        ListItem("As you think about your topics and start designing your apps, remember to keep an eye out for bias and use your team mates to keep you accountable!")
        Paragraph("In their groups, students brainstorm topic ideas and add them to their worksheet.")
        TeachingTip()
        Paragraph("Students have a lot of freedom in choosing their topics. If they are struggling with ideas, they could create an app for another class, for example: an overview of the periodic table for science class.")
        EndCallout()
        Subsection("Step 2: Choose One Topic")
        Paragraph("Working with a partner, students narrow down their ideas to one topic and explain what would be covered in their app.")
        Subsection("Step 3: Survey Your Classmates")
        Paragraph("The goal in this step is for students to understand the needs of their users. This will help inform the overall design of the app.")
        Subsection("Step 4: Design the User Interface")
        Paragraph("Student use the screen templates to sketch out the design of their app, including arrows or notes to show how different elements are connected.")
        TeachingTip()
        Paragraph("After Step 4, you may want to check in with student groups to make sure their apps are doable and can be completed within the scope of the project.")
        Paragraph("Steps 5+ will be completed later on in the unit.")
        EndCallout()
    end

    private action WrapUp5Minutes
        Section("Wrap up (5 Minutes)")
        Paragraph():Strong("Discuss:"):Text(" How did talking with the users of your app impact your design decisions?")
        Subsection("Remarks")
        BulletList()
        ListItem("In the following lessons, you will continue to plan and create you apps. What are we doing here? We are following a development process, which is similar to what developers use in the real world when creating their own apps. A development process breaks down the steps into small pieces - we've completed the first few today.")
        ListItem("There are many different versions of the development process. Most use some combination of investigating and reflecting, designing, prototyping and testing. Development processes can be ordered or be more exploratory in nature. As we continue on through this project, reflect on the steps and consider how they help organize the process.")
    end

    private action AssessmentCheckForUnderstanding
        Section("Assessment: Check for Understanding")
        Subsection("For Students")
        Paragraph("Open a word doc or google doc and copy/paste the following question.")
        Subsection("Question")
        Paragraph("Match each term with an example.")
        Paragraph():Emphasis("Terms:")
        NumberedList()
        ListItem("Input")
        ListItem("Output")
        ListItem("User Interface")
        BulletList()
        ListItem("Text is displayed on the screen.")
        ListItem("Buttons and a text area with a title.")
        ListItem("Selecting an button.")
    end

    private action StandardsAlignment
        Section("Standards Alignment")
        BulletList()
        ListItem():Strong("CSTA K-12 Computer Science Standards (2017): "):Text("3A-AP-16, 3A-AP-19, 3A-AP-21, 3A-AP-22, 3A-AP-23")
        ListItem():Strong("CSP2021: "):Text("CRD-1.A.3, CRD-1.A.4, CRD-1.A.6")
        ListItem():Strong("CSP2021: "):Text("CRD-2.E.1, CRD-2.E.2, CRD-2.E.4, CRD-2.F.1, CRD-2.F.2, CRD-2.F.3, CRD-2.F.4, CRD-2.F.5, CRD-2.F.6, CRD-2.F.7")
    end
end
