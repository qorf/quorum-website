use Libraries.Web.Page.QuorumPage

/*
    Digital Information - Lesson 11: Intellectual Property.
    Converted from the old Lesson page by plan 13's generator: the same
    words, now without Tailwind.
*/
class CodeOrgUnit1L11 is QuorumPage

    on create
        SetLocation("lessons/code/internet/InternetLesson11.html")
        // The name lists and links use, and the series and track it belongs
        // to: its section and picture.
        SetShortTitle("Intellectual Property")
        SetSectionName("Digital Information")
        // For search engines and link previews, and what lists of pages say.
        SetDescription("Learn about copyright and intellectual property")
        SetSummary("copyright and intellectual property")
    end

    action Setup
        SetWebPageTitle("Unit 1 Lesson 11: Intellectual Property")
        Title("Digital Information - Lesson 11: Intellectual Property")
        Overview()
        GettingStarted5Minutes()
        Activity30Mins()
        WrapUp5Minutes()
        AssessmentCheckForUnderstanding()
        StandardsAlignment()
    end

    private action Overview
        Section("Overview")
        Paragraph("Students are asked to reflect on who owns their creative works from this class, such as their pixel images, before reading an article describing how ownership can become complicated as analog works become digital artifacts. After reading the article, students watch several videos explaining copyright and introducing them to the Creative Commons. Students then re-read the article answering three questions about the benefits, harms, and impacts of current copyright policy. Students use their new understanding of copyright to form an opinion about current copyright policies and create a small poster justifying their opinion with a quote from the article.")
        Subsection("Goals")
        Paragraph("Students will be able to:")
        BulletList()
        ListItem("Explain how copyright and Creative Commons Licenses can be applied to digital works of creativity")
        ListItem("Argue if current copyright laws are helping or harming society using evidence from an article")
        Subsection("Purpose")
        Paragraph("Students have been examining how digital information is created and stored, but they have not closely examined the question of who owns their digital data and what rules govern how that information can be shared. This lesson introduces the concept of copyright by presenting students with an article that challenges their current understanding of digital ownership and makes them wrestle with some of the complexities of owning and sharing digital information. It's important for students to talk through their ideas and hear the perspectives of their peers as they try to unpack how copyright law can impact society. Ultimately, students begin to form their own opinions about copyright focusing on how these policies impact the world around us and observing who benefits and who is harmed in particular copyright situations.")
        Paragraph("This lesson is also a scaffold to the larger project that begins after this lesson which includes several tasks that are also a part of this lesson such as, annotating an article, answering questions, and forming an opinion using the article as evidence. Students may need support with these processes during this lesson so they are able to complete the following lesson independently. It is especially important that students use marking the text strategies to help them comprehend and synthesize the information from their article, because they will need to do this in the next lesson as well.")
        Subsection("Resources")
        Paragraph("For the students")
        BulletList()
        ListItem():Link("Article - Fortnite Stealing Dance Moves", "https://drive.google.com/file/d/1zs-d_4L53qgPCtdg1e9Gw00QMx8NQpt0/view?usp=sharing")
        ListItem():Link("Video - Copyright Overview", "https://youtu.be/GPNWvU_IphU")
        ListItem():Link("Video - Copyright in Practice", "https://youtu.be/ITASCSxnBqw")
        ListItem():Link("Video - Creative Commons Copyright", "https://youtu.be/wC-m23T7cPM")
    end

    private action GettingStarted5Minutes
        Section("Getting Started (5 minutes)")
        Paragraph():Strong("Prompt: "):Text("Imagine you were using some of our pixelation tools to create an image and you posted it online for your friends to see - but, a week later you find out someone took that image and put it on a T-shirt that they're selling for $10 each. How would you feel in this situation?")
        DiscussionGoal()
        Paragraph("This discussion doesn't need to come to a definite conclusion - it should generate more questions than answers. You can complicate this discussion by asking:")
        BulletList()
        ListItem("What if the owner gives you credit for the drawing on the T-shirt - does that make it more or less okay?")
        ListItem("If we use the pixelation widget, then our image is just a binary number that's been transformed into an image - can we really "):DoubleQuote():Text("own"):DoubleQuote():Text(" a number?")
        ListItem("What if, instead of this happening a week later, it happened 20 years later. Does that change anything?")
        EndCallout()
        Paragraph("This discussion doesn't need to come to a definite conclusion - it should generate more questions than answers. You can complicate this discussion by asking:")
        BulletList()
        ListItem("What if the owner gives you credit for the drawing on the T-shirt - does that make it more or less okay?")
        ListItem("If we use the pixelation widget, then our image is just a binary number that's been transformed into an image - can we really "):DoubleQuote():Text("own"):DoubleQuote():Text(" a number?")
        ListItem("What if, instead of this happening a week later, it happened 20 years later. Does that change anything?")
        Subsection("Remarks")
        BulletList()
        ListItem("When you create materials on the computer, you own them - they are your "):DoubleQuote():Text("Intellectual Property"):DoubleQuote():Text(". Using materials created by someone else and trying to pass them off as your own is plagiarism when you don't have the creator's permissions. There may even be legal consequences for using these materials!")
        ListItem("However, we can see from our discussion that it can be complicated when we talk about ownership of digital information. Today we are going to explore these issues.")
    end

    private action Activity30Mins
        Section("Activity (30 mins)")
        Subsection("Activity Part 1: Read the Article")
        Paragraph():Strong("Distribute: "):Link("Article - Fortnite Stealing Dance Moves", "https://drive.google.com/file/d/1zs-d_4L53qgPCtdg1e9Gw00QMx8NQpt0/view?usp=sharing")
        Paragraph():Strong("Do This:"):Text(" Students read the article. After they are finished reading they should mark up the text with the following:")
        DiscussionGoal()
        Paragraph("This lesson is written assuming that you have printed out the article and have it physically available for students to write on, even though it is also possible to have students interact with this text digitally. If students read the article digitally, it is most important that they still follow the active reading strategies outlined in this lesson - interacting with the text and summarizing. This may require some additional time & instruction to teach students your preferred tools of digital annotation, or you can ask students to record quotes in their journal or notes rather than highlight them. You can use these same adjustments for some of the later annotation strategies in this lesson.")
        EndCallout()
        Paragraph():Strong("Prompt:"):Text(" This article brings up issues around copyright. Based on what you've read and your own experiences, what questions do you have about copyright?")
        DiscussionGoal()
        Paragraph("This discussion continues to generate questions and spark student curiosity based on the article. Ultimately we will present students with a focused question to continue the lesson, but this lets students voice their ideas and concerns with the class. It can be helpful to keep these questions & concerns in mind as the lesson continues and return to them when you can.")
        EndCallout()
        Paragraph():Strong("Prompt: "):Text("Are our current copyright policies helping society or hurting society?")
        TeachingTip()
        Paragraph("You may find that a topic about digital copyright is in the news when you are teaching this lesson. It may be appropriate and relevant to use those news events in addition to, or instead of, the article in this lesson plan. Any article you use should:")
        BulletList()
        ListItem("Discuss the complexities of owning and sharing digital information")
        ListItem("Explore who benefits or is harmed by policies around copyright")
        Paragraph("If you find current news stories that also cover these points, you may want to consider using those articles here.")
        EndCallout()
        Subsection("Activity Part 2: Copyright Overview (10 minutes)")
        Paragraph("Before we can really discuss this question, we need some additional background information. We are going to watch three videos. Our goal is to better understand the rules of copyright, and to better understand when we can reuse or remix something.")
        BulletList()
        ListItem():Link("Video #1: Copyright Overview", "https://www.youtube.com/watch?v=GPNWvU_IphU")
        ListItem():Link("Video #2: Copyright in Practice", "https://www.youtube.com/watch?v=ITASCSxnBqw")
        ListItem():Link("Video #3: Creative Commons Copyright", "https://www.youtube.com/watch?v=wC-m23T7cPM")
        Subsubsection("Video 1")
        Video("https://www.youtube.com/embed/GPNWvU_IphU?si=J141CK-8lO1e6c8o", "C&C A.1  Creators and Consumers of Media Online")
        Subsubsection("Video 2")
        Video("https://www.youtube.com/embed/ITASCSxnBqw?si=TJm8t-lHaw-hsqmM", "C&C A.5 Copyright in the Real World—Remember when Taylor Swift took her music OFF spotify?")
        Subsubsection("Video 3")
        Video("https://www.youtube.com/embed/wC-m23T7cPM?si=Q9LY_MVdI1ALo-v_", "C&C C.4  Wanna Work Together")
        TeachingTip()
        Paragraph("The videos in this section are sourced from the "):Link("Copyright & Creativity for Ethical Digital Citizens Curriculum", "https://www.copyrightandcreativity.org/high-school/"):Text(". Credit to the Internet Education Foundation and iKeepSafe for these videos.")
        EndCallout()
        Subsection("Activity Part 3: Article Re-read (10 minutes)")
        BulletList()
        ListItem("Now that we better understand the rules & controls of copyright, we're going to re-read this article to see if we can determine if current copyright policies are helping or hurting society")
        Paragraph():Strong("Prompt:"):Text(" Consider our earlier prompt again -- are our current copyright policies helping society or hurting society?")
        Paragraph():Strong("Do This:"):Text(" Have students re-read the article in order to answer these questions:")
        BulletList()
        ListItem("What was digitized?")
        ListItem("What was the goal or purpose of digitizing this thing?")
        ListItem("Is someone benefiting from this situation? If so, who?")
        ListItem("Is someone being harmed in this situation? If so, who?")
        ListItem("Are these impacts intended or unintended? How do you know?")
        Paragraph("Students should continue to annotate or record quotes from the article to do the following:")
        BulletList()
        ListItem("Identify sentences that show benefit")
        ListItem("Identify sentences that show harm")
        ListItem("Identify sentences that show impact")
        Paragraph():Strong("Prompt:"):Text(" Share some of the sentences you annotated. Did everyone identify the same areas?")
        DiscussionGoal()
        Paragraph("This discussion continues to generate questions and spark student curiosity based on the article. Ultimately we will present students with a focused question to continue the lesson, but this lets students voice their ideas and concerns with the class. It can be helpful to keep these questions & concerns in mind as the lesson continues and return to them when you can.")
        EndCallout()
        TeachingTip()
        Paragraph():Strong("Activity Repetition:"):Text(" This aspect of the lesson - reading an article and looking at these questions - is repeated in tomorrow's lesson as well. Students are presented with a different set of articles to examine and must also identify benefits, harms, and impacts. Having them complete this same task today acts as a scaffold to prepare students to read an article with purpose. As you circulate and work with students, offer reading tips and strategies that will help them complete this similar task independently tomorrow.")
        EndCallout()
    end

    private action WrapUp5Minutes
        Section("Wrap up (5 Minutes)")
        Subsection("Remarks")
        BulletList()
        ListItem("You need to take a stand on today's question, using this article to help support your position. We will do this by creating a position poster so we can see how everyone feels about Copyright based on this article.")
        Paragraph():Strong("Do This:")
        BulletList()
        ListItem("Distribute paper to each student. Have students fold the paper in half.")
        ListItem("In the top section, complete this sentence stem: "):DoubleQuote():Text("I think copyright can [help / hurt] society because ..."):DoubleQuote()
        ListItem("In the bottom section, provide a quote from the text that helps justify the sentence you wrote in the top")
        Paragraph():Strong("Circulate:"):Text(" Check in with students and encourage them to use one of their highlighted sentences as evidence for their opinion. As students finish, they hang them in a public space edge-to-edge like a quilt to form a larger tapestry of opinions about copyright with evidence. This class artifact can hang in the classroom as a reference for the next few lessons.")
        BulletList()
        ListItem("Today we learned about Creative Commons, a license that allows you to freely use materials created by others. There are a few other licenses that you may have heard about that also allow access:")
        ListItem("Open Source: programs that are made freely available and may be redistributed and modified.")
        ListItem("Open Access: online research output free of restrictions to access and use")
        ListItem("You do have options when you want to ethically use others materials! Because of these licenses, we have access to a wide variety of digital materials.")
        ListItem("To close, when you use these materials, always make sure to cite where you go these sources. Citations come in many forms - it could be a link, or a description of where you got the source. There are formal versions of citations recommended by various organizations, but genearlly the most important thing to remember when citing a source is to provide as much information as possible about the materials you are using.")
        TeachingTip()
        Paragraph():Strong("Creating the Artifact:"):Text(" This is another aspect of the lesson that will be repeated in tomorrow's project - students will create an artifact that will be displayed for their peers to see, and this artifact must also include references to the text they read. Displaying the artifacts from today's lesson acts as a model for what students will be expected to do independently in tomorrow's lesson.")
        EndCallout()
    end

    private action AssessmentCheckForUnderstanding
        Section("Assessment: Check for Understanding")
        Subsection("For Students")
        Paragraph("Open a word doc or google doc and copy/paste the 2 following question.")
        Subsection("Question 1")
        Paragraph("How is a Creative Commons license different from a regular copyright?")
        Subsection("Question 2")
        Paragraph("Now that we understand Copyright, what would need to change in order for the scenario from the warm-up to be okay? As a reminder, here was the scenario from the warm-up: "):Emphasis("Imagine you were using some of our pixelation tools to create an image and you posted it online for your friends to see - but, a week later you find out someone took that image and put it on a T-shirt that they're selling for $10 each.")
    end

    private action StandardsAlignment
        Section("Standards Alignment")
        BulletList()
        ListItem():Strong("CSTA K-12 Computer Science Standards (2017): IC"):Text(" - Impacts of Computing: 3A-IC-28 - Explain the beneficial and harmful effects that intellectual property laws can have on innovation.")
        ListItem():Strong("CSP2021: "):Text("IOC-1.F.1, IOC-1.F.2, IOC-1.F.3, IOC-1.F.4, IOC-1.F.5, IOC-1.F.6, IOC-1.F.7")
    end
end
