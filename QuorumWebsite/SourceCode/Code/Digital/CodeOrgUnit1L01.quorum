use Libraries.Web.Page.QuorumPage

/*
    Digital Information - Lesson 1: Welcome to CSP.
    Converted from the old Lesson page by plan 13's generator: the same
    words, now without Tailwind.
*/
class CodeOrgUnit1L01 is QuorumPage
    // A double quote, for code and words that hold one.
    text dq = ""

    on create
        SetLocation("lessons/code/internet/InternetLesson1.html")
        // The name lists and links use, and the series and track it belongs
        // to: its section and picture.
        SetShortTitle("Welcome to CSP")
        SetSectionName("Digital Information")
        SetCardImage("/media/userInterface/quorumAssets/cspImages/csp1.svg")
        SetCardDescription("This unit explores the technical challenges and questions that arise from the need to represent digital information in computers.")
        // For search engines and link previews, and what lists of pages say.
        SetDescription("An unplugged lesson exploring innovations in everyday life")
        SetSummary("explore innovations in everyday life")
    end

    action Setup
        dq = dq:GetDoubleQuote()
        SetWebPageTitle("Unit 1 Lesson 1: Welcome to CSP")
        Title("Digital Information - Lesson 1: Welcome to CSP")
        Overview()
        GettingStarted15Minutes()
        Activity20Mins()
        WrapUp10Minutes()
        AssessmentCheckForUnderstanding()
        StandardsAlignment()
    end

    private action Overview
        Section("Overview")
        Paragraph("Welcome to Computer Science Principles! The first lesson is about getting students excited about the course and connecting their own personal interests to computer science. Students are asked to share something they know a lot about and teach it to a small group. Groups make a "):DoubleQuote():Text("rapid"):DoubleQuote():Text(" prototype of an innovative idea and share it. For the Wrap Up, students watch a brief video about computing innovations, and the lesson ends with students answering a brief prompt about what "):DoubleQuote():Text("computer science"):DoubleQuote():Text(" means to them.")
        Paragraph("This Computer Science track is designed to parallel the Code.org CS principle's course. This track can be used as a standalone or in a mixed class. If Code.org provided any supplemental material (guides, videos, or visuals) those are linked in the resources section of each lesson.")
        Subsection("Goals")
        Paragraph("Students will be able to:")
        BulletList()
        ListItem("Communicate with classmates about computing innovations in their lives.")
        ListItem("Describe positive and negative effects of computing innovations.")
        ListItem("Have fun while programming in Quorum!")
        Subsection("Purpose")
        Paragraph("This activity plants the initial seed for students to think about the ways in which they might be able to solve some problems relevant to their lives with technological innovations.")
        Subsection("Resources")
        Subsubsection("For Teachers using code.org material")
        BulletList()
        ListItem():Link("How to Administer a Locked Assessment", "https://support.code.org/hc/en-us/articles/115001331951-Using-lock-settings-for-assessments-and-surveys")
        Subsubsection("For Students")
        BulletList()
        ListItem():Link("Personal Innovations - Activity Guide", "https://docs.google.com/document/d/14UBbBCYtaWskax2UOcE-vMdSBUelte9qdKRhgQ6SeJU/edit")
        ListItem():Link("Computer Science is Changing Everything", "https://www.youtube.com/watch?v=QvyTEx1wyOY")
        ListItem():Link("Personal Innovations - Rubric", "https://docs.google.com/document/d/1_ULIYnSwsMxOEZr0SHP_ueopo4qlIHFCyrfFcMhuDgE/edit")
        Subsection("Tech Setup")
        Paragraph("If you are going to use the code.org material as well as quorum please consider the following tech set up.")
        Paragraph("Make sure you are registered as a "):DoubleQuote():Text("verified teacher"):DoubleQuote():Text(" in order to see assessments and answer keys for Code.org material.")
        TeachingTip()
        Paragraph():Strong("How-To Videos:"):Text("The following steps are also covered in a series of How to videos available on Code.org's Teacher Support website. You may decide to watch these videos before reading the instructions below.")
        Paragraph():Link("How-To Videos", "https://support.code.org/hc/en-us/articles/4405629586957-New-how-to-walkthrough-videos-for-teachers-")
        EndCallout()
    end

    private action GettingStarted15Minutes
        Section("Getting Started (15 minutes)")
        Subsection("Teacher Message")
        BulletList()
        ListItem("Welcome to Computer Science Principles! This year we're going to learn a lot about computer science, but before we begin, we want to learn a little bit about you and your thoughts on computer science in general. Let's take the CSP Pre-Course Survey.")
        Subsubsection("If you are also using code.org material, please have your students take the CSP Pre-Course Survey.")
        Paragraph():Strong("Do This:"):Text(" Students can find a link to the survey in Code Studio (on the code.org site) as the first item on the Unit 1 overview page. To ensure that students only take the survey at the appropriate time, it is "):DoubleQuote():Text("locked"):DoubleQuote():Text(" and unviewable by them until you "):DoubleQuote():Text("unlock"):DoubleQuote():Text(" the survey as a verified teacher on code.org. The How to Administer a Locked Assessment document provides details on how to do that when you are ready. Note that the instructions for administering an assessment and a survey are the same.")
        TeachingTip()
        Paragraph():Strong("Why do the pre-course survey?")
        BulletList()
        ListItem("A major goal of CS Principles is to broaden participation in computer science.")
        ListItem("It is crucial therefore to have insight into students' attitidues and beliefs about computer science before the course so that we can measure the amount of change that occured after the course is over.")
        ListItem("Please note that this survey is "):Strong("anonymous for students")
        ListItem("Completing it also helps us understand important improvements we can make to the curriculum to improve the teacher and student experience.")
        Paragraph("Please help by having your students contribute to this vital dataset. Their voices make the difference!")
        Paragraph():Strong("How much time does it take?")
        BulletList()
        ListItem("The survey is roughly 40 quick response items. We expect it to take 5-10 minutes to complete. You might consider administering it on an admin day at school, or as an early homework.")
        ListItem("Because it is a pre-course survey it is important that students take it as early in the course as possible, before they have had much (or any) exposure to the class so that we may accurately gauge changes in attitudes and beliefs caused by the course.")
        Paragraph("Thank you! -The Code.org Team")
        EndCallout()
        Subsection("Topic Brainstorm")
        BulletList()
        ListItem("One thing that makes this class unique is that you have to invent solutions to problems and create things all the time, both alone and with others. Everyone has a unique and creative perspective they bring to the table.")
        ListItem("Let's start by seeing how creative we can be right now!")
        Paragraph():Strong("Do This:"):Text(" Take out a journal or note taking tool.")
        Paragraph():Strong("Prompt:"):Text(" What's something that you know a lot about? Something that you could teach somebody?")
        Paragraph():Strong("Discuss:"):Text(" With a partner or a small group:")
        BulletList()
        ListItem("introduce yourself")
        ListItem("explain the thing you know a lot about")
        ListItem("tell the group something interesting about that topic")
        TeachingTip()
        Paragraph("If students need help coming up with ideas, share these tips:")
        BulletList()
        ListItem("This doesn't have to be a subject in school - it very well might not be.")
        ListItem("As a person, as an individual who is living and breathing in this world, there is something that you probably know a lot about - maybe you feel like you know more about than most people. What is that thing?"):DoubleQuote()
        EndCallout()
        TeachingTip()
        Paragraph("What you're trying to do here is get students to state something that they are interested in, but also know a lot about - something they might have insights into.")
        Paragraph("A big part of students' enthusiasm for sharing will come from your enthusiasm and genuine interest in getting to know them.")
        Paragraph("Students might need prodding: there is something that makes them interesting and unique. Something they like to do, have interest in, read about, have some expertise in, a hidden talent.")
        EndCallout()
    end

    private action Activity20Mins
        Section("Activity (20 mins)")
        Paragraph():Strong("Group: "):Text("Place students in small groups.")
        Subsection("Identify impacts and prototype an innovation")
        Subsection("Remarks")
        BulletList()
        ListItem("People seem to say that technology is all around us and that it affects everything we do. Is that true? Technological innovation is about recognizing a problem that needs to be solved, or recognizing that something needs improving and then building a tool to solve it.")
        ListItem():Strong("As a class we're going to determine how innovative we can be. We're going to do something called " + dq + "rapid prototyping." + dq)
        ListItem():DoubleQuote():Text("Prototype"):DoubleQuote():Text(" is a fancy word that means a simple sketch of an idea or model for something new. It's the original drawing from which something real might be built or created.")
        Subsection("Brainstorm Technological Innovation")
        Paragraph():Strong("Do This:"):Text(" Either as individuals or in small groups,")
        BulletList()
        ListItem("Write down a way that technology is used with or affects the area or thing you talked about before in Getting Started. If working with a group, you can discuss this.")
        ListItem("Next, we're going to brainstorm. Write down or discuss with others a way that technology might be improved to make it better, faster, and/or easier to use, or a creative new technology that might help solve some problem within that area.")
        ListItem("If working with a group, everyone in the group should make suggestions for any of the areas of interest in your group.")
        TeachingTip()
        Paragraph("Keep things quick. If a group is worried about not being innovative enough, remind them that very small ideas can have big consequences. People once thought it was ridiculous that you would want to send a short text message to another person over a phone.")
        Paragraph("Alternatively, a group may have a great idea that they want to spend more time on. They can do that later. For now, just remind them it's a rapid prototype.")
        EndCallout()
        Paragraph("We've just brainstormed about some technology ideas at the table. Now, let's develop that idea with a rapid prototype -- something to quickly convey the idea.")
        BulletList()
        ListItem("If working in groups, have each group nominate an idea that they've discussed that they think would be the most interesting to everyone else in the class.")
        ListItem("The rapid prototype is a way to quickly convey the idea. Groups can sketch out their idea on a poster, or flesh out their idea in a different format.")
        Subsubsection("Share Prototypes")
        Paragraph("Once the prototypes are ready, share them with other students. You can put posters on a wall to let students survey them, have each group present their prototype, or otherwise share the prototype in a way that's convenient for the format they've used.")
    end

    private action WrapUp10Minutes
        Section("Wrap up (10 Minutes)")
        TeachingTip()
        Paragraph("Take this opportunity to explain the importance of bringing individual interests and perspectives to this course. From day one, students should be thinking about how to apply the principles they learn to their own lives, and hopefully they will be excited to do so. Consider some of the following remarks to contextualize this activity and build excitement about the rest of the year.")
        EndCallout()
        Subsection("Welcome Students to the Course")
        BulletList()
        ListItem("We are just starting this class, but you all bring passions and knowledge about things you care about. And whatever those things are it is likely (if not inevitable) that they involve computing technology in some way.")
        ListItem("Everyone is unique, but we're all in this together.")
        Paragraph("Next, we're going to listen to a video that talks about how technology affects every area of our lives. After the video, students will complete a short reflection activity.")
        Video("https://www.youtube.com/embed/QvyTEx1wyOY", "Computer Science is Changing Everything")
        BulletList()
        ListItem():Link("Video: Computer Science is Changing Everything", "https://www.youtube.com/watch?v=QvyTEx1wyOY")
        Paragraph():Strong("Discuss:"):Text(" What are you excited to lean about in this course?")
        DiscussionGoal()
        Paragraph("Students can discuss in small groups and then share out with the whole class. It's ok if at this point students don't have an answer to this prompt.")
        EndCallout()
    end

    private action AssessmentCheckForUnderstanding
        Section("Assessment: Check for Understanding")
        Paragraph("Computer science has changed the way we communicate with each other, make art and movies, grow food, and even treat illnesses. Everyone can learn computer science and make a difference.")
        Subsection("Quotes from Students")
        Paragraph("Still, we understand that taking a computer science course can be difficult at first. Here are a few student quotes describing their strategies and tips for taking this course. Please read the quotes carefully and respond to the prompt below.")
        Paragraph():Strong("Sofia P. (age 16) said..."):DoubleQuote():Text(" At the start of the class I worried that I was different from the other students. I wasn't sure I fit in -- I worried that I couldn't do it and that the teacher and other students would look down on me. A few days after I started, I realized that almost everyone who takes the class isn't sure if they fit in at first. It's something everyone goes through. Now it seems ironic -- everybody feels different at first, when really we're all going through the same thing."):DoubleQuote()
        Paragraph():Strong("Jasmin D. (age 17) tells us..."):DoubleQuote():Text(" I loved this computer science class! I've met some cool people and learned a lot. But it was a difficult transition. The first few days I was intimidated and not sure why I should learn computer science. Why would I need it? But then we talked in class about things I'm interested in, like music and design, and I realized that I can learn how to do cool new things. I had the wrong picture in my head about CS, it's actually very creative! I just had to be patient and find ways to connect the class to what I really care about."):DoubleQuote()
        Paragraph():Strong("Sam J. (age 17) said..."):DoubleQuote():Text(" I didn't have any experience with code, and I worried that I was not prepared for this class. Other students did some programming at home or in summer camps. On my first day, I was so nervous about getting bad grades and looking stupid. But then, I started to feel better -- I talked with other students and enjoyed the class more. I became more comfortable asking for help when I had a problem. It turned out that the students with CS experience had the same issues as me! Hah, it took some time, but now I really feel like I belong in CS class."):DoubleQuote()
        Subsection("Reflect and Summarize")
        Paragraph("Now consider the above strategies and insights about how to learn best and respond to the prompt below.")
        Paragraph():Strong("Prompt:"):Text(" What are your own strategies and insights about how to learn best? And, how are they similar or different to the ones that you just heard about from other students?")
    end

    private action StandardsAlignment
        Section("Standards Alignment")
        BulletList()
        ListItem():Strong("CSTA K-12 Computer Science Standards (2017): "):Text("3B-IC-27")
    end
end
