use Libraries.Web.Page.QuorumPage

/*
    Digital Information - Lesson 2: Representing Information.
    Converted from the old Lesson page by plan 13's generator: the same
    words, now without Tailwind.
*/
class CodeOrgUnit1L02 is QuorumPage

    on create
        SetLocation("lessons/code/internet/InternetLesson2.html")
        // The name lists and links use, and the series and track it belongs
        // to: its section and picture.
        SetShortTitle("Representing Information")
        SetSectionName("Digital Information")
        // For search engines and link previews, and what lists of pages say.
        SetDescription("Learning how the information is sent on the internet at the very fundamental level.")
        SetSummary("Explore how information can be represented and communicated")
    end

    action Setup
        SetWebPageTitle("Unit 1 Lesson 2: Representing Information")
        Title("Digital Information - Lesson 2: Representing Information")
        Paragraph("Understanding how digital information is sent in a physical system")
        Overview()
        GettingStarted5Minutes()
        Activity35Mins()
        WrapUp10Minutes()
        AssessmentCheckForUnderstanding()
        StandardsAlignment()
    end

    private action Overview
        Section("Overview")
        Paragraph("Using everyday materials, students create devices for sending information to a partner. Each group then uses its device to send an answer to a question. Following this, students modify their devices to answer more complex answers, responding with one of four possible messages, then one of eight possible messages.")
        Subsection("Goals")
        Paragraph("Students will be able to:")
        BulletList()
        ListItem("Explain how the same piece of information can be represented in a variety of different ways.")
        ListItem("Use a device to represent different pieces of information")
        ListItem("Use patterns to represent information")
        Subsection("Purpose")
        Paragraph("This lesson introduces the concept of sending bits of information from one place to another. While building and modifying their information sending devices students should eventually recognize that it's easier to invent a system of communication that used a combination of patterns with a simple device, rather than making a new, or increasingly complex device for each new problem. This lays the foundation for understanding how complex information is represented in computers using a combination of bits.")
        DiscussionGoal()
        Paragraph():Strong("Goal:"):Text(" More important than writing a formal definition of information is getting students discussing the term and its diverse forms. If students struggle with defining "):DoubleQuote():Text("information,"):DoubleQuote():Text(" modify the prompt by asking them to provide examples of information in their world such as texts, books, videos, music, conversations, etc.")
        EndCallout()
    end

    private action GettingStarted5Minutes
        Section("Getting Started (5 minutes)")
        Subsection("Remarks")
        BulletList()
        ListItem("A lot of people think that computer science is the study of computers, like the phone in your pocket or the computer on your desk. As we'll see this year, computer science actually has a lot more to do with information.")
        Paragraph():Strong("Discuss:"):Text(" What is your definition of information?")
        Paragraph("Have students silently write their own definition, then share with a partner, and finally have some volunteers share with the room.")
        BulletList()
        ListItem("There are many ways we can think about the word "):DoubleQuote():Text("information,"):DoubleQuote():Text(" but one possible definition we'll explore today is that information is the answer to a question.")
        ListItem("We're going to investigate what it takes to send that information back and forth to one another.")
    end

    private action Activity35Mins
        Section("Activity (35 mins)")
        Paragraph():Strong("Group:"):Text(" Place students in groups of two.")
        Paragraph():Strong("Distribute:"):Text(" Materials for students to build their binary message devices (straws, scissors, etc.)")
        Subsection("Remarks")
        BulletList()
        ListItem("Today you are going to build your own device for sending and receiving messages which you will use to answer questions that you write.")
        Subsection("Challenge #1")
        Paragraph():Strong("Do This:"):Text(" Write down a question that has two possible answers. Then, build a device out of classroom supplies to communicate the answer to your question.")
        Paragraph():Strong("Rules:")
        BulletList()
        ListItem("No projectiles.")
        ListItem("No language can be used. For example: If my question is "):DoubleQuote():Text("Is your favorite color blue or green?"):DoubleQuote():Text(" I can't write the words blue and green on my device.")
        Paragraph():Strong("Do This:"):Text(" After students have completed their devices, choose a few groups to demonstrate their device in action. Students stand on opposite sides of the classroom. One student asks the agreed upon question. The other student uses the device to communicate the answer.")
        Subsection("Challenge #2")
        Paragraph():Strong("Do This:"):Text(" Modify the answer to your question so there are now four possible answers. Then, update your device to communicate one of four possible answers to your question. Again, choose groups to demonstrate their updated devices.")
        Subsection("Challenge #3")
        Paragraph():Strong("Do This:"):Text(" Modify the answers to your question so there are now eight possible choices. Then, update your device to communicate one of eight possible answers to your question.")
        Paragraph("Consider:")
        BulletList()
        ListItem("Should you modify your device?")
        ListItem("Can you use it in a different way?")
        ListItem("Should you make a new device?")
        Paragraph("Do a final demonstration of devices before ending the activity.")
        TeachingTip()
        Paragraph():Strong("Challenge 1 - Questions with 2 Answers:"):Text(" In this activity, avoid the urge to give students a pre-written question or answers without allowing them time to struggle with the challenge. Encourage students to write down in their journal how their device works.")
        BulletList()
        ListItem("Example Question: Do you like strawberry or vanilla ice cream?")
        ListItem("Answer: strawberry (move my pencil up and down), vanilla (move my pencil side to side)")
        Paragraph():Strong("Challenge 2 - Questions with 4 Answers:"):Text(" Some students may add new ways of answering a question. Others may notice that they can reuse their previous responses, sending those responses in sequences that produce new messages. Avoid the urge to tell them to reuse the device, instead allowing them to explore their own ideas.")
        Paragraph():Strong("Challenge 3 - Questions with 8 or More Answers:"):Text(" At this point, students may start to realize that the way their device communicates information is not practical and could not be scaled up if there were for example, a thousand or a million possible answers.")
        EndCallout()
    end

    private action WrapUp10Minutes
        Section("Wrap up (10 Minutes)")
        BulletList()
        ListItem("Let's wrap up by discussing how you designed your devices and what that means about the questions you can ask and the messages you can send.")
        Paragraph():Strong("Prompt:"):Text(" Think back to your simple two-option device from Challenge #1. Instead of changing your device and adding more options every time you added more answers, how could you simply modify the way you use your device with only two options?")
        Subsection("Discussion Goal")
        Paragraph("Focus the discussion on why some groups created devices using unique options for each additional message, while other groups devised plans in which they reused the same device to create new combinations of the original two options.")
        Paragraph("Ultimately, groups begin to notice that, for example: instead of bending a straw in four different directions, they could simply bend the straw the same two ways multiple times.")
        BulletList()
        ListItem("Sample Question: Do you like strawberry, chocolate, vanilla, or peanut butter ice cream?")
        ListItem("Answers: strawberry (bend straw forward once), chocolate (bend straw forward twice), vanilla (bend straw backwards once), peanut butter (bend straw backwards twice)")
    end

    private action AssessmentCheckForUnderstanding
        Section("Assessment: Check for Understanding")
        Subsection("For Students")
        Paragraph("Open a word doc or google doc and copy/paste the following question.")
        Subsection("Question")
        Paragraph("Recall when you built your information sending device. Why did we decide to send a message as a sequence of two options rather than modifying our devices to represent more options?")
        Paragraph("For example: Modifications with two options")
        BulletList()
        ListItem("bend straw forward once")
        ListItem("bend straw backwards once")
        ListItem("bend straw forwards twice")
        ListItem("bend straw backwards twice")
        Paragraph("vs. Four options")
        BulletList()
        ListItem("bend straw forward")
        ListItem("bend straw backwards")
        ListItem("bend straw to the left")
        ListItem("bend straw to the right")
    end

    private action StandardsAlignment
        Section("Standards Alignment")
        BulletList()
        ListItem():Strong("CSTA K-12 Computer Science Standards (2017): AP"):Text(" - Algorithms & Programming: 3A-AP-21 - Evaluate and refine computational artifacts to make them more usable and accessible.")
        ListItem():Strong("CSTA K-12 Computer Science Standards (2011): DA"):Text(" - Data & Analysis: 2-DA-07 - Represent data using multiple encoding schemes, 3A-DA-09 - Translate between different bit representations of real-world phenomena, such as characters, numbers, and images.")
    end
end
