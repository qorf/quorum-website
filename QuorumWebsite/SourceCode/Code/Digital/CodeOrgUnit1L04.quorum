use Libraries.Web.Page.QuorumPage

/*
    Digital Information - Lesson 4: Binary Numbers.
    Converted from the old Lesson page by plan 13's generator: the same
    words, now without Tailwind.
*/
class CodeOrgUnit1L04 is QuorumPage
    // A double quote, for code and words that hold one.
    text dq = ""

    on create
        SetLocation("lessons/code/internet/InternetLesson4.html")
        // The name lists and links use, and the series and track it belongs
        // to: its section and picture.
        SetShortTitle("Binary Nunbers")
        SetSectionName("Digital Information")
        // For search engines and link previews, and what lists of pages say.
        SetDescription("Learning the Number Systems as a part of Computer Science Principles curriculum in Quorum Computer Science Principles curriculum page (this page correspond to the Code.org high school Computer Science Principles curriculum page). This page is accessible for the blind and visually imapaired.")
        SetSummary("Understanding number systems")
    end

    action Setup
        dq = dq:GetDoubleQuote()
        SetWebPageTitle("Unit 1 Lesson 4: Binary Numbers")
        Title("Digital Information - Lesson 4: Binary Numbers")
        Overview()
        GettingStarted5Minutes()
        Activity35Mins()
        WrapUp5Minutes()
        AssessmentCheckForUnderstanding()
        StandardsAlignment()
    end

    private action Overview
        Section("Overview")
        Paragraph("In this lesson, students will practice representing numbers in binary (base 2), transitioning from the circle-square representations they made in the last lesson. Students will create and use a "):DoubleQuote():Text("Flippy Do"):DoubleQuote():Text(", a manipulative which helps students convert between binary (base 2) and decimal (base 10) numbers. They will practice converting numbers and explore the concept of place value in the context of binary numbers.")
        Subsection("Goals")
        Paragraph("Students will be able to:")
        BulletList()
        ListItem("Represent decimal numbers using combinations of binary (base 2) digits 0 and 1")
        ListItem("Represent binary numbers using combinations of decimal (base 10) digits 0-9")
        ListItem("Explain how the position of each binary digit determines its place value and numeric value")
        Subsection("Purpose")
        Paragraph("This lesson is designed to give students as much time as possible using the Flippy Do to get comfortable with the relationship between binary and decimal numbers and the concept of place value.")
        Subsection("Resources")
        Subsubsection("Supplemental Code.org material")
        Paragraph("For the teachers")
        BulletList()
        ListItem():Link("How to Make a Flippy Do in print", "https://docs.google.com/document/d/1ecO5-Vg8eQVVvpjIUX8P0dAVX2Mi1-QW7zfIMFWeqgY/edit")
        ListItem():Link("Flippy Do worksheet in braille, Duxbury file", "/files/code/Unit1/U1L05_FlippyDoPro.dxb")
        ListItem():Link("Flippy Do worksheet in braille, .brf", "/files/code/Unit1/U1L05_FlippyDoPro.brf")
        Paragraph("For the students")
        BulletList()
        ListItem():Link("Activity Guide in print", "https://docs.google.com/document/d/1DmzViCZqIJTEPZQ2-aVa4Z-8_3PmzgRIS_XzzPbxXsU/edit")
        ListItem():Link("Activity Guide in braille, Duxbury file", "/files/code/Unit1/U1L05 Activity Guide Brl.dxb")
        ListItem():Link("Activity Guide in braille, .brf", "/files/code/Unit1/U1L05 Activity Guide Brl.brf")
    end

    private action GettingStarted5Minutes
        Section("Getting Started (5 minutes)")
        Paragraph():Strong("Discuss:"):Text(" Yesterday, you created your own number system using circles and squares. What can we communicate using only two symbols? Is there a limit?")
        Paragraph("Students should quietly write an answer, then share with a partner, then discuss with the whole class.")
        DiscussionGoal()
        Paragraph("In previous lessons, students represented information using two options. This is a quick thinking question to tap into students' prior knowledge and experiences. Once students have mentioned a few of the points below, they can move on.")
        BulletList()
        ListItem("The answer to a yes/no or true/false question")
        ListItem("Flipping a switch on/off")
        ListItem("Combinations of yes/no answers by using multiple symbols in a row")
        ListItem("We can keep adding more of the same symbols, so the only limit is how much space we have to write or store those symbols")
        EndCallout()
    end

    private action Activity35Mins
        Section("Activity (35 mins)")
        Paragraph():Strong("Lecture:"):Text(" Today's activity is introducing students to the binary number system. As a visual aid, you can use "):Link("Code.org's presentation slides for Unit 1, Lesson 4: Binary Numbers.", "https://docs.google.com/presentation/d/137WkLc4Lgld2cYrDrru-qAunb58S59GByTl4TpXWnrs/copy"):Text(" These slides use a lot of animations. The lecture notes below describe when to move to the next slide or click through an animation -- if you aren't using the slides, you can ignore these prompts.")
        Subsection("Lecture")
        Table("Lecture Slides")
        TableHeader():Cell("Slide"):Cell("Say")
        TableRow():Cell("Binary Numbers"):Cell("Today we are going to explore how Binary Numbers work.")
        TableRow():Cell("1 place value - 2 possible patterns"):Cell("With only one place value, we only have two possible patterns: circle or square. Click through animation. If using the slides. For this example I'm starting with circle, but we could easily start with square instead.")
        TableRow():Cell("2 place values = 4 possible patterns"):Cell("Click through animation. If using the slides. With two place values, we can make two sets of the previous patterns. Then, insert circles in front of the first set and squares in front of the second set. This makes four possible patterns.")
        TableRow():Cell("3 place values = 8 possible patterns"):Cell("Click through animation. If using the slides. For three place value patterns, we can make two copies of the two place value patterns. Then, just like we did before, fill in the first set with circles in front and the second set with squares in front. This makes 8 arrangements. Computer scientists like to start counting at 0!")
        TableRow():Cell("Instead of two shapes, what if we had 10 shapes?"):Cell("Instead of two shapes, what if we had 10 shapes?")
        TableRow():Cell("1 place value = Ten 1-shape patterns"):Cell("Click through animation. If using the slides. We could use more geometric shapes, or we could use letters, but the shapes we are used to are the numbers 0 through 9.")
        TableRow():Cell("2 places = one hundred 2-shape patterns"):Cell("With two places, we have one hundred 2-shape patterns. These are the numbers 00 through 99. Click through animation. If using the slides.")
        TableRow():Cell("Quiz: What comes next?"):Cell("What happens when we count up to the last shape? Suppose we have three value places, and the digits 0-9-9. Quick quiz! What comes after this number?")
        TableRow():Cell("Quiz: What comes next? (with answer to quiz)"):Cell("100! When we run up to the last shape, 9, we roll over back to 0 and add one in the next place to the left. This is the place value that we have used all our lives.")
        TableRow():Cell("Where is this heading?"):Cell("Where is this heading? Click through animation. If using the slides.")
        TableRow():Cell(dq + "Binary" + dq + " is a number system with 2 shapes..."):Cell("Binary is a number system with two shapes. Click through animation. If using the slides")
        TableRow():Cell("Making Organized Lists -> Counting in Binary"):Cell("Click through animation. If using the slides. Instead of shapes, we use 0's and 1's. In this example, each pattern maps to a decimal number from 0 to 7.")
        TableRow():Cell("Make Your Flippy Do!"):Cell("For today's activity, you will be creating your own Flippy Do. This is a tool that will allow you to quickly and easily translate between the decimal number base we are used to as humans and the binary number base that computers use. Hand out the Flippy Do templates - one per student. Lead students through completing their Flippy Do's using the steps below, or following the slide as a guide. If you chose to give students already-completed Flippy Do's, explain the meaning of each row and how to use the Flippy Do.")
        TableRow():Cell("Each place value represents one " + dq + "bit" + dq + "..."):Cell("Each place value represents one " + dq + "bit" + dq + " which is short for " + dq + "binary digit" + dq + ". A binary digit can be a zero or a one. Your flippy do has eight " + dq + "bits" + dq + ". Click through animation. If using the slides. Together, eight place values, or " + dq + "bits" + dq + ", makes up one " + dq + "byte" + dq + ". Since computers represent information digitally, the lowest level components of information are bits.")
        TableRow():Cell("Try Out Your Flippy Do!"):Cell("Use your Flippy Do to try out these problems: 7 and 20. Represent these decimal numbers in binary: 0001 0010 and 0001 1111")
        Subsection("Flippy Do Instructions")
        NumberedList()
        ListItem("In the top-right cell of the Flippy Do, write the first power of 2, 20. In the cell to left, write the next power of 2, 21. Do this until you've finished the entire top row. The last value should be 27.")
        ListItem("In the second row, write the whole number equivalent of each power of two in the cell above. For example, the right-most cell in the second row should read "):DoubleQuote():Text("1"):DoubleQuote():Text(", because that is the value of 20 in the cell just above it.")
        ListItem("In the third row, write a "):DoubleQuote():Text("0"):DoubleQuote():Text(" in each cell.")
        ListItem("Write a "):DoubleQuote():Text("1"):DoubleQuote():Text(" on the "):Strong("back"):Text(" of each flap on the bottom -- these will be flipped up over the zeroes in the third row. Make sure the ones aren't upside down when they're flipped!")
        ListItem("Cut on the dotted lines at the bottom.")
        Subsubsection("Continue with the FlippyDo")
        Paragraph():Strong("Note:"):Text(" It may be necessary to demonstrate how values can be calculated by flipping up a "):DoubleQuote():Text("1"):DoubleQuote():Text(" for each value required to arrive at the sum of values equal to the decimal number.")
        Paragraph("Represent these decimal numbers in binary:")
        Paragraph():Strong("Try:"):Text(" Try Out Your Flippy Do!")
        Paragraph():Strong("Do This:"):Text(" Use your Flippy Do to try out these problems:")
        Paragraph("For example, To convert the decimal number 10, I would flip up a one in the 8's position, because eight can fit in 10 (The next bit to the left is 16, which is too big). Then I have 2 left. I flip up a one in the 2's position. This gives me the binary number "):DoubleQuote():Text("1010"):DoubleQuote():Text(", which means 10 in decimal.")
        Paragraph("If students are having a difficult time understanding the rules of the system, remind them of the concept of place value and relate to base 10.")
        Paragraph():Strong("Try:"):Text(" Flippy Do Activity Guide")
        Paragraph():Strong("Say:"):Text(" Let's continue to practice with our own two number bases, decimal and binary. After you finish each of the four parts of the Activity Guide, I want you to check your work with your partner. Feel free to use your Flippy Do as you work.")
        Paragraph():Strong("Distribute:"):Text(" Activity Guide")
        Paragraph():Strong("Note:"):Text(" Encourage students to use their Flippy Do as a resource.")
        BulletList()
        ListItem():Strong("Challenge 1 - All 4-bit Numbers:"):Text(" Students should produce all binary numbers with a length of 4 bits, from 0000 to 1111. They should see that all odd numbers end in 1 and even numbers end in 0. Students may also notice that the binary digits increasingly "):DoubleQuote():Text("roll-over"):DoubleQuote():Text(" to 1's (from right to left) as numbers become larger and larger.")
        ListItem():Strong("Challenge 2 - Binary Numbers with Exactly One 1:"):Text(" The goal here is for students to systematically find all binary numbers that have all zeros, except for one bit. Students should notice that the resulting decimal values are all powers of 2.")
        ListItem():Strong("Challenge 3 - Conversion Practice:"):Text(" This section gives students more practice converting between number bases. The last two decimal numbers, 256 and 513, are too big to represent using the Flippy Do, however students should make the connection that more bits could be added to the left of the Flippy Do using increasing powers of 2.")
        ListItem():Strong("Challenge 4 - Putting it all Together:"):Text(" The last three questions on the Activity Guide ask students to apply their understanding to new situations. The first question asks them to consider odd values. The last two questions ask students to think about how many bits are required to represent specific values in binary.")
        Paragraph():Strong("Note:"):Text(" As you circulate, take an opportunity to be a Lead Learner. Help students discover the items below using the suggested questions:")
        BulletList()
        ListItem():Strong("Reading a number vs. Placing a Number:"):Text(" Do we fill in the places on the Flippy Do starting on the left or right? Does it matter? (Yes. If we have a 5-bit number, we actually use the 5 bits on the far right. If we were to use the bits on the far left, this changes the value of the number. This is similar to adding more zeros to a decimal number.)")
        ListItem():Strong("Highest value possible with a given number of bits:"):Text(" What is the largest number we can make with 4 bits? Is the last number we can make always odd? (A meaningful pattern is that we can count as high as one less than the next bit on the left. If we have four bits, we can count up to the number 15, because the next bit has a value of 16.)")
        ListItem():Strong("Number of numbers we can make:"):Text(" How many total unique numbers are possible with 4 bits? (This is a base 2 number system. With each new bit, we double the amount of unique numbers we can make. With four bits, we can make the decimal numbers 0 to 15 (0000 to 1111), for a total of 16 unique numbers.)")
    end

    private action WrapUp5Minutes
        Section("Wrap up (5 Minutes)")
        Subsection("Remarks")
        BulletList()
        ListItem("It's important to know the differences between binary and decimal number systems. As a review, the decimal number system is base-10. There are ten different symbols used to represent numbers (0-9). The binary numbers system is base-2. There are two different symbols used to represent numbers (0-1). Using our Flippy Do, we can convert between Binary and Decimal number systems.")
        ListItem("While it is easier for humans to use the decimal number system in our everyday lives, we will see later in this unit how electrical signals inside computers can be best represented by using the the binary number system.")
        TeachingTip()
        Paragraph():Strong("Number Bases:"):Text(" Number bases help us express data and reason about quantities. With ten digits on our hands and feet, the decimal (base 10) number base was natural for humans to develop. The ten symbols we use for this number base are the digits 0-9. For a computer, however, it makes more sense that data be represented in binary (base 2), as this can easily be interpreted with electrical switches set to two states: ON or OFF. The two symbols we use for this number base are the digits 0 and 1.")
        Paragraph("Both number bases take advantage of the concept of place value. In decimal, numbers are composed of powers of 10, increasing in value from right to left. Binary is similar, however we use powers of 2 (1, 2, 4, 8, 16, etc.). Expressed in binary, these values are 1, 10, 100, 1000, 10000, and so on. These make up the incremental place values in the binary number system.")
        Paragraph():Strong("Why Binary?:"):Text(" Students will see in a later lesson how computers use binary numbers as a representation of electrical signals on a wire. The wire is always set to one of two different options: on or off. Off can be reprsented with a 0 and on with a 1.")
        EndCallout()
        Paragraph():Strong("Prompt:"):Text(" Now that we've had a chance to practice, let's find out what we've learned and what we still have questions about. Write down:")
        BulletList()
        ListItem("3 things you learned today")
        ListItem("2 things you found interesting")
        ListItem("1 question you still have.")
        DiscussionGoal()
        Paragraph("Use this exercise to help assess what students learned and what needs to be clarified.")
        EndCallout()
        Subsection("Journal")
        Paragraph("Add to your journal the vocab definition for bit and byte.")
        BulletList()
        ListItem():Emphasis("bit:"):Text(" A contraction of "):DoubleQuote():Text("Binary Digit"):DoubleQuote():Text("; the single unit of information in a computer, typically represented as a 0 or 1")
        ListItem():Emphasis("byte:"):Text(" 8 bits (For example 10010101)")
    end

    private action AssessmentCheckForUnderstanding
        Section("Assessment: Check for Understanding")
        Subsection("For Students")
        Paragraph("Open a word doc or google doc and copy/paste the 3 following question.")
        Subsection("Question 1")
        Paragraph("How many bits would be needed to count all of the students in class today?")
        Subsection("Question 2")
        Paragraph("Each time we add another bit, what happens to the amount of numbers we can make?")
        Subsection("Question 3")
        Paragraph("What are the similarities and differences between the binary and decimal systems?")
    end

    private action StandardsAlignment
        Section("Standards Alignment")
        BulletList()
        ListItem():Strong("CSTA K-12 Computer Science Standards (2017): DA"):Text(" - Data & Analysis: 3A-DA-09 - Translate between different bit representations of real-world phenomena, such as characters, numbers, and images.")
        ListItem():Strong("CSP2021: "):Text("DAT-1.A.2, DAT-1.A.3, DAT-1.A.4, DAT-1.C.1, DAT-1.C.2, DAT-1.C.3, DAT-1.C.4, DAT-1.C.5")
    end
end
