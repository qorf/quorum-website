use Libraries.Web.Page.QuorumPage

/*
    Digital Information - Lesson 7: Black and White Images.
    Converted from the old Lesson page by plan 13's generator: the same
    words, now without Tailwind.
*/
class CodeOrgUnit1L07 is QuorumPage

    on create
        SetLocation("lessons/code/internet/InternetLesson7.html")
        // The name lists and links use, and the series and track it belongs
        // to: its section and picture.
        SetShortTitle("Black and White Images")
        SetSectionName("Digital Information")
        // For search engines and link previews, and what lists of pages say.
        SetDescription("Learn about the ASCII protocol and how to encode text")
        SetSummary("how to encode black and white images")
    end

    action Setup
        SetWebPageTitle("Unit 1 Lesson 7: Black and White Images")
        Title("Digital Information - Lesson 7: Black and White Images")
        Overview()
        GettingStarted5Minutes()
        Activity35Mins()
        WrapUp5Minutes()
        AssessmentCheckForUnderstanding()
        StandardsAlignment()
    end

    private action Overview
        Section("Overview")
        Paragraph("Students explore how black and white images are represented. Students use the black and white pixelation widget to represent each pixel of an image with black or white light. They learn how to sample an analog image using small squares of uniform size (each represented with a black or white value) and reflect on the pros and cons of choosing a smaller or larger square size when sampling.")
        Subsection("Goals")
        Paragraph("Students will be able to:")
        BulletList()
        ListItem("Explain how bits can be used to represent the individual pixels of a black and white image")
        ListItem("Explain how sampling is used to create a digital form of an analog image")
        Subsection("Purpose")
        Paragraph("Throughout this unit, students gradually discover how to use bits to represent more complex data types. In this case, students work on representing images using sampling. Students quickly realize that very tiny sample squares are needed to approximate an image's curves and small details. The smaller we make each sample, the more bits are needed. Students must also wrestle with deciding whether each square should be a 0 or 1, as many squares have both white and black in the same square. They will have more control over the representation of each bit in the next lesson.")
        Subsection("Resources")
        BulletList()
        ListItem():Link("Getting Started with Quorum Studio", "https://quorumlanguage.com/tutorials/language/gettingStarted.html")
        ListItem():Link("Introduction To Git/Version Control", "https://quorumlanguage.com/tutorials/language/teamsAndVersionControl.html")
        ListItem():Link("CSP-Widgets repository", "https://github.com/qorf/CSP-Widgets")
        Paragraph("To download the CSP Widget repository using Git, clone this url: "):Code("https://github.com/qorf/CSP-Widgets.git")
        Subsubsection("Supplemental Code.org material")
        Paragraph("For the students")
        BulletList()
        ListItem():Link("B&W Pixelation Tutorial", "https://youtu.be/rJOa5Q5a1WM")
        ListItem():Link("U1L7 Black and White Images - Activity Guide", "https://docs.google.com/document/d/1-W0LMRihs84dIlC6VwKowq3FcTE3hCZGes8Duda1TqM/edit?usp=sharing")
    end

    private action GettingStarted5Minutes
        Section("Getting Started (5 minutes)")
        Paragraph():Strong("Prompt:"):Text(" You recently did some online shopping and are expecting a package to arrive in about a month. The delivery service has a tracking system which reads the location of the package.")
        Paragraph("How often would you want the location read? Every week? Every day? Every hour? Every minute? Be ready to explain your answer.")
        Paragraph():Strong("Discuss:"):Text(" Students should think for a minute, then share with a partner. Once students have shared, call on a few students to explain their answers with the class.")
        Paragraph():Strong("Discussion Goal:"):Text(" The goal here is for students to realize that, depending on the situation, we may want to take readings more frequently. Later in the lesson as students interact with the widget, you can help students make connections that the frequency of readings affects the digital representation that we obtain.")
        Subsection("Remarks")
        BulletList()
        ListItem("Thank you for sharing your insights. It seems to depend on the situation. Sometimes we want to take a reading of the location more frequently. Today, we're actually learning about how images are represented in computers, but let's keep in mind these ideas about how often to take a reading or measurement.")
    end

    private action Activity35Mins
        Section("Activity (35 mins)")
        Subsection("The Pixelation Widget (10 minutes)")
        Paragraph("For today's activity, each student will use the Pixelation Widget, which can be found in the "):Link("CSP-Widgets repository", "https://github.com/qorf/CSP-Widgets"):Text(". Each widget is a Quorum project which you can run inside of Quorum Studio.")
        Paragraph("Here are a few resources you can use to guide you through using Quorum Studio and downloading the repository:")
        BulletList()
        ListItem():Link("Getting Started with Quorum Studio", "https://quorumlanguage.com/tutorials/language/gettingStarted.html")
        ListItem():Link("Introduction To Git/Version Control", "https://quorumlanguage.com/tutorials/language/teamsAndVersionControl.html")
        ListItem():Link("CSP-Widgets repository", "https://github.com/qorf/CSP-Widgets")
        Subsection("Using the Pixelation Widget")
        Paragraph():Strong("Display (Optional):"):Text(" Watch the "):Link("Code.org pixelation widget video", "https://www.youtube.com/watch?v=rJOa5Q5a1WM&feature=youtu.be"):Text(". The widget shown is different than the one we will use, but the primary concept (using 1's and 0's to set pixel colors) is the same.")
        Video("https://www.youtube.com/embed/rJOa5Q5a1WM?si=Fy4lrXKGcfTljPVf", "Intro to Pixelation Encoding B & W")
        TeachingTip()
        Paragraph("Students type in the textbox on the right to sequentially set pixel values. Typing a 1 will make the next pixel white, and typing a 0 will make the next pixel black.")
        Paragraph("Students can set the width and height of the image using the text fields at the top of the widget. You can ignore the settings for colored pixels or bits per pixel for now -- these will be used in a future lesson.")
        Paragraph("The widget is accessible with screen readers. While using a screen reader, students can focus on the pixel region, then use the arrow keys to inspect how bright each pixel on the grid is. The first grid coordinate, (0, 0), is in the top left corner.")
        Paragraph("You can also increase or decrease the size of all text in the widget using the CONTROL + PLUS or CONTROL + MINUS keyboard shortcuts, respectively.")
        EndCallout()
        TeachingTip()
        Paragraph("Not all students can see color, like students that are color blind or part of the visually impaired community. This lesson embeds alternate descriptions that can describe these colors to these students. Students that can see color may explore these alts or come up with their own to see how they work.")
        EndCallout()
        Paragraph():Strong("Do This:")
        Paragraph():Strong("Level 2:"):Text(" Students will recreate the letter A as shown in the image below using the black and white Pixelation Widget. They must first use the fields at the top of the widget to adjust the width and height of the image. Then, they will type the appropriate bit for each portion of the image ("):DoubleQuote():Text("0"):DoubleQuote():Text(" for black, "):DoubleQuote():Text("1"):DoubleQuote():Text(" for white).")
        Paragraph():Strong("Level 3: "):Text("Students must find and delete the extra bit that is causing the image to be distorted.")
        Image("media/lessons/csp/unit1/Unit1-7_Activity_Image.png", "A 3 by 5 image in the Pixelation Widget depicting a simple A. Every pixel in the left and right columns black, except for the top row, which is white. The middle column is all white, except for a pixel in the top row and another in the middle row, which are both black.")
        TeachingTip()
        Paragraph("The point of this activity is to get students familiar with the tool and practice entering the bits. Once most of the class has finished, you can move on, or optionally give students another challenge of your choosing to practice with. Encourage students who are finished to help those who haven't.")
        EndCallout()
        Subsection("Sampling an Analog Image (20 minutes)")
        BulletList()
        ListItem("Now that you've had a chance to see how to set each pixel black or white, we are going to use the widget to represent an analog image using a process called sampling.")
        ListItem("What is an analog? It's a term used to mean something with continuous representation - such as a picture you draw on a piece of paper. Each pencil line smoothly connects to the next, no matter how much you zoomed in on the picture with a magnifying glass.")
        ListItem("When we represent an analog image digitally, we will have to make some choices on how to sample the image to get the smoothest representation possible while keeping in mind the number of bits it takes to build that image.")
        ListItem("What does it mean to sample? We are choosing how small to make section of the picture we look at when deciding whether to make it black or white. The smaller the sample, the more pixels required to represent that image. Larger samples require less pixels, but the image can become blurry.")
        ListItem("Try it out yourself!")
        Subsection("Challenges A,B, & C")
        TeachingTip()
        Paragraph():Strong("Questions to Ask as You Circulate:"):Text(" As students think about a good analog to put into the widget, circulate the room and ask pairs of students questions about their process:")
        BulletList()
        ListItem("How are you deciding whether each square should be black or white?")
        ListItem("Do you think this process will give a good representation of the image? Why or why not?")
        ListItem("What would you change about the sampling process to produce a better representation of the image?")
        Paragraph():Strong("Alternative Strategies:"):Text(" While working with students with visual impairments, rather than using the images on the supplemental worksheet, you might consider asking your students to use geometric shapes as an analog source. Here are a couple of examples:")
        BulletList()
        ListItem():Emphasis("Triangles "):Text("- While one or two sides of a triangle might align with the pixel grid, at least one side will be angled. At larger sample sizes, the angled edge may feel more jagged, rather than a smooth line.")
        ListItem():Emphasis("Circles"):Text(" - Curved edges are particularly difficult to represent with large samples. If the dimensions of the grid are extremely small, such as 2x2, a circle can be indistinguishable from a square.")
        EndCallout()
        Paragraph():Strong("Do This:")
        Paragraph("For the next two challenges have students try and represent numbers, letters, and possibly a simple shape in the widget.")
        Subsubsection("Challenges A")
        BulletList()
        ListItem("Begin with a 3 by 5 grid and input the values into the widget. Use a 0 for black and 1 for white.")
        ListItem("When you are finished see if a partner or the instructor can guess what you represented")
        Paragraph("Answer the following questions after the challenge:")
        BulletList()
        ListItem("What was the total number of grid spaces that you used?")
        ListItem("Did they guess correct?")
        Subsubsection("Challenges B")
        BulletList()
        ListItem("Repeat for another number, letter, or simple shape this time use a larger grid (say 7 by 5).")
        Paragraph("Answer the following questions after the challenge:")
        BulletList()
        ListItem("What was the total number of grid spaces that you used?")
        ListItem("Did they guess correct?")
        ListItem("Was it easier or harder to guess this time?")
        Paragraph():Strong("Regroup:"):Text(" After students have finished Challenge A & Challenge B, discuss the challenges they encountered while completing the challenges. Then direct students on to Challenge C.")
        Subsubsection("Challenges C")
        Paragraph():Strong("Do This:")
        BulletList()
        ListItem("Select your favorite tactile company logo")
        ListItem("Decide how you are going to sample this logo - what is the plan for representing the logo in the widget?")
        ListItem("Recreate the logo in the Pixelation Widget.")
        ListItem("Run the widget. Do they recognize the logo? Make adjustments if needed. For example: You may need to increase the gridsize.")
    end

    private action WrapUp5Minutes
        Section("Wrap up (5 Minutes)")
        Paragraph():Strong("Discuss:"):Text(" In first two challenges, you and your partner practiced sampling the same image twice. The second time, we did a more frequent sampling by using a larger gridsize.")
        BulletList()
        ListItem("What are the pros and cons of sampling an image more frequently?")
        Paragraph():Strong("Discuss:"):Text(" Allow students time to think, then have them share in pairs or groups of four. Call on a few students to share with the whole class.")
        Paragraph():Strong("Discussion Goal:"):Text(" We want students to start seeing that there are advantages and disadvantages as a result of decisions we make when we represent data digitally. Some key points to draw out from students:")
        BulletList()
        ListItem():Strong("Pros:"):Text(" We get a much more smooth/clearer/accurate representation of the analog image. A little easier to decide whether to make a square black or white.")
        ListItem():Strong("Cons:"):Text(" More bits are needed. Took longer to enter in the widget. Still doesn't exactly replicate the analog.")
        Subsection("Remarks")
        BulletList()
        ListItem("Thank you for sharing. It looks like there are several advantages and disadvantages when it comes to sampling more frequently by using smaller squares. We get a better approximation of the analog image when we do more frequent sampling and it was a little easier to decide whether each square should be set to black or white. However, it took longer and we needed a lot more bits. We still got an image that didn't represent the image accurately enough, though.")
        ListItem("Fortunately, a computer does this process much more quickly than we can, and it can store thousands or even millions of bits to represent an analog image.")
        ListItem("By this point, we've used bits to represent numbers, text, and images. The same sequence of bits can represent different types of data depending on the context. It all comes down to 0s and 1s!")
        Subsection("Journal")
        Paragraph("Have students add definitions to their journals for: analog data, digital data, and sampling.")
        BulletList()
        ListItem():Emphasis("Analog Data:"):Text(" Data with values that change continuously, or smoothly, over time. Some examples of analog data include music, colors of a painting, or position of a sprinter during a race.")
        ListItem():Emphasis("Digital Data:"):Text(" Data that changes discreetly through a finite set of possible values.")
        ListItem():Emphasis("Sampling:"):Text(" A process for creating a digital representation of analog data by measuring the analog data at regular intervals called samples.")
    end

    private action AssessmentCheckForUnderstanding
        Section("Assessment: Check for Understanding")
        Subsection("For Students")
        Paragraph("Open a word doc or google doc and copy/paste the 3 following question.")
        Subsection("Question 1")
        Paragraph("Assume your friend just sent you 32 bits of pixel data (just the 0s and 1s for black and white pixels) that were encoded after sampling an image. Choose the two statements that are true.")
        BulletList()
        ListItem("The 32 bits of pixel data is enough to produce the image using the widget. Nothing else is needed.")
        ListItem("The digital image would be an exact copy of the analog image.")
        ListItem("The correct width and height must be input into the pixelation widget to produce the image.")
        ListItem("The fact that only 32 bits were used to represent the image indicates relatively large sample squares were used. The digital image may vary from the analog image significantly.")
        Subsection("Question 2")
        Paragraph("Which of the following would result in a better digital approximation of an analog black and white image?")
        BulletList()
        ListItem("Increasing the size of each sample square, thus decreasing the number of samples taken.")
        ListItem("Decreasing the size of each sample square, thus increasing the number of samples taken.")
        ListItem("Using fewer bits to represent the image.")
        ListItem("Using decimal numbers to represent each pixel.")
        Subsection("Question 3")
        Paragraph("Your computer science teacher asks you to sample a black and white image that is 4"):DoubleQuote():Text("by 6"):DoubleQuote():Text(". How would you sample the image to provide a good digital approximation using the pixelation widget? What sample size would you use? How would your decision affect the digital representation?")
    end

    private action StandardsAlignment
        Section("Standards Alignment")
        BulletList()
        ListItem():Strong("CSTA K-12 Computer Science Standards (2017): CS"):Text(" - Computing Systems: 3A-CS-02 - Compare levels of abstraction and interactions between application software, system software and hardware layers.")
        ListItem():Strong("CSTA K-12 Computer Science Standards (2017): DA"):Text(" - 2-DA-07 - Represent data using multiple encoding schemes. 3A-DA-09 - Translate between different bit representations of real-world phenomena, such as characters, numbers, and images.")
        ListItem():Strong("CSP2021: "):Text("DAT-1.A.10, DAT-1.A.7, DAT-1.A.8")
    end
end
