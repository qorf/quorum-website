use Libraries.Web.Page.QuorumPage

/*
    Digital Information - Lesson 12: Digital Information Dilemmas Part 2.
    Converted from the old Lesson page by plan 13's generator: the same
    words, now without Tailwind.
*/
class CodeOrgUnit1L13 is QuorumPage

    on create
        SetLocation("lessons/code/internet/InternetLesson13.html")
        // The name lists and links use, and the series and track it belongs
        // to: its section and picture.
        SetShortTitle("Project - Digital Information Dilemmas Part 2")
        SetSectionName("Digital Information")
        // For search engines and link previews, and what lists of pages say.
        SetDescription("Complete your digital information projects")
        SetSummary("Project - Digital Information Dilemmas Part 2")
    end

    action Setup
        SetWebPageTitle("Unit 1 Lesson 13: Project - Digital Information Dilemmas Part 2")
        Title("Digital Information - Lesson 12: Digital Information Dilemmas Part 2")
        Overview()
        GettingStarted5Minutes()
        Activity50Mins()
        WrapUp5Minutes()
        AssessmentSubmit()
        StandardsAlignment()
    end

    private action Overview
        Section("Overview")
        Paragraph("In this lesson students finish designing an artifact that represents their analysis of an article on the impacts of digitizing information. Students will complete the final two quadrants of their poster in which they identify the benefits and harms highlighted in the article and then make an overall claim about whether the world has been made better or worse through the digitization of information. At the conclusion of the class students update the position of their stickies on the "):DoubleQuote():Text("better"):DoubleQuote():Text(" to "):DoubleQuote():Text("worse"):DoubleQuote():Text(" spectrum they designed yesterday and then discuss whether and why they changed their opinion.")
        Subsection("Goals")
        Paragraph("Students will be able to:")
        BulletList()
        ListItem("Argue whether the digitization of information has broadly speaking improved or damaged society")
        ListItem("Examine articles to identify the social benefits and harms caused by information digitization")
        Subsection("Purpose")
        Paragraph("This lesson is a continuation of the major unit project. Students continue to consider broad societal questions about the impacts of computing and the ways it is changing their world.")
        Subsection("Resources")
        Subsubsection("Additional Code.org material")
        Paragraph("For the students")
        BulletList()
        ListItem():Link("Project Rubric", "https://docs.google.com/document/d/14rAnNQCTjhGgWCqnVo4XczoNEDFM-oYLNqhJvLW-88Q/edit?usp=sharing")
    end

    private action GettingStarted5Minutes
        Section("Getting Started (5 minutes)")
        Subsection("Remarks")
        BulletList()
        ListItem("Yesterday you began making a position poster based on an article you read. Today we are going to finish that up before debating our positions!")
        TeachingTip()
        Paragraph():Strong("Get to the Activity:"):Text("The warm-up is short today. Continue on to the activity as soon as possible to give students the maximum amount of time to complete their posters.")
        EndCallout()
    end

    private action Activity50Mins
        Section("Activity (50 mins)")
        Subsection("Position Posters (15 minutes)")
        Paragraph():Strong("Do This:"):Text(" Use the lesson slides to guide students through completing their position posters.")
        TeachingTip()
        Paragraph("Encourage students to find creative ways to represent the information in each quadrant.")
        EndCallout()
        Paragraph():Strong("Do This:"):Text(" Complete quadrants 3 & 4.")
        BulletList()
        ListItem():Strong("Quadrant 3:"):Text(" What are the benefits and harms of digitizing this content?")
        ListItem():Strong("Quadrant 4:"):Text(" Is our world better or worse because of digital representation? Explain why, giving examples from the article.")
        Subsection("Jigsaw (10 minutes)")
        Paragraph():Strong("Group:"):Text(" Place students in groups with one representative for each article.")
        Paragraph():Strong("Discuss:"):Text(" Students share their position papers and discuss the articles they read with their groups.")
        Subsection("Digital Dilemma Debate (10 minutes)")
        BulletList()
        ListItem("In the last class, we started the lesson by placing a sticky note on a spectrum. Based on your jigsaw discussions, put a sticky note back on the board. Has your position changed since yesterday?")
        ListItem("Where do you stand?")
        Paragraph():Strong("Do This:"):Text(" Students move their sticky notes along the spectrum of worse to better.")
        Subsubsection("Remarks")
        BulletList()
        ListItem("Now, where does our class stand? Where do the majority of our sticky notes fall on the spectrum? Let's consider our group position.")
        Paragraph():Strong("Debate:"):Text(" Is our world better or worse because of digital representation?")
        DiscussionGoal()
        Paragraph("At this point, open the floor for general discussion. Students should state their case for the group position, referencing the articles and sharing from their own experiences.")
        EndCallout()
        Paragraph():Strong("Do This:"):Text(" Conclude the debate by grouping all sticky notes into a single location on the spectrum to represent the majority position of the class.")
    end

    private action WrapUp5Minutes
        Section("Wrap up (5 Minutes)")
        BulletList()
        ListItem("There are trade-offs in representing information digitally. Usually someone is benefitting while others are harmed.")
        Paragraph():Strong("Prompt:"):Text(" Why should we care about information being represented digitally? How does this impact you personally?")
        DiscussionGoal()
        Paragraph("Allow students time to think and share about the personal implications of digital representation.")
        EndCallout()
    end

    private action AssessmentSubmit
        Section("Assessment: Submit")
        Paragraph("Students turn in both of the pieces of their project for assessment:")
        BulletList()
        ListItem("Annotated article")
        ListItem("Position Projects")
    end

    private action StandardsAlignment
        Section("Standards Alignment")
        BulletList()
        ListItem():Strong("CSTA K-12 Computer Science Standards (2017): IC"):Text(" - Impacts of Computing: 2-IC-20 - Compare tradeoffs associated with computing technologies that affect people's everyday activities and career options, 3A-IC-24 - Evaluate the ways computing impacts personal, ethical, social, economic, and cultural practices, 3A-IC-28 - Explain the beneficial and harmful effects that intellectual property laws can have on innovation.")
    end
end
