use Libraries.Web.Page.QuorumPage

/*
    Digital Information - Lesson 10: Lossy Compression.
    Converted from the old Lesson page by plan 13's generator: the same
    words, now without Tailwind.
*/
class CodeOrgUnit1L10 is QuorumPage

    on create
        SetLocation("lessons/code/internet/InternetLesson10.html")
        // The name lists and links use, and the series and track it belongs
        // to: its section and picture.
        SetShortTitle("Lossy Compression")
        SetSectionName("Digital Information")
        // For search engines and link previews, and what lists of pages say.
        SetDescription("Learn about lossy compression")
        SetSummary("examine how lossy compression works")
    end

    action Setup
        SetWebPageTitle("Unit 1 Lesson 10: Lossy Compression")
        Title("Digital Information - Lesson 10: Lossy Compression")
        Overview()
        GettingStarted5Minutes()
        Activity30Mins()
        WrapUp5Minutes()
        AssessmentCheckForUnderstanding()
        StandardsAlignment()
    end

    private action Overview
        Section("Overview")
        Paragraph("Students are introduced to lossy compression via the Lossy Text Compression widget. They apply this concept and their prior knowledge of sampling to create their own lossy compressions of image files using the Lossy Image Widget. Students then discuss several practical scenarios where they need to decide whether to use a lossy or lossless compression algorithm. The lesson ends with a discussion of the situations where lossless compression is important and the situations where lossy compression is important.")
        Subsection("Goals")
        Paragraph("Students will be able to:")
        BulletList()
        ListItem("Examine the effects of lossy compression on text & images")
        ListItem("Given a piece of media, decide whether to use lossy or lossless compression based on the needs of a situation")
        Subsection("Purpose")
        Paragraph("After exploring lossless compression in yesterday's lesson, students are introduced to lossy compression. A theme throughout the lesson is that lossy compression can greatly reduce the file size, but it can also greatly reduce the quality and it's important to find that balance between quality and file size. The real challenge here is finding where that line is - how much can we compress but still keep it recognizable? In the final discussion, students compare lossy compression with lossless compression to see that each has value depending on the situation - lossy is useful when file size needs to be minimized, but lossless is important when its vital to be able to reconstruct the original image.")
    end

    private action GettingStarted5Minutes
        Section("Getting Started (5 minutes)")
        Subsection("Remarks")
        BulletList()
        ListItem("This widget claims you can keep the first letter of a word then remove all of the vowels and the result will still be readable. Let's test this out - what are some other sentences we should try with this widget?")
        Paragraph():Strong("Do This: "):Text("Use the "):Link("the Lossy Compression project", ""):Text(" and try out a few phrases.")
        Paragraph():Strong("Prompt:"):Text(" How is this widget similar to the widget we used yesterday? How is it different?")
        Subsubsection("Discussion Goal")
        Paragraph("Students should identify that this widget is similar to yesterday's text compression widget because it also shortens text, but it is different in that some of the information is permanently lost when it is shortened. You can emphasize this point by supplying some carefully-chosen sample text and seeing that the results can be ambiguous:")
        Paragraph():DoubleQuote():Text("there are three tiers of tires at the shop"):DoubleQuote()
        Paragraph("Students may debate whether or not this really fits the definition of compression we saw yesterday, which is a great bridge to the next part of the lesson.")
    end

    private action Activity30Mins
        Section("Activity (30 mins)")
        Subsection("Remarks")
        BulletList()
        ListItem("Yesterday's widget was an example of "):Strong("lossless compression"):Text(" because we could always reverse the process to recreate the original. This widget is an example of "):Strong("lossy compression"):Text(" because some information gets lost, making this process not reversible. In today's lesson, we will investigate how lossy compression works with images.")
        Paragraph("The Code.org lesson plan has a visual activity here that is currently not included in this lesson plan.")
        Subsection("Compression Decisions (10 minutes)")
        Paragraph():Strong("Prompt:"):Text(" Let's imagine we are trying to use this image for a particular purpose, and we need to decide how much compression we want to use. We will look at a series of scenarios and we will)vote on how much compression is appropriate.")
        BulletList()
        ListItem():Strong("Scenario 1:"):Text(" You are sending this as a text message to a friend but you've almost run out of data on your phone plan")
        ListItem():Strong("Scenario 2:"):Text(" You are a crime-scene photographer and this image is part of a crime-scene photo")
        ListItem():Strong("Scenario 3:"):Text(" This image is part of a satellite imaging assignment for the military, being used for intelligence gathering")
        ListItem():Strong("Scenario 4:"):Text(" You are a Social Media manager posting this to an Instagram story for an event happening right now")
        ListItem():Strong("Scenario 5:"):Text(" This image will be part of a collage where 100 copies will be stitched together to make a larger image")
        ListItem():Strong("Scenario 6:"):Text(" You are a professional photographer submitting to a design competition where your submission will be carefully judged for color & composition")
        TeachingTip()
        Paragraph("After voting, briefly discuss each scenario and come to a classroom consensus on the best option.")
        Paragraph("Note that there is not necessarily one "):DoubleQuote():Text("correct answer"):DoubleQuote():Text(" to these scenarios the goal here is to weigh the pros and cons and make an informed decision.")
        EndCallout()
    end

    private action WrapUp5Minutes
        Section("Wrap up (5 Minutes)")
        Subsection("Prompt")
        NumberedList()
        ListItem("When is it a good idea to use lossless compression?")
        ListItem("When should you use lossy compression?")
        ListItem("What are the important factors in making that decision?")
        DiscussionGoal()
        Paragraph("This discussion should draw out two key points:")
        BulletList()
        ListItem("Lossless compression is useful when the accuracy of the original item is most important")
        ListItem("Examples: Bank records, text files, some images")
        ListItem("Lossy compression is useful when file size is a concern or when it needs to be sent in a reasonable amount of time.")
        ListItem("Examples: Multimedia - especially streaming media (images, video, audio)")
        EndCallout()
        Subsection("Remarks")
        BulletList()
        ListItem("We've seen today that lossy compression can greatly reduce file size, but can also reduce the quality of the image. Finding that balance is important, especially when the size of your file is a concern. But, if you need to recreate an exact copy of the original, then lossless compression is a better choice.")
        Subsection("Journal")
        Paragraph("Have students take out their journals and add the definition for lossy compression.")
        BulletList()
        ListItem():Emphasis("Lossy Compression:"):Text(" A process for reducing the number of bits needed to represent something in which some information is lost or thrown away. This process is not reversible.")
    end

    private action AssessmentCheckForUnderstanding
        Section("Assessment: Check for Understanding")
        Subsection("For Students")
        Paragraph("Open a word doc or google doc and copy/paste the 2 following question.")
        Subsection("Question")
        Paragraph("You've been given a new cell phone with a 2 gigabyte data plan. You plan to use your phone for text messages, images, video, and music. Which of these categories are best compressed using lossless compression? Which of these categories are best compressed using lossy compression? Why?")
    end

    private action StandardsAlignment
        Section("Standards Alignment")
        BulletList()
        ListItem():Strong("CSTA K-12 Computer Science Standards (2017): DA"):Text(" - Data & Analysis: 3A-DA-10 - Evaluate the tradeoffs in how data elements are organized and where data is stored.")
        ListItem():Strong("CSP2021: "):Text("DAT-1.D.5, DAT-1.D.6, DAT-1.D.7, DAT-1.D.8")
    end
end
