use Libraries.Web.Page.QuorumPage

/*
    Digital Information - Lesson 3: Circle Square Patterns.
    Converted from the old Lesson page by plan 13's generator: the same
    words, now without Tailwind.
*/
class CodeOrgUnit1L03 is QuorumPage

    on create
        SetLocation("lessons/code/internet/InternetLesson3.html")
        // The name lists and links use, and the series and track it belongs
        // to: its section and picture.
        SetShortTitle("Circle Square Patterns")
        SetSectionName("Digital Information")
        // For search engines and link previews, and what lists of pages say.
        SetDescription("Learn about protocols, binary messages, and bit rate")
        SetSummary("how to write a protocol to send and receive binary messages.")
    end

    action Setup
        SetWebPageTitle("Unit 1 Lesson 3: Circle Square Patterns")
        Title("Digital Information - Lesson 3: Circle Square Patterns")
        Overview()
        GettingStarted5Minutes()
        Activity35Mins()
        WrapUp5Minutes()
        AssessmentCheckForUnderstanding()
        StandardsAlignment()
    end

    private action Overview
        Section("Overview")
        Paragraph("Students will create rules for ordering patterns of circles and squares. Students generate all possible messages with three place values, then create rules that explain how they ordered each message. Emphasis is placed on creating clear rules so that, if another group were to follow the rules, they would generate the same list in the same order. Using these rules, students then try to list all possible messages with four place values. As the lesson concludes, students share their rules with classmates.")
        Subsection("Goals")
        Paragraph("Students will be able to:")
        BulletList()
        ListItem("Follow a set of rules for ordering sets of patterns")
        ListItem("Explain the challenges of creating a clear set of rules for ordering patterns")
        Subsection("Purpose")
        Paragraph("Eventually, students will need to understand the binary number system which uses 1's and 0's rather than circles and squares. This lesson acts as a bridge to the next lesson where binary is formally introduced and practiced. In wrestling with the challenge of describing the rules of ordering patterns of circles and squares clearly, students will be primed to see how the binary number system solves many of these problems. Students may discover a system that is equivalent to the binary number system, which is a feat worth celebrating, but it is not expected that every student uncovers the rules for binary in this lesson.")
        Subsection("Resources")
        Subsection("Supplemental Code.org material")
        Paragraph("For the students")
        BulletList()
        ListItem():Link("Circle Square Patterns - Activity Guide, docx", "https://docs.google.com/document/d/17GrZRYeVRMKwo9vbW-xVT1-Ccu0U2n88Thr-kMqu4s4/edit")
        ListItem():Link("Shape Cutouts", "https://docs.google.com/document/d/1l19mBWEkYLt-cIZbahv8JrrbRQFnwQQajmeq-r5InsU/edit")
    end

    private action GettingStarted5Minutes
        Section("Getting Started (5 minutes)")
        Paragraph():Strong("Prompt:"):Text(" How many ways can you represent 7?")
        Paragraph("Students should brainstorm individually before sharing in small groups. It is important to allow ample brainstorming time - students may generate familiar responses at first, but may stretch their thinking and get more creative with additional time. Some examples may include:")
        BulletList()
        ListItem("Linguistic examples - "):DoubleQuote():Text("seven"):DoubleQuote():Text(", "):DoubleQuote():Text("siete"):DoubleQuote():Text(" (spanish), "):DoubleQuote():Text("sept"):DoubleQuote():Text(" (french), "):DoubleQuote():Text("sieben"):DoubleQuote():Text(" (german), etc")
        ListItem("Picture examples - dots, tallys, emojis, etc")
        ListItem("Math & Geometry examples - 5 + 2, 8 - 1, a seven-sided shape, etc")
        Paragraph("After a short time, ask students to share some responses with the whole class. Use these responses to quickly generate a wide variety of representations.")
        Paragraph():Strong("Discussion Goal:"):Text(" Introduce the idea that the numeral '7' is just one commonly used symbol to represent the number seven. There are many ways to communicate this same number that may use different symbols or representations, all of which are valid. Sharing the variety of responses helps motivate the following activity that asks students to discover a system for using the circles and squares to represent numbers, including the number 7.")
        BulletList()
        ListItem("There are a variety of ways we could represent the number 7 - we might use the numeral '7' or the word 'seven', but this might be different in other countries or other languages. Today we'll see how we might represent the number 7 using only two different shapes.")
    end

    private action Activity35Mins
        Section("Activity (35 mins)")
        BulletList()
        ListItem("In the previous class, we ended by deciding that one of the best way to use our devices was to limit them to two options, let's say: option 1 is circles and option 2 is squares. Now let's figure out how we can use these shapes to communicate lots of different pieces of information.")
        Paragraph():Strong("Prompt:"):Text(" With a partner, work out how many different pieces of information (made of up of circles and squares) you can represent with three place values. For example: "):Code("circle-circle-circle"):Text(" and "):Code("circle-square-circle"):Text(" can represent two different pieces of information.")
        Paragraph():Strong("Discuss:"):Text(" Give students time to work individually, then have them share with their neighbor and fill in any patterns they may have missed.")
        Paragraph():Strong("Do This"):Text(" Confirm with the class that there are 8 possible patterns, but don't list all of them out. Ask students to share the 7th pattern in their list. Students will likely have different answers for this.")
        Subsection("Remarks")
        BulletList()
        ListItem("We agreed that there are 8 possible patterns we can make with 3 place values. But, not everyone wrote these patterns in the same order, which means we don't all have the same 7th pattern! Our goal is to create a clear set of rules where, if the class were to follow these rules, everyone should generate the same list of patterns in the same order.")
        Subsection("Circle Square Activity (25 minutes)")
        Paragraph("Place students in groups of 2, making one group of 3 if necessary. Distribute "):Link("Circle Square Patterns - Activity Guide, docx", "https://docs.google.com/document/d/17GrZRYeVRMKwo9vbW-xVT1-Ccu0U2n88Thr-kMqu4s4/edit"):Text(" - one for each group. Each group also gets the "):Link("Shape Cutouts - Resource", "https://docs.google.com/document/d/1l19mBWEkYLt-cIZbahv8JrrbRQFnwQQajmeq-r5InsU/edit"):Text(" to use during the activity.")
        Paragraph():Strong("Challenge #1:"):Text(" Students again list all possible three place value patterns, but with an added focus on the order of their patterns.")
        Paragraph():Strong("Challenge #2:"):Text("Students describe the rules or strategy they used to create their list. They are aiming for clear directions that can be followed by another group to reproduce their same list in the same order.")
        Paragraph():Strong("Challenge #3:"):Text(" Students extend their rules to generate all possible four place value patterns. This challenge has 2 parts: discovering all possible four place value combinations (there are 16) and extending the rules from the previous challenge so they work here as well. Most groups will need to change or add to their rules in order to accomplish Challenge #3.")
        Paragraph():Strong("Discuss:"):Text(" Select a few groups to share out their rules, highlighting groups with different strategies and rules they used for their lists. Emphasize the 7th item in each list, connecting it back to the warm-up activity as another way to represent the number 7.")
        TeachingTip()
        Paragraph():Strong("Manipulatives:"):Text(" Students are given manipulatives to help visualize any rules they are using to move from one element of the list to the next. You might see students use all their manipulatives at once to create the different patterns, then discuss how to arrange them into an ordered list. You might see students representing one pattern at a time, then discussing the rules for "):DoubleQuote():Text("replacing"):DoubleQuote():Text(" shapes to generate each of the next patterns. Students might not use the manipulatives at all, using pen & paper or whiteboards instead.")
        Paragraph():Strong("Many Possible Answers:"):Text(" It is okay for different groups to come up with different orders for their lists of patterns - this will help with the share-out discussion as you highlight different strategies.")
        Paragraph():Strong("Facilitating With Groups:"):Text(" You should act as a facilitator during this part of the activity, guiding students in describing the rules & strategies that they used to create their list. These strategies may be implicit and unconscious to the student, but you can ask questions to help students realize their own thinking that went into generating their list. Aim to help students clarify their thinking to make it easier for other groups to follow.")
        Paragraph():Strong("Group Dynamics:"):Text(" Be mindful of groups that appear to be dominated by a single student. Asking each student individually about their strategy can help bring students back together and reinforce the collaborative aspect of this activity.")
        EndCallout()
    end

    private action WrapUp5Minutes
        Section("Wrap up (5 Minutes)")
        BulletList()
        ListItem("Congratulations! You just invented your own system for counting and we now have new ways to represent the number 7! This happens a lot as new technology is invented and fine-tuned - different technologies might count in different ways. Tomorrow we're going to learn about the counting system computers use to represent numbers!")
        Paragraph():Strong("Prompt:"):Text(" How is counting in this circle/square system similar to how we count in our regular lives? How is it different?")
        TeachingTip()
        Paragraph():Strong("Goal:"):Text(" There are many ways to structure this discussion, especially if you have your own established share-out routines. Here are a few that could work for this particular discussion:")
        EndCallout()
    end

    private action AssessmentCheckForUnderstanding
        Section("Assessment: Check for Understanding")
        Subsection("For Students")
        Paragraph("Open a word doc or google doc and copy/paste the following question.")
        Subsection("Question")
        Paragraph("How would you explain a number system to someone who had never used numbers before?")
    end

    private action StandardsAlignment
        Section("Standards Alignment")
        BulletList()
        ListItem():Strong("CSTA K-12 Computer Science Standards (2017): DA"):Text(" - Data & Analysis: 3A-DA-09 - Translate between different bit representations of real-world phenomena, such as characters, numbers, and images.")
    end
end
