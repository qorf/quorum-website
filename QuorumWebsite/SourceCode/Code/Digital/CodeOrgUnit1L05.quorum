use Libraries.Web.Page.QuorumPage

/*
    Digital Information - Lesson 5: Overflow and Rounding.
    Converted from the old Lesson page by plan 13's generator: the same
    words, now without Tailwind.
*/
class CodeOrgUnit1L05 is QuorumPage

    on create
        SetLocation("lessons/code/internet/InternetLesson5.html")
        // The name lists and links use, and the series and track it belongs
        // to: its section and picture.
        SetShortTitle("Overflow and Rounding")
        SetSectionName("Digital Information")
        // For search engines and link previews, and what lists of pages say.
        SetDescription("Unplugged lesson that reinforces concepts already learned about binary numbers.")
        SetSummary("learn about limitations of binary number systems")
    end

    action Setup
        SetWebPageTitle("Unit 1 Lesson 5: Overflow and Rounding")
        Title("Digital Information - Lesson 5: Overflow and Rounding")
        Overview()
        GettingStarted5Minutes()
        Activity35Mins()
        WrapUp5Minutes()
        AssessmentCheckForUnderstanding()
        StandardsAlignment()
    end

    private action Overview
        Section("Overview")
        Paragraph("Students extend their understanding of the binary number system by exploring errors that result from overflow and rounding. They make a "):DoubleQuote():Text("flippy do pro"):DoubleQuote():Text(" to practice binary-to-decimal number conversions which include fractional place values.")
        Subsection("Goals")
        Paragraph("Students will be able to:")
        BulletList()
        ListItem("Describe how to include fractions in the binary number system.")
        ListItem("Understand that overflow and roundoff errors result from real-world limitations in representing place value.")
        Subsection("Purpose")
        Paragraph("This lesson introduces students to the practical aspects of using a binary system to represent numbers in a computing device. Students discover the limitations of creating numbers that are "):DoubleQuote():Text("too big"):DoubleQuote():Text(" or "):DoubleQuote():Text("too small"):DoubleQuote():Text(" to count. They learn that, while a number system is infinite, the physical representation of numbers requires place values -- which are finite, and limit the ability to represent numbers.When using this binary representation of numbers, certain values (1, 2, 4, 8, 16, etc.) are seen repeatedly. When written in binary, these values are 1, 10, 100, 1000, 10000, and so on, and so are the incremental place values in this binary number system.")
        Subsection("Resources")
        Subsubsection("Supplemental Code.org material")
        BulletList()
        ListItem():Link("Flippy Do Pro worksheet in print", "https://drive.google.com/a/code.org/file/d/1VpZH4E2c5fR-g2fBMggd4-pz8GNRxxwZ/view?usp=sharing")
        ListItem():Link("Flippy Do Pro worksheet in braille, Duxbury file", "/files/code/Unit1/U1L05_FlippyDoPro.dxb")
        ListItem():Link("Flippy Do Pro worksheet in braille, .brf", "/files/code/Unit1/U1L05_FlippyDoPro.brf")
    end

    private action GettingStarted5Minutes
        Section("Getting Started (5 minutes)")
        Paragraph():Strong("Discuss:"):Text(" Imagine you work at a local store. In the register all you have are nine $10 bills, nine $1 bills, and nine dimes.")
        BulletList()
        ListItem("What's the largest amount of change that you can give someone?")
        ListItem("What's the least?")
        ListItem("What would you do if someone needed 7 cents in change?")
        Paragraph():Strong("Discussion Goal:"):Text(" Today we're going to explore what happens when you don't have the right "):DoubleQuote():Text("places"):DoubleQuote():Text(" to store information. This can happen when you try to store very large numbers, very small ones, and everything in-between! The goal of the prompt is to understand the very real problem of making sure that enough place values are available to represent numbers.")
        BulletList()
        ListItem("The largest amount of change you can give someone is $99.90.")
        ListItem("The least change you can give is $0.10.")
        ListItem("You can't give someone $0.07. You also can't give someone $1.25 in change (because you have no nickels!)")
        Paragraph("At both extremes of the number range, large and small -- and in between numbers -- you are unable to build some numbers because you don't have the place values to do so.")
    end

    private action Activity35Mins
        Section("Activity (35 mins)")
        Paragraph("Place students in groups of two. Groups will need one computer per group.")
        TeachingTip()
        Paragraph("Students will tackle the problem of "):DoubleQuote():Text("running out of place values"):DoubleQuote():Text(" when counting to bigger and bigger numbers. They will consider an odometer to explore what happens when you add one to the largest number you can represent in a number system.")
        EndCallout()
        Paragraph():Strong("Prompt:"):Text(" Suppose we have a car odometer. The number in the odometer keeps going up as we drive. What about when the odometer reaches the max value? What happens if we keep driving?")
        Subsection("Flippy Do Pro")
        BulletList()
        ListItem("Now that you have started thinking about place value and overflow, we are going to work on a different problem. What happens when there aren't enough place values to represent a number? You will explore this with a new version of the Flippy Do, the Flippy Do Pro!")
        Paragraph("Provide each group with a copy of the Flippy Do Pro Template and scissors.")
        Paragraph():Strong("Do This:"):Text(" Cut and fold your Flippy Do Pro following the guidance on the slide. Fill out all the numbers if they are not already done.")
        Subsubsection("Remarks")
        BulletList()
        ListItem("The Flippy Do Pro is similar to the one you made before. But this time, the Flippy Do Pro is already filled with binary place values assigned in a different way -- they include fractions.")
        ListItem("When using the Flippy Do Pro, the numbers on the left-hand side of the line are whole numbers and those on the right-hand side of the line are fractional numbers.")
        Subsubsection("Teaching Tip")
        BulletList()
        ListItem("The Flippy Do Pro is still using 8 bits to represent a number. But this time, the place value of each bit has been assigned in a different way than in the previous Flippy Do. The bits have been "):DoubleQuote():Text("shifted"):DoubleQuote():Text(" to the right two times. The value 1 (2^0) is no longer the smallest place value. The value of a bit just to the right of 1 (2^0) is 0.5, which is 2^-1. The value to the right again is 0.25 which is 2^-2.")
        ListItem("Students may struggle with negative exponents. What's more important than emphasizing the math is emphasizing the pattern of place values in the Flippy Do Pro. As you move left, the place value doubles. As you move right, the place value halves.")
        ListItem("Help students see that using the Flippy Do Pro is similar to using the Flippy Do. To form a value, flip the flaps up or down at the bottom of the device to create a sequence of zeros and ones. Note that the range of place values is limited by the largest bit value, 2^5 which is 32, and the smallest bit value, 2^-2 which is 0.25. As with the Flippy Do, adding together all the values for each place value containing a "):DoubleQuote():Text("1"):DoubleQuote():Text(" produces the total value represented on the Flippy Do Pro.")
        Subsection("Flippy Do Pro Challenges")
        Paragraph():Strong("Challenge #1 - Smallest Number:"):Text(" Produce the smallest binary number possible with the Flippy Do Pro.")
        BulletList()
        ListItem("The smallest binary number students produce is "):Code("000000.01"):Text(" and this number has a decimal value of "):Code("0.25"):Text(".")
        Paragraph():Strong("Challenge #2 - Next Value:"):Text(" Increase the number made in Challenge #1 to the next possible value.")
        BulletList()
        ListItem("The binary number students produce is "):Code("000000.10"):Text(" and this number has a decimal value of "):Code("0.50"):Text(".")
        Paragraph():Strong("Challenge #3 - Got Quarters?"):Text(" Make the values 0.25, 0.50, and 0.75 one after another.")
        BulletList()
        ListItem("The binary numbers students produce are "):Code("000000.01"):Text(", "):Code("000000.10"):Text(", "):Code("000000.11"):Text(". Note the pattern of changing a place value from 1 to 0 and then "):DoubleQuote():Text("carrying"):DoubleQuote():Text(" the one.")
        Paragraph():Strong("Challenge #4 - Can't Make Change:"):Text(" Make all the fractional possible in binary using the Flippy Do Pro.")
        BulletList()
        ListItem("There are no new values besides those made in Challenge #3 because there are no place values for representing other fractions.")
        ListItem("Note, if students need a concrete example for Challenge #4, have them try to make 39 cents in binary. It can't be done with the values they have available in the Flippy Do Pro.")
        Paragraph():Strong("Challenge #5 - Largest Number:"):Text(" What is the largest number (in decimal) you can make with the Flippy Do Pro?")
        BulletList()
        ListItem("With all of the bits flipped to 1, the largest number you can make is 63.75. Note that this is smaller than the largest you can make with a traditional Flippy Do, which is 255. This is because we have shifted two bits to represent smaller numbers (0.5 & 0.25).")
        Paragraph():Strong("Challenge #6 - How Much Pie:"):Text(" Challenge 6 contains a number of pie charts. Each chart has a single colored slice, representing a piece of pie. Students use a Flippy Do Pro to determine how much pie is left at the end of dessert. With each slide, allow time for students to decide how to represent the amount of pie left as a binary number, then convert that to decimal and write it down in the journal. In this challenge it is expected that students will estimate and do some rounding when determining how much pie is left.")
        Paragraph():Strong("Do This: For each pie chart, students should:")
        NumberedList()
        ListItem("Estimate how big the colored slice is.")
        ListItem("Use your Flippy Do Pro to represent how big the slice is. You may need to round up or down.")
        ListItem("Convert your binary number to a decimal number.")
        ListItem("Write down the number in your journal.")
        Subsubsection("Pie #1: Pumpkin")
        Image("media/lessons/csp/unit1/Unit1-5_Challenge6_Chart1.png", "A pie chart with a single orange slice that takes approximately two-tenths of the chart.")
        Subsubsection("Pie #2: Cherry")
        Image("media/lessons/csp/unit1/Unit1-5_Challenge6_Chart2.png", "A pie chart with a single orange slice that takes approximately three-tenths of the chart.")
        Subsubsection("Pie #3: Lemon")
        Image("media/lessons/csp/unit1/Unit1-5_Challenge6_Chart3.png", "A pie chart with a single orange slice that takes approximately one-tenth of the chart.")
        Subsubsection("Pie #4: Chocolate")
        Image("media/lessons/csp/unit1/Unit1-5_Challenge6_Chart4.png", "A pie chart with a single orange slice that takes approximately four-tenths of the chart.")
        Paragraph():Strong("Do This:"):Text(" Add all the decimal numbers together. Compare with a partner and discuss.")
        Subsection("Final Task")
        BulletList()
        ListItem("In our final challenge, your answer may be different than your classmates. It comes down to how you rounded - did you decide to round up or round down with the various amounts of pie. If we did not have to round, the answer would be exactly one pie left over. You may have come to the same conclusion by rounding - or not!")
        Paragraph():Strong("Prompt:"):Text(" Why is it a problem for a computer if your answers are different than others?")
        Paragraph():Strong("Discussion Goal:"):Text(" Computers rely on precision. Think of a calculator. We depend on 1+1 always equaling 2. Rounding is necessary because of the limits of bits, but can lead to errors.")
    end

    private action WrapUp5Minutes
        Section("Wrap up (5 Minutes)")
        Paragraph("Review the information on the first wrapup slide showing how binary can be used to precisely represent some fractional values from the decimal number system. Students do not need to understand how to convert fractional amounts from decimal to binary.")
        TeachingTip()
        Paragraph("For your own personal knowledge, you can read more about "):DoubleQuote():Text("decimal points "):DoubleQuote():Text("and"):DoubleQuote():Text(" binary points on Wikipedia.")
        EndCallout()
        Subsection("Remarks")
        BulletList()
        ListItem("The most important takeaway from this lesson is to understand that bits can represent a limited amount of information.")
        Subsection("Discuss")
        BulletList()
        ListItem("What does an odometer show us about representing large numbers?")
        ListItem("What does the Flippy Do Pro show about representing very small numbers?")
        ListItem("If we had a big enough odometer or Flippy Do Pro, could we represent every possible number?")
        Subsubsection("Discussion Goal")
        Paragraph("As students have seen, you can make "):DoubleQuote():Text("any number"):DoubleQuote():Text(" in your head, but the tool you use to represent a number has limitations. It has a fixed number of place values it can show. An odometer keeps running after you move beyond its upper limit, but the largest place values cannot be displayed due to overflow error.")
        Paragraph("In the Flippy Do Pro, you assigned some of the bits to fractions, but you saw that you still couldn't represent certain "):DoubleQuote():Text("small"):DoubleQuote():Text(" numbers -- you could only show a number that was "):DoubleQuote():Text("close to"):DoubleQuote():Text(" your target number. This is roundoff error, an error that occurs when bit arrangements can't represent numbers as intended.")
        Paragraph("Ultimately, regardless of the size of our odometer or Flippy Do Pro, and how many bits we add to them, there's going to be numbers that are too large, too small, or "):DoubleQuote():Text("in-between"):DoubleQuote():Text(" the values we want to represent.")
        Subsection("Journal")
        Paragraph("Students add to their journals the definitions for: Overflow Error and Round-off Error.")
        BulletList()
        ListItem():Emphasis("Overflow Error:"):Text(" Error from attempting to represent a number that is too large.")
        ListItem():Emphasis("Round-off Error:"):Text(" Error from attempting to represent a number that is too precise. The value is rounded.")
    end

    private action AssessmentCheckForUnderstanding
        Section("Assessment: Check for Understanding")
        Subsection("For Students")
        Paragraph("Open a word doc or google doc and copy/paste the 3 following question.")
        Subsection("Question 1")
        Paragraph("Modern car odometers record up to a million miles driven. What happens to the odometer reading when a car drives beyond its maximum reading?")
        Subsection("Question 2")
        Paragraph("When using bits to represent fractions of a number, can you create all possible fractions? Why or why not?")
    end

    private action StandardsAlignment
        Section("Standards Alignment")
        BulletList()
        ListItem():Strong("CSTA K-12 Computer Science Standards (2017): DA"):Text(" - Data & Analysis: 3A-DA-09 - Translate between different bit representations of real-world phenomena, such as characters, numbers, and images.")
        ListItem():Strong("CSP2021: "):Text("DAT-1.B.1, DAT-1.B.2, DAT-1.B.3")
    end
end
