use Libraries.Web.Page.QuorumPage

/*
    The Internet - Lesson 14: The Internet and Society.
    Converted from the old Lesson page by plan 13's generator: the same
    words, now without Tailwind.
*/
class CodeOrgUnit1L14 is QuorumPage
    // A double quote, for code and words that hold one.
    text dq = ""

    on create
        SetLocation("lessons/code/internet/InternetLesson14.html")
        // The name lists and links use, and the series and track it belongs
        // to: its section and picture.
        SetShortTitle("CSP Internet Lesson 14")
        // For search engines and link previews, and what lists of pages say.
        SetDescription("Practice Performace Task researching Net Neutrality and Internet Censorship")
        SetSummary("Practice Performance Task")
    end

    action Setup
        dq = dq:GetDoubleQuote()
        SetWebPageTitle("Unit 1 Lesson 14: The Internet and Society")
        Title("The Internet - Lesson 14: The Internet and Society")
        Overview()
        Vocabulary()
        GoalsPart()
        Purpose()
        Resources()
        GettingStarted()
        Activity()
        WrapUp()
        Assessment()
        ExtendedLearning()
        StandardsAlignment()
    end

    private action Overview
        Section("Overview")
        Paragraph("This lesson is a capstone to the Internet unit. Students will research and prepare a flash talk about an issue facing society: either Net Neutrality or Internet Censorship. Developing an informed opinion about these issues hinges on an understanding of how the Internet functions as a system. Students will prepare and deliver a flash talk that should combine forming an opinion about the issue and an exhibition of their knowledge of the internet.")
        Paragraph("This lesson is good practice for certain elements of the AP Explore Performance Task. The primary things practiced here are: doing a bit of research about impacts of computing (though here it's specifically about the Internet), explaining some technical details related to ideas in computer science, and connecting these ideas to global and social impacts. Students will practice synthesizing information, and presenting their learning in a flash talk.")
        Paragraph("Note: This is NOT the official AP® Performance Task that will be submitted as part of the Advanced Placement exam; it is a practice activity intended to prepare students for some portions of their individual performance at a later time.")
    end

    private action Vocabulary
        Section("Vocabulary")
        BulletList()
        ListItem():Strong("DNS: "):Text("the service that translates URLs to IP addresses")
        ListItem():Strong("HTTP: "):Text("HyperText Transfer Protocol - the protocol used for transmitting web pages over the Internet")
        ListItem():Strong("IP Address: "):Text("a number assigned to any item that is connected to the Internet")
        ListItem():Strong("Net Neutrality: "):Text("the principle that all Internet traffic should be treated equally by Internet Service Providers")
        ListItem():Strong("TCP: "):Text("Transmission Control Protocol - provides reliable, ordered, and error-checked delivery of a stream of packets on the internet. TCP is tightly linked with IP and usually written as TCP/IP")
    end

    private action GoalsPart
        Section("Goals")
        Paragraph("Students will be able to:")
        BulletList()
        ListItem("Research a global impact of the Internet")
        ListItem("Create and present a flash talk on a global impact of the Internet")
        ListItem("Analyze the relationship of an Internet technology to the impact")
    end

    private action Purpose
        Section("Purpose")
        Paragraph("This lesson has dual purposes of honing "):DoubleQuote():Text("rapid research"):DoubleQuote():Text(" skills and tying a temporary bow on the Internet Unit.")
        Paragraph("The act of doing "):DoubleQuote():Text("rapid research"):DoubleQuote():Text(" is one that will come up over and over again in this course. We want to build students' confidence and skills in researching topic using a variety of sources. In the case of this lesson we want students to read articles on the issues but scan for the terms and vocabulary they know like: IP, DNS, HTTP, routing, packets, scaling, redundancy, reliability. We want students to be able to explain with some level of technical proficiency how these things work as well as the potential beneficial and harmful effects.")
        Paragraph("Net Neutrality and Internet Censorship are related issues having to do with organizations attempting to control internet traffic for a variety of reasons. There are many other large societal issues and dilemmas related to the Internet besides these that like: big data, surveillance, security and encryption. We address these issues in Unit 4: Big Data and Privacy. For this practice PT we want to keep the focus on issues that relate more directly to the systems and protocols")
    end

    private action Resources
        Section("Resources")
        Callout("Additional Code.org material")
        BulletList()
        ListItem():Link("Flash Talk: The Internet and Society - Practice PT", "/files/code/Unit1/U1L14 Practice.pdf")
        ListItem():Link("Vint Cerf's " + dq + "The Internet is for Everyone" + dq + " (Reference from Unit 1 Lesson 8)", "/files/code/Unit1/U1L08 Activity Guide.pdf")
        EndCallout()
    end

    private action GettingStarted
        Section("Getting Started")
        Paragraph("At the beginning of this unit we examined Vint Cerf’s RFC entitled "):DoubleQuote():Text("The Internet is for Everyone"):DoubleQuote():Text(" in which he laid out some challenges to the prospect that the Internet would be a large scale, open resource for everyone.")
        Paragraph("However, on the scale of human history, the Internet is still relatively new and the Internet has introduced some new and potentially difficult issues for people and society that have never existed before. We are still grappling with these issues and they often present moral and ethical dilemmas about what's best to do.")
        Paragraph("By the same token a large number of people do not understand as much about the Internet and how it works as you do. You have now learned quite a bit about how the Internet works as a large scale system, that involves layers of abstraction, protocols and algorithms. You have learned about some of the most fundamental protocols and structures that contribute to the functioning of the Internet.")
        Subsection("Present the Practice PT")
        Paragraph("Read the following prompt to the students.")
        Paragraph("Several major issues facing society today require a knowledge of the Internet and how it works in order to have a well-informed opinion about what’s best or the right thing to do. Over the next few days you will research one of these issues and prepare a (very) short presentation about it - a Flash Talk.")
    end

    private action Activity
        Section("Activity")
        Paragraph("To start, distribute and review the "):DoubleQuote():Text("Flash Talk: The Internet and Society - Practice PT"):DoubleQuote():Text(" resource.")
        Subsection("Pro Tip")
        BulletList()
        ListItem("Pair each student with a research "):DoubleQuote():Text("buddy"):DoubleQuote():Text(" to either collaboratively research or to bounce ideas off each other")
        ListItem("Encourage students to start by just simply searching for words and names of protocols that they recognize in the text of articles")
        ListItem("Students may or may not find the research organizer helpful - you might want to create another template for them to follow that provides more structure or guidance")
        Paragraph("This Practice PT has 3 main components to it:")
        NumberedList()
        ListItem("Pick an issue and research it")
        ListItem("Prepare (write) a Flash Talk")
        ListItem("Deliver it")
        Paragraph("Note that this lesson is expected to take three days. Below is a sample timeline for how this project might unfold.")
        Subsection("Day 1 - Start Research")
        Paragraph("1. Review the "):DoubleQuote():Text("Flash Talk: The Internet and Society - Practice PT"):DoubleQuote():Text(" resource")
        Paragraph("2. Students choose a topic:")
        BulletList()
        ListItem("Net Neutrality")
        ListItem("Internet Censorship")
        ListItem("Advanced: Protocal Hacks and Vulnerabilities")
        Paragraph("3. Students start research")
        Subsubsection("Pro Tip")
        Paragraph("If students choose the advanced option they are still responsible for knowing what the issue of Net Neutrality is about. Researching protocol hacks is a certain kind of fun, and students may get very "):DoubleQuote():Text("into"):DoubleQuote():Text(" it. However, you may want to ensure to pair a student or group who chooses the "):DoubleQuote():Text("hacking"):DoubleQuote():Text(" option with a group who researched Net Neutrality or censorship to make sure that the concepts get to both groups.")
        Subsection("Day 2 - Start Flash Talk Prep")
        Paragraph("1. Conclude research")
        Paragraph("2. Prepare (write) script for flash talk")
        Subsection("Day 3 - Finish and Deliver")
        Paragraph("1. Present flash talk")
        Paragraph("2. Submit materials for assessment")
        Subsubsection("Content Corner")
        Paragraph("Note that preparing a flash talk is basically like writing a short speech. 2 minutes is about 300 words, which is the maximum word-length of a typical reflection prompt on the Explore Performance task. So you might want to reframe this as a simple prompt to respond to.")
        Paragraph("The Explore PT is also an individual task for students. You may want students to have a partner to work with here, but students do need some practice doing these things on their own.")
        Paragraph("The primary skills related to the Explore PT that students are practicing here are:")
        BulletList()
        ListItem("Research on a topic related to computing")
        ListItem("Connecting Computing to socially relevant issues")
        ListItem("Explaining the technical details necessary for understanding the issues at play")
        ListItem("Writing short concise text that explains a complicated issue and associated technology")
    end

    private action WrapUp
        Section("Wrap Up")
        Paragraph("The wrap up should happen on Day 3 and you can choose from one of the Delivery and Assessment Options described below.")
        Paragraph("The major thing students should be able to do is describe is the relationship and connection between a societal issue, like Net Neutrality, with aspects of the technical underpinnings that gave rise to the issue in the first place.")
        Subsection("Delivery and Assessment Options")
        Paragraph("You probably don't have time for every student to give their flash talk to the entire class. You might consider doing one of the following options:")
        BulletList()
        ListItem("Put students in small groups of to give their flash talks to each other")
        ListItem("Have students trade what they wrote for the flash talk and present the other person's talk")
        ListItem("Only require that they write the talk (basically a speech or response to a reflection prompt) and turn it in")
        ListItem("Have students read each others' talks anonymously and evaluate it according to the rubric")
        ListItem("Collect the student’s research organizer as well as a text-copy of the flash talk for assessment")
    end

    private action Assessment
        Section("Assessment")
        Paragraph("Assessment for this lesson is based on their Flash Talk presentation, rather than the usual questions. See the rubric in the "):DoubleQuote():Text("Flash Talk: The Internet and Society - Pratice PT"):DoubleQuote():Text(" resource.")
    end

    private action ExtendedLearning
        Section("Extended Learning")
        Paragraph("Students may find additional research help on their Global Impact of the Internet topic in the following chapters of "):DoubleQuote():Text("Blown to Bits."):DoubleQuote()
        BulletList()
        ListItem():Link("Chapter 2: Naked in the Sunlight", "http://www.bitsbook.com/wp-content/uploads/2008/12/chapter2.pdf")
        ListItem():Link("Chapter 6: Balance Toppled", "http://www.bitsbook.com/wp-content/uploads/2008/12/chapter6.pdf")
        ListItem():Link("Chapter 7: You Can't Say That on the Internet", "http://www.bitsbook.com/wp-content/uploads/2008/12/chapter7.pdf")
        ListItem():Link("Chapter 8: Bits in the Air (Note: some explicit language)", "http://www.bitsbook.com/wp-content/uploads/2008/12/chapter8.pdf")
    end

    private action StandardsAlignment
        Section("Standards Alignment")
        BulletList()
        ListItem():Strong("CSTA K-12 Computer Science Standards: "):Text("CD.L3A:8, CD.L3A:9")
        ListItem():Strong("CSTA K-12 Computer Science Standards: "):Text("CI.L2:2, CI.L2:3, CI.L2:5, CI.L3A:10, CI.L3A:4")
        ListItem():Strong("CSTA K-12 Computer Science Standards: "):Text("CL.L2:2")
        ListItem():Strong("Computer Science Principles: "):Text("6.3.1 (A, B)")
        ListItem():Strong("Computer Science Principles: "):Text("7.1.1 (A, B, C, D, H, I, J, K, M, O)")
        ListItem():Strong("Computer Science Principles: "):Text("7.4.1 (A, B, D, E)")
    end
end
