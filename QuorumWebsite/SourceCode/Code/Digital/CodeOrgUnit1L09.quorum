use Libraries.Web.Page.QuorumPage

/*
    Digital Information - Lesson 9: Lossless Compression.
    Converted from the old Lesson page by plan 13's generator: the same
    words, now without Tailwind.
*/
class CodeOrgUnit1L09 is QuorumPage
    // A double quote, for code and words that hold one.
    text dq = ""

    on create
        SetLocation("lessons/code/internet/InternetLesson9.html")
        // The name lists and links use, and the series and track it belongs
        // to: its section and picture.
        SetShortTitle("Lossless Compression")
        SetSectionName("Digital Information")
        // For search engines and link previews, and what lists of pages say.
        SetDescription("Learn about lossless compression")
        SetSummary("losslessly compressing information")
    end

    action Setup
        dq = dq:GetDoubleQuote()
        SetWebPageTitle("Unit 1 Lesson 9: Lossless Compression")
        Title("Digital Information - Lesson 9: Lossless Compression")
        Overview()
        GettingStarted5Minutes()
        Activity35Mins()
        WrapUp5Minutes()
        AssessmentCheckForUnderstanding()
        StandardsAlignment()
    end

    private action Overview
        Section("Overview")
        Paragraph("Students use the Text Compression Widget to experiment with compressing songs and poems and try to find their "):DoubleQuote():Text("personal best"):DoubleQuote():Text(" compression. A video introduces important vocabulary for the lesson and demonstrates the full features of the widget. Students pick a text they think will be "):DoubleQuote():Text("easy"):DoubleQuote():Text(" to compress and one they think will be "):DoubleQuote():Text("difficult"):DoubleQuote():Text(", paying attention to why some texts might be more compressible than others. As a wrap-up, students discuss what factors make some texts more compressible than others.")
        Subsection("Goals")
        Paragraph("Students will be able to:")
        BulletList()
        ListItem("Create lossless compressions of text files")
        ListItem("Analyze patterns in data to determine compression strategies")
        Subsection("Purpose")
        Paragraph("As students have been creating images over the last few lessons, the number of bits it takes to represent that information has grown and grown. In this lesson, students are introduced to the concept of compression as a way to address the growing file sizes of all of our information. This lesson is anchored by the Text Compression widget, which is a very hands-on & active widget for students to experiment with. Most of the lesson should be spent in the widget, having students experiment with different strategies for compression and creating a memorable experience to help anchor the concept of compression. Students also watch a video that introduces "):Strong("lossless"):Text(" and "):Strong("lossy compression"):Text(" - today's lesson is an example of "):Strong("lossless compression"):Text(", while tomorrow's lesson is dedicated to "):Strong("lossy compression"):Text(". The widget is just one example of lossless compression and students aren't expected to master specific compression strategies - instead, they should understand that lossless compression uses less data and still lets them re-create the original information.")
        Subsection("Resources")
        BulletList()
        ListItem():Link("Text Compression Widget Video", "http://youtu.be/LCGkcn1f-ms")
        ListItem():Link("Lossless Compression Project", "https://quorumlanguage.com/Project.quorum?user=Projects&file=Text+Compression")
    end

    private action GettingStarted5Minutes
        Section("Getting Started (5 minutes)")
        Paragraph():Strong("Prompt:"):Text(" This list represents several common abbreviations used in text messages. What other abbreviations could you add to this list?")
        BulletList()
        ListItem("lol")
        ListItem("ty")
        ListItem("c u soon")
        Paragraph():Strong("Prompt:"):Text(" Why might we use abbreviations when sending messages? What are the advantages?")
        Paragraph():Strong("Discussion Goal:"):Text(" There are many possible responses to this - to talk in code, to hide information, to be clever - but an important response to highlight is that abbreviations save time & space when communicating. If a student suggested an abbreviation that not everyone knew, this is a great moment to bring up that both the sender and the receiver need to understand what the abbreviation stands for in order for it to make sense. Both of these points foreshadow today's activity on compression.")
    end

    private action Activity35Mins
        Section("Activity (35 mins)")
        Subsection("Introduction to Compression (5 minutes)")
        Paragraph():Strong("Remarks")
        BulletList()
        ListItem("I want to send this message to a friend:")
        ListItem():Emphasis("Pitter_patter_pitter_patter_listen_to_the_rain_pitter_patter_pitter_patter_on_the_window_pane")
        ListItem("My friend's phone can only accept 80 characters of text at a time. I notice this pattern has some repetition in it, so rather than sending the whole message, I send this instead:")
        ListItem():Emphasis("5listen_to1rain_5on1window_pane")
        ListItem():Emphasis("1 _the_")
        ListItem():Emphasis("2 tter_")
        ListItem():Emphasis("3 Pi2")
        ListItem():Emphasis("4 Pi2")
        ListItem():Emphasis("5 3434")
        Paragraph():Strong("Prompt:"):Text(" How is this message the same as the first? What actually gets sent to my friend?")
        Subsubsection("Discussion Goal")
        Paragraph("Students should notice that each symbol represents other snippets of text. By substituting each symbol for the text it represents, we can re-create the original message.")
        Paragraph("Students may need some guidance to see that the entire sent message is really two parts - the text with symbols and the key that shows what each symbol represents. Students should see that both need to be sent in order for the original message to be recreated - if only the text is sent, the receiver won't know how what each symbol represents to recreate the message.")
        Subsubsection("Remarks")
        BulletList()
        ListItem("Using abbreviations and symbols is a form of "):Strong("compression"):Text(", where we try to represent the same information with fewer characters. The original message had 93 characters, but the new message and key, also called a dictionary, have a total of 56 characters. We're essentially sending the same information, but with fewer characters. Our goal today will be to create our own text compressions using similar methods.")
        Subsection("Text Compression Widget (15 minutes)")
        Paragraph():Strong("Do This:"):Text(" Provide students with links to the Lossless Text Compression project on the Quorum Language Website.")
        Paragraph():Link("Lossless Compression Project", "https://quorumlanguage.com/Project.quorum?user=Projects&file=Text+Compression")
        Subsubsection("Remarks")
        BulletList()
        ListItem("This widget will let you compress a piece of text. You can type in the input to add a new entry in the dictionary. As you do, the text will update with your symbols. You have 4 minutes to try and compress this text as best you can.")
        Paragraph():Strong("Circulate: "):Text("Help students understand how this widget works so they can successfully compress text. Make note of students who have found successful strategies so they can be highlighted in the upcoming discussion.")
        Paragraph():Strong("Regroup:"):Text(" Gather the class back together. Emphasize the current compression rating. Have students make a note of their current Compression Percentage at the bottom of the box.")
        Paragraph():Strong("Prompt:"):Text(" What strategies are you using to compress your sample text? Which ones seem most successful?")
        Subsubsection("Discussion Goal")
        Paragraph("Students will have encountered a variety of strategies, but there are a few worth emphasizing for the full class:")
        BulletList()
        ListItem("Look for repeated words, sentences, or even parts of words (like -ing or -th).")
        ListItem("You can embed symbols within symbols. This was demonstrated in the pitter-patter example where some symbols were "):DoubleQuote():Text("unpacked"):DoubleQuote():Text(" to include other symbols.")
        ListItem("The order of the dictionary matters and trying to rearrange the dictionary once it's made can lead to problems.")
        Paragraph():Strong("Video:"):Text(" Show "):Link("Text Compression widget (tutorial) - Video", "http://youtu.be/LCGkcn1f-ms"):Text(" (feel free to skip from 2:30-5:00, which shows Code.org's widget, which is different than the project used for this lesson plan. Don't miss 5:00+, which talks about concepts). After the video, be sure to emphasize two things:")
        BulletList()
        ListItem("The widget we are using is an example of "):Strong("lossless compression")
        ListItem("The compression percentage at the bottom of the screen is calculated by comparing the number of "):Strong("bytes"):Text(" in the original message and the number of "):Strong("bytes"):Text(" in the compressed message.")
        Paragraph():Strong("Do This:"):Text(" Give students another 4 minutes to apply the strategies they've just seen to continue to raise their compression percentage.")
        TeachingTip()
        Paragraph():Strong("Competitions:"):Text(" You could incorporate a peer-to-peer competition (in small groups or as a full class) to get the "):DoubleQuote():Text("highest"):DoubleQuote():Text(" rating, but that can be isolating for students and suggests there is a single "):DoubleQuote():Text("best"):DoubleQuote():Text(" way to do this. An alternate strategy is: when students start for the second time, have them compete against themselves to beat their rating during the first 4 minutes. In this way, success is measured by personal growth and has a higher chance of letting every student feel successful.")
        Paragraph():Strong("Starting Over:"):Text(" When solving computational problems, it can sometimes be helpful to restart completely from the beginning. This activity may be a good place to suggest this to students, especially those that feel particularly stuck or frustrated - sometimes restarting from the very beginning surfaces new ideas and strategies that we didn't see before.")
        EndCallout()
        Paragraph():Strong("Circulate:"):Text(" Check in with students on their strategies and their compression rates. Encourage students to continually try and reach a "):DoubleQuote():Text("personal best"):DoubleQuote():Text(" by looking at how their compression rates change when they add or remove items from the dictionary.")
        BulletList()
        ListItem("We're starting to reach the "):DoubleQuote():Text("limit"):DoubleQuote():Text(" for how much we can compress this particular message. But not every message can be compressed with a high rating. We're going to investigate what makes some messages more compressible than others.")
        Subsection("Comparing Compressions")
        BulletList()
        ListItem("Explore the other texts to compress. Be looking for texts you predict will be 'easy' to compress and texts you predict will be 'difficult'")
        Paragraph():Strong("Group:"):Text(" Have students work with their neighbor for this activity. Place students in groups of 2 with at most one group of 3.")
        Paragraph():Strong("Do This:"):Text(" Students work together to compress an 'easy' text and a 'difficult' text.")
        TeachingTip()
        Paragraph():Strong(dq + "aaaa...aaa" + dq + ":"):Text(" Many groups will probably attempt the last option, all A's, as their "):DoubleQuote():Text("easy"):DoubleQuote():Text(" text - it's possible to get a compression rating into the mid-80's with this text. This is fine, since it still emphasizes one of the big takeaways from this activity: information with high repetition is easier to compress. However, it is also reasonable to ask groups to do a second "):DoubleQuote():Text("easy"):DoubleQuote():Text(" text once they're satisfied with this one")
        Paragraph():Strong("Priorities:"):Text(" It's not necessary for all groups to pick the same texts, nor is it important to find the very "):DoubleQuote():Text("best"):DoubleQuote():Text(" compressions. Instead, students should focus on the qualities that they think make some texts "):DoubleQuote():Text("easier"):DoubleQuote():Text(" or more "):DoubleQuote():Text("difficult"):DoubleQuote():Text(" than others. You can emphasize this with the questions you ask as you circulate to groups: "):DoubleQuote():Text("What made you pick this for your 'easy' text? What made you pick this for your 'difficult' text?"):DoubleQuote()
        EndCallout()
    end

    private action WrapUp5Minutes
        Section("Wrap up (5 Minutes)")
        Subsection("Synthesis")
        Paragraph():Strong("Prompt:"):Text(" What made some messages "):DoubleQuote():Text("easier"):DoubleQuote():Text(" to compress than others? What made some messages more "):DoubleQuote():Text("difficult"):DoubleQuote():Text(" to compress than others?")
        Subsubsection("Discussion Goal")
        BulletList()
        ListItem():DoubleQuote():Text("Easier"):DoubleQuote():Text(" texts usually had lots of repetition - repeated words or phrases or syllables. A useful strategy is to use this repetition to create the compression.")
        ListItem():DoubleQuote():Text("Difficult"):DoubleQuote():Text(" texts usually have less repetition, making it less likely to apply this particular method of compression. Some strategies may actually make compression worse, which can be counter-intuitive")
        Subsubsection("Remarks")
        BulletList()
        ListItem("There are many strategies we can use when creating lossless compressions and there isn't a single best way to do it. Instead, our compression rate usually depends on which strategy we choose and the patterns in the text we're compressing. Most importantly, even though the number of bytes is getting smaller, we're never actually losing information - we can always perfectly recreate the original message using our dictionary key.")
        Subsection("Journal")
        Paragraph("Have students add the definition of "):Strong("lossless compression"):Text(" to their journal")
        BulletList()
        ListItem():Emphasis("Lossless Compression:"):Text(" A process for reducing the number of bits needed to represent something without losing any information. This process is reversible.")
    end

    private action AssessmentCheckForUnderstanding
        Section("Assessment: Check for Understanding")
        Subsection("For Students")
        Paragraph("Open a word doc or google doc and copy/paste the 2 following question.")
        Subsection("Question 1")
        Paragraph("What is the most important quality of lossless compression?")
        Subsection("Question 2")
        Paragraph("An author is preparing to send their book to a publisher as an email attachment. The file on their computer is 1000 bytes. When they attach the file to their email, it shows as 750 bytes. The author gets very upset because they are concerned that part of their book has been deleted by the email address. If you could talk to this author, how would you explain what is happening to their book?")
    end

    private action StandardsAlignment
        Section("Standards Alignment")
        BulletList()
        ListItem():Strong("CSTA K-12 Computer Science Standards (2017): DA"):Text(" - Data & Analysis: 3A-DA-10 - Evaluate the tradeoffs in how data elements are organized and where data is stored.")
        ListItem():Strong("CSP2021: "):Text("DAT-1.D.1, DAT-1.D.2, DAT-1.D.3, DAT-1.D.4")
    end
end
