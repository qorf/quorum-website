use Libraries.Web.Page.QuorumPage

/*
    Digital Information - Lesson 6: Representing Text.
    Converted from the old Lesson page by plan 13's generator: the same
    words, now without Tailwind.
*/
class CodeOrgUnit1L06 is QuorumPage

    on create
        SetLocation("lessons/code/internet/InternetLesson6.html")
        // The name lists and links use, and the series and track it belongs
        // to: its section and picture.
        SetShortTitle("Representing Text")
        SetSectionName("Digital Information")
        // For search engines and link previews, and what lists of pages say.
        SetDescription("Learning 'how Encoding of Numbers is used in the real world' as a part of Computer Science Principles curriculum in Quorum Computer Science Principles curriculum page (this page correspond to the Code.org high school Computer Science Principles curriculum page). This page is accessible for the blind and visually imapaired.")
        SetSummary("how work Tortoise vs. the Hare in Quorum.")
    end

    action Setup
        SetWebPageTitle("Unit 1 Lesson 6: Representing Text")
        Title("Digital Information - Lesson 6: Representing Text")
        Overview()
        GettingStarted5Minutes()
        Activity35Mins()
        WrapUp5Minutes()
        AssessmentCheckForUnderstanding()
        StandardsAlignment()
    end

    private action Overview
        Section("Overview")
        Paragraph("In this lesson, students create a system for representing text using only numbers while communicating with each other. They are only allowed to send numbers back-and-forth, so they must create a system to translate between number and character. At the end of the main activity they briefly review the ASCII system for representing text. The wrap up discussion emphasizes how all of the concepts thus far have "):DoubleQuote():Text("built"):DoubleQuote():Text(" on each other and introduces the concept of abstraction to describe this progression.")
        Subsection("Goals")
        Paragraph("Students will be able to:")
        BulletList()
        ListItem("Develop a system for using numbers to represent text.")
        ListItem("Explain how bits are grouped to represent abstractions like numbers and text.")
        ListItem("Describe the challenges in representing text when using a fixed number of bits for each character.")
        Subsection("Purpose")
        Paragraph("After this lesson students will understand the ways the most common types of information, text and numbers, are stored using binary. More importantly they should understand the challenges or principles that led to the creation of these systems and that these systems are somewhat arbitrarily created to solve a shared problem. They work not because there was "):DoubleQuote():Text("one right answer"):DoubleQuote():Text(" but because many people agreed to use them. The wrap up discussion begins to explore the concept of abstraction. This is a challenging concept to understand and one that students will return to many times throughout the course. In this context, we emphasize how common it is to send text messages to each other yet these messages rely on many smaller layers (like binary numbers and electrical signals) to truly function correctly.")
        Subsection("Resources")
        BulletList()
        ListItem():Link("ASCII Reference Sheet", "http://sticksandstones.kstrom.com/appen.html")
    end

    private action GettingStarted5Minutes
        Section("Getting Started (5 minutes)")
        Subsection("Remarks")
        Paragraph():Strong("Prompt:"):Text(" Brainstorm with your neighbor what you think this list represents. When you think you have an idea, come up with another item to add to this list and be ready to explain why it belongs.")
        BulletList()
        ListItem("1 1")
        ListItem("2 14")
        ListItem("7 4")
        ListItem("10 31")
        Paragraph():Strong("Discussion Goal:"):Text(" Each item in the list represents a non-denominational holiday - New Years Day, Valentine's Day, Independence Day, and Halloween. Students should be initially puzzled by what this list represents - it may be helpful to point out the format of the list (two numbers) and that this list happens throughout the year.")
        Paragraph():Strong("Alternate Discussion:"):Text(" This example could be adapted to fit your classroom or school environment in order to better help your students predict what the list represents. For example: a list of room numbers in your school that students can relate to, or a list of street addresses that have meaning to students. If you decide to adapt this example, make sure it still addresses the larger concept that this warm-up introduces: that numbers can be used to represent different types of information.")
    end

    private action Activity35Mins
        Section("Activity (35 mins)")
        BulletList()
        ListItem("In our warm-up, we used numbers to represent certain type of information. In today's activity, we will also use numbers to represent something that computers use pretty frequently: text messages.")
        Paragraph():Strong("Group:"):Text(" Place students in pairs. Assign students to "):DoubleQuote():Text("Partner A"):DoubleQuote():Text(" or "):DoubleQuote():Text("Partner B"):DoubleQuote():Text(".")
        Paragraph():Strong("Distribute:"):Text(" Give each pair a few sticky notes, or some other way to record short sequences of numbers.")
        Paragraph():Strong("Do This:"):Text(" Consider the following samples:")
        BulletList()
        ListItem("hey")
        ListItem("ttyl")
        ListItem("morning")
        Paragraph("Using only numbers, you will need to communicate these samples to a partner. No letters or other characters (including spaces) allowed! Come up with a system that allows you to do this.")
        Subsection("Teaching Tip")
        Paragraph("Most likely students will arrive at a system where they assign each character to a corresponding number.")
        Paragraph("For example: a = 1, b = 2")
        Paragraph("If students are struggling, remind them to consider each character individually rather than the whole word at once.")
        Paragraph("The four challenges are designed to test the limits of the students' systems. For each challenge, after one partner has put their head down, click through to reveal the challenge to the the other partner.")
        Paragraph("After the partner has translated the message to numbers, they hand the sticky note to the other partner and put their head down. The other partner translates back to English.")
        Paragraph("After the challenge is done, give students a few minutes to update their systems as needed.")
        Paragraph("Be on the lookout for cheats in a system - students cannot use spaces (aside from between two numbers to differentiate that where one number stops and the other starts) or symbols - only numbers one after the other.")
        Subsection("Challenge #1 - Spaces")
        Paragraph():Strong("Do This:")
        BulletList()
        ListItem():Strong("Partner A:"):Text(" Heads down!")
        ListItem():Strong("Partner B:"):Text(" On a sticky note, use your system to write the message: oh no")
        BulletList()
        ListItem():Strong("Partner A:"):Text(" Heads Up! Translate the message on the sticky note using your system.")
        ListItem():Strong("Partner B:"):Text(" Heads down!")
        Paragraph():Strong("Do This:"):Text(" Heads up! Check your answers. After students have checked, allow them time to update their system as needed.")
        Subsection("Challenge #2 - Punctuation")
        Paragraph():Strong("Do This:")
        BulletList()
        ListItem():Strong("Partner A:"):Text(" Heads down!")
        ListItem():Strong("Partner B:"):Text(" On a sticky note, use your system to write the message: Great!")
        BulletList()
        ListItem():Strong("Partner A:"):Text(" Heads Up! Translate the message on the sticky note using your system.")
        ListItem():Strong("Partner B:"):Text(" Heads down!")
        Paragraph():Strong("Do This:"):Text(" Heads up! Check your answers. After students have checked, allow them time to update their system as needed.")
        Subsection("Challenge #3 - Capitals and Numbers")
        Paragraph():Strong("Do This:")
        BulletList()
        ListItem():Strong("Partner A:"):Text(" Heads down!")
        ListItem():Strong("Partner B:"):Text(" On a sticky note, use your system to write the message: Free at 5?")
        BulletList()
        ListItem():Strong("Partner A:"):Text(" Heads Up! Translate the message on the sticky note using your system.")
        ListItem():Strong("Partner B:"):Text(" Heads down!")
        Paragraph():Strong("Do This:"):Text(" Heads up! Check your answers. After students have checked, allow them time to update their system as needed.")
        Subsection("Challenge #4 - Review all symbols")
        Paragraph():Strong("Do This:")
        BulletList()
        ListItem():Strong("Partner A:"):Text("Heads down!")
        ListItem():Strong("Partner B:"):Text(" On a sticky note, use your system to write the message: Cya 2nite!")
        BulletList()
        ListItem():Strong("Partner A:"):Text(" Heads Up! Translate the message on the sticky note using your system.")
        ListItem():Strong("Partner B:"):Text(" Heads down!")
        Paragraph():Strong("Do This:"):Text(" Heads up! Check your answers. After students have checked, allow them time to update their system as needed.")
        Paragraph():Strong("Prompt:"):Text(" Find another group. Discuss with them the following prompts:")
        BulletList()
        ListItem("Compare your systems. How are they the same? How are they different?")
        ListItem("What's the minimum number of bits each of your system would need per character? How do you know?")
        ListItem("Hint: Convert your largest number in your system into binary. How many bits does this number require?")
        Paragraph():Strong("Discuss: "):Text("Have groups compare with each other, then move to a full group discussion. Ask groups to share out what they discussed about their systems.")
        DiscussionGoal()
        BulletList()
        ListItem("There's many possible systems and there's usually not a "):DoubleQuote():Text("right"):DoubleQuote():Text(" one so long as everyone agrees.")
        ListItem("Adding more possibilities increases the risk of having too many characters to represent and not enough bits to do it. This is a practical example of the overflow and rounding issues from the previous lesson.")
        EndCallout()
        Subsection("Introduce ASCII")
        BulletList()
        ListItem("You just invented your own scheme for representing text with numbers. Given we use text on our phones and computers all the time, we should assume there is a standard representation for most of the symbols you can type on an American keyboard. Today we're going to be looking at one called or ASCII (pronounced: "):DoubleQuote():Text("Ask-ee"):DoubleQuote():Text(") or the American Standard Code for Information Interchange")
        Paragraph("Hand out copies of the "):Link("ASCII Reference Sheet", "https://docs.google.com/document/d/15pgXcGUX7XbAAGBkHfXMMLFwDP5cTKKZ-zFIfFKu9FQ/edit"):Text(" or project it. Quickly read the overview text at the beginning of the sheet.")
        Paragraph():Strong("Teaching Tip:"):Text(" Students should be aware that ASCII exists and see how its development mirrors their own experiences in the previous activity, but they are not required to memorize the ASCII table. If your students are able to quickly recognize the point of the ASCII table feel free to move on to the wrap up.")
        Paragraph():Strong("Prompt:"):Text(" Compare ASCII to the system you developed.")
        BulletList()
        ListItem("What's the same as the systems you created?")
        ListItem("What's different?")
        ListItem("What is most interesting or surprising about this system?")
        Paragraph():Strong("Discuss:"):Text(" Briefly discuss these prompts as a class. At this point the main features of the system should be familiar but use this discussion to reinforce previous points.")
    end

    private action WrapUp5Minutes
        Section("Wrap up (5 Minutes)")
        BulletList()
        ListItem("Representing text is an example of "):Strong("abstraction"):Text(", which is when we create simplified representations of something more complex. This lets us hide the details and instead focus on problems at a higher level.")
        Subsection("Prompt")
        BulletList()
        ListItem("What problem were we trying to solve today?")
        ListItem("What detail from the last few lessons was hidden or out of focus?")
        DiscussionGoal()
        BulletList()
        ListItem("Students should identify they were trying to send text messages.")
        ListItem("Students were using decimal numbers instead of binary numbers or AB patterns")
        EndCallout()
        Subsection("Remarks")
        BulletList()
        ListItem("Sending text messages is an example of "):Strong("abstraction"):Text(". For a computer, each character is really just a number, which itself is really a binary number. It all comes back to zeroes and ones!")
        Paragraph():Strong("Prompt:"):Text(" What is another example of an abstraction in your everyday life? Something where you don't completely understand how it works but you can still use it with confidence?")
        Paragraph():Strong("Discussion Goal:"):Text(" Student answers will vary. Examples: driving a car, turning on the lights in your room, riding in an elevator, etc.")
    end

    private action AssessmentCheckForUnderstanding
        Section("Assessment: Check for Understanding")
        Subsection("For Students")
        Paragraph("Open a word doc or google doc and copy/paste the 3 following question.")
        Subsection("Question")
        Paragraph():DoubleQuote():Text("The binary pattern 01000001 represents the number 65."):DoubleQuote():Text(" Write a brief response explaining whether or not you believe this statement is always true. Explain your reasoning.")
    end

    private action StandardsAlignment
        Section("Standards Alignment")
        BulletList()
        ListItem():Strong("CSTA K-12 Computer Science Standards (2017): AP"):Text(" - Algorithms & Programming: 3A-AP-21 - Evaluate and refine computational artifacts to make them more usable and accessible.")
        ListItem():Strong("CSTA K-12 Computer Science Standards (2017): DA"):Text(" - Data & Analysis: 3A-DA-09 - Translate between different bit representations of real-world phenomena, such as characters, numbers, and images.")
        ListItem():Strong("CSP2021: "):Text("DAT-1.A.5, DAT-1.A.6, DAT-1.A.7")
    end
end
