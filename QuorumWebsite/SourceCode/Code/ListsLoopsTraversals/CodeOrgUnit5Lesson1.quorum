use Libraries.Web.Page.QuorumPage
use Libraries.Web.Page.TableRowWriter

/*
    Lists, Loops, and Traversals - Lesson 1: Lists Explore.
    Converted from the old Lesson page by plan 13's generator: the same
    words, now without Tailwind.
*/
class CodeOrgUnit5Lesson1 is QuorumPage
    // A double quote, for code and words that hold one.
    text dq = ""
    // The table row being written, when its cells hold more than words.
    TableRowWriter row = undefined

    on create
        SetLocation("lessons/code/BuildingApps/Lesson1.html")
        // The name lists and links use, and the series and track it belongs
        // to: its section and picture.
        SetShortTitle("Lists Explore")
        SetSectionName("Lists, Loops, and Traversals")
        SetCardImage("/media/userInterface/quorumAssets/cspImages/csp6.svg")
        SetCardDescription("This unit introduces lists, loops, and traversals, and explores the way they can be used to build apps that store and process large amounts of information.")
        // For search engines and link previews, and what lists of pages say.
        SetDescription("Learn how to use lists to store lots of information")
        SetSummary("Learn about lists")
    end

    action Setup
        dq = dq:GetDoubleQuote()
        SetWebPageTitle("Unit 5 Lesson 1: Lists Explore")
        Title("Lists, Loops, and Traversals - Lesson 1: Lists Explore")
        Overview()
        GettingStarted5Minutes()
        Activity30Minutes()
        WrapUp10Minutes()
        AssessmentCheckForUnderstanding()
        StandardsAlignment()
    end

    private action Overview
        Section("Overview")
        Paragraph("Students will learn the ways that lists are created, accessed, and changed through a teacher-guided activity using plastic baggies and pieces of paper. The lesson begins with a brief reflection on the value of lists. Students then complete the main activity which introduces the syntax to use lists and the ways they can be used. To wrap up students watch two short videos on lists and record the main concepts in their journals.")
        Subsection("Goals")
        Paragraph("Students will be able to:")
        BulletList()
        ListItem("Use appropriate vocabulary to describe lists.")
        ListItem("Use an index to reference specific elements in a list")
        Subsection("Purpose")
        Paragraph("In the warmup, students brainstorm different lists of information that they encounter on a daily basis. Then in the activity, students return to baggies and sticky notes from the previous unit to build a concrete model of a list before seeing how lists are programmed in Javascript and Quorum. Students are exposed to different ways of interacting with a list like accessing, removing, appending, and inserting elements. The wrap up concludes the lesson with a summary video and a journal vocabulary exercise.")
        Subsection("Resources")
        Paragraph("For the students")
        BulletList()
        ListItem():Link("Code.org CSP Unit 5 Presentation Slides (Optional)", "https://docs.google.com/presentation/d/1qQPTgZxJnYZRl-9Do2UB_hM882QtouLclWfCsw8jDBw/copy")
        ListItem():Link("CS Principles: Introduction to Lists - Part 1 Intro", "https://youtu.be/n1exiRH00x0")
        ListItem():Link("CS Principles: Introduction to Lists - Part 2 Accessing Lists", "https://youtu.be/TL0Y_GI4NZg")
        Subsubsection("Supplemental code.org material")
        BulletList()
        ListItem():Link("Code.org CSP Unit 5 Presentation Slides (Optional)", "https://docs.google.com/presentation/d/1qQPTgZxJnYZRl-9Do2UB_hM882QtouLclWfCsw8jDBw/copy")
        Subsection("Preparation")
        Paragraph("If you want to use physical manipulatives for this lesson, you'll need to prepare the following:")
        BulletList()
        ListItem("7+ sandwich baggies per pair of students")
        ListItem("1 gallon-sized baggy per pair of students")
        ListItem("packs of red and orange stickies")
        ListItem("pens / pencils")
        ListItem("1 dry erase marker per four students (pairs can share)")
        ListItem("If you are using the slides, review them and click through all animations")
    end

    private action GettingStarted5Minutes
        Section("Getting Started (5 minutes)")
        Paragraph():Strong("Prompt:"):Text(" With a partner, brainstorm lists of information that you encounter on a daily basis. Why are lists useful?")
        Paragraph():Strong("Discuss:"):Text(" Have students discuss with a partner and then have a few students share out their responses.")
        DiscussionGoal()
        BulletList()
        ListItem("Lists help us group together like information")
        ListItem("We can go through a list item by item to check off things we have completed")
        ListItem("Lists help us stay organized")
        EndCallout()
        Paragraph():Strong("Group:"):Text(" Group students in pairs.")
        Paragraph():Strong("Distribute:"):Text(" Give each pair of students:")
        BulletList()
        ListItem("A small stack of red and orange sticky notes")
        ListItem("A pen/pencil")
        ListItem("7+ snack-sized plastic baggies")
        ListItem("One gallon-sized plastic baggy")
        ListItem("A dry erase marker to share with another group")
        TeachingTip()
        Paragraph():Strong("Supplies Substitutions:"):Text(" There's no need to use stick notes if you have other scraps of colored paper. Also consider cutting stickies in 4 to make them go further. If you don't have dry erase markers handy consider using pieces of masking tape on the baggies. The gallon-sized baggie can be replaced with any baggie that is large enough to hold the snack-sized baggies.")
        Paragraph():Strong("Alternatives for Accessibility or Distance Learning:"):Text(" Instead of using the physical materials listed here, you can use alternate physical or digital materials that are more convenient for your class.")
        Paragraph("Similar to Unit 4 Lesson 1, you can have pairs of students share an online document as their workspace. Students can use numbered lists in the document to represent lists, where each line in the list represents an element of the list. Have students store strings using quotes and numbers without quotes.")
        Paragraph("Whatever approach you use, the goal is to teach students about the concepts of lists, especially how information can be stored and accessed by using specific "):DoubleQuote():Text("addresses"):DoubleQuote():Text(" in the list.")
        EndCallout()
        Paragraph():Strong("Guided Activity:"):Text(" Today's activity introduces students to the concept of lists. As a visual aid, you can use "):Link("Code.org's presentation slides for Unit 5, Lesson 1: Lists Explore.", "https://docs.google.com/presentation/d/1qQPTgZxJnYZRl-9Do2UB_hM882QtouLclWfCsw8jDBw/copy"):Text(" These slides include animations. The notes below describe when to move to the next slide or click through an animation -- if you aren't using the slides, you can ignore these prompts.")
        Paragraph():Strong("Discuss:"):Text(" Discuss with the class any questions.")
    end

    private action Activity30Minutes
        Section("Activity (30 minutes)")
        Subsection("Guided Activity")
        Paragraph("Follow this lesson with the supplemental slides.")
        Table("Lecture Slides")
        TableHeader():Cell("Slide"):Cell("Speaker Notes")
        TableRow():Cell("Activity Title"):Cell("Today, we are going to explore lists.")
        TableRow():Cell("var myName = " + dq + "Jose" + dq):Cell("We've already learned that variables can help us store one piece of information.")
        TableRow():Cell("But what if we have a lot of information?"):Cell("But what if we have lots of information? With a partner, discuss the challenges that you'd encounter if you need to store 10, or 100, or 1,000 pieces of information using variables. Lead a short discussion on the challenges they'd encounter. The main challenges are that you'd need to make a variable for each piece of information and it could get difficult to name them all.")
        TableRow():Cell("Creating and Accessing Lists"):Cell("Let's look at how to use lists.")
        TableRow():Cell("Lists"):Cell("Today we're going to practice using a new way to store information called a list. Follow the instructions here to make a list of your own: art with a number) Gallon baggie connected to smaller baggies Gallon baggie connected to smaller baggies Gallon baggies are named with the same rules as a variable (no spaces, can't start with a number) Smaller baggies are numbered starting at 0 If you are using alternative materials, you may need to provide different instructions here. Also, if you are using an online document, it's okay to let students start numbering their lists from 1 instead of 0. There will be other opportunities to show how indexing starts at 0 in lists later. Have students create their own lists that holds between 2 and 4 values, then share with another group. Circulate the room to check on how they're doing.")
        row = TableRow()
        row:Cell():Text("Your list is made up of elements.")
        row:Cell():Text("Your list is made up of elements. Each element has its own index. Indexes are just numbers that count up from zero. The length of the list is how many elements it contains. This list has 3 elements and indexes from 0 to 2. "):Code("Books:"):NewLine():Code("0. " + dq + "Redwall" + dq):NewLine():Code("1. " + dq + "Hunger Games" + dq):NewLine():Code("2. " + dq + "Wrinkle in Time" + dq)
        TableRow():Cell("Notice that all the bags can be folded up..."):Cell("Notice that all the bags can be folded up and be placed inside the big variable baggie. Sometimes we want to think about the whole list, sometimes we want to think about individual elements")
        row = TableRow()
        row:Cell():Text("var myList = ["):DoubleQuote():Text("pizza"):DoubleQuote():Text(", 4]")
        row:Cell():Text("Let's create this list using a command. "):Code("myList:"):NewLine():Code("0. " + dq + "pizza" + dq):NewLine():Code("1. 4")
        row = TableRow()
        row:Cell():Text("Variable Creation")
        row:Cell():Text("In JavaScript, we would use this command. It creates a new list and assigns it to a variable. The square brackets indicate we're making a list. Each value is separated by commas. "):Code("var myList = [" + dq + "pizza" + dq + ", 4]"):Text(" In Quorum, the code looks different. We make an "):DoubleQuote():Text("Array"):DoubleQuote():Text(" variable (which is just another name for lists). Then we add the items to it. In Quorum, we use the angled brackets to indicate what type of variables are allowed to stay in the list. "):Code("Array<text> myList"):NewLine():Code("myList:Add(" + dq + "pizza" + dq + ")"):NewLine():Code("myList:Add(" + dq + "4" + dq + ")"):Text(" Have students write the code to make their own list and the list of partner group. By sharing their answers with another group they can check that they're following along.")
        row = TableRow()
        row:Cell():Text("myList[1]")
        row:Cell():Text("If we want to access the values in our list, in Javascript we use the square brackets next to the name of our list. "):Code("myList[1]"):Text(" In Quorum, we use the "):DoubleQuote():Text("Get"):DoubleQuote():Text(" command instead. "):Code("myList:Get(1)"):Text(" Question: What does lunchFood[0] access in Javascript? What does lunchFood:Get(2) access in Quorum? "):Code("lunchFood:"):NewLine():Code("0. " + dq + "nachos" + dq):NewLine():Code("1. " + dq + "pizza" + dq):NewLine():Code("2. " + dq + "soup" + dq):Text(" Have students discuss with other groups. They should see the answers are "):DoubleQuote():Text("nachos"):DoubleQuote():Text(" and "):DoubleQuote():Text("soup"):DoubleQuote()
        row = TableRow()
        row:Cell():Text("Lists and Expressions")
        row:Cell():Text("We can use list accesses inside of expressions, just like variables. Let's look at a list and some expressions. "):Code("myNumbers:"):NewLine():Code("0. 10"):NewLine():Code("1. 20"):NewLine():Code("2. 25")
        row = TableRow()
        row:Cell():Code("3 + myNumbers:Get(1)"):NewLine():Code("myNumbers:Get(0) + myNumbers:Get(2)")
        row:Cell():Text("Click for animation. This first expression evaluates to 23 because myNumbers contains 20 at index 1. Click for animation. The second expression evaluates to 35 because myNumbers[0] and myNumbers[2] contain 25 and 10. Have students write three expressions using their own lists. Then have them trade with another group to practice evaluating. Circulate the room to make sure students are following the directions correctly.")
        row = TableRow()
        row:Cell():Text("myList[1] = "):DoubleQuote():Text("hello"):DoubleQuote()
        row:Cell():Text("We can assign the index of a list just like a variable. Show students the lines of code on the slide, or present them with the Quorum code below. Have students discuss what the list will contain after the last line runs "):Code("Array<integer> myList"):NewLine():Code("myList:Add(10)"):NewLine():Code("myList:Add(20)"):NewLine():Code("myList:Add(25)"):NewLine():Code("myList:Set(0, 5)"):NewLine():Code("myList:Set(2, 30)"):Text(" Click for animation. This code will assign new values at indexes 0 and 2 in the list.")
        row = TableRow()
        row:Cell():Text("Do This: Run this program...")
        row:Cell():Text("Have students "):DoubleQuote():Text("run"):DoubleQuote():Text(" the program on the slide or the code below. "):Code("Array<text> myStuff"):NewLine():Code("myStuff:Add(" + dq + "20" + dq + ")"):NewLine():Code("myStuff:Add(" + dq + "hat" + dq + ")"):NewLine():Code("myStuff:Add(" + dq + "pow" + dq + ")"):NewLine():Code("myStuff:Add(" + dq + "5" + dq + ")"):NewLine():Code("myStuff:Set(1, " + dq + "cat" + dq + ")"):NewLine():Code("myStuff:Set(2, myStuff:Get(1))"):NewLine():Code("myStuff:Set(0, myStuff:Get(3) + 10)"):NewLine():Code("myStuff:Set(3, myStuff:Get(0) + myStuff:Get(0))"):Text(" Although the lists in Quorum and Javascript are similar, running each section of code will give different results. The list in Quorum only allows strings, while the Javascript list allows any kind of variable in each position. That means that the integers will be concatenated onto the end of the strings in Quorum, instead of adding integers together. Click for animation. Quickly discuss with the class what the list looks like at the end of the program.")
        row = TableRow()
        row:Cell():Text("Do This: You can use expressions...")
        row:Cell():Text("You can use expressions in the place of the list index. Run this program and compare your result with another group. "):Code("Array<integer> myStuff"):NewLine():Code("myStuff:Add(25)"):NewLine():Code("myStuff:Add(400)"):NewLine():Code("myStuff:Add(3)"):NewLine():Code("myStuff:Add(10)"):NewLine():Code("myStuff:Set(2 - 1, 80)"):NewLine():Code("myStuff:Set(myStuff:Get(2), myStuff:Get(0))"):Text(" Circulate the room while students run this program. Click for animation. Discuss quickly with the class what the list looks like when the program ends.")
        TableRow():Cell("Changing Your List"):Cell("Now let's learn about three different commands that can change your list.")
        row = TableRow()
        row:Cell():Text("removeItem(list, index)")
        row:Cell():Text("The "):Code("RemoveAt"):Text(" command will remove an item from an array. The item at the index given is removed, items to the right are shifted over, and the last index is removed. Have students discuss what the list will show after this command. "):Code("Array<integer> myNumbers"):NewLine():Code("myNumbers:Add(10)"):NewLine():Code("myNumbers:Add(20)"):NewLine():Code("myNumbers:Add(25)"):NewLine():Code("myNumbers:RemoveAt(1)"):NewLine():Code("myNumbers:RemoveAt(0)"):Text(" Click for animation. Discuss with the class any questions.")
        row = TableRow()
        row:Cell():Text("appendItem(list, item)")
        row:Cell():Text("The Add command adds an item to a list. As we've seen, a new index is added to the end of the list and the new item is placed in it. Have students discuss what the list will show after this command "):Code("Array<integer> nums"):NewLine():Code("nums:Add(10)"):NewLine():Code("nums:Add(50)"):NewLine():Code("nums:Add(100)"):Text(" Click for animation. Discuss with the class any questions. If you're using the slides, this slide introduces a new command in Javascript. In Quorum, this is the same command that we have already used to make our lists. You can use this slide to highlight the difference between the standard Add command and the command on the next slide, or you can choose to skip it.")
        row = TableRow()
        row:Cell():Text("insertItem(list, index, item)")
        row:Cell():Text("We can also use the Add command to add an item to the middle of a list. The item is placed at the index given. The old item at that index, plus all of the items to the right, are moved over one space to make room. A new index is added to the end of the list for the last item. Have students discuss what the list will show after this command. "):Code("Array<integer> nums"):NewLine():Code("nums:Add(10)"):NewLine():Code("nums:Add(50)"):NewLine():Code("nums:Add(1, 20)"):NewLine():Code("nums:Add(1, 100)"):Text(" Click for animation. Discuss with the class any questions.")
        row = TableRow()
        row:Cell():Text("Do This: Run this program...")
        row:Cell():Text("Have students run this program. Circulate the room to support them with any questions. "):Code("Array<text> aList"):NewLine():Code("aList:Add(" + dq + "20" + dq + ")"):NewLine():Code("aList:Add(" + dq + "hat" + dq + ")"):NewLine():Code("aList:Add(" + dq + "pow" + dq + ")"):NewLine():Code("aList:Add(" + dq + "5" + dq + ")"):NewLine():Code("aList:Add(" + dq + "10" + dq + ")"):NewLine():Code("aList:Remove(1)"):NewLine():Code("aList:Add(2, " + dq + "bang" + dq + ")"):Text(" Click for animation. Discuss with the class any questions.")
        row = TableRow()
        row:Cell():Text("Do This: Run this program... (2)")
        row:Cell():Text("Have students run this program. Circulate the room to support them with any questions. "):Code("Array<text> bList"):NewLine():Code("bList:Add(" + dq + "to" + dq + ")"):NewLine():Code("bList:Add(" + dq + "5" + dq + ")"):NewLine():Code("bList:Add(" + dq + "po" + dq + ")"):NewLine():Code("bList:Add(bList:Get(2) + " + dq + "ta" + dq + " + bList:Get(0))"):NewLine():Code("bList:Add(2-1, " + dq + "go" + dq + ")"):NewLine():Code("bList:Remove(2)"):Text(" Discuss with the class any questions.")
        TableRow():Cell("var myName = " + dq + "Jose" + dq):Cell("We've already learned that variables can help us store one piece of information.")
    end

    private action WrapUp10Minutes
        Section("Wrap Up (10 minutes)")
        Subsection("Remarks")
        Paragraph():Strong("Videos:"):Text(" As a class, watch both videos on lists.")
        BulletList()
        ListItem():Link("CS Principles: Introduction to Lists - Part 1 Intro", "https://youtu.be/n1exiRH00x0")
        ListItem():Link("CS Principles: Introduction to Lists - Part 2 Accessing Lists", "https://youtu.be/TL0Y_GI4NZg")
        Paragraph():Strong("Do This:"):Text(" Review the Key Takeaways below and have students add to their journals: lists, element, and index.")
        Subsection("Key Takeaways")
        BulletList()
        ListItem("A "):Strong("List"):Text(" is an ordered collection of elements")
        ListItem("An "):Strong("Element"):Text(" is an individual value in a list that is assigned a unique index")
        ListItem("An "):Strong("index"):Text(" a common method for referencing the elements in a list or string using numbers")
        ListItem("The length of a list is how many elements it contains. Lists can grow or shrink as elements are added or removed.")
        ListItem("Lists are an example of data abstraction. They allow us to name and program with large collections of information while ignoring the low level details of how the data is stored, organized, etc. These programs are easier to develop and mantain.")
    end

    private action AssessmentCheckForUnderstanding
        Section("Assessment: Check for Understanding")
        Paragraph("Check For Understanding Question(s) and solutions can be found in each lesson on Code Studio. These questions can be used for an exit ticket.")
        Subsection("For Students")
        Paragraph("Open a word doc or google doc and copy/paste the following question.")
        Subsection("Question")
        Paragraph("Match the index in the following list with the value from the array in the code snippet. For example in the array at the index of 1 is the value 64.")
        CodeExample("var myNumbers = [32,64,33,0,15,26,3] ", "")
        BulletList()
        ListItem("0")
        ListItem("4")
        ListItem("3")
        ListItem("6")
    end

    private action StandardsAlignment
        Section("Standards Alignment")
        BulletList()
        ListItem():Strong("CSTA K-12 Computer Science Standards (2017): "):Text("3A-AP-14")
        ListItem():Strong("CSP2021: "):Text("AAP-1.C.1, AAP-1.C.2, AAP-1.C.3")
        ListItem():Strong("CSP2021: "):Text("AAP-2.N.2")
        ListItem():Strong("CSP2021: "):Text("AAP-2.O.3, AAP-2.0.4")
    end
end
