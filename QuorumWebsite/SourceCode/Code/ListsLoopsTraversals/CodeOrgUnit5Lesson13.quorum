use Libraries.Web.Page.QuorumPage

/*
    Lists, Loops, and Traversals - Lesson 13: Project - Hackathon Part 1.
    Converted from the old Lesson page by plan 13's generator: the same
    words, now without Tailwind.
*/
class CodeOrgUnit5Lesson13 is QuorumPage

    on create
        SetLocation("lessons/code/BuildingApps/Lesson13.html")
        // The name lists and links use, and the series and track it belongs
        // to: its section and picture.
        SetShortTitle("Project - Hackathon Part 1")
        SetSectionName("Lists, Loops, and Traversals")
        // For search engines and link previews, and what lists of pages say.
        SetDescription("Begin designing your project using a dataset")
        SetSummary("Start the unit project")
    end

    action Setup
        SetWebPageTitle("Unit 5 Lesson 13: Project - Hackathon Part 1")
        Title("Lists, Loops, and Traversals - Lesson 13: Project - Hackathon Part 1")
        Overview()
        GettingStarted3Minutes()
        Activity40Minutes()
        WrapUp2Minutes()
        AssessmentOptional()
        StandardsAlignment()
    end

    private action Overview
        Section("Overview")
        Paragraph("This is the first day of a five-day unit project. Students begin the project by choosing a partner, determining a dataset to design the app around, and creating a paper prototype.")
        Subsection("Goals")
        Paragraph("Students will be able to:")
        BulletList()
        ListItem("Effectively plan a project using a paper prototype")
        ListItem("Determine a dataset for project usage")
        Subsection("Purpose")
        Paragraph("Students will demonstrate their app design and programming skills throughout this five day project. In addition, students work with a dataset as this ensures students will be using the types of programming constructs required for the Create Performance Task, which this project is designed as a practice for. Students complete the project by individually filling out a Written Response, modeled after the Create PT.")
        Paragraph("This project can be used as a unit project, or as an end cap to the first semester of the course.")
        Subsection("Resources")
        BulletList()
        ListItem():Link("CSP-Widgets repository", "https://github.com/qorf/CSP-Widgets")
        ListItem():Link("CSP Unit 5 Hackathon Project - Written Response", "https://docs.google.com/document/d/1DN78RvCqq_mlTh9VLsBberQQV4xctby5PU6N4LLhDcU/edit?usp=sharing")
        ListItem():Link("CSP Unit 5 Hackathon Project - Planning Guide", "https://docs.google.com/document/d/1Hc8LF0AsiPK_JyRaieKC6Kint6savoassU4ncz6GuTc/edit?usp=sharing")
    end

    private action GettingStarted3Minutes
        Section("Getting Started (3 minutes)")
        Subsection("Intro the Project")
        BulletList()
        ListItem("Today we are beginning the Hackathon Project, which is an opportunity for you to show off what you've learned so far.")
        ListItem("What is a hackathon? Traditionally, hackathons are events where people come together to build something creative in a short amount of time. Sometimes hackathons are centered around a goal or a problem to solve. Usually team members take on different roles (programming, designing, etc.) to get the project done within the time limit.")
        ListItem("You will work with a partner on the Hackathon Project, using a database to create an interesting app.")
    end

    private action Activity40Minutes
        Section("Activity (40 minutes)")
        Subsection("Hackathon Prep")
        TeachingTip()
        Paragraph():Strong("Forming Groups:"):Text(" You may opt to form the groups yourself, randomly place students in groups, or let students select their partners based on the dataset they want to work with.")
        Paragraph():Strong("Previewing the Written Response:"):Text(" You may opt to share the "):Link("CSP Unit 5 Hackathon Project - Written Response", "https://docs.google.com/document/d/1DN78RvCqq_mlTh9VLsBberQQV4xctby5PU6N4LLhDcU/edit?usp=sharing"):Text(" with students early just so they know what they'll be expected to write at the end of the 5-day project.")
        EndCallout()
        Paragraph():Strong("Group:"):Text(" Place students in groups of two.")
        Paragraph():Strong("Distribute:"):Text(" Pass out the "):Link("CSP Unit 5 Hackathon Project - Planning Guide", "https://docs.google.com/document/d/1Hc8LF0AsiPK_JyRaieKC6Kint6savoassU4ncz6GuTc/edit?usp=sharing"):Text(" - one per group.")
        Paragraph():Strong("Read:"):Text(" As a class, read through the Project Description on the Planning Guide.")
        Subsection("Hackathon Project")
        Paragraph():Strong("Step 1:"):Text(" Students inspect the data files in the Data folder in the "):Strong("Unit_ProjectTemplate"):Text(" project. Have students select a dataset that looks interesting to them.")
        Paragraph():Strong("Step 2:"):Text(" Now students select how they will traverse a list pulled from their chosen dataset. Using the Planning Guide, students select whether they will use the filter, map, or reduce pattern and explain the specifics.")
        BulletList()
        ListItem("Filter (most common option): use the list from one column to determine information that will be filtered from a list created by another column")
        NestedBulletList()
        ListItem("Example: dogHeight filters dogNames, so only the names of small dogs are added to the filtered list")
        EndNestedList()
        ListItem("Map: Add or change each item in a list")
        NestedBulletList()
        ListItem("Example: map a list of numbers pulled from a column using "):Code("Round(number)"):Text(" - now each number is rounded")
        EndNestedList()
        ListItem("Reduce: Reduce the data in a list to a single number")
        NestedBulletList()
        ListItem("Example: find the smallest number in a list")
        EndNestedList()
        Paragraph():Strong("Step 3:"):Text(" The majority of the lesson should be spent on creating a detailed paper prototype. Students work together to design the screens of their app and design the flow from one screen to the next.")
        BulletList()
        ListItem("Draw a prototype which shows how your app will actually run.")
        ListItem("Include all the buttons, text, and images that the user will be able to use and see.")
        ListItem("Write notes or draw arrows showing how different user interface elements should work. For example, if clicking a button takes me to another screen, I should draw an arrow from that button to the drawing of the screen.")
    end

    private action WrapUp2Minutes
        Section("Wrap Up (2 minutes)")
        Subsection("Remarks")
        BulletList()
        ListItem("In the next lesson, you will decide your project roles and we will begin to translate your paper prototype to the screen.")
    end

    private action AssessmentOptional
        Section("Assessment: Optional")
        Paragraph():Strong("Planning Guide:"):Text(" As an optional completion assessment, you can look at steps 1-3 in the Planning Guide.")
    end

    private action StandardsAlignment
        Section("Standards Alignment")
        BulletList()
        ListItem():Strong("CSTA K-12 Computer Science Standards (2017): "):Text("3A-AP-14, 3A-AP-16, 3A-AP-22, 3A-AP-23")
    end
end
