use Libraries.Web.Page.QuorumPage

/*
    Lists, Loops, and Traversals - Lesson 12: Traversals Make.
    Converted from the old Lesson page by plan 13's generator: the same
    words, now without Tailwind.
*/
class CodeOrgUnit5Lesson12 is QuorumPage

    on create
        SetLocation("lessons/code/BuildingApps/Lesson12.html")
        // The name lists and links use, and the series and track it belongs
        // to: its section and picture.
        SetShortTitle("Traversals Make")
        SetSectionName("Lists, Loops, and Traversals")
        // For search engines and link previews, and what lists of pages say.
        SetDescription("Make the Random Forecaster app using traversals")
        SetSummary("Make a project with traversals")
    end

    action Setup
        SetWebPageTitle("Unit 5 Lesson 12: Traversals Make")
        Title("Lists, Loops, and Traversals - Lesson 12: Traversals Make")
        Overview()
        GettingStarted2Minutes()
        Activity38Minutes()
        WrapUp5Minutes()
        AssessmentMakeProject()
        StandardsAlignment()
    end

    private action Overview
        Section("Overview")
        Paragraph("Using Programming Patterns and a step-by-step approach students make their own version of a Random Forecaster app. At the beginning of the lesson students are able to explore a working version of the app. They are then given the design elements of the app but begin with a blank screen. Students use an Activity Guide to go through the high level steps they should use to develop their app but leaves it to them to decide how to write the code. At the end students submit their apps which can be assessed using a provided rubric.")
        Subsection("Goals")
        Paragraph("Students will be able to:")
        BulletList()
        ListItem("Recognize the need for programming patterns with traversals as part of developing a functioning app")
        ListItem("Implement programming patterns with traversals to develop a functioning app")
        ListItem("Write comments to clearly explain both the purpose and function of different segments of code within an app")
        ListItem("Use debugging skills as part of developing an app")
        Subsection("Purpose")
        Paragraph("This lesson is an opportunity for students to take on the "):DoubleQuote():Text("blank screen"):DoubleQuote():Text(" and build the code that runs an app entirely from scratch. Guidance provided throughout the lesson helps students break down the large task of "):DoubleQuote():Text("building an app"):DoubleQuote():Text(" into more incremental steps that they can use on future projects, including this unit's final project and the Create PT.")
        Subsection("Resources")
        BulletList()
        ListItem():Link("CSP-Widgets repository", "https://github.com/qorf/CSP-Widgets")
        Subsubsection("Supplemental Code.org material")
        BulletList()
        ListItem():Link("CSP Traversals Make - Random Forecaster App (Activity Guide) (Optional)", "https://docs.google.com/document/d/1a6MK9hALSWPJ_mHs0uM5dwrGammMAr5IfXGbf7gtczg/edit?usp=sharing")
    end

    private action GettingStarted2Minutes
        Section("Getting Started (2 minutes)")
        Subsection("Intro the Project")
        BulletList()
        ListItem("For the past few days, we've learned a lot about using traversals to make apps that manipulate large amounts of information. In today's Make Project you'll be practicing processing lists and using programming patterns with traversals to create a functioning Random Forecaster app.")
        TeachingTip()
        Paragraph():Strong("Short Intro:"):Text(" The Warm Up today is short and light. Students should spend the maximum amount of time working on their projects.")
        EndCallout()
    end

    private action Activity38Minutes
        Section("Activity (38 minutes)")
        Subsection("Try the Random Forecaster App")
        Paragraph():Strong("Group:"):Text(" Make a determination as to whether this project will be completed in pairs or individually. You may even choose to let students decide.")
        Paragraph():Strong("Open a Project:"):Text(" Have students explore the working Random Forecaster app in the "):Strong("Lesson12_ExampleApp"):Text(" project. Students shouldn't inspect the code of the example app at this point.")
        Paragraph():Strong("Do This:")
        BulletList()
        ListItem("Click on Get Forecast")
        ListItem("Click the button several times to see how the display changes.")
        Paragraph():Strong("Prompt:"):Text(" If students are not working in pairs they should still discuss these prompts with a neighbor:")
        BulletList()
        ListItem("What information is needed to create this app?")
        ListItem("What list filtering patterns might be used?")
        DiscussionGoal()
        BulletList()
        ListItem("What information is needed to create this app?")
        NestedBulletList()
        ListItem("The weather forecast for a specific date for random cities, including the weather condition, high and low temperatures, and a weather icon.")
        EndNestedList()
        ListItem("What list filtering patterns might be used?")
        NestedBulletList()
        ListItem("The List Filter Pattern: Filtering Multiple Lists is used.")
        EndNestedList()
        EndCallout()
        Subsection("Make the Random Forecaster App")
        BulletList()
        ListItem("Now let's build this app. The screen has been set up for you - it's your job to add the code!")
        Paragraph():Strong("Do This:"):Text(" Direct students to open the "):Strong("Lesson12_ProjectTemplate"):Text(" project where they complete the Random Forecaster app. An optional Activity Guide is provided if students would like guidance in creating the app. You may also choose to quickly review the "):Emphasis("List Filter Pattern: Filtering Multiple Lists"):Text(" pattern with students, if needed.")
        Paragraph():Strong("Submit:"):Text(" Encourage students to check the rubric on the last page of the Activity Guide before submitting.")
        TeachingTip()
        Paragraph():Strong("Supporting Students:"):Text(" While students are working on their apps, circulate the room and check in with students who need a little help. Encourage students to collaborate and discuss bugs with each other.")
        Paragraph():Strong("Debugging:"):Text(" Review with students steps they can use to debug if they get stuck:")
        BulletList()
        ListItem("Use the output command to log the value of variables to the console")
        ListItem("Explain the code to a friend")
        Paragraph():Strong("Looking at Previous Code:"):Text(" You can choose to let students look at code from apps in previous lessons as a reference if they're stuck. You can also use the code in the example project, but it's important that students don't just copy-paste from it. Looking at related code as a reference and translating it into new code is a valuable programming skill, but it's important that students are confident enough in their understanding of the material to build code in the blank slate environment. They will need this skill for the upcoming projects.")
        EndCallout()
    end

    private action WrapUp5Minutes
        Section("Wrap Up (5 minutes)")
        Subsection("Remarks")
        BulletList()
        ListItem("Awesome work today! Make sure to submit your project when you're done with it!")
        TeachingTip()
        Paragraph():Strong("Maximize Work Time:"):Text(" The wrap up is short to allow the maximum amount of time for students to complete the activity.")
        EndCallout()
    end

    private action AssessmentMakeProject
        Section("Assessment: Make Project")
        Paragraph("Use the rubric provided with the project to assess student projects.")
    end

    private action StandardsAlignment
        Section("Standards Alignment")
        BulletList()
        ListItem():Strong("CSTA K-12 Computer Science Standards (2017): "):Text("3A-AP-14, 3B-AP-10")
    end
end
