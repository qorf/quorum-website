use Libraries.Web.Page.QuorumPage

/*
    Building Apps - Lesson 18: Practice PT - Create Your Own App.
    Converted from the old Lesson page by plan 13's generator: the same
    words, now without Tailwind.
*/
class CodeOrgUnit5Lesson18 is QuorumPage

    on create
        SetLocation("lessons/code/BuildingApps/Lesson18.html")
        // The name lists and links use, and the series and track it belongs
        // to: its section and picture.
        SetShortTitle("Code.Org Unit 5 Lesson 18")
        // For search engines and link previews, and what lists of pages say.
        SetDescription("Learn how to create your own App")
        SetSummary("Learn how to create your own App")
    end

    action Setup
        SetWebPageTitle("Unit 5 Lesson 18: Practice PT - Create Your Own App")
        Title("Building Apps - Lesson 18: Practice PT - Create Your Own App")
        Paragraph("Note - This lesson is optional at this point. It has not yet been updated to match the 2018 Create PT Scoring Guidelines and its contents are now covered in the AP Create PT Prep Unit.")
        Overview()
        GoalsPart()
        Purpose()
        Resources()
        GettingStarted()
        Activity()
        WrapUp()
        StandardsAlignment()
    end

    private action Overview
        Section("Overview")
        Paragraph("To conclude their introduction to programming, students will design their own App. They will design an app based off of one of the projects they have previously worked on in this programming unit. Specifically, they will determine what kinds of improvements they wish to make to the existing program, demonstrating their ability to make abstractions and implement complex algorithms. Through designing their own app, students should get some further insight into Computer Science Principles using the Quorum Programming Language.")
        Paragraph("The project concludes with reflection questions similar to those students will encounter on the AP® Create Performance Task. They can either complete the project individually or with a partner. Even if they aren't working in a pair, every student should have a collaborative partner with whom they will give and receive feedback.")
        Paragraph("Note: This is NOT the official AP Performance Task that will be submitted as part of the Advanced Placement exam; it is a practice activity intended to prepare students for portions of their individual performance at a later time.")
    end

    private action GoalsPart
        Section("Goals")
        Paragraph("Students will be able to:")
        BulletList()
        ListItem("Complete reflection questions in a format similar to those on the AP performance tasks.")
        ListItem("Collaborate to give and receive feedback on program implementation to improve program functionality.")
        ListItem("Update existing code to add new functionality to a program, or create new code using imagination, creativity, and logical thinking process.")
        ListItem("Create a video demonstrating the functionality of a program.")
    end

    private action Purpose
        Section("Purpose")
        Paragraph("A skill that programmers must develop is the ability to plan and execute a project from idea all the way through shipping of a product. Some of the best apps are new ideas brought on by the past work of a programmer themselves or other programmers. In order to execute these new ideas programmers must identify the programming structures needed to implement their idea and create a project plan. Often there are deadlines on projects which require programmers to make choices about the top features which need to be in a release of a new product. Finally, programmers must be able to express to others the work they have done to create their app.")
        Paragraph("AP® is a trademark registered and/or owned by the College Board, which was not involved in the production of, and does not endorse, this curriculum.")
    end

    private action Resources
        Section("Resources")
        BulletList()
        ListItem():Link("Improve Your App Planning Guide, rtf", "/files/code/Unit5/PracticePT Planning Guide - Improve Your App-reorganized.rtf")
        ListItem():Link("Improve Your App Overview and Rubric, rtf", "/files/code/Unit5/U5L18 Practice PT Overview and Rubric - Improve Your App.rtf")
    end

    private action GettingStarted
        Section("Getting Started")
        Paragraph("For students that want to work in pairs, give them a minute to find partners.")
        Subsection("Brainstorm: Programming Projects and Concepts So Far")
        Paragraph("Remember the programming projects, both large and small, done in the unit. Review how they can be used to frame the coming project as a practice for the Create Performance Task. Consider reading to them the following prompt.")
        BulletList()
        ListItem("For the project we are beginning today, you are going to create a project of your choice by adding to your past work. To begin with, let's make a list of all the past projects you have worked on and the programming concepts you have learned.")
        Subsubsection("List of past projects")
        BulletList()
        ListItem("Musical Keyboard - Lesson 2")
        ListItem("Build Your Own Event-Driven Program - Lesson 3")
        ListItem():DoubleQuote():Text("Counter"):DoubleQuote():Text(" Game - Lesson 5")
        ListItem("Mad Libs App - Lesson 6")
        ListItem("The Game of Choice - Lesson 10")
        ListItem():DoubleQuote():Text("My Favorite Things"):DoubleQuote():Text(" App - Lesson 13")
        ListItem():DoubleQuote():Text("Image Scroller"):DoubleQuote():Text(" App - Lesson 14")
        ListItem():DoubleQuote():Text("Soundboard"):DoubleQuote():Text(" App - Lesson 17")
        Subsubsection("List of programming concepts")
        BulletList()
        ListItem("Event Driven Programming")
        ListItem("Object Oriented Programming")
        ListItem("Quorum Game Engine")
        ListItem("Common Code Structure")
        ListItem("Quorum Turtle Module")
        ListItem("Actions")
        ListItem("Actions with Return Values")
        ListItem("Parameters")
        ListItem("Quorum Standard Libraries")
        ListItem("Repeat (times, while, until)")
        ListItem("Random Numbers")
        ListItem("Commenting")
        ListItem("Debugging")
        ListItem("Debug Mode")
        ListItem("Debug Commands")
        ListItem("Console output and Screen display output")
        ListItem("Events")
        ListItem("UI Elements")
        ListItem("Variables")
        ListItem("Conditionals (if, elseif, else)")
        ListItem("Boolean Expressions")
        ListItem("Boolean Operators")
        ListItem("Keyboard Handling")
        ListItem("Array (Creating and Processing)")
        Paragraph("After briefly reviewing the above concepts, read the following prompt to students.")
        BulletList()
        ListItem("Now that we've jogged your memory... for this final project of the unit you will use one of the projects we've done already as a point of inspiration to make something new.")
    end

    private action Activity
        Section("Activity")
        Paragraph("First, distribute the "):DoubleQuote():Text("Improve Your App Planning Guide"):DoubleQuote():Text(" resource to each pair of students (or to any individual students working alone). It should help them think about how to plan and execute their project. They should also be provided the "):DoubleQuote():Text("Improve Your App Overview and Rubric"):DoubleQuote():Text(" resource so they can begin reviewing the project guidelines before getting down to work. This project will take some time, as it has new elements, such as a video, and it asks students to create PDF documents of their write-ups.")
        Paragraph("A proposed schedule of the steps of this project is included below, as well as more thorough explanations of how to conduct the various stages.")
        Subsection("Day 1")
        BulletList()
        ListItem("Review the project guidelines and the rubric.")
        ListItem("Assign students to collaborate with partners.")
        ListItem("Have students brainstorm and complete the App Design Guide in the "):DoubleQuote():Text("Improve Your App Planning Guide"):DoubleQuote():Text(" resource.")
        Subsubsection("Pro Tip")
        Paragraph("Complete Project Planning Guide: Students should use the "):DoubleQuote():Text("Improve Your App Planning Guide"):DoubleQuote():Text(" resource to develop an overview description of their target app. The first thing students should do as part of planning is to...")
        BulletList()
        ListItem("Read Requirements: Read through the guidelines of the project together and address any high-level questions about the aims of the project. Students will have a chance to review the requirements once they start planning.")
        ListItem("Assign Collaborative Partners: On the real Create Performance Task, teachers are not supposed to give much help to you. Instead students are supposed to work with a collaborative partner. Assign each student a specific person as their collaborative partner.")
        ListItem("Note: While students can work with a partner to create an app together, they should probably still consult with someone outside of the partnership who does not know the details of your project. This will help with the feedback process.")
        Subsubsection("Day 2 - Individually program major components.")
        BulletList()
        ListItem("Students begin work on programming projects.")
        ListItem("Add at least one or two new features/components to the app.")
        Subsubsection("Pro Tip")
        BulletList()
        ListItem("If students are having difficulty developing their project plan, encourage them to talk with their collaboration partner. Develop the expectation that students have consulted one another prior to asking for your help.")
        ListItem("Program: Students should work individually to program their app or portion of their app. While they are responsible for writing their own code for the project, they may still consult with the other members of their class, especially their collaborative partner.")
        Subsubsection("Day 3 - Work with classmates to give and receive feedback.")
        BulletList()
        ListItem("Students give and receive feedback with their collaborative partner.")
        ListItem("Students pick two pieces of feedback to act on and improve in your program.")
        ListItem("Continue working on program.")
        Subsubsection("Day 4")
        BulletList()
        ListItem("Students finalize their first implementation of the program.")
        ListItem("Students begin their reflection questions and/or video.")
        Subsubsection("Pro Tip")
        Paragraph("If students work in partners, they will need some way to combine their code. Possible solutions are:")
        BulletList()
        ListItem("Write a block of code in a simple text processing program such as "):DoubleQuote():Text("Text Wrangler,"):DoubleQuote():Text(" "):DoubleQuote():Text("Note Pad,"):DoubleQuote():Text(" "):DoubleQuote():Text("Word Pad,"):DoubleQuote():Text(" "):DoubleQuote():Text("Text Edit,"):DoubleQuote():Text(" etc. Then send the document via an email attachment.")
        ListItem("Using a Google Doc is an option, but students need to be careful not to change their partner's code without a consensus. A better approach may be to copy and paste the entire code to the bottom of the document (with date and their name) - every time one partner makes some additions to the code. *** Note - Students will need to disable the "):DoubleQuote():Text("smart quote"):DoubleQuote():Text(" function of the Google Doc, as it creates "):DoubleQuote():Text("faulty quotation marks"):DoubleQuote():Text(" for coding purposes.")
        Paragraph("Peer Consultation: After students have finished implementing a draft of their program, they should meet with their collaborative partner, present their work so far, and provide feedback regarding their progress. They should complete the Feedback Guide. Other potential questions to address are below:")
        BulletList()
        ListItem("Other potential questions to address: Is there anything that's particularly clever or gives you ideas for your own project? Do you agree with the choices your partner has made? Is there anything missing?")
        Subsubsection("Day 5 - Complete project reflection questions and create video.")
        BulletList()
        ListItem("Students complete their reflection questions and/or video.")
        ListItem("Students submit their projects.")
        Subsubsection("Pro Tip")
        BulletList()
        ListItem("Reflection Questions: Students need to complete the reflection questions included in the "):DoubleQuote():Text("Improve Your App Planning Guide"):DoubleQuote():Text(" resource.")
        ListItem("Video Creation: Students also need to create a video to demonstrate the functionality of their program. The video should not be longer than 1 minute. It does not need sound.")
        Subsubsection("Video Creation - Suggested Tools:")
        BulletList()
        ListItem("LiceCap is an easy way to create gifs of things happening on your computer")
        ListItem():Link("LiceCap", "http://www.cockos.com/licecap/")
        ListItem("QuickTime - You can do a screen recording with QuickTime as well. QuickTime works on both Mac and Windows.")
    end

    private action WrapUp
        Section("Wrap Up")
        Paragraph():Strong("Self-assess: "):Text("It can be a useful exercise for students to briefly assess themsevles using the rubric they were provided at the beginning of the project. Ask them to identify points where they could improve, and remind them that this rubric is very similar in structure to the one that will be used on the actual AP Performance Tasks they will encounter later in the year.")
        Paragraph():Strong("Presentation (Optional): "):Text("If time allows, students may wish to have an opportunity to share their final apps with one another. Consider options like creating a "):DoubleQuote():Text("Digital Gallery"):DoubleQuote():Text(" by posting all links to a shared document.")
    end

    private action StandardsAlignment
        Section("Standards Alignment")
        BulletList()
        ListItem():Strong("Computer Science Principles: "):Text("1.1.1 (A, B)")
        ListItem():Strong("Computer Science Principles: "):Text("1.2.1 (A, B, C, D, E)")
        ListItem():Strong("Computer Science Principles: "):Text("1.2.2 (A, B)")
        ListItem():Strong("Computer Science Principles: "):Text("1.2.3 (A, B, C)")
        ListItem():Strong("Computer Science Principles: "):Text("1.2.4 (A, B, C, D, E, F)")
        ListItem():Strong("Computer Science Principles: "):Text("2.2.1 (A, B, C)")
        ListItem():Strong("Computer Science Principles: "):Text("2.2.2 (A, B)")
        ListItem():Strong("Computer Science Principles: "):Text("4.1.1 (A, B, C, D, E, F, G, H, I)")
        ListItem():Strong("Computer Science Principles: "):Text("4.1.2 (A, B, C, D, E, F, G, H, I)")
        ListItem():Strong("Computer Science Principles: "):Text("5.1.1 (A, B, C, D, E)")
        ListItem():Strong("Computer Science Principles: "):Text("5.1.2 (A, B, C, D, E, F, G, H, I, J)")
        ListItem():Strong("Computer Science Principles: "):Text("5.1.3 (A, B, C, D, E, F)")
        ListItem():Strong("Computer Science Principles: "):Text("5.4.1 (C, E, F, G, H, J, L, M, N)")
        ListItem():Strong("Computer Science Principles: "):Text("5.5.1 (A, B, C, D, E, F, G, H, I, J)")
    end
end
