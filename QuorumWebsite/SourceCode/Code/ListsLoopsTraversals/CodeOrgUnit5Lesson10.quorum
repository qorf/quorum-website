use Libraries.Web.Page.QuorumPage

/*
    Lists, Loops, and Traversals - Lesson 10: Traversals Investigate.
    Converted from the old Lesson page by plan 13's generator: the same
    words, now without Tailwind.
*/
class CodeOrgUnit5Lesson10 is QuorumPage
    // A double quote, for code and words that hold one.
    text dq = ""

    on create
        SetLocation("lessons/code/BuildingApps/Lesson10.html")
        // The name lists and links use, and the series and track it belongs
        // to: its section and picture.
        SetShortTitle("Traversals Investigate")
        SetSectionName("Lists, Loops, and Traversals")
        // For search engines and link previews, and what lists of pages say.
        SetDescription("Investigate how traversals can be used to filter data")
        SetSummary("Investigate apps with traverals")
    end

    action Setup
        dq = dq:GetDoubleQuote()
        SetWebPageTitle("Unit 5 Lesson 10: Traversals Investigate")
        Title("Lists, Loops, and Traversals - Lesson 10: Traversals Investigate")
        Overview()
        GettingStarted5Minutes()
        Activity35Minutes()
        WrapUp5Minutes()
        AssessmentCheckForUnderstanding()
        StandardsAlignment()
    end

    private action Overview
        Section("Overview")
        Paragraph("In this lesson students work with partners to investigate three different apps that use traversal to access items in a lists. Students first explore all three apps without seeing the code to notice similarities and predict how they will work. Then they explore the code itself and make additions and modifications to the apps. To conclude the lesson, students review and discuss common programming patterns with traversals.")
        Subsection("Goals")
        Paragraph("Students will be able to:")
        BulletList()
        ListItem("Identify common programming patterns using traversals")
        ListItem("Explain the purpose of programming patterns with traversals both in terms of how they work and what they accomplish")
        ListItem("Modify apps that make use of common programming patterns with traversals to adjust their functionality")
        Subsection("Purpose")
        Paragraph("After building a conceptual model using a loop to traverse a list in the previous lesson, this lesson allows students to see how this is actually implemented in code. This lesson also introduces common programming patterns when using lists and traverals. Students will have some opportunities to modify working code in this lesson, but the most significant practice with lists and traversals will come in the following lesson.")
        Subsection("Resources")
        BulletList()
        ListItem():Link("CSP-Widgets repository", "https://github.com/qorf/CSP-Widgets")
    end

    private action GettingStarted5Minutes
        Section("Getting Started (5 minutes)")
        Paragraph():Strong("Prompt:"):Text(" Let's review last lesson. What did we do?")
        DiscussionGoal()
        Paragraph("Last lesson, we visualized how a loop is used to traverse a list and interact with each element in the list one by one.")
        EndCallout()
    end

    private action Activity35Minutes
        Section("Activity (35 minutes)")
        Subsection("Mile Tracker Investigation")
        Paragraph():Strong("Group:"):Text(" Group students into groups of four.")
        Paragraph():Strong("Open a Project:"):Text(" Today's lesson uses three apps, starting with "):Strong("Lesson10_App1"):Text(".")
        Paragraph():Strong("App 1:"):Text(" Students read the entire code, and then students focus their attention on a single action. Students should re-read the code for their function.")
        BulletList()
        ListItem("Student A - "):Code("Average()")
        ListItem("Student B - "):Code("Slow()")
        ListItem("Student C - "):Code("Fast()")
        ListItem("Student D - "):Code("NumberedListDisplay()")
        Paragraph():Strong("Discuss:"):Text("How does the app work?")
        Paragraph("Students discuss in their groups how each of their functions work, specifically referencing the list it uses and how it is traversed using a for loop. Then as a class address any confusion over how the app works.")
        BulletList()
        ListItem():Strong("The goal:"):Text(" The goal of this investigation is to give students the opportunity to see lists traversed for different reasons and with different outcomes. Students should look at the code for their assigned function and make sense of what the function does overall and how it does it.")
        ListItem():Strong("What to look for:"):Text(" It may be helpful to re-watch the video in the U5L10 - Traversals Explore lesson starting at 3:07 to hear how the speaker describes a section of code that processes a list for a specific purpose. Listening to that explanation will help give you an idea of what student explanations of their functions should sound like.")
        Paragraph("For example, when explaining the average function in this investigation, students should describe what the function does. In this case, the function calculates the average of the values stored in the mileTimes list and stores that value in the avg variable. In addition to describing what the function does, students should describe how the function works. This will involve more detail. Students should be able to describe that the function contains a local variable of total which is initialized at 0.")
        Paragraph("Then the function uses a for loop to traverse through the mileTimes list. In the loop, each value inside mileTimes list is accessed and added to the current value stored inside the total variable. When the loop reaches the end of the list, the loop ends and the total variable contains the sum of all the mileTimes. In the last line of the function, the value stored in avg is updated by dividing the value stored in total by the total number of elements in the mileTimes list.")
        Paragraph("When you bring the class together to talk about how the app works, you should talk both about what the functions do as well as how they work. There likely is not time to go over all four functions, but discussing one or two of them will ensure the full class has an opportunity to hear how their peers describe code.")
        Paragraph():Strong("Modify:"):Text(" Students work with a partner to create a function that adds together the total time of every element in the list. Output the result. Call this function in the "):Code("UpdateScreen()"):Text(" function.")
        TeachingTip()
        Paragraph():Strong("Prepping for Investigate Lessons:"):Text(" The best way to prepare for this lesson is to go through the experience yourself. Check out the three apps to get a sense for how they work. Then move on to the Code Investigation and actually try to answer all the questions for each app. These questions are intended to help students read and make sense of the code. It is not about getting the "):DoubleQuote():Text("right answer"):DoubleQuote():Text(" as much as it is about building skills in your students to read, test, and make sense of code that they haven't seen before.")
        Paragraph():Strong("Display Code at the Front:"):Text(" If your room allows it, display the code during the Code Investigation at the front of the room. When students mentions specific lines of code actually scroll to that line and read through it together.")
        Paragraph():Strong("Save Modifications for the End:"):Text(" This lesson can be tight on time. Rather than have students modify the code all at once, you can save modifications for the end of the Code Investigation and have students pick a single app they wish to modify.")
        EndCallout()
        Subsection("Data Tab Investigation")
        Paragraph():Strong("App 2 (5 mins):"):Text(" Students read the code, and then investigate the data folder.")
        Paragraph():Strong("Discuss:"):Text(" Encourage students to share out what they found in the datasets and how they can interact with it with code.")
        BulletList()
        ListItem("How does it work? What information is available? What can you change? What can't you change? Investigate a few different datasets.")
        ListItem():Strong("The goal:"):Text(" The goal of this investigation is to get students comfortable with information inside the Data tab and to help them understand the getColumn command. Students should be given some time to explore the Data tab themselves and even try the Modify task for a few minutes.")
        ListItem():Strong("What to look for:"):Text(" When you bring the class together, students should be able to describe what information they see in the data tab and how they can use the data tab to help get access to data. Key points to draw out are:")
        NestedBulletList()
        ListItem("The Data Library on the left hand side has different categories of datasets that students can view. Students need to import a data set to be able to see the data inside it or to use the data in the code. Once imported, students will see the data set in the Data Browser area and can click on the name of the Data Set to see the data in table form. To use the getColumn command, you need the name of the table you want to use and the name of the column from that table. getColumn will return the column from your table as a list. You can see it is a list because when it is printed to the console, it has square brackets [ ] around the items which are separated by commas.")
        EndNestedList()
        Paragraph():Strong("Modify:"):Text(" Students load a new dataset into the project. Then students modify the code to print out a column of data from the new dataset. Point out to students that when they pull out a column, they are creating a list.")
        Paragraph():Strong("Do This:"):Text(" Show the Data Tab in App Lab video.")
        TeachingTip()
        Paragraph("Note that in the next investigation, students will combine their knowledge of traversals and the Data Tab to make more robust apps that don't require students to type long lists in their code themselves.")
        EndCallout()
        Subsection("Random Dog Picker Investigation")
        Paragraph():Strong("App 3:"):Text(" Instruct students to run the app and then carefully read it. There is a lot of information in the comments in this app. Students work through all of the questions on the screen.")
        Paragraph():Strong("Discuss:"):Text(" Go through the questions one by one and answer as a class. Afterwards, go line by line with the class explaining how the app works.")
        BulletList()
        ListItem():Strong("The goal:"):Text(" The goal of this investigation is to give students an opportunity to make sense of how traversals and the datasets can be used together to create a working app. It is important to note that the algorithms in this app have some of the same qualities as the algorithm students will need to develop for the Create PT.")
        ListItem():Strong("What to look for:"):Text(" This project defines several different functions. Help guide students particularly to how the lists are filled. Students should see a "):Code("listSetup"):Text(" function. This function calls the "):Code("filter"):Text(" function. "):Code("filter"):Text(" is where the lists are being filled. Use the questions listed in CodeStudio to help students make sense of this code. In particular, spend a little extra time discussing the question How are these lists filled?. This is an opportunity to go through the "):Code("filter"):Text(" function line by line to understand how the function works.")
        DiscussionGoal()
        Subsection("Discussion Goal")
        Paragraph("Make sure students arrive at the following answers:")
        BulletList()
        ListItem("What are the names of the three lists in this program?")
        NestedBulletList()
        ListItem():Code("dogNames"):Text(", "):Code("dogHeights"):Text(", "):Code("filteredDogNames")
        EndNestedList()
        ListItem("On what lines of code are the lists created?")
        NestedBulletList()
        ListItem():Code("dogNames"):Text(": 30")
        ListItem():Code("dogHeights"):Text(": 31")
        ListItem():Code("filteredDogNames"):Text(": 34")
        EndNestedList()
        ListItem("On what lines of code are the lists filled?")
        NestedBulletList()
        ListItem():Code("dogNames"):Text(": 98")
        ListItem():Code("dogHeights"):Text(": 99")
        ListItem():Code("filteredDogNames"):Text(": 72-81")
        EndNestedList()
        ListItem("How are these lists filled?")
        NestedBulletList()
        ListItem():Code("dogNames"):Text(" and "):Code("dogHeights"):Text(" are filled by pulling a column of data from the dataset")
        ListItem("For "):Code("filteredDogNames"):Text(", the "):Code("dogHeights"):Text(" list is traversed. If "):Code("dogHeights"):Text(" and "):Code("dogSize"):Text(" meet the given conditions the name at the same index position in the "):Code("dogNames"):Text(" list is added to the filtered list.")
        EndNestedList()
        ListItem("Find and open the Dogs.csv file in Excel or another spreadsheet program. What columns does this app use?")
        NestedBulletList()
        ListItem():DoubleQuote():Text("Name"):DoubleQuote():Text(", "):DoubleQuote():Text("Maximum Height"):DoubleQuote():Text(", "):DoubleQuote():Text("Image"):DoubleQuote()
        EndNestedList()
        ListItem("Look at the filter function. On what lines is the filtered list reset to be blank?")
        NestedBulletList()
        ListItem("Line 64")
        EndNestedList()
        ListItem("What condition is being checked to determine if an element belongs in a filtered list?")
        NestedBulletList()
        ListItem("If a dog's height is above or below a certain number")
        EndNestedList()
        EndCallout()
        TeachingTip()
        Paragraph("Traversals can be tricky! In this case, we are filtering a list by information that is in another list.")
        Paragraph("There are three lists to start: "):Code("dogNames"):Text(", "):Code("dogHeights"):Text(", and "):Code("dogImages"):Text(". We want to sort out the dogs so that when the user picks a size via the buttons, only dogs of that size show up in the display.")
        Paragraph("To do this, we traverse using a filter pattern. Using a loop to go through each item in the "):Code("dogHeights"):Text(" list, if a dog's height matches up to the requirements, we pull the dog's name from the original list (all the indexes will match) and put that in the new filtered list.")
        Paragraph("Once this is done, we have a filtered list we can pull from to display a random dog's name and image.")
        EndCallout()
        Subsection("Traversal Patterns")
        Paragraph():Strong("Pattern Review:"):Text(" Review the two patterns below as a class: the "):Emphasis("List Filter Pattern"):Text(" and the "):Emphasis("List Reduce Pattern"):Text(".")
        BulletList()
        ListItem("Have students add any relevant notes about the patterns to their journals.")
        ListItem("Discuss which patterns were used in the apps today.")
        Subsection("List Filter Patterns")
        Subsubsection("Filtering One List")
        Paragraph("This pattern allows the user to filter a list into a new list by limiting the information that is added to the new list. For example, you could filter a list of words so that only words of a certain length or words that start with a specific letter appear in the new list.")
        Subsubsection():Emphasis("Example: List Filter - starting letter")
        CodeExample("Array<text> list
list:Add(" + dq + "apples" + dq + ")
list:Add(" + dq + "oranges" + dq + ")
list:Add(" + dq + "apricots" + dq + ")
list:Add(" + dq + "bananas" + dq + ")

Array<text> filteredList

integer i = 0
repeat while i < list:GetSize()
    text firstLetter = list:Get(i):GetSubtext(0, 1)
    if firstLetter = " + dq + "a" + dq + "
        filteredList:Add(list:Get(i))
    end
    i = i + 1
end")
        Subsubsection():Emphasis("Example: List Filter - length")
        CodeExample("Array<text> list
list:Add(" + dq + "apples" + dq + ")
list:Add(" + dq + "oranges" + dq + ")
list:Add(" + dq + "apricots" + dq + ")
list:Add(" + dq + "bananas" + dq + ")

Array<text> filteredList

integer i = 0
repeat while i < list:GetSize()
    integer wordLength = list:Get(i):GetSize()
    if wordLength > 7
        filteredList:Add(list:Get(i))
    end
    i = i + 1
end")
        Subsubsection("How does it work?")
        BulletList()
        ListItem("Create a variable and store a list in it")
        ListItem("Create a blank list to store the filtered list")
        ListItem("Use a loop to access each element in the original list")
        ListItem("If that element meets a certain condition, append it to the filtered list")
        Subsection("Filtering Multiple Lists")
        Paragraph("What if you have multiple lists, but want to filter all the lists based on the information in a single list?")
        Subsubsection():Emphasis("Example: Multiple List Filterh")
        CodeExample("Array<text> studentNameList
Array<integer> studentGradeList
Array<integer> studentAgeList

Array<text> filteredStudentNameList
Array<integer> filteredStudentGradeList
Array<integer> filteredStudentAgeList

action Start
    studentNameList:Add(" + dq + "Sal" + dq + ")
    studentNameList:Add(" + dq + "Maya" + dq + ")
    studentNameList:Add(" + dq + "Rudy" + dq + ")
    studentNameList:Add(" + dq + "Gina" + dq + ")
    studentNameList:Add(" + dq + "Paris" + dq + ")
    
    studentGradeList:Add(10)
    studentGradeList:Add(11)
    studentGradeList:Add(10)
    studentGradeList:Add(12)
    studentGradeList:Add(11)
    
    studentAgeList:Add(16)
    studentAgeList:Add(18)
    studentAgeList:Add(15)
    studentAgeList:Add(17)
    studentAgeList:Add(17)

    Filter()
end

action Filter
    // Start with blank lists
    filteredStudentNameList:Empty()
    filteredStudentGradeList:Empty()
    filteredStudentAgeList:Empty()

    integer i = 0
    repeat while i < studentGradeList:GetSize()
        if studentGradeList:Get(i) = 11
            filteredStudentNameList:Add(studentNameList:Get(i))
            filteredStudentGradeList:Add(studentGradeList:Get(i))
            filteredStudentAgeList:Add(studentAgeList:Get(i))
        end
        i = i + 1
    end
end")
        Paragraph("All the lists must be the same length for this pattern - ideally they are columns pulled from a table")
        Subsubsection("How does it work?")
        BulletList()
        ListItem("Create a variable for each list")
        ListItem("Create blank lists to store the filtered lists")
        ListItem("In a function, first reset all filtered lists to blank lists. Every time the function is called, the filtered lists will reset.")
        ListItem("Use a loop to access each item in the list that contains the element you are filtering by")
        ListItem("If the element is found, append to each filtered list the element at the index in the original lists where the element was found")
        Subsection("List Reduce Patterns")
        Paragraph("This pattern is used when you want to reduce the information in a list down to a single number. For example, you might want to find the average of a list of numbers or the smallest number.")
        Subsubsection():Emphasis("Example: List Reduce - average")
        CodeExample("Array<number> list
number average = 0

action Start
    list:Add(1)
    list:Add(2)
    list:Add(3)
    list:Add(4)
    list:Add(5)

    FindAverage()
end

action FindAverage
    number total = 0
    integer i = 0
    repeat while i < list:GetSize()
        total = total + list:Get(i)
        i = i + 1
    end
    average = total / list:GetSize()
end")
        Subsubsection("How does it work?")
        BulletList()
        ListItem("Create a list of numbers")
        ListItem("Create a blank variable to store the average")
        ListItem("In a function create a local variable to store the total value of all elements in the list")
        ListItem("Use a loop to access each element in the list and add its value to total")
        ListItem("After the loop, calculate the average by dividing total by the length of the list")
        Subsubsection():Emphasis("Example: List Reduce - smallest")
        CodeExample("Array<number> list
number smallest = 0

action Start
    list:Add(5)
    list:Add(4)
    list:Add(3)
    list:Add(2)
    list:Add(1)

    FindSmallest()
end

action FindSmallest
    number temp = list:Get(0)
    integer i = 0
    repeat while i < list:GetSize()
        if list:Get(i) < temp
            temp = list:Get(i)
        end
        i = i + 1
    end
    smallest = temp
end")
        Subsubsection("How does it work?")
        BulletList()
        ListItem("Create a list of numbers")
        ListItem("Create a blank variable to store the smallest number")
        ListItem("In a function create a local variable to store a temporary value")
        ListItem("Use a for loop to access each element in the list")
        ListItem("If that element is less than the value stored in temp, set the value of temp to the current element")
        ListItem("After the loop set the value of smallest to the value stored in temp")
    end

    private action WrapUp5Minutes
        Section("Wrap Up (5 minutes)")
        Paragraph():Strong("Prompt:"):Text(" What aspects of using traversals to process a list do you feel you already understand? What questions do you want to dig into more tomorrow during the practice lesson?")
    end

    private action AssessmentCheckForUnderstanding
        Section("Assessment: Check for Understanding")
        Subsection("For Students")
        Paragraph("Open a word doc or google doc and copy/paste the following question.")
        Subsection("Question")
        Paragraph("Explain how you would filter the dog dataset using traversal to have a filtered list of dogs who live long lives.")
    end

    private action StandardsAlignment
        Section("Standards Alignment")
        BulletList()
        ListItem():Strong("CSTA K-12 Computer Science Standards (2017): "):Text("3A-AP-14, 3B-AP-10, 3B-AP-23")
        ListItem():Strong("Computer Science Principles: "):Text("AAP-3.F.1, AAP-3.F.2, AAP-3.F.3, AAP-3.F.4, AAP-3.F.5, AAP-3.F.6, AAP-3.F.7")
    end
end
