use Libraries.Web.Page.QuorumPage

/*
    Lists, Loops, and Traversals - Lesson 9: Traversals Explore.
    Converted from the old Lesson page by plan 13's generator: the same
    words, now without Tailwind.
*/
class CodeOrgUnit5Lesson9 is QuorumPage
    // A double quote, for code and words that hold one.
    text dq = ""

    on create
        SetLocation("lessons/code/BuildingApps/Lesson9.html")
        // The name lists and links use, and the series and track it belongs
        // to: its section and picture.
        SetShortTitle("Traversals Explore")
        SetSectionName("Lists, Loops, and Traversals")
        // For search engines and link previews, and what lists of pages say.
        SetDescription("Explore the use of loops to traverse a list")
        SetSummary("Explore list traversals")
    end

    action Setup
        dq = dq:GetDoubleQuote()
        SetWebPageTitle("Unit 5 Lesson 9: Traversals Explore")
        Title("Lists, Loops, and Traversals - Lesson 9: Traversals Explore")
        Overview()
        GettingStarted5Minutes()
        Activity30Minutes()
        WrapUp5Minutes()
        AssessmentCheckForUnderstanding()
        StandardsAlignment()
    end

    private action Overview
        Section("Overview")
        Paragraph("The lesson begins with a quick review of lists and loops before moving into the main activity. Here students explore the concept using pseudocode and optionally the Traversal Machine, a physical model of traversal using a for loop.")
        Subsection("Goals")
        Paragraph("Students will be able to:")
        BulletList()
        ListItem("Use appropriate vocabulary to describe traversals.")
        ListItem("Understand how to use a loop to traverse a list")
        ListItem("Trace simple programs with loop traversals")
        Subsection("Purpose")
        Paragraph("Students are introduced to the concept of traversal using pseudocode and (optionally) the Traversal Machine. This unplugged lesson provides students a physical mental model they will be able to use when they transition to programming traversals in actual code.")
        Subsection("Resources")
        BulletList()
        ListItem():Link("CSP Unit 5 - Lists, Loops, and Traversals (Presentation)", "https://docs.google.com/presentation/d/1qQPTgZxJnYZRl-9Do2UB_hM882QtouLclWfCsw8jDBw/copy")
        ListItem():Link("CS Principles: Processing Lists (Video)", "https://youtu.be/RQ6GJt9f2vg")
        Subsubsection("Code.org supplemental material")
        BulletList()
        ListItem():Link("Traversal Machine", "https://docs.google.com/document/d/155CFeFELE2dfoQCip9CwLb6KbJqDeUcvhumCRecCU-Y/view")
        TeachingTip()
        Paragraph():Strong("Optional Materials and Substitutions:"):Text(" Like the previous explore lessons, this lesson is a guided activity with optional accompanying slides. The activity makes use of the Traversal Machine, a paper cut-out with a for loop and a sliding track. Whether or not you use the handout, the core of this activity is in writing and running pseudocode. The slides show Javascript-style pseudocode, and we have included Quorum-style pseudocode here. You can direct students to use either.")
        Paragraph("Instead of using the Traversal Machine, you can instead ask students to write pseudocode directly on paper or in a text editor. You can even have them write actual code in a blank project in Quorum Studio, but if you do, it's okay if student's code doesn't compile. For this lesson, it's only important that students explore the concept, rather than worry about the exact syntax of code.")
        EndCallout()
    end

    private action GettingStarted5Minutes
        Section("Getting Started (5 minutes)")
        Paragraph():Strong("Discuss:"):Text(" Review key vocabulary for lists and loops with students:")
        BulletList()
        ListItem("List - an ordered sequence of elements.")
        ListItem("Element - an individual value in a list that is assigned a unique index.")
        ListItem("Index - a common method for referencing the elements in a list or string using natural numbers.")
        ListItem("Iteration - a repetitive portion of an algorithm. Iteration repeats until a given condition is met.")
    end

    private action Activity30Minutes
        Section("Activity (30 minutes)")
        Subsection("Traversals")
        Paragraph():Strong("Display:"):Text(" Use the activity slides for this lesson to guide the unplugged activity on Traversals.")
        TeachingTip()
        Paragraph():Strong("Running the Activity:"):Text(" This activity asks students to follow along as a number of core concepts for programming are introduced. The model is typically that a term or concept is introduced and modeled and then afterwards students are encouraged to try it out on their own. Trying it out typically means they are writing information down and sharing it with another group before discussing the results with the whole class.")
        Paragraph("Slides with animations have an icon in the bottom left corner to let you know you need to click to reveal more of the slide's content.")
        Paragraph("To help you more easily prepare the activity and keep track of your instructions, detailed instructions have been included as speaker notes in the presentation. Here are some tips to help you throughout the presentation.")
        BulletList()
        ListItem("There are opportunities throughout the presentation for students to actively engage. At these moments students should be making things with their manipulatives or using them to answer questions. Use these opportunities to check progress.")
        ListItem("There is a fair amount of new vocabulary introduced but it is introduced gradually and with intentional repetition. Make a point of actively modeling the use of new terms.")
        ListItem("The most important goal here is building a mental model. It is ok if students have some open questions that will get resolved over the subsequent conditional lessons.")
        ListItem("Both you and students can use the "):DoubleQuote():Text("Key Takeaways"):DoubleQuote():Text(" to check your understanding at the end.")
        EndCallout()
        Paragraph():Strong("Guided Activity:"):Text(" The focus of today's lesson is an unplugged guided activity. You can optionally use the Code.org presentation slides for this lesson. Prompts below indicate when to move to a new slide. If you aren't using the slides, you can ignore these prompts.")
        Paragraph():Strong("Distribute:"):Text(" If you are using the Traversal Machine, hand them out to students and ensure they have the supplies listed on the slide. Otherwise, make sure students have access to pencil and paper, a text editor, or whatever alternative tools you choose to use for this lesson.")
        Paragraph():Strong("Say:"):Text(" Today we are going to learn about Traversals. Make sure you and your partner have all the supplies you need.")
        Paragraph():Strong("Note to Teacher:"):Text(" If you are using the Traversal Machines and are concerned about time or material management, the Traversal Machines can be prepared ahead of time. You only need one Traversal Machine per pair of students, and machines can be shared between classes.")
        Paragraph("There are three places to make cuts:")
        BulletList()
        ListItem("The dotted line at the top of the sheet")
        ListItem("The box with the list index")
        ListItem("The box inside of the variable baggy")
        Subsection("Guided Activity")
        Paragraph("Follow this lesson with the supplemental slides.")
        Paragraph():Strong("Slide:"):Text(" Do This")
        Paragraph():Strong("Do This:"):Text(" Write down this list:")
        CodeExample("temps = [77, 85, 89, 65]")
        Paragraph():Strong("Slide:"):Text(" What if...")
        Paragraph():Strong("Prompt:"):Text(" What if I want to know if a value is in a list? With a partner, discuss the method you would use to look for an item in a list.")
        Paragraph():Strong("Answer:"):Text(" Most likely, you would scan your list looking at each item until you found the correct one.")
        Paragraph():Strong("Slide:"):Text(" Computers are really good at checking things one by one.")
        Paragraph():Strong("Say:"):Text(" Computers are really good at checking things one by one. To do this, let's use a loop.")
        Paragraph():Strong("Slide:"):Text(" Get ready! Set up the Traversal Machine")
        Paragraph():Strong("Do This:"):Text(" Set up the Traversal Machine, or write down this pseudocode. Make sure to leave plenty of space open in the middle of the loop!")
        Paragraph():Strong("Note:"):Text(" Students use scissors make cuts as directed on the Traversal Machines. As noted before, this can all be done before class to save time.")
        CodeExample("integer i = 0
repeat while i < list:GetSize()
    integer element = list:Get(i)
    i = i + 1
end")
        Paragraph():Strong("Slide:"):Text(" This is where we assign the starting value...")
        Paragraph():Strong("Do This:"):Text(" Direct students attention to the Traversal Machines or to the first line of pseudocode as you describe the parts.")
        CodeExample("integer i = 0")
        Paragraph():Strong("Say:"):Text(" This is where we assign the starting value to the counter variable i. Usually we assign it to 0. What else starts with 0? The index of a list!")
        Paragraph():Strong("Note:"):Text(" In Javascript and Quorum, the index of a list starts at 0. You may want to remind students that on the AP Exam, pseudocode starts the index at 1.")
        Paragraph():Strong("Slide:"):Text(" This is the Boolean expression...")
        CodeExample("i < list:GetSize()")
        Paragraph():Strong("Say:"):Text(" This is the Boolean expression that is checked to see if the loop should continue to run. When working with a list, we want to access every element in the list, so we are going to keep the loop going until we have hit the size of the list.")
        Paragraph():Strong("Note:"):Text(" You may want to remind students that list:GetSize() evaluates to the length of a list, which will be different than the last index number. For example, in a list of three, the length is 3 and the index numbers are 0, 1, 2")
        Paragraph():Strong("Slide:"):Text(" Do This: replace list...")
        Paragraph():Strong("Do This:"):Text(" Replace "):DoubleQuote():Text("list"):DoubleQuote():Text(" with the name of your list. In this case, we would replace it with "):DoubleQuote():Text("temps"):DoubleQuote()
        BulletList()
        ListItem("If students are using the Traversal Machine, they should take two small pieces of a sticky note and write "):Strong("temps"):Text(" on them. Then, place the sticky note pieces over the two instances of "):Strong("list"):Text(" on the machine.")
        ListItem("If students are using pseudocode, they can erase and replace the instances of "):Strong("list"):Text(" in the text.")
        Paragraph():Strong("Slide:"):Text(" The counter variable i...")
        CodeExample("i = i + 1")
        Paragraph():Strong("Say:"):Text(" The counter variable i increases after each loop runs.")
        Paragraph():Strong("Slide:"):Text(" To access each element in the list...")
        Paragraph():Strong("Say:"):Text(" To access each element in the list, we are going to store the element in a variable inside the for loop. Let's try this out.")
        Paragraph():Strong("Click for animation.")
        Paragraph():Strong("Do This:"):Text(" If you're using the Traversal Machine, set up a variable baggy and give it the name element.")
        Paragraph("Whether you're using the Traversal Machine or pseudocode, you may opt to not use variable baggies at all in this lesson and instead have students keep track of variables separately, such as on a scrap piece of paper. In this case, the variable element is tracking the local variable that is inside of the for loop. With every round of the for loop, the variable will update.")
        Paragraph():Strong("NOTE:"):Text(" "):Emphasis("If you are not using the Traversal Machine, you can skip this slide and its related section.")
        Paragraph():Strong("Slide:"):Text(" Do this: Pull the index sheet up to assign i to 0.")
        Paragraph():Strong("Do This:"):Text(" Pull the index sheet up to assign i to 0.")
        Paragraph():Strong("Click for animation.")
        Paragraph():Strong("Say:"):Text(" Notice how the variable in the baggy has changed Each time the loop is executed, the variable i increases by one.")
        Paragraph():Strong("Note:"):Text(" For the following six slides, students will follow along with what's happening on the screen with their own Traversal Machines. Give students a few seconds to pull up the index sheet at each step.")
        Paragraph():Strong("Slide:"):Text(" Do This: Look at the list below.")
        Paragraph():Strong("Say:"):Text(" Look at our list. Right now, i = 0.")
        CodeExample("temps = [77, 85, 89, 65]")
        Paragraph():Strong("Do This:"):Text(" Evaluate the statement in the for loop to see what value is stored by the variable element.")
        Paragraph():Strong("Click through animation:"):Text(" There are six steps to click through. "):Code("temps:Get(0)"):Text(" evaluates to 77 which is stored in the variable "):Code("element"):Text(".")
        Paragraph():Strong("Slide:"):Text(" Do This: Now pull the index sheet up one spot.")
        Paragraph():Strong("Do This:"):Text(" Now, evaluate the next iteration of the loop. If you're using the Traversal Machine, pull the index sheet up one spot. i now equals 1. Evaluate the statement inside the loop.")
        Paragraph():Strong("Click through animation:"):Text(" There are seven steps to click through. "):Code("temps:Get(1)"):Text(" evaluates to 85 which is stored in the variable "):Code("element"):Text(".")
        Paragraph():Strong("Slide:"):Text(" Do This: Pull the sheet up again")
        Paragraph():Strong("Do This:"):Text(" Evaluate the next iteration again. If you're using the Traversal Machine, pull the index sheet up again. i now equals 2. Evaluate the statement inside the loop.")
        Paragraph():Strong("Click through animation:"):Text(" There are seven steps to click through. "):Code("temps:Get(2)"):Text(" evaluates to 89 which is stored in the variable "):Code("element"):Text(".")
        Paragraph():Strong("Slide:"):Text(" Do This: Pull the sheet up again")
        Paragraph():Strong("Do This:"):Text(" Evaluate the next iteration again. If you're using the Traversal Machine, pull the index sheet up again. i now equals 3. Evaluate the statement inside the loop.")
        Paragraph():Strong("Click through animation:"):Text(" There are seven steps to click through. "):Code("temps:Get(3)"):Text(" evaluates to 65 which is stored in the variable "):Code("element"):Text(".")
        Paragraph():Strong("Slide:"):Text(" Do This: Now pull up the index sheet one last time.")
        Paragraph():Strong("Do This:"):Text(" Evaluate the loop one last time, pulling up the index sheet again if you're using the Traversal Machine. i now equals 4.")
        Paragraph():Strong("Click through animation:"):Text(" There are three steps to click through.")
        Paragraph():Strong("Say:"):Text(" Is 4 less than 4 (the length of the list)? No - so we exit out of the loop.")
        Paragraph():Strong("Slide:"):Text(" Are you starting to see a pattern here?")
        Paragraph():Strong("Say:"):Text(" Are you starting to a see a pattern here?")
        BulletList()
        ListItem("We are able to access each item in a list by using a loop.")
        ListItem("This is called traversal. We are traveling or traversing through a list one element at a time.")
        Paragraph():Strong("Slide:"):Text(" Do this: Let's look for a number in the temps list.")
        Paragraph():Strong("Say:"):Text(" Let's look for a number in the temps list. It's easy for you to scan the list quickly with your own eyes, but for this exercise, let's pretend you are a computer and must use code to look for the number.")
        Paragraph():Strong("Do this:")
        BulletList()
        ListItem("Write down the code below and put it in your loop.")
        ListItem("If you're using the Traversal Machine, pull the index sheet up each time you go through the loop.")
        ListItem("Run the loop until it is finished.")
        ListItem("Write output to the "):DoubleQuote():Text("console"):DoubleQuote():Text(" -- a scrap piece of paper, a separate blank document, etc.")
        ListItem("When done, compare your console with another group.")
        CodeExample("integer element = temps:Get(i)
if element = 85
    output " + dq + "Element found at index " + dq + " + i
else
    output " + dq + "Not here!" + dq + "
end
i = i + 1")
        Paragraph():Strong("Slide:"):Text(" My Console")
        Paragraph():Strong("Say:"):Text(" Check your console. Does it look like this?")
        CodeExample("Not here!
Element found at index 1
Not here!
Not here!")
        Paragraph():Strong("Say:"):Text(" The number 85 was found at index 1, the second number in the list. Notice that i currently has the value 4. This is because we stopped after four rounds. Element is currently storing 65, the last element that we accessed, at index 3.")
        Paragraph():Strong("Slide:"):Text(" Do this: Now I want to find the smallest number in my list.")
        Paragraph():Strong("Say:"):Text(" Now I want to find the smallest number in a list. I am going to reduce the list to the smallest number.")
        Paragraph():Strong("Do This:")
        BulletList()
        ListItem("We're going to add a new global variable to our program, "):Code("integer min = temps:Get(0)"):Text(". You can add this to the top of your pseudocode or store it on a scrap piece of paper.")
        ListItem("Evaluate that statement to find the first value stored in min.")
        ListItem("Replace the inside of your loop with the new code below.")
        ListItem("Run the program.")
        ListItem("Update the variable min as needed.")
        CodeExample("integer element = temps:Get(i)
if element < min
    min = element
end
i = i + 1")
        Paragraph():Strong("Slide:"):Text(" The smallest number in the list is 65.")
        Paragraph():Strong("Say:"):Text(" The smallest number in the list is 65. Again, this is easy for you to quickly scan with your eyes when your list is short, but imagine if your list contained 1,000 or 1,000,000 elements? This is where a computer using a loop really shines.")
        Paragraph():Strong("Slide:"):Text(" Do this: Let's make it more challenging.")
        Paragraph():Strong("Say:"):Text(" Let's make it more challenging.")
        Paragraph():Strong("Do This:")
        BulletList()
        ListItem("With your partner, update the code inside the for loop to now find the largest number (max)")
        ListItem("One partner creates a new list of 8 random numbers and keeps them hidden.")
        ListItem("The other partner runs the Traversal Machine to find the largest number in the list by asking for each number one at a time.")
        ListItem("Before beginning:")
        NestedBulletList()
        ListItem("Store a new global variable: "):Code("integer max = temps:Get(0)")
        ListItem("Evaluate that statement to find the value stored in max. Ask your partner what is stored at "):DoubleQuote():Text("temps index 0"):DoubleQuote()
        EndNestedList()
        ListItem("Run the loop.")
        ListItem("Check your answer at the end with your partner!")
        Paragraph():Strong("Note:"):Text("Read this example out loud so students understand how they should interact while doing the challenge.")
        CodeExample(dq + "Marnie, what number is at temps index 0?" + dq + "
- Run one round of the loop. If the value is greater than what is already stored in max, update max. If it is not greater than, continue on.
" + dq + "Marnie, what number is at temps index 1?" + dq + "
- And so on and so forth ... until you get to the end of the list.")
        Paragraph("Allow students five or so minutes to fully complete the task. Here's a sample of what their updated code might look like:")
        CodeExample("if element > max
    max = element
end")
        Paragraph():Strong("Slide:"):Text(" Do this: I have a list of animals...")
        Paragraph():Strong("Say:"):Text(" Now I have a list of animals from which I want to filter some elements and store them in another list.")
        Paragraph():Strong("Do This:")
        BulletList()
        ListItem("One partner creates a list of eight random animal names and stores it in the list "):Code("animals"):Text(". Keep this list hidden.")
        ListItem("The other partner separately keep track of a new list called "):Code("animalsListA"):Text(".")
        ListItem("Change the name of the list in your code to animals.")
        ListItem("Copy the code below and place it in your loop.")
        CodeExample("text element = animals:Get(i)
if element:GetSubtext(0, 1) = " + dq + "a" + dq + "
    listAnimalsA:Add(element)
    output " + dq + "Added " + dq + " + element + " + dq + " list" + dq + " 
else
    output " + dq + "Nothing to see here!" + dq + "
end
i = i + 1")
        Paragraph():Strong("Slide:"):Text(" Do This: Run the code")
        Paragraph():Strong("Do This:")
        BulletList()
        ListItem("Run the code")
        ListItem("Keep track of your console")
        ListItem("When finished, trade your animal list with another group, run the code, and compare your console outputs")
        Paragraph():Strong("Note:"):Text(" Expect this activity to take around 5 minutes. When students have finished, move on to the Takeaways in the Wrap Up.")
    end

    private action WrapUp5Minutes
        Section("Wrap Up (5 minutes)")
        Paragraph():Strong("Do This:"):Text(" Review key takeaways with the class.")
        Subsection("Key Takeaways")
        BulletList()
        ListItem("We use a "):Strong("loop"):Text(" to traverse a list, visiting each element one at a time.")
        ListItem("Each pass through the loop, the counting variable changes - usually by one. We can access each element by evaluating "):Code("list:Get(i)"):Text(" in the loop.")
        ListItem("Once we know the element at each spot in a list, we can do different things with it:")
        NestedBulletList()
        ListItem():Strong("Filter"):Text(" (create a subset of elements from the original list)")
        ListItem():Strong("Reduce"):Text(" (reduce the list down to a single element, for example: the smallest number in the list)")
        EndNestedList()
        Paragraph():Strong("Video:"):Text(" As a class, watch the "):Link("CS Principles: Processing Lists", "https://youtu.be/RQ6GJt9f2vg"):Text(" video.")
        Video("https://www.youtube.com/embed/RQ6GJt9f2vg?si=svL3wHEIkQBOdjgU", "CS Principles: Processing Lists")
        Paragraph():Strong("Journal:"):Text(" Have students add the definition for the word traversal to their journal:")
        BulletList()
        ListItem():Emphasis("Traversal:"):Text(" the process of accessing each item in a list one at a time")
        Subsection("Remarks")
        BulletList()
        ListItem("We can use traversals to modify data in several different ways that we will investigate tomorrow including transforming or changing each element in a list, filtering a dataset, and combining or comparing data.")
    end

    private action AssessmentCheckForUnderstanding
        Section("Assessment: Check for Understanding")
        Subsection("For Students")
        Paragraph("Open a word doc or google doc and copy/paste the following question.")
        Subsection("Question")
        Paragraph("Why is a traversal with a loop a good method for accessing and updating items in a lengthy list?")
    end

    private action StandardsAlignment
        Section("Standards Alignment")
        BulletList()
        ListItem():Strong("CSTA K-12 Computer Science Standards (2017): "):Text("3A-AP-14, 3B-AP-10")
        ListItem():Strong("CSP2021: "):Text("AAP-2.O.1, AAP-2.O.2, AAP-2.O.4")
        ListItem():Strong("CSP2021: "):Text("DAT-2.D.6")
    end
end
