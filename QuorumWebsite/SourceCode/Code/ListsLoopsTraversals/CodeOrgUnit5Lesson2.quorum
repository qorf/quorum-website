use Libraries.Web.Page.QuorumPage

/*
    Lists, Loops, and Traversals - Lesson 2: Lists Investigate.
    Converted from the old Lesson page by plan 13's generator: the same
    words, now without Tailwind.
*/
class CodeOrgUnit5Lesson2 is QuorumPage
    // A double quote, for code and words that hold one.
    text dq = ""

    on create
        SetLocation("lessons/code/BuildingApps/Lesson2.html")
        // The name lists and links use, and the series and track it belongs
        // to: its section and picture.
        SetShortTitle("Lists Investigate")
        SetSectionName("Lists, Loops, and Traversals")
        // For search engines and link previews, and what lists of pages say.
        SetDescription("Explore apps and patterns using lists")
        SetSummary("Investigating lists in apps")
    end

    action Setup
        dq = dq:GetDoubleQuote()
        SetWebPageTitle("Unit 5 Lesson 2: Lists Investigate")
        Title("Lists, Loops, and Traversals - Lesson 2: Lists Investigate")
        Overview()
        GettingStarted5Minutes()
        Activity35Minutes()
        WrapUp5Minutes()
        StandardsAlignment()
    end

    private action Overview
        Section("Overview")
        Paragraph("In this lesson students work with partners to investigate three different apps that use lists. Students first explore all three apps without seeing the code to notice similarities and predict how they will work. Then they explore the code itself and make additions and modifications to the apps. To conclude the lesson, students review and discuss common programming patterns with conditionals.")
        Subsection("Goals")
        Paragraph("Students will be able to:")
        BulletList()
        ListItem("Identify common programming patterns using lists")
        ListItem("Explain the purpose of programming patterns with lists both in terms of how they work and what they accomplish")
        ListItem("Modify apps that make use of common programming patterns with lists to adjust their functionality")
        Subsection("Purpose")
        Paragraph("After building a conceptual model for list and list operations in the previous lesson, this lesson allows students to see how they are actually implemented in code. This lesson also introduces common programming patterns when using lists. Students will have some opportunities to modify working code in this lesson, but the most significant practice with lists will come in the following lesson.")
        Subsection("Resources")
        Paragraph("For the students")
        BulletList()
        ListItem():Link("Introduction to Lists - Part 4 (Video)", "https://youtu.be/H__zi1BiXJM")
        ListItem():Link("Introduction to Lists - Part 3 (Video)", "https://youtu.be/rWSsVSMGXXY")
        ListItem():Link("CSP-Widgets repository", "https://github.com/qorf/CSP-Widgets")
    end

    private action GettingStarted5Minutes
        Section("Getting Started (5 minutes)")
        Paragraph():Strong("Prompt:"):Text(" What are some similarities and differences between variables and lists? How does a list manage complexity in a program?")
        DiscussionGoal()
        Paragraph("Students may bring up the following points:")
        BulletList()
        ListItem("Both are used to store information")
        ListItem("Lists store multiple items, but variables only store one")
        ListItem("When written in Javascript, both start with the keyword var")
        ListItem("In Quorum, lists are declared differently than variables")
        ListItem("In Quorum, both variables and lists have types, and can only hold that specific type of information")
        Paragraph("Managing complexity:")
        BulletList()
        ListItem("You don't need to know how a list is created in order to use it - all you need is the name. There is a separation between the abstract properties of the data type (list) and the concrete details of its representation.")
        ListItem("Programs that use lists are easier to read and manage - separate variables are not needed for each individual element")
        EndCallout()
    end

    private action Activity35Minutes
        Section("Activity (35 minutes)")
        Subsection("Accessing Lists (20 minutes)")
        TeachingTip()
        Paragraph():Strong("Finding Target Responses:"):Text(" With a verified teacher account you should be able to see target responses to each question posed on each level.")
        Paragraph():Strong("Prepping for Investigate Lessons:"):Text("The best way to prepare for this lesson is to go through the experience yourself. Check out both apps to get a sense for how they work. Then watch the videos. Then move on to the Code Investigation and actually try to answer all the questions for each app.")
        Paragraph():Strong("Show Videos at the Front:"):Text(" Show videos at the front of the room rather than having students watch them individually. It will be a good opportunity to bring the room back together.")
        Paragraph():Strong("Display Code at the Front:"):Text(" If your room allows it, display the code during the Code Investigation at the front of the room. When students mentions specific lines of code actually scroll to that line and read through it together.")
        EndCallout()
        Paragraph():Strong("Level 1 - Video:"):Text(" Show "):Link("Introduction to Lists - Part 4 (Video)", "https://youtu.be/H__zi1BiXJM"):Text(". This video explains how to determine the length of a list in Javascript. In Quorum, the concepts are the same, but the code looks slightly different. Instead of using "):Code("myList.length"):Text(", the code in Quorum would be "):Code("myList:GetSize()"):Text(".")
        Video("https://www.youtube.com/embed/H__zi1BiXJM?si=tUsnPzYOoacnlQD5", "CS Principles: Introduction to Lists - Part 4 Getting Length")
        Paragraph():Strong("Group:"):Text(" Place students in pairs.")
        Paragraph():Strong("Level 2 - Open a Project:"):Text(" Direct students to open "):Strong("Lesson2_App1"):Text(" and investigate the Outfit Picker app. Each pair should read the app carefully and prepare answers to the questions for their app.")
        Paragraph():Strong("Discuss:"):Text(" Have pairs match up with another pair, forming a group of four. Each pair should spend ~5 minutes walking them through the way that the app works and what they learned specifically from answering each question. Afterwards discuss any open questions that they couldn't answer with the room.")
        DiscussionGoal()
        Paragraph("Use this paired-group discussion to push students on using new vocabulary associated with lists and referring/pointing to specific lines when explaining their answers to the questions. Both programs use .length in ways that might be challenging for students to understand. Demonstrating the difference between using .length and .length-1 to the class could be useful.")
        EndCallout()
        Paragraph():Strong("Modify: "):Text("Have pairs modify the app the investigated based on the instructions for the particular app.")
        Subsection("Chaning Lists")
        Paragraph():Strong("Level 4 - Video:"):Text(" Show "):Link("Introduction to Lists - Part 3 (Video)", "https://youtu.be/rWSsVSMGXXY"):Text(". This video explains how inserting and removing elements in a list in Javascript works. Once again, the concepts are the same in Quorum, but the code is different. Inserting and removing elements in Quorum is done using the "):Code("Add(index, element)"):Text(" and "):Code("RemoveAt(index)"):Text(" commands, respectively.")
        Video("https://www.youtube.com/embed/rWSsVSMGXXY?si=bwoosUrxM1azlofF", "CS Principles: Introduction to Lists - Part 3 Assigning and Updating")
        Paragraph():Strong("Level 5 - Pair Maker: "):Text("Have all pairs investigate "):Strong("Lesson2_App2"):Text(" on their own, answering the questions listed in the code of the Pair Maker app.")
        Paragraph():Strong("Discuss:"):Text(" Have pairs match up with another pair forming a group of four. The group should spend ~5 minutes discussing their responses to each of the questions. Bubble up confusion points or open questions to the room.")
        DiscussionGoal()
        Paragraph("Make sure students understand how the properties of the dropdown and the lists are working together in this program. Demonstrating how to find these properties and play around with them in design mode might help your students better understand the connection.")
        EndCallout()
        Paragraph():Strong("Modify Apps:"):Text(" If there is time remaining, have pairs return to one or more of the apps and make the suggested modifications.")
    end

    private action WrapUp5Minutes
        Section("Wrap up (5 Minutes)")
        Paragraph():Strong("Levels 6-7 Patterns Review:"):Text(" Review the patterns below as a class.")
        BulletList()
        ListItem("Have students add any relevant notes about the patterns to their journals.")
        ListItem("Discuss which of the three apps you think were using which pattern.")
        Subsection("Random List Access Patterns")
        CodeExample("integer index = 0
Array<text> fruitList
Label fruitLabel = undefined

action Start
    fruitList:Add(" + dq + "banana" + dq + ")
    fruitList:Add(" + dq + "apple" + dq + ")
    fruitList:Add(" + dq + "pear" + dq + ")

    // Other code here for setting up an app...
end

action ButtonActivated(Button button)
    index = RandomNumber(0, fruitList:GetSize() - 1)
    UpdateScreen()
end

action UpdateScreen
    fruitLabel:SetText(fruitList:Get(index))
end")
        Subsubsection("How does it work?")
        Paragraph("Many projects run in the following way.")
        BulletList()
        ListItem("The user is interested in seeing items in a list, like a list of favorite foods, or a list of reminders.")
        ListItem("The app shows the user one item in the list at a time.")
        ListItem("By clicking buttons (or otherwise interacting with the app) a new random item in the list is shown to the user.")
        Paragraph("This pattern allows a user to see random elements in a list. In order to make it work, create an index variable and a list. Then generate a random number between 0 and the length of the list minus one and set the index to that value. Then update the screen.")
        Subsection("List Scrolling Pattern")
        CodeExample("integer index = 0
Array<text> fruitList
Label fruitLabel = undefined
Button leftButton = undefined
Button rightButton = undefined

action Start
    fruitList:Add(" + dq + "banana" + dq + ")
    fruitList:Add(" + dq + "apple" + dq + ")
    fruitList:Add(" + dq + "pear" + dq + ")

    // Other code here for setting up an app...
end

action ButtonActivated(Button button)
    if button = leftButton
        if index > 0
            index = index - 1
        end
    elseif button = rightButton
        if index < fruitList:GetSize() - 1
            index = index + 1
        end
    end
    UpdateScreen()
end

action UpdateScreen
    fruitLabel:SetText(fruitList:Get(index))
end")
        Subsubsection("How does it work?")
        Paragraph("Many projects run in the following way.")
        NumberedList()
        ListItem("The user is interested in seeing items in a list, like a list of favorite foods, or a list of reminders.")
        ListItem("The app shows the user one item in the list at a time.")
        ListItem("By clicking buttons (or otherwise interacting with the app) the user can move back and forth through the list, one item at a time, to see every item.")
        Paragraph("This pattern allows a user to "):DoubleQuote():Text("scroll"):DoubleQuote():Text(" through all the items in the list. In order to make it work, create an index variable and a list. Then use the "):DoubleQuote():Text("Counter Pattern with Boundary"):DoubleQuote():Text(" pattern to create event handlers to change the value of the index.")
        Paragraph("This pattern makes sense to use with the "):Code("UpdateScreen"):Text(" pattern since you will need at least two buttons for scrolling left and right through the list but afterwards will use the same code to update the screen.")
        Subsection("Synthesis")
        Paragraph():Strong("Prompt:"):Text(" What aspects of using lists do you feel you already understand? What questions do you want to dig into more tomorrow during the practice lesson?")
        Paragraph():Strong("Discuss:"):Text(" Have students write in their journals, then share with a neighbor, then finally discuss as a class.")
        DiscussionGoal()
        Paragraph():Strong("Discussion Goal:"):Text(" Use this discussion to identify any points of confusion that will need to be reviewed in coming lessons.")
        EndCallout()
    end

    private action StandardsAlignment
        Section("Standards Alignment")
        BulletList()
        ListItem():Strong("CSTA K-12 Computer Science Standards (2017): "):Text("3A-AP-14, 3A-AP-23")
        ListItem():Strong("CSP2021: "):Text("AAP-1.A.3, AAP-1.A.4")
        ListItem():Strong("CSP2021: "):Text("AAP-1.D.1, AAP-1.D.2, AAP-1.D.3, AAP-1.D.4, AAP-1.D.5, AAP-1.D.6")
    end
end
