use Libraries.Web.Page.QuorumPage

/*
    Lists, Loops, and Traversals - Lesson 5: Loops Explore.
    Converted from the old Lesson page by plan 13's generator: the same
    words, now without Tailwind.
*/
class CodeOrgUnit5Lesson5 is QuorumPage

    on create
        SetLocation("lessons/code/BuildingApps/Lesson5.html")
        // The name lists and links use, and the series and track it belongs
        // to: its section and picture.
        SetShortTitle("Loops Explore")
        SetSectionName("Lists, Loops, and Traversals")
        // For search engines and link previews, and what lists of pages say.
        SetDescription("Discover how to use loops to repeat code")
        SetSummary("Learn about loops")
    end

    action Setup
        SetWebPageTitle("Unit 5 Lesson 5: Loops Explore")
        Title("Lists, Loops, and Traversals - Lesson 5: Loops Explore")
        Overview()
        GettingStarted5Minutes()
        Activity30Minutes()
        WrapUp10Minutes()
        AssessmentCheckForUnderstanding()
        StandardsAlignment()
    end

    private action Overview
        Section("Overview")
        Paragraph("Students begin the lesson by discussing the purpose of loops before completing the unplugged activity. This activity involves moving a "):DoubleQuote():Text("robot"):DoubleQuote():Text(" around a game board while practicing tracing blocks of code by hand. To conclude, the lesson is wrapped up with a vocabulary discussion and a video.")
        Subsection("Goals")
        Paragraph("Students will be able to:")
        BulletList()
        ListItem("Use appropriate vocabulary to describe loops.")
        ListItem("Identify the exit point of a loop.")
        ListItem("Trace a simple program with a loop.")
        Subsection("Purpose")
        Paragraph("Students are introduced to the concept of loops through a robot maze activity. This unplugged lessons provides students a physical mental model they will be able to use when they start programming with loops in the subsequent lessons.")
        Subsection("Resources")
        Paragraph():Strong("For the students")
        BulletList()
        ListItem():Link("CS Principles: Using Loops (Video)", "https://youtu.be/G8hfAk4PfOM")
        Subsubsection("Supplemental code.org material")
        BulletList()
        ListItem():Link("Code.org CSP Unit 5 Presentation Slides", "https://docs.google.com/presentation/d/1qQPTgZxJnYZRl-9Do2UB_hM882QtouLclWfCsw8jDBw/copy")
        Subsection("Preparation")
        BulletList()
        ListItem("1 game board per pair of students")
        ListItem("1 "):DoubleQuote():Text("robot"):DoubleQuote():Text(" per pair of students")
        ListItem("Game pieces, markers, or tokens that can be used to represent barriers")
        ListItem("Review the optional Intro to Loops presentation and click through all of the animations if you plan on using the slides")
        TeachingTip()
        BulletList()
        ListItem():Strong("Robot:"):Text(" The "):DoubleQuote():Text("robot"):DoubleQuote():Text(" can be any small item that fits in a square on the game board and is clearly facing a direction. It could be as simple as a scrap of paper shaped like a triangle or a paperclip with googly eyes.")
        ListItem():Strong("Game Pieces:"):Text(" The game pieces can be anything that will fit in a square on the game board that is clearly distinguishable from the robot. For example, you can use knick-knacks, tokens, markers, paperclips, or scraps of paper.")
        ListItem():Strong("Game Board:"):Text(" The game board should be a grid that is 5x5. You can use a grid printed on paper, a chess board, or a tactile grid, such as a LEGO board. If your grid is larger than 5x5, you should mark off the excess space. The robot and obstacles should only be placed within the 5x5 section for this activity.")
        EndCallout()
    end

    private action GettingStarted5Minutes
        Section("Getting Started (5 minutes)")
        Subsection("Set-up")
        Paragraph():Strong("Distribute:"):Text(" The activity today involves a lot of moving pieces. Take this time at the beginning of class to pass out supplies and pair students.")
        Paragraph("Per pair of students:")
        BulletList()
        ListItem("1 game board")
        ListItem("1 "):DoubleQuote():Text("robot"):DoubleQuote()
        ListItem("At least 4 game pieces, markers, or tokens that can be used to represent barriers")
        Paragraph():Strong("Group:"):Text(" Put students in groups of two.")
    end

    private action Activity30Minutes
        Section("Activity (30 minutes)")
        Subsection("Loops")
        TeachingTip()
        Paragraph("This activity asks students to follow along as a number of core concepts for programming are introduced. The model is typically that a term or concept is introduced and modeled and then afterwards students are encouraged to try it out on their own. Trying it out typically means they are writing information on a note and sharing it with another group before discussing the results with the whole class.")
        Paragraph("Slides with animations have an icon in the bottom left corner to let you know you need to click to reveal more of the slide's content.")
        Paragraph("To help you more easily prepare the activity and keep track of your instructions, detailed instructions have been included as speaker notes in the presentation. Here are some tips to help you throughout the presentation.")
        BulletList()
        ListItem("There are opportunities throughout the presentation for students to actively engage. At these moments students should be making things with their manipulatives or using them to answer questions. Use these opportunities to check progress.")
        ListItem("There is a fair amount of new vocabulary introduced but it is introduced gradually and with intentional repetition. Make a point of actively modeling the use of new terms.")
        ListItem("The most important goal here is building a mental model. It is ok if students have some open questions that will get resolved over the subsequent conditional lessons.")
        ListItem("Both you and students can use the "):DoubleQuote():Text("Key Takeaways"):DoubleQuote():Text(" to check your understanding at the end.")
        EndCallout()
        Paragraph():Strong("Guided Activity:"):Text(" Today's activity introduces students to the concept of loops. As a visual aid, you can use "):Link("Code.org's presentation slides for Unit 5, Lesson 5: Loops Explore.", "https://docs.google.com/presentation/d/1qQPTgZxJnYZRl-9Do2UB_hM882QtouLclWfCsw8jDBw/copy"):Text(" These slides include animations. The notes below describe when to move to the next slide or click through an animation -- if you aren't using the slides, you can ignore these prompts.")
        Subsection("Guided Activity")
        Paragraph("Follow this lesson with the supplemental slides.")
        Paragraph():Strong("Slide:"):Text(" Do this: You have one command")
        Paragraph():Strong("Say:"):Text(" Today we are going to explore Loops. You will move a robot around a game board following commands. Here's the first one: "):Code("MoveForward()")
        Paragraph():Strong("Do This:"):Text(" Place the robot in the center of the bottom row, facing the top row. Use the "):Code("MoveForward()"):Text(" command to write a program to move the robot to the top row.")
        Paragraph():Strong("Click through animation to reveal the answer.")
        Paragraph():Strong("Slide:"):Text(" This code is repetitive.")
        Paragraph():Strong("Say:"):Text(" This code is repetitive. How can we simplify it? By using a While Loop.")
        Paragraph():Strong("Slide:"):Text(" Here's how it works:")
        Paragraph():Strong("Say:"):Text(" Here's how a While Loop works. While something is true, the code in the while loop runs, over and over until that thing is no longer true. Let's try it together!")
        Paragraph():Strong("Slide:"):Text(" var steps = 0;")
        Paragraph():Strong("Say:"):Text(" Let's run this program together. Set up your board with the robot in the center of the bottom row, facing the top. We are going to run each step of the loop together. First you will try it on your board, and then we will look at the answers together.")
        CodeExample("integer steps = 0

repeat while steps < 4
    MoveForward()
    steps = steps + 1
end")
        Paragraph():Strong("Slide:"):Text(" Round 1")
        Paragraph():Strong("Say:"):Text(" Read the code with your partner and complete the first round of the loop. You may want to keep track of the value in the variable using a note or scrap of paper.")
        Paragraph():Strong("Click through for animation "):Text("to view the answer after students have had a chance to follow the code on their own board. Discuss each part of the code as it is running.")
        Paragraph():Strong("Slide:"):Text(" Round 2")
        Paragraph():Strong("Say:"):Text(" Let's continue on with the second round. You do it first.")
        Paragraph():Strong("Click through for animation "):Text("to view the answer after students have had a chance to follow the code on their own board. Discuss each part of the code as it is running.")
        Paragraph():Strong("Slide:"):Text(" Round 3")
        Paragraph():Strong("Say:"):Text(" Now on to the third round. You do it first.")
        Paragraph():Strong("Click through for animation "):Text("to view the answer after students have had a chance to follow the code on their own board. Discuss each part of the code as it is running.")
        Paragraph():Strong("Slide:"):Text(" Round 4")
        Paragraph():Strong("Say:"):Text(" Time for the fourth round. You do it first.")
        Paragraph():Strong("Click through for animation "):Text("to view the answer after students have had a chance to follow the code on their own board. Discuss each part of the code as it is running.")
        Paragraph():Strong("Slide:"):Text(" Round 5")
        Paragraph():Strong("Say:"):Text(" What happens here? Discuss with your partner.")
        Paragraph():Strong("Click through for animation "):Text("to view the answer after students have had a chance to follow the code on their own board. Discuss each part of the code as it is running. The main thing to point out here is that the loop ends because the Boolean expression evaluates to false.")
        Paragraph():Strong("Slide: "):Text("var steps = 0;")
        Paragraph():Strong("Do This:"):Text(" Put the robot on the bottom row in the center column, facing upwards. With your partner, run this program on your board. What happens?")
        CodeExample("integer steps = 0

repeat while steps < 4
    MoveForward()
end")
        Paragraph():Strong("Click for animation.")
        Paragraph():Strong("Discuss:"):Text(" Why does the robot run off the board?")
        Paragraph("This is an example of an infinite loop. The program never ends because steps will always be less than 4.")
        Paragraph():Strong("Slide: "):Text("Do This: You have a new command.")
        Paragraph():Strong("Say:"):Text(" You have a new command, "):Code("TurnRight()")
        Paragraph():Strong("Do This:"):Text(" Put the robot on the bottom row in the second column, facing upwards. Run this program on your board. Where will the robot end up?")
        CodeExample("integer steps = 0
repeat while steps < 4
    MoveForward()
    TurnRight()
    steps = steps + 1
end")
        Paragraph():Strong("Click through animation to see the answer."):Text(" The robot returns to its original position.")
        Paragraph():Strong("Slide: "):Text("While Loop: 3 Parts")
        Paragraph():Strong("Say:"):Text(" A While Loop has three distinct parts.")
        BulletList()
        ListItem("A counting variable set to an initial value")
        ListItem("A Boolean expression which checks the condition of that variable")
        ListItem("A statement which increases or decreases the variable that is being checked")
        NestedBulletList()
        ListItem("Note: if this piece is missing, you may create an "):Strong("infinite loop"):Text(" that never stops running!")
        EndNestedList()
        Paragraph():Strong("Click for animation: "):Text("Read each step as the animation highlights the program code.")
        Paragraph():Strong("Slide: "):Text("A for loop combines these three parts into one statement")
        Paragraph():Strong("Say:"):Text(" A For Loop combines all three of these parts into one statement.")
        Paragraph():Strong("Click for animation:"):Text(" Read each step as the animation highlights the Javascript code, or look at the Quorum code below.")
        CodeExample("repeat 4 times
    MoveForward()
end")
        Paragraph():Strong("Note:"):Text(" The "):DoubleQuote():Text("repeat times"):DoubleQuote():Text(" loop in Quorum is slightly different than the traditional "):DoubleQuote():Text("for"):DoubleQuote():Text(" loop in Javascript. Both loops make it possible to iterate a specific number of times, but in Quorum, you don't make a variable as part of the loop declaration.")
        Paragraph():Strong("Say:"):Text(" A loop is an example of iteration: a repetitive portion of an algorithm which repeats a specified number of times or until a given condition is met.")
        Paragraph():Strong("Slide: "):Text("Do this: You have another new command")
        Paragraph():Strong("Say:"):Text(" You have another new command: "):Code("TurnLeft()")
        Paragraph():Strong("Click to reveal the program code,"):Text(" or share the Quorum code below. Have students place the robot in the bottom left corner of their grid, facing forward again.")
        CodeExample("repeat 3 times
    MoveForward()
    TurnRight()
    MoveForward()
    TurnLeft()
end")
        Paragraph():Strong("Do This:"):Text(" With your partner, follow the code with your robot.")
        Paragraph():Strong("Click through the animation to see the answer.")
        Paragraph():Strong("Slide: "):Text("Do this: click to see a new program.")
        Paragraph():Strong("Click to reveal the program code,"):Text(" or share the Quorum code below.")
        CodeExample("integer steps = 0

repeat while steps <= 2
    MoveForward()
    MoveForward()
    TurnRight()
    MoveForward()
    steps = steps + 1
end")
        Paragraph():Strong("Do This:"):Text(" Place the robot on the second row from the bottom, in the left-most column, facing towards the top. Run the program on your board. Where will the robot end up?")
        Paragraph():Strong("Click through the animation to see the answer.")
        Paragraph():Strong("Slide: "):Text("Do this: Click to see a new program.")
        Paragraph():Strong("Click to reveal the program code,"):Text(" or share the Quorum code below.")
        CodeExample("repeat 2 times
    MoveForward()
    TurnLeft()
    TurnLeft()
    MoveForward()
    MoveForward()
end")
        Paragraph():Strong("Do This:"):Text(" Place the robot on the center of your board, then run the program. Where will the robot end up?")
        Paragraph():Strong("Click through the animation to see the answer")
        Paragraph():Strong("Slide: "):Text("Let's make it a little more challenging.")
        Paragraph():Strong("Say: "):Text("We're going to add some new commands to make things more challenging: "):Code("CanMoveLeft()"):Text(", "):Code("CanMoveRight()"):Text(", "):Code("CanMoveForward()"):Text(", and "):Code("CanMoveBackward()"):Text(". These evaluate to true or false and are dependent on the direction that the robot is facing. If a barrier or a wall (the edge of the board) is in the way, the Boolean expression evaluates to False.")
        Paragraph():Strong("Slide: "):Text("canMove(forward);")
        Paragraph():Strong("Click through the animation to see the answer.")
        Paragraph():Strong("Say:"):Text(" In this example, we have our robot in the center of our grid, facing upwards. There is a barrier in the space immediately to its left. "):Code("CanMoveLeft()"):Text(" returns false, and the other commands return true.")
        Paragraph():Strong("Slide: "):Text("canMove(forward);")
        Paragraph():Strong("Click through the animation to see the answer.")
        Paragraph():Strong("Say:"):Text(" In this example, our robot is in the top row, in the center column, and facing to the right. There is a barrier immediately behind it, so "):Code("CanMoveBackward()"):Text(" returns false. "):Code("CanMoveLeft()"):Text(" also returns false, because the robot's left side is up against a wall (the edge of the board).")
        Paragraph():Strong("Slide: "):Text("Do This: Run the following program.")
        Paragraph():Strong("Click to reveal the program code,"):Text(" or share the Quorum code below.")
        CodeExample("repeat 3 times
    if CanMoveRight()
        TurnRight()
        MoveForward()
    end
    TurnLeft()
    if CanMoveForward()
        MoveForward()
    end
end")
        Paragraph():Strong("Do This:"):Text(" Place the robot in the center of the grid facing upwards. Then place a barrier one space below the robot, and another barrier one space above and to the right of the robot. Then run the program on your board. Where will the robot end up?")
        Paragraph():Strong("Click through the animation to see the answer.")
        Paragraph():Strong("Slide: "):Text("Do this: Run the following program.")
        Paragraph():Strong("Click to reveal the program code,"):Text(" or share the Quorum code below.")
        CodeExample("repeat 4 times
    if CanMoveForward()
        MoveForward()
    end
    TurnLeft()
    if CanMoveForward()
        MoveForward()
    end
    Turn Right()
end")
        Paragraph():Strong("Do This:"):Text(" Place the robot in the fourth column and the bottom row, facing upwards. Then, place a barrier one space to the left of the robot, and another barrier three spaces to the left of the robot. Finally, place a barrier in the second column in the top row and another in the second column in the center row. Then run the program on your board. Where will the robot end up?")
        Paragraph():Strong("Click through the animation to see the answer.")
        Paragraph():Strong("Slide: "):Text("Challenge!")
        Paragraph():Strong("Say:"):Text(" Now it's your turn to write your own programs!")
        Paragraph():Strong("Do This:"):Text(" With a partner, set up a game board and add as many barriers as you'd like. Write a program using a for loop to navigate the board. Figure out the starting and ending points of the robot. Share your board and code with another group. See if you agree on the ending point of the robot!")
        Paragraph():Strong("Slide: "):Text("Key Takeaways")
        Paragraph():Strong("Do This:"):Text(" Review the key takeaways with students.")
        Paragraph():Strong("Note:"):Text(" The key takeaways are slightly different between Javascript and Quorum because the "):DoubleQuote():Text("for"):DoubleQuote():Text(" and "):DoubleQuote():Text("repeat times"):DoubleQuote():Text(" loops are not identical. One important takeaway for both languages though is that the "):DoubleQuote():Text("while"):DoubleQuote():Text(" loop can do anything the other loops can. The other loop styles are just for convenience.")
        BulletList()
        ListItem():Strong("Repeat While Loops"):Text(" use a boolean condition to repeatedly run a block of code. If it is true it runs the block of code contained within it. This process of checking the condition and running the block of code is repeated as long as the Boolean condition remains true. Once the Boolean expression becomes false it will stop.")
        ListItem():Strong("Repeat Times Loops"):Text(" explicitly run a set number of times. How many times this kind of loop runs could be a constant number or it could be a variable.")
    end

    private action WrapUp10Minutes
        Section("Wrap Up (10 minutes)")
        Subsection("Introduction to Loops")
        Paragraph():Strong("Video:"):Text(" As a class, watch the "):Link("CS Principles: Using Loops", "https://youtu.be/G8hfAk4PfOM"):Text(" video from Code.org. The video discusses the use of loops in Javascript, but most of the concepts are still useful in Quorum as well.")
        Video("https://www.youtube.com/embed/G8hfAk4PfOM?si=l47ftyQzlrt4Td9j", "CS Principles: Using Loops")
        Subsection("Journal")
        Paragraph("Have students add the following terms to their journals:")
        BulletList()
        ListItem():Emphasis("iteration:"):Text(" a repetitive portion of an algorithm which repeats a specified number of times or until a given condition is met.")
        ListItem():Emphasis("infinite loop:"):Text(" occurs when the ending condition will never evaluate to true.")
    end

    private action AssessmentCheckForUnderstanding
        Section("Assessment: Check for Understanding")
        Subsection("For Students")
        Paragraph("Open a word doc or google doc and copy/paste the following question.")
        Subsection("Question")
        Paragraph("When breaking a problem down, you often encounter elements that you want to use repeatedly in your code. Sometimes it's appropriate to write a new function; at other times it's appropriate to write a loop.")
        Paragraph("Reminder: There is no hard-and-fast rule as to which is better, but what do you think? What kinds of circumstances would lead you to writing a function versus using a loop?")
    end

    private action StandardsAlignment
        Section("Standards Alignment")
        BulletList()
        ListItem():Strong("CSTA K-12 Computer Science Standards (2017): "):Text("3A-AP-15")
        ListItem():Strong("CSP2021: "):Text("AAP-2.K.1, AAP-2.K.4")
    end
end
