use Libraries.Web.Page.QuorumPage

/*
    Lists, Loops, and Traversals - Lesson 7: Loops Practice.
    Converted from the old Lesson page by plan 13's generator: the same
    words, now without Tailwind.
*/
class CodeOrgUnit5Lesson7 is QuorumPage
    // A double quote, for code and words that hold one.
    text dq = ""

    on create
        SetLocation("lessons/code/BuildingApps/Lesson7.html")
        // The name lists and links use, and the series and track it belongs
        // to: its section and picture.
        SetShortTitle("Loops Practice")
        SetSectionName("Lists, Loops, and Traversals")
        // For search engines and link previews, and what lists of pages say.
        SetDescription("Practice writing and debugging loops")
        SetSummary("Practice with loops")
    end

    action Setup
        dq = dq:GetDoubleQuote()
        SetWebPageTitle("Unit 5 Lesson 7: Loops Practice")
        Title("Lists, Loops, and Traversals - Lesson 7: Loops Practice")
        Overview()
        GettingStarted5Minutes()
        Activity35Minutes()
        WrapUp5Minutes()
        AssessmentCheckForUnderstandingAPPractice()
        StandardsAlignment()
    end

    private action Overview
        Section("Overview")
        Paragraph("Students practice the basics of loops including using while loops, repeat times loops, and updating multiple screen elements with a while loop. Along the way students develop debugging practices with loops.")
        Subsection("Goals")
        Paragraph("Students will be able to:")
        BulletList()
        ListItem("Write programs that use loops with the support of sample code.")
        ListItem("Debug programs that use loops")
        ListItem("Use a for loop to update multiple screen elements at once")
        Subsection("Purpose")
        Paragraph("This lesson is students primary opportunity to get hands on with loops in code prior to the Make activity in the following lesson. Give students as much class time as you can to work through these. For this lesson it's recommended that you place students in pairs as a support and to encourage discussion about the challenges or concepts they're seeing.")
        Subsection("Resources")
        BulletList()
        ListItem():Link("CSP-Widgets repository", "https://github.com/qorf/CSP-Widgets")
    end

    private action GettingStarted5Minutes
        Section("Getting Started (5 minutes)")
        TeachingTip()
        Paragraph():Strong("Move Quickly to the Activity:"):Text(" There's a lot in the main activity of today's lesson. You may optionally wish to do a quick vocabulary review or address any questions that came up in the last lesson. Otherwise, give students more time to get hands on with some code.")
        EndCallout()
        Subsection("Quick Warm Up")
        BulletList()
        ListItem("Today we're going to have a chance to practice programming with a lot of the concepts and patterns we've explored over the last two lessons. I encourage you to go through these with a partner, but pay close attention to what each other is doing. In our next lesson you're going to have to use a lot of these on an independent project, and these activities are good practice for what you'll find there! Alright, let's get to it!")
    end

    private action Activity35Minutes
        Section("Activity (35 minutes)")
        Subsection("Debugging")
        BulletList()
        ListItem("Describe the Problem: What do you expect it to do? What does it actually do? Does it always happen?")
        ListItem("Hunt for Bugs: Are there warnings or errors? What did you change most recently? Explain your code to someone else. Look for code related to the problem")
        ListItem("Try Solutions: Make a small change.")
        ListItem("Read the resources in the Help & Tips tab")
        ListItem("Document As You Go: What have you learned? What strategies did you use? What questions do you have?")
        Subsection("Practice Time")
        TeachingTip()
        Paragraph():Strong("Providing Support:"):Text(" Circulate around the room through the lesson encouraging students to use the strategies introduced at the beginning of the lesson. Students have a number of supports at their fingertips, so a big part of your role is helping build their independence in using those resources.")
        EndCallout()
        Subsubsection("Remarks")
        BulletList()
        ListItem("Today you're mostly going to practice what we've learned about programming with loops. I'm here to help you when you need. However, I first want to remind you of the following:")
        NestedBulletList()
        ListItem("Use your debugging skills. Try to zoom in on precisely where you're getting stuck.")
        ListItem("Talk to your partner! That's what they're there for!")
        ListItem("Hover over blocks to read the documentation about how they work.")
        ListItem("Read the resources in the Help & Tips tab")
        ListItem("Talk to the group next to you. If another group asks for help make sure to take some time to talk it through with them.")
        EndNestedList()
        ListItem("We can debug loops by using the Watch Panel with our iterator variable, usually an i.")
        NestedBulletList()
        ListItem("Watcher Panel: Here you can see the length of a list in addition to all of the elements.")
        EndNestedList()
        Paragraph():Strong("Open a Project:"):Text(" For today's activity, students will work through a series of projects, beginning with "):Strong("Lesson7_App1.")
        Paragraph():Strong("Apps 1-3 While Loop Practice:"):Text(" Simple "):Code("output"):Text(" projects in which students practice using while loops.")
        BulletList()
        ListItem("App 1: Students use a while loop to print the numbers 0-99")
        ListItem("App 2: Students use a while loop to print a message 100 times")
        ListItem("App 3: Students use a while loop to fill an array and print the results")
        Paragraph():Strong("Apps 4-6 For Loop Practice:"):Text(" In these levels, students consider when to use "):Code("for"):Text(" loops, and when they should use "):Code("while"):Text(" loops instead.")
        BulletList()
        ListItem("App 4: Students use a for loop to print the numbers 0-99.")
        ListItem("App 5: Students use a for loop to print a message 100 times.")
        ListItem("App 6: Students use a for loop to fill an array and print the results.")
        Paragraph():Strong("Apps 7-8: Loops and Screen Elements:"):Text(" In these levels students practice writing programs that modify screen elements with loops. Screen elements have already been designed to have repeated patterns (e.g. "):DoubleQuote():Text("dice0"):DoubleQuote():Text(", "):DoubleQuote():Text("dice1"):DoubleQuote():Text(", "):DoubleQuote():Text("dice2"):DoubleQuote():Text(" ...) that make it possible to write code that modifies every screen element. This is important practice for the Make project in the next lesson.")
        BulletList()
        ListItem("App 7: This project is a simple introduction to using loops to modify multiple labels at once.")
        ListItem("App 8: Students must update a "):DoubleQuote():Text("Dice Roller"):DoubleQuote():Text(" app that has some working functionality already. All of the different concepts they'll need to use are already in the starter code of this app, but they'll need to think through how to put them together to get the target code behavior.")
    end

    private action WrapUp5Minutes
        Section("Wrap Up (5 minutes)")
        Paragraph():Strong("Prompt:"):Text(" What aspects of working with loops do you feel like clicked today? What do you still feel like you have trouble with?")
        DiscussionGoal()
        Paragraph("Use this opportunity to address any lingering questions or misconceptions in the room. You can also use this as a source of discussion topics to kick off the following lesson. As you lead the discussion, call out the many resources students have access to help when they're getting stuck.")
        EndCallout()
        Paragraph():Strong("Discuss:"):Text(" Have students share with one another before sharing with the whole class.")
        Subsection("Remarks")
        BulletList()
        ListItem("Working with loops can be tricky - especially working with the iterator variable. We will get more practice tomorrow by making an app that uses loops in an interesting way.")
    end

    private action AssessmentCheckForUnderstandingAPPractice
        Section("Assessment: Check for Understanding - AP Practice")
        Subsection("For Students")
        Paragraph("Open a word doc or google doc and copy/paste the following question.")
        Subsection("Question 1")
        Paragraph("What will be displayed after this code snippet is run?")
        CodeExample("a <- 0
REPEAT 3 TIMES
{
    a <- a + 1
    DISPLAY(a)
    a <- a + 1
}")
        Subsection("Question 2")
        Paragraph("What will be displayed after this code snippet is run?")
        CodeExample("count <- 0
REPEAT UNTIL (count = 3)
{
    count <- count + 1
    DISPLAY(" + dq + "and" + dq + ")
    DISPLAY(count)
}")
    end

    private action StandardsAlignment
        Section("Standards Alignment")
        BulletList()
        ListItem():Strong("CSTA K-12 Computer Science Standards (2017): "):Text("3A-AP-15, 3A-DA-12")
        ListItem():Strong("CSP2021: "):Text("AAP-2.K.2, AAP-2.K.3, AAP-2.K.4, AAP-2.K.5")
        ListItem():Strong("CSP2021: "):Text("AAP-2.L.1, AAP-2.L.2, AAP-2.L.5")
        ListItem():Strong("CSP2021: "):Text("CRD-2.I.3, CRD-2.I.4")
    end
end
