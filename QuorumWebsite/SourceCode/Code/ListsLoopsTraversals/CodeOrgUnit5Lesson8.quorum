use Libraries.Web.Page.QuorumPage

/*
    Lists, Loops, and Traversals - Lesson 8: Loops Make.
    Converted from the old Lesson page by plan 13's generator: the same
    words, now without Tailwind.
*/
class CodeOrgUnit5Lesson8 is QuorumPage

    on create
        SetLocation("lessons/code/BuildingApps/Lesson8.html")
        // The name lists and links use, and the series and track it belongs
        // to: its section and picture.
        SetShortTitle("Loops Make")
        SetSectionName("Lists, Loops, and Traversals")
        // For search engines and link previews, and what lists of pages say.
        SetDescription("Make an app using lists and loops")
        SetSummary("Make an app using lists and loops")
    end

    action Setup
        SetWebPageTitle("Unit 5 Lesson 8: Loops Make")
        Title("Lists, Loops, and Traversals - Lesson 8: Loops Make")
        Overview()
        GettingStarted2Minutes()
        Activity38Minutes()
        WrapUp5Minutes()
        AssessmentMakeProject()
        StandardsAlignment()
    end

    private action Overview
        Section("Overview")
        Paragraph("Using Programming Patterns and a step-by-step approach students make their own version of a Lock Screen Maker app. At the beginning of the lesson students are able to explore a working version of the app. They are then given the design elements of the app but begin with minimal starting code. A progression of levels guides students on the high level steps they should use to develop their app but leaves it to them to decide how to write the code. At the end students submit their apps which can be assessed using a provided rubric.")
        Subsection("Goals")
        Paragraph("Students will be able to:")
        BulletList()
        ListItem("Recognize the need for programming patterns with loops as part of developing a functioning app")
        ListItem("Implement programming patterns with loops to develop a functioning app")
        ListItem("Write comments to clearly explain both the purpose and function of different segments of code within an app")
        ListItem("Use debugging skills as part of developing an app")
        Subsection("Purpose")
        Paragraph("This lesson is an opportunity for students to take on the "):DoubleQuote():Text("blank screen"):DoubleQuote():Text(" and build the code that runs an app entirely from scratch. Guidance provided throughout the lesson helps students break down the large task of "):DoubleQuote():Text("building an app"):DoubleQuote():Text(" into more incremental steps that they can use on future projects, including this unit's final project and the Create PT.")
        Subsection("Resources")
        BulletList()
        ListItem():Link("CSP-Widgets repository", "https://github.com/qorf/CSP-Widgets")
        Subsubsection("Supplimental Code.org material")
        BulletList()
        ListItem():Link("(Optional) CSP Loops Make - Lock Screen Maker (Activity Guide)", "https://docs.google.com/document/d/1MPQ1wXqf5SwDuqCJtiG7aGzrtmkOwCD5PUiPU32-LE4/edit?usp=sharing")
    end

    private action GettingStarted2Minutes
        Section("Getting Started (2 minutes)")
        TeachingTip()
        Paragraph():Strong("Short Intro:"):Text(" The Warm Up today is short and light. Students should spend the maximum amount of time working on their projects.")
        EndCallout()
        Subsection("Remarks")
    end

    private action Activity38Minutes
        Section("Activity (38 minutes)")
        Paragraph():Strong("Group:"):Text(" Make a determination as to whether this project will be completed in pairs or individually. You may even choose to let students decide.")
        Paragraph():Strong("Open a Project:"):Text(" Direct students to open and run the "):Strong("Lesson8_ExampleApp"):Text(" project.")
        Paragraph():Strong("Explore:"):Text(" Have students explore the working Lock Screen Maker app. If students are not working in pairs they should still discuss these prompts with a neighbor:")
        Subsection("Discuss:")
        BulletList()
        ListItem("Where (if at all) do you think this app is using a loop?")
        ListItem("Where (if at all) do you think this app is using a list?")
        DiscussionGoal()
        Paragraph("Where (if at all) do you think this app is using a loop?")
        BulletList()
        ListItem("It's more important that students justify their answers. However, students may reconize that the different icons are likely being chosen from a list.")
        Paragraph("Where (if at all) do you think this app is using a list?")
        BulletList()
        ListItem("Students will hopefully recognize that with many different icons to be updated by each button there is almost certainly a loop being used by each of those button.")
        EndCallout()
        Subsection("Remarks")
        BulletList()
        ListItem("Now let's build the this app. The screen has been set up for you - it's your job to add the code!")
        Paragraph():Strong("Distribute:"):Text(" Give students copies of "):Link("CSP Loops Make - Lock Screen Maker (Activity Guide)", "https://docs.google.com/document/d/1MPQ1wXqf5SwDuqCJtiG7aGzrtmkOwCD5PUiPU32-LE4/edit?usp=sharing"):Text(" if you will be using it during the class.")
        TeachingTip()
        Paragraph():Strong("Supporting Students:"):Text(" While students are working on their apps, circulate the room and check in with students who need a little help. Encourage students to collaborate and discuss bugs with each other.")
        Paragraph():Strong("Debugging:"):Text(" Review with students steps they can use to debug if they get stuck:")
        BulletList()
        ListItem("Build small parts of the program at a time and test them to make sure they work")
        ListItem("Add output statements to check variables at specific points")
        ListItem("Explain the code to a friend and clarify the differences between what they expect to happen and what is actually happening")
        EndCallout()
        Paragraph():Strong("Open a Project:"):Text(" Direct students to open "):Strong("Lesson8_ProjectTemplate"):Text(".")
        Paragraph():Strong("Do This:"):Text(" Students should complete the Lock Screen Maker app from the template. Based on the needs of your classroom decide whether you will collectively go through the activity guide or have students complete it individually. Afterwards give them time to work on their projects and circulate the room to offer support. Students who finish early can work on the extensions suggested in the activity guide.")
        Paragraph():Strong("Submit:"):Text(" Encourage students to check the rubric on the last page of the Activity Guide before submitting.")
    end

    private action WrapUp5Minutes
        Section("Wrap Up (5 minutes)")
        TeachingTip()
        Paragraph():Strong("Maximize Work Time:"):Text(" The wrap up is short to allow the maximum amount of time for students to complete the activity.")
        EndCallout()
        Subsection("Remarks")
        BulletList()
        ListItem("Awesome work today! Make sure to submit your project when you're done with it!")
    end

    private action AssessmentMakeProject
        Section("Assessment: Make Project")
        Table("Rubric for assessing student projects")
        TableHeader():Cell("Category"):Cell("Extensive Evidence"):Cell("Convincing Evidence"):Cell("Limited Evidence"):Cell("No Evidence")
        TableRow():Cell("Input"):Cell("onEvents are created for all the required inputs."):Cell("onEvents are created for most of the inputs."):Cell("onEvents are created for some of the inputs."):Cell("onEvents are not created for any inputs.")
        TableRow():Cell("Variables and Lists"):Cell("Variables and lists are created and appropriately used for all pieces of information used in the app."):Cell("Variables and lists are created and appropriately used for most pieces of information used in the app."):Cell("Some information is stored in variables and lists and appropriately updated throughout the app."):Cell("There are no variables or lists which store the necessary information for the app to work correctly.")
        TableRow():Cell("Loops"):Cell("The program correctly uses loops for all three buttons to generate the expected output."):Cell("The program correctly uses a loop for two of the buttons to generate the expected output."):Cell("The program correctly uses lists for one of the buttons to generate the expected output."):Cell("The program does not include or correctly use any loops.")
        TableRow():Cell("Output"):Cell("All three buttons work as expected to move icons, change their colors, and change their icon to a random new icon."):Cell("Only two of the buttons work as expected."):Cell("Only one of the buttons work as expected."):Cell("None of the buttons work as expected.")
        TableRow():Cell("Code runs without errors."):Cell("No errors are present in the required code."):Cell("Some errors are present in the required code."):Cell("Many errors are present in the required code."):Cell("The code does not run.")
        TableRow():Cell("Code runs without errors."):Cell("No errors are present in the required code."):Cell("Some errors are present in the required code."):Cell("Many errors are present in the required code."):Cell("The code does not run.")
        Paragraph("Use the rubric below or (optionally) the one provided with the project to assess student projects.")
    end

    private action StandardsAlignment
        Section("Standards Alignment")
        BulletList()
        ListItem():Strong("CSTA K-12 Computer Science Standards (2017): "):Text("3A-AP-15")
    end
end
