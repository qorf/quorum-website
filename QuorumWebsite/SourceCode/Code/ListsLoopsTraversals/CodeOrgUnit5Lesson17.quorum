use Libraries.Web.Page.QuorumPage

/*
    Lists, Loops, and Traversals - Lesson 17: Project - Hackathon Part 5.
    Converted from the old Lesson page by plan 13's generator: the same
    words, now without Tailwind.
*/
class CodeOrgUnit5Lesson17 is QuorumPage

    on create
        SetLocation("lessons/code/BuildingApps/Lesson17.html")
        // The name lists and links use, and the series and track it belongs
        // to: its section and picture.
        SetShortTitle("Project - Hackathon Part 5")
        SetSectionName("Lists, Loops, and Traversals")
        // For search engines and link previews, and what lists of pages say.
        SetDescription("Finish and submit your project")
        SetSummary("Project Day 5")
    end

    action Setup
        SetWebPageTitle("Unit 5 Lesson 17: Project - Hackathon Part 5")
        Title("Lists, Loops, and Traversals - Lesson 17: Project - Hackathon Part 5")
        Overview()
        GettingStarted0Minutes()
        Activity40Minutes()
        WrapUp5Minutes()
        AssessmentGradingTheProject()
        StandardsAlignment()
    end

    private action Overview
        Section("Overview")
        Paragraph("This is the final day of a five-day project. Students complete a Written Response, individually answering prompts about the project. Students then share their apps during a gallery walk.")
        Subsection("Goals")
        Paragraph("Students will be able to:")
        BulletList()
        ListItem("Complete a Written Response modeled after the Create PT")
        ListItem("Complete the Hackathon Project app")
        Subsection("Purpose")
        Paragraph("Students will demonstrate their app design and programming skills throughout this five day project. In addition, students work with a dataset as this ensures students will be using the types of programming constructs required for the Create Performance Task, which this project is designed as a practice for. Students complete the project by individually filling out a Written Response, modeled after the Create PT.")
        Paragraph("This project can be used as a unit project, or as an end cap to the first semester of the course.")
        Subsection("Resources")
        BulletList()
        ListItem():Link("CSP-Widgets repository", "https://github.com/qorf/CSP-Widgets")
        ListItem():Link("CSP Unit 5 Hackathon Project - Written Response", "https://docs.google.com/document/d/1DN78RvCqq_mlTh9VLsBberQQV4xctby5PU6N4LLhDcU/edit?usp=sharing")
        ListItem():Link("CSP Unit 5 Hackathon Project - Planning Guide", "https://docs.google.com/document/d/1Hc8LF0AsiPK_JyRaieKC6Kint6savoassU4ncz6GuTc/edit?usp=sharing")
        ListItem():Link("CSP Unit 5 Hackathon Submission on AP Classroom - Teacher Resource", "https://docs.google.com/document/d/1_wObV2_1G7RiHpzBrdl63QHJyZqNyzW7CVqlFEJi2LA/edit?usp=sharing")
    end

    private action GettingStarted0Minutes
        Section("Getting Started (0 minutes)")
        Paragraph():Strong("Do This:"):Text(" Move quickly to the activity portion of the lesson.")
    end

    private action Activity40Minutes
        Section("Activity (40 minutes)")
        Subsection("Written Response")
        Paragraph():Strong("Note:"):Text(" The Written Response is to be completed individually. From this point on, partners should not discuss anything about their project.")
        Paragraph():Strong("On your individual computer: "):Text("One tab with the project and one tab with the Written Response.")
        TeachingTip()
        Paragraph("The Written Response portion of this project is a modified, short version of the Create Performance Task students will turn in to the College Board for the AP Exam. To have your students practice submitting this project using a similar interface to the Create Performance Task, see the "):Link("CSP Unit 5 Hackathon Submission on AP Classroom - Teacher Resource", "https://docs.google.com/document/d/1_wObV2_1G7RiHpzBrdl63QHJyZqNyzW7CVqlFEJi2LA/edit?usp=sharing"):Text(" for instructions on how to set up an assessment on AP Classroom.")
        EndCallout()
        Paragraph():Strong("Do This:"):Text(" All students individually open their projects. They should also separately open the written response. Make sure both members of each group individually have access to their project.")
        TeachingTip()
        Paragraph("Programmers should share the project link with the designers. Designers open the project, then click View Code, which is located on the top right of the screen.")
        EndCallout()
        Subsection("Remarks")
        BulletList()
        ListItem("On your Written Response, you will need to insert screenshots of code segments. What's a code segment? It's a collection of program statements that are part of a program. Together, they demonstrate some working part of your program. You can use screenshots of text or blocks for your code segments.")
        TeachingTip()
        Paragraph("Students may struggle with the prompt on managing complexity. Encourage students to think how the program would be written differently if no lists could be used. In most cases, this would involve a large amount of variables. Students need to be specific and explain what these variables would store.")
        EndCallout()
        Paragraph():Strong("Do This (30 mins):"):Text(" Students work silently to complete the Written Response. Students will need to take screenshots of code and insert those screenshots into the appropriate boxes in the Written Response. At your discretion, you may also allow students to copy/paste code segments into the boxes. Students can check the Scoring Guidelines in the Planning Guide to make sure they are meeting all the requirements.")
        Paragraph():Strong("Submit:"):Text(" Students submit their project (one per group), Planning Guide (one per group), and Written Response (individual).")
        Paragraph():Strong("Share:"):Text(" Now students display their projects on a computer and complete a gallery walk. If you decide to have a winner of the hackathon, students can vote on their favorite projects by writing down the name of the project on a sticky note and passing it in.")
    end

    private action WrapUp5Minutes
        Section("Wrap Up (5 minutes)")
        TeachingTip()
        Paragraph("Feel free to skip the announcement of a hackathon winner if you want to keep the project non-competitive.")
        EndCallout()
        Subsection("Remarks")
        BulletList()
        ListItem("Great work everyone on the Hackathon Project! It's amazing how much you were able to accomplish in a short amount of time.")
        ListItem("And now, the moment that everyone has been waiting for. I have tallied up the votes and the winner is...")
    end

    private action AssessmentGradingTheProject
        Section("Assessment: Grading the Project")
        Paragraph():Strong("Project:"):Text(" Use the Scoring Guidelines on the final page of the Planning Guide to assess student projects. The Written Response portion is individual, while the Overall Project portion is a group grade.")
    end

    private action StandardsAlignment
        Section("Standards Alignment")
        BulletList()
        ListItem():Strong("CSTA K-12 Computer Science Standards (2017): "):Text("3A-AP-14, 3A-AP-22, 3A-AP-23")
        ListItem():Strong("CSP2021: "):Text("CRD-2.B.2")
    end
end
