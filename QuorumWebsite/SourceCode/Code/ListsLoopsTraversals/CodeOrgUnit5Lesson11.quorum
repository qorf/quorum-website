use Libraries.Web.Page.QuorumPage

/*
    Lists, Loops, and Traversals - Lesson 11: Traversals Practice.
    Converted from the old Lesson page by plan 13's generator: the same
    words, now without Tailwind.
*/
class CodeOrgUnit5Lesson11 is QuorumPage

    on create
        SetLocation("lessons/code/BuildingApps/Lesson11.html")
        // The name lists and links use, and the series and track it belongs
        // to: its section and picture.
        SetShortTitle("Traversals Practice")
        SetSectionName("Lists, Loops, and Traversals")
        // For search engines and link previews, and what lists of pages say.
        SetDescription("Practice using traversals and traversal patterns")
        SetSummary("Practice using traversals")
    end

    action Setup
        SetWebPageTitle("Unit 5 Lesson 11: Traversals Practice")
        Title("Lists, Loops, and Traversals - Lesson 11: Traversals Practice")
        Overview()
        GettingStarted2Minutes()
        Activity38Minutes()
        WrapUp5Minutes()
        AssessmentCheckForUnderstandingAPPractice()
        StandardsAlignment()
    end

    private action Overview
        Section("Overview")
        Paragraph("Students practice traversing lists, filtering and reducing lists, and using the data import tools. Along the way students develop debugging practices with traversals.")
        Subsection("Goals")
        Paragraph("Students will be able to:")
        BulletList()
        ListItem("Write programs that use list traversals, including the filter and reduce patterns, with the support of sample code")
        ListItem("Debug programs that use list traversals")
        Subsection("Resources")
        BulletList()
        ListItem():Link("CSP-Widgets repository", "https://github.com/qorf/CSP-Widgets")
        Subsection("Purpose")
        Paragraph("This lesson is students primary opportunity to get hands on with lists in code prior to the Make activity in the following lesson. Give students as much class time as you can to work through these. For this lesson it's recommended that you place students in pairs as a support and to encourage discussion about the challenges or concepts they're seeing.")
    end

    private action GettingStarted2Minutes
        Section("Getting Started (2 minutes)")
        Subsection("Remarks")
        BulletList()
        ListItem("Today we're going to have a chance to practice programming with a lot of the concepts and patterns we've explored over the last two lessons. I encourage you to go through these with a partner, but pay close attention to what each other is doing. In our next lesson you're going to have to use a lot of these on an independent project, and these activities are good practice for what you'll find there! Alright, let's get to it!")
        TeachingTip()
        Paragraph():Strong("Move Quickly to the Activity:"):Text(" There's a lot in the main activity of today's lesson. You may optionally wish to do a quick vocabulary review or address any questions that came up in the last lesson. Otherwise, give students more time to get hands on with some code.")
        EndCallout()
    end

    private action Activity38Minutes
        Section("Activity (38 minutes)")
        Subsection("Practice Time")
        Paragraph():Strong("Group:"):Text(" It is recommended that students work in pairs for this lesson and a number of the activities feature discussion prompts. Consider using pair programming, having drivers and navigators switch every 3 minutes, not every project.")
        Subsubsection("Remarks")
        BulletList()
        ListItem("Today you're mostly going to practice what we've learned about programming with traversals. I'm here to help you when you need. However, I first want to remind you of the following:")
        NestedBulletList()
        ListItem("Use your debugging skills. Try to zoom in on precisely where you're getting stuck.")
        ListItem("Talk to your partner! That's what they're there for!")
        ListItem("Hover over blocks to read the documentation about how they work.")
        ListItem("Read the resources in the Help & Tips tab")
        ListItem("Talk to the group next to you. If another group asks for help make sure to take some time to talk it through with them.")
        EndNestedList()
        ListItem("We can debug traversals by using many skills that helped us with lists, like using output statements. Another important new debugging skill will be to actually go look at your data in the original data file. Use output to make sure you're successfully getting the data you want.")
        Subsection("Traversal Practice")
        Paragraph():Strong("Open a Project:"):Text(" Today's lesson has students investigate 7 different apps. Direct students to begin with "):Strong("Lesson11_App1"):Text(".")
        Paragraph():Strong("Apps 1-3 Traversal Practice:"):Text(" These apps have students perform simple traversals over lists that are created inside their code (not by importing data from a file). In each program sample code is provided which students can use to help writing the code of their own.")
        BulletList()
        ListItem("App 1: traverse over a list and output every element")
        ListItem("App 2: traverse over a list and output every element and its position")
        ListItem("App 3: traverse over two parallel lists and print elements from both")
        TeachingTip()
        Paragraph():Strong("Providing Support:"):Text(" Circulate around the room through the lesson encouraging students to use the strategies introduced at the beginning of the lesson. Students have a number of supports at their fingertips, so a big part of your role is helping build their independence in using those resources.")
        EndCallout()
        Subsection("Reduce and Filter Practice")
        Paragraph():Strong("Apps 4-6 Reduce and Filter Practice:"):Text(" Students practice the reduce and filter patterns introduced in the previous lesson. In each program sample code is provided which students can use to help writing the code of their own.")
        BulletList()
        ListItem("App 4: filter a list of students to keep only those with more than 6 letters in their names.")
        ListItem("App 5: reduce a list to find the maximum price inside of it.")
        ListItem("App 6: filter a list of countries to find those in the Central America region. This program makes use of the data import tools.This program makes use of an imported data file.")
        Subsection("App Practice")
        Paragraph():Strong("App 7 App Practice:"):Text(" In this level, students use the reduce pattern to finish building an app.")
        BulletList()
        ListItem("App 7: Write code for the "):DoubleQuote():Text("reduce"):DoubleQuote():Text(" pattern to calculate a student's average grade")
        ListItem("App 8: Write code to calculate and display the percent of each type of Air Quality Index day.")
    end

    private action WrapUp5Minutes
        Section("Wrap Up (5 minutes)")
        Subsection("Synthesizing Discussion")
        Paragraph():Strong("Prompt:"):Text(" What aspects of working with traversals do you feel like clicked today? What do you still feel like you have trouble with?")
        DiscussionGoal()
        Paragraph("Use this opportunity to address any lingering questions or misconceptions in the room. You can also use this as a source of discussion topics to kick off the following lesson. As you lead the discussion, call out the many resources students have access to help when they're getting stuck.")
        EndCallout()
        Paragraph():Strong("Discuss:"):Text(" Have students share with one another before sharing with the whole class.")
        Subsubsection("Remarks")
        BulletList()
        ListItem("Working with traversals can be tricky. We will get more practice tomorrow by making an app that uses traversals and the data tools.")
    end

    private action AssessmentCheckForUnderstandingAPPractice
        Section("Assessment: Check for Understanding - AP Practice")
        Subsection("For Students")
        Paragraph("Open a word doc or google doc and copy/paste the following question.")
        Subsection("Question")
        Paragraph("What are the values stored in "):Code("studentScores"):Text(" array after running this code snippet?")
        CodeExample("studentScores <- [77, 32, 45, 92, 86]

FOR EACH item IN studentScores
{
    IF (item > 60)
    {
        item <- item + 5
    }
    ELSE
    {
        item <- 0
    }
}")
    end

    private action StandardsAlignment
        Section("Standards Alignment")
        BulletList()
        ListItem():Strong("CSTA K-12 Computer Science Standards (2017): "):Text("3A-AP-14, 3B-AP-10")
        ListItem():Strong("CSP2021: "):Text("AAP-2.O.3")
    end
end
