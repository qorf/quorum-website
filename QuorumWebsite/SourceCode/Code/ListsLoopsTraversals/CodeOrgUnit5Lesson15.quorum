use Libraries.Web.Page.QuorumPage

/*
    Lists, Loops, and Traversals - Lesson 15: Hackathon - Project Part 3.
    Converted from the old Lesson page by plan 13's generator: the same
    words, now without Tailwind.
*/
class CodeOrgUnit5Lesson15 is QuorumPage

    on create
        SetLocation("lessons/code/BuildingApps/Lesson15.html")
        // The name lists and links use, and the series and track it belongs
        // to: its section and picture.
        SetShortTitle("Project - Hackathon Part 3")
        SetSectionName("Lists, Loops, and Traversals")
        // For search engines and link previews, and what lists of pages say.
        SetDescription("Continue developing the project app")
        SetSummary("Project Day 3")
    end

    action Setup
        SetWebPageTitle("Unit 5 Lesson 15: Hackathon - Project Part 3")
        Title("Lists, Loops, and Traversals - Lesson 15: Hackathon - Project Part 3")
        Overview()
        GettingStarted0Minutes()
        Activity40Minutes()
        WrapUp5Minutes()
        AssessmentOptional()
        StandardsAlignment()
    end

    private action Overview
        Section("Overview")
        Paragraph("This is the third day of a five-day unit project. Students continue to build their apps.")
        Subsection("Goals")
        Paragraph("Students will be able to:")
        BulletList()
        ListItem("Translate a paper prototype to screens")
        ListItem("Continue programming an app which uses a database")
        Subsection("Purpose")
        Paragraph("Students will demonstrate their app design and programming skills throughout this five day project. In addition, students work with a dataset as this ensures students will be using the types of programming constructs required for the Create Performance Task, which this project is designed as a practice for. Students complete the project by individually filling out a Written Response, modeled after the Create PT.")
        Paragraph("This project can be used as a unit project, or as an end cap to the first semester of the course.")
        Subsection("Resources")
        BulletList()
        ListItem():Link("CSP-Widgets repository", "https://github.com/qorf/CSP-Widgets")
        ListItem():Link("CSP Unit 5 Hackathon Project - Planning Guide", "https://docs.google.com/document/d/1Hc8LF0AsiPK_JyRaieKC6Kint6savoassU4ncz6GuTc/edit?usp=sharing")
    end

    private action GettingStarted0Minutes
        Section("Getting Started (0 minutes)")
        Paragraph():Strong("Do This:"):Text(" Move quickly to the activity portion of the lesson.")
    end

    private action Activity40Minutes
        Section("Activity (40 minutes)")
        Subsection("Hackathon Project")
        TeachingTip()
        Paragraph("Encourage students to check the rubric on the last page of the Planning Guide as they work through building their app. The Written Response portion will be completed on the last day of the project.")
        EndCallout()
        Paragraph():Strong("Step 6 (continued):"):Text(" Students work on building their apps, guided by their roles.")
        BulletList()
        ListItem("Programmers: Use the table to guide you in adding programming statements to your project.")
        ListItem("Designers: Use the chart to guide you in adding screen elements to your program. You can work on a separate computer from your partner.")
        TeachingTip()
        Paragraph("If the designer finishes their screens early, they can start pair programming with the programmer.")
        EndCallout()
        Paragraph():Strong("Do This:"):Text(" When the designer is ready to share their screens with the programmer, there are specific steps that must be followed after the designer clicks share and copies the link to their app. The programmer:")
        NumberedList()
        ListItem("Programmer: Add a blank screen")
        ListItem("Programmer: Delete the old project screens.")
        ListItem("Programmer: Click the screen dropdown, then click "):DoubleQuote():Text("Import screen"):DoubleQuote()
        ListItem("Designer: Click to share your project. Copy the link and send to the Programmer")
        ListItem("Programmer: Paste in the link from the designer.")
        ListItem("Programmer: Select to import all of the screens.")
        ListItem("Delete the blank screen.")
        ListItem("Set the home screen to be the default screen (Hint: Go to design mode and click on the screen)")
    end

    private action WrapUp5Minutes
        Section("Wrap Up (5 minutes)")
        Paragraph():Strong("Do This:"):Text(" Take some time to answer student questions.")
        Paragraph():Strong("Planning Guide:"):Text(" As an optional completion assessment, you can look at the table in Step 4 of the Planning Guide.")
    end

    private action AssessmentOptional
        Section("Assessment: Optional")
    end

    private action StandardsAlignment
        Section("Standards Alignment")
        BulletList()
        ListItem():Strong("CSTA K-12 Computer Science Standards (2017): "):Text("3A-AP-14, 3A-AP-22, 3A-AP-23")
    end
end
