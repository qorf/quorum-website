use Libraries.Web.Page.QuorumPage

/*
    Lists, Loops, and Traversals - Lesson 6: Loops Investigate.
    Converted from the old Lesson page by plan 13's generator: the same
    words, now without Tailwind.
*/
class CodeOrgUnit5Lesson6 is QuorumPage
    // A double quote, for code and words that hold one.
    text dq = ""

    on create
        SetLocation("lessons/code/BuildingApps/Lesson6.html")
        // The name lists and links use, and the series and track it belongs
        // to: its section and picture.
        SetShortTitle("Loops Investigate")
        SetSectionName("Lists, Loops, and Traversals")
        // For search engines and link previews, and what lists of pages say.
        SetDescription("Investigate how loops can be used for simulation and modifying elements in an app")
        SetSummary("Investigate how loops are used")
    end

    action Setup
        dq = dq:GetDoubleQuote()
        SetWebPageTitle("Unit 5 Lesson 6: Loops Investigate")
        Title("Lists, Loops, and Traversals - Lesson 6: Loops Investigate")
        Overview()
        GettingStarted5Minutes()
        Activity35Minutes()
        WrapUp5Minutes()
        AssessmentCheckForUnderstanding()
        StandardsAlignment()
    end

    private action Overview
        Section("Overview")
        Paragraph("Students practice using the for loop in order to repeatedly run pieces of code. The lesson begins with a quick investigation of an app that flips coins. After that code investigation students complete another investigation with an app that uses loops to update screen elements.")
        Subsection("Goals")
        Paragraph("Students will be able to:")
        BulletList()
        ListItem("Read programs that use loops")
        ListItem("Understand the parts of a loop")
        ListItem("Update the Boolean expression in a for loop to change how many times the loop runs")
        Subsection("Purpose")
        Paragraph("This lesson is students primary opportunity to get hands on with loops in code prior to the Practice activity in the following lesson. Give students as much class time as you can to work through these. For this lesson it's recommended that you place students in pairs as a support and to encourage discussion about the challenges or concepts they're seeing.")
        Subsection("Resources")
        BulletList()
        ListItem():Link("CSP-Widgets repository", "https://github.com/qorf/CSP-Widgets")
    end

    private action GettingStarted5Minutes
        Section("Getting Started (5 minutes)")
        Paragraph():Strong("Prompt:"):Text(" Imagine you are interested in finding out how much time it takes on average to walk from one end of your school to the next. You've decided to figure this out on your lunch break, and are able to complete the walk 20 times. What would your algorithm look like? Where could a loop show up? ("):Strong("Note:"):Text(" You do not need to write your algorithm in a programming language. You can write it out in English or in pseudocode.)")
        Paragraph():Strong("Discuss:"):Text(" Compare your algorithms with a partner and then discuss as a class.")
        DiscussionGoal()
        Paragraph("The point of this activity is for students to see the need for a loop. Algorithms might look something like this:")
        BulletList()
        ListItem("Repeat 20 times:")
        NestedBulletList()
        ListItem("Stand at the entry doors to the school.")
        ListItem("Start the timer.")
        ListItem("Walk at a steady pace to the end of the hallway.")
        ListItem("Turn off the timer.")
        ListItem("Record the time in a notebook.")
        ListItem("Walk back to the entry doors.")
        EndNestedList()
        ListItem("Add all times together.")
        ListItem("Divide by 20 to find the average.")
        EndCallout()
        Subsection("Remarks")
        BulletList()
        ListItem("A loop helps simplify code. Let's investigate how this looks in two different apps.")
    end

    private action Activity35Minutes
        Section("Activity (35 minutes)")
        TeachingTip()
        Paragraph("For this lesson, there are two separate investigations of two different apps. Lead the class through discussions, and circulate around the classroom as students work.")
        Paragraph("As time allows, encourage students to do the Modify tasks for each level. This will give students extra practice.")
        EndCallout()
        Paragraph():Strong("Prompt:"):Text(" The first app we are going to investigate uses a loop in a simulation. What is a simulation? Why are they useful?")
        DiscussionGoal()
        Paragraph("Simulations allow us to test solutions or run experiments in a way that is usually cheaper, safer, and often times faster. Simulations are models of the real world that allow the user to investigate hypotheses and draw conclusions. Oftentimes they involve inputting various sets of data or values to demonstrate the changing state of a phenomenon.")
        EndCallout()
        Subsection("Remarks")
        BulletList()
        ListItem("Thanks for sharing your thoughts on simulations! Other examples of simulations are flight simulators which allows you to practice flying without damaging yourself or a real plane or a city building game where you can play with tweaking multiple values in the economy without real consequences.")
        ListItem("These examples demonstrate the process of developing an abstract simulation where the specific details have been removed, or the functionality simplified.")
        ListItem("While simulations are a useful way to model the real-world, we also need to be constantly on the lookout for bias in the real-world elements that are actually included in the simulation.")
        ListItem("Today, we are going to look at a simple simulation.")
        ListItem("Simulations can be helpful to run when it would take a long time or it would be too impractical to do something physically. For example, what if we wanted to see the results of a coin flip that we flipped a million times? That would take a long time to perform ourselves, but a computer can run that simulation much quicker. Let's look at an app that does just that.")
        Paragraph():Strong("Group:"):Text(" Place students in pairs.")
        Paragraph():Strong("Open a Project:"):Text(" Students will investigate two apps for today's lesson. Direct students to begin with Lesson6_App1 in the Unit5 folder of the CSP-Widgets repository.")
        Paragraph():Strong("Project 1, Part 1 - Coin Flipper App (App Investigation):"):Text(" This code investigation includes a number of steps to help students get familiar with a new app. Students run the app and discuss the following:")
        BulletList()
        ListItem("What information does the user input?")
        ListItem("How does the app process that information?")
        NestedBulletList()
        ListItem("What is being repeated?")
        ListItem("Where is there an opportunity to use a loop?")
        EndNestedList()
        ListItem("What information does the app output?")
        Paragraph():Strong("Project 1, Part 2 - Coin Flipper App (Code Investigation):"):Text(" Students carefully read each individual part of the program before discussing the following:")
        BulletList()
        ListItem("On what lines of code is the program using a loop?")
        ListItem("Which lines of code decide how many times to flip the coin?")
        ListItem("What does the ++ command seem to do?")
        Paragraph():Strong("Prompt:"):Text(" How does a loop help when running similar simulations?")
        DiscussionGoal()
        Paragraph("A loop lets us repeat code quickly to determine an answer to a question.")
        Paragraph("Inside the loop we can use random number generation to get a variety of possible answers, similar to what would happen in the real world.")
        EndCallout()
        BulletList()
        ListItem("Now let's investigate an app that uses loops in a different way. This time loops are used to update elements on the screen.")
        Paragraph():Strong("Level 3 Project 2 - Label Tester App:"):Text(" Students open the second project and run the app before discussing the following:")
        BulletList()
        ListItem("Find the four different for loops in the program. What do they each do?")
        ListItem("Also take a look at the names of the screen elements in Design Mode. Then navigate back to the code. How is "):Code(dq + "text " + dq + " + i"):Text(" used? How does it evaluate with each round of the loop?")
        DiscussionGoal()
        Paragraph("This is a way of doing something to a set of elements. In this case, we have five text boxes named"):Code("text0"):Text(","):Code("text1"):Text(","):Code("text2"):Text(","):Code("text3"):Text(","):Code("text4")
        BulletList()
        ListItem():Code("text + i"):Text(" is evaluated each round of the loop.")
        NestedBulletList()
        ListItem("First Round: "):Code("text0")
        ListItem("Second Round: "):Code("text1")
        ListItem("Third Round: "):Code("text2")
        ListItem("Fourth Round: "):Code("text3")
        ListItem("Fifth Round: "):Code("text4")
        EndNestedList()
        ListItem("So when the first round of the loop is executed, the element with the "):Code("text0"):Text(" ID is changed to whatever information is in the for loop.")
        EndCallout()
        Subsection("Do This")
        BulletList()
        ListItem("What happens if you change the label variable names?")
        ListItem("What happens if you change the label variable names? Try changing them from "):Code("text0"):Text(", "):Code("text1"):Text(", etc. to "):Code("textbox0"):Text(", "):Code("textbox1"):Text(", etc.")
        ListItem("What do you need to change in the code for the program to still work?")
        Subsection("Do This")
        BulletList()
        ListItem("What happens if you change the Boolean expression "):Code("i < 5"):Text(" in the loop?")
        ListItem("Change all the Boolean expressions to one of the options below, run the program, and discuss. Then move to the next option and repeat:")
        NestedBulletList()
        ListItem():Code("i < 4")
        ListItem():Code("i < 3")
        ListItem():Code("i <= 4")
        EndNestedList()
    end

    private action WrapUp5Minutes
        Section("Wrap Up (5 minutes)")
        Subsection("Remarks")
        BulletList()
        ListItem("Let's review the parts of a loop.")
        Paragraph():Strong("Prompt:"):Text(" What aspects of working with loops do you feel like clicked today? What do you still feel like you have trouble with?")
        Paragraph():Strong("Discuss:"):Text(" Have students share with one another before sharing with the whole class.")
        DiscussionGoal()
        Paragraph("Use this opportunity to address any lingering questions or misconceptions in the room. You can also use this as a source of discussion topics to kick off the following lesson. As you lead the discussion, call out the many resources students have access to help when they're getting stuck.")
        EndCallout()
        BulletList()
        ListItem("Working with loops can be a little tricky. We'll have more opportunities to practice combining loops and lists together to make even more powerful apps.")
    end

    private action AssessmentCheckForUnderstanding
        Section("Assessment: Check for Understanding")
        Subsection("For Students")
        Paragraph("Open a word doc or google doc and copy/paste the following question.")
        Subsection("Question")
        Paragraph("Think back on the Label Tester app. Can you think of an example of another app or feature of an app which would use a loop to control different elements on a screen?")
    end

    private action StandardsAlignment
        Section("Standards Alignment")
        BulletList()
        ListItem():Strong("CSTA K-12 Computer Science Standards (2017): "):Text("3A-AP-15, 3A-AP-23, 3A-DA-12")
        ListItem():Strong("CSP2021: "):Text("AAP-3.F.1, AAP-3.F.2, AAP-3.F.3, AAP-3.F.4, AAP-3.F.5, AAP-3.F.6, AAP-3.F.7, AAP-3.F.8")
    end
end
