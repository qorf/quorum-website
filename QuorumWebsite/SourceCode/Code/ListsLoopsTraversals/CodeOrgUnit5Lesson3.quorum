use Libraries.Web.Page.QuorumPage

/*
    Lists, Loops, and Traversals - Lesson 3: Lists Practice.
    Converted from the old Lesson page by plan 13's generator: the same
    words, now without Tailwind.
*/
class CodeOrgUnit5Lesson3 is QuorumPage
    // A double quote, for code and words that hold one.
    text dq = ""

    on create
        SetLocation("lessons/code/BuildingApps/Lesson3.html")
        // The name lists and links use, and the series and track it belongs
        // to: its section and picture.
        SetShortTitle("Lists Practice")
        SetSectionName("Lists, Loops, and Traversals")
        // For search engines and link previews, and what lists of pages say.
        SetDescription("Practice writing and debugging apps with lists")
        SetSummary("Practice using lists")
    end

    action Setup
        dq = dq:GetDoubleQuote()
        SetWebPageTitle("Unit 5 Lesson 3: Lists Practice")
        Title("Lists, Loops, and Traversals - Lesson 3: Lists Practice")
        Overview()
        GettingStarted5Minutes()
        Activity35Minutes()
        WrapUp5Minutes()
        AssessmentCheckForUnderstandingAPPractice()
        StandardsAlignment()
    end

    private action Overview
        Section("Overview")
        Paragraph("Practice the basics of lists including creating lists and accessing, inserting, and removing elements from lists.")
        Subsection("Goals")
        Paragraph("Students will be able to:")
        BulletList()
        ListItem("Correctly set up a list in a program")
        ListItem("Debug programs with lists")
        ListItem("Accurately use list operations including accessing, inserting, and removing elements")
        Subsection("Purpose")
        Paragraph("This lesson is students primary opportunity to get hands on with lists in code prior to the Make activity in the following lesson. Give students as much class time as you can to work through these. For this lesson it's recommended that you place students in pairs as a support and to encourage discussion about the challenges or concepts they're seeing.")
        Subsection("Resources")
        Paragraph("For the students")
        BulletList()
        ListItem():Link("CSP-Widgets repository", "https://github.com/qorf/CSP-Widgets")
    end

    private action GettingStarted5Minutes
        Section("Getting Started (5 minutes)")
        Paragraph():Strong("Do This:"):Text(" Run a quick vocabulary review with students.")
        BulletList()
        ListItem():Strong("List"):Text(" - an ordered collection of elements")
        ListItem():Strong("Element"):Text(" - an individual value in a list that is assigned a unique index")
        ListItem():Strong("Index"):Text(" - a common method for referencing the elements in a list or string using numbers")
        Subsection("Remarks")
        BulletList()
        ListItem("Today we're going to have a chance to practice programming with a lot of the concepts and patterns we've explored over the last two lessons. I encourage you to go through these with a partner, but pay close attention to what each other is doing. In our next lesson you're going to have to use a lot of these on an independent project, and these activities are good practice for what you'll find there! Alright, let's get to it!")
    end

    private action Activity35Minutes
        Section("Activity (35 minutes)")
        Subsection("Practice Time")
        TeachingTip()
        Paragraph():Strong("Providing Support:"):Text(" Circulate around the room through the lesson encouraging students to use the strategies introduced at the beginning of the lesson. Students have a number of supports at their fingertips, so a big part of your role is helping build their independence in using those resources.")
        Paragraph():Strong("Common Errors:"):Text(" The following are common errors students may encounter in this lesson:")
        BulletList()
        ListItem("The last index in an array is at "):Code("array:GetSize() - 1"):Text(" because the first index is 0. One of the most common errors with arrays, therefore, is trying to access indexes that are out of bounds, most notably "):Code("array:GetSize()"):Text(".")
        ListItem("Syntax errors are common with arrays because the syntax is new. In particular, students might be confused how the "):Code("Add"):Text(" command can accept different inputs to add to the end or the middle of a list.")
        ListItem("When using the patterns students may become overly reliant on simply copying and pasting without thinking through what the code from the patterns does. They may reference variables that don't exist in their program, for example, because it is in the example code of the pattern.")
        EndCallout()
        Paragraph():Strong("Display:"):Text(" Remind students of the debugging process, including some of these important skills:")
        BulletList()
        ListItem("Try to zoom in on precisely where you're getting stuck.")
        ListItem("Talk to your partner! That's what they're there for!")
        ListItem("Talk to the group next to you. If another group asks for help make sure to take some time to talk it through with them.")
        Paragraph():Strong("Display:"):Text(" Highlight important debugging skills specifically for lists including ways to use the Watch panel and the Debug Console with lists.")
        Paragraph():Strong("Display:"):Text(" Quickly introduce the fact that strings have indexes too. Students will see "):Code("text:GetSize()"):Text(" and "):Code("text:GetSubtext(start, end)"):Text(" during the lesson so this is just calling out a concept that students will need to recognize when they get to it. You may optionally use slide 46 from "):Link("CSP Unit 5 Presentation Slides", "https://docs.google.com/presentation/d/1qQPTgZxJnYZRl-9Do2UB_hM882QtouLclWfCsw8jDBw/copy"):Text(" to present this information. While the slide uses Javascript instead of Quorum, the concept is the same in both languages.")
        Paragraph():Strong("Open a Project:"):Text(" Students will be using a number of projects to practice today. Direct students to begin with "):Strong("Lesson3_App1"):Text(" of Unit 5 in the CSP-Widgets repository.")
        Paragraph():Strong("Apps 1-2 Setting Up Lists:"):Text(" These levels involve setting up a list and printing the list to the console.")
        BulletList()
        ListItem("Level 1 App 1: A list of numbers")
        ListItem("Level 2 App 2: A list of strings")
        Paragraph():Strong("Apps 3-5 Accessing Elements in a List:"):Text(" Students practice accessing elements in a list using the index. These levels also practice the random list access and list scrolling pattern students saw in the Investigate lesson.")
        BulletList()
        ListItem("Level 3 App 3: Students practice printing specific elements to the console using the "):Code("Get(index)"):Text(" command.")
        ListItem("Level 4 App 4: Students build a "):DoubleQuote():Text("Magic 8 Ball"):DoubleQuote():Text(" app that uses the Random List Access pattern.")
        ListItem("Level 5 App 5: Students build a "):DoubleQuote():Text("Class Schedule"):DoubleQuote():Text(" app that uses the List Scrolling pattern.")
        TeachingTip()
        BulletList()
        ListItem("App 5: Ask students to add the ability to add new classes to the list in the Class Schedule app.")
        ListItem("App 10: Ask students to add the ability to remove items in the Food Diary app.")
        ListItem("App 11: Ask students to add a button that will "):DoubleQuote():Text("Undo"):DoubleQuote():Text(" adding the most recent song to the list. This is pretty tricky and requires keeping track of some new information.")
        EndCallout()
        Paragraph():Strong("Extension activities")
        Paragraph():Strong("App 6-7 Strings and Indexes:"):Text(" Students practice accessing characters in a string.")
        BulletList()
        ListItem("Level 6 App 6: Students practice printing the length and first characters of strings.")
        ListItem("Level 7 App 7: Students debug code that uses "):Code("text:GetSubtext(start, end)"):Text(" to grab different parts of a date stored as a string.")
        Paragraph():Strong("Apps 8-11 List Operations:"):Text(" In these levels, students work with list operations: "):Code("Add(element)"):Text(", "):Code("RemoveAt(index)"):Text(", and "):Code("Add(index, element)"):Text(".")
        BulletList()
        ListItem("Level 8 App 8: Students practice using "):Code("Add(element)"):Text(" to increase the size of a list.")
        ListItem("Level 9 App 9: Students modify a "):DoubleQuote():Text("Food Diary"):DoubleQuote():Text(" app so that the user can add new elements to a list.")
        ListItem("Level 10 App 10: Students practice using "):Code("RemoveAt(index)"):Text(" and "):Code("Add(index, element)"):Text(" to modify lists.")
        ListItem("Level 11 App 11: Students modify a "):DoubleQuote():Text("Top Ten Songs"):DoubleQuote():Text(" app so that the user can add new items into the middle of a list while keeping the total length of the list to 10.")
    end

    private action WrapUp5Minutes
        Section("Wrap up (5 Minutes)")
        Subsection("Discussion")
        Paragraph():Strong("Prompt:"):Text(" What aspects of working with lists do you feel like clicked today? What do you still feel like you have trouble with?")
        Paragraph():Strong("Discuss:"):Text(" Have students share with one another before sharing with the whole class.")
        Paragraph():Strong("Goal:"):Text(" Use this opportunity to address any lingering questions or misconceptions in the room. You can also use this as a source of discussion topics to kick off the following lesson. As you lead the discussion, call out the many resources students have access to help when they're getting stuck.")
        Subsection("Remarks")
        BulletList()
        ListItem("Working with lists can be tricky - especially working with the index. We will get more practice tomorrow by making an app that uses lists to store information.")
        CodeExample("gems <- [" + dq + "ruby" + dq + ", " + dq + "sapphire" + dq + ", " + dq + "garnet" + dq + "]
gems <- [" + dq + "opal" + dq + ", " + dq + "emerald" + dq + "]
DISPLAY(gems[1])")
        CodeExample("luckyNumbers <- [15, 33, 25]
INSERT(luckyNumbers, 2, 13)
APPEND(luckyNumbers, 3)
REMOVE(luckyNumbers, 1)
DISPLAY(LENGTH(luckyNumbers))")
    end

    private action AssessmentCheckForUnderstandingAPPractice
        Section("Assessment: Check for Understanding - AP Practice")
        Paragraph("Check For Understanding Question(s) and solutions can be found in each lesson on Code Studio. These questions can be used for an exit ticket.")
        Subsection("For Students")
        Paragraph("Open a word doc or google doc and copy/paste the following question.")
        Subsection("Question 1")
        Paragraph("What will be displayed after this code snippet is run?")
        Subsection("Question 2")
        Paragraph("What will be displayed after this code snippet is run?")
    end

    private action StandardsAlignment
        Section("Standards Alignment")
        BulletList()
        ListItem():Strong("CSTA K-12 Computer Science Standards (2017): "):Text("3A-AP-14")
        ListItem():Strong("CSP2021: "):Text("AAP-1.D.7, AAP-1.D.8")
        ListItem():Strong("CSP2021: "):Text("AAP-2.D.2")
        ListItem():Strong("CSP2021: "):Text("AAP-2.N.1, AAP-2.N.2")
        ListItem():Strong("CSP2021: "):Text("AAP-2.0.3")
    end
end
