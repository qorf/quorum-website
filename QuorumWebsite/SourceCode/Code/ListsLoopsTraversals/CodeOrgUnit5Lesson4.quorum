use Libraries.Web.Page.QuorumPage

/*
    Lists, Loops, and Traversals - Lesson 4: Lists Make.
    Converted from the old Lesson page by plan 13's generator: the same
    words, now without Tailwind.
*/
class CodeOrgUnit5Lesson4 is QuorumPage

    on create
        SetLocation("lessons/code/BuildingApps/Lesson4.html")
        // The name lists and links use, and the series and track it belongs
        // to: its section and picture.
        SetShortTitle("Lists Make")
        SetSectionName("Lists, Loops, and Traversals")
        // For search engines and link previews, and what lists of pages say.
        SetDescription("Make the Reminder App using lists")
        SetSummary("Use lists to make an app")
    end

    action Setup
        SetWebPageTitle("Unit 5 Lesson 4: Lists Make")
        Title("Lists, Loops, and Traversals - Lesson 4: Lists Make")
        Overview()
        GettingStarted5Minutes()
        Activity35Minutes()
        WrapUp10Minutes()
        AssessmentMakeProject()
        StandardsAlignment()
    end

    private action Overview
        Section("Overview")
        Paragraph("Using Programming Patterns and a step-by-step approach students make their own version of a Reminder app. At the beginning of the lesson students are able to explore a working version of the app. They are then given the design elements of the app but begin with a blank screen. Students use an Activity Guide to go through the high level steps they should use to develop their app but leaves it to them to decide how to write the code. At the end students submit their apps which can be assessed using a provided rubric.")
        Subsection("Goals")
        Paragraph("Students will be able to:")
        BulletList()
        ListItem("Recognize the need for programming patterns with lists as part of developing a functioning app")
        ListItem("Implement programming patterns with lists to develop a functioning app")
        ListItem("Write comments to clearly explain both the purpose and function of different segments of code within an app")
        ListItem("Use debugging skills as part of developing an app")
        Subsection("Purpose")
        Paragraph("This lesson is an opportunity for students to take on the "):DoubleQuote():Text("blank screen"):DoubleQuote():Text(" and build the code that runs an app entirely from scratch. Guidance provided throughout the lesson helps students break down the large task of "):DoubleQuote():Text("building an app"):DoubleQuote():Text("into more incremental steps that they can use on future projects, including this unit's final project and the Create PT.")
        Subsection("Resources")
        Paragraph("For the students")
        BulletList()
        ListItem():Link("CSP-Widgets repository", "https://github.com/qorf/CSP-Widgets")
        Subsubsection("Supplemental code.org material")
        BulletList()
        ListItem():Link("CSP Lists Make - Reminder App (Activity Guide)", "https://docs.google.com/document/d/1GlcxUvD-czBrwGGq70ZiiItOSB3R77s0JOSL2XvxecM/edit?usp=sharing")
    end

    private action GettingStarted5Minutes
        Section("Getting Started (5 minutes)")
        Paragraph():Strong("Prompt:"):Text(" Imagine you want to build an app for reminders. What information do you think would be stored in a list?")
        DiscussionGoal()
        Paragraph("Students may struggle with this question. It's ok if they don't get it right away. The goal is to prime their thinking before they look at the sample app.")
        EndCallout()
        Paragraph():Strong("Sample Answer:"):Text(" The reminders could be stored in a list.")
        Subsection("Remarks")
        BulletList()
        ListItem("For the past few days, we've learned a lot about using lists to help apps keep track of information. In today's Make Project you'll be practicing using lists and programming patterns with lists to create a functioning Reminders app.")
    end

    private action Activity35Minutes
        Section("Activity (35 minutes)")
        Subsection("Build the Reminder App")
        TeachingTip()
        Paragraph():Strong("Supporting Students:"):Text(" While students are working on their apps, circulate the room and check in with students who need a little help. Encourage students to collaborate and discuss bugs with each other.")
        Paragraph():Strong("Debugging:"):Text(" Review with students steps they can use to debug if they get stuck:")
        BulletList()
        ListItem("Run the code on turtle mode.")
        ListItem("Add the variables to the watcher.")
        ListItem("Explain the code to a friend.")
        EndCallout()
        Paragraph():Strong("Group:"):Text(" Make a determination as to whether this project will be completed in pairs or individually. You may even choose to let students decide.")
        Paragraph():Strong("Open a Project:"):Text(" Direct students to open the "):Strong("Lesson4_ExampleApp"):Text(" project in Unit 5 of the CSP Widgets repository.")
        Paragraph():Strong("Do This:"):Text(" Have students explore the working Reminder App. Add several reminders to the app. Scroll through your reminders.")
        Paragraph():Strong("Prompt:"):Text(" If students are not working in pairs they should still discuss the prompts with a neighbor.")
        DiscussionGoal()
        BulletList()
        ListItem("How many lists do you think are needed to make this app work?")
        NestedBulletList()
        ListItem("Only one list is needed. It stores all of the reminders.")
        EndNestedList()
        ListItem("What programming patterns with lists do you think you'll need to use?")
        NestedBulletList()
        ListItem("This app uses the List Scrolling pattern.")
        EndNestedList()
        EndCallout()
        Subsubsection("Remarks")
        BulletList()
        ListItem("Now let's build this app. The screen has been set up for you - it's your job to add the code!")
        Paragraph():Strong("Open a Project:"):Text(" Direct students to open the "):Strong("Lesson4_ProjectTemplate"):Text(" project in Unit 5 of the CSP Widgets repository.")
        Paragraph():Strong("Do This:"):Text(" Students should complete the Reminder App. An optional Activity Guide is provided if students would like guidance in creating the app. You may optionally choose to review the List Scrolling pattern quickly with students, if needed.")
        Paragraph():Strong("Submit:"):Text(" Encourage students to check the rubric on the last page of the Activity Guide before submitting.")
    end

    private action WrapUp10Minutes
        Section("Wrap Up (10 minutes)")
        TeachingTip()
        Paragraph():Strong("Maximize Work Time:"):Text(" The wrap up is short to allow the maximum amount of time for students to complete the activity.")
        EndCallout()
        Subsection("Remarks")
        BulletList()
        ListItem("Awesome work today! Make sure to submit your project when you're done with it!")
    end

    private action AssessmentMakeProject
        Section("Assessment: Make Project")
        Paragraph("Use the rubric provided on the last page of the Activity Guide to assess student projects.")
    end

    private action StandardsAlignment
        Section("Standards Alignment")
        BulletList()
        ListItem():Strong("CSTA K-12 Computer Science Standards (2017): "):Text("3A-AP-14")
    end
end
