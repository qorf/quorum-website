use Libraries.Web.Page.QuorumPage
use Libraries.Web.Series.PageSeries
use Libraries.Containers.Array

/*
    The Computer Science Principles page: a banner, then "About the Course"
    and a card for each unit (design B, plan 13 phase 5): its name, linked
    to its first lesson, its description, and what its lessons teach.
*/
class CodeOrgTrack is QuorumPage
    // The track's units, in order, from the builder.
    Array<PageSeries> units = undefined

    on create
        SetLocation("lessons/code.html")
    end

    action SetTrackSeries(Array<PageSeries> trackUnits)
        units = trackUnits
    end

    action Setup
        SetWebPageTitle("Quorum Reference Pages - Quorum Programming Language")
        Banner("Computer Science Principles", "The AP CSP Quorum course is adaptation of code.org's online curriculum for the College Board's Computer Science Principles Course.", "media/userInterface/quorumAssets/csp-logos.png", "Reference Page")
        Section("About the Course")
        Paragraph("This AP Course is designed to expose students to the multidisciplinary concepts of computer science with a goal to attract future leaders in the field and engage students who are underrepresented in computer science. This course has been been adapted and made accessible based off of Code.org’s AP Computer Science curriculum.")
        integer i = 0
        repeat while i < units:GetSize()
            PageSeries unit = units:Get(i)
            UnitCard("Unit " + (i + 1) + ": " + unit:GetName(), unit, unit:GetImage())
            i = i + 1
        end
    end
end
