use Libraries.Web.Page.QuorumPage

/*
    Getting Started with CSP Widgets.
    Converted from the old Lesson page by plan 13's generator: the same
    words, now without Tailwind.
*/
class CodeOrgWidgetTutorial is QuorumPage

    on create
        SetLocation("lessons/code/CodeOrgWidgetTutorial.html")
        // The name lists and links use, and the series and track it belongs
        // to: its section and picture.
        SetShortTitle("Getting Started with CSP Widgets")
        // For search engines and link previews, and what lists of pages say.
        SetDescription("A step-by-step guide for getting and running the widgets used in the CSP curriculum.")
        SetSummary("Learn how to clone the widget repository and open projects.")
    end

    action Setup
        SetWebPageTitle("Getting Started with CSP Widgets")
        Title("Getting Started with CSP Widgets")
        Paragraph("A step-by-step guide to downloading and running the Computer Science Principles widgets")
        GettingStartedWithCSPWidgets()
        Part1GetQuorumStudio()
        Part2CloneTheCSPWidgetsRepository()
        OpeningAProject()
        UsingTheProject()
    end

    private action GettingStartedWithCSPWidgets
        Section("Getting Started with CSP Widgets")
        Paragraph("This guide describes how to download the widgets used for the Computer Science Principles curriculum. It also shows you how to open and run the projects. For information on each individual widget, see the lessons where they are used.")
    end

    private action Part1GetQuorumStudio
        Section("1. Get Quorum Studio")
        Paragraph("First, "):Link("download Quorum Studio, version 3.0 or later", "/download.html"):Text(". You'll need a (free) Quorum account to download Quorum Studio. If you don't already have one, you can make one by selecting "):DoubleQuote():Text("Login"):DoubleQuote():Text(" in the top bar of the website and selecting "):DoubleQuote():Text("Sign up for an account"):DoubleQuote():Text(".")
        Paragraph():Strong("IMPORTANT:"):Text(" If you already have Quorum Studio installed, make sure it's at least version 3.0! Older versions may not correctly clone the repository in the upcoming steps. If you aren't sure, go to "):DoubleQuote():Text("Help"):DoubleQuote():Text(" > "):DoubleQuote():Text("Check for Updates"):DoubleQuote():Text(" in Quorum Studio and to automatically update to the newest version.")
    end

    private action Part2CloneTheCSPWidgetsRepository
        Section("2. Clone the CSP Widgets Repository")
        Paragraph("To get the widgets, we "):DoubleQuote():Text("clone"):DoubleQuote():Text(" them. This downloads the most up-to-date version of the widgets, along with all the code that makes them work, and makes it easy to get updates using version control. If you want to know more about cloning or how version control works, you can check out the "):Link("Teams and Version Control tutorial", "/tutorials/language/teamsAndVersionControl.html"):Text(", but you don't have to for this guide.")
        Paragraph("In Quorum Studio, go to "):DoubleQuote():Text("Team"):DoubleQuote():Text(" > "):DoubleQuote():Text("Clone"):DoubleQuote():Text(" in the top bar, or press "):Strong("CONTROL"):Text(" + "):Strong("SHIFT"):Text(" + "):Strong("O"):Text(" on Windows or "):Strong("COMMAND"):Text(" + "):Strong("SHIFT"):Text(" + "):Strong("O"):Text(". This opens the Clone dialog, which should look similar to the picture below.")
        Image("media/lessons/csp/Clone_Dialog.png", "The Clone dialog box in Quorum Studio. It has a field labelled ")
        Paragraph("In the "):DoubleQuote():Text("Clone"):DoubleQuote():Text(" section, enter this address: "):Link("https://github.com/qorf/CSP-Widgets.git", "https://github.com/qorf/CSP-Widgets.git")
        Paragraph("You can use the "):DoubleQuote():Text("Location"):DoubleQuote():Text(" field (or the associated "):DoubleQuote():Text("Browse"):DoubleQuote():Text(" button) to choose where the downloaded files will go. If you leave the field blank, it'll go into the default location for Quorum Studio projects -- for example, on Windows, this will be the "):DoubleQuote():Text("Quorum Studio"):DoubleQuote():Text(" folder in your Documents.")
        Paragraph("The last two fields, "):DoubleQuote():Text("Username"):DoubleQuote():Text(" and "):DoubleQuote():Text("Password"):DoubleQuote():Text(", should be left blank -- we don't need login information for this publicly available repository. Once you're ready to proceed, click the "):DoubleQuote():Text("Clone"):DoubleQuote():Text(" button. Quorum Studio will now download all of the needed files. This will take a few moments, during which the status updates will appear in the console.")
    end

    private action OpeningAProject
        Section("Opening a Project")
        Paragraph("Once the clone is finished, we can now open a project. Opening the projects will let us run the associated widget and see the code that makes it work.")
        Paragraph("To open a project, select "):DoubleQuote():Text("File"):DoubleQuote():Text(" > "):DoubleQuote():Text("Open Project"):DoubleQuote():Text(", or use the hotkey ("):Strong("CONTROL"):Text(" + "):Strong("O"):Text(" on Windows, or "):Strong("COMMAND"):Text(" + "):Strong("O"):Text(" on Mac). This will open a file browsing dialog.")
        Paragraph("In the dialog, navigate to where you downloaded the repository in the previous step. Inside the folder there will be different projects and folders for the various widgets used in the CSP curriculum. To open a widget, navigate into its folder, go into the "):DoubleQuote():Text("Project"):DoubleQuote():Text(" subfolder, and open "):DoubleQuote():Text("Project.qp"):DoubleQuote():Text(". For example, to open the Pixelation Widget, we would navigate to PixelationWidget/Project/Project.qp and open it.")
    end

    private action UsingTheProject
        Section("Using the Project")
        Paragraph("Once you've opened the project, you should see it appear in the project tree on the left side of the editor. From here, you can view the individual code files of the project, or run the project by selecting it in the tree and clicking the Run button in the toolbar or by selecting "):DoubleQuote():Text("Run"):DoubleQuote():Text(" > "):DoubleQuote():Text("Run"):DoubleQuote():Text(" in the top bar. For example, if ran the Pixelation Widget, it would look like the picture below:")
        Image("media/lessons/csp/Widget_Example.png", "A screenshot of Quorum Studio with the PixelationWidget project open in the project tree and the file Main.quorum open in the text editor. An extra window named Pixelation Widget is open, which is the app created by running the project.")
        Paragraph("With that, you're done! Every widget used by the CSP curriculum can be found in this repository, and every project can be opened, inspected, and run in the same way. For individual directions on how to use each widget, see the lessons they feature in.")
    end
end
