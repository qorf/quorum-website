use Libraries.Web.Page.QuorumPage

/*
    Variables, Conditionals, and Functions - Lesson 5: Conditionals Explore.
    Converted from the old Lesson page by plan 13's generator: the same
    words, now without Tailwind.
*/
class CodeOrgUnit4Lesson5 is QuorumPage

    on create
        SetLocation("lessons/code/BigDataAndPrivacy/Lesson5.html")
        // The name lists and links use, and the series and track it belongs
        // to: its section and picture.
        SetShortTitle("Conditionals Explore")
        SetSectionName("Variables, Conditionals, and Functions")
        // For search engines and link previews, and what lists of pages say.
        SetDescription("Learn about boolean values and how to make decisions with them")
        SetSummary("Explore booleans and conditonals")
    end

    action Setup
        SetWebPageTitle("Unit 4 Lesson 5: Conditionals Explore")
        Title("Variables, Conditionals, and Functions - Lesson 5: Conditionals Explore")
        Overview()
        GettingStarted5Minutes()
        Activity30Minutes()
        WrapUp10Minutes()
        AssessmentCheckForUnderstanding()
        StandardsAlignment()
    end

    private action Overview
        Section("Overview")
        Paragraph("Students learn the basics of conditionals through an unplugged activity using the sticky notes and plastic baggies from the Variables Explore lesson. Flowcharts are introduced as a way to understand how computers make decisions using Boolean expressions.")
        Subsection("Goals")
        Paragraph("Students will be able to:")
        BulletList()
        ListItem("Use appropriate vocabulary to describe Boolean expressions and conditional statements")
        ListItem("Evaluate expressions that include Boolean values, comparison operators, and logical operators")
        ListItem("Trace simple programs that use Boolean expressions and conditional statements")
        Subsection("Purpose")
        Paragraph("The warm up activity is designed to provide context for the Conditionals progression. The subsequent activity provides students a physical mental model they will be able to use when they start programming with conditionals in the subsequent lessons.")
        Subsection("Resources")
        BulletList()
        ListItem():Link("CS Principles: Conditionals - Part 1 Boolean Expressions (Video)", "https://www.youtube.com/watch?v=y3rCKJNOwpA")
        ListItem():Link("Code.org CSP Unit 4 - Variables, Conditionals, and Functions (Presentation Slides)", "https://docs.google.com/presentation/d/1GhpZOh2589s9MuKsll7YkQ3xv6nwcpmtAnTCgJPIXC0/copy")
    end

    private action GettingStarted5Minutes
        Section("Getting Started (5 minutes)")
        Paragraph():Strong("Discuss:"):Text(" Imagine you want to make a decision about what to wear to an event. Name two pieces of information you'd want. How would you use them in your decision?")
    end

    private action Activity30Minutes
        Section("Activity (30 minutes)")
        Paragraph():Strong("Group:"):Text(" Group students in pairs.")
        Paragraph():Strong("Distribute:"):Text(" Give each pair of students:")
        BulletList()
        ListItem("A small stack of red, yellow, and blue sticky notes")
        ListItem("A pen/pencil")
        ListItem("3 plastic baggies")
        ListItem("A dry erase marker to share with another group")
        TeachingTip()
        Paragraph():Strong("Supplies Substitutions:"):Text(" There's no need to use stickie notes if you have other scraps of colored paper. Also consider cutting stickies in 4 to make them go further. If you don't have dry erase markers handy consider using pieces of masking tape on the baggies.")
        EndCallout()
        Paragraph():Strong("Guided Activity:"):Text(" Today's activity introduces students to the concept of variables. As a visual aid, you can use "):Link("Code.org's presentation slides for Unit 4, Lesson 5: Conditionals Explore", "https://docs.google.com/presentation/d/1GhpZOh2589s9MuKsll7YkQ3xv6nwcpmtAnTCgJPIXC0/copy"):Text(". These slides include animations. The notes below describe when to move to the next slide or click through an animation -- if you aren't using the slides, you can ignore these prompts.")
        TeachingTip()
        Paragraph():Strong("Running the Activity:"):Text(" This activity asks students to follow along as a number of core concepts for programming are introduced. The model is typically that a term or concept is introduced and modeled and then afterwards students are encouraged to try it out on their own. Trying it out typically means they are writing information on a sticky note and sharing it with another group before discussing the results with the whole class.")
        Paragraph("If you're using the slides to accompany this activity, slides with animations have an icon in the bottom left corner to let you know you need to click to reveal more of the slide's content.")
        Paragraph("To help you more easily prepare the activity and keep track of your instructions, detailed instructions have been included as speaker notes in the presentation. Here are some tips to help you throughout the presentation.")
        BulletList()
        ListItem("There are opportunities throughout the presentation for students to actively engage. At these moments students should be making things with their manipulatives or using them to answer questions. Use these opportunities to check progress.")
        ListItem("There is a fair amount of new vocabulary introduced but it is introduced gradually and with intentional repetition. Make a point of actively modeling the use of new terms.")
        ListItem("The most important goal here is building a mental model. It is ok if students have some open questions that will get resolved over the subsequent conditional lessons.")
        ListItem("Both you and students can use the "):DoubleQuote():Text("Key Takeaways"):DoubleQuote():Text(" to check your understanding at the end.")
        ListItem("Students who have been using Quorum in the previous lessons will have already seen basic conditionals as part of their event-handling code, but they haven't been given context as to how they work. You can reference back to these examples, or just leave them alone for now.")
        ListItem("The slides use Javascript instead of Quorum. The concepts of conditionals and booleans are valid regardless of language, but when students program, they should know how to use the Quorum symbols. Here's the differences between the two languages:")
        NestedBulletList()
        ListItem("- The "):DoubleQuote():Text("equal to"):DoubleQuote():Text(" operator in Quorum is "):DoubleQuote():Text("="):DoubleQuote():Text(" instead of "):DoubleQuote():Text("=="):DoubleQuote()
        ListItem("- The "):DoubleQuote():Text("not equal to"):DoubleQuote():Text(" operator in Quorum is "):DoubleQuote():Text("not="):DoubleQuote():Text(" instead of "):DoubleQuote():Text("!="):DoubleQuote()
        ListItem("- The "):DoubleQuote():Text("AND"):DoubleQuote():Text(" operator in Quorum is "):DoubleQuote():Text("and"):DoubleQuote():Text(" instead of "):DoubleQuote():Text("&&"):DoubleQuote()
        ListItem("- The "):DoubleQuote():Text("OR"):DoubleQuote():Text(" operator in Quorum is "):DoubleQuote():Text("or"):DoubleQuote():Text(" instead of "):DoubleQuote():Text("||"):DoubleQuote()
        ListItem("- The "):DoubleQuote():Text("NOT"):DoubleQuote():Text(" operator in Quorum is "):DoubleQuote():Text("not"):DoubleQuote():Text(" instead of "):DoubleQuote():Text("!"):DoubleQuote()
        EndNestedList()
        EndCallout()
        Subsection("Guided Activity")
        Paragraph("Follow this lesson with the supplemental slides.")
        Paragraph():Strong("Slide:"):Text(" Conditionals Explore")
        Paragraph():Strong("Say:"):Text(" Today we are going to explore Conditionals.")
        Paragraph():Strong("Slide:"):Text(" Information can be stored as...")
        Paragraph():Strong("Say:"):Text(" Previously, we learned that information can be stored as numbers or strings in variables. These are two different types of data. Numbers and strings can be combined together using operators to make expressions. Expressions are evaluated before storing in variables.")
        Paragraph():Strong("Slide:"):Text(" Information can be also be stored as a...")
        Paragraph():Strong("Say:"):Text(" Boolean values are another type of data. They can store the values "):DoubleQuote():Text("true"):DoubleQuote():Text(" or "):DoubleQuote():Text("false"):DoubleQuote():Text(". Why would we want that information? Booleans are used to make decisions. If something is true, do this. If something is false, do that.")
        Paragraph():Strong("Click for animation.")
        Paragraph():Strong("Say:"):Text(" You only need two blue sticky notes today. Write down "):DoubleQuote():Text("true"):DoubleQuote():Text(" on one and "):DoubleQuote():Text("false"):DoubleQuote():Text(" on the other.")
        Paragraph():Strong("Slide:"):Text(" 3 < 8")
        Paragraph():Strong("Say:"):Text(" Let's look at this expression: "):Code("3 < 8"):Text(". Take a guess as to what Boolean value this evaluates to.")
        Paragraph():Strong("Do This:"):Text(" Hold up the sticky note with the correct value.")
        Paragraph():Strong("Click for animation.")
        Paragraph():Strong("Say:"):Text(" The expression evaluates to true, because 3 is less than 8.")
        Paragraph():Strong("Click for animation.")
        Paragraph():Strong("Say:"):Text(" The less than symbol is a comparison operator. When we see a comparison operator, we need to stop and evaluate for a Boolean value. There are six different comparison operators - you may be familiar with some of them from math class. These symbols are less than, greater than, less than or equal to, greater than or equal to, equal to, and not equal to. The symbols on the slide show how these appear in Javascript, but they look different in Quorum. You'll get a chance to practice with the Quorum symbols later.")
        Paragraph():Strong("Slide: Each side of the comparison operator...")
        Paragraph():Strong("Say:"):Text(" Both sides of the relational operator should be reduced to a single value before we can compare. Think of it in terms of sticky notes. You should have only one sticky note on each side.")
        Paragraph():Strong("Do This:"):Text(" What does 3 + 6 equate to?")
        Paragraph():Strong("Click for animation.")
        Paragraph():Strong("Say:"):Text(" Right: 9! Now we can compare 9 and 8 using the relational operator: less than.")
        Paragraph():Strong("Do This:"):Text(" Does this evaluate to true or false? Hold up the correct sticky note.")
        Paragraph():Strong("Click for animation.")
        Paragraph():Strong("Slide:"):Text(" Do This:")
        Paragraph():Strong("Say:"):Text(" Let's evaluate these expressions line by line. It may be helpful to use your sticky notes here.")
        NumberedList()
        ListItem("6 - 3 < 4 + 1")
        ListItem("12 / 6 > 3 - 0")
        ListItem("(7 - 3) * 3 <= 10")
        ListItem("9 + 5 = 4 + 10")
        Paragraph():Strong("Do This:"):Text(" Reduce each side of the relational operator to one sticky note. Then evaluate for a Boolean value. Compare your answers with a partner.")
        Paragraph():Strong("Click for animation:"):Text(" When the class is finished, click through to view the answers. The third line may be a little tricky. Remind students to evaluate the information in the parenthesis first. In the fourth line, draw attention to the double equal signs used in the slide and remind the class double equal signs are a signal to compare if both sides are the same.")
        Paragraph():Strong("Slide:"):Text(" Any of the values in an expression can be a variable.")
        Paragraph():Strong("Say:"):Text(" The expressions that we evaluate can also contain variables. Remember, variables store information. This information can be different data types like numbers, strings, or even Boolean values themselves. For now, we are going to stick with numbers.")
        Paragraph():Strong("Do This:"):Text(" With a partner, look at these variables and the expression. Reduce both sides of the relational operator, then evaluate for a Boolean value.")
        NumberedList()
        ListItem("lives: 5")
        ListItem("score: 10")
        ListItem("lives + 4 < score - 1")
        Paragraph():Strong("Click for animation:"):Text(" When the class is finished, click through for the answer.")
        Paragraph():Strong("Say:"):Text(" Any expression that can be evaluated as true or false is known as a Boolean Expression.")
        Paragraph():Strong("Slide:"):Text(" Decision time!")
        Paragraph():Strong("Say:"):Text(" At the beginning of class, we talked about how Booleans are used to make decisions. Let's see that in action. Consider the following question: Can I go to the movies? I'm allowed to if it's before 8 o'clock. This may seem like a simple decision! But let's think about this like a computer.")
        Paragraph():Strong("Do This:"):Text(" What information would the computer need to know in order to answer the question. Create a baggie variable to store the information. Give it a name.")
        Paragraph():Strong("Slide:"):Text(" "):DoubleQuote():Text("Can I go to the movies"):DoubleQuote():Text(" flowchart")
        Paragraph():Strong("Say:"):Text(" We can think of the decision like a flowchart. It's an organized way to make a decision or come to a conclusion. Creating a flowchart helps us think like a computer. At the top, we are listing the variables that are needed. Your variable might be called time or clock or really anything. It doesn't matter as long as you use the same name every time you refer to the variable. For this example, I'm naming my variable "):DoubleQuote():Text("time"):DoubleQuote():Text(". Let's step through the flowchart with an example to see how it works.")
        Paragraph():Strong("Slide:"):Text(" "):DoubleQuote():Text("Can I go to the movies"):DoubleQuote():Text(" flowchart #2")
        Paragraph():Strong("Click for animation.")
        Paragraph():Strong("Say:"):Text(" It's 9 o'clock. Can I go to the movies?")
        Paragraph():Strong("Click for animation.")
        Paragraph():Strong("Say:"):Text(" First I assign 9 to the variable time, then I move on to the diamond section.")
        Paragraph():Strong("Click for animation.")
        Paragraph():Strong("Say:"):Text(" I see a comparison operator, which let's me know that we need to stop and evaluate the Boolean expression.")
        Paragraph():Strong("Click for animation.")
        Paragraph():Strong("Say:"):Text(" First reduce both sides to a single value. Then evaluate for a Boolean value. In this case, The Boolean expression evaluates to false.")
        Paragraph():Strong("Click for animation.")
        Paragraph():Strong("Say:"):Text(" Follow the "):DoubleQuote():Text("false"):DoubleQuote():Text(" path, and we arrive at the result: "):DoubleQuote():Text("I can't go to the movies."):DoubleQuote()
        Paragraph():Strong("Note:"):Text(" If students are confused, return back to the previous slide and try running some examples together as a class. Students can hold up true or false when evaluating the Boolean expression. Once students get the hang of using a flowchart, continue on to the next slide.")
        Paragraph():Strong("Slide:"):Text(" Have I won the game?")
        Paragraph():Strong("Say:"):Text(" Here's another decision that needs to be made. I'm not sure if I have won the game I'm playing. I have won it if my score * (times) my lives is greater than 10.")
        Paragraph():Strong("Do This:"):Text(" Direct students to create baggie variables for the information that needs to be stored and write down the Boolean expression on a spare sticky note or scrap paper. Groups then compare their Boolean expressions.")
        Paragraph():Strong("Slide:"):Text(" "):DoubleQuote():Text("Have I won the game?"):DoubleQuote():Text(" flowchart")
        Paragraph():Strong("Say:"):Text(" Take a look at the Boolean expression in the decision section of the flowchart: "):Code("score * lives > 10"):Text(". Is this similar to what you and your partner wrote? Are there other ways we could construct this? (score and lives might have different names, score and lives might be in opposite order, you could write it as 10 < score * lives).")
        Paragraph():Strong("Click for animation.")
        Paragraph():Strong("Do This:"):Text(" With a partner, try following the flowchart with a few different inputs.")
        Paragraph():Strong("Slide:"):Text(" Challenge!!")
        Paragraph():Strong("Say:"):Text(" Here's a new decision we need to make:")
        Paragraph("Is my dog older than me if his age is converted to human years? Seven dog years equals one human year.")
        Paragraph():Strong("Do This:"):Text(" With a partner walk through these steps. Think about what the Boolean expression will look like.")
        NumberedList()
        ListItem("What information do I need to know?")
        ListItem("Create baggie variable(s) to store that information. Give them names.")
        ListItem("With a partner, discuss what the Boolean will look like. What will be compared?")
        Paragraph():Strong("Slide:"):Text(" "):DoubleQuote():Text("Is my dog older than me"):DoubleQuote():Text(" flowchart")
        Paragraph():Strong("Say:"):Text(" Let's use a flowchart for the question we just considered.")
        Paragraph():Strong("Do This:"):Text(" With your partner, step through a flowchart with a few different inputs.")
        Paragraph():Strong("Note:"):Text(" After students have practice on their own, call on one group to give input values for "):Code("dogAge"):Text(" and "):Code("myAge"):Text(" and step through the flowchart as a class.")
        Paragraph():Strong("Slide:"):Text(" What if my decision requires several steps?")
        Paragraph():Strong("Say:"):Text(" What happens if my decision requires several steps? I want to adopt a cat, but I have to have both 40 dollars and be over 14 years old.")
        Paragraph():Strong("Note:"):Text(" Emphasize precise language here. The Boolean is checking if I have 40 dollars - that's exactly 40, not one cent more! In the Conditional Practice lesson, students will return to this flowchart and edit it to account for having more than 40 dollars.")
        Paragraph():Strong("Slide:"):Text(" Can I adopt a cat?")
        Paragraph():Strong("Say:"):Text(" Let's get setup for stepping through the decision making process for this question:")
        Paragraph("Can I adopt a cat? I can if I have 40 dollars AND I am over 14 years old.")
        Paragraph():Strong("Do This:"):Text(" Set up your baggies, and discuss with a partner how the flowchart might be set up.")
        NumberedList()
        ListItem("What information do I need to know?")
        ListItem("Create baggie variable(s) to store that information. Give them names.")
        ListItem("With a partner, discuss what the Boolean will look like. What will be compared?")
        Paragraph():Strong("Slide:"):Text(" "):DoubleQuote():Text("Can I adopt a cat?"):DoubleQuote():Text(" flowchart")
        Paragraph():Strong("Say:"):Text(" This flowchart looks a little different from the previous one. There are two stopping points where a Boolean expression is evaluated. Let's try this out with an example.")
        Paragraph():Strong("Click for animation:"):Text(" Click through, one step at a time with the class. When you get to a decision point, before clicking to the next animation have students evaluate the expression and hold up a blue sticky note.")
        Paragraph():Strong("Say:"):Text(" Notice in the question box, I've stated that I can adopt the cat if I have 40 dollars AND (emphasize) I am over 14 years old. I am checking two things. Let's look at a way to simplify that process.")
        Paragraph():Strong("Slide:"):Text(" Boolean values are a type of information...")
        Paragraph("Say: In the previous example, we had two Boolean expressions to evaluate. We can use logical operators to compare the results of those Boolean expressions. The logical operators we will look at are AND, OR, and NOT.")
        Paragraph():Strong("Note:"):Text(" If you're using the slides, the symbols shown are for Javascript. In Quorum, these logical operators are "):Code("and"):Text(", "):Code("or"):Text(", and "):Code("not"):Text(".)")
        Paragraph():Strong("Slide:"):Text(" Let's take a look at Truth Tables")
        Paragraph():Strong("Say:"):Text(" Now we're going to take a look at something called a Truth Table.")
        Paragraph():Strong("Slide:"):Text(" Truth Table (AND)")
        Paragraph("This is a truth table.")
        BulletList()
        ListItem():Code("true"):Text(" and "):Code("true"):Text(" = "):Code("true")
        ListItem():Code("true"):Text(" and "):Code("false"):Text(" = "):Code("false")
        ListItem():Code("false"):Text(" and "):Code("true"):Text(" = "):Code("false")
        ListItem():Code("false"):Text(" and "):Code("false"):Text(" = "):Code("false")
        Paragraph():Strong("Say:"):Text(" The table demonstrates all the possible combinations of true and false and what they would evaluate to if combined with the logical operator AND. The first one seems obvious to us - if something is true and another thing is true, then the whole thing is true!. Read through each row, and consider what is being stated. In rows 2 and 3, if one value is false, the whole thing evaluates to false. This is what happened with the cat example. On the final line, if both values are false, the final evaluation is false.")
        Paragraph():Strong("Click for animation.")
        Paragraph():Strong("Say:"):Text(" What's the takeway? In evaluating two Boolean expressions with the AND operator, both must be true in order for the whole expression to evaluate as true.")
        Paragraph():Strong("Slide:"):Text(" Truth Table (OR)")
        Paragraph():Strong("Say:"):Text(" Now let's consider a Truth Table for OR.")
        NumberedList()
        ListItem():Code("true"):Text(" or "):Code("true")
        ListItem():Code("false"):Text(" or "):Code("true")
        ListItem():Code("true"):Text(" or "):Code("false")
        ListItem():Code("false"):Text(" or "):Code("false")
        Paragraph():Strong("Do This:"):Text(" With a partner, evaluate each row. For example, if the first sticky is "):Code("true"):Text(" or the second sticky is "):Code("true"):Text(" what do you think the whole expression will evaluate to: true or false?")
        Paragraph():Strong("Click for animation:"):Text(" Stop line by line and allow time for groups to make their predictions.")
        Paragraph():Strong("Say:"):Text(" For the OR Truth Table, if either sticky note is true, the expression evaluates to true.")
        Paragraph():Strong("Slide:"):Text(" Truth Table (NOT)")
        Paragraph():Strong("Say:"):Text(" The NOT table is simple because it reverses the value.")
        Paragraph():Strong("Click for animation:"):Text(" As a class quickly state what the opposite values are and click through the animations.")
        Paragraph():Strong("Slide:"):Text(" Use logical operators to combine...")
        Paragraph():Strong("Say:"):Text(" Let's return to the cat example. How can we write a single expression that accounts for all the information that needs to be checked?")
        Paragraph("Can I adopt a cat? I can if I have 40 dollars AND I am over 14 years old.")
        Paragraph():Strong("Do This:"):Text(" With a partner, create the expression using logical operators.")
        Paragraph():Strong("Note:"):Text(" It's ok if students struggle with this activity. After a few minutes, move on to the next slide and reveal the answer. This will help students make the connection.")
        Paragraph():Strong("Slide:"):Text(" "):DoubleQuote():Text("Can I adopt a cat?"):DoubleQuote():Text(" flowchart")
        Paragraph():Strong("Click for animation:"):Text(" Click through the animation step by step and follow along as a class. Allow time to predict at decision points. When the truth table (yellow box) appears on the screen, take a moment to remind students what this is and what it demonstrates. If a value is true and another value is true, it evaluates to true. It's not expected that students will memorize the truth tables, but they should be familiar with how they work.")
        Paragraph():Strong("Note:"):Text(" If you have extra time, try running this flowchart with other inputs. Try changing the conditions and then running the flowchart (i.e. I can adopt the cat if I have 40 dollars OR I am over 14 years old)")
        Paragraph():Strong("Say:"):Text(" Today we used flowcharts to demonstrate how computers make decisions. In the next class, we will investigate how decisions are made in code.")
        Paragraph():Strong("Slide:"):Text(" Do This: Now it's your turn to make a flowchart.")
        Paragraph():Strong("Do This:"):Text(" Give students a few minutes to craft their own flowcharts and test on each other following these instructions:")
        BulletList()
        ListItem("Think back to the warm-up where we discussed making a decision on what to wear to an event.")
        ListItem("Write down the variables at the top.")
        ListItem("Below the variables, create the Boolean expression that will be used to make the decision.")
        ListItem("Draw True/False lines to the possible decisions.")
        ListItem("Challenge: Use logical operators (and, or, not) in your Boolean expression. Add extra branches with multiple decisions.")
        ListItem("Test your flowchart with a friend!")
        Paragraph():Strong("Note:"):Text(" Simple flowcharts are fine, or students can build more complex models. Students are ready to move on when the majority of the class has made and tested a flowchart.")
        Paragraph():Strong("Slide:"):Text(" Key Takeaways")
        Paragraph():Strong("Click for animation:"):Text(" Click through the animation to reveal the key takeaways on the slide.")
        Paragraph():Strong("Review:"):Text(" Review the key takeaways with students:")
        BulletList()
        ListItem("A "):Strong("Boolean Value"):Text(" is a data type that is either true or false.")
        ListItem():Strong("Comparison Operators"):Text(" <, >, <=, >=, =, not= indicate a Boolean expression.")
        ListItem("Each side of the Boolean expression is reduced to a single value.")
        ListItem("Single values are compared and result in a Boolean value (true or false)")
        Paragraph():Strong("Slide:"):Text(" Key Takeaways (#2)")
        Paragraph():Strong("Click for animation:"):Text(" Click through the animation to reveal the key takeaways on the slide.")
        Paragraph():Strong("Review:"):Text(" Review the key takeaways with students:")
        BulletList()
        ListItem("Boolean expressions can also include "):Strong("Logical Operators"):Text(" (AND, OR, NOT). Both sides of the logical operator are reduced to a single Boolean value")
        ListItem("A truth table is used to evaluate the reduced Boolean expression to a single Boolean value")
        ListItem("A decision is made with the single Boolean value")
        ListItem("A flowchart illustrates the steps of making a decision with a Boolean expression")
    end

    private action WrapUp10Minutes
        Section("Wrap Up (10 minutes)")
        Paragraph():Strong("Video:"):Text(" As a class, watch "):Link("CS Principles: Conditionals - Part 1 Boolean Expressions (Video)", "https://www.youtube.com/watch?v=y3rCKJNOwpA"):Text(".")
        Video("https://www.youtube.com/embed/y3rCKJNOwpA?si=zXjfif5DuhTbXyeO", "CS Principles: Conditionals - Part 1 Boolean Expressions")
        Subsection("Journal")
        Paragraph("Have students add the following words and definitions to their journals:")
        BulletList()
        ListItem():Emphasis("Boolean Value:"):Text(" True or false")
        ListItem():Emphasis("Boolean Expression:"):Text(" An expression that evaluates to either true or false")
    end

    private action AssessmentCheckForUnderstanding
        Section("Assessment: Check for Understanding")
        Subsection("For Students")
        Paragraph("Open a word doc or google doc and copy/paste the following question.")
        Subsection("Question")
        Paragraph("Can a computer evaluate an expression to something between true and false? Can you write an expression to deal with a "):DoubleQuote():Text("maybe"):DoubleQuote():Text(" answer?")
    end

    private action StandardsAlignment
        Section("Standards Alignment")
        BulletList()
        ListItem():Strong("CSTA K-12 Computer Science Standards (2017): "):Text("2-AP-10, 3A-AP-15")
        ListItem():Strong("CSP2021: "):Text("AAP-2.E.1, AAP-2.F.5")
    end
end
