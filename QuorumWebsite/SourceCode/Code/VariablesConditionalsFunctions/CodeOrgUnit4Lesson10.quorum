use Libraries.Web.Page.QuorumPage

/*
    Variables, Conditionals, and Functions - Lesson 10: Functions Practice.
    Converted from the old Lesson page by plan 13's generator: the same
    words, now without Tailwind.
*/
class CodeOrgUnit4Lesson10 is QuorumPage
    // A double quote, for code and words that hold one.
    text dq = ""

    on create
        SetLocation("lessons/code/BigDataAndPrivacy/Lesson10.html")
        // The name lists and links use, and the series and track it belongs
        // to: its section and picture.
        SetShortTitle("Functions Practice")
        SetSectionName("Variables, Conditionals, and Functions")
        // For search engines and link previews, and what lists of pages say.
        SetDescription("Practice using and creating functions")
        SetSummary("Practice using functions")
    end

    action Setup
        dq = dq:GetDoubleQuote()
        SetWebPageTitle("Unit 4 Lesson 10: Functions Practice")
        Title("Variables, Conditionals, and Functions - Lesson 10: Functions Practice")
        Overview()
        GettingStarted5Minutes()
        Activity35Minutes()
        WrapUp5Minutes()
        AssessmentCheckForUnderstanding()
        StandardsAlignment()
    end

    private action Overview
        Section("Overview")
        Subsection("Goals")
        Paragraph("Students will be able to:")
        BulletList()
        ListItem("Write programs that use functions with the support of sample code")
        ListItem("Debug programs that use functions")
        ListItem("Identify opportunities to use functions to reduce repeated code within a program")
        Subsection("Purpose")
        Paragraph("This lesson is students primary opportunity to get hands on with functions in code prior to the Make activity in the following lesson. Give students as much class time as you can to work through these. For this lesson it's recommended that you place students in pairs as a support and to encourage discussion about the challenges or concepts they're seeing. In the following lesson students are encouraged to work independently.")
        Subsection("Resources")
        BulletList()
        ListItem():Link("CSP-Widgets Repository", "https://github.com/qorf/CSP-Widgets")
        Paragraph("In this lesson students spend most of their time practicing using the skills and processes they have learned about functions. At the conclusion of the lesson students discuss remaining questions in anticipation of their Make project in the following lesson.")
    end

    private action GettingStarted5Minutes
        Section("Getting Started (5 minutes)")
        Subsection("Remarks")
        BulletList()
        ListItem("Today we're going to have a chance to practice programming with a lot of the concepts and patterns we've explored over the last two lessons. I encourage you to go through these with a partner, but pay close attention to what each other is doing. In our next lesson you're going to have to use a lot of these on an independent project, and these activities are good practice for what you'll find there! Alright, let's get to it!")
        TeachingTip()
        Paragraph():Strong("Move Quickly to the Activity:"):Text(" There's a lot in the main activity of today's lesson. You may optionally wish to do a quick vocabulary review or address any questions that came up in the last lesson. Otherwise, give students more time to get hands on with some code.")
        EndCallout()
    end

    private action Activity35Minutes
        Section("Activity (35 minutes)")
        Subsection("Practice Time")
        TeachingTip()
        Paragraph():Strong("Providing Support:"):Text(" Circulate around the room through the lesson encouraging students to use the strategies introduced at the beginning of the lesson. Students have a number of supports at their fingertips, so a big part of your role is helping build their independence in using those resources.")
        EndCallout()
        Paragraph():Strong("Group:"):Text(" It is recommended that students work in pairs for this lesson and a number of the activities feature discussion prompts. Consider using pair programming, having drivers and navigators switch every 3 minutes, not every project.")
        Paragraph():Strong("Distribute:"):Text(" Optionally pass out a plastic cup or other manipulative they can place on their computer when they are stuck as a signal that they need support.")
        Paragraph():Strong("Open a Project:"):Text(" Today's lesson uses several apps. Direct students to begin by opening "):Strong("Lesson10_App1.")
        Subsection("Remarks")
        BulletList()
        ListItem("Today you're mostly going to practice what we've learned about programming with functions. I'm here to help you when you need, and you can put this cup on your computer when you need help. However, I first want to remind you of the following:")
        NestedBulletList()
        ListItem("Use your debugging skills. Try to zoom in on precisely where you're getting stuck.")
        ListItem("Talk to your partner! That's what they're there for!")
        ListItem("Talk to the group next to you. If another group asks for help make sure to take some time to talk it through with them.")
        EndNestedList()
        Paragraph():Strong("Apps 1 - 5 Declare and Call Functions:"):Text(" In these projects students practice declaring and calling functions. At first students practice calling functions that have already been declared for them. Students can focus their energy on the syntax of calling a function and how using functions changes the order in which lines of code run. Later in the progression they practice finding repeated code and are guided through how to create a function in its place.")
        Paragraph():Strong("App 6 - Function Scope:"):Text(" This project returns to a topic that was covered in the variables lessons as well: variable scope. While students do not need a deep understanding of scope at this point, they will in some instances encounter debugging challenges that arise because of it.")
        Paragraph():Strong("Discuss:"):Text(" As a class, discuss the section below, "):DoubleQuote():Text("When to make a function"):DoubleQuote():Text(".")
        Subsection("When to Make a Function")
        Paragraph("An important questions for new programmers is "):DoubleQuote():Text("When should I decide to make a function"):DoubleQuote():Text(". In general, the earlier you realize you need a function, the better. This is a skill you'll get better at with practice. "):Strong("By the end of this course you should aim to be in the During or Before rows.")
        Table("Table with two columns of song lyrics labeled Style 1 and Style 2.")
        TableHeader():Cell("When You Create Functions"):Cell("Description"):Cell("Comments")
        TableRow():Cell("Never"):Cell("You never create functions at all."):Cell("Your code will be difficult to read and debug and have lots of repeated code. Aim to move on at least to the " + dq + "After" + dq + " step.")
        TableRow():Cell("After"):Cell("You write your entire program without functions. Once you're done you look for repeated code and move those into a function."):Cell("Your code is much easier to read and debug now. You're also getting better at seeing how your program is organized. As you get more comfortable, try to move on to " + dq + "During" + dq + " or " + dq + "Before" + dq + ".")
        TableRow():Cell("During"):Cell("As you write your code you notice when you're about to rewrite code you already wrote somewhere else in your program. Before moving on you declare a function and call that function instead."):Cell("You have a good understanding of your program and are able to keep it organized as you develop it. See if sometimes you can move on to " + dq + "Before" + dq + ".")
        TableRow():Cell("Before"):Cell("Before you write your program you make a plan and identify places you're likely to use repeated code. You create your function at the beginning."):Cell("This level reflects a strong understanding of how your program is going to be designed. You can almost " + dq + "see it in your head" + dq + " before you begin writing. That said, it's OK if sometimes you realize you need a function while you program and work in the " + dq + "During" + dq + " stage")
        Paragraph():Strong("App 7 - Creating Functions:"):Text(" In this project, students revisit the Movie Ticket app and are challenged to think through the process of declaring a function with code that they anticipate could be repeated.")
        TeachingTip()
        Paragraph():Strong("Never - After - During - Before:"):Text(" In this section students are introduced to a framework for thinking about their development with using functions. The primary question is "):DoubleQuote():Text("when should I make a function"):DoubleQuote():Text(". In general, you want students to make their functions earlier, as this both improves the process of writing code and reflects deeper understanding of code structure. Throughout this course, you want to see them moving along the "):DoubleQuote():Text("never - after - during - before"):DoubleQuote():Text(" scale.")
        Paragraph("At this point students are still learning to identify repeated code and replace it with a function. This would align with the "):DoubleQuote():Text("after"):DoubleQuote():Text(" level. In the Functions Make project and the Unit 4 project they are encouraged to anticipate the need for functions in advance. Rather than write code twice and then remove the duplicate code by creating a function later, they should begin deciding early that they'll need a function. The "):DoubleQuote():Text("UpdateScreen() pattern"):DoubleQuote():Text(" helps reinforce this point.")
        Paragraph("Reinforce this language in the classroom, though remember it's only a guide. Not every student will immediately be able to move on to "):DoubleQuote():Text("during"):DoubleQuote():Text(" or "):DoubleQuote():Text("before"):DoubleQuote():Text(". Different approaches also work better in different contexts, and many experienced programmers will typically operate in the "):DoubleQuote():Text("during"):DoubleQuote():Text(" mode unless they're building a large and complex project.")
        EndCallout()
    end

    private action WrapUp5Minutes
        Section("Wrap Up (5 minutes)")
        Paragraph():Strong("Discuss:"):Text(" What aspects of working with functions clicked today? What do you still feel like you have trouble with?")
        DiscussionGoal()
        Paragraph():Strong("Discussion Goal:"):Text(" Use this opportunity to address any lingering questions or misconceptions in the room. You can also use this as a source of discussion topics to kick off the following lesson. As you lead the discussion, call out the many resources students have access to help when they're getting stuck.")
        EndCallout()
    end

    private action AssessmentCheckForUnderstanding
        Section("Assessment: Check for Understanding")
        Subsection("For Students")
        Paragraph("Open a word doc or google doc and copy/paste the following question.")
        Subsection("Question")
        Paragraph("What will the value of the variable score be when the following code is finished running?")
        CodeExample("day_of_week = " + dq + "Saturday" + dq + "
day_of_week = " + dq + "Monday" + dq + "

IF ((day_of_week = " + dq + "Saturday" + dq + ") OR (day_of_week = " + dq + "Sunday" + dq + ")) {
     weekend
}
ELSE {
     weekday
}

PROCEDURE weekday {
     DISPLAY(" + dq + "School day" + dq + ")
}

PROCEDURE weekend {
     DISPLAY(" + dq + "Day off" + dq + ")
}")
    end

    private action StandardsAlignment
        Section("Standards Alignment")
        BulletList()
        ListItem():Strong("CSTA K-12 Computer Science Standards (2017): "):Text("3A-AP-17, 3B-AP-14")
    end
end
