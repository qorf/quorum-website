use Libraries.Web.Page.QuorumPage

/*
    Variables, Conditionals, and Functions - Lesson 6: Conditionals Investigate.
    Converted from the old Lesson page by plan 13's generator: the same
    words, now without Tailwind.
*/
class CodeOrgUnit4Lesson6 is QuorumPage
    // A double quote, for code and words that hold one.
    text dq = ""

    on create
        SetLocation("lessons/code/BigDataAndPrivacy/Lesson6.html")
        // The name lists and links use, and the series and track it belongs
        // to: its section and picture.
        SetShortTitle("Conditionals Investigate")
        SetSectionName("Variables, Conditionals, and Functions")
        // For search engines and link previews, and what lists of pages say.
        SetDescription("Investigate conditionals in apps")
        SetSummary("Investigate the use of branching conditionals in apps")
    end

    action Setup
        dq = dq:GetDoubleQuote()
        SetWebPageTitle("Unit 4 Lesson 6: Conditionals Investigate")
        Title("Variables, Conditionals, and Functions - Lesson 6: Conditionals Investigate")
        Overview()
        GettingStarted5Minutes()
        Activity35Minutes()
        WrapUp5Minutes()
        AssessmentCheckForUnderstanding()
        StandardsAlignment()
    end

    private action Overview
        Section("Overview")
        Paragraph("In this lesson students work with partners to investigate three versions of the "):DoubleQuote():Text("Lemon Squeeze"):DoubleQuote():Text(" app to understand how boolean expressions and conditional statements allow programs to make decisions. In each guided investigation students first watch a short video on a concept, then use a working app to predict how new features work, then investigate the code to see how those features are implemented, and finally modify the code to add expanded features. To conclude the lesson, students review and discuss common programming patterns with conditionals.")
        Subsection("Goals")
        Paragraph("Students will be able to:")
        BulletList()
        ListItem("Identify common programming patterns using boolean expressions and conditional statements")
        ListItem("Explain the purpose of those programming patterns with boolean expressions and conditional statements both in terms of how they work and what they accomplish")
        ListItem("Modify apps that make use of common programming patterns with boolean expressions and conditional statements to adjust their functionality")
        Subsection("Purpose")
        Paragraph("After building a conceptual model for boolean expressions and conditional statements in the previous lesson, this lesson allows students to see how they are actually implemented in code. This lesson also introduces common programming patterns when using variables. Students will have some opportunities to modify working code in this lesson, but the most significant practice with conditional statements and boolean expressions will come in the following lesson.")
        Subsection("Resources")
        BulletList()
        ListItem():Link("Introduction to Conditionals (Video, Part A)", "https://youtu.be/0oG3Wck2fRU")
        ListItem():Link("Introduction to Conditionals (Video, Part B)", "https://youtu.be/ZIL_3YRD14s")
        ListItem():Link("Introduction to Conditionals (Video, Part C)", "https://youtu.be/aFssCTE5hs8")
        ListItem():Link("Introduction to Conditionals (Video, Part D)", "https://youtu.be/kyFdniI-ZZs")
        ListItem():Link("CSP-Widgets Repository", "https://github.com/qorf/CSP-Widgets")
    end

    private action GettingStarted5Minutes
        Section("Getting Started (5 minutes)")
        Paragraph():Strong("Discuss:"):Text(" A water park will let a visitor on a ride if they are 48 or more inches tall OR they are 14 years old or older. Make a flowchart for this decision. Make sure to use comparison operators ("):Code("<,>,="):Text(", etc.) and logical operators ("):Code("and,or,not"):Text(") when you write your Boolean expression.")
        TeachingTip()
        Paragraph():Strong("Optional Warmup Prompt:"):Text(" This prompt is optional and is helpful to further synthesize key points from the previous lesson. If you are able to quickly move to the main activity and believe your class does not need this revew consider skipping this prompt.")
        EndCallout()
        Paragraph():Strong("Discuss:"):Text(" Have partners share their responses at their tables. Then discuss answers briefly as a class.")
        Subsection("Remarks")
        BulletList()
        ListItem("In everyday conversation it is common to switch between using the words "):DoubleQuote():Text("when"):DoubleQuote():Text(" and "):DoubleQuote():Text("if"):DoubleQuote():Text(". Here's some examples of what this looks like:")
        NestedBulletList()
        ListItem():DoubleQuote():Text("When the user clicks the button..."):DoubleQuote()
        ListItem():DoubleQuote():Text("If the user clicks the button..."):DoubleQuote()
        ListItem():DoubleQuote():Text("When the user has more than 100 points..."):DoubleQuote()
        ListItem():DoubleQuote():Text("If the user has more than 100 points..."):DoubleQuote()
        EndNestedList()
        ListItem("Today we want to be careful about how we use these words. To make things simple, we're going to use the following rules:")
        NestedBulletList()
        ListItem():DoubleQuote():Text("when"):DoubleQuote():Text(": Means there is an action that responds to user input, like "):Code("ButtonActivated"):Text(". The app does something "):DoubleQuote():Text("when"):DoubleQuote():Text(" the user clicks.")
        ListItem():DoubleQuote():Text("if"):DoubleQuote():Text(": Means there is a conditional statement that decides what pieces of code to run. The app does something "):DoubleQuote():Text("if"):DoubleQuote():Text(" a boolean expression evaluates to true.")
        EndNestedList()
        ListItem("We'll talk more about this later but for now keep an eye out for the difference between "):DoubleQuote():Text("when"):DoubleQuote():Text(" and "):DoubleQuote():Text("if"):DoubleQuote():Text(".")
    end

    private action Activity35Minutes
        Section("Activity (35 minutes)")
        Paragraph():Strong("Group:"):Text(" Place students in pairs. One student per group should navigate to the lesson on Code Studio.")
        Subsection("Investigation #1: If Statements (15 mins)")
        TeachingTip()
        Paragraph():Strong("Running the First Investigation:"):Text(" This first investigation is supposed to get students moving around the room while also motivating them to carefully read a new program. As you circulate the room encourage them to read carefully, ask good questions, and be comfortable asking where they don't understand something.")
        EndCallout()
        Paragraph():Strong("Display:"):Text(" As a class, watch "):Link("Introduction to Conditionals (Video, Part A)", "https://youtu.be/0oG3Wck2fRU"):Text(".")
        Video("https://www.youtube.com/embed/0oG3Wck2fRU?si=JqJ-YS0MqCNEcKOO", "CSP: Conditionals pt 2A - if statements")
        TeachingTip()
        Paragraph():Strong("Show the Video at the Front:"):Text(" In order to better keep the group together we recommend you show the videos at the front of the room.")
        Paragraph():Strong("Reinforce When vs. If:"):Text(" As you make your way through these examples model using "):DoubleQuote():Text("when"):DoubleQuote():Text(" and "):DoubleQuote():Text("if"):DoubleQuote():Text(" as described in the warm up. For example, "):DoubleQuote():Text("when"):DoubleQuote():Text(" the buttons are clicked the app is deciding "):DoubleQuote():Text("if"):DoubleQuote():Text(" the temperature can change.")
        EndCallout()
        Paragraph():Strong("Open a Project:"):Text(" Direct students to open "):Strong("Lesson6_App1"):Text(".")
        Paragraph():Strong("Activity - Lemon Squeeze App (Part 1):"):Text(" This code investigation includes a number of steps to help students get familiar with a new app.")
        BulletList()
        ListItem("Form Pairs: Place students in pairs")
        ListItem("Play the Game: Let students play the game for a couple minutes")
        ListItem("Assign Code Sections: Count off pairs by three and assign them to one of the three code sections.")
        ListItem("Read Code: Groups should carefully read the code for their section making sure they understand how it works. Give them 3 minutes to do so.")
        ListItem("Explain Your Section: Have groups find members of the other two sections and carefully explain how their section works. Give each group 1-2 minutes to do so.")
        ListItem("Class Discussion: Ask a few members of each section to quickly share out how their section works. Display the code at the front so you can talk through it together.")
        ListItem("Modify: Have groups return to their original seats. Give them a couple minutes to work on the modify the app so that the game ends once a user has 0 lives remaining.")
        Subsection("Investigation #2: If-Else Statements (10 mins)")
        Paragraph():Strong("Display:"):Text(" As a class, watch "):Link("Introduction to Conditionals (Video, Part B)", "https://youtu.be/ZIL_3YRD14s"):Text(".")
        Video("https://www.youtube.com/embed/ZIL_3YRD14s?si=gLH6EQmebEnWJ4F7", "CSP: Conditionals pt 2B - if/else statements")
        Paragraph():Strong("Display:"):Text(" As a class, watch "):Link("Introduction to Conditionals (Video, Part C)", "https://youtu.be/aFssCTE5hs8"):Text(".")
        Video("https://www.youtube.com/embed/aFssCTE5hs8?si=-J3BUZYOP9urga9y", "CSP: Conditionals pt 2C - if/else if statements")
        Paragraph():Strong("Open a Project:"):Text(" Direct students to open "):Strong("Lesson6_App2"):Text(".")
        Paragraph():Strong("Activity - Lemon Squeeze App (Part 2):"):Text(" This program is an updated version of the Lemon Squeeze app. This time students should continue to work in partners but do not need to work with other groups. They will need to:")
        BulletList()
        ListItem("Play the Game: Have students play the game")
        ListItem("Discuss Changes: Talk through how the game plays differently now")
        ListItem("Find the "):Code("if-elseif"):Text(" command: Have students find the command")
        ListItem("Draw a flowchart: Students should draw a flow chart for the if-elseif command in their journals")
        ListItem("Modify the code: Modify the program to make the lemon even smaller when the player has more than 15 points.")
        TeachingTip()
        Paragraph():Strong("Running the Second Investigation:"):Text(" This second investigation remains focused on reading code, but students are more responsible than last time for showing their work. Students will need to create a flowchart for the new if-elseif statement and make more significant modfications to the code. Continue to emphasize open discussion and collaboration between partners.")
        EndCallout()
        Subsection("Investigation #3: Logical Operators AND OR (10 mins)")
        Paragraph():Strong("Display:"):Text(" As a class, watch "):Link("Introduction to Conditionals (Video, Part D)", "https://youtu.be/kyFdniI-ZZs"):Text(".")
        Video("https://www.youtube.com/embed/kyFdniI-ZZs?si=_eUAsR7wbNbsRr7r", "CS Principles: Conditionals - Part 3 " + dq + "And & Or" + dq + " Operators")
        Paragraph():Strong("Open a Project:"):Text(" Direct students to open "):Strong("Lesson6_App3"):Text(".")
        Paragraph():Strong("Activity - Lemon Squeeze App (Part 3):"):Text(" This program is a final version of the Lemon Squeeze app. Again students should work with partners.")
        TeachingTip()
        Paragraph():Strong("Running the Third Investigation:"):Text(" In this final investigation students are primarily working independently to design their flowchart and modify the code. While you should quickly have students share out what they noticed about how the app changed, spend most of your time circulating answering questions students have as they modify the programs or draw their flowcharts.")
        EndCallout()
        BulletList()
        ListItem():Strong("Play the Game:"):Text(" Have students play the game")
        ListItem():Strong("Discuss Changes:"):Text(" Talk through how the game plays differently now")
        ListItem():Strong("Find the "):Code("if-elseif"):Strong(" command:"):Text(" Have students find the if-else-if command that was added")
        ListItem():Strong("Draw a Flowchart:"):Text(" Students should draw a flowchart of this new if-elseif command")
        ListItem():Strong("Modify the code:"):Text(" Modify the program to add a new username and password. Students will have to modify the code as well as the user interface.")
    end

    private action WrapUp5Minutes
        Section("Wrap Up (5 minutes)")
        Paragraph():Strong("Discuss:"):Text(" What is the difference between an if-statement, an if-else statement, and an if-elseif statement? How are they similar?")
        TeachingTip()
        Paragraph():Strong("Discussion Goal:"):Text(" Some key points to call out in this discussion.")
        BulletList()
        ListItem("These statements are more the same than different. They all use boolean expressions to decide whether to run certain pieces of code.")
        ListItem("if-statements check if one boolean expression is true. If it is, a piece of code is run. Otherwise the code runs as normally.")
        ListItem("if-else statements add the functionality that if the condition is false it can still run some code before returning to running the program as normal")
        ListItem("if-elseif statements can check more than one boolean expression. They will only run the code for the first boolean expression that evaluates to true.")
        EndCallout()
        Paragraph():Strong("Review if-elseif:"):Text(" Review how to check multiple conditions by discussing the examples and documentation below.")
        Subsection("Checking Multiple Conditions with if-elseif")
        CodeExample("if temperature > 100
    output " + dq + "It's dangerously hot" + dq + "
elseif temperature > 90
    output " + dq + "It's very hot" + dq + "
elseif temperature > 80
    output " + dq + "It's hot" + dq + "
elseif temperature > 70
    output " + dq + "It's warm" + dq + "
else
    output " + dq + "It's cool" + dq + "
end")
        Subsubsection("How does it work?")
        Paragraph("The "):Code("if-elseif"):Text(" command lets you check multiple boolean conditions. The computer will check conditions in the order they are written until one of the boolean expressions evaluates to true. The code associated with that boolean expression will be run, but all others will be skipped. If none of the expressions evaluates to true then the code inside the "):Code("else"):Text(" command will be run.")
        Subsubsection("Most Specific Cases First")
        Paragraph("When writing an if-else-if statement you want to put the most specific cases first. In the temperature example above you want to check for temperatures over 100 degrees first. Afterwards the code checks for temperatures above 90 degrees, but because of the order the code is written you know that none of temperatures you'll find there are above 100 degrees. After all you would have caught them in the previous if-statement. This means you can be confident any temperatures you catch there will be between 90 and 100 degrees. As you continue through the if-else-if statement you use the same logic to check for different ranges of temperature.")
        Subsection("A Broken Example: Most Specific Cases Last")
        Paragraph("This is a broken example that shows what happens if you start checking for temperatures in reverse order, most specific cases last.")
        CodeExample("if temperature > 60
    output " + dq + "It's cool" + dq + "
elseif temperature > 70
    output " + dq + "It's warm" + dq + "
elseif temperature > 80
    output " + dq + "It's hot" + dq + "
elseif temperature > 90
    output " + dq + "It's very hot" + dq + "
else
    output " + dq + "It's dangerously hot" + dq + "
end")
        Paragraph("Think through what would happen when this code runs for the temperature 82 degrees. You would want the output to say "):DoubleQuote():Text("It's hot"):DoubleQuote():Text(". If you look at the first boolean expression, however, you'll notice that 82 is higher than 60 degrees, making that boolean expression evaluate to true. As a result the code will output "):DoubleQuote():Text("It's cool"):DoubleQuote():Text(". This is because the first expression is not actually the most specific.")
    end

    private action AssessmentCheckForUnderstanding
        Section("Assessment: Check for Understanding")
        Subsection("For Students")
        Paragraph("Open a word doc or google doc and copy/paste the following question.")
        Subsection("Question")
        Paragraph("When creating an if-elseif statement you should always make your first condition the most specific. Write a short paragraph responding to the questions below.")
        BulletList()
        ListItem("What does it mean to put the most specific case first?")
        ListItem("Why is it important to put the most specific case first? What types of errors does it help avoid?")
    end

    private action StandardsAlignment
        Section("Standards Alignment")
        BulletList()
        ListItem():Strong("CSTA K-12 Computer Science Standards (2017): "):Text("2-AP-10, 2-AP-12, 3B-AP-23")
        ListItem():Strong("CSP2021: "):Text("AAP-2.H.1, AAP-2.I.1")
    end
end
