use Libraries.Web.Page.QuorumPage

/*
    Variables, Conditionals, and Functions - Lesson 11: Functions Make.
    Converted from the old Lesson page by plan 13's generator: the same
    words, now without Tailwind.
*/
class CodeOrgUnit4Lesson11 is QuorumPage

    on create
        SetLocation("lessons/code/BigDataAndPrivacy/Lesson11.html")
        // The name lists and links use, and the series and track it belongs
        // to: its section and picture.
        SetShortTitle("Functions Make")
        SetSectionName("Variables, Conditionals, and Functions")
        // For search engines and link previews, and what lists of pages say.
        SetDescription("Make the Quote Maker app using functions")
        SetSummary("Make an app using functions")
    end

    action Setup
        SetWebPageTitle("Unit 4 Lesson 11: Functions Make")
        Title("Variables, Conditionals, and Functions - Lesson 11: Functions Make")
        Overview()
        GettingStarted2Minutes()
        Activity38Minutes()
        WrapUp5Minutes()
        AssessmentMakeProject()
        StandardsAlignment()
    end

    private action Overview
        Section("Overview")
        Paragraph("Using Programming Patterns and a step-by-step approach students make their own version of a Quote Maker app. At the beginning of the lesson students are able to explore a working version of the app. They are then given the design elements of the app but begin with a blank screen. Students use an Activity Guide to go through the high level steps they should use to develop their app but leaves it to them to decide how to write the code. At the end students submit their apps which can be assessed using a provided rubric.")
        Subsection("Goals")
        Paragraph("Students will be able to:")
        BulletList()
        ListItem("Recognize the need for a function to reduce repeated code while developing a functional app")
        ListItem("Implement a function using programming patterns while developing a functional app")
        ListItem("Write comments to clearly explain both the purpose and function of different segments of code within an app")
        ListItem("Use debugging skills as part of developing an app")
        Subsection("Purpose")
        Paragraph("This lesson is an opportunity for students to take on the "):DoubleQuote():Text("blank screen"):DoubleQuote():Text(" and build the code that runs an app entirely from scratch. Guidance provided throughout the lesson helps students break down the large task of "):DoubleQuote():Text("building an app"):DoubleQuote():Text(" into more incremental steps that they can use on future projects, including this unit's final project and the Create PT.")
        Subsection("Resources")
        BulletList()
        ListItem():Link("CSP-Widgets repository", "https://github.com/qorf/CSP-Widgets")
        Subsubsection("Supplemental Code.org material")
        Paragraph("For the students")
        BulletList()
        ListItem():Link("Quote Maker App - Activity Guide", "https://docs.google.com/document/d/1K_0TbgCTNsO52Nm4rzy_o3P0X80SI8nx0KwHhHpFfrk/edit?usp=sharing")
    end

    private action GettingStarted2Minutes
        Section("Getting Started (2 minutes)")
        TeachingTip()
        Paragraph():Strong("When to Make Functions:"):Text(" The end of the previous lesson and the beginning of this lesson both emphasize a transition students will go through in making functions. Early on they are likely to either not use functions or only realize the need one after they've already written duplicate code. As they get more experienced as programmers, however, they will likely realize sooner and sooner in the process that a function will be necessary. As students grow more experienced they should actually be able to anticipate and write their functions from the beginning of designing their program. Use this brief introduction to reinforce that language.")
        EndCallout()
        Subsection("Remarks")
        BulletList()
        ListItem("For the past few days, we've learned a lot about using functions to simplify code and make it easy to edit. So far we have learned how to use functions to remove repeated code in our programs. Early on it's common to realize you need a function only after you've completely written the same chunk of code in two places. As you get better, however, you'll realize sooner and sooner in the process that you're likely going to need a function, and will be able avoid writing repeated code before putting it inside a function. Eventually you'll want to anticipate what your functions are going to be even before you start programming. These are the "):DoubleQuote():Text("during"):DoubleQuote():Text(" and "):DoubleQuote():Text("before"):DoubleQuote():Text(" levels we read about yesterday.")
        ListItem("In today's Make lesson and the following project you'll have a chance to practice this. See if sometimes you can work that "):DoubleQuote():Text("during"):DoubleQuote():Text(" or "):DoubleQuote():Text("before"):DoubleQuote():Text(" category.")
    end

    private action Activity38Minutes
        Section("Activity (38 minutes)")
        Paragraph():Strong("Group:"):Text(" Make a determination as to whether this project will be completed in pairs or individually. You may even choose to let students decide.")
        Paragraph():Strong("Run a Project:"):Text(" Have students open the "):Strong("Unit 4 Lesson11_ExampleApp"):Text(" project from the CSP Widgets repository and run it. Ask them to explore the following in the app:")
        BulletList()
        ListItem("Try many of the different options.")
        ListItem("Pay attention to what is happening in the output window when you enter text or activate the buttons.")
        ListItem("When does the screen update?")
        ListItem("What happens if you choose lavender and Verdana from the buttons? Try choosing green and adjusting the font size until you receive feedback.")
        Paragraph():Strong("Discuss:"):Text(" If students are not working in pairs they should still discuss the prompts with a neighbor.")
        BulletList()
        ListItem("What does this app do?")
        ListItem("What are the inputs?")
        ListItem("What are the outputs?")
        ListItem("How could a function be used in this app?")
        DiscussionGoal()
        Subsection("Discussion Goal")
        BulletList()
        ListItem("What does this app do?")
        NestedBulletList()
        ListItem("Display a quote with user-defined fonts and background colors.")
        EndNestedList()
        ListItem("What are the inputs?")
        NestedBulletList()
        ListItem("The buttons for background color, font family, and font size.")
        ListItem("The quote text field.")
        EndNestedList()
        ListItem("What are the outputs?")
        NestedBulletList()
        ListItem("The fully designed quote displayed at the top of the screen")
        ListItem("The design feedback label at the end of the app")
        EndNestedList()
        ListItem("How could a function be used in this app?")
        NestedBulletList()
        ListItem("Students may struggle with this question, and it's ok to not have it fully answered before beginning the project.")
        ListItem("A function can be used to update the screen.")
        ListItem("The function contains the conditional that is checked everytime the user interacts with the screen.")
        EndNestedList()
        EndCallout()
        TeachingTip()
        Paragraph():Strong("Supporting Students:"):Text(" While students are working on their apps, circulate the room and check in with students who need a little help. Encourage students to collaborate and discuss bugs with each other.")
        Paragraph():Strong("Debugging:"):Text(" Review with students steps they can use to debug if they get stuck:")
        BulletList()
        ListItem("Add output statements to the code")
        ListItem("Explain the code to a friend")
        EndCallout()
        Subsection("Remarks")
        BulletList()
        ListItem("Now let's build this app. The screen has been set up for you - it's your job to add the code!")
        Paragraph():Strong("Open a Project:"):Text(" Have students open the "):Strong("CSP-Widget repository Lesson11_ProjectTemplate"):Text(" project.")
        Paragraph():Strong("Do This:"):Text(" Direct students to complete the Quote Maker App. An optional Activity Guide is provided if students would like guidance in creating the app. You may also choose to quickly review the UpdateScreen pattern with students, if needed.")
        Paragraph():Strong("Submit:"):Text(" Encourage students to check the rubric on the last page of the Activity Guide before submitting.")
    end

    private action WrapUp5Minutes
        Section("Wrap Up (5 minutes)")
        BulletList()
        ListItem("Awesome work today! Make sure to submit your project when you're done with it!")
        TeachingTip()
        Paragraph():Strong("Maximize Work Time:"):Text(" The wrap up is short to allow the maximum amount of time for students to complete the activity.")
        EndCallout()
    end

    private action AssessmentMakeProject
        Section("Assessment: Make Project")
        Paragraph():Strong("Assess:"):Text(" Use the rubric provided with the project to assess student projects.")
    end

    private action StandardsAlignment
        Section("Standards Alignment")
        BulletList()
        ListItem():Strong("CSTA K-12 Computer Science Standards (2017): "):Text("2-AP-19, 3A-AP-17, 3B-AP-14")
    end
end
