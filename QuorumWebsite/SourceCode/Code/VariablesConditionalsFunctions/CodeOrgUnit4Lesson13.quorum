use Libraries.Web.Page.QuorumPage

/*
    Variables, Conditionals, and Functions - Lesson 13: Project- Decision Maker App Part 2.
    Converted from the old Lesson page by plan 13's generator: the same
    words, now without Tailwind.
*/
class CodeOrgUnit4Lesson13 is QuorumPage

    on create
        SetLocation("lessons/code/BigDataAndPrivacy/Lesson13.html")
        // The name lists and links use, and the series and track it belongs
        // to: its section and picture.
        SetShortTitle("Project - Decision Maker App Part 2")
        SetSectionName("Variables, Conditionals, and Functions")
        // For search engines and link previews, and what lists of pages say.
        SetDescription("Build your decision making app")
        SetSummary("Unit Project Day 2")
    end

    action Setup
        SetWebPageTitle("Unit 4 Lesson 13: Project - Decision Maker App Part 2")
        Title("Variables, Conditionals, and Functions - Lesson 13: Project- Decision Maker App Part 2")
        Overview()
        GettingStarted2Minutes()
        Activity43Minutes()
        WrapUp0Minutes()
        StandardsAlignment()
    end

    private action Overview
        Section("Overview")
        Paragraph("Students translate the plans they documented in Part 1 of the Practice PT to a working program in through a series of steps.")
        Subsection("Goals")
        Paragraph("Students will be able to:")
        BulletList()
        ListItem("See rubric (Refer to Unit4 Lesson12 or supplemental document) for guidance in measuring student learning")
        Subsection("Purpose")
        Paragraph("The Practice PT gives students the opportunity to design and program an app from scratch. Welcome to The Decision Maker App! Students demonstrate mastery of variables, conditionals, and functions by combining these elements into a useful program designed to solve the problem of making a decision.")
        Subsection("Resources")
        BulletList()
        ListItem():Link("CSP-Widgets repository", "https://github.com/qorf/CSP-Widgets")
        Subsubsection("Supplemental Code.org material")
        Paragraph("For the students")
        BulletList()
        ListItem():Link("CSP Unit 4 Practice PT Rubric", "https://docs.google.com/document/d/1mldgFK3CJbsWnTS8WYVDtEY1e7V4c0_V0sv63dYUkG8/edit?usp=sharing")
        ListItem():Link("CSP Unit 4 Practice PT Planning Guide", "https://docs.google.com/document/d/1IojBJ1NQPDz4SajskdWq_6LSstg3_9EgpTAwQf63M5g/edit?usp=sharing")
    end

    private action GettingStarted2Minutes
        Section("Getting Started (2 minutes)")
        TeachingTip()
        Paragraph():Strong("Short Intro:"):Text(" The Warm Up today is short and light. Students should spend the maximum amount of time working on their projects.")
        EndCallout()
        Subsection("Remarks")
        BulletList()
        ListItem("Today we are continuing work on the Decision Maker App. You will follow a series of steps while constructing your app.")
    end

    private action Activity43Minutes
        Section("Activity (43 minutes)")
        TeachingTip()
        Paragraph():Strong("Supporting students in Practice PT Lessons")
        Paragraph("At this point in the project attention shifts to Quorum Studio where students design and program their app. Continue to circulate the room and check in with students as needed to make sure instructions are clear and students understand expectations.")
        Paragraph("What should you expect?")
        BulletList()
        ListItem("Planning Guides out on desks or tables so students can reference them while setting up their apps")
        ListItem("A healthy buzz in the classroom as students collaboratively debug")
        ListItem("There may be some student confusion on the steps to take in building their app. Direct students back to the instructions, and make sure they haven't skipped any of the steps.")
        EndCallout()
        Paragraph():Strong("Do This:"):Text(" Students now transition to Quorum Studio where they will build their app. Students should use the "):Strong("Unit_Project_Template"):Text(" project to build their apps.")
        Paragraph():Strong("Display:"):Text(" Share the steps for today with students.")
        Paragraph():Strong("Step 1:"):Text(" Design the App")
        BulletList()
        ListItem("Students create the screens they designed in Step 6 in the Planning Guide.")
        Paragraph():Strong("Step 2:"):Text(" Create the Variables")
        BulletList()
        ListItem("Using the list of variables from Step 4 in the Planning Guide students create their variables.")
        Paragraph():Strong("Step 3:"):Text(" Create the Function")
        BulletList()
        ListItem("This is most likely the trickiest step.")
        ListItem("Students create an "):Code("UpdateScreen"):Text(" function with a conditional statement")
        ListItem("Students should reference the flowchart in Step 5 of the Planning Guide to help craft the Boolean expression(s) for the conditional statement.")
        ListItem("A comment is added to explain what it does (purpose) and how it does that (functionality)")
        Paragraph():Strong("Step 4:"):Text(" Handle Events")
        BulletList()
        ListItem("Students should add code to the event handling actions to update the appropriate variables and add a call to the "):Code("UpdateScreen"):Text(" function.")
        ListItem("Students don't need to add code to all of the event handling actions, only the ones they need for their app.")
    end

    private action WrapUp0Minutes
        Section("Wrap Up (0 minutes)")
        Paragraph("No wrap up today. All time should be spent on the project.")
    end

    private action StandardsAlignment
        Section("Standards Alignment")
        BulletList()
        ListItem():Strong("CSTA K-12 Computer Science Standards (2017): "):Text("2-AP-10, 2-AP-11, 3A-AP-16, 3B-AP-14")
    end
end
