use Libraries.Web.Page.QuorumPage

/*
    Variables, Conditionals, and Functions - Lesson 7: Conditionals Practice.
    Converted from the old Lesson page by plan 13's generator: the same
    words, now without Tailwind.
*/
class CodeOrgUnit4Lesson7 is QuorumPage
    // A double quote, for code and words that hold one.
    text dq = ""

    on create
        SetLocation("lessons/code/BigDataAndPrivacy/Lesson7.html")
        // The name lists and links use, and the series and track it belongs
        // to: its section and picture.
        SetShortTitle("Conditionals Practice")
        SetSectionName("Variables, Conditionals, and Functions")
        // For search engines and link previews, and what lists of pages say.
        SetDescription("Practice using conditionals in a series of projects")
        SetSummary("Practice using conditionals")
    end

    action Setup
        dq = dq:GetDoubleQuote()
        SetWebPageTitle("Unit 4 Lesson 7: Conditionals Practice")
        Title("Variables, Conditionals, and Functions - Lesson 7: Conditionals Practice")
        Overview()
        GettingStarted5Minutes()
        Activity35Minutes()
        WrapUp5Minutes()
        AssessmentCheckForUnderstanding()
        StandardsAlignment()
    end

    private action Overview
        Section("Overview")
        Paragraph("In this lesson students spend most of their time practicing using the skills and processes they have learned about conditionals. At the conclusion of the lesson students discuss the main things they realized and still have questions about at the conclusion of this lesson.")
        Subsection("Goals")
        Paragraph("Students will be able to:")
        BulletList()
        ListItem("Write programs that use boolean expressions and conditional statements with the support of sample code.")
        ListItem("Debug programs that use boolean expressions and conditional statements")
        Subsection("Purpose")
        Paragraph("This lesson is students primary opportunity to get hands on with conditionals in code prior to the Make activity in the following lesson. Give students as much class time as you can to work through these. For this lesson it's recommended that you place students in pairs as a support and to encourage discussion about the challenges or concepts they're seeing. In the following lesson students are encouraged to work independently.")
    end

    private action GettingStarted5Minutes
        Section("Getting Started (5 minutes)")
        Subsection("Remarks")
        BulletList()
        ListItem("Today we're going to have a chance to practice programming with a lot of the concepts and patterns we've explored over the last two lessons. I encourage you to go through these with a partner, but pay close attention to what each other is doing. In our next lesson you're going to have to use a lot of these on an independent project, and these activities are good practice for what you'll find there! Alright, let's get to it!")
        TeachingTip()
        Paragraph():Strong("Move Quickly to the Activity:"):Text(" There's a lot in the main activity of today's lesson. You may optionally wish to do a quick vocabulary review or address any questions that came up in the last lesson. Otherwise, give students more time to get hands on with some code.")
        EndCallout()
    end

    private action Activity35Minutes
        Section("Activity (35 minutes)")
        Paragraph():Strong("Group:"):Text(" It is recommended that students work in pairs for this lesson and a number of the activities feature discussion prompts. Consider using pair programming, having drivers and navigators switch every 3 minutes, not every project.")
        Paragraph():Strong("Open a Project:"):Text(" Direct students to open the "):Strong("Lesson7_App1"):Text(" project. Students will start with this project, then move through each Lesson7 project until they finish with Lesson7_App9. Before students start, briefly remind them about debugging skills that they will be using in today's activity.")
        Subsection("Remarks")
        BulletList()
        ListItem("Today you're mostly going to practice what we've learned about programming with conditionals. As always you should be using the debugging process to help you as you work on issues. Today we're also going to be working on finding two types of errors:")
        NestedNumberedList()
        ListItem("- Syntax errors show up when you type code that breaks the rules of the programming language. You can check for errors and warnings")
        ListItem("- Logic errors show up when you type valid code but it works incorrectly. Today you're going to focus on testing your code to make sure you don't have logic errors.")
        EndNestedList()
        ListItem("Other errors you may encounter include:")
        NestedBulletList()
        ListItem("- Run-time error - a mistake in the program that shows when running the program. These are defined by the programming language.")
        ListItem("- Overflow error - an error that occurs when a computer tries to handle a number outside of the defined range of values.")
        EndNestedList()
        Paragraph():Strong("Projects 1-3:"):Text(" These levels only use the "):Code("output"):Text(" command which prints commands in the debug console. Here are a few things to keep an eye out for:")
        BulletList()
        ListItem("Projects 1-2 ask students to write Boolean expressions using comparison operators. Students may need to quickly review the comparison operators ("):Code("<, >, <=, >=, =, not="):Text(")")
        ListItem("Project 4 asks students to write Boolean expressions with logical operators ("):Code("and, or, not"):Text(")")
        TeachingTip()
        Paragraph():Strong("Providing Support:"):Text(" Circulate around the room through the lesson encouraging students to use the strategies introduced at the beginning of the lesson. Students have a number of supports at their fingertips, so a big part of your role is helping build their independence in using those resources.")
        EndCallout()
        Paragraph():Strong("Projects 4-8:"):Text(" These levels practice if-statements while working with a star color-changing app.")
        BulletList()
        ListItem("Projects 4-5 involve setting up an if-statement that becomes an if-else statement.")
        ListItem("In Project 6 students follow a pattern to create a lengthy if-else-if statement.")
        ListItem("For Project 7, make sure students understand what's happening. Students can use "):Code("output"):Text(" statements in each of the if-else-if blocks to see which sections are triggering.")
        ListItem("Project 8 demonstrates that Boolean expressions can be written as conditional statements, and vice versa")
        Paragraph():Strong("Project 9:"):Text(" This two-part project returns to the "):DoubleQuote():Text("Can I Adopt a Cat?"):DoubleQuote():Text(" flowchart from the Conditionals Explore activity. Students will use the flowchart to work out the logic of the if-statements in a their program.")
        BulletList()
        ListItem("A new type of code appears in this project, "):Code("cast"):Text(". A cast is a special command that changes data from one type to another. Here, it's used to turn text into a number that can be used mathematically.")
        ListItem("The second half of the project can be completed many different ways. There are different combinations of Boolean expressions using "):Code("and"):Text(" and "):Code("or"):Text(". Students should regularly test their apps to see if their Boolean expressions are working properly.")
        Subsection("Extension Opportunities")
        BulletList()
        ListItem("Project 3: Students can add more variables and create complex Boolean expressions. One challenge might be to assign a String to a variable and compare that string to another.")
        ListItem("Project 9: There are multiple solutions. If students build their if-statement using only "):Code("and"):Text(" encourage them to figure out how to build it using only "):Code("or"):Text(". They may need to switch the content of the if and else branches.")
        ListItem("Project 9: Create another input (i.e. How many cats do you already own?). Students use this information to craft more complex if-statements.")
    end

    private action WrapUp5Minutes
        Section("Wrap Up (5 minutes)")
        Paragraph():Strong("Discuss:"):Text(" What aspects of working with conditionals do you feel like clicked today? What do you still feel like you have trouble with?")
        TeachingTip()
        Paragraph():Strong("Discussion Goal:"):Text(" Use this opportunity to address any lingering questions or misconceptions in the room. You can also use this as a source of discussion topics to kick off the following lesson. As you lead the discussion, call out the many resources students have access to help when they're getting stuck.")
        EndCallout()
        Subsection("Remarks")
        BulletList()
        ListItem("Conditionals can be a little bit tricky, but I saw a lot of good progress today in nailing down this concept. We may have a few lingering questions, but you also have a lot of resources available. Next time you'll have a chance to put all this together by programming an app that starts with "):DoubleQuote():Text("the blank screen"):DoubleQuote():Text("!")
    end

    private action AssessmentCheckForUnderstanding
        Section("Assessment: Check for Understanding")
        Paragraph():Strong("AP Reference:"):Text(" The questions below reflect how questions will be represented on the AP exam. You can use the "):Link("AP CSP Reference Sheet and Quorum Info", "/files/code/AP CSP Reference sheet and Quorum info.docx"):Text(" resource to see more about how the exam is presented and the differences between Quorum and the reference language.")
        Subsection("Question 1")
        Paragraph("What will be displayed afer this code segment is run?")
        CodeExample("F (lives = 0)
{
    DISPLAY(" + dq + "You Lose!" + dq + ")
}
ELSE
{
    IF ((score >= 5) AND (lives = 3))
    {
        DISPLAY(" + dq + "Perfect Game!" + dq + ")
    }
    ELSE
    {
        DISPLAY(" + dq + "You Win!" + dq + ")
    }
}")
        Paragraph():Strong("Choose one of the following:")
        NumberedList()
        ListItem("Perfect Game!")
        ListItem("You Win!")
        ListItem("You Lose!")
        ListItem("Nothing will be displayed")
        Subsection("Question 2")
        Paragraph("The program below asks a user to type in a number and then will output a message. What number will a user need to input for the message "):DoubleQuote():Text("COLD"):DoubleQuote():Text(" to be displayed?")
        CodeExample("number <- INPUT()

IF (number >= 10)
{
    IF (number <= 20)
    {
        DISPLAY(" + dq + "MEDIUM" + dq + ")
    }
    ELSE
    {
        DISPLAY(" + dq + "HOT" + dq + ")
    }
}
ELSE
{
    DISPLAY(" + dq + "COLD" + dq + ")
}")
        Paragraph():Strong("Choose one of the following:")
        NumberedList()
        ListItem("5")
        ListItem("10")
        ListItem("15")
        ListItem("20")
    end

    private action StandardsAlignment
        Section("Standards Alignment")
        BulletList()
        ListItem():Strong("CSTA K-12 Computer Science Standards (2017): "):Text("2-AP-10, 2-AP-12")
        ListItem():Strong("CSP2021: "):Text("AAP-2.E.2")
        ListItem():Strong("CSP2021: "):Text("AAP-2.F.1, AAP-2.F.2, AAP-2.F.3, AAP-2.F.4")
        ListItem():Strong("CSP2021: "):Text("AAP-2.H.2, AAP-2.H.3")
        ListItem():Strong("CSP2021: "):Text("AAP-2.L.3, AAP-2.L.4")
        ListItem():Strong("CSP2021: "):Text("AAP-3.A.9")
        ListItem():Strong("CSP2021: "):Text("CRD-2.I.1, CRD-2.I.2, CRD-2.I.3, CRD-2.I.4")
        ListItem():Strong("CSP2021: "):Text("CRD-2.J.2")
    end
end
