use Libraries.Web.Page.QuorumPage

/*
    Variables, Conditionals, and Functions - Lesson 1: Variables Explore.
    Converted from the old Lesson page by plan 13's generator: the same
    words, now without Tailwind.
*/
class CodeOrgUnit4Lesson1 is QuorumPage
    // A double quote, for code and words that hold one.
    text dq = ""

    on create
        SetLocation("lessons/code/BigDataAndPrivacy/Lesson1.html")
        // The name lists and links use, and the series and track it belongs
        // to: its section and picture.
        SetShortTitle("Variables Explore")
        SetSectionName("Variables, Conditionals, and Functions")
        SetCardImage("/media/userInterface/quorumAssets/cspImages/csp4.svg")
        SetCardDescription("This unit explores how variables, conditionals, and functions allow for the design of increasingly complex apps.")
        // For search engines and link previews, and what lists of pages say.
        SetDescription("Learn about variables using an unplugged activity")
        SetSummary("Explore the concept of variables")
    end

    action Setup
        dq = dq:GetDoubleQuote()
        SetWebPageTitle("Unit 4 Lesson 1: Variables Explore")
        Title("Variables, Conditionals, and Functions - Lesson 1: Variables Explore")
        Overview()
        GettingStarted5Minutes()
        Activity40Minutes()
        WrapUp10Minutes()
        AssessmentCheckForUnderstanding()
        StandardsAlignment()
    end

    private action Overview
        Section("Overview")
        Paragraph("To begin the lesson students explore sample apps similar to the ones they'll be able to build by the end of the unit. Then students complete an unplugged activity with plastic baggies and sticky notes to build a mental model of how variables are used to move and store information. The lesson ends with a synthesizing discussion and students adding key vocabulary to their journal.")
        Subsection("Goals")
        Paragraph("Students will be able to:")
        BulletList()
        ListItem("Use appropriate vocabulary to describe variables, expressions, and variable assignment.")
        ListItem("Evaluate expressions that include numbers, strings, and arithmetic operators.")
        ListItem("Trace simple programs that use variables, expressions, and variable assignment.")
        Subsection("Purpose")
        Paragraph("The warm up activity is designed to provide context for the coming unit and motivate the reasons students will want to learn the concepts covered in Unit 4. The subsequent activity provides students a physical mental model they will be able to use when they start programming with variables in the subsequent lessons.")
        Subsection("Preparation")
        BulletList()
        ListItem("Collect for each pair of students:")
        NestedBulletList()
        ListItem("- 3 sandwich baggies")
        ListItem("- packs of red and yellow stickies")
        ListItem("- pens / pencils")
        ListItem("- 1 dry erase marker per four students (pairs can share)")
        EndNestedList()
        ListItem("Review the sample apps shown in the warm up")
        ListItem("Review the rules and vocabulary used in the activity")
        Subsection("Resources")
        BulletList()
        ListItem():Link("EIPM: A Short Introduction (Teacher Resource)", "https://docs.google.com/document/d/1ncil5b0yWAN4LCyOeXwYuNrNKEHtN4nmAd2o-_K5Psw/edit?usp=sharing")
        ListItem():Link("Code.org CSP Unit 4 Presentation Slides", "https://docs.google.com/presentation/d/1GhpZOh2589s9MuKsll7YkQ3xv6nwcpmtAnTCgJPIXC0/copy")
        ListItem():Link("Guide to EIPM Lessons - Video", "https://www.youtube.com/watch?v=OTvi0XRTIjA")
        ListItem():Link("Guide to Explore Lessons - Video", "https://youtu.be/mzm-xqXH8BQ")
        ListItem():Link("CSP-Widgets Repository", "https://github.com/qorf/CSP-Widgets")
        TeachingTip()
        Paragraph("This is the first official "):DoubleQuote():Text("Explore"):DoubleQuote():Text(" lesson in the EIPM model. Review the EIPM model in the "):Link("EIPM: A Short Introduction - Resource", "https://docs.google.com/document/d/1ncil5b0yWAN4LCyOeXwYuNrNKEHtN4nmAd2o-_K5Psw/edit?usp=sharing")
        Paragraph():Strong("Overview:"):Text(" Students explore the new concept through a teacher-led hands-on group activity.")
        BulletList()
        ListItem("Typically uses physical manipulatives")
        ListItem("Teacher leads with support of slides and activity guides")
        Paragraph():Strong("Goal:"):Text(" Students begin to develop a shared mental model and understand the main ideas of the new concept.")
        Image("media/lessons/csp/unit4/explore_thumbnail.png", "A sketch showcasing students performing an unplugged activity to explore the concept of variables.")
        Paragraph("Watch the following videos:")
        BulletList()
        ListItem():Link("Guide to EIPM Lessons", "https://www.youtube.com/watch?v=OTvi0XRTIjA")
        ListItem():Link("Guide to Explore Lessons", "https://www.youtube.com/watch?v=mzm-xqXH8BQ")
        EndCallout()
    end

    private action GettingStarted5Minutes
        Section("Getting Started (5 minutes)")
        Subsection("Explore Sample Apps")
        Paragraph():Strong("Group:"):Text(" Place students in pairs.")
        Paragraph():Strong("Do This:"):Text(" Give students 3-5 minutes to explore the sample apps (beginning with "):Strong("Lesson1_App1"):Text(" in Unit4 of the "):Link("CSP-Widgets repository", "https://github.com/qorf/CSP-Widgets"):Text("). Students can explore one or more depending on time.")
        Paragraph():Strong("Discuss:"):Text(" These are samples of the kinds of apps you'll be able to build by the end of this unit. As you go through them, write down at least two examples where the app seems to be keeping track of a piece of information or using it to make decisions.")
        DiscussionGoal()
        Paragraph():Strong("Discussion Goal:"):Text(" Have volunteers share what they noticed with the room. Some ideas include:")
        BulletList()
        ListItem("The Pet Rock App keeps track of button selections and uses it to decide when the pet rock will "):DoubleQuote():Text("evolve"):DoubleQuote()
        ListItem("The Poem App keeps track of the poem as you write it.")
        EndCallout()
        Subsection("Preview the Unit")
        BulletList()
        ListItem("Last unit we built apps that mostly focused on input and output. For example:")
        NestedBulletList()
        ListItem("- When button is selected, show a picture")
        ListItem("- When button is selected, change screen")
        ListItem("- When button is selected, play a sound")
        EndNestedList()
        ListItem("But we all want our programs to do more than that! In this unit we're going to learn how to build apps that keep track of information and use to make decisions and perform calculations. This is going to let us build much more powerful apps! So let's get started by diving in deep on what's involved with programming with information.")
    end

    private action Activity40Minutes
        Section("Activity (40 minutes)")
        Paragraph():Strong("Group:"):Text(" Group students in pairs.")
        Paragraph():Strong("Distribute: Give each pair of students")
        BulletList()
        ListItem("A small stack of red and yellow sticky notes")
        ListItem("A pen / pencil")
        ListItem("3 plastic baggies")
        ListItem("A dry erase marker to share with another group")
        TeachingTip()
        Paragraph():Strong("Supplies Substitutions:"):Text(" There's no need to use stickie notes if you have other scraps of colored paper. Also consider cutting stickies in 4 to make them go further. If you don't have dry erase markers handy consider using pieces of masking tape on the baggies.")
        Paragraph():Strong("Alternatives for Accessibility or Distance Learning:"):Text(" When working with students remotely or students who are blind or visually impaired, consider having students type into an online document rather than using sticky notes or baggies. In this case, individual values can be represented on a single line, where strings are denoted by quotes and numbers don't have quotes. To represent variables, have students write the variable name followed by its value on a single line. Students form expressions by combining standalone values, variables, and operators on a single line.")
        Paragraph("Using an online document in this way will produce lines of text that will look a lot like code. The important part of the lesson is bringing attention to the concept of storing information in one place, using it again later, or replacing the information in that place with new values.")
        EndCallout()
        Paragraph():Strong("Guided Activity:"):Text(" Today's activity introduces students to the concept of variables. As a visual aid, you can use "):Link("Code.org's presentation slides for Unit 4, Lesson 1: Variables Explore", "https://docs.google.com/presentation/d/1GhpZOh2589s9MuKsll7YkQ3xv6nwcpmtAnTCgJPIXC0/copy"):Text(". These slides include animations. The notes below describe when to move to the next slide or click through an animation -- if you aren't using the slides, you can ignore these prompts.")
        TeachingTip()
        Paragraph():Strong("Running the Activity:"):Text(" This activity asks students to follow along as a number of core concepts for programming are introduced. The model is typically that a term or concept is introduced and modeled and then afterwards students are encouraged to try it out on their own. Trying it out typically means they are writing information on a sticky note and sharing it with another group before discussing the results with the whole class.")
        Paragraph("Slides with animations have an icon in the bottom left corner to let you know you need to click to reveal more of the slide's content.")
        Paragraph("To help you more easily prepare the activity and keep track of your instructions, detailed instructions have been included as speaker notes in the presentation. Here are some tips to help you throughout the presentation.")
        BulletList()
        ListItem("There are opportunities throughout the presentation for students to actively engage. At these moments students should be making things with their manipulatives or using them to answer questions. Use these opportunities to check progress.")
        ListItem("There is a fair amount of new vocabulary introduced but it is introduced gradually and with intentional repetition. Make a point of actively modeling the use of new terms.")
        ListItem("The most important goal here is building a mental model. It is ok if students have some open questions that will get resolved over the subsequent conditional lessons.")
        ListItem("Both you and students can use the "):DoubleQuote():Text("Key Takeaways"):DoubleQuote():Text(" to check your understanding at the end.")
        EndCallout()
        Subsection("Guided Activity")
        Paragraph("Follow this lesson with the supplemental slides.")
        Paragraph():Strong("Slide:"):Text(" Variables Explore")
        Paragraph():Strong("Say:"):Text(" Today we are going to explore Variables.")
        Paragraph():Strong("Slide:"):Text(" Value: Numbers, Strings")
        Paragraph():Strong("Say:"):Text(" We're going to be thinking about how computers work with information. We're going to call one "):DoubleQuote():Text("piece"):DoubleQuote():Text(" of information a "):DoubleQuote():Text("value"):DoubleQuote():Text(". Right now there are two different types of values: numbers and strings. There are a few ways to tell them apart. Numbers work the way you normally think of numbers. They are made of the digits 0 through 9. We are going to put numbers on yellow sticky notes. When we write numbers you don't need quotes. Strings are made of any characters you can see on the keyboard which means all these examples count as strings. Strings go inside double quotes. You can see how it would be important to tell the number 123 apart from the string "):DoubleQuote():Text("123"):DoubleQuote():Text(".")
        Paragraph():Strong("Do This:"):Text(" Make one string and one number and hold it up at your table.")
        Paragraph():Strong("Slide:"):Text(" Operators")
        Paragraph():Strong("Say:"):Text(" Operator is just a fancy name for the plus, minus, multiply, and divide symbols. An expression is a combination of two sticky notes and an operator. When I ask you "):DoubleQuote():Text("what's 2 plus 3"):DoubleQuote():Text(" you say "):DoubleQuote():Text("5"):DoubleQuote():Text("! You just "):DoubleQuote():Text("evaluated"):DoubleQuote():Text(" the expression 2+3, or figured out what the value is. Since 5 is a number, we put it on a yellow sticky. When evaluating an expression, we follow order of operations - just like in math class.")
        Paragraph():Strong("Do This:"):Text(" Evaluate the expression 5-1 and make a sticky note. Make sure you pick the correct color and decide if you need quotes or not!")
        Paragraph():Strong("Slide:"):Text(" Expression Table")
        Paragraph():Strong("Say:"):Text(" This table shows the different ways we can create expressions. We can use all four operators with numbers the normal way. When you want to use strings, you can only use the + operator and it connects the two words together. If you're connecting a number and a string, the number first gets converted to a string.")
        BulletList()
        ListItem("3 + 4 evaluates to 7")
        ListItem("5 - 2 evaluates to 3")
        ListItem("11 * 2 evaluates to 22")
        ListItem("10 / 2 evaluates to 5")
        ListItem():DoubleQuote():Text("for"):DoubleQuote():Text(" + "):DoubleQuote():Text("ever"):DoubleQuote():Text(" evaluates to "):DoubleQuote():Text("forever"):DoubleQuote()
        ListItem():DoubleQuote():Text("gr"):DoubleQuote():Text(" + 8 evaluates to "):DoubleQuote():Text("gr8"):DoubleQuote()
        ListItem("2 + "):DoubleQuote():Text("day"):DoubleQuote():Text(" evaluates to "):DoubleQuote():Text("2day"):DoubleQuote()
        Paragraph():Strong("Do This:"):Text(" With your partner make a sticky note for each of these 5 expressions and we'll share as a class.")
        NumberedList()
        ListItem("4 + 5")
        ListItem("10 - 9")
        ListItem():DoubleQuote():Text("tree"):DoubleQuote():Text(" + "):DoubleQuote():Text("house"):DoubleQuote()
        ListItem():DoubleQuote():Text("you"):DoubleQuote():Text(" + "):DoubleQuote():Text("r"):DoubleQuote()
        ListItem("3 + "):DoubleQuote():Text("D"):DoubleQuote()
        Paragraph():Strong("Click for animation:"):Text(" Click through to see the answers on the slide.")
        Paragraph():Strong("Slide:"):Text(" Variables")
        Paragraph():Strong("Say:"):Text(" We're going to call the plastic baggies on your table "):DoubleQuote():Text("variables"):DoubleQuote():Text(". Variables can hold at most one value, or sticky note. They have names that use no quotes, include no spaces, and must start with a letter. For now just practice making a variable with your partner.")
        Paragraph():Strong("Do This:"):Text(" Make one variable with any name you like. Share it with another group. Make sure you use a whiteboard marker so we can reuse the baggies later.")
        Paragraph():Strong("Slide:"):Text(" Variables and Expressions")
        Paragraph():Strong("Say:"):Text(" We can evaluate expressions that include variable names. To do that, first make a copy of the sticky note inside the variable. Then evaluate the expression the way you normally would. These two examples show you how.")
        BulletList()
        ListItem("Example #1:")
        NestedNumberedList()
        ListItem("- zip = 5")
        ListItem("- 3 + zip evaluates to 3 + 5")
        ListItem("- 3 + 5 evaluates to 8")
        EndNestedList()
        ListItem("Example #2:")
        NestedNumberedList()
        ListItem("- bop = "):DoubleQuote():Text("hi"):DoubleQuote()
        ListItem("- bop + zip evaluates to "):DoubleQuote():Text("hi"):DoubleQuote():Text(" + 5")
        ListItem("- "):DoubleQuote():Text("hi"):DoubleQuote():Text(" + 5 evaluates to "):DoubleQuote():Text("hi5"):DoubleQuote()
        EndNestedList()
        Paragraph():Strong("Click for animation:"):Text(" Click through to see the answers to the examples on the slides.")
        Paragraph():Strong("Slide:"):Text(" Do This: Evaluate these expressions.")
        Paragraph():Strong("Do This:"):Text(" Evaluate these expressions. Make sure to pay attention to whether it evaluates to a string or a number.")
        Paragraph():Emphasis("Variables:")
        BulletList()
        ListItem("boo = 4")
        ListItem("rar = "):DoubleQuote():Text("be"):DoubleQuote()
        Paragraph():Emphasis("Expressions:")
        NumberedList()
        ListItem("3 * boo")
        ListItem("rar + "):DoubleQuote():Text("ep"):DoubleQuote()
        ListItem("rar + boo")
        Paragraph():Strong("Note:"):Text(" Have students share their answers by holding up the sticky notes for each solution.")
        Paragraph():Strong("Click for animation:"):Text(" Click through to see the answers.")
        Paragraph():Strong("Slide:"):Text(" Let's start writing programs...")
        Paragraph():Strong("Say:"):Text(" Now let's write programs. We're going to stop using sticky notes, but will highlight strings and numbers to help you remember the difference.")
        Paragraph():Strong("Slide:"):Text(" var")
        Paragraph():Strong("Say:"):Text(" Here's what a program looks like. The var command tells the computer to create a variable.")
        BulletList()
        ListItem():Emphasis("var pow"):Text(" : creates a new variable. Grab a new baggie and write the variable's name (in this case, "):DoubleQuote():Text("pow"):DoubleQuote():Text(") on it.")
        TeachingTip()
        Paragraph():Strong("Teaching Tip:"):Text(" The slides show code examples that reflect how variables are used in Javascript, which is used for Code.org's App Lab. At this point, the concept of variables is more important than the exact code. There will be opportunities in later slides to discuss the differences between how the two languages handle variables.")
        EndCallout()
        Paragraph():Strong("Slide:"):Text(" "):DoubleQuote():Text("Assignment operator"):DoubleQuote()
        Paragraph():Strong("Say:"):Text(" The left arrow is called the "):DoubleQuote():Text("assignment operator"):DoubleQuote():Text(". That's just a fancy word for "):DoubleQuote():Text("put this value in the baggy"):DoubleQuote():Text(". If we wanted to read line 01 we would say "):DoubleQuote():Text("pow gets 3"):DoubleQuote():Text(". We know that variables can only hold one sticky note or value. So if we try to assign a variable that already has a value in it, we just throw the old one away.")
        Paragraph():Strong("Do This:"):Text(" Run this program. What is the result?")
        NumberedList()
        ListItem("var pow")
        ListItem("pow <- 3")
        ListItem("pow <- 5")
        Paragraph():Strong("Click for animation:"):Text(" Click through to run the program.")
        Paragraph():Strong("Say:"):Text(" In a computer you don't actually put the old number in a trash can, it's totally deleted! The numbers are stored as electrical charges somewhere in your computer's memory. When you assign a new number to a variable it actually erases the old number, and stores the new number in its place.")
        Paragraph():Strong("Slide:"):Text(" Do This...")
        Paragraph():Strong("Do This:"):Text(" Run this program. Compare your results with another group.")
        NumberedList()
        ListItem("var pizza")
        ListItem("pizza <- 3")
        ListItem("var tacos")
        ListItem("pizza <- "):DoubleQuote():Text("yum"):DoubleQuote()
        ListItem("tacos <- "):DoubleQuote():Text("the best"):DoubleQuote()
        Paragraph():Strong("Note:"):Text(" Walk around the room making sure students are following the rules correctly. No baggies should have more than one sticky note in them.")
        Paragraph():Strong("Click for animation:"):Text(" Click through to see the answers.")
        TeachingTip()
        Paragraph():Strong("Teaching Tip:"):Text(" This is a good opportunity to highlight the difference between variables in Javascript and Quorum. In Javascript, a single variable can hold different types of values over a program -- for example, the "):DoubleQuote():Text("pizza"):DoubleQuote():Text(" in this program stores a number, then replaces it with a string. In Quorum, this isn't allowed, because variables must store a specific type. Rather than declaring "):DoubleQuote():Text("var pizza"):DoubleQuote():Text(", we might've declared "):DoubleQuote():Text("number pizza"):DoubleQuote():Text(" or "):DoubleQuote():Text("text pizza, but it couldn't store both.")
        Paragraph("Alternately you can use the Quorum code found in "):Strong("Lesson1_SlideAnswers"):Text(" project folder in the CSP-Widget repository.")
        Paragraph("If you want to highlight this, you can use this optional prompt:")
        Paragraph():Strong("Discuss:"):Text(" In our program, we can store either a string or a number in the same variable. What if we said each variable could only hold one type of value instead? What are some of the advantages or disadvantages of that approach?")
        BulletList()
        ListItem("Allowing variables to hold any type makes them more flexible and makes them easier to reuse.")
        ListItem("Restricting what types each variable can hold makes them more consistent and predictable -- a text variable always contains text, for example.")
        ListItem("These two approaches are known as "):Emphasis("dynamic typing"):Text(" and"):Emphasis("static typing"):Text(", respectively, and both are very common in real-world programming languages!")
        EndCallout()
        Paragraph():Strong("Slide:"):Text(" Assign a Variable with Expression")
        Paragraph():Strong("Say:"):Text(" Now let's combine what we've learned. You can use assignment with expressions. In order for this to work you need to evaluate first, then assign. This makes sense because we know we can only put one sticky note in the variable baggy.")
        Paragraph():Strong("Slide:"):Text(" Do This...")
        Paragraph():Strong("Do This:"):Text(" Run the program. Compare your results with another group.")
        NumberedList()
        ListItem("var zow")
        ListItem("var fly")
        ListItem("fly <- 2 + "):DoubleQuote():Text("day"):DoubleQuote()
        ListItem("zow <- 4 - 1")
        ListItem("fly <- 3 * 3")
        ListItem("zow <- 4 + "):DoubleQuote():Text("now"):DoubleQuote()
        Paragraph():Strong("Note:"):Text(" Walk around the room making sure students are evaluating before they assign. Reinforce the language "):DoubleQuote():Text("gets"):DoubleQuote():Text(" for the assignment operator. For example, line 02 would read "):DoubleQuote():Text("fly gets two plus day"):DoubleQuote():Text(".")
        Paragraph():Strong("Click for animation:"):Text(" Click through to see the answers.")
        Paragraph():Strong("Slide:"):Text(" We're not going to...")
        Paragraph():Strong("Say:"):Text(" We're not going to highlight our strings and numbers anymore. We can just use double quotes around the strings to tell the difference. "):Emphasis("(NOTE: If you aren't using the slides or otherwise highlighting the values, you can skip this.)")
        Paragraph():Strong("Slide:"):Text(" Assign a Variable: Expressions with Variables")
        Paragraph():Strong("Say:"):Text(" Let's run this program. Evaluate the expression on the right first to get one value. Note that variables aren't "):DoubleQuote():Text("connected."):DoubleQuote():Text(" Changing kit doesn't change boo.")
        Paragraph():Strong("Do This:"):Text(" Run through this program together as a class.")
        NumberedList()
        ListItem("var kit")
        ListItem("kit <- 1")
        ListItem("var boo")
        ListItem("boo <- kit + 1")
        ListItem("kit <- 5")
        Paragraph():Strong("Note:"):Text("Reinforce:")
        BulletList()
        ListItem("Evaluate, then asssign.")
        ListItem("As shown on line 04, there's no special "):DoubleQuote():Text("connection"):DoubleQuote():Text(" made between variables. All we're doing is moving information around.")
        ListItem("Variables only hold one value, the old one is "):DoubleQuote():Text("thrown away"):DoubleQuote():Text(" (again, what's happening is that assignment replaces the electric charges somewhere inside the computer so the old value is actually "):DoubleQuote():Text("erased"):DoubleQuote():Text(" or "):DoubleQuote():Text("deleted"):DoubleQuote():Text(")")
        Paragraph():Strong("Click for animation:"):Text(" Click through to see the answers.")
        Paragraph():Strong("Slide:"):Text(" Do This:")
        Paragraph():Strong("Do This:"):Text(" Run this program. Compare your results with another group.")
        NumberedList()
        ListItem("var fuzz")
        ListItem("var clip")
        ListItem("fuzz <- 5")
        ListItem("clip <- fuzz + 2")
        ListItem("fuzz <- clip + 1")
        ListItem("clip <- "):DoubleQuote():Text("gr"):DoubleQuote():Text(" + fuzz")
        ListItem("fuzz <- fuzz + 1")
        ListItem("fuzz <- fuzz + 1")
        ListItem("fuzz <- fuzz + 1")
        Paragraph():Strong("Note:"):Text(" Have students hold up their two baggies when they're done. Make sure students are evaluating and then assigning. Call out that last three lines which can be a little nutty to think about. You're using a variable's value as part of the assignment. This lets it "):DoubleQuote():Text("count up by one"):DoubleQuote():Text(".")
        Paragraph():Strong("Click for animation:"):Text(" Click through to see the answers.")
        Paragraph():Strong("Slide:"):Text(" Key Takeaways")
        Paragraph():Strong("Do This:"):Text(" Review the key takeaways with students.")
        BulletList()
        ListItem("Numbers and strings are two different types of values")
        ListItem("Expressions evaluate to a single new value")
        ListItem("When variables are in the expression just make a copy, don't change the actual variable.")
        ListItem("Variables are "):DoubleQuote():Text("assigned"):DoubleQuote():Text(" a new value")
        ListItem("Evaluate first, then assign")
        ListItem("Old values are deleted forever.")
        ListItem("Assignment just moves information around. It does not "):DoubleQuote():Text("connect"):DoubleQuote():Text(" variables.")
        Paragraph():Strong("Slide:"):Text(" In some languages...")
        Paragraph():Strong("Say:"):Text(" In some programming languages (including Quorum and Javascript) the assignment operator is not written with an arrow but is written as an equal sign.")
        Paragraph():Strong("Slide:"):Text(" So the command...")
        Paragraph():Strong("Say:"):Text(" That means that in those languages, "):Code("fuzz <- fuzz + 1"):Text(" would be written as "):Code("fuzz = fuzz + 1"):Text(". We'll see more of this in the next lesson!")
        Paragraph():Strong("Note:"):Text(" In math "):DoubleQuote():Text("="):DoubleQuote():Text(" means "):DoubleQuote():Text("are equal forever."):DoubleQuote():Text(" In programming "):DoubleQuote():Text("="):DoubleQuote():Text(" means"):DoubleQuote():Text(" put this value in this variable"):DoubleQuote():Text(".")
    end

    private action WrapUp10Minutes
        Section("Wrap Up (10 minutes)")
        Subsection("Journal")
        Paragraph("Have students add the following words to their journals: Expression, Variable, Assignment Operator.")
        BulletList()
        ListItem():Emphasis("Expression:"):Text(" a combination of operators and values that evaluates to a single value.")
        ListItem():Emphasis("Variable:"):Text(" an abstraction inside the program that can hold a value. Each variable has associated data storage that represents one value at a time.")
        ListItem():Emphasis("Assignment operator:"):Text(" allows a program to change the value represented by a variable.")
        Subsection("Remarks")
        BulletList()
        ListItem("This isn't the last time we'll look at these definitions and it's fine to update them as you get more experience. In fact, I'm sure you'll have a lot more to add once we see all of these concepts used inside of apps when we meet next time!")
    end

    private action AssessmentCheckForUnderstanding
        Section("Assessment: Check for Understanding")
        Paragraph("Check For Understanding Question(s) and solutions can be found in each lesson on Code Studio. These questions can be used for an exit ticket.")
        Subsection("For Students")
        Paragraph("Open a word doc or google doc and copy/paste the following question.")
        Subsection("Question")
        Paragraph("What will the value of the variable score be when the following code is finished running?")
        CodeExample("var score
score <- 3
score <- score + 1
score <- " + dq + "The score is: " + dq + " + score")
    end

    private action StandardsAlignment
        Section("Standards Alignment")
        BulletList()
        ListItem():Strong("CSTA K-12 Computer Science Standards (2017): "):Text("2-AP-11")
        ListItem():Strong("CSP2021: "):Text("AAP-1.A.1, AAP-1.B.1, AAP-1.B.3, AAP-1.C.4")
        ListItem():Strong("CSP2021: "):Text("AAP-2.B.3, AAP-2.B.4, AAP-1.B.5, AAP-2.C.1, AAP-2.C.4")
        ListItem():Strong("CSP2021: "):Text("DAT-1.A.1")
    end
end
