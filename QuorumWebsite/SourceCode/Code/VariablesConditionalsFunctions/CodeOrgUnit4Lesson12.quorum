use Libraries.Web.Page.QuorumPage

/*
    Variables, Conditionals, and Functions - Lesson 12: Project- Decision Maker App Part 1.
    Converted from the old Lesson page by plan 13's generator: the same
    words, now without Tailwind.
*/
class CodeOrgUnit4Lesson12 is QuorumPage

    on create
        SetLocation("lessons/code/BigDataAndPrivacy/Lesson12.html")
        // The name lists and links use, and the series and track it belongs
        // to: its section and picture.
        SetShortTitle("Project - Decision Maker App Part 1")
        SetSectionName("Variables, Conditionals, and Functions")
        // For search engines and link previews, and what lists of pages say.
        SetDescription("Explore sample apps and plan your project")
        SetSummary("Unit Project Day 1")
    end

    action Setup
        SetWebPageTitle("Unit 4 Lesson 12: Project - Decision Maker App Part 1")
        Title("Variables, Conditionals, and Functions - Lesson 12: Project- Decision Maker App Part 1")
        Overview()
        GettingStarted5Minutes()
        Activity40Minutes()
        WrapUp0Minutes()
        StandardsAlignment()
    end

    private action Overview
        Section("Overview")
        Paragraph("Using a Project Planning Guide, students work through the stages of creating an app from scratch. This is the first day of a three-day project. This lesson is devoted to the planning phase.")
        Subsection("Goals")
        Paragraph("Students will be able to:")
        BulletList()
        ListItem("See rubric for guidance in measuring student learning")
        Subsection("Purpose")
        Paragraph("The Practice PT gives students the opportunity to design and program an app from scratch. Welcome to The Decision Maker App! Students demonstrate mastery of variables, conditionals, and functions by combining these elements into a useful program designed to solve the problem of making a decision.")
        Subsection("Resources")
        BulletList()
        ListItem():Link("CSP-Widgets repository", "https://github.com/qorf/CSP-Widgets")
        Subsubsection("Supplemental Code.org material")
        Paragraph("For the students")
        BulletList()
        ListItem():Link("CSP Unit 4 Practice PT Rubric", "https://docs.google.com/document/d/1mldgFK3CJbsWnTS8WYVDtEY1e7V4c0_V0sv63dYUkG8/edit?usp=sharing")
        ListItem():Link("CSP Unit 4 Practice PT Planning Guide", "https://docs.google.com/document/d/1IojBJ1NQPDz4SajskdWq_6LSstg3_9EgpTAwQf63M5g/edit?usp=sharing")
    end

    private action GettingStarted5Minutes
        Section("Getting Started (5 minutes)")
        TeachingTip()
        Paragraph():Strong("Short Intro:"):Text(" The Warm Up today is short and light. Students should spend the maximum amount of time working on their projects.")
        EndCallout()
        Subsection("Remarks")
        BulletList()
        ListItem("Have you ever been stuck trying to make a decision? What movie should we watch? Where should we go for lunch? How many chocolate bars can I buy? For the next three days you will build an app to help people make a decision.")
    end

    private action Activity40Minutes
        Section("Activity (40 minutes)")
        Paragraph():Strong("Explore Projects:"):Text(" Direct students to explore two apps from the CSP-Wideget Repository, "):Strong("Lesson12_ExampleApp1"):Text(" and "):Strong("Lesson12_ExampleApp2."):Text(" These apps should spark ideas in what the students can create for this project.")
        DiscussionGoal()
        Paragraph():Strong("Sample App #1: Where Should I Eat?")
        BulletList()
        ListItem("Recommends a restaurant to the user.")
        ListItem("Inputs: text box for user name, drop down menu for restaurant type, up and down buttons to control the amount of dollars the user wants to spend.")
        ListItem("Outputs: Text box at the bottom of the screen which displays the recommendation and sound that plays when the user interacts with the app.")
        ListItem("Variables: username, type of restaurant, dollar amount, output text")
        ListItem("Conditional Logic: If the dollar amount within certain amounts, recommend different restaurants")
        ListItem("Function: Update the screen every time the user changes an input.")
        Paragraph():Strong("Sample App #2: Activity Finder")
        BulletList()
        ListItem("Recommends an activity to the user.")
        ListItem("Inputs: text box for user name, drop down menu for time of day, drop down menu for activity level.")
        ListItem("Outputs: Text box at the bottom of the screen which displays the recommendation and sound that plays when the user interacts with the app.")
        ListItem("Variables: username, time of day, activity level, output text")
        ListItem("Conditional Logic: If the user selects certain times of day and activity levels, make targeted recommendations.")
        ListItem("Function: Update the screen every time the user changes an input.")
        EndCallout()
        Paragraph():Strong("Discuss:"):Text(" For each app, discuss the following:")
        BulletList()
        ListItem("What does this app do?")
        ListItem("What are the inputs?")
        ListItem("What are the outputs?")
        ListItem("What variables do you think would be necessary for this app to work?")
        ListItem("What kinds of conditional logic do you think are necessary to make it work?")
        ListItem("How could a function be used in this app?")
        Paragraph():Strong("Distribute:"):Text(" Each student should have a copy of the Practice PT Decision Maker App Planning Guide.")
        Subsection("Remarks")
        BulletList()
        ListItem("For this project you will create an app that helps a user make a decision. Your app must take in at least one number and one string from the user that will help to make the decision. All of this information will be used as part of the decision making process. In addition, your code must include at least one function used to update the screen.")
        Paragraph():Strong("Discuss:"):Text(" Review the rubric requirements in the following chart or in the supplemental Planning Guide.")
        Table("Rubric for Practice PT Guide")
        TableHeader():Cell("Category: App Development Planning Guide"):Cell("Convincing Evidence:Planning guide is fully completed"):Cell("Approaching Evidence: Planning guide is mostly completed"):Cell("Limited Evidence: Planning guide is somewhat complete"):Cell("No Evidence: Planning guide is not complete")
        TableRow():Cell("Written Response 1:"):Cell("Response accurately describes the purpose, functionality, and inputs/outputs of the app."):Cell("Response describes the purpose and functionality, or the inputs/outputs of the app."):Cell("Response partially describes the purpose and functionality, or the inputs/outputs of the app."):Cell("Response does not describe the purpose, functionality, and inputs/outputs of the app.")
        TableRow():Cell("Written Response 2:"):Cell("Response clearly describes an idea or recommendation provided by a partner / peer and how it improved the app."):Cell("Response describes an idea or recommendation provided by a partner / peer and how it improved the app, but there is some confusion."):Cell("Response describes an idea or recommendation provided by a partner, but does not explain how it improved the app."):Cell("Response does not describe an idea or recommendation provided by a partner.")
        TableRow():Cell("User Interface:"):Cell("The User Interface is easy to navigate and it's clear how the app is designed to be used. All text is readable."):Cell("The User Interface is mostly easy to navigate and it's clear how the app is designed to be used. All text is readable."):Cell("The User Interface is lacking in some readability or it's not clear how to use the app."):Cell("The User Interface is difficult to navigate and it's not clear how the app is designed to be used. Text is unreadable.")
        TableRow():Cell("Code: Warnings & Error Messages"):Cell("No warnings or error messages appear when the app is run."):Cell("A few warnings or error messages appear when the app is run."):Cell("Many warnings or error messages appear when the app is run."):Cell("The app does not run at all.")
        TableRow():Cell("Code: Variables"):Cell("At least one number and one String are each stored in a variable and used to make a decision."):Cell("One data type (numbers or Strings) is stored in at least two variables and used to make a decision."):Cell("One variable stores either a number or String and is used to make a decision."):Cell("No variables are set up or used to make a decision.")
        TableRow():Cell("Code: Function"):Cell("A function is used to update the screen. The function is called at least two times in the program."):Cell("A function is used to update the screen. The function is called one time in the program."):Cell("A function is created to update the screen but is not called in the program."):Cell("A function was not created to update the screen.")
        TableRow():Cell("Code: Conditional"):Cell("A conditional is used inside of the function to make a decision based on information stored in variables. The conditional correctly uses a logical operator (&&, ||, or !) in the Boolean expression. The decision is displayed on the screen. There are at least three different responses that could be displayed."):Cell("A conditional is used inside of the function to make a decision based on information stored in variables. The conditional does not correctly use a logical operator (&&, ||, or !) in the Boolean expression. The decision is displayed on the screen. There are at least two different responses that could be displayed."):Cell("A conditional is created inside of the function, but does not use information stored in variables to make a decision or display it on the screen."):Cell("No conditionals are present in the function.")
        TableRow():Cell("Code: Comments"):Cell("The update screen function has a comment which clearly explains its purpose and functionality."):Cell("The update screen function has a comment which clearly explains its purpose or functionality."):Cell("A comment is present, but it does not clearly explain anything about the function."):Cell("No comments are present.")
        TeachingTip()
        Paragraph():Strong("Supporting students in Practice PT Lessons")
        Paragraph("The teacher plays the role of a guide throughout the Practice PT lessons. In preparation, you may want to set aside some time to complete the project yourself to identify potential points of confusion for your classroom.")
        Paragraph("In this first lesson, the classroom progresses together through steps 1-3, and then students work at the own pace for steps 4-6. Circulate the room and check in with students as needed to make sure instructions are clear and students understand expectations.")
        Paragraph("What should you expect?")
        BulletList()
        ListItem("Students writing and sketching in the Planning Guide")
        ListItem("Active discussion around project ideas")
        ListItem("Students should only be in Quorum Studio if they have finished Steps 1-6 early and are ready to begin designing the interface for their app. If this is true, they can move on to the first level in Lesson 13.")
        EndCallout()
        Paragraph():Strong("Display:"):Text(" Show the steps students will complete today in the Planning Guide:")
        NumberedList()
        ListItem():Strong("Brainstorm App Ideas:"):Text(" Students come up with three distinct ideas.")
        ListItem():Strong("Choose One Idea:"):Text(" Students should select one of their three ideas to turn into an app.")
        ListItem():Strong("Survey Your Classmates:"):Text(" Students discuss with two classmates the decision their app will help the user make and decide what information is needed to make this decision.")
        ListItem():Strong("Storing Information:"):Text(" Variables needed for storing information are listed in this section.")
        ListItem():Strong("Flowchart:"):Text(" Students create a flowchart, following the "):DoubleQuote():Text("Can I adopt a cat?"):DoubleQuote():Text(" sample flowchart from the Conditionals Explore lesson.")
        ListItem():Strong("Design User Interface:"):Text(" There is space for students to design up to three screens. There are no screen requirements for the app, so students may use only one screen.")
    end

    private action WrapUp0Minutes
        Section("Wrap Up (0 minutes)")
        Paragraph("No wrap up today. All time should be spent on the project.")
    end

    private action StandardsAlignment
        Section("Standards Alignment")
        BulletList()
        ListItem():Strong("CSTA K-12 Computer Science Standards (2017): "):Text("2-AP-10, 2-AP-11, 3A-AP-16, 3B-AP-14")
    end
end
