use Libraries.Web.Page.QuorumPage

/*
    Variables, Conditionals, and Functions - Lesson 3: Variables Practice.
    Converted from the old Lesson page by plan 13's generator: the same
    words, now without Tailwind.
*/
class CodeOrgUnit4Lesson3 is QuorumPage

    on create
        SetLocation("lessons/code/BigDataAndPrivacy/Lesson3.html")
        // The name lists and links use, and the series and track it belongs
        // to: its section and picture.
        SetShortTitle("Variables Practice")
        SetSectionName("Variables, Conditionals, and Functions")
        // For search engines and link previews, and what lists of pages say.
        SetDescription("Practice debugging and writing variables")
        SetSummary("Practice debugging and writing variables")
    end

    action Setup
        SetWebPageTitle("Unit 4 Lesson 3: Variables Practice")
        Title("Variables, Conditionals, and Functions - Lesson 3: Variables Practice")
        Overview()
        GettingStarted0Minutes()
        Activity40Minutes()
        WrapUp5Minutes()
        AssessmentCheckForUnderstandingAPPractice()
        StandardsAlignment()
    end

    private action Overview
        Section("Overview")
        Paragraph("In this lesson students spend most of their time practicing using the skills and processes they have learned about variables. At the conclusion of the lesson students discuss the main things they realized and still have questions about at the conclusion of this lesson.")
        Subsection("Goals")
        Paragraph("Students will be able to:")
        BulletList()
        ListItem("Write programs that use variables and expressions with the support of sample code.")
        ListItem("Debug programs that use variables and expressions")
        Subsection("Purpose")
        Paragraph("This lesson is students primary opportunity to get hands on with variables in code prior to the Make activity in the following lesson. Give students as much class time as you can to work through these. For this lesson it's recommended that you place students in pairs as a support and to encourage discussion about the challenges or concepts they're seeing. In the following lesson students are encouraged to work independently.")
        Subsection("Resources")
        BulletList()
        ListItem():Link("Debugging Global vs. Local Variables (Video)", "https://www.youtube.com/watch?v=Vlj1_X474to")
        ListItem():Link("EIPM: A Short Introduction (Teacher Resource)", "https://docs.google.com/document/d/1ncil5b0yWAN4LCyOeXwYuNrNKEHtN4nmAd2o-_K5Psw/edit?usp=sharing")
        ListItem():Link("CSP-Widgets Repository", "https://github.com/qorf/CSP-Widgets")
        TeachingTip()
        Paragraph("This is the first official "):DoubleQuote():Text("Practice"):DoubleQuote():Text(" lesson in the EIPM model. Review the EIPM model in the"):Link("EIPM: A Short Introduction (Teacher Resource)", "https://docs.google.com/document/d/1ncil5b0yWAN4LCyOeXwYuNrNKEHtN4nmAd2o-_K5Psw/edit?usp=sharing"):Text(".")
        Subsection("Practice Lessons:")
        Paragraph():Strong("Overview:"):Text(" Students practice using the new concept through a scaffolded series of programming activities.")
        BulletList()
        ListItem("Students work independently or in pairs")
        ListItem("Teacher introduces debugging practices that the beginning of the Activity and circulates the room during the lesson to provide targeted support.")
        Paragraph():Strong("Goal:"):Text(" Students gain confidence in writing and debugging programs that use the new concept.")
        Image("media/lessons/csp/unit4/practice-thumbnail.png", "A sketch showing students working together on computers.")
        Paragraph("Watch the following videos:")
        BulletList()
        ListItem():Link("Guide to EIPM Lessons", "https://www.youtube.com/watch?v=OTvi0XRTIjA")
        ListItem():Link("Guide to Practice Lessons", "https://www.youtube.com/watch?v=Aad0UJXGcR4")
        EndCallout()
    end

    private action GettingStarted0Minutes
        Section("Getting Started (0 minutes)")
        Subsection("Remarks")
        BulletList()
        ListItem("Today we're going to have a chance to practice programming with a lot of the concepts and patterns we've explored over the last two lessons. I encourage you to go through these with a partner, but pay close attention to what each other is doing. In our next lesson you're going to have to use a lot of these on an independent project, and these activities are good practice for what you'll find there! Alright, let's get to it!")
        TeachingTip()
        Paragraph():Strong("Move Quickly to the Activity:"):Text(" There's a lot in the main activity of today's lesson. You may optionally wish to do a quick vocabulary review or address any questions that came up in the last lesson. Otherwise, give students more time to get hands on with some code.")
        EndCallout()
    end

    private action Activity40Minutes
        Section("Activity (40 minutes)")
        Paragraph():Strong("Group:"):Text(" It is recommended that students work in pairs for this lesson and a number of the activities feature discussion prompts. Consider using pair programming, having drivers and navigators switch every 3 minutes, not on every project.")
        Paragraph():Strong("Distribute:"):Text(" Optionally pass out a plastic cup or other manipulative they can place on their computer when they are stuck as a signal that they need support.")
        Subsection("Remarks")
        BulletList()
        ListItem("Today you're mostly going to practice what we've learned about programming with variables. As always you should be using the debugging process to help you as you work on issues.")
        ListItem("Let's review the debugging process first. Debugging is the process of finding and fixing problems in code. We previously talked about these four steps: Describe, Hunt, Try, and Document.")
        ListItem("Today we're going to be focusing on our debugging skills while we practice. Don't forget to use "):Code("output"):Text(" to check the values of variables!")
        Paragraph():Strong("Open a Project:"):Text(" Students will use a number of projects for this lesson, beginning with "):Strong("Lesson3_App1"):Text(". Each project has instructions in a comment that describes what students should do for that project. When they finish one project, they can proceed to the next one.")
        TeachingTip()
        Paragraph():Strong("Providing Support:"):Text(" Circulate around the room through the lesson encouraging students to use the strategies introduced in the previous lessons. Students have a number of supports at their fingertips, so a big part of your role is helping build their independence in using those resources.")
        EndCallout()
        Paragraph():Strong("Projects 1-2 Assigning Numbers and Strings:"):Text(" These projects only use the "):Code("output"):Text(" commands which prints text in the console. Some key points in these levels:")
        BulletList()
        ListItem("Students are asked to discuss what they see with a partner")
        ListItem("These projects heavily reinforce language around assigning and creating variables")
        ListItem("Project 2 is a debugging-heavy level which introduces more rules about syntax.")
        Paragraph():Strong("Projects 3-7 Variables and Operators:"):Text(" These projects have students practice writing more complex expressions and using operators. A few tricky things to look out for")
        BulletList()
        ListItem("These levels transition from using only "):Code("output"):Text(" to using full apps with user interfaces.")
        ListItem("Project 3 has a tricky question regarding the difference between "):Code("1.0/7.0"):Text(" and "):Code("1/7"):Text(". In the first case, the numbers have a decimal component, so the operation will create a fraction. In the second case, it's dividing by whole integers with no fraction, so 1 divided by 7 equals 0!")
        ListItem("Project 5 introduces the concept of multi-line text")
        ListItem("Students continue to be encouraged to discuss what they are learning with a neighbor")
        ListItem("Projects 6 and 7 introduce the use of the counter pattern with numbers and strings. Students may need to be reminded of the pattern.")
        Paragraph():Strong("Regroup:"):Text(" Bring the class back together to watch the Scope Practice Video.")
        TeachingTip()
        Paragraph():Strong("Teaching Tip:"):Text(" The concept of variable scope can be difficult for students to understand. It is highly recommended that you watch the video prior to the lesson. "):Link("Slides are available for this lesson if you would like to optionally review as a class.", "https://docs.google.com/presentation/d/1GhpZOh2589s9MuKsll7YkQ3xv6nwcpmtAnTCgJPIXC0/copy")
        EndCallout()
        Paragraph():Strong("Display:"):Text(" Show the "):Link("Scope Practice video", "https://www.youtube.com/watch?v=Vlj1_X474to"):Text(".")
        Video("https://www.youtube.com/embed/Vlj1_X474to?si=PowwtMMFXC4r9I4M", "Debugging Global vs. Local Variables")
        Paragraph():Strong("Do This:"):Text(" Discuss these differences between global and local scope, and debugging tips for dealing with them.")
        Subsection("Create Variables Once At the Top of Your Codes")
        Paragraph("When you create variables you should:")
        BulletList()
        ListItem():Strong("Create each variable only once."):Text(" You don't need to create variables twice and this can cause errors.")
        ListItem():Strong("Create your variables at the top of the "):Code("class"):Strong(" section."):Text(" This keeps your code organized and easier to read for you and others.")
        ListItem():Strong("Avoid creating variables inside of actions."):Text(" Read on to understand why.")
        Subsection("Global vs. Local Variables")
        Paragraph("There's two types of variables, global and local, and so far we've only focused on global variables. Here's the main difference between global and local variables.")
        BulletList()
        ListItem():Strong("Global Variables"):Text(" are permanent. They can be used anywhere in your code. Variables created outside of an "):Code("action"):Text(" section are global.")
        ListItem():Strong("Local Variables"):Text(" are temporary. They can be used only in the part of the code where they were created, like inside an "):Code("action"):Text(". These are deleted once code section is done running. Variables created inside "):Code("action"):Text(" or "):Code("if"):Text(" blocks are local.")
        Subsection("Avoiding Local Variables and Debugging")
        Paragraph("Local variables will eventually be useful but for now they're most likely to just be confusing. The biggest issue you'll run into right now with local variables is accidentally creating a variable in an "):Code("action"):Text(" while trying to use a global variable. Here's what the code usually looks like:")
        CodeExample("integer count = 0
action ButtonActivated(Button button)
    integer count = count + 1
end")
        Paragraph("This code is pretty confusing. While it looks like there's only one variable being used, it actually has two variables, one local, and one global, and they're both named "):Code("count"):Text("! Changing the value of one will have no impact on the other. This can cause unexpected behavior in your code and it can get tricky to debug.")
        Paragraph("The best way to avoid these issues is to "):Strong("make sure for now that you're not using variable creation commands inside of an "):Code("action"):Strong("."):Text(" If you run into a tricky debugging problem, check if you're accidentally creating a local variable.")
        Subsection("Resume the Activity")
        Paragraph():Strong("Project 8 Debugging Scope Issues:"):Text(" This project highlights a common bug that can come up when working with variables. While students should be aware of this bug, they don't quite have the background they'd need to fully understand it. For now support students in following the three main takeaways.")
        BulletList()
        ListItem("Create variables once")
        ListItem("Create variables at the top of the "):Code("class"):Text(" section")
        ListItem("Don't create variables inside "):Code("action"):Text(" blocks")
        Paragraph():Strong("Project 9 Putting It All Together:"):Text(" This project asks students to put together many of the concepts they've seen so far. This is an opportunity to have a bit more of a "):DoubleQuote():Text("blank screen moment"):DoubleQuote():Text(" while still being able to use some starter code as a guide.")
    end

    private action WrapUp5Minutes
        Section("Wrap Up (5 minutes)")
        Paragraph():Strong("Discuss:"):Text(" What aspects of working with variables do you feel like clicked today? What do you still feel like you have trouble with?")
        DiscussionGoal()
        Paragraph():Strong("Discussion Goal:"):Text(" Use this opportunity to address any lingering questions or misconceptions in the room. You can also use this as a source of discussion topics to kick off the following lesson. As you lead the discussion, call out the many resources students have access to help when they're getting stuck.")
        EndCallout()
        Paragraph():Strong("Discuss:"):Text(" Have students share with one another before sharing with the whole class.")
        Subsection("Remarks")
        BulletList()
        ListItem("Variables can be a little bit tricky, but I saw a lot of good progress today in nailing down this concept. We may have a few lingering questions, but you also have a lot of resources available. Next time you'll have a chance to put all this together by programming an app that starts with "):DoubleQuote():Text("the blank screen"):DoubleQuote():Text("!")
    end

    private action AssessmentCheckForUnderstandingAPPractice
        Section("Assessment: Check for Understanding - AP Practice")
        Subsection("For Students")
        Paragraph("Open a word doc or google doc and copy/paste the following question.")
        Subsection("Question")
        Paragraph("What will be displayed after this code segment is run?")
        CodeExample("myPoints <- 2
myPoints <- 5
myPoints <- myPoints + 1
DISPLAY myPoints")
    end

    private action StandardsAlignment
        Section("Standards Alignment")
        BulletList()
        ListItem():Strong("CSTA K-12 Computer Science Standards (2017): "):Text("2-AP-11")
        ListItem():Strong("CSP 2021: "):Text("AAP-1.B.2")
        ListItem():Strong("CSP 2021: "):Text("AAP-2.C.2, AAP-2.C.3")
        ListItem():Strong("CSP 2021: "):Text("AAP-3.A.6, AAP-3.E.1")
        ListItem():Strong("CSP 2021: "):Text("DAT-1.B.2")
    end
end
