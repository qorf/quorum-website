use Libraries.Web.Page.QuorumPage
use Libraries.Web.Page.TableRowWriter

/*
    Variables, Conditionals, and Functions - Lesson 9: Functions Explore / Investigate.
    Converted from the old Lesson page by plan 13's generator: the same
    words, now without Tailwind.
*/
class CodeOrgUnit4Lesson9 is QuorumPage
    // The table row being written, when its cells hold more than words.
    TableRowWriter row = undefined

    on create
        SetLocation("lessons/code/BigDataAndPrivacy/Lesson9.html")
        // The name lists and links use, and the series and track it belongs
        // to: its section and picture.
        SetShortTitle("Functions Explore / Make")
        SetSectionName("Variables, Conditionals, and Functions")
        // For search engines and link previews, and what lists of pages say.
        SetDescription("Learn how to reuse code with functions")
        SetSummary("Explore and investigate functions")
    end

    action Setup
        SetWebPageTitle("Unit 4 Lesson 9: Functions Explore / Investigate")
        Title("Variables, Conditionals, and Functions - Lesson 9: Functions Explore / Investigate")
        Overview()
        GettingStarted5Minutes()
        Activity30Minutes()
        WrapUp5Minutes()
        AssessmentCheckForUnderstanding()
        StandardsAlignment()
    end

    private action Overview
        Section("Overview")
        Paragraph("Students begin the lesson by considering two ways to write out the lyrics of a song, one that includes a lot of repeated text and one that does not. After exploring this example students complete a series of investigate activities in which functions have been used to remove repeated code from a program. At the conclusion of the lesson students discuss the concept of a function to synthesize their learning and add definitions to their journal.")
        Subsection("Goals")
        Paragraph("Students will be able to:")
        BulletList()
        ListItem("Use appropriate vocabulary to describe the declaring and calling of functions")
        ListItem("Trace the flow of execution in programs that declare and call functions")
        ListItem("Describe the way a function call interrupts the normal flow of execution within a program")
        ListItem("Modify programs that declare and call functions to adjust their functionality")
        Subsection("Purpose")
        Paragraph("This lesson is both the Explore and Investigate components of the EIPM sequence for functions. Functions are best understood by actually using them in a program, and so while the Explore component is relatively shorter, students actually are given many opportunities to observe how functions are used in programs. There is a heavy emphasis on running programs slowly to see how functions change the order in which programs run.")
        Paragraph("If you are a teacher with more experience with the concept of functions you may be wondering where other related concepts like parameters, arguments, and return values, will be introduced. In this unit these additional concepts are not learning objectives, and they will not be discussed in detail until later units. For now, it is fine for students to think of functions simply as a way to name a collection of commands so that they can be used in multiple places within your code.")
        Subsection("Resources")
        BulletList()
        ListItem():Link("CSP-Widgets repository", "https://github.com/qorf/CSP-Widgets")
        ListItem():Link("Song Lyrics (Activity Guide)", "https://docs.google.com/document/d/1Kf0x84kHyOPXsEVp3LnXEYGiGybKXqqL86a4xgKHBLI/edit?usp=sharing")
        ListItem():Link("CS Principles: Defining and Calling Functions (Video)", "https://youtu.be/yPWQfa4CHbw")
    end

    private action GettingStarted5Minutes
        Section("Getting Started (5 minutes)")
        Paragraph():Strong("(Optional) Distribute:"):Text(" Share the "):Link("Song Lyrics - Activity Guide", "https://docs.google.com/document/d/1Kf0x84kHyOPXsEVp3LnXEYGiGybKXqqL86a4xgKHBLI/edit?usp=sharing"):Text(" by giving paper copies, providing students the link, or projecting the activity guide where all can see it.")
        Table("Table with two columns of song lyrics labeled Style 1 and Style 2.")
        TableHeader():Cell("Style 1"):Cell("Style 2")
        row = TableRow()
        row:Cell():Text("00 Feeling my way through the darkness"):NewLine():Text(" 01 Guided by a beating heart"):NewLine():Text(" 02 I can't tell where the journey will end"):NewLine():Text(" 03 But I know where to start"):NewLine():Text(" 04"):NewLine():Text(" 05 They tell me I'm too young to understand"):NewLine():Text(" 06 They say I'm caught up in a dream"):NewLine():Text(" 07 Well life will pass me by if I don't open up my eyes"):NewLine():Text(" 08 Well that's fine by me"):NewLine():Text(" 09"):NewLine():Text(" 10 So wake me up when it's all over"):NewLine():Text(" 11 When I'm wiser and I'm older"):NewLine():Text(" 12 All this time I was finding myself"):NewLine():Text(" 13 And I didn't know? I was lost"):NewLine():Text(" 14"):NewLine():Text(" 15 So wake me up when it's all over"):NewLine():Text(" 16 When I'm wiser and I'm older"):NewLine():Text(" 17 All this time I was finding myself"):NewLine():Text(" 18 And I didn't know? I was lost"):NewLine():Text(" 19 "):NewLine():Text(" 20 I tried carrying the weight of the world"):NewLine():Text(" 21 But I only have two hands"):NewLine():Text(" 22 I hope I get the chance to travel the world"):NewLine():Text(" 23 But I don't have any plans"):NewLine():Text(" 24 I wish that I could stay forever this young"):NewLine():Text(" 25 Not afraid to close my eyes"):NewLine():Text(" 26 Life's a game? made for everyone"):NewLine():Text(" 27 And love is the prize"):NewLine():Text(" 28"):NewLine():Text(" 29 So wake me up when it's all over"):NewLine():Text(" 30 When I'm wiser and I'm older"):NewLine():Text(" 31 All this time I was finding myself"):NewLine():Text(" 32 And I didn't know? I was lost"):NewLine():Text(" 33"):NewLine():Text(" 34 So wake me up when it's all over"):NewLine():Text(" 35 When I'm wiser and I'm older"):NewLine():Text(" 36 All this time I was finding myself"):NewLine():Text(" 37 And I didn't know? I was lost"):NewLine():Text(" 38"):NewLine():Text(" 39 I didn't know I was lost"):NewLine():Text(" 40 I didn't know I was lost"):NewLine():Text(" 41 I didn't know I was lost"):NewLine():Text(" 42 I didn't know I was lost"):NewLine():Text(" 43"):NewLine():Text(" 44 So wake me up when it's all over"):NewLine():Text(" 45 When I'm wiser and I'm older"):NewLine():Text(" 46 All this time I was finding myself"):NewLine():Text(" 47 And I didn't know? I was lost")
        row:Cell():Text("00 Feeling my way through the darkness"):NewLine():Text(" 01 Guided by a beating heart"):NewLine():Text(" 02 I can't tell where the journey will end"):NewLine():Text(" 03 But I know where to start"):NewLine():Text(" 04"):NewLine():Text(" 05 They tell me I'm too young to understand"):NewLine():Text(" 06 They say I'm caught up in a dream"):NewLine():Text(" 07 Well life will pass me by if I don't open up my eyes"):NewLine():Text(" 08 Well that's fine by me"):NewLine():Text(" 09"):NewLine():Text(" 10 Sing Chorus (the lyrics are below)"):NewLine():Text(" 11"):NewLine():Text(" 12 Sing Chorus (the lyrics are below)"):NewLine():Text(" 13 "):NewLine():Text(" 14 I tried carrying the weight of the world"):NewLine():Text(" 15 But I only have two hands"):NewLine():Text(" 16 I hope I get the chance to travel the world"):NewLine():Text(" 17 But I don't have any plans"):NewLine():Text(" 18"):NewLine():Text(" 19 I wish that I could stay forever this young"):NewLine():Text(" 20 Not afraid to close my eyes"):NewLine():Text(" 21 Life's a game? made for everyone"):NewLine():Text(" 22 And love is the prize"):NewLine():Text(" 23"):NewLine():Text(" 24 Sing Chorus (the lyrics are below)"):NewLine():Text(" 25"):NewLine():Text(" 26 Sing Chorus (the lyrics are below)"):NewLine():Text(" 27"):NewLine():Text(" 28 I didn't know I was lost"):NewLine():Text(" 29 I didn't know I was lost"):NewLine():Text(" 30 I didn't know I was lost"):NewLine():Text(" 31 I didn't know I was lost"):NewLine():Text(" 32"):NewLine():Text(" 33 Sing Chorus (the lyrics are below)"):NewLine():Text(" 34"):NewLine():Text(" 35 Chorus Lyrics:"):NewLine():Text(" 36 So wake me up when it's all over"):NewLine():Text(" 37 When I'm wiser and I'm older"):NewLine():Text(" 38 All this time I was finding myself"):NewLine():Text(" 39 And I didn't know? I was lost")
        Subsection("Discuss")
        BulletList()
        ListItem("In Style 1, what line of the song do you sing after line 09? What about in Style 2?")
        ListItem("Style 2 uses fewer lines to write. Are there fewer lyrics to sing?")
        ListItem("What are the benefits of writing a song in Style 2?")
        DiscussionGoal()
        Paragraph():Strong("Goal:"):Text(" This lesson does not feature a large hands-on explore segment, but students should still get a quick introduction to the concept of a function before jumping in the code to try it out. Run this discussion to help motivate the ideas underlying functions. Here are the main points to bring out.")
        BulletList()
        ListItem("In Style 1 you read line 10 after line 09. This is a the normal order we're used to.")
        ListItem("In Style 2 you sing the lyrics "):DoubleQuote():Text("out of order"):DoubleQuote():Text(". After line 09 you're going to sing line 35")
        ListItem("It's shorter to write the song but it's the same song and will take the same time / lyrics to sing.")
        ListItem("Style 2 removes repetition and it also makes it a little easier to understand the overall structure of the song")
        EndCallout()
        Subsection("Remarks")
        BulletList()
        ListItem("This second song is written in a style that we're going to use to write some of our programs. In fact, we're going to start off by looking at a program that "):DoubleQuote():Text("sings"):DoubleQuote():Text(" this exact same song.")
    end

    private action Activity30Minutes
        Section("Activity (30 minutes)")
        Paragraph():Strong("Open a Project:"):Text(" Direct students to open "):Strong("Lesson9_App1"):Text(" from the CSP-Widgets repository. This is the first of three apps students will investigate today.")
        Paragraph():Strong("App 1 - Explore Song Lyrics:"):Text("This level is a continuation of the Explore activity in the warmup. Students should pay close attention to how the code that is running will jump down to the bottom of the program (the function declaration) when the name of the function is used (the function call).")
        Subsection("Remarks")
        BulletList()
        ListItem("This concept that we just explored in both text and a program is called a "):DoubleQuote():Text("function"):DoubleQuote():Text(", or as they're called in Quorum, an "):DoubleQuote():Text("action"):DoubleQuote():Text(". We're going to watch a short video that explains it in more detail.")
        Paragraph():Strong("Video:"):Text(" Watch the "):Link("CS Principles: Defining and Calling Functions (Video)", "https://youtu.be/yPWQfa4CHbw"):Text(" as a class. The video uses Javascript and Code.org's App Lab, but the core concepts are the same in Quorum. The most important three takeaways are that:")
        Video("https://www.youtube.com/embed/yPWQfa4CHbw?si=QVEma2vjwbnkqpM2", "CS Principles: Defining and Calling Functions")
        BulletList()
        ListItem("Functions are declared in your program in order to give a group of commands a name.")
        ListItem("Functions are called to run those commands.")
        ListItem("A function is only declared once but is called as many times as you wish.")
        Subsection("App 2 - Investigate Score Clicker")
        BulletList()
        ListItem():Strong("Discuss:"):Text(" Once students have had a chance to run the code ask them to explore it and be ready to share responses to the questions provided.")
        NestedBulletList()
        ListItem("The function is declared on line 32 but called two times, on lines 21 and 27.")
        ListItem("This way of writing the program makes the code in each of the buttons much simpler to read. It also removes repeated code.")
        EndNestedList()
        ListItem():Strong("Modify:"):Text(" Have students modify the program as instructed in the comments at the top of the file. All of the modifications should be made from within the function. Afterwards call out the following points.")
        NestedBulletList()
        ListItem("If you change the function you can use those changes every place the function is called.")
        ListItem("These changes make it easier to debug your program since you are not writing redundant code. You only need to rewrite and debug the code once.")
        EndNestedList()
        Subsection("App 3 - Investigate Lemon Squeeze App with Functions")
        BulletList()
        ListItem():Strong("Modify:"):Text(" Students in this level are asked to create a function themselves by identifying repeated code. They'll need to create a single function for this repeated code.")
        ListItem():Strong("Discuss:"):Text(" After creating their function lead a short discussion on the benefits of creating a function to remove repeated code.")
    end

    private action WrapUp5Minutes
        Section("Wrap Up (5 minutes)")
        Subsection("Journal")
        Paragraph("Review the UpdateScreen pattern with students. Afterwards have them add to their journal definition for a function and a function call.")
        Subsection("How does the UpdateScreen pattern work?")
        Paragraph("Many app projects run in the following way.")
        BulletList()
        ListItem("The user interacts with a screen element (like clicking a button or typing in a text box). This triggers an event handler.")
        ListItem("The event handler changes the values stored in variables.")
        ListItem("The information on the screen is updated to reflect the change to the variable.")
        Paragraph("Typically every one of your event handlers (like the "):Code("ButtonActivated"):Text(" action) will include identical code for step 3, updating the screen. To avoid this problem, make a single function called "):Code("UpdateScreen"):Text(" that includes the code to change every element on your screen once variables have been updated.")
        Paragraph("You will usually want to call "):Code("UpdateScreen"):Text(" inside of every event handler and will also want to call it once at the beginning of your program. This ensures that the same code is always being used to update the information that shows up on the screen.")
        Subsection("Closing")
        Paragraph():Strong("Discuss:"):Text(" Reflecting on today's lesson about functions:")
        BulletList()
        ListItem("What did you learn?")
        ListItem("What are you uncertain about?")
        DiscussionGoal()
        Paragraph():Strong("Discussion Goal:"):Text(" Use this quick discussion to identify any open questions that students have at the conclusion of the lesson. These can help you know where to focus attention in the next lesson.")
        EndCallout()
    end

    private action AssessmentCheckForUnderstanding
        Section("Assessment: Check for Understanding")
        Subsection("For Students")
        Paragraph("Open a word doc or google doc and copy/paste the following question.")
        Subsection("Question")
        Paragraph("In your own words describe the benefits of creating functions in your code.")
    end

    private action StandardsAlignment
        Section("Standards Alignment")
        BulletList()
        ListItem():Strong("CSTA K-12 Computer Science Standards: "):Text("3A-AP-17, 3B-AP-23")
        ListItem():Strong("CSP2021: "):Text("AAP-3.A.1, AAP-3.A.2, AAP-3.A.4")
    end
end
