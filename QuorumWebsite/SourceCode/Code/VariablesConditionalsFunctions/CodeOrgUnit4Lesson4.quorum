use Libraries.Web.Page.QuorumPage

/*
    Variables, Conditionals, and Functions - Lesson 4: Variables Make.
    Converted from the old Lesson page by plan 13's generator: the same
    words, now without Tailwind.
*/
class CodeOrgUnit4Lesson4 is QuorumPage

    on create
        SetLocation("lessons/code/BigDataAndPrivacy/Lesson4.html")
        // The name lists and links use, and the series and track it belongs
        // to: its section and picture.
        SetShortTitle("Variables Make")
        SetSectionName("Variables, Conditionals, and Functions")
        // For search engines and link previews, and what lists of pages say.
        SetDescription("Practice with variables by making an app")
        SetSummary("Practice using variables")
    end

    action Setup
        SetWebPageTitle("Unit 4 Lesson 4: Variables Make")
        Title("Variables, Conditionals, and Functions - Lesson 4: Variables Make")
        Overview()
        GettingStarted2Minutes()
        Activity38Minutes()
        WrapUp5Minutes()
        AssessmentMakeProject()
        StandardsAlignment()
    end

    private action Overview
        Section("Overview")
        Paragraph("Using Programming Patterns and a step-by-step approach students make their own version of a Photo Liker app. At the beginning of the lesson students are able to explore a working version of the app. They are then given the design elements of the app but begin with a blank screen. A progression of levels guides students on the high level steps they should use to develop their app but leaves it to them to decide how to write the code. At the end students submit their apps which can be assessed using a provided rubric.")
        Subsection("Goals")
        Paragraph("Students will be able to:")
        BulletList()
        ListItem("Recognize the need for programming patterns with variables as part of developing a functioning app")
        ListItem("Implement programming patterns with variables to develop a functioning app")
        ListItem("Write comments to clearly explain both the purpose and function of different segments of code within an app")
        ListItem("Use debugging skills as part of developing an app")
        Subsection("Purpose")
        Paragraph("This lesson is an opportunity for students to take on the "):DoubleQuote():Text("blank screen"):DoubleQuote():Text(" and build the code that runs an app entirely from scratch. Guidance provided throughout the lesson helps students break down the large task of "):DoubleQuote():Text("building an app"):DoubleQuote():Text(" into more incremental steps that they can use on future projects, including this unit's final project and the Create PT.")
        Subsection("Resources")
        Subsubsection("Activity Guide")
        BulletList()
        ListItem():Link("CSP Variables Make - Photo Liker App (Activity Guide)", "https://docs.google.com/document/d/1q13ZBiTwSUuE2zG5nSIvYv7QASLS784LjmpJis9vzQY/edit")
        ListItem():Link("EIPM: A Short Introduction (Teacher Resource)", "https://docs.google.com/document/d/1ncil5b0yWAN4LCyOeXwYuNrNKEHtN4nmAd2o-_K5Psw/edit?usp=sharing")
        ListItem():Link("CSP-Widgets Repository", "https://github.com/qorf/CSP-Widgets")
        TeachingTip()
        Paragraph("This is the first official "):DoubleQuote():Text("Make"):DoubleQuote():Text(" lesson in the EIPM model. Review the EIPM model in the "):Link("EIPM: A Short Introduction (Teacher Resource)", "https://docs.google.com/document/d/1ncil5b0yWAN4LCyOeXwYuNrNKEHtN4nmAd2o-_K5Psw/edit?usp=sharing"):Text(".")
        Paragraph():Strong("Make Lessons"):Text(" Students make a target app for which they are given the screen elements but little to no starter code.")
        BulletList()
        ListItem("Students are provided high-level steps to break down the project")
        ListItem("Teacher supports students by directing them towards notes, previous work, and debugging strategies practiced in earlier lessons.")
        Paragraph():Strong("Goal:"):Text(" Students are able to independently decide when and how to use the new concept in the context of a larger project.")
        Paragraph("Watch the following videos:")
        BulletList()
        ListItem():Link("Guide to EIPM Lessons", "https://www.youtube.com/watch?v=OTvi0XRTIjA")
        ListItem():Link("Guide to Make Lessons", "https://www.youtube.com/watch?v=d5IK3kUlXW4")
        Image("media/lessons/csp/unit4/make-thumbnail.png", "A sketch portraying several completed apps.")
        EndCallout()
    end

    private action GettingStarted2Minutes
        Section("Getting Started (2 minutes)")
        Subsection("Remarks")
        BulletList()
        ListItem("For the past few days, we've learned a lot about storing and updating information in variables. Today you are going to have an opportunity to demonstrate your learning by making an app.")
        TeachingTip()
        Paragraph():Strong("Short Intro:"):Text(" The Warm Up today is short and light. Students should spend the maximum amount of time working on their projects.")
        EndCallout()
    end

    private action Activity38Minutes
        Section("Activity (38 minutes)")
        Paragraph():Strong("Group:"):Text(" Make a determination as to whether this project will be completed in pairs or individually. You may even choose to let students decide.")
        Paragraph():Strong("Do This:"):Text(" Have students run the "):Strong("Unit 4 Lesson4_ExampleApp"):Text(" project, or run the app and display it to the class.")
        Paragraph():Strong("Discuss:"):Text(" If students are not working in pairs they should still discuss these prompts with a neighbor:")
        BulletList()
        ListItem("What does this app do?")
        ListItem("What are the inputs?")
        ListItem("What are the outputs?")
        ListItem("What's one piece of information that might be stored in a variable?")
        DiscussionGoal()
        Paragraph("See "):Strong("Unit4AnswerKey"):Text(" for the solutions to this discussion.")
        EndCallout()
        TeachingTip()
        Paragraph():Strong("Supporting Students:"):Text(" While students are working on their apps, circulate the room and check in with students who need a little help. Encourage students to collaborate and discuss bugs with each other.")
        Paragraph():Strong("Debugging:"):Text(" Review with students steps they can use to debug if they get stuck:")
        BulletList()
        ListItem("Use "):Code("output"):Text(" to get output from the app")
        ListItem("Explain the code to a friend")
        ListItem("Read the code carefully line by line, trying to decide which one is causing the error.")
        EndCallout()
        Subsection("Remarks")
        BulletList()
        ListItem("Now let's build this app. The screen has been provided for you - it's your job to add the code!")
        Paragraph():Strong("Distribute:"):Text(" Give students copies of "):Link("CSP Variables Make - Photo Liker App - Activity Guide", "https://docs.google.com/document/d/1q13ZBiTwSUuE2zG5nSIvYv7QASLS784LjmpJis9vzQY/edit"):Text(" if you will be using it during the class.")
        Paragraph():Strong("Do This:"):Text(" Direct students to open the "):Strong("Lesson4_ProjectTemplate"):Text(" project where they complete the Photo Liker App. Given this is students first Make project, it is highly recommended that students practice with this guide the first time. In future Make lessons they may opt not to use this guide. For students who need more detailed guidance once they've started programming, Step 3 includes step by step instructions that the student can follow.")
        Paragraph("Based on the needs of your classroom decide whether you will collectively go through the activity guide or have students complete it individually.")
        Paragraph():Strong("Submit:"):Text(" Encourage students to check the rubric on the last page of the Activity Guide before submitting.")
    end

    private action WrapUp5Minutes
        Section("Wrap Up (5 minutes)")
        Subsection("Remarks")
        BulletList()
        ListItem("Awesome work today! Make sure to submit your project when you're done with it!")
        TeachingTip()
        Paragraph():Strong("Maximize Work Time:"):Text(" The wrap up is short to allow the maximum amount of time for students to complete the activity.")
        EndCallout()
    end

    private action AssessmentMakeProject
        Section("Assessment: Make Project")
        Paragraph("Use the rubric provided with the project to assess student projects.")
    end

    private action StandardsAlignment
        Section("Standards Alignment")
        BulletList()
        ListItem():Strong("CSTA K-12 Computer Science Standards (2017): "):Text("2-AP-11, 2-AP-19")
    end
end
