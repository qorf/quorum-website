use Libraries.Web.Page.QuorumPage

/*
    Variables, Conditionals, and Functions - Lesson 8: Conditionals Make.
    Converted from the old Lesson page by plan 13's generator: the same
    words, now without Tailwind.
*/
class CodeOrgUnit4Lesson8 is QuorumPage

    on create
        SetLocation("lessons/code/BigDataAndPrivacy/Lesson8.html")
        // The name lists and links use, and the series and track it belongs
        // to: its section and picture.
        SetShortTitle("Conditionals Make")
        SetSectionName("Variables, Conditionals, and Functions")
        // For search engines and link previews, and what lists of pages say.
        SetDescription("Conditionals Make")
        SetSummary("Make an app using conditionals")
    end

    action Setup
        SetWebPageTitle("Unit 4 Lesson 8: Conditionals Make")
        Title("Variables, Conditionals, and Functions - Lesson 8: Conditionals Make")
        Overview()
        GettingStarted2Minutes()
        Activity38Minutes()
        WrapUp5Minutes()
        Assessment()
        StandardsAlignment()
    end

    private action Overview
        Section("Overview")
        Paragraph("Using Programming Patterns and a step-by-step approach students make their own version of a Museum Ticket Generator app. At the beginning of the lesson students are able to explore a working version of the app. They are then given the design elements of the app but begin with a blank screen. A progression of levels guides students on the high level steps they should use to develop their app but leaves it to them to decide how to write the code. At the end students submit their apps which can be assessed using a provided rubric.")
        Subsection("Goals")
        Paragraph("Students will be able to:")
        BulletList()
        ListItem("Recognize the need for programming patterns with Boolean expressions and conditional statements as part of developing a functioning app")
        ListItem("Implement programming patterns with boolean expressions and conditionals statements to develop a functioning app")
        ListItem("Write comments to clearly explain both the purpose and function of different segments of code within an app")
        ListItem("Use debugging skills as part of developing an app")
        Subsection("Purpose")
        Paragraph("This lesson is an opportunity for students to take on the "):DoubleQuote():Text("blank screen"):DoubleQuote():Text(" and build the code that runs an app entirely from scratch. Guidance provided throughout the lesson helps students break down the large task of "):DoubleQuote():Text("building an app"):DoubleQuote():Text(" into more incremental steps that they can use on future projects, including this unit's final project and the Create PT.")
        Subsection("Resources")
        BulletList()
        ListItem():Link("CSP-Widgets repository", "https://github.com/qorf/CSP-Widgets")
        Subsubsection("Supplemental Code.org material")
        Paragraph("For the students")
        BulletList()
        ListItem():Link("CSP Conditionals Make - Museum Ticket Generator App (Activity Guide)", "https://docs.google.com/document/d/1Xl34LDzK2GB2x46Bo8Mx6RI1K-deRG_vHO1oQqZlfsA/edit")
    end

    private action GettingStarted2Minutes
        Section("Getting Started (2 minutes)")
        TeachingTip()
        Paragraph():Strong("Short Intro:"):Text(" The warm up today is short and light. Students should spend the maximum amount of time working on their projects.")
        EndCallout()
        Subsection("Remarks")
        BulletList()
        ListItem("For the past few days, we've learned a lot about using conditional statements to help apps make decisions. In today's Make Project you'll be practicing both making flow charts and writing complex conditionals statements as you build a Museum Ticket Generator app.")
    end

    private action Activity38Minutes
        Section("Activity (38 minutes)")
        Paragraph():Strong("Group:"):Text(" Make a determination as to whether this project will be completed in pairs or individually. You may even choose to let students decide.")
        Paragraph():Strong("Distribute:"):Text(" Make sure students have access to scrap paper and pencils / paper for drawing flow charts, or any alternative materials you may ask students to use instead.")
        Paragraph():Strong("Open a Project:"):Text(" Direct students to open the Lesson8_ExampleApp project from the CSP-Widgets repository. Have students explore the working Museum Ticket Generator App. If students are not working in pairs they should still discuss the prompts with a neighbor.")
        Subsection("Prompts")
        BulletList()
        ListItem("What does this app do?")
        ListItem("What are the inputs?")
        ListItem("What are the outputs?")
        ListItem("What variables do you think would be necessary for this app to work?")
        ListItem("What kinds of conditional logic do you think are necessary to make it work?")
        DiscussionGoal()
        BulletList()
        ListItem("Answers are provided in "):Strong("Unit4AnswerKey"):Text(" repository.")
        EndCallout()
        TeachingTip()
        Paragraph():Strong("Supporting Students:"):Text(" While students are working on their apps, circulate the room and check in with students who need a little help. Encourage students to collaborate and discuss bugs with each other.")
        Paragraph():Strong("Debugging:"):Text(" Review with students steps they can use to debug if they get stuck:")
        BulletList()
        ListItem("Output the variables at different points in the program")
        ListItem("Explain the code to a friend")
        EndCallout()
        Subsection("Remarks")
        BulletList()
        ListItem("Now let's build this app. The screen has been set up for you - it's your job to add the code!")
        Paragraph():Strong("(Optional) Distribute:"):Text(" Give students copies of "):Link("CSP Conditionals Make - Museum Ticket Generator App (Activity Guide)", "https://docs.google.com/document/d/1Xl34LDzK2GB2x46Bo8Mx6RI1K-deRG_vHO1oQqZlfsA/edit"):Text(" if you will be using it during the class.")
        Paragraph():Strong("Open a Project:"):Text(" Direct students to open the Lesson8_ProjectTemplate project.")
        Paragraph():Strong("Do This:"):Text(" Based on the needs of your classroom decide whether you will collectively go through the activity guide or have students complete it individually. Afterwards give them time to work on their projects and circulate the room to offer support. Students who finish early can work on the extensions suggested in the activity guide.")
        Paragraph():Strong("Submit:"):Text(" Encourage students to check the rubric on the last page of the Activity Guide before submitting.")
    end

    private action WrapUp5Minutes
        Section("Wrap Up (5 minutes)")
        Subsection("Remarks")
        BulletList()
        ListItem("Awesome work today! Make sure to submit your project when you're done with it!")
        TeachingTip()
        Paragraph():Strong("Maximize Work Time:"):Text(" The wrap up is short to allow the maximum amount of time for students to complete the activity.")
        EndCallout()
    end

    private action Assessment
        Section("Assessment")
        Paragraph():Strong("Project:"):Text(" Use the rubric provided with the project to assess student projects.")
    end

    private action StandardsAlignment
        Section("Standards Alignment")
        BulletList()
        ListItem():Strong("CSTA K-12 Computer Science Standards (2017): "):Text("2-AP-10, 2-AP-12, 2-AP-19, 3B-AP-21")
    end
end
