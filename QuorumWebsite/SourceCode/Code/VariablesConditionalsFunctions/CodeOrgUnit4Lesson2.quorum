use Libraries.Web.Page.QuorumPage

/*
    Variables, Conditionals, and Functions - Lesson 2: Variables Investigate.
    Converted from the old Lesson page by plan 13's generator: the same
    words, now without Tailwind.
*/
class CodeOrgUnit4Lesson2 is QuorumPage
    // A double quote, for code and words that hold one.
    text dq = ""

    on create
        SetLocation("lessons/code/BigDataAndPrivacy/Lesson2.html")
        // The name lists and links use, and the series and track it belongs
        // to: its section and picture.
        SetShortTitle("Variables Investigate")
        SetSectionName("Variables, Conditionals, and Functions")
        // For search engines and link previews, and what lists of pages say.
        SetDescription("Inspect how apps use variables and design patterns that use them")
        SetSummary("Investigate how variables are used")
    end

    action Setup
        dq = dq:GetDoubleQuote()
        SetWebPageTitle("Variables, Conditionals, and Functions - Lesson 2: Variables Investigate")
        Title("Variables, Conditionals, and Functions - Lesson 2: Variables Investigate")
        Overview()
        GettingStarted5Minutes()
        Activity35Minutes()
        WrapUp5Minutes()
        AssessmentCheckForUnderstanding()
        StandardsAlignment()
    end

    private action Overview
        Section("Overview")
        Paragraph("In this lesson students work with partners to investigate several versions of the "):DoubleQuote():Text("Thermostat App"):DoubleQuote():Text(" to understand how variables store and update information. To begin, students examine a version of the app where the temperature displayed changes each time a button is clicked. The next two versions of the app demonstrate how variables can store strings. Students learn about the patterns they are observing, specifically "):DoubleQuote():Text("Counter Pattern with Event"):DoubleQuote():Text(" and "):DoubleQuote():Text("Variables with String Concatenation Pattern"):DoubleQuote():Text(". To conclude the lesson, students review and discuss the programming patterns that they will make use of in the programs they write.")
        Subsection("Goals")
        Paragraph("Students will be able to:")
        BulletList()
        ListItem("Identify common programming patterns when using variables as part of an app")
        ListItem("Explain the purpose of those programming patterns with variables both in terms of how they work and what they accomplish")
        ListItem("Modify apps that make use of common programming patterns with variables to adjust their functionality")
        Subsection("Purpose")
        Paragraph("After building a conceptual model for variables in the previous lesson, students investigate three working examples of apps that make use of variables. This lesson also introduces common programming patterns when using variables. Students will have some opportunities to modify working code in this lesson, but the most significant practice with variables will come in the following lesson.")
        Subsection("Resources")
        BulletList()
        ListItem():Link("EIPM: A Short Introduction (Teacher Resource)", "https://docs.google.com/document/d/1ncil5b0yWAN4LCyOeXwYuNrNKEHtN4nmAd2o-_K5Psw/edit?usp=sharing")
        ListItem():Link("Code.org CSP Unit 4 Presentation Slides", "https://docs.google.com/presentation/d/1GhpZOh2589s9MuKsll7YkQ3xv6nwcpmtAnTCgJPIXC0/copy")
        ListItem():Link("Guide to EIPM Lessons - Video", "https://www.youtube.com/watch?v=OTvi0XRTIjA")
        ListItem():Link("Guide to Explore Lessons - Video", "https://youtu.be/mzm-xqXH8BQ")
        ListItem():Link("CSP-Widgets Repository", "https://github.com/qorf/CSP-Widgets")
        TeachingTip()
        Paragraph("This is the first official "):DoubleQuote():Text("Investigate"):DoubleQuote():Text(" lesson in the EIPM model. Review the EIPM model in the "):Link("EIPM: A Short Introduction - Resource", "https://docs.google.com/document/d/1ncil5b0yWAN4LCyOeXwYuNrNKEHtN4nmAd2o-_K5Psw/edit?usp=sharing")
        Paragraph():Strong("Investigate Lessons")
        Paragraph():Strong("Overview:"):Text(" Students investigate two or three sample programs that use the new concept.")
        BulletList()
        ListItem("Close-reading of working programs")
        ListItem("Teacher-led discussions")
        ListItem("Tasks to modify apps")
        Paragraph():Strong("Goal:"):Text(" Students become comfortable reading and modifying programs that use the new concept.")
        Image("media/lessons/csp/unit4/investigate-thumbnail.png", "A sketch showing a teacher lead students through material on a display.")
        EndCallout()
    end

    private action GettingStarted5Minutes
        Section("Getting Started (5 minutes)")
        Subsection("Preview the Lesson")
        BulletList()
        ListItem("Yesterday we explored storing information like a computer. Computers store each piece of information in a variable. In Javascript, we name or declare a variable with the keyword "):DoubleQuote():Text("var"):DoubleQuote():Text(". In Quorum, we declare it by type, like "):DoubleQuote():Text("integer"):DoubleQuote():Text(", "):DoubleQuote():Text("text"):DoubleQuote():Text(", or "):DoubleQuote():Text("Button"):DoubleQuote():Text(" Today we are going to look at a new app that stores information in variables.")
        Paragraph():Strong("Discuss:"):Text(" Let's do a quick review. How does a baggy represent a variable?")
        DiscussionGoal()
        Paragraph():Strong("Discussion Goal:"):Text(" The baggy represents a variable by storing one item: a value on a sticky note placed in a named baggy. The value in the baggy can be changed at any time, just like a variable's value can change.")
        EndCallout()
    end

    private action Activity35Minutes
        Section("Activity (35 minutes)")
        Paragraph():Strong("Group:"):Text(" Place students in pairs. One student per group should open the apps used for this lesson, beginning with "):Strong("Lesson2_App1"):Text(".")
        Subsection("Investigation #1: Thermostat App v.1")
        Paragraph():Strong("Open a Project:"):Text(" Have students open the project "):Strong("Lesson2_App1"):Text(".")
        Paragraph():Strong("Activity:"):Text(" This project introduces a new app for students to investigate. It represents a Thermostat App where the temperature can be changed up and down.")
        BulletList()
        ListItem("Run the app: Let students run the app for a few minutes.")
        ListItem("Predict: Students predict the information that is being stored in variables.")
        ListItem("Assign Code Sections: Have students open the file "):Strong("Main.quorum"):Text(". Assign half the pairs to investigate the first section of the Button handling code on lines 83 and 93. The other half investigates the second half on lines 95 to 101. Both groups should also look at lines 79 and 80 and consider how they are related to their sections.")
        ListItem("Read Code: Groups should carefully read the code for their section making sure they understand how it works. Give them 3 minutes to do so.")
        ListItem("Explain Your Section: Have partners make a group with members of the other section and carefully explain how their section works line by line.")
        ListItem("Class Discussion: Ask a few members of each section to quickly share out how their section works. Display the code at the front so you can talk through it together.")
        DiscussionGoal()
        Paragraph():Strong("Discussion Goal:"):Text(" Here are some points that students are likely to bring up while discussing their code:")
        Subsubsection("Lines 79-80:")
        BulletList()
        ListItem("Two variables are created, "):Code("temperature"):Text(" and "):Code("tempF"):Text(".")
        ListItem():Code("temperature"):Text(" gets the value "):Code("70"):Text(" and "):Code("tempF"):Text(" is set to an empty string, which is represented with empty quotation marks.")
        Subsubsection("Lines 83-93:")
        BulletList()
        ListItem("On line 83, a sound is played.")
        ListItem("On line 85, we create a variable and store the name of the button that was clicked.")
        ListItem("Although we haven't explicitly discussed conditionals yet, students may recognize that code inside the block starting on line 88 will only trigger for the "):DoubleQuote():Text("down"):DoubleQuote():Text(" button.")
        ListItem("When the down button is clicked, the "):Code("temperature"):Text(" variable decreases by one.")
        ListItem("Then the "):Code("tempF"):Text(" variable is updated with the current value of "):Code("temperature"):Text(" joined with the letter "):Code("F"):Text(".")
        ListItem("The text on the screen is set to dispay the value stored in the variable "):Code("tempF"):Text(".")
        Subsubsection("Lines 95-101:")
        BulletList()
        ListItem("Although we haven't explicitly discussed conditionals yet, students may recognize that code inside the block starting on line 96 will only trigger for the "):DoubleQuote():Text("up"):DoubleQuote():Text(" button.")
        ListItem("When the up button is clicked, the "):Code("temperature"):Text(" variable increases by one.")
        ListItem("Then the "):Code("tempF"):Text(" variable is updated with the current value of "):Code("temperature"):Text(" joined with the letter "):Code("F"):Text(".")
        ListItem("The text on the screen is set to dispay the value stored in the variable "):Code("tempF"):Text(".")
        EndCallout()
        Paragraph("Modify: Have groups return to their original seats. Give them a couple of minutes to work on modifying the app to change the degrees by two when the up and down arrows are clicked.")
        Subsection("Investigation #2: Thermostat App v.2")
        Paragraph():Strong("Open a Project:"):Text(" Have students open the project "):Strong("Lesson2_App2"):Text(".")
        Paragraph():Strong("Activity:"):Text(" This program is an updated version of the Thermostat app. This time students should continue to work in partners but do not need to work with other groups. They will need to:")
        BulletList()
        ListItem("Run the app: Let students run the app for a few minutes.")
        ListItem("Discuss Changes: Talk through how the app is different than the first version.")
        ListItem("Find the "):Code("Round"):Text(" command. Discuss with a partner how this command might work. Try deleting "):Code("Round"):Text(" in lines 12, 102, and 112. What happens? Add it back in.")
        ListItem("Class Discussion: Ask a few students to explain what's happening on line 12 with "):Code("Round"):Text(".")
        ListItem("Modify the Code: Change the code so that no space displays between the temperature and the unit description ("):DoubleQuote():Text("F"):DoubleQuote():Text(" or "):DoubleQuote():Text("C"):DoubleQuote():Text(").")
        DiscussionGoal()
        Paragraph():Strong("Discussion Goal:"):Text(" On line 3, the Fahrenheit temperature is converted to Celsius. "):Code("Round"):Text(" rounds a given value to the nearest integer.")
        EndCallout()
        Subsection("Investigation #3: Thermostat App v.3")
        Paragraph():Strong("Open a Project:"):Text(" Have students open the project "):Strong("Lesson2_App3"):Text(".")
        Paragraph():Strong("Activity:"):Text(" This program is again an updated version of the Thermostat app with a login screen.")
        BulletList()
        ListItem("Run the app: Let students run the app for a few minutes.")
        ListItem("Predict: Students predict the information that is being stored in variables.")
        ListItem("Read Code: Give students a few minutes to read and discuss the code with their partners. What has changed? What has stayed the same?")
        ListItem("Class Discussion: Look at line 208. How does "):Code("nameField:GetText()"):Text(" work? What is it doing?")
        ListItem("Modify the Code: Add an explanation point "):DoubleQuote():Text("!"):DoubleQuote():Text(" to the end of the string stored in "):Code("userName"):Text(".")
        DiscussionGoal()
        Paragraph():Strong("Discussion Goal:"):Text(" "):Code("nameField:GetText()"):Text(" gets the string of text the user typed into the "):Code("nameField"):Text(" text box. In our app, the name written in the "):Code("nameField"):Text(" element is concatenated with "):DoubleQuote():Text("Hi"):DoubleQuote():Text(" and then stored in the variable "):Code("myName"):Text(".")
        EndCallout()
        Subsection("Patterns (7 minutes)")
        BulletList()
        ListItem("We are learning two patterns here:")
        NestedBulletList()
        ListItem("- Counter Pattern with Event")
        ListItem("- Variables with String Concatenation Pattern")
        EndNestedList()
        ListItem("The Counter Pattern with Event is a common pattern for updating variables that you will use in making many different apps. We call it the "):Strong("Counter Pattern with Event.")
        Paragraph():Strong("Display:"):Text(" Talk through the pattern with students.")
        CodeExample("integer counter = 0

action ButtonActivated(Button myButton)
     counter = counter + 1
end")
        Paragraph():Strong("Discuss:"):Text(" With a partner, discuss the following:")
        BulletList()
        ListItem("The "):DoubleQuote():Text("Counter Pattern with Event"):DoubleQuote():Text(" should look familiar! How would you explain this pattern to another person?")
        ListItem("When might you want to use the "):DoubleQuote():Text("Counter Pattern with Event"):DoubleQuote():Text("?")
        DiscussionGoal()
        Paragraph():Strong("Discussion Goal:"):Text(" Students should step through each line of the pattern, explaining what's happening.")
        Paragraph("Counter Pattern with Event:")
        BulletList()
        ListItem("The counter variable gets the value 0")
        ListItem("When the event is triggered, counter is updated, getting the current value of counter and adding 1.")
        Paragraph("The "):Strong("Counter Pattern with Event"):Text(" might be used to update a score in a game when an item is clicked.")
        EndCallout()
        Subsubsection("Remarks")
        BulletList()
        ListItem("Variables can store many different types of information including numbers and Strings. Anything placed inside of the quotation marks becomes a String.")
        ListItem("Guess what! There's a pattern for working with Strings. When we want to combine Strings with other Strings, numbers, or even with another variable we call that concatenation.")
        Paragraph():Strong("Display:"):Text(" Talk through the pattern with students.")
        CodeExample("text myString = " + dq + "rock" + dq + "
text myOtherString = " + dq + "roll" + dq + "

text myStory = myString + " + dq + " and " + dq + " + myOtherStrin")
        Paragraph():Strong("Discuss:"):Text(" Explain to a partner how the "):DoubleQuote():Text("Variable with String Concatenation Pattern"):DoubleQuote():Text(" works.")
        DiscussionGoal()
        Paragraph():Strong("Discussion Goal:"):Text(" Students should be able to verbally explain how the "):Strong("Variable with String Concatenation Pattern"):Text(" works.")
        EndCallout()
        Subsubsection("Changes")
        BulletList()
        ListItem("myString gets the value "):DoubleQuote():Text("rock"):DoubleQuote()
        ListItem("myOtherString gets the value "):DoubleQuote():Text("roll"):DoubleQuote()
        ListItem("myStory gets the value that is stored in myString ("):DoubleQuote():Text("rock"):DoubleQuote():Text(") and combines that with a string "):DoubleQuote():Text("and"):DoubleQuote():Text(" and the value stored in myOtherString ("):DoubleQuote():Text("roll"):DoubleQuote():Text(")")
        ListItem("myStory now stores the value: "):DoubleQuote():Text("rock and roll"):DoubleQuote()
    end

    private action WrapUp5Minutes
        Section("Wrap Up (5 minutes)")
        Subsection("Remarks")
        BulletList()
        ListItem("The patterns we learned today are present in many different kinds of apps, and we'll learn many new patterns as we go.")
        Paragraph():Strong("Discuss:"):Text(" Let's review. What can be stored in a variable? Why is using a meaningful name for the variable important?")
        DiscussionGoal()
        Paragraph():Strong("Discussion Answers:")
        Paragraph("Please see the Unit4AnswerKey.md document.")
        EndCallout()
        Subsection("Journal")
        Paragraph("Add to your journal the definition for variable.")
        BulletList()
        ListItem():Emphasis("Variable:"):Text(" a reference to a value or expression that can be used repeatedly throughout a program.")
        BulletList()
        ListItem("Today we've learned a lot about how variables work in actual programs.")
    end

    private action AssessmentCheckForUnderstanding
        Section("Assessment: Check for Understanding")
        Paragraph("Check For Understanding Question(s) and solutions can be found in each lesson on Code Studio. These questions can be used for an exit ticket.")
        Subsection("For Students")
        Paragraph("Open a word doc or google doc and copy/paste the following question.")
        Subsection("Question")
        Paragraph("Explain in your own words the process of creating and updating a variable. How does the Counter Pattern with Event work?")
    end

    private action StandardsAlignment
        Section("Standards Alignment")
        BulletList()
        ListItem():Strong("CSTA K-12 Computer Science Standards (2017): "):Text("2-AP-11, 3B-AP-23")
        ListItem():Strong("CSP2021: "):Text("AAP-1.A.2, AAP-1.A.3, AAP-2.D.1")
    end
end
