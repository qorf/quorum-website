use Libraries.Web.Page.QuorumPage

/*
    Variables, Conditionals, and Functions - Lesson 14: Project- Decision Maker App Part 3.
    Converted from the old Lesson page by plan 13's generator: the same
    words, now without Tailwind.
*/
class CodeOrgUnit4Lesson14 is QuorumPage

    on create
        SetLocation("lessons/code/BigDataAndPrivacy/Lesson14.html")
        // The name lists and links use, and the series and track it belongs
        // to: its section and picture.
        SetShortTitle("Project - Decision Maker App Part 3")
        SetSectionName("Variables, Conditionals, and Functions")
        // For search engines and link previews, and what lists of pages say.
        SetDescription("Test and iterate on your app")
        SetSummary("Unit Project Day 3")
    end

    action Setup
        SetWebPageTitle("Unit 4 Lesson 14: Project - Decision Maker App Part 3")
        Title("Variables, Conditionals, and Functions - Lesson 14: Project- Decision Maker App Part 3")
        Overview()
        GettingStarted2Minutes()
        Activity38Minutes()
        WrapUp10Minutes()
        Reflection()
        AssessmentPracticePTDecisionMakerProject()
        StandardsAlignment()
    end

    private action Overview
        Section("Overview")
        Paragraph("The final lesson in the Practice PT progression is devoted to feedback and improvements to the Decision Maker App. Students work with classmates to review and update the functionality of their apps before submitting the final project.")
        Subsection("Goals")
        Paragraph("Students will be able to:")
        BulletList()
        ListItem("See rubric for guidance in measuring student learning")
        Subsection("Purpose")
        Paragraph("The Practice PT gives students the opportunity to design and program an app from scratch. Welcome to The Decision Maker App! Students demonstrate mastery of variables, conditionals, and functions by combining these elements into a useful program designed to solve the problem of making a decision.")
        Subsection("Resources")
        BulletList()
        ListItem():Link("CSP-Widgets repository", "https://github.com/qorf/CSP-Widgets")
        Subsubsection("Supplemental Code.org material")
        Paragraph("For the students")
        BulletList()
        ListItem():Link("CSP Unit 4 Practice PT Rubric", "https://docs.google.com/document/d/1mldgFK3CJbsWnTS8WYVDtEY1e7V4c0_V0sv63dYUkG8/edit?usp=sharing")
        ListItem():Link("CSP Unit 4 Practice PT Planning Guide", "https://docs.google.com/document/d/1IojBJ1NQPDz4SajskdWq_6LSstg3_9EgpTAwQf63M5g/edit?usp=sharing")
    end

    private action GettingStarted2Minutes
        Section("Getting Started (2 minutes)")
        TeachingTip()
        Paragraph():Strong("Short Intro:"):Text(" The Warm Up today is short and light. Students should spend the maximum amount of time working on their projects.")
        EndCallout()
        Subsection("Remarks")
        BulletList()
        ListItem("For the past few days we've been working on an app to help users make a decision. Now you will share that app with others, get feedback, make improvements, and submit for your final project.")
    end

    private action Activity38Minutes
        Section("Activity (38 minutes)")
        TeachingTip()
        Paragraph():Strong("Supporting students in Practice PT Lessons")
        Paragraph("This is the final lesson where students complete their projects. The classroom energy will likely increase when students begin Step 5 and collect feedback from classmates. Encourage students to work productively during the testing phase so they have enough time to finish their projects.")
        Paragraph("What should you expect?")
        BulletList()
        ListItem("It's ok to start the testing phase even if the apps aren't finished. Students should be able to explain to each other what they want their app to do when fully operational.")
        ListItem("Students should have their Planning Guides out again to record feedback and plans for implementing changes")
        ListItem("Frustration may be higher today if students feel rushed to debug and fix their projects for final submission. Make sure students have debugging partners and are actively making use of their debugging skills.")
        ListItem("If students are inspired to continue working on their projects or add additional features, you may need to extend the project an extra day or allow students to work outside of class.")
        EndCallout()
        Paragraph():Strong("Group:"):Text(" Put students in groups of 3-4.")
        Paragraph():Strong("Do This:"):Text(" Direct students to open their projects. They should pull out their Planning Guides and with their group complete Step 5: Testing.")
        Paragraph():Strong("Step 5:"):Text(" Testing")
        BulletList()
        ListItem("Each app is tested by at least two students.")
        ListItem("The creator of the app watches these students use the app and records feedback from the testers and things the creator noticed while observing someone else using the app. For example, the creator may notice that the user has difficulty figuring out which button to click on the app to make it run. The creator notes this down in the Planning Guide.")
        Paragraph():Strong("Step 6:"):Text(" Pick Improvements")
        BulletList()
        ListItem("In the Planning Guide, students pick at least one improvement that they can make based on feedback from their peers.")
        Paragraph():Strong("Step 7:"):Text(" Complete your App")
        BulletList()
        ListItem("Students use the feedback to update their app.")
        Paragraph():Strong("Submit:"):Text(" Students complete a final check of their complected projects before they submit their work. Make sure they have access to the rubric (Refer to Unit4 Lesson12 or the supplemental document).")
    end

    private action WrapUp10Minutes
        Section("Wrap Up (10 minutes)")
    end

    private action Reflection
        Section("Reflection")
        Paragraph("Complete the two reflection questions below from the Planning Guide.")
        Paragraph():Strong("Question 1:"):Text(" Provide a written response that:")
        BulletList()
        ListItem("describes the overall purpose of the program")
        ListItem("describes the functionality of your app")
        ListItem("describes the input and outputs of your app (Approx 150)")
        Paragraph():Strong("Question 2:"):Text(" This project was created using a development process that required you to incorporate the ideas of your partner and feedback from your classmates. Provide a written response that describes one part of your app that was improved through input from EITHER your partner or feedback you received from classmates. Include:")
        BulletList()
        ListItem("Who specifically provided the idea or recommendation")
        ListItem("What their idea or recommendation was")
        ListItem("The specific change you made to your app's user interface or functionality in response to the recommendation")
        ListItem("How you believe this change improved your app (Approx 150 words)")
    end

    private action AssessmentPracticePTDecisionMakerProject
        Section("Assessment: Practice PT Decision Maker Project")
        Paragraph("Use the "):Link("CSP U4 Practice PT Rubric", "https://docs.google.com/document/d/1mldgFK3CJbsWnTS8WYVDtEY1e7V4c0_V0sv63dYUkG8/edit?usp=sharing"):Text(" provided with the project (or posted in Unit4 Lesson 12) to assess student work.")
    end

    private action StandardsAlignment
        Section("Standards Alignment")
        BulletList()
        ListItem():Strong("CSTA K-12 Computer Science Standards (2017): "):Text("2-AP-10, 2-AP-11, 3A-AP-16, 3B-AP-14")
    end
end
