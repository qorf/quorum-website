use Libraries.Web.Page.QuorumPage

/*
    Algorithms - Lesson 3: Unreasonable Time.
    Converted from the old Lesson page by plan 13's generator: the same
    words, now without Tailwind.
*/
class CodeOrgUnit6Lesson3 is QuorumPage

    on create
        SetLocation("lessons/code/Algorithms/Lesson3.html")
        // The name lists and links use, and the series and track it belongs
        // to: its section and picture.
        SetShortTitle("Unreasonable Time")
        SetSectionName("Algorithms")
        // For search engines and link previews, and what lists of pages say.
        SetDescription("Learn what it means to say that one algorithm is ")
        SetSummary("Learn why onLesson 4thm is more efficient than another")
    end

    action Setup
        SetWebPageTitle("Unit 6 Lesson 3: Unreasonable Time")
        Title("Algorithms - Lesson 3: Unreasonable Time")
        Overview()
        GettingStarted5Minutes()
        Activity30Minutes()
        WrapUp10Minutes()
        AssessmentCheckForUnderstanding()
        StandardsAlignment()
    end

    private action Overview
        Section("Overview")
        Paragraph("Students investigate two different types of raffles that highlight the way seemingly small problems can quickly grow large. The first raffle asks students to hunt for pairs of tickets that add to a target value. The second raffle asks students to hunt for any group of tickets that adds to a target value. After trying out each raffle live students will try to figure out the patterns for how many total combinations need to be checked in each. At the end they discuss the difference between reasonable and unreasonable algorithms based on their experiences.")
        Subsection("Goals")
        Paragraph("Students will be able to:")
        BulletList()
        ListItem("Explain the difference between problems that run in a reasonable time and those that do not")
        ListItem("Explain how both formal mathematical reasoning and informal measurement can be used to determine an algorithm's efficiency")
        Subsection("Purpose")
        Paragraph("This lesson explores some tricky mathematical concepts in a hands on and interactive way. Building off the raffle analogy used in the previous lesson, it gives students an experience with two types of problems that grow quickly in size, though as they'll see one grows much faster than the other. This lesson should give students a sense of how computer scientists use mathematics to think about problems without relying too heavily on mathematical background that not all students may have.")
        Subsection("Resources")
        BulletList()
        ListItem():Link("Unreasonable Time - Activity Guide", "https://docs.google.com/document/d/13VSFGtFwbJT73aYr4VnNJrsbnbyZBTDiSImVkqJGc5w/edit?usp=sharing")
        ListItem():Link("CSP-Widgets Repository", "https://github.com/qorf/CSP-Widgets")
    end

    private action GettingStarted5Minutes
        Section("Getting Started (5 minutes)")
        Paragraph():Strong("Prompt: "):Text("What does it mean to say one algorithm is "):DoubleQuote():Text("more efficient"):DoubleQuote():Text(" than another?")
        Paragraph():Strong("Discuss: "):Text("Have students think about their answers on their own, then share with a partner, and then finally discuss responses with the entire room.")
        DiscussionGoal()
        Paragraph("This prompt is a review from the previous lesson. Students should be free to refer to notes or their journals. You might hear the following points.")
        BulletList()
        ListItem("One algorithm requires fewer steps to complete than another")
        ListItem():DoubleQuote():Text("The line for one algorithm curves below the other"):DoubleQuote()
        ListItem("More efficient algorithms are much more helpful as input size grows. The amount of work grows more slowly.")
        EndCallout()
        Subsection("Remarks")
        BulletList()
        ListItem("Yesterday we started looking at how computer scientists might compare two algorithms that solve the same problem. Today we're going to look at two different problems. They may seem similar but as we'll see they actually are much harder to solve than either of the two we saw yesterday. The question will be "):DoubleQuote():Text("how much harder"):DoubleQuote():Text("? Let's get to it!")
    end

    private action Activity30Minutes
        Section("Activity (30 minutes)")
        Paragraph():Strong("Open a Project: "):Text("Have students re-open the "):Strong("Lesson2_TicketGenerator"):Text(" project in the Unit 6 folder of the CSP-Widgets repository. Students will use this to randomly generate ticket numbers for today's activity.")
        Paragraph():Strong("Problem #1 - The Pair Raffle: "):Text("Every student will generate a ticket. Any pair of students win the raffle if their two tickets add to the winning number. The winning number is 1000.")
        Paragraph():Strong("Do This:")
        NumberedList()
        ListItem("Generate a ticket")
        ListItem("Silently move around the room")
        ListItem("See if you're part of a winning pair!")
        Paragraph():Strong("Circulate: "):Text("Give students a couple of minutes to walk around the room seeing if they can find a partner with which they can win the raffle. After a couple of minutes have them return to their desks. If there are any winners feel free to celebrate.")
        TeachingTip()
        Paragraph("Both because it helps give students a sense of the problem space and because it's fun to run a raffle, you should run both the pair raffle and the group raffle in your classroom. Here's some helpful tips.")
        BulletList()
        ListItem("Insist that students check for the pair raffle silently. For this one it's very easy to just yell out what number you would pair with and lose the opporuntity to see how many total checks are necessary if they can just all yell from their seats.")
        ListItem("The group raffle doesn't necessarily need to be silent. As students will see, it's an incredibly difficult problem and they're going to need to do a lot of checking even if they're able to talk out loud.")
        ListItem("Think ahead about whether you actually want to award winners of the raffles. It's pretty unlikely that there will be a winner.")
        ListItem("There's a pretty good chance that no one will win either raffle.")
        ListItem("As computer scientists we're getting better at thinking about problems and algorithms. We also saw last time that we can use a little mathematical reasoning to decide if one algorithm is more efficient than the other. Let's do a little work on these two raffles to see if our intuitions are correct.")
        EndCallout()
        BulletList()
        ListItem("Alright, that was interesting. Let's try out a different version of the raffle. Last time I made you work silently so that we got a better sense of how many checks needed to happen. This time we're going to run a group raffle, but I'll let you talk out loud if you want.")
        Paragraph():Strong("Problem #2 - The Group Raffle: "):Text("Each student generates a new ticket. The winners are any group of students (from one ticket up to all of them) that adds up to the winning number. The winning number is 2500.")
        Paragraph():Strong("Do This:")
        NumberedList()
        ListItem("Generate a ticket")
        ListItem("Move around the room (you can talk this time)")
        ListItem("See if you're part of a winning group!")
        Paragraph():Strong("Circulate: "):Text("Give students a couple of minutes to walk around the room seeing if they can find a group with which they can win the raffle. After a couple of minutes have them return to their desks. If there are any winners feel free to celebrate.")
        Paragraph():Strong("Prompt: "):Text("Which raffle felt like it was more difficult to check? Why?")
        Paragraph():Strong("Discuss: "):Text("Have students discuss this prompt with a neighbor. Then have a few students share out their reflections.")
        DiscussionGoal()
        Paragraph("This discussion is primarily designed to get quick reactions from students to motivate the second big activity in this lesson. Students will likely note that the group raffle felt a lot harder to check, even with the ability to talk. That said, there's no wrong answers at this point. You're about to check their intutions mathematically.")
        EndCallout()
        Subsection("Remarks")
        BulletList()
        Paragraph():Strong("Distribute:"):Text(" Distribute copies of "):Link("Unreasonable Time - Activity Guide", "https://docs.google.com/document/d/13VSFGtFwbJT73aYr4VnNJrsbnbyZBTDiSImVkqJGc5w/edit?usp=sharing")
        Paragraph():Strong("Problem #1 - The Pair Raffle: "):Text("Ask students to fill out the first page where they must figure out the total number of pairs for different sized "):DoubleQuote():Text("pair raffles"):DoubleQuote():Text(". This may take several minutes and require students to draw pictures.")
        Paragraph():Strong("Problem #2 - The Group Raffle: "):Text("Ask students to fill out the second page where they must figure out the total number of groups for different sized "):DoubleQuote():Text("group raffles"):DoubleQuote():Text(". This may take several minutes and require students to draw pictures.")
        Paragraph():Strong("Share Responses: "):Text("Ask students to share their responses with another group.")
        Paragraph():Strong("Display: "):Text("Look at the chart as a class and examine the graph. The graph visualizes the pattern the class discussed.")
        Table("Raffle Tickets - Polynomial Time Table")
        TableHeader():Cell("Tickets"):Cell("Checks")
        TableRow():Cell("2"):Cell("1")
        TableRow():Cell("3"):Cell("3")
        TableRow():Cell("4"):Cell("6")
        TableRow():Cell("5"):Cell("10")
        TableRow():Cell("8"):Cell("28")
        Image("media/lessons/csp/unit6/polynomialTimeGraph.png", "A graph mapping the number of tickets to the number of checks to solve the problem. The result is a upward curved line where the y axis grows faster than the x axis. ")
        Paragraph("The exact formula for this relationship is (n^2 - n)/2 You don’t need to know that formula, but you should know that because of the "):DoubleQuote():Text("n-squared"):DoubleQuote():Text(" term the graph curves up. Any algorithm whose efficiency includes an n2, n3, n4 … is called polynomial.")
        Table("Raffle Tickets - Exponential Time Table")
        TableHeader():Cell("Tickets"):Cell("Checks")
        TableRow():Cell("2"):Cell("3")
        TableRow():Cell("3"):Cell("7")
        TableRow():Cell("4"):Cell("15")
        TableRow():Cell("5"):Cell("31")
        TableRow():Cell("8"):Cell("255")
        Image("media/lessons/csp/unit6/exponentialTimeGraph.png", "A graph mapping the number of tickets to the number of checks to solve the problem. The result is a upward curved line where the y axis grows MUCH faster than the x axis. This patttern is called exponential.")
        Paragraph("The exact formula for this relationship is (2^n) - 1 You don’t need to know that formula, but you should know that because of the "):DoubleQuote():Text("2 to the n"):DoubleQuote():Text(" term the graph curves up very quickly. Any algorithm whose efficiency includes an 2n, 3n, 4n … is called exponential.")
        Paragraph():Strong("Prompt: "):Text("Polynomial and exponential both curve up. Why do you think only exponential is considered "):DoubleQuote():Text("unreasonable"):DoubleQuote():Text("?")
        Paragraph():Strong("Discuss: "):Text("Briefly ask students for their ideas why before showing them the following slides. Exponential curves grow extremely quickly. You simply can't build a computer fast enough even for relatively small raffle sizes.")
        Image("media/lessons/csp/unit6/efficiencyComparisonGraph.png", " A graph showing the 4 different efficiencies (log, linear, polynomial, exponential). For log and linear the x axis grows the same or less than the y axis. The polynomial grows faster on the y axis than the x axis but it is not as steep as exponential. The exponential grows on the y axis so much faster than on the x axis it is considered unreasonable.  ")
        Table("Raffle Tickets - Time Complexities")
        TableHeader():Cell("Tickets"):Cell("Sorted Raffle (log)"):Cell("Normal Raffle (linear)"):Cell("Pair Raffle (polynomial)"):Cell("Group Raffle (exponential)")
        TableRow():Cell("10"):Cell("4 Checks"):Cell("10 Checks"):Cell("100 Checks"):Cell("1,024 Checks")
        TableRow():Cell("20"):Cell("5 Checks"):Cell("20 Checks"):Cell("400 Checks"):Cell("1,048,576 Checks")
        TableRow():Cell("100"):Cell("7 Checks"):Cell("100 Checks"):Cell("10,000 Checks"):Cell("1.26*10^30 Checks")
        TableRow():Cell("1000"):Cell("10 Checks"):Cell("1000 Checks"):Cell("1,000,000 Checks"):Cell("1.07*10^301 Checks")
        TableRow():Cell("10,000"):Cell("14 Checks"):Cell("10,000 Checks"):Cell("100,000,000 Checks"):Cell("2.00*10^3010 Checks")
        TableRow():Cell("100,000"):Cell("17 Checks"):Cell("100,000 Checks"):Cell("1.00*10^10 Checks"):Cell("9.99*10^30102 Checks")
        Paragraph("Polynomial is bad but exponential gets unreasonably large extremely quickly.")
        Paragraph("Note that 1.07*10^301 Checks (1000 tickets in a group raffle) is more checks than atoms in the entire universe!")
    end

    private action WrapUp10Minutes
        Section("Wrap up (10 Minutes)")
        Paragraph():Strong("Prompt: "):Text("Your school is considering running the group raffle at an upcoming assembly to give away a prize. Write a brief explanation of what advice you would give them.")
        Paragraph():Strong("Discuss: "):Text("Have students think about their answers on their own, then share with a partner, and then finally discuss responses with the entire room.")
        DiscussionGoal()
        Paragraph("Use this discussion to reinforce vocabulary introduced in the slides and make sure they have understood the main concepts of the day. Students should be able to explain with the term reasonable, unreasonable, and exponential, why running a group raffle in a school of most sizes is impossible.")
        EndCallout()
        Subsection("Remarks")
        BulletList()
        ListItem("The group raffle is just one example of an algorithm that is "):DoubleQuote():Text("unreasonable"):DoubleQuote():Text(". It grows exponentially and so we'd never want to run it at our school. Next time we'll talk more about what to do when we encounter unreasonable problems.")
        Paragraph():Strong("Journal: "):Text("Students add the following vocabulary words and definitions to their journals:")
        BulletList()
        ListItem():Emphasis("Unreasonable time:"):Text(" Algorithms with exponential or factorial efficiencies are examples of algorithms that run in an unreasonable amount of time.")
        ListItem():Emphasis("Reasonable time:"):Text(" Algorithms with a polynomial efficiency or lower (constant, linear, square, cube, etc.) are said to run in a reasonable amount of time.")
    end

    private action AssessmentCheckForUnderstanding
        Section("Assessment: Check for Understanding")
        Subsection("For Students")
        Paragraph("Open a word doc or google doc and copy/paste the 2 following questions.")
        Subsection("Question 1")
        Paragraph("Which of the follow efficiencies would be considered unreasonable?")
        NumberedList()
        ListItem("a. 2^n")
        ListItem("b. 2n")
        ListItem("c. n^2")
        ListItem("d. n^20")
        Subsection("Question 2")
        Paragraph("A team of programmers is trying to determine the efficiency of a piece of code. They run the code with inputs of different sizes and also record the number of iterations through the core block of code. The data is recorded in the table below.")
        Table("Raffle Tickets - Iterations")
        TableHeader():Cell("Input Size (Tickets)"):Cell("Iterations (Checks)")
        TableRow():Cell("10"):Cell("200")
        TableRow():Cell("20"):Cell("400")
        TableRow():Cell("30"):Cell("600")
        TableRow():Cell("40"):Cell("800")
        TableRow():Cell("50"):Cell("1000")
        TableRow():Cell("100"):Cell("2000")
        Paragraph("Based on the data provided, does this algorithm run in a reasonable or unreasonable time? Explain your answer")
    end

    private action StandardsAlignment
        Section("Standards Alignment")
        BulletList()
        ListItem():Strong("CSTA K-12 Computer Science Standards (2017): "):Text("3B-AP-11")
        ListItem():Strong("CSP2021: "):Text("AAP-4.A.4, AAP-4.A.7")
    end
end
