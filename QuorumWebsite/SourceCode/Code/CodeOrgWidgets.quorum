use Libraries.Web.Page.QuorumPage

/*
    Computer Science Principles Widgets.
    Converted from the old Lesson page by plan 13's generator: the same
    words, now without Tailwind.
*/
class CodeOrgWidgets is QuorumPage

    on create
        SetLocation("lessons/code/CodeOrgWidgets.html")
        // The name lists and links use, and the series and track it belongs
        // to: its section and picture.
        SetShortTitle("Computer Science Principles Widgets")
        // For search engines and link previews, and what lists of pages say.
        SetDescription("A page of all the widgets used in the Computer Science Principles course")
        SetSummary("explore the widgets used in the Computer Science Principles course")
    end

    action Setup
        SetWebPageTitle("Computer Science Principles Widgets")
        Title("Computer Science Principles Widgets")
        Paragraph("A collection of widgets ued in CS Principles Lessons")
        Widgets()
        BinaryCalculator()
        TextCompression()
        Cryptography()
    end

    private action Widgets
        Section("Widgets")
        Paragraph("Students can explore concepts from our Computer Science Principles course hands-on using these digital tools. Let them encrypt and decrypt messages, compress song lyrics, and more! Use the widgets on their own, or create a single-concept lesson for your class using the plans linked with each widget below.")
    end

    private action BinaryCalculator
        Section("Binary Calculator")
        Paragraph("This widget allows students to input a number (in decimal), and then the number is converted to binary, octal, and hexadecimal. This widget is used in "):Link("Unit 1 Lesson 5", "internet/InternetLesson5.html"):Text(".")
        BulletList()
        ListItem():Link("Binary Calculator Widget", "https://quorumlanguage.com/Project.quorum?user=Projects&file=Binary+Calculator")
    end

    private action TextCompression
        Section("Text Compression")
        Paragraph("These widgets let students compress textual phrases into smaller pieces. One widget performs lossless text compression, while the other performs lossy text compression. The following video uses Code.org's text compression widgets as examples, but helps explain the purpose of each. Further information can be found in the lessons in which the widgets are used.")
        Video("https://www.youtube.com/embed/By30SCp-Tsw", "Digital Compression explained by Aloe Blacc")
        BulletList()
        ListItem():Link("Video: Digital Compression Explained by Aloe Blacc", "https://www.youtube.com/watch?v=By30SCp-Tsw")
        Subsection("Lossless Text Compression")
        Paragraph("This widget gives students the chance to compress a piece of text. Students can use this to learn how to identify patterns, store those patterns in a "):DoubleQuote():Text("dictionary,"):DoubleQuote():Text(" and then replace the dictionary pattern with a number to create a lossless compressed version of text. The widget updates with each new portion entered and performs compression calculations so students can see if they're increasing or decreasing the total file size in real-time as they work. This widget is used in "):Link("Unit 2 Lesson 2", "Digital-Information/Lesson2.html"):Text(".")
        BulletList()
        ListItem():Link("Lossless Text Compression Widget", "https://quorumlanguage.com/Project.quorum?user=Projects&file=Text+Compression")
        Paragraph():Strong("A challenge for students:"):Text(" How can you achieve the best compression possible by representing patterns of patterns? Have fun harnessing the power of this compression technique through experimentation, but also be aware that it can go very, very wrong.")
        Subsubsection("Lossy Compression")
        Paragraph("This widget gives another chance for students to compress a piece of text, though this one works differently from the "):DoubleQuote():Text("Text Compression"):DoubleQuote():Text(" widget. Instead of substituting patterns of text using a "):DoubleQuote():Text("dictionary,"):DoubleQuote():Text(" lossy compression loses part of the original message but tries its best not to change the meaning of the message, though occassionally the result is ambiguous. For example, consider abbreviations people use in texting; most people recognize common abbreviations, such as "):DoubleQuote():Text("OMW"):DoubleQuote():Text(" representing the statement "):DoubleQuote():Text("On My Way."):DoubleQuote():Text(" This compresses the message to save us the trouble of fully writing out the phrase, but it is lossy compression because many letters are dropped, which could make the message ambiguous to those who aren't familiar with the abbreviation. This widget is used in "):Link("Unit 2 Lesson 5", "Digital-Information/Lesson5.html"):Text(".")
        BulletList()
        ListItem():Link("Lossy Compression Widget", "https://quorumlanguage.com/Project.quorum?user=Projects&file=Lossy+Compression")
    end

    private action Cryptography
        Section("Cryptography")
        Paragraph("These widgets let students play with some classic schemes for both encrypting and "):DoubleQuote():Text("cracking"):DoubleQuote():Text(" secret messages. The following video uses Code.org's cryptography widgets as examples, but helps explain their purpose. Specific information on each individual widget can be found in the lessons in which the widgets are used.")
        Video("https://www.youtube.com/embed/ZghMPWGXexs", "The Internet: Encryption & Public Keys")
        BulletList()
        ListItem():Link("Video: Digital Compression Explained by Aloe Blacc", "https://www.youtube.com/watch?v=ZghMPWGXexs")
        Subsection("Caesar Cipher")
        Paragraph("This widget uses the Caesar shift, which encrypts a message by shifting the alphabet forward or backward by a set number of places. This widget is used in "):Link("Unit 4 Lesson 7", "BigDataAndPrivacy/Lesson7.html"):Text(".")
        BulletList()
        ListItem():Link("Caesar Cipher Widget", "https://quorumlanguage.com/Project.quorum?user=Projects&file=Caesar+Cipher")
        Subsubsection("Random Substitution Cipher")
        Paragraph("This widget uses the random substitution method of encryption, which does a 1:1 substitution of one alphabet letter for another, randomly assigning the substitutions. This widget is used in "):Link("Unit 4 Lesson 7", "BigDataAndPrivacy/Lesson7.html"):Text(".")
        BulletList()
        ListItem():Link("Random Substitution Cipher Widget", "https://quorumlanguage.com/Project.quorum?user=Projects&file=Substitution+Cipher")
        Subsubsection("Vigenere Cipher")
        Paragraph("This widget allows students to play with a much more sophisticated encryption technique that was considered virtually unbreakable for a very long time. The Vigenere Cipher is similar to the Caesar or random substitution ciphers, but the alphabetic shift changes for each letter based on a secret key. This widget is used in "):Link("Unit 4 Lesson 8", "BigDataAndPrivacy/Lesson8.html"):Text(".")
        BulletList()
        ListItem():Link("Vigenere Encryption Widget", "https://quorumlanguage.com/Project.quorum?user=Projects&file=Vigenere+Encryption")
        ListItem():Link("Vigenere Decryption Widget", "https://quorumlanguage.com/Project.quorum?user=Projects&file=Vigenere+Decryption")
        Subsubsection("Modulo Calculator")
        Paragraph("The Modulo Calculator widget helps students learn how to use the modulo operation, which results in the remainder after dividing two positive integers. Modulo operations are key to certain encryption methods, so understanding them is crucial to using the "):DoubleQuote():Text("Public Key Cryptography"):DoubleQuote():Text(" widget. This widget is used in "):Link("Unit 4 Lesson 9", "BigDataAndPrivacy/Lesson9.html"):Text(".")
        BulletList()
        ListItem():Link("Modulo Calculator Widget", "https://quorumlanguage.com/Project.quorum?user=Projects&file=Modulo+Calculator")
        Subsubsection("Public Key Cryptography")
        Paragraph("Compared to the other cipher widgets, Public Key Cryptography is much closer to methods actually used on the Internet today. By exchanging public information that can only be accessed using private information, Public Key Cryptography allows two people to exchange encrypted information over insecure channels, such as the Internet. This widget is used in "):Link("Unit 4 Lesson 9", "BigDataAndPrivacy/Lesson9.html"):Text(".")
        BulletList()
        ListItem():Link("Public Key Cryptography Widget", "https://quorumlanguage.com/Project.quorum?user=Projects&file=Public+Cryptography")
    end
end
