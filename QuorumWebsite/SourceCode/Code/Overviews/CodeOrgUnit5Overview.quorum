use Libraries.Web.Page.QuorumPage

/*
    Unit 5: Building Apps.
    Converted from the old Lesson page by plan 13's generator: the same
    words, now without Tailwind.
*/
class CodeOrgUnit5Overview is QuorumPage
    // A double quote, for code and words that hold one.
    text dq = ""

    on create
        SetLocation("lessons/code/Unit5.html")
        // The name lists and links use, and the series and track it belongs
        // to: its section and picture.
        SetShortTitle("Unit 5: Building Apps Overview")
        // For search engines and link previews, and what lists of pages say.
        SetDescription("Expand on basics learned in Unit 3 to program interactive applications in the 
            Quorum Programming Language.")
        SetSummary("Unit 5 Overview and Lesson Links")
    end

    action Setup
        dq = dq:GetDoubleQuote()
        SetWebPageTitle("Unit 5: Building Apps - Computer Science Principles in Quorum Programming Language")
        Title("Unit 5: Building Apps")
        Paragraph("This unit continues to develop students' ability to program in the Quorum language to create a series of small applications (apps) that live on the web, each highlighting a core concept of programming. In this unit students transition to creating event-driven apps. The unit assumes that students have learned the concepts and skills from Unit 3, namely: writing and using actionss, using simple repeat loops, being able to read documentation, and collaborating")
        Part51EventDrivenProgramming()
        BigQuestions()
        EnduringUnderstandings()
        OptionalLessons()
        Chapter2ProgrammingWithDataStructures()
        BigQuestions2()
        EnduringUnderstandings2()
        OptionalLessons2()
    end

    private action Part51EventDrivenProgramming
        Section("5.1: Event-Driven Programming")
        NumberedList()
        ListItem():Link("Lesson 1: Introduction to Event-Driven Programming", "buildingApps/Lesson1")
        ListItem():Link("Lesson 2: Multi-Screen Apps", "buildingApps/Lesson2")
        ListItem():Link("Lesson 3: Building an App: Multi-Screen App", "buildingApps/Lesson3.html")
        ListItem():Link("Lesson 4: Controlling Memory with Variables", "buildingApps/Lesson4")
        ListItem():Link("Lesson 5: Building an App: Clicker Game", "buildingApps/Lesson5")
        ListItem():Link("Lesson 6: User Input and Strings (Text)", "buildingApps/Lesson6")
        ListItem():Link("Lesson 7: If-Statements: Unplugges", "buildingApps/Lesson7")
        ListItem():Link("Lesson 8: Boolean Expressions and " + dq + "if" + dq + " statements", "buildingApps/Lesson8")
        ListItem():Link("Lesson 9: " + dq + "if/elseif" + dq + " statements and Conditional Logic", "buildingApps/Lesson9")
        ListItem():Link("Lesson 10: Building an App: Color Sleuth", "buildingApps/Lesson10")
    end

    private action BigQuestions
        Section("Big Questions")
        BulletList()
        ListItem("How do you program apps to respond to user "):DoubleQuote():Text("events"):DoubleQuote():Text("?")
        ListItem("How do you write programs to make decisions?")
        ListItem("How do programs keep track of information?")
        ListItem("How creative is programming?")
        ListItem("How do people develop, test, and debug programs?")
        ListItem("How are real world phenomena modeled and simulated on a computer?")
        ListItem("How do you write programs to store and retrieve lots of information?")
        ListItem("What are "):DoubleQuote():Text("data structures"):DoubleQuote():Text(" in a program and when do you need them?")
        ListItem("How are algorithms evaluated for "):DoubleQuote():Text("speed"):DoubleQuote():Text("?")
    end

    private action EnduringUnderstandings
        Section("Enduring Understandings")
        BulletList()
        ListItem("1.1 Creative development can be an essential process for creating computational artifacts.")
        ListItem("1.2 Computing enables people to use creative development processes to create computational artifacts for creative expression or to solve a problem.")
        ListItem("1.3 Computing can extend traditional forms of human expression and experience.")
        ListItem("2.2 Multiple levels of abstraction are used to write programs or create other computational artifacts.")
        ListItem("4.1 Algorithms are precise sequences of instructions for processes that can be executed by a computer and are implemented using programming languages.")
        ListItem("5.1 Programs can be developed for creative expression, to satisfy personal curiosity, to create new knowledge, or to solve problems (to help people, organizations, or society).")
        ListItem("5.2 People write programs to execute algorithms.")
        ListItem("5.3 Programming is facilitated by appropriate abstractions.")
        ListItem("5.4 Programs are developed, maintained, and used by people for different purposes.")
        ListItem("5.5 Programming uses mathematical and logical concepts.")
        ListItem("7.1 Computing enhances communication, interaction, and cognition.")
    end

    private action OptionalLessons
        Section("Optional Lessons")
        BulletList()
        ListItem("None")
    end

    private action Chapter2ProgrammingWithDataStructures
        Section("Chapter 2: Programming with Data Structures")
        NumberedList()
        ListItem():Link("Lesson 11: While Loops", "buildingApps/Lesson11")
        ListItem():Link("Lesson 12: Loops and Simulations", "buildingApps/Lesson12")
        ListItem():Link("Lesson 13: Introduction to Arrays", "buildingApps/Lesson13")
        ListItem():Link("Lesson 14: Building an App: Image Scroller", "buildingApps/Lesson14")
        ListItem():Link("Lesson 15: Processing Arrays", "buildingApps/Lesson15")
        ListItem():Link("Lesson 16: Actions with Return Values", "buildingApps/Lesson16")
        ListItem():Link("Lesson 17: Building an App- Canvas Painter", "buildingApps/Lesson17")
    end

    private action BigQuestions2
        Section("Big Questions")
        BulletList()
    end

    private action EnduringUnderstandings2
        Section("Enduring Understandings")
        BulletList()
        ListItem("2.3 Models and simulations use abstraction to generate new understanding and knowledge.")
        ListItem("3.1 People use computer programs to process information to gain insight and knowledge.")
        ListItem("4.1 Algorithms are precise sequences of instructions for processes that can be executed by a computer and are implemented using programming languages.")
        ListItem("5.1 Programs can be developed for creative expression, to satisfy personal curiosity, to create new knowledge, or to solve problems (to help people, organizations, or society)")
    end

    private action OptionalLessons2
        Section("Optional Lessons")
        BulletList()
        ListItem():Link("Lesson 18: Practice PT- Create Your Own App", "lessons/code/buildingApps/Lesson18.html")
    end
end
