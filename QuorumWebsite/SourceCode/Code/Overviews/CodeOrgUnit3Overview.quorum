use Libraries.Web.Page.QuorumPage

/*
    Unit 3: Intro to Programming.
    Converted from the old Lesson page by plan 13's generator: the same
    words, now without Tailwind.
*/
class CodeOrgUnit3Overview is QuorumPage

    on create
        SetLocation("lessons/code/Unit3.html")
        // The name lists and links use, and the series and track it belongs
        // to: its section and picture.
        SetShortTitle("Unit 3: Intro to Programming Overview")
        // For search engines and link previews, and what lists of pages say.
        SetDescription("Learn the foundational principles of computer programming, and how to make
            functional apps. This course uses the Quorum Programming Language.")
        SetSummary("Unit 3 Overview and Lesson Links")
    end

    action Setup
        SetWebPageTitle("Unit 3: Intro to Programming - Computer Science Principles in Quorum Programming Language")
        Title("Unit 3: Intro to Programming")
        Paragraph("This unit introduces the foundational concepts of computer programming, which unlocks the ability to make rich, interactive apps. This course uses Quorum Programming Language as the programming language to build apps, but the concepts learned in these lessons span all programming languages and tools.")
        Chapter1ProgrammingLanguagesAndAlgorithms()
        BigQuestions()
        EnduringUnderstandings()
        OptionalLessons()
    end

    private action Chapter1ProgrammingLanguagesAndAlgorithms
        Section("Chapter 1: Programming Languages and Algorithms")
        NumberedList()
        ListItem():Link("Lesson 1: The Need for Programming Languages", "Algorithm-Programming/Lesson1.html")
        ListItem():Link("Lesson 2: The Need for Algorithms", "Algorithm-Programming/Lesson2.html")
        ListItem():Link("Lesson 3: Creativity in Algorithms", "Algorithm-Programming/Lesson3.html")
        ListItem():Link("Lesson 4: Using Simple Commands", "Algorithm-Programming/Lesson4.html")
        ListItem():Link("Lesson 5: Creating Actions", "Algorithm-Programming/Lesson5.html")
        ListItem():Link("Lesson 6: Actions and Top-Down Design", "Algorithm-Programming/Lesson6.html")
        ListItem():Link("Lesson 7: APIs/Libraries and Action Parameters", "Algorithm-Programming/Lesson7.html")
        ListItem():Link("Lesson 8: Creating Actions with Parameters", "Algorithm-Programming/Lesson8.html")
        ListItem():Link("Lesson 9: Looping and Random Numbers", "Algorithm-Programming/Lesson9.html")
    end

    private action BigQuestions
        Section("Big Questions")
        BulletList()
        ListItem("Why do we need algorithms?")
        ListItem("How is designing an algorithm to solve a problem different from other kinds of problem solving?")
        ListItem("How do you design a solution for a problem so that is programmable?")
        ListItem("What does it mean to be a "):DoubleQuote():Text("creative"):DoubleQuote():Text(" programmer?")
        ListItem("How do programmers collaborate?")
    end

    private action EnduringUnderstandings
        Section("Enduring Understandings")
        BulletList()
        ListItem("1.1 Creative development can be an essential process for creating computational artifacts.")
        ListItem("1.2 Computing enables people to use creative development processes to create computational artifacts for creative expression or to solve a problem.")
        ListItem("2.2 Multiple levels of abstraction are used to write programs or create other computational artifacts.")
        ListItem("4.1 Algorithms are precise sequences of instructions for processes that can be executed by a computer and are implemented using programming languages.")
        ListItem("5.1 Programs can be developed for creative expression, to satisfy personal curiosity, to create new knowledge, or to solve problems (to help people, organizations, or society).")
        ListItem("5.2 People write programs to execute algorithms.")
        ListItem("5.3 Programming is facilitated by appropriate abstractions.")
    end

    private action OptionalLessons
        Section("Optional Lessons")
        BulletList()
        ListItem():Link("Lesson 10: Practice PT- Design a Digital Scene", "Algorithm-Programming/Lesson10.html")
    end
end
