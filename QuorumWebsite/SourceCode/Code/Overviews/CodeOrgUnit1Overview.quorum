use Libraries.Web.Page.QuorumPage

/*
    Unit 1: The Internet.
    Converted from the old Lesson page by plan 13's generator: the same
    words, now without Tailwind.
*/
class CodeOrgUnit1Overview is QuorumPage

    on create
        SetLocation("lessons/code/Unit1.html")
        // The name lists and links use, and the series and track it belongs
        // to: its section and picture.
        SetShortTitle("Unit 1: The Internet Overview")
        SetCardImage("/media/userInterface/quorumAssets/cspImages/csp2.svg")
        SetCardDescription("This unit reveals how the Internet was designed to connect billions of devices and people to one another. Learn how the different protocols of the Internet work together. ")
        // For search engines and link previews, and what lists of pages say.
        SetDescription("Learn about The Internet, including the digital representation of 
                information - numbers, text, images, and communication protocols.")
        SetSummary("Unit 1 Overview and Lesson Links")
    end

    action Setup
        SetWebPageTitle("Unit 1: The Internet - Computer Science Principles in Quorum Programming Language")
        Title("Unit 1: The Internet")
        Paragraph("This unit explores the technical challenges and questions that arise from the need to represent digital information in computers and transfer it between people and computational devices. The unit then explores the structure and design of the internet and the implications of those design decisions.")
        Chapter1RepresentingAndTransmittingInformation()
        BigQuestions()
        EnduringUnderstandings()
        OptionalLessons()
        Chapter2InventingTheInternet()
        BigQuestions2()
        EnduringUnderstandings2()
        OptionalLessons2()
    end

    private action Chapter1RepresentingAndTransmittingInformation
        Section("Chapter 1: Representing and Transmitting Information")
        NumberedList()
        ListItem():Link("Lesson 1: Personal Innovations", "internet/InternetLesson1.html")
        ListItem():Link("Lesson 2: Sending Binary Messages", "internet/InternetLesson2.html")
        ListItem():Link("Lesson 3: Sending Binary Messages with the Internet Simulator", "internet/InternetLesson3.html")
        ListItem():Link("Lesson 4: Number Systems", "internet/InternetLesson4.html")
        ListItem():Link("Lesson 5: Binary Numbers", "internet/InternetLesson5.html")
        ListItem():Link("Lesson 6: Sending Numbers", "internet/InternetLesson6.html")
        ListItem():Link("Lesson 7: Encoding and Sending Formatted Text", "internet/InternetLesson7.html")
    end

    private action BigQuestions
        Section("Big Questions")
        BulletList()
        ListItem("Why do computers use binary to represent digital information?")
        ListItem("How does data physically get from one computer to another?")
        ListItem("Are the ways data is represented and transmitted with computers laws of nature or laws of man?")
    end

    private action EnduringUnderstandings
        Section("Enduring Understandings")
        BulletList()
        ListItem("2.1 A variety of abstractions built upon binary sequences can be used to represent all digital data.")
        ListItem("3.3 There are trade offs when representing information as digital data.")
        ListItem("6.2 Characteristics of the Internet influence the systems built on it.")
        ListItem("7.2 Computing enables innovation in nearly every field.")
    end

    private action OptionalLessons
        Section("Optional Lessons")
        BulletList()
        ListItem():Link("Lesson 3 Optional: Sending Bits in the Real World", "lessons/code/internet/InternetLesson3o1.html")
        ListItem():Link("Lesson 6 Expanded: Sending Letters", "lessons/code/internet/InternetLesson6o2.html")
        ListItem():Link("Lesson 6 Optional: Encoding Numbers in the Real World", "lessons/code/internet/InternetLesson6o1.html")
    end

    private action Chapter2InventingTheInternet
        Section("Chapter 2: Inventing the Internet")
        NumberedList()
        ListItem():Link("Lesson 8: The Internet is for Everyone", "internet/InternetLesson8.html")
        ListItem():Link("Lesson 9: The Need for Addressing", "internet/InternetLesson9.html")
        ListItem():Link("Lesson 10: Routers and Redundancy", "internet/InternetLesson10.html")
        ListItem():Link("Lesson 11: Packets and Making a Reliable Internet", "internet/InternetLesson11.html")
        ListItem():Link("Lesson 12: The Need for DNS", "internet/InternetLesson12.html")
        ListItem():Link("Lesson 13: HTTP and Abstraction on the Internet", "internet/InternetLesson13.html")
        ListItem():Link("Lesson 14: Practice PT- The Internet and Society", "internet/InternetLesson14.html")
    end

    private action BigQuestions2
        Section("Big Questions")
        BulletList()
        ListItem("Who and what is "):DoubleQuote():Text("in charge"):DoubleQuote():Text(" of the Internet and how it functions?")
        ListItem("How is information transmitted from one computer to the other when they are not directly connected?")
        ListItem("How can the Internet keep growing? How does that work?")
    end

    private action EnduringUnderstandings2
        Section("Enduring Understandings")
        BulletList()
        ListItem("2.1 A variety of abstractions built upon binary sequences can be used to represent all digital data.")
        ListItem("6.1 The Internet is a network of autonomous systems.")
        ListItem("6.2 Characteristics of the Internet influence the systems built on it.")
        ListItem("7.3 Computing has a global affect - both beneficial and harmful - on people and society.")
    end

    private action OptionalLessons2
        Section("Optional Lessons")
        BulletList()
        ListItem():Link("Lesson 11 Optional 1: Algorithms Detour- Minimum Spanning Tree", "lessons/code/internet/InternetLesson11o1.html")
        ListItem():Link("Lesson 11 Optional 2: Algoriths Detour- Shortest Path", "lessons/code/internet/InternetLesson11o2.html")
        ListItem():Link("Lesson 11 Optional 3: How Routers Learn", "lessons/code/internet/InternetLesson11o3.html")
    end
end
