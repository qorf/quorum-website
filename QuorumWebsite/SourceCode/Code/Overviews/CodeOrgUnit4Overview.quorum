use Libraries.Web.Page.QuorumPage

/*
    Unit 4: Big Data and Privacy.
    Converted from the old Lesson page by plan 13's generator: the same
    words, now without Tailwind.
*/
class CodeOrgUnit4Overview is QuorumPage

    on create
        SetLocation("lessons/code/Unit4.html")
        // The name lists and links use, and the series and track it belongs
        // to: its section and picture.
        SetShortTitle("Unit 4: Big Data and Privacy Overview")
        // For search engines and link previews, and what lists of pages say.
        SetDescription("Learn the pros and cons of data in the modern world, and basics of how 
            encryption.")
        SetSummary("Unit 4 Overview and Lesson Links")
    end

    action Setup
        SetWebPageTitle("Unit 4: Big Data and Privacy - Computer Science Principles in Quorum Programming Language")
        Title("Unit 4: Big Data and Privacy")
        Paragraph("The data-rich world we live in introduces many complex questions related to public policy, law, ethics and societal impact. The goals of this unit are to develop a well-rounded and balanced view about data in the world, including the positive and negative effects of it, and to understand the basics of how and why modern encryption works.")
        Part41TheWorldOfBigDataAndEncryption()
        BigQuestions()
        EnduringUnderstandings()
        OptionalLessons()
    end

    private action Part41TheWorldOfBigDataAndEncryption
        Section("4.1: The World of Big Data and Encryption")
        NumberedList()
        ListItem():Link("Lesson 1: What is Big Data?", "bigdataandprivacy/Lesson1.html")
        ListItem():Link("Lesson 2: Finding Trends with Visualizations", "bigdataandprivacy/Lesson2.html")
        ListItem():Link("Lesson 3: Check Your Assumptions", "bigdataandprivacy/Lesson3.html")
        ListItem():Link("Lesson 4: Rapid Research - Data Innovations", "bigdataandprivacy/Lesson4.html")
        ListItem():Link("Lesson 5: Identifying People with Data", "bigdataandprivacy/Lesson5.html")
        ListItem():Link("Lesson 6: The Cost of Free", "bigdataandprivacy/Lesson6.html")
        ListItem():Link("Lesson 7: Simple Encryption", "bigdataandprivacy/Lesson7.html")
        ListItem():Link("Lesson 8: Encryption with Keys and Passwords", "bigdataandprivacy/Lesson8.html")
        ListItem():Link("Lesson 9: Public Key Cryptography", "bigdataandprivacy/Lesson9.html")
        ListItem():Link("Lesson 10: Rapid Research - Cybercrime", "bigdataandprivacy/Lesson10.html")
    end

    private action BigQuestions
        Section("Big Questions")
        BulletList()
        ListItem("What opportunities do large data sets provide for solving problems and creating knowledge?")
        ListItem("How is cybersecurity impacting the ever-increasing number of Internet users?")
        ListItem("How does cryptography work?")
    end

    private action EnduringUnderstandings
        Section("Enduring Understandings")
        BulletList()
        ListItem("3.2 Computing facilitates exploration and the discovery of connections in information.")
        ListItem("3.3 There are trade offs when representing information as digital data.")
        ListItem("4.2 Algorithms can solve many but not all computational problems.")
        ListItem("6.3 Cybersecurity is an important concern for the Internet and the systems built on it.")
        ListItem("7.1 Computing enhances communication, interaction, and cognition.")
        ListItem("7.3 Computing has a global affect - both beneficial and harmful - on people and society.")
        ListItem("7.4 Computing innovations influence and are influenced by the economic, social, and cultural contexts in which they are designed and used.")
    end

    private action OptionalLessons
        Section("Optional Lessons")
        BulletList()
        ListItem():Link("Lesson 8 optional 1: Hard Problems- Traveling Salesperson Problem", "bigdataandprivacy/Lesson8o1.html")
        ListItem():Link("Lesson 8 optional 2: One-Way Functions- The WiFi Hotspot Problem", "bigdataandprivacy/Lesson8o2.html")
        ListItem():Link("Lesson 10: Practice PT- Big Data and Cybersecurity Delimas", "bigdataandprivacy/Lesson10o1.html")
    end
end
