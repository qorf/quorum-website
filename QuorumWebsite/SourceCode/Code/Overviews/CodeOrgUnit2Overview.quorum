use Libraries.Web.Page.QuorumPage

/*
    Unit 2: Digital Information.
    Converted from the old Lesson page by plan 13's generator: the same
    words, now without Tailwind.
*/
class CodeOrgUnit2Overview is QuorumPage

    on create
        SetLocation("lessons/code/Unit2.html")
        // The name lists and links use, and the series and track it belongs
        // to: its section and picture.
        SetShortTitle("Unit 2: Digital Data Overview")
        // For search engines and link previews, and what lists of pages say.
        SetDescription("Learn how digital data is encoded, represented, and manipulated.")
        SetSummary("Unit 2 Overview and Lesson Links")
    end

    action Setup
        SetWebPageTitle("Unit 2: Digital Information - Computer Science Principles in Quorum Programming Language")
        Title("Unit 2: Digital Information")
        Paragraph("This unit further explores the ways that digital information is encoded, represented and manipulated. Being able to digitally manipulate data, visualize it, and identify patterns, trends and possible meanings are important practical skills that computer scientists do every day. Understanding where data comes from, having intuitions about what could be learned or extracted from it, and being able to use computational tools to manipulate data and communicate about it are the primary skills addressed in the unit.")
        Chapter1EncodingAndCompressingComplexInformation()
        BigQuestions()
        EnduringUnderstandings()
        OptionalLessons()
        Chapter2ManipulatingAndVisualizingData()
        BigQuestions2()
        EnduringUnderstandings2()
        OptionalLessons2()
    end

    private action Chapter1EncodingAndCompressingComplexInformation
        Section("Chapter 1: Encoding and Compressing Complex Information")
        NumberedList()
        ListItem():Link("Lesson 1: Bytes and File Sizes", "Digital-Information/Lesson1.html")
        ListItem():Link("Lesson 2: Text Compression", "Digital-Information/Lesson2.html")
        ListItem():Link("Lesson 3: Encoding B&W Images", "Digital-Information/Lesson3.html")
        ListItem():Link("Lesson 4: Encoding Color Images", "Digital-Information/Lesson4.html")
        ListItem():Link("Lesson 5: Lossy Compression and File Formats", "Digital-Information/Lesson5.html")
    end

    private action BigQuestions
        Section("Big Questions")
        BulletList()
        ListItem("Are the ways in which digital information is encoded more laws of nature or man made?")
        ListItem("What kinds of limitations does the binary encoding of information impose on what can be represented inside a computer")
        ListItem("How accurately can human experience and perception be captured or reflected in digital information?")
    end

    private action EnduringUnderstandings
        Section("Enduring Understandings")
        BulletList()
        ListItem("1.1 Creative development can be an essential process for creating computational artifacts.")
        ListItem("1.3 Computing can extend traditional forms of human expression and experience.")
        ListItem("2.1 A variety of abstractions built upon binary sequences can be used to represent all digital data.")
        ListItem("3.3 There are trade offs when representing information as digital data.")
    end

    private action OptionalLessons
        Section("Optional Lessons")
        BulletList()
        ListItem():Link("Lesson 6: Practice PT- Encode and Experience", "Digital-Information/Lesson6.html")
    end

    private action Chapter2ManipulatingAndVisualizingData
        Section("Chapter 2: Manipulating and Visualizing Data")
        NumberedList()
        ListItem():Link("Lesson 7: Introduction to Data", "Digital-Information/Lesson7.html")
        ListItem():Link("Lesson 8: Finding Trends with Visualizations", "Digital-Information/Lesson8.html")
        ListItem():Link("Lesson 9: Check Your Assumptions", "Digital-Information/Lesson9.html")
        ListItem():Link("Lesson 10: Good and Bad Data Visualizations", "Digital-Information/Lesson10.html")
        ListItem():Link("Lesson 11: Making Data Visualizations", "Digital-Information/Lesson11.html")
        ListItem():Link("Lesson 12: Discover a Data Story", "Digital-Information/Lesson12.html")
        ListItem():Link("Lesson 13: Cleaning Data", "Digital-Information/Lesso13.html")
        ListItem():Link("Lesson 14: Creating Summary Tables", "Digital-Information/Lesson14.html")
    end

    private action BigQuestions2
        Section("Big Questions")
        BulletList()
        ListItem("What is the relationship between data, information and knowledge?")
        ListItem("What are the best ways to find, see, and extract meaningful trends and patterns from raw data?")
        ListItem("Where and how does human bias affect the collection, processing and interpretation of data?")
    end

    private action EnduringUnderstandings2
        Section("Enduring Understandings")
        BulletList()
        ListItem("1.3 Computing can extend traditional forms of human expression and experience.")
        ListItem("3.1 People use computer programs to process information to gain insight and knowledge.")
        ListItem("3.2 Computing facilitates exploration and the discovery of connections in information.")
        ListItem("3.3 There are trade offs when representing information as digital data.")
        ListItem("7.1 Computing enhances communication, interaction, and cognition.")
        ListItem("7.3 Computing has a global affect - both beneficial and harmful - on people and society.")
    end

    private action OptionalLessons2
        Section("Optional Lessons")
        BulletList()
        ListItem():Link("Lesson 15: Practice PT- Tell a Data Story", "Digital-Information/Lesson15.html")
    end
end
