use Libraries.Web.Page.QuorumPage

/*
    Explore Performance Task - Lesson 2: Explore PT- Make a Plan.
    Converted from the old Lesson page by plan 13's generator: the same
    words, now without Tailwind.
*/
class CodeOrgUnit6L02 is QuorumPage

    on create
        SetLocation("lessons/code/explore/Lesson2.html")
        // The name lists and links use, and the series and track it belongs
        // to: its section and picture.
        SetShortTitle("Code.org Explore PT Lesson 2")
        // For search engines and link previews, and what lists of pages say.
        SetDescription("Use the Explore PT Survival Guide to plan your Explore PT submission")
        SetSummary("make a plan for completing the Explore PT")
    end

    action Setup
        SetWebPageTitle("Explore Performance Task Lesson 2: Explore PT- Make a Plan")
        Title("Explore Performance Task - Lesson 2: Explore PT- Make a Plan")
        Paragraph("AP Exam PT Prep")
        Overview()
        GoalsPart()
        Purpose()
        Resources()
        GettingStarted()
        ActivityIntroduceTheExplorePTSurvivalGuide()
        Activity1WhatMakesAGoodComputingInovation()
        Activity2BrainstormHarmfulEffectsVDataSecurityCo()
        ActivityRapidResearchHarmfulEffects()
        WrapUp()
        StandardsAlignment()
    end

    private action Overview
        Section("Overview")
        Paragraph("This lesson uses the Explore Performance Task Survival Guide - Student Guide as the backbone for a series of activities to ramp up to doing the actual Explore Performance Task. It contains some brainstorming activities around what qualifies as a "):DoubleQuote():Text("computing innovation"):DoubleQuote():Text(" for the task as well practical advice and strategies for handling some of the nuances of the task such as distinguising between a "):DoubleQuote():Text("harmful effect"):DoubleQuote():Text(" and a "):DoubleQuote():Text("data security or privacy concern."):DoubleQuote():Text(" The lesson concludes by providing the students with resources to make a plan to complete the performance task staring in the next lesson.")
    end

    private action GoalsPart
        Section("Goals")
        Paragraph("Students will be able to:")
        BulletList()
        ListItem("Describe the elements and purpose of the Explore PT")
        ListItem("Describe the scoring guidelines for the Explore PT")
        ListItem("Evaluate sample Explore PTs by applying the scoring guidelines")
    end

    private action Purpose
        Section("Purpose")
        Paragraph("These activities are designed to approach reviewing the Explore Performance Task in a whole-class-discussion inquiry-based way. It's not required that the instructor do this, but there is a fair amount of reading to get through and this should help break it up.")
    end

    private action Resources
        Section("Resources")
        BulletList()
        ListItem():Link("Explore PT Planning Organizer, PDF", "/files/Unit6/Explore PT Planning Organizer.pdf")
        ListItem():Link("Explore PT Survival Guide, PDF", "/files/Unit6/Explore PT - Survival Guide.pdf")
        ListItem():Link("Explore PT Survival Guide, Word", "/files/Unit6/Explore PT - Survival Guide.docx")
        ListItem():Link("Explore PT Survival Guide, Google Doc", "https://docs.google.com/document/d/1savzKfWdI6qszDLWDwfNWLQKsbN7021K36kjeqDxzgk/copy")
        ListItem():Link("AP CSP Performance Task Directions, PDF", "/files/Unit6/CSP PT Directions.pdf")
        ListItem():Link("Explore PT Scoring and Guidelines, PDF", "/files/Unit6/Explore PT Scoring and Guidelines.pdf")
    end

    private action GettingStarted
        Section("Getting Started")
        Paragraph("Review with the students through the following prompt: based on the review of the Explore Performance Task in the last lesson:")
        BulletList()
        ListItem("What are the main things you have to do for the Explore Performance Task?")
        ListItem("What should you do first?")
        Paragraph("Remind the students that below are the few things that they need to do through the discussion")
        BulletList()
        ListItem("Make computational artifact")
        ListItem("Provide written responses to prompts")
        ListItem("Research")
        ListItem("Cite everything with sources.")
        Paragraph("Remind students that they need to: pick a good computing innovation first!")
        Paragraph():Strong("Note:"):Text(" The purpose of this discussion to warm up students' brains and recall the elements of the Explore PT. We want students to start thinking about choices in light of what they have to do for the Explore PT, rather than simply out of interest or "):DoubleQuote():Text("coolness."):DoubleQuote():Text(" Hopefully, the two go hand in hand. In particular we'll looking to drive home the point that your selection of a computing innovation should be done thoughtfully to make completing the task easier.")
    end

    private action ActivityIntroduceTheExplorePTSurvivalGuide
        Section("Activity: Introduce The Explore PT Survival Guide")
        Paragraph("This lesson uses the Explore PT Survival Guide to get started with the Explore Performance Task. The beginning of the packet has a number of quick activities that help get the students in the right mindset for thinking about and doing the task, so they are ready to hit the ground running. The guide will be helpful to the students through the entire process of completing the actual Explore Task as well. Read page 1 to get started.")
        Paragraph("Ask the students to read the "):DoubleQuote():Text("Explore PT Overview"):DoubleQuote():Text(" section of page 1. The information about the task itself should not be news if they have already reviewed the Explore PT. Ask the students to focus on the suggested processs.")
    end

    private action Activity1WhatMakesAGoodComputingInovation
        Section("Activity 1: What makes a good Computing Inovation?")
        Paragraph("Ask the students to group with a partner and complete the innovations brainstorm activity on page 2. Pick their three best, and three worst possible picks.")
        Paragraph("Remind the students that:")
        BulletList()
        ListItem("Not all technological innovations are computing innovations.")
        ListItem("Focus or refine your choice so you're choosing the "):DoubleQuote():Text("computing"):DoubleQuote():Text(" part of your innovation.")
        ListItem("Keep the written responses in mind. If you already have some sense of the data your innovation uses (think literal binary data) and the impacts of the innovation on society, you're probably on the right track.)")
        Subsection("Pro Tip")
        BulletList()
        ListItem():Strong("Strong Choices"):Text(" all involve computer code or computing as a core part of their functionality, have broad societal impacts, and make use of data.")
        ListItem():Strong("Good Choices"):Text(" might need a little finessing to make sure you identify a computational aspect to report on.")
        ListItem():Strong("Poor Choices"):Text(" do not include a computer or program code, and so are not really computing innovations.")
        Paragraph("Examples of choices are shown in the following table:")
        Image("files/code/Unit6/Sample Choices.png", "Sample Choices Table")
        Paragraph():Strong("Discuss:"):Text(" What other innovations did you think of while reviewing your list? Anything you'd be excited about researching?")
        Paragraph("The goal of this activity is NOT to come up with definitively correct or incorrect "):DoubleQuote():Text("answers"):DoubleQuote():Text(" about the list of innovations. Many if not most technological innovations students come up with will be borderline cases that can be used for the Explore PT if framed the right way. The purpose here is to spur disccusion about what makes for a computing innovation not lead to frustration about what the "):DoubleQuote():Text("right"):DoubleQuote():Text(" answers are.")
    end

    private action Activity2BrainstormHarmfulEffectsVDataSecurityCo
        Section("Activity 2: Brainstorm: Harmful Effects v. Data Security Concerns")
        Paragraph("Complete the activity in the Page 2 of the Survival Guide.")
        BulletList()
        ListItem("Read the definitions at the top of the page.")
        ListItem("Look at the list of "):DoubleQuote():Text("bad stuff"):DoubleQuote():Text(" resulting from computing innovations. Which ones are harmful effects (by the definition in the Explore Task) and which are data security concerns?")
        ListItem("With a partner go through and mark each as either a harmful effect or data security/privacy concern.")
        Subsection("Pro Tip")
        BulletList()
        ListItem("Most of the "):DoubleQuote():Text("answers"):DoubleQuote():Text(" follow the definitions closely, but a few are nuanced.")
        ListItem("It's a harmful effect if the "):DoubleQuote():Text("bad thing"):DoubleQuote():Text(" affects a group of people resulting from the intended use of the innovation.")
        ListItem("It's a data security/privacy concern if the data is being used in ways that weren't intended.")
    end

    private action ActivityRapidResearchHarmfulEffects
        Section("Activity: Rapid Research - Harmful Effects")
        Paragraph("Complete the research activity on page 4 in the Survival Guide. Now that the students have a better sense of what "):DoubleQuote():Text("harmful effect"):DoubleQuote():Text(" means they are going to see if they can find one for an innovation of their choosing.")
        Paragraph("Ask the students to pick one from the list of innovations earlier in the Survival Guide or one that they have thought of themselves, then go quickly look it up and see if they can fill in all the aspects of the table provided.")
        Paragraph("Ask the stduents to discuss: (1) What did you learn from your research? (2) Was is easy or hard to find a harmful effect for the innovation you chose?")
        Paragraph("The students should be aware that it should be rather quick, and easy to find harmful effects. If it takes more than 10 minutes to find a harmful effect it's probably a sign that they should pick a different computing innovation.")
    end

    private action WrapUp
        Section("Wrap Up")
        Paragraph("Ask the students to use pages 5 and 6 of the survial guide to start writing their plan. Note that page 5 of the survival guide is the same as "):DoubleQuote():Text("Explore PT Planning Organizer"):DoubleQuote():Text(" except that "):DoubleQuote():Text("Explore PT Planning Organizer"):DoubleQuote():Text(" is in higher resolution. These templates will help guide them to completing the Explore task. The teacher may adjust the schedule based on the school's schedule. Note, 8 hours is the minumum time needed for this task. It may take longer.")
        Paragraph():Strong("Discuss:"):Text(" taking into account all the activities we did today plus what you know about the Explore PT now, where do you expect you'll be spending most of your time? For which parts of the task should you maximize your time?")
        BulletList()
        ListItem("You probably want to maximize writing and artifact creation time.")
        ListItem("Research can be done rapidly.")
        ListItem("Don't forget to allocate time to proofread for easy-to-make mistakes that will cost points, like forgetting to cite sources.")
    end

    private action StandardsAlignment
        Section("Standards Alignment")
        BulletList()
        ListItem():Strong("Computer Science Principles: "):Text("1.1.1 (A, B)")
        ListItem():Strong("Computer Science Principles: "):Text("1.2.1 (A, B, C, D, E)")
        ListItem():Strong("Computer Science Principles: "):Text("1.2.3 (A, B, C)")
        ListItem():Strong("Computer Science Principles: "):Text("7.5.1 (A, B, C)")
        ListItem():Strong("Computer Science Principles: "):Text("7.5.2 (A, B)")
    end
end
