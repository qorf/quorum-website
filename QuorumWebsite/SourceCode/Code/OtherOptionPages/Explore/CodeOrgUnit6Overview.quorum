use Libraries.Web.Page.QuorumPage

/*
    Unit 6: Explore- AP Performance Task Prep.
    Converted from the old Lesson page by plan 13's generator: the same
    words, now without Tailwind.
*/
class CodeOrgUnit6Overview is QuorumPage

    on create
        SetLocation("lessons/code/Unit6.html")
        // The name lists and links use, and the series and track it belongs
        // to: its section and picture.
        SetShortTitle("Unit 6: Explore- Practice AP Performance Task Task Overview")
        // For search engines and link previews, and what lists of pages say.
        SetDescription("Prepare and practice for the Explore Performance Task on the AP exam.")
        SetSummary("Unit 6 Overview and Lesson Links")
    end

    action Setup
        SetWebPageTitle("Unit 6: Explore- AP Performance Task Prep- Computer Science Principles in Quorum Programming Language")
        Title("Unit 6: Explore- AP Performance Task Prep")
        Paragraph("These lessons are here to help you understand, prepare for, and do the AP Explore Performance Task. Each "):DoubleQuote():Text("lesson"):DoubleQuote():Text(" contains links to helpful documents that your teacher can help walk you through.NOTE: the second item in the first lesson is not related to the Explore Performance Task directly, but covers general tech setup and tools you need to do various elements of both the Explore and Create tasks.This unit contains lessons to help students with preparation and execution of the AP Performance Task: Explore and Impact of Computing Innovations. The lessons in this unit are meant to be taken piecemeal rather than as a typical unit sequence. Instead of a sequence of connected lessons, these represent a more modular breakdown of the things you need to do: 1) Review and understand the AP Explore Task, scoring guidelines and sample submissions. 2) Hands-on practice interpreting tricky elements of the task, and making a plan for completing the tasks in the time allotted. 3) Actually doing the tasks and submitting.")
        Chapter1ExploreAPPerformanceTaskPrep()
        BigQuestions()
        EnduringUnderstandings()
        OptionalLessons()
    end

    private action Chapter1ExploreAPPerformanceTaskPrep
        Section("Chapter 1: Explore- AP Performance Task Prep")
        NumberedList()
        ListItem():Link("Lesson 1: Explore Performance Task- Review the Task", "explore/Lesson1.html")
        ListItem():Link("Lesson 2: Explore Performance Task- Make a Plan", "explore/Lesson2.html")
        ListItem():Link("Lesson 3: Explore Performance Task- Complete the Task", "explore/Lesson3.html")
    end

    private action BigQuestions
        Section("Big Questions")
        BulletList()
    end

    private action EnduringUnderstandings
        Section("Enduring Understandings")
        BulletList()
    end

    private action OptionalLessons
        Section("Optional Lessons")
        BulletList()
        ListItem():Link("Lesson 1 (optional): Tech Setup and Tools for the AP Performance Tasks", "explore/Lesson1o1.html")
        ListItem():Link("Lesson 3 (optional): Review Research Practices and Strategies", "explore/Lesson3o1.html")
    end
end
