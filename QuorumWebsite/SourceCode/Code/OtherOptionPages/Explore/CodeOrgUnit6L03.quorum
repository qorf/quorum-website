use Libraries.Web.Page.QuorumPage

/*
    Explore Performance Task - Lesson 3: Complete the Explore Performance Task.
    Converted from the old Lesson page by plan 13's generator: the same
    words, now without Tailwind.
*/
class CodeOrgUnit6L03 is QuorumPage

    on create
        SetLocation("lessons/code/explore/Lesson3.html")
        // The name lists and links use, and the series and track it belongs
        // to: its section and picture.
        SetShortTitle("Code.org Explore PT Lesson 3")
        // For search engines and link previews, and what lists of pages say.
        SetDescription("Final prep and reminders before starting the Explore PT")
        SetSummary("Ready, set, go! Complete the Explore PT.")
    end

    action Setup
        SetWebPageTitle("Explore Performance Task Lesson 3: Complete the Explore Performance Task")
        Title("Explore Performance Task - Lesson 3: Complete the Explore Performance Task")
        Paragraph("Performance Task Submission")
        Overview()
        GoalsPart()
        Purpose()
        Resources()
        GettingStarted()
        Activity()
        WrapUp()
        ExtendedLearningOptionalReviewResearchPracticesA()
        StandardsAlignment()
    end

    private action Overview
        Section("Overview")
        Paragraph("It is finally time for students to take on the Explore Performance Task. For a minimum of 8 class hours, students should work on their projects with only types of teacher support allowed (essentially: Advise on process, don’t influence or evaluate ideas). The lesson includes reminders about how you can interact with students while they are working on their projects, and suggestions about time line. The Explore PT requires a minimum of 8 hours of class time. At the end, students will submit their computational artifact and written responses through their AP digital portfolio.")
    end

    private action GoalsPart
        Section("Goals")
        Paragraph("Students will be able to:")
        BulletList()
        ListItem("Complete and submit the Explore Performance Task")
    end

    private action Purpose
        Section("Purpose")
        Paragraph("There are no new CS concepts covered in this lesson. Students will individually work on the Explore Performance Task.")
    end

    private action Resources
        Section("Resources")
        Paragraph("The students will need the work they completed in the last lessons to complete your Explore Performance Task.")
        BulletList()
        ListItem():Link("Teacher's Guidelines", "https://docs.google.com/document/d/1QB6vo46nJcj59OoPAlTTsA8aZ32mOc98CNbKJxTJkJM/edit")
        ListItem():Link("AP CSP Performance Task Directions for Students - College Board Student Handout", "https://apcentral.collegeboard.org/pdf/ap-csp-student-task-directions.pdf?course=ap-computer-science-principles")
        ListItem():Link("AP CSP Performance Task Scoring Guidelines and Notes", "https://apcentral.collegeboard.org/pdf/2018-explore-performance-tasks-sg.pdf")
        ListItem():Link("AP Digital Portfolio Website", "https://account.collegeboard.org/login/login?appId=295&skipEnroll=Y&DURL=https%3A%2F%2Fdigitalportfolio.collegeboard.org%2F%23instruction")
        ListItem():Link("Student Guide - AP Digital Portfolio", "https://secure-media.collegeboard.org/digitalServices/pdf/ap/computer-science-principles-digital-portfolio-student-guide.pdf")
        ListItem():Link("Explore PT Survival Guide, PDF", "/files/Unit6/Explore PT - Survival Guide.pdf")
        ListItem():Link("Explore PT Survival Guide, Word", "/files/Unit6/Explore PT - Survival Guide.docx")
        ListItem():Link("Explore PT Survival Guide, Google Doc", "https://docs.google.com/document/d/1savzKfWdI6qszDLWDwfNWLQKsbN7021K36kjeqDxzgk/copy")
        ListItem():Link("Guide to Evaluate Internet Resources", "https://www.library.georgetown.edu/tutorials/research-guides/evaluating-internet-content")
    end

    private action GettingStarted
        Section("Getting Started")
        Subsection("Ready?")
        Paragraph("Role of the teacher during Explore task completion: "):Strong("You can help with process, but not evaluate or influence ideas"):Text(".")
        Paragraph("The teachers can use "):Link("these guidelines", "https://docs.google.com/document/d/1QB6vo46nJcj59OoPAlTTsA8aZ32mOc98CNbKJxTJkJM/edit"):Text(" to help the students to complete the tasks.")
        Paragraph("Therefore, it is good to remind the students that:")
        BulletList()
        ListItem("For the next ~8 days, you will be completing the Explore Performance Task.")
        ListItem("All of the work for this task must be done independently.")
        ListItem("I (teacher) can help you with process and timeline and keep you on task.")
        ListItem("But from this point on, all ideas, and work are your own.")
        Paragraph("After asking the students to open the "):DoubleQuote():Text("AP CSP Performance Task Directions for Students - College Board Student Handout,"):DoubleQuote():Text(" ask the students to "):Strong("read page 3 to prepare for the through-course performance tasks"):Text(".")
        BulletList()
        Paragraph():Strong("Instruction for the students"):Text(":")
        BulletList()
        Paragraph("With a partner - one person reading from the top down, the other reading from bottom up - check off things we've done to prepare so far. Identify anything we haven't done.")
        Paragraph("After reading ask the students, with their partner, to summarize anything new or unexpected that they have discovered.")
        BulletList()
        Paragraph():Strong("Note for teachers"):Text(":")
        BulletList()
        Paragraph("Some of the items do not pertain to the Explore PT so can be ignored.")
        BulletList()
        Paragraph("Everything else should have been covered in one way or another if you've done the prep lessons prior to this and used the Explore PT Survival guide.")
        BulletList()
        Paragraph("Address any questions students have.")
        Paragraph("Now, ask the students to "):Strong("read page 7"):Text(".")
        Paragraph("Again, using the divide and conquer method, ask the students to:")
        BulletList()
        Paragraph("Scan the page with a partner and check off things you feel confident about, and pull out things you're not sure about.")
        Paragraph("The teachers should see if they have missed any steps specifically pertaining to the Explore Performance Task. They should be all checked except the following: '"):Emphasis("practice searching and evaluating sources relevant to computing innovations; all sources cited must be relevant, credible, and easily accessible"):Text("'.")
        Paragraph("Now, ask the students to "):Strong("read page 2"):Text(", the Plagarism Policy.")
        BulletList()
        Paragraph():Strong("The students should have the following question in mind when they read"):Text(":")
        BulletList()
        Paragraph("According to the performance task guidelines what constitutes plagiarism and what are the consequences?")
        Paragraph("The teachers can reference the following:")
        Image("files/code/Unit6/plagiarism policy.png", "Plagiarism Policy")
        Paragraph("Make sure students understand what's required in terms of citing sources. At the very least they probably want to keep track of links to articles they found during their research process so they can easily include them later on. Use the Survival Guide as a place to do this.")
        Paragraph("Ask the students to "):Strong("read page 8"):Text(", which has a final set of Do's, Don'ts, and Reminders for the Explore PT.")
        BulletList()
        Paragraph():Strong("Instruction for the students"):Text(":")
        BulletList()
        Paragraph("with your partner, read especially the "):DoubleQuote():Text("you may"):DoubleQuote():Text(" and "):DoubleQuote():Text("you may not"):DoubleQuote():Text(" sections of this page. Then with you partner summarize: what kinds of things can your teacher help you with?")
        BulletList()
        Paragraph():Strong("Instruction for the teachers"):Text(":")
        BulletList()
        ListItem("Let students read and discuss with partners.")
        ListItem("Discuss specifically how you (teacher) are allowed to help and not. Short version: you can help students with the process of completing the task, you cannot help by evaluating their work or ideas in any way.")
        ListItem("There is some gray area around this item: "):DoubleQuote():Text("as needed, seek assistance from your teacher for AP Coordinator in defining your focus and choice of topics."):DoubleQuote():Text(" This means the teacher can help the students brainstorm ideas and talk students through making a good choice of topic, but cannot assign or suggest a particular one.")
        ListItem("The Innovation Brainstorm activity from Page 2 of the Explore PT survival guide fits this category.")
        Subsubsection("Set")
        BulletList()
        ListItem("Remind students of the overall timeline and that the official PT time is about to start")
        ListItem("Take out your Explore PT timeline that we developed")
        Subsubsection("The Students Must")
        BulletList()
        ListItem("Be aware of the performance task directions, timeline, and scoring criteria;")
        ListItem("Support your written analysis of your computing innovation when responding to all the prompts by using details related to the knowledge and understanding of computer science you have obtained throughout the course and your investigation;")
        ListItem("Provide evidence to support your claims using in-text citations;")
        ListItem("Use relevant and credible sources to gather information about your computin innovation;")
        ListItem("Provide acknowledgments for the use of any media or program code used in the creation of your computational artifact that is not your own; and")
        ListItem("Allow your own interests to drive your choice of computing innovation and computational artifact.")
        Subsubsection("The Students May")
        BulletList()
        ListItem("Follow a timeline and schedule for completing the performance task;")
        ListItem("Seek clarification from your teacher or AP Coordinator pertaining to the task, timeline, components, and scoring criteria;")
        ListItem("Seek clarification from your teacher or AP Coordinator regarding submission requirements;")
        ListItem("As needed, seek assistance from your teacher or AP Coordinator in defining your focus and choice of topics; and")
        ListItem("Seek assistance from your teacher or AP Coordinator to resolve technical problems that impede work, such as a failing workstation or difficulty with access to networks, or help with saving files or making movie files.")
        Subsubsection("The Students May NOT")
        BulletList()
        ListItem("Collaborate on the Explore Performance Yask;")
        ListItem("Submit work that has been revised, amended, or corrected by another individual;")
        ListItem("Submit work from a practice performance task as your official submission to the College Board to be scored by the AP Program; or")
        ListItem("Seek assistance or feedback on answers to prompts.")
        Paragraph("After reviewing the list above, get your timeline out. You are about to start your 8 hours on the Explore Performance Task.")
    end

    private action Activity
        Section("Activity")
        Subsection("GO! (8 Hours)")
        BulletList()
        Paragraph():Strong("Instructions for students"):Text(":")
        BulletList()
        Paragraph("You may now begin your work. Before you submit your final work, look over your notes, and the scoring rubric, to make sure you have included all required parts.")
    end

    private action WrapUp
        Section("Wrap Up")
        Paragraph():Strong("Submitting:"):Text(" At the designated end of the Task administration (having allowed for at least 8 hours of class time for work) students should submit their computational artifacts, and written responses to their AP Digital Portfolio")
        BulletList()
        Paragraph():Strong("Before the students submit their final work"):Text(":")
        BulletList()
        Paragraph("Encourage students to check over the rubric one more time to make sure they met the requirements")
        BulletList()
        Paragraph("Make sure they have all the components necessary for the Explore Performance Task")
        Subsection("Tips")
        Paragraph("You (the teachers) may spread out submission over a few days if you like since students can save progress in the AP Digital Portfolio. As long as they finalize submission by the closing date of the PTs it's fine.")
    end

    private action ExtendedLearningOptionalReviewResearchPracticesA
        Section("Extended Learning (Optional: Review research practices and strategies)")
        Paragraph("In working through these practice PTs, students have built skills with researching and talking about innovations and creating computational artifacts.")
        Subsection("Discussion")
        Paragraph("Prompt: In your small groups create a list of best practices for research.")
        Paragraph("Students should record what they did in earlier projects first, but may choose to look at outside resources to augment their lists. Have groups report out to the whole room their lists of best practices for research. The students can consider using the 'Evaluate Online Resources' guide posted in the resources section above.")
        Paragraph("Discussion Goals: Students need to know what's required of them in terms of citing sources in the task, as well as getting a reminder about best practices.")
        Paragraph("Make sure the students' list include:")
        BulletList()
        ListItem("Author")
        ListItem("Purpose")
        ListItem("Objectivity")
        ListItem("Accuracy")
        ListItem("Reliability")
        ListItem("Credibility")
        Paragraph("One of the most frequently asked questions is about how students should cite sources with their Explore PTs. The citations need to be inline citations but you can basically invent any format for doing that that you want. As long as it's clear which information came from where that's the goal. The students can look to the sample PTs in the previous lesson for examples.")
    end

    private action StandardsAlignment
        Section("Standards Alignment")
        BulletList()
        ListItem():Strong("Computer Science Principles: "):Text("1.2.1 (A, B, C, D, E)")
        ListItem():Strong("Computer Science Principles: "):Text("1.2.2 (A, B)")
        ListItem():Strong("Computer Science Principles: "):Text("1.2.3 (A, B, C)")
        ListItem():Strong("Computer Science Principles: "):Text("1.2.5 (A, B, C, D)")
        ListItem():Strong("Computer Science Principles: "):Text("3.1.3 (A, B, C, D, E)")
        ListItem():Strong("Computer Science Principles: "):Text("3.2.1 (A, B, C, D, E, F, G, H, I)")
        ListItem():Strong("Computer Science Principles: "):Text("3.3.1 (A, B, C, D, E, F, G, H, I)")
        ListItem():Strong("Computer Science Principles: "):Text("7.1.1 (A, B, C, D, E, F, G, H, I)")
        ListItem():Strong("Computer Science Principles: "):Text("7.2.1 (A, B, C, D, E, G)")
        ListItem():Strong("Computer Science Principles: "):Text("7.3.1 (A, B, C, D, E, F, G, H, I)")
        ListItem():Strong("Computer Science Principles: "):Text("7.4.1 (A, B, C, D, E)")
        ListItem():Strong("Computer Science Principles: "):Text("7.5.1 (A, B, C)")
        ListItem():Strong("Computer Science Principles: "):Text("7.5.2 (A, B)")
    end
end
