use Libraries.Web.Page.QuorumPage

/*
    Explore Performance Task - Lesson 1: Explore Performance Task - Review Task.
    Converted from the old Lesson page by plan 13's generator: the same
    words, now without Tailwind.
*/
class CodeOrgUnit6L01 is QuorumPage
    // A double quote, for code and words that hold one.
    text dq = ""

    on create
        SetLocation("lessons/code/explore/Lesson1.html")
        // The name lists and links use, and the series and track it belongs
        // to: its section and picture.
        SetShortTitle("Code.org Explore Practice Performance Task Lesson 1")
        // For search engines and link previews, and what lists of pages say.
        SetDescription("Learn the Submission Requirements and Scoring Guidelines for the AP Exlpore Performance Task")
        SetSummary("submission and scoring guidelines for the Explore Performance Task")
    end

    action Setup
        dq = dq:GetDoubleQuote()
        SetWebPageTitle("Explore Performance Task Lesson 1: Explore PT - Review Task")
        Title("Explore Performance Task - Lesson 1: Explore Performance Task - Review Task")
        Paragraph("AP Exam PT Prep")
        Overview()
        GoalsPart()
        Purpose()
        Resources()
        GettingStarted()
        ActivityExplorePTSampleResponseC()
        ActivityExplorePerformanceTaskAnnotatedSamplesD5()
        WrapUp()
        OptionalAPDigitalPortfolioSetup()
        StandardsAlignment()
    end

    private action Overview
        Section("Overview")
        Paragraph("This lesson contains a series of activities you can use to familiarize yourself with the Explore Performance Task, how it is scored, and some example tasks provided by the College Board.")
        Paragraph("Students review the Submission Requirements and Scoring Guidelines for the Explore PT. Subsequently they review three example scored Explore PT submissions with commentary to better understand how the Submission Requirements and Scoring Guidelines are used together. In a wrap up conversation they identify a piece of advice, a "):DoubleQuote():Text("gotcha,"):DoubleQuote():Text(" and a remaining question they have about the Explore PT.")
        Paragraph("Note: Most the exemplar task, scores, and commentary on scoring shared in this lesson come directly from the College Board. Code.org's commentary is noted where applicable.")
    end

    private action GoalsPart
        Section("Goals")
        Paragraph("Students will be able to:")
        BulletList()
        ListItem("Describe the major components of the Explore Performance Task(PT)")
        ListItem("Describe how the Explore Performance Task Scoring Guidelines will be used to assess the task")
        ListItem("Identify remaining questions about the Explore Performance Task")
    end

    private action Purpose
        Section("Purpose")
        Paragraph("The Explore PT is in many ways straightforward: you perform research on a computing innovation and present your findings. As you dig into the details of the task, however, you quickly come across some of the nuances of individual components of the task and how they're scored. This lesson is designed to introduce what these nuances are, and begin to provide some answers to the questions that will inevitably arise. Keep in mind that the next lesson provides a more structured set of responses to those questions, and so today students are just diving in to what the task looks like.")
    end

    private action Resources
        Section("Resources")
        Subsection("College Board Handouts")
        BulletList()
        ListItem():Link("AP CSP Performance Task Directions, PDF", "/files/Unit6/CSP PT Directions.pdf")
        ListItem():Link("Explore PT Scoring and Guidelines, PDF", "/files/Unit6/Explore PT Scoring and Guidelines.pdf")
        Subsubsection("College Board Explore PT Samples")
        BulletList()
        ListItem():Link("Explore Task Artifact Sample C, PDF", "/files/Unit6/Explore Task artifact C.pdf")
        ListItem():Link("Explore Task Sample C, PDF", "/files/Unit6/Explore Task sample C.pdf")
        Subsubsection("Annotated Explore PT Samples")
        BulletList()
        ListItem():Link("Annotated Explore Sample Task C, PDF", "/file/Unit6/CB Explore PT - Sample C.pdf")
        ListItem():Link("Annotated Explore Sample Task C, Word", "/file/Unit6/CB Explore PT - Sample C.docx")
        ListItem():Link("Annotated Explore Sample Task D, PDF", "/file/Unit6/CB Explore PT - Sample D.pdf")
        ListItem():Link("Annotated Explore Sample Task D, Word", "/file/Unit6/CB Explore PT - Sample D.docx")
        ListItem():Link("Annotated Explore Sample Task E, PDF", "/file/Unit6/CB Explore PT - Sample E.pdf")
        ListItem():Link("Annotated Explore Sample Task E, Word", "/file/Unit6/CB Explore PT - Sample E.docx")
        Subsubsection("(optional) Digital Portfolio Setup")
        BulletList()
        ListItem():Link("AP Digital Portfolio Student Guide, PDF", "https://secure-media.collegeboard.org/digitalServices/pdf/ap/computer-science-principles-digital-portfolio-student-guide.pdf")
        ListItem():Link("Go on the CodePrint site", "https://bakerfranke.github.io/codePrint/")
        ListItem():Link("Screencast-o-Matic", "https://screencast-o-matic.com")
    end

    private action GettingStarted
        Section("Getting Started")
        Paragraph("Today the students are going to start looking more deeply at the Explore PT, focusing specifically on understanding")
        BulletList()
        ListItem("The different components of the Explore PT")
        ListItem("How the task will be scored")
        Paragraph("Reassure the students that they already have much of the knowledge and skills they need to do well on this task. The hardest part might be just understanding what is required of them.")
        Subsection("Review Explore PT Submission Requirements and Scoring Guidelines")
        Paragraph("Starting with the "):DoubleQuote():Text("AP CSP Performance Task Directions"):DoubleQuote():Text(" handout in the Resources section, ask the students to read the following:")
        BulletList()
        ListItem("the "):DoubleQuote():Text("Submission Requirements"):DoubleQuote():Text(" section on pages 5-6")
        ListItem("the scoring guidelines on pages 22-23")
        Paragraph("For the scoring guidelines the class can focus only on the first 3 columns for now: "):DoubleQuote():Text("Reporting Category,"):DoubleQuote():Text(" "):DoubleQuote():Text("Task,"):DoubleQuote():Text(" "):DoubleQuote():Text("Scoring Criteria."):DoubleQuote():Text(" We'll dive into the decision rules later. Just get familiar with these documents.")
        Paragraph("After reading, ask the students to discuss with a partner the following:")
        BulletList()
        ListItem("What will you actually be turning in to the College Board?")
        ListItem("What are you hoping will become more clear after looking at example projects?")
        Paragraph("Here are some of the key points that the students should remember:")
        Paragraph("They will need to submit:")
        BulletList()
        ListItem("A computational artifact (though you may be wondering what this means)")
        ListItem("Responses to a few written responses")
        ListItem("Citations to sources for these two items.")
        Paragraph("Also note that the Scoring Guidelines provide specific guidance on how each part of the task will be graded")
    end

    private action ActivityExplorePTSampleResponseC
        Section("Activity: Explore PT Sample Response C")
        Paragraph("Ask the students to read the Explore PT Sample Response C. This is a raw student submission - exactly what the student uploaded for their computational artifact and written responses. Ask the students to spend a few minutes with a partner reviewing this exemplar. Be ready to share out the following answers.")
        BulletList()
        ListItem("Did anything surprise you in looking at this exemplar?")
        ListItem("Do you think this scored well based on what you know about the scoring guidelines?")
        Paragraph("This sample actually received a perfect 8/8 score. Ask the students to look at the sample response C side-by-side with the scoring guidelines and the actual AP scorer's notes (given in the annotated Sample C document) to see why. Try an answer these questions with a partner:")
        BulletList()
        ListItem("How does scorer differentiate between a harmful effect and a data security concern?")
        ListItem("What characteristics of this response made it score well?")
        ListItem("What questions do you still have about the Scoring Guidelines or Task Description?")
        Paragraph("Ask the students to share their responses after discussing with a partner. Where possible call out ways that the discussion is answering questions raised earlier in the class about the Submission Requirements or Scoring Guidelines.")
        Subsection("Pro Tip")
        Paragraph("Difference between "):DoubleQuote():Text("harmful effect"):DoubleQuote():Text(" and "):DoubleQuote():Text("data security concern."):DoubleQuote()
        BulletList()
        ListItem("As called out in the scorer's notes, a "):DoubleQuote():Text("harmful effect"):DoubleQuote():Text(" is one that comes from using the innovation as intended, which in this case is the result of overuse (or over-reliance) on GPS. A good way to think of "):DoubleQuote():Text("harmful effect"):DoubleQuote():Text(" is the unintended consequences of using the innovation as designed, which this response does.")
        ListItem("A data security concern often comes from misuse of the innovation, or using it in a way that was not originally intended. The effects or risks from spying, hacking, or even accidental exposure of sensitive information or invasions of privacy are common things listed here.")
    end

    private action ActivityExplorePerformanceTaskAnnotatedSamplesD5
        Section("Activity: Explore Performance Task Annotated Samples D (5/8) and E (2/8)")
        Paragraph("Now, ask the students to look at some examples that did not earn a perfect score. Provide pairs of students copies of the Annotated Explore PT Samples D and E. The students can pick which one they want to look at first. As they review this task with a partner, please ask them to answer these questions:")
        BulletList()
        ListItem("Where and how specifically did this fall short?")
        ListItem("Was there one major problem that caused ripple effects through the scoring?")
        ListItem("Or were there several smaller issues?")
        ListItem("Try to point out specific aspects of the Scoring Guidelines or Submission Requirements.")
        Paragraph("Ask partners to spend a couple minutes specifically discussing the prompt above. Then have the whole class share the results of their discussion. Where possible call out ways that the discussion is answering questions raised earlier in the class about the Submission Requirements or Scoring Guidelines.")
        Subsection("Pro Tip")
        Paragraph("The students should be gaining comfort with the structure of the task and scoring guidelines at this point. Since these task missed some points they provide a good opportunity to dive into those components of the Scoring Guidelines.")
        Paragraph("Sample D falls short by:")
        BulletList()
        ListItem("Failed to make a few small connections.")
        ListItem("The harmful effect didn't come from intended use, and wasn't specific enough on who the harm would come to.")
        Paragraph("Sample E falls short by:")
        BulletList()
        ListItem("Fails to identify a computing innovation - this fact alone was the source of many lost points, even though the sample itself comes close in many ways.")
        ListItem("Failed to list citations inline.")
    end

    private action WrapUp
        Section("Wrap Up")
        Paragraph("Ask the students to take a few minutes to write (1) one piece of advice that they have from the Explore PT, (2) their bigest "):DoubleQuote():Text("gotcha,"):DoubleQuote():Text(" and (3) a question they still have. Share these with a partner, or the entire group.")
        Paragraph("The next lesson is designed to address these three specific prompts. The students will have time to dive deep on what counts as a computing innovation, and how to choose one wisely. They will be given a checklist of "):DoubleQuote():Text("gotchas"):DoubleQuote():Text(" next to each part of the task to use.")
    end

    private action OptionalAPDigitalPortfolioSetup
        Section("(Optional) AP Digital Portfolio Setup")
        Paragraph("At some point students need to setup their AP Digital Portfolio to officially submit your performance tasks and to sign up for the exam. Doing that setup and navigating around the digital portfolio will take a little bit of time.")
        Paragraph("Note: Pick the right time to do this tech setup. Use the "):DoubleQuote():Text("AP Digital Portfolio Student Guide"):DoubleQuote():Text(" linked in the resources section.")
        Subsection("Making PDFs for Written Responses")
        Paragraph("The students are required to make a PDF of their written responses to prompts. It's recommended that they use the College Board templates for filling out their responses. At some point they will have their written responses in a word processing document such as Microsoft Word, Google Docs, or Pages.")
        Subsubsection("How to make a PDF, a guide copied from " + dq + "AP Digital Portfolio Student Guide" + dq)
        Paragraph("How to make a PDF")
        BulletList()
        ListItem("Recent versions of applications like: Word, PowerPoint, Pages, and Google Docs, have built-in features that allow you to save or export your file as a PDF. Instructions are provided below.")
        ListItem("If your software does not have a PDF option, visit the Adobe site and learn more about whether Acrobat from Adobe Systems can convert your document to PDF.")
        ListItem("You are responsible for ensuring that your file is properly formatted and readable. After you have created your PDF, be sure to check it by opening and reviewing your PDF in Adobe Reader, a free application that can be downloaded from the Adobe site.")
        Paragraph("Making PDF using Microsoft Office (Word, PowerPoint)")
        BulletList()
        ListItem("In Word, Powerpoint, and other Microsoft Office programs you will "):DoubleQuote():Text("Save as PDF."):DoubleQuote():Text(" Visit the Microsoft Office support page for more information about "):DoubleQuote():Text("Save as PDF."):DoubleQuote():Text(" To save a Word or Powerpoint document as PDF:")
        ListItem("Open your Word or Powerpoint document.")
        ListItem("From the top menu select "):DoubleQuote():Text("File,"):DoubleQuote():Text(" and select "):DoubleQuote():Text("Save As"):DoubleQuote()
        ListItem("In the dialog window, go to the drop-down menu for "):DoubleQuote():Text("Save as type,"):DoubleQuote():Text(" and select "):DoubleQuote():Text("PDF."):DoubleQuote()
        ListItem("Click "):DoubleQuote():Text("Save."):DoubleQuote()
        Paragraph("Making PDF using Google Docs")
        BulletList()
        ListItem("In Google Docs, you will "):DoubleQuote():Text("Download as"):DoubleQuote():Text(" PDF. Visit the Google support page for more information on "):DoubleQuote():Text("Download a file."):DoubleQuote():Text(" To download a Google Doc as a PDF:")
        ListItem("Open your Google doc")
        ListItem("From the top menu select "):DoubleQuote():Text("File,"):DoubleQuote():Text(" and select "):DoubleQuote():Text("Download as,"):DoubleQuote():Text(" and select "):DoubleQuote():Text("PDF Document (.pdf)"):DoubleQuote()
        Paragraph("Making PDF using Pages")
        BulletList()
        ListItem("In Pages, you will "):DoubleQuote():Text("Export to"):DoubleQuote():Text(" PDF. Visit the Apple support page for more information or follow the steps below:")
        ListItem("Open your Pages document.")
        ListItem("From the top menu select "):DoubleQuote():Text("File,"):DoubleQuote():Text(" and select "):DoubleQuote():Text("Export to,"):DoubleQuote():Text(" and select "):DoubleQuote():Text("PDF."):DoubleQuote()
        ListItem("In the dialogue window select "):DoubleQuote():Text("Best,"):DoubleQuote():Text(" image quality.")
        ListItem("Choose a destination for the export and click "):DoubleQuote():Text("Export."):DoubleQuote()
        Subsubsection("Making PDF of Program Code (for the Create PT)")
        Paragraph("Students will need to make a PDF of their code and they also draw an oval and rectangle onto the PDF to highlight certain parts. There are a few options for this.")
        Paragraph("Using CodePrint to Annotate and Make PDF")
        BulletList()
        ListItem():Link("Go on the CodePrint site", "https://bakerfranke.github.io/codePrint/")
        ListItem("Copy and paste the code into the text box")
        ListItem("Draw 1 rectangle and 1 oval using the cursor on the "):DoubleQuote():Text("prettified"):DoubleQuote():Text(" code")
        ListItem("Click on the "):DoubleQuote():Text("Hide/Show Controls"):DoubleQuote():Text(" button")
        ListItem("Print to PDF from the browser")
        Image("files/code/CodePrint Oval and Rectangles DEMO.png", "CodePrint Oval and Rectangles DEMO")
        Paragraph("Using a Word Processor (Google docs or MS Word) to Make PDF and Annotate: This option is fine but the students won't get line numbers next to their code which can be inconvenient.")
        BulletList()
        ListItem("Copy and paste the code onto a word processor")
        ListItem("Save as PDF from the word processor")
        ListItem("To annotate the PDF if using a Mac: use the preinstalled program "):DoubleQuote():Text("Preview"):DoubleQuote():Text(" to do annotations")
        ListItem("To annotate the PDF if using a Windows machine: install Adobe Acrobat (see the AP guide for students), open the PDF in Acrobat and add annotations")
        Subsubsection("Making a video screen capture")
        Paragraph("If you are using Mac or Windows machine, code.org recommends the students to use the screen capture service provided by "):DoubleQuote():Text("Screencast-o-Matic"):DoubleQuote():Text(".")
    end

    private action StandardsAlignment
        Section("Standards Alignment")
        BulletList()
        ListItem():Strong("Computer Science Principles: "):Text("1.1.1 (A, B)")
        ListItem():Strong("Computer Science Principles: "):Text("1.2.1 (A, B, C, D, E)")
        ListItem():Strong("Computer Science Principles: "):Text("7.5.1 (C)")
    end
end
