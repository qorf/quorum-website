use Libraries.Web.Page.QuorumPage

/*
    Create Performance Task - Lesson 1: Review the Task.
    Converted from the old Lesson page by plan 13's generator: the same
    words, now without Tailwind.
*/
class CodeOrgUnit8Lesson1 is QuorumPage

    on create
        SetLocation("lessons/code/create/PTLesson1.html")
        // The name lists and links use, and the series and track it belongs
        // to: its section and picture.
        SetShortTitle("Create Performance Task - Review the Task")
        SetSectionName("Create Performance Task Prep")
        SetCardImage("/media/userInterface/quorumAssets/cspImages/csp9.svg")
        SetCardDescription("In this unit prepare for, and do the AP Create Performance Task. Each lesson contains links to helpful documents and activities to help you understand the task.")
        // For search engines and link previews, and what lists of pages say.
        SetDescription("This lesson contains a series of activities you can use to help students familiarize themselves with Create Performance Task, how it is scored, and some example tasks.")
        SetSummary("Prepares students to complete the Create Performance Task (PT)")
    end

    action Setup
        SetWebPageTitle("Create PT - Review the Task")
        Title("Create Performance Task - Lesson 1: Review the Task")
        Overview()
        GettingStarted10Minutes()
        Activity25Mins()
        WrapUp5Minutes()
    end

    private action Overview
        Section("Overview")
        Paragraph("This lesson contains a series of activities you can use to help students familiarize themselves with Create Performance Task, how it is scored, and some example tasks created by Code.org.")
        Paragraph("Students review the Submission Requirements and Scoring Guidelines for the Create PT. Subsequently they review three example scored Create PT submissions with commentary to better understand how the Submission Requirements and Scoring Guidelines are used together. In a wrap-up conversation they identify a piece of advice, a "):DoubleQuote():Text("gotcha"):DoubleQuote():Text(", and a remaining question they have about the Create PT.")
        Subsection("Goals")
        Paragraph("Students will be able to:")
        BulletList()
        ListItem("Describe the major components of the Create Performance Task (PT)")
        ListItem("Describe how the Create PT Scoring Guidelines will be used to assess the task")
        ListItem("Evaluate sample Create PT submissions by applying the scoring guidelines")
        ListItem("Identify remaining questions about the Create PT")
        Subsection("Purpose")
        Paragraph("The Create PT is in many ways straightforward: you complete a self-directed programming project and respond to prompts about your program and process. As you dig into the details of the task, however, you quickly come across some of the nuances of individual components of the task and how they're scored. This lesson is designed to introduce what these nuances are, and begin to provide some answers to the questions that will inevitably arise. Keep in mind that the next lesson provides a more structured set of responses to those questions, and so today students are just diving in to what the task looks like.")
        Subsection("Resources")
        BulletList()
        ListItem():Link("Code.org CSP Unit 8 Presentation Slides (Optional)", "https://docs.google.com/presentation/d/130WMgJC9JxZ2bz7pO59i-0-XafKeKLADKSqIGx1ZcSQ/copy")
        ListItem():Link("APCSP CT 20-21 Task Instructions - Resource", "https://apcentral.collegeboard.org/pdf/ap-csp-student-task-directions.pdf")
        ListItem():Link("APCSP CT 20-21 Scoring Guidelines - Rubric", "https://apcentral.collegeboard.org/pdf/ap-computer-science-principles-2021-create-performance-task-scoring-guidelines.pdf")
        ListItem():Link("CSP Create PT Code.org Sample 1 Video - Video", "https://drive.google.com/file/d/1QkAkYVDp5pxuE_g60-vaziOknrEDfwJx/view?usp=sharing")
        ListItem():Link("CSP Create PT Code.org Sample 1 WR - Written Response", "https://docs.google.com/document/d/1fyoXamP6NaToEQPwH8X4IgvairKauWlkt-bwZjcC4b0/edit?usp=sharing")
        ListItem():Link("CSP Create PT Code.org Sample 2 Video - Video", "https://drive.google.com/file/d/1G0kHFUkaib8eDEqa6EyGrzsJcf3smBSM/view?usp=sharing")
        ListItem():Link("CSP Create PT Code.org Sample 2 WR - Written Response", "https://docs.google.com/document/d/16E5NTKp9HXzgWj10JcQc7LiDTyk0v3eDNaQZi-CRKtM/edit?usp=sharing")
        ListItem():Link("CSP Create PT Code.org Sample 3 Video - Video", "https://drive.google.com/file/d/13medsGUeI2T3BlWcgzebVxlAnVgSKc2e/view?usp=sharing")
        ListItem():Link("CSP Create PT Code.org Sample 3 WR - Written Response", "https://docs.google.com/document/d/1sd0KEIBFAVeF0mKnVko17W4bHIapQnyjRtYs_MuCC5I/edit?usp=sharing")
        ListItem():Link("CSP Create PT Code.org Annotated Sample 1 - Annotated Sample", "https://docs.google.com/document/d/1UFIgYE6RlW0wbLo80JxtrRy-2gy8tzGwDWvp2jOXZIQ/edit?usp=sharing")
        ListItem():Link("CSP Create PT Code.org Annotated Sample 2 - Annotated Sample", "https://docs.google.com/document/d/1Fo5pPczV3gDcCujg_dvyneq5anEEeqAZqIvdVt8uQV8/edit?usp=sharing")
        ListItem():Link("CSP Create PT Code.org Annotated Sample 3 - Annotated Sample", "https://docs.google.com/document/d/16eWwTwyYzFJ_7z5Ru0HF9LbqTjS-XFIy4SL_ZW-T7Rg/edit?usp=sharing")
        ListItem():Link("CSP Create PT College Board Annotated Sample A - Annotated Sample", "https://docs.google.com/document/d/12Uv9n4rpSf3tULTTwfoMQlX4Zz6VZDiCzBscbtC9u_A/edit?usp=sharing")
        ListItem():Link("CSP Create PT College Board Annotated Sample C - Annotated Sample", "https://docs.google.com/document/d/1-RVtSe9TeoPI2UPARg3tfsOmuNzMiSYvsPwtCn8E9xE/edit?usp=sharing")
        ListItem():Link("CSP Create PT College Board Annotated Sample F - Annotated Sample", "https://docs.google.com/document/d/1dLYH7nAa5g1vXD-sST6-TkE_L5YTLl5tWachFpTQbrU/edit?usp=sharing")
        ListItem():Link("CSP Create PT College Board Annotated Sample G - Annotated Sample", "https://docs.google.com/document/d/1s-M7-jIu7gifIm2eSdtfmIeeyAimx7agsNUOPp8FH0U/edit?usp=sharing")
    end

    private action GettingStarted10Minutes
        Section("Getting Started (10 minutes)")
        Subsection("Introduce the Create PT")
        BulletList()
        ListItem("Today we're going to start looking more deeply at the Create PT, focusing specifically on understanding:")
        NestedBulletList()
        ListItem("The different components of the Create PT")
        ListItem("How the task will be scored")
        EndNestedList()
        ListItem("Don't worry, you already have much of the knowledge and skills you need to do well on this task. The hardest part might be just understanding what is required of you.")
        ListItem("First, we'll quickly read the task description and look a some examples and how they were scored.")
        Subsection("Review Create PT Submission Requirements and Scoring Guidelines")
        Paragraph():Strong("Distribute: "):Text("Students should each get printed or digital copies of the Scoring Guidelines and Task Instructions.")
        Paragraph():Strong("Prompt: "):Text("Read and then discuss with a partner the Scoring Guidelines and Task Instructions. For the Scoring Guidelines you can focus on only the first 3 columns for now: "):DoubleQuote():Text("Reporting Category"):DoubleQuote():Text(", "):DoubleQuote():Text("Task"):DoubleQuote():Text(", "):DoubleQuote():Text("Scoring Criteria"):DoubleQuote():Text(". We'll dive into the decision rules later. Just get familiar with these documents.")
        DiscussionGoal()
        Paragraph():Strong("Aim to keep this discussion relatively short. "):Text("Assure students you're intending to log their questions and they will be addressed through the lesson.")
        Paragraph("Students should leave this discussion knowing they will submit:")
        BulletList()
        ListItem("video of their code running")
        ListItem("written responses")
        ListItem("PDF of program code")
        Paragraph("They should also know the Scoring Guidelines:")
        BulletList()
        ListItem("contains 6 rows, each worth 1 point")
        ListItem("sometimes several rows apply to one written response to pick out specific aspects")
        Paragraph("Students are not, however, expected to fully understand the nuances of the task or scoring.")
        EndCallout()
        Paragraph("After reading discuss with a partner:")
        BulletList()
        ListItem("What will you "):Emphasis("actually"):Text(" be turning in to the College Board?")
        ListItem("What are you hoping will become more clear after looking at example projects?")
        Paragraph():Strong("Discuss: "):Text("Give students time to read the pages, in pairs or individually, and then discuss both questions with one another. The first one is more important for now.")
        Subsubsection("Remarks")
        BulletList()
        ListItem("Hopefully in your reading you concluded that for the Create PT you'll need to submit:")
        NestedBulletList()
        ListItem("Video showing your programs main functionality, including input and output")
        ListItem("A PDF of your program code")
        ListItem("A PDF Written Response")
        EndNestedList()
        ListItem("You should also have noticed:")
        NestedBulletList()
        ListItem("The Scoring Guidelines provide specific guidance on how each part of the task will be graded")
        EndNestedList()
        ListItem("I'm sure that right now you have a lot of questions about what this task will look like and how it will be scored. Before we answer them, let's look at some examples first.")
    end

    private action Activity25Mins
        Section("Activity (25 mins)")
        Subsection("Create PT Sample 1")
        Paragraph():Strong("Display: "):Text("As a class, watch the video for Create PT Sample 1.")
        Paragraph():Strong("Distribute: "):Text("Provide pairs of students copies of Create PT Sample 1 (links available on student page for this lesson).")
        Paragraph():Strong("Prompt: "):Text("This is a Written Response for the Create PT. Read it to yourself first. Then with your partner spend a few minutes reviewing it. Be ready to share out the following answers.")
        Paragraph():Strong("Discuss: "):Text("Ask partners to spend a couple of minutes specifically discussing the following prompts. Then have the whole class quickly share the results of their discussion.")
        BulletList()
        ListItem("Did anything surprise you in looking at this sample?")
        ListItem("Do you think this scored well based on what you know about the scoring guidelines?")
        Subsubsection("Create PT Annotated Sample 1 (score: 6/6)")
        BulletList()
        ListItem("Sample C actually received a 6/6 score. Let's look at the student response side-by-side with the scoring guidelines "):Emphasis("and"):Text(" the annotated notes to see why")
        Paragraph():Strong("Distribute: "):Text("The CSP Create PT Code.org Annotated Sample 1.")
        Paragraph():Strong("Prompt: "):Text("With your partner look over this annotated version of the sample to see how each row of the scoring guidelines was applied. You should be reading specifically to answer any of the questions you had about the task earlier. After looking it over we will discuss:")
        Paragraph():Strong("Discuss: "):Text("Ask partners to spend a couple of minutes specifically discussing the following prompts. Then have the whole class share the results of their discussion.")
        BulletList()
        ListItem("What characteristics of this response made it score well?")
        ListItem("What parts confused you?")
        ListItem("What questions do you still have about the Scoring Guidelines or Task description?")
        DiscussionGoal()
        Paragraph():Strong("Goal: "):Text("Students should understand from this example that the Scoring Guidelines are in many ways as important as the task description. The responses in this sample not only match the task description but address the particular "):DoubleQuote():Text("gotchas"):DoubleQuote():Text(" of the scoring guidelines.")
        Paragraph("Students may still have questions about the individual prompts or scoring guidelines. Encourage them that you'll look at more examples which may help clarify.")
        EndCallout()
        Subsection("Create PT Annotated Samples 2 (4/6) and 3 (2/6)")
        BulletList()
        ListItem("Let's now take a look at some other samples. To kick things off, we let's watch the student videos for Sample 2 and Sample 3.")
        Paragraph():Strong("Display: "):Text("Play both short videos for Samples 2 & 3. Students should have a basic understanding of what these apps are and how they work.")
        BulletList()
        ListItem("Sample 2: Magic 8 Ball app - when the screen is clicked, a recommendation appears and the icons change to indicate if it's a positive, neutral, or negative response.")
        ListItem("Sample 3: Random Dog Picker app - this app should be familiar from a previous unit. A dog size is chosen from a dropdown menu, and a random dog in that size category is displayed on the screen.")
        Paragraph():Strong("Distribute: "):Text("Provide pairs of students copies of the Create PT Annotated Samples 2 & 3 (student links on code studio). Students should also pull up the Written Responses for each task so they can look at the submitted code segments.")
        Paragraph():Strong("Prompt: "):Text("With your partner look at these samples - you can pick which to look at first. As you review this task with a partner ask yourself:")
        BulletList()
        ListItem("Where and how specifically did this fall short?")
        ListItem("Was there one major problem that caused ripple effects through the scoring?")
        ListItem("Or were there several smaller issues?")
        ListItem("Try to point out specific aspects of the Scoring Guidelines or Submission Requirements.")
        Paragraph():Strong("Discuss: "):Text("Ask partners to spend a couple minutes specifically discussing the prompt above. Then have the whole class share the results of their discussion. Where possible call out ways that the discussion is answering questions raised earlier in the class about the Submission Requirements or Scoring Guidelines.")
        Subsubsection("Remarks")
        BulletList()
        ListItem("In Written Response 3b, you will need to state how the named list manages complexity. This can be tricky! You will need to make sure that you specifically speak to how parts of your program would be different without the list.")
        ListItem("Let's practice this together.")
        Paragraph():Strong("Do This: "):Text("Direct students back to Create PT Annotated Sample 2. With a partner, ask students to discuss how they could rewrite 3b in order to earn the point.")
        DiscussionGoal()
        Paragraph():Strong("Goal: "):Text("Encourage students to use specific programming language in their responses (i.e. variables, conditionals, loops, etc.).")
        Paragraph("Sample 3b response: The answers list manages complexity because without it, each element would need to be stored in its own variable which would increase the length of the code and opportunities for error. The variables would need to be carefully named to indicate if they are positive, neutral, or negative as this is how the program determines what icons to display. For example, one variable might be called positive0 and store the value "):DoubleQuote():Text("Yes, absolutely"):DoubleQuote():Text(".")
        EndCallout()
    end

    private action WrapUp5Minutes
        Section("Wrap up (5 Minutes)")
        Subsection("Create PT: Advice, Gotchas, Questions")
        Paragraph():Strong("Prompt: "):Text("Based on the examples that you saw today write down on separate post-its / scratch piece of paper")
        DiscussionGoal()
        Paragraph():Strong("Goal: "):Text("The next lesson is designed to address these three specific prompts. Students will have time to dive deep on what counts as a computing innovation and how to choose one wisely. They will be provided a checklist of "):DoubleQuote():Text("gotchas"):DoubleQuote():Text(" next to each part of the task to use while they complete. There is also time set aside to answer remaining questions. In other words, don't feel the need to respond to all of these prompts here. Use this conversation to synthesize what they saw and remind students that tomorrow you'll investigate all these questions more deeply.")
        BulletList()
        ListItem("The number one piece of advice you have for the Create PT")
        ListItem("One "):DoubleQuote():Text("gotcha"):DoubleQuote():Text(" to look out for")
        ListItem("One question you'd still like answered about the Create PT")
        EndCallout()
        Paragraph():Strong("Discuss: "):Text("Have students share their answers with a partner. Then have them place their responses on the board somewhere where they can be seen.")
        Paragraph("Once answers are on the board quickly report back to the group the patterns or trends that you're seeing in their responses.")
        Subsubsection("Remarks")
        BulletList()
        ListItem("Next time we meet we're going to look more deeply into the Create PT, using the three questions you just answered. We'll talk about strategies for avoiding many of the "):DoubleQuote():Text("gotchas"):DoubleQuote():Text(" you identified in this lesson. Finally, we'll take time to address any remaining questions you have about the task.")
    end
end
