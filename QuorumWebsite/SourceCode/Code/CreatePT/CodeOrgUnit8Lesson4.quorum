use Libraries.Web.Page.QuorumPage

/*
    Lesson 4: Create PT - Complete the Task (12 hrs).
    Converted from the old Lesson page by plan 13's generator: the same
    words, now without Tailwind.
*/
class CodeOrgUnit8Lesson4 is QuorumPage

    on create
        SetLocation("lessons/code/create/PTLesson4.html")
        // The name lists and links use, and the series and track it belongs
        // to: its section and picture.
        SetShortTitle("Create Performance Task - Complete the Task")
        SetSectionName("Create Performance Task Prep")
        // For search engines and link previews, and what lists of pages say.
        SetDescription("The lesson includes some final reminders and guidelines for completing the Create PT before officially starting. For a total of 12 class hours, you will work on your project with only types of teacher support allowed (essentially: Advise on process, not ideas). You may also work with a collaborative partner in *in development of you program* - written responses must be done on your own.")
        SetSummary("Prepares students to complete the Create Performance Task (PT)")
    end

    action Setup
        SetWebPageTitle("Create PT - Complete the Task (12 hrs)")
        Title("Lesson 4: Create PT - Complete the Task (12 hrs)")
        Overview()
        GettingStarted20Minutes()
        Activity60Minutes()
        WrapUp()
        StandardsAlignment()
    end

    private action Overview
        Section("Overview")
        Paragraph("It is finally time for students to take on the Create Performance Task. For a total of 12 class hours, students should work on their projects with only types of teacher support allowed (essentially: Advise on process, don't influence or evaluate ideas). Students may also work with a collaborative partner "):Emphasis("in development of their program"):Text(" - written responses must be done on their own.")
        Paragraph("The lesson includes reminders about how you can interact with students while they are working on their projects, and suggestions about time line. The Create PT requires a minimum of 12 hours of class time. At the end, students will submit their program code, program video, and written responses through their AP digital portfolio.")
        Subsection("Goals")
        Paragraph("Students will be able to:")
        BulletList()
        ListItem("Complete and submit the Create Performance Task.")
        Subsection("Purpose")
        Paragraph("There are no new CS concepts covered in this lesson. Students will work individually or with a collaborative partner on the Create Performance Task.")
        Subsection("Resources")
        BulletList()
        ListItem():Link("APCSP CT 20-21 Task Instructions", "https://docs.google.com/document/d/1jcK8o2w7wPODoHkYy7Tg56EjwnbIOsNEWowWRcfbbl4/edit")
        ListItem():Link("APCSP CT 20-21 Scoring Guidelines", "https://apcentral.collegeboard.org/pdf/ap-computer-science-principles-2021-create-performance-task-scoring-guidelines.pdf")
    end

    private action GettingStarted20Minutes
        Section("Getting Started (20 minutes)")
        Subsection("Ready?")
        BulletList()
        ListItem("For the next ~12-16 days, you will be completing the Create Performance Task.")
        ListItem("Most of the work for this task "):Emphasis("must"):Text(" be done independently - but you are allowed to collaborate with another student to create a program. However, you must have enough individual contributions to meet all the requirements of the written responses.")
        ListItem("I (teacher) can help you with "):Emphasis("process"):Text(" and timeline and keep you on task")
        ListItem("There are a few other last minute things we should look at to make sure you're clear before we start.")
        TeachingTip()
        Paragraph():Strong("Creating a new Quorum Project:"):Text(" Before students begin programming, they should make sure they are creating their program using the Lesson3_ProjectTemplate - NOT in a project associated with a previous lesson.")
        Paragraph("However, you can use a previous project as a starting point as long as you add new parts that fulfill the task requirements.")
        Paragraph():Strong("To build off a project started in a previous lesson:")
        Paragraph("Duplicate the project from the previous lesson into Unit 8. This will create a new project that can be built upon for this lesson. Students should indicate using comments what parts of the program are copied from older projects.")
        Paragraph():Strong("For students who are creating an entirely new project:")
        Paragraph("Create a new project using the Lesson3_ProjectTemplate.")
        Paragraph():Strong("How Can You Help as a Teacher:"):Text(" "):Link("Review the Course and Exam Description", "https://apcentral.collegeboard.org/pdf/ap-computer-science-principles-course-and-exam-description.pdf"):Text(", in particular pages 170-171 to understand how you as a teacher can and cannot assist on the Create Performance Task.")
        EndCallout()
        Paragraph("Before we start let's review the AP CSP Create Task Instructions.")
        Paragraph():Strong("Prompt:"):Text(" Read page 12-13: Preparing for the Performance Task. This is a general checklist of things you should do to prepare for the AP Performance Task. Let's see how we did. With a partner - one person reading from the top down, the other reading from bottom up - check off things we've done to prepare so far. Identify anything we haven't done. Discuss together before discussing as a class.")
        Paragraph():Strong("Prompt:"):Text(" Read Page 11: AP Computer Science Principles Policy on Plagiarism. With a partner carefully read this section. Discuss together before discussing as a class.")
        Paragraph():Strong("Do This:"):Text(" Make sure everyone understands expectations.")
        BulletList()
        ListItem("For example: if you use a library that someone else created, you need to include a comment citing this source as code you yourself did not write")
        ListItem("If using images, media or other copyrighted material found on the web, you should cite those sources in comments in your program code - usually at the top. Something like:")
        CodeExample("// The images used in this app came from:
// [1] bird image - http://name-of-site.com/path/to/image.jpg
// [2] flower image - http://site.com/path/to/flower.jpg")
        Paragraph():Strong("Prompt:"):Text(" Read Pages 14-15: Guidelines for Completing the Create Performance Task. This is a final list of Do's and Don'ts for the Create PT. With your partner, read the "):Strong("You must"):Text(", "):Strong("You may not"):Text(", and "):Strong("You may"):Text(" sections of this page. Then with your partner summarize: "):Emphasis("what kinds of things can your teacher help you with?")
        DiscussionGoal()
        Paragraph("Goal:")
        BulletList()
        ListItem("Discuss specifically how you (teacher) are allowed to help and not. Short version: you "):Emphasis("can"):Text(" help students with the "):Emphasis("process"):Text(" of completing the task, you "):Emphasis("cannot"):Text(" help by evaluating their work or ideas in any way.")
        ListItem("If you modify an existing project for the Create PT "):Strong("make sure"):Text(" that the purpose is also new, or modified to fit the changes and updates you are making. For example: "):DoubleQuote():Text("The purpose was to add a login feature to a game I made previously"):DoubleQuote():Text(".")
        EndCallout()
        Subsection("Set")
        Paragraph("Do This:")
        BulletList()
        ListItem("Take out your Create PT timeline that we developed and reviewed.")
        ListItem("Ask and answer any remaining questions.")
        ListItem("Remind students of the overall timeline and that the official PT time is about to start.")
    end

    private action Activity60Minutes
        Section("Activity (60 Minutes)")
        Subsection("GO! Complete Create Performance Task")
        Paragraph("Links in Code Studio:")
        BulletList()
        ListItem("Students can find links to the AP documents in the Resources section associated with this lesson.")
        ListItem("Students may use the "):Link("Create PT Template", "https://docs.google.com/document/d/1GXTWA_q-xpN-nfLL6C8e6f28pQGps_QouzKMVHDFzEU/edit?usp=sharing"):Text(" to record their Written Response. Remind students that these responses must be entered into the appropriate fields in the Digital Portfolio before submitting their work.")
    end

    private action WrapUp
        Section("Wrap up")
        TeachingTip()
        Paragraph():Strong("Submission Timeline:"):Text(" You may spread out submission over a few days if you like since students can save progress in the AP Digital Portfolio. As long as they finalize submission by the closing date of the PTs it's fine.")
        Paragraph("In the past submitting everything right at the deadline has been a risky proposition as the site sometimes experiences outages due to heavy traffic. Get "):Emphasis("something"):Text(" in early and modify later.")
        EndCallout()
        Subsection("Students submit completed Create Performance Task")
        Paragraph():Strong("Submitting:")
        BulletList()
        ListItem("You are encouraged to submit and save work in the AP digital portfolio as you go!")
        ListItem("At the designated end of the Task administration (having allowed for at least 12 hours of class time for work) students should submit their video of the program running, written responses, and program code to their "):Link("AP Digital Portfolio", "https://apstudents.collegeboard.org/digital-submission/submit-ap-csp-work"):Text(". You can find more instructions as well by using the "):Link("AP Digital Portfolio: Student User Guide", "https://apcentral.collegeboard.org/pdf/digital-portfolio-student-user-guide-ap-csp.pdf"):Text(".")
        Paragraph("Before they submit their final work:")
        BulletList()
        ListItem("Encourage students to check over the Survival Guide checklists one more time to make sure they met the requirements.")
        ListItem("Make sure they have all the components necessary for the Create Performance Task.")
    end

    private action StandardsAlignment
        Section("Standards Alignment")
        BulletList()
        ListItem():Strong("CSTA K-12 Computer Science Standards (2017):"):Text(" 3A-AP-16, 3A-AP-18, 3A-AP-19, 3A-AP-21, 3A-AP-23, 3B-AP-14")
    end
end
