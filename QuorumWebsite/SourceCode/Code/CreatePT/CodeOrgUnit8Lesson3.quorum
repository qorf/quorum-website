use Libraries.Web.Page.QuorumPage

/*
    Lesson 3: Create PT Make a Plan.
    Converted from the old Lesson page by plan 13's generator: the same
    words, now without Tailwind.
*/
class CodeOrgUnit8Lesson3 is QuorumPage

    on create
        SetLocation("lessons/code/create/PTLesson3.html")
        // The name lists and links use, and the series and track it belongs
        // to: its section and picture.
        SetShortTitle("Create Performance Task - Make a Plan")
        SetSectionName("Create Performance Task Prep")
        // For search engines and link previews, and what lists of pages say.
        SetDescription("This lesson uses the Create PT Survival Guide as the backbone for a series of activities to ramp up to doing the actual Create PT. It contains activities to help students understand the requirements of the task, as well as activities to help them narrow down and brainstorm ideas for their actual project. The lesson concludes by providing students with resources to make a plan to complete the task staring in the next lesson.")
        SetSummary("Prepares students to complete the Create Performance Task (PT)")
    end

    action Setup
        SetWebPageTitle("Create PT Make a Plan")
        Title("Lesson 3: Create PT Make a Plan")
        Overview()
        GettingStarted5Minutes()
        Activity60Minutes()
        WrapUp10Minutes()
    end

    private action Overview
        Section("Overview")
        Paragraph("This lesson uses the Create PT Survival Guide as the backbone for a series of activities to ramp up to doing the actual Create PT. It contains activities to help students understand the requirements of the task, as well as activities to help them narrow down and brainstorm ideas for their actual project.")
        Paragraph("The lesson concludes by providing students with resources to make a plan to complete the task staring in the next lesson.")
        Subsection("Goals")
        Paragraph("Students will be able to:")
        BulletList()
        ListItem("Describe the elements and purpose of the Create PT.")
        ListItem("Describe the scoring guidelines for the Create PT.")
        ListItem("Evaluate sample Create PT components by applying the scoring guidelines.")
        Subsection("Purpose")
        Paragraph("There are no new CS concepts covered in this lesson. It is a review of the processes and requirements of the Create Performance Task before students begin working on it individually.")
        Subsection("Resources")
        BulletList()
        ListItem():Link("Create PT Survival Guide 2020-21", "https://docs.google.com/document/d/1jcK8o2w7wPODoHkYy7Tg56EjwnbIOsNEWowWRcfbbl4/edit")
    end

    private action GettingStarted5Minutes
        Section("Getting Started (5 minutes)")
        Paragraph():Strong("Discuss: "):Text("Based on our review of the Create PT yesterday...")
        Paragraph():Strong("Discussion Goal: "):Text("The purpose of this discussion to warm up students' brains and recall the elements of the Create PT. Students should start thinking about choices in light of what they have to do for the Create PT, rather than simply out of interest or"):DoubleQuote():Text("coolness"):DoubleQuote():Text(" Hopefully, the two go hand in hand.")
        Paragraph("In particular we'll looking to understand the requirements so that students select appropriately scoped projects.")
        BulletList()
        ListItem("What are the main things you have to do for the Create PT?")
        ListItem("What should you do first?")
        Paragraph():Strong("Prompt: "):Text("Let students call out the things they remember. Make this a quick review just to remind them of what was covered in the previous lesson.")
        Paragraph("A few of the things you need to do:")
        BulletList()
        ListItem("Write a program, possibly with a partner")
        ListItem("Make a video of your code running")
        ListItem("Answer written responses")
        ListItem("Make a PDF of your code")
        Paragraph("What should you do first?")
        BulletList()
        ListItem("Pick and scope down your project")
    end

    private action Activity60Minutes
        Section("Activity (60 Minutes)")
        Subsection("Remarks")
        Paragraph("Today we will use the Create PT Survival Guide to dig in a little deeper with the Create PT. The beginning of the packet has a few quick activities that help get us in the right mindset for thinking about and doing the task so you are ready to hit the ground running.")
        Paragraph("The guide will be useful throughout the entire process of completing the actual Create Task as well.")
        Paragraph():Strong("Distribute: "):Text("Create PT Survival Guide 2020-21 and optionally give students access to the Scoring Guidelines and Task Directions distributed in the previous lesson.")
        Subsection("The Create PT Survival Guide")
        Paragraph():Strong("Task Overview (page 1) - 5 mins:"):Text("Have students quickly review the information on page 1 which summarizes components of the task and the role of the guide. Answer any high level questions that come up.")
        Paragraph():Strong("What is Required of My Program (page 2) - 5 mins: "):Text("Have students read the summary of the program requirements on page 2. The goal of this section should be to highlight the four takeaways in the Survival Guide. These should be familiar ideas to students from reviewing sample submissions in the previous lesson.")
        Subsubsection("Remarks")
        Paragraph("Based on these four takeaways, it's clear that you have a lot of freedom in deciding how to design your program. Before moving on, we're going to complete two short activities to make sure we really understand the third requirement about our functions, since that one is the most complicated.")
        Paragraph():Strong("Function Requirement Activity 1 - Does It Count (pages 3 - 4) - 15 mins: "):Text("Ask students to complete the activity on page 3, using the scoring guidelines on page 4. For each of the provided algorithms they need to decide whether the function would earn each row. Give students roughly 10 minutes to score each of the functions and then take 5 minutes to discuss their work and the main takeaways from this activity.")
        Paragraph():Strong("Discuss:"):Text("Have students share and compare their responses with a classmate. Afterwards lead a discussion on the patterns they see.")
        Paragraph():Strong("Discussion Goal:"):Text(" This activity is designed to help students anticipate how they'll need to respond to prompt 3d and potentially make some decisions about how to design their functions. Here's some things they may notice:")
        BulletList()
        ListItem("It is much more straightforward to answer the question in the second example since the parameter is being used directly in the conditional statement.")
        ListItem("In either case students should come up with example arguments that run differently from one another.")
        Paragraph():Strong("Narrow it Down (page 6) - 5 mins: "):Text("As a class read the "):DoubleQuote():Text("Narrow It Down"):DoubleQuote():Text(" section of your survival guide. The most important points to note:")
        BulletList()
        ListItem("The written responses are the most important part of the Create PT.")
        ListItem("It's OK to submit a small or even incomplete project so long as it has a working feature you can show in your video and has a list and function that meets the requirements.")
        ListItem("Most ideas can and should be narrowed down before you start.")
        ListItem("You shouldn't be doing a lot of work in Design Mode or worrying about how your app looks until the end.")
        Paragraph():Strong("Practice Narrowing It Down (page 6) - 10 mins:"):Text("Have students go through one of the three project ideas and practice helping the example student narrow down their project. Give students roughly 5 minutes to discuss ideas with a partner. Then have a couple volunteers from each project idea share how they helped narrow down the project idea.")
        Paragraph():Strong("Discuss: "):Text("Lead a discussion about how to narrow down project ideas.")
        BulletList()
        ListItem("Many projects have sub parts, each of which could stand on its own as a PT")
        ListItem("You should be able to easily see a list and function opportunity within at least one of the sub parts -- if you can't, not a good choice.")
        ListItem("For any project idea it should be relatively easy to scope it down to one or two things that will be totally acceptable for the Create PT")
        Paragraph():Strong("Discussion Goal: "):Text("Understand it doesn't have to be a big project; The create PT is about demonstrating something you already know how to do.")
        Paragraph("The biggest thing we're trying to guard against is students' eyes being bigger than their stomachs. We want to encourage students to be creative and start build whatever they want, but temper that with the realities of the Create PT...")
        BulletList()
        ListItem("It doesn't need to be a big project")
        ListItem("Your job is to demonstrate that you know how to program something and identify certain aspects of it.")
        ListItem("There are no points for coolness or prettiness")
        ListItem("If you want to do something big, just get it started for the Create PT and come back to it afterward.")
        Paragraph():Strong("Choosing a Project Idea (page 8) - 5 mins:"):Text(" Quickly read this section with students and review and high level questions as a class. The main takeaways are below.")
        BulletList()
        ListItem("You don't actually have that much time to work!")
        ListItem("When you start, you should have an idea about what your list and function will be.")
        ListItem("Start with a narrowly scoped project, start working right away on the core parts of it.")
        ListItem("Don't try to learn new programming skills during the PT - do something you know how to do now.")
        ListItem("Get to the written responses as quickly as you can.")
        Paragraph():Strong("Brainstorm Ideas (page 8) - 10 mins:"):Text(" Have students use this page to brainstorm project ideas. They should come up with two different ideas and fill in information about both. These can be first draft ideas but emphasize to students that they're starting to think through what they're actually going to do on their projects.")
        Paragraph():Strong("Discuss: "):Text("Have students share and compare their responses with a classmate. When deciding on a project the answer to all of the questions in the guide should be "):DoubleQuote():Text("yes"):DoubleQuote():Text(".")
        Paragraph():Strong("Discussion Goal: "):Text("Students should exit this brief activity with (1) a basic idea of what they're going to do for their project and (2) confidence that they can do it.")
    end

    private action WrapUp10Minutes
        Section("Wrap up (10 Minutes)")
        Subsection("Make a Plan")
        Paragraph():Strong("Create PT Written Response Organizer (page 9) - 5 mins: "):Text("Quickly review this organizer with students. Encourage them to use it throughout the 12 class hours to track their progress and make sure they have every component needed to answer the questions.")
        Paragraph():Strong("Create PT Completion Timeline (page 10) - 5 mins:"):Text(" Review the sample schedule provided on page 10.")
        Paragraph():Strong("Discuss: "):Text("Have students share where they think most of their time should go.")
        Paragraph():Strong("Discussion Goal:"):Text(" the goal here is to have students start planning in earnest for the Create PT. Students should take seriously how they will allocate their time, and should think about how they probably want to maximize the amount of time they have to write the code and the written responses.")
        Subsection("Students submit completed Create Performance Task")
        BulletList()
        ListItem("You are encouraged to submit and save work in the AP digital portfolio as you go!")
        ListItem("Before submitting final: Encourage students to check over the Survival Guide checklists one more time to make sure they met the requirements and make sure you have all three components finished.")
        ListItem("At the designated end of the Task administration submit the three items to your AP Portfolio: Video, Written Responses, Program Code")
        Subsection("Remarks")
        Paragraph("Now that we have methods and strategies for completing the task along with the beginnings of a plan, tomorrow we'll officially start the task.")
    end
end
