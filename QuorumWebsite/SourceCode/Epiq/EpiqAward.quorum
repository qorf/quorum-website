use Libraries.Web.Page.QuorumPage

/*
    EPIQ Award.
    Converted from the old Lesson page by plan 13's generator: the same
    words, now without Tailwind.
*/
class EpiqAward is QuorumPage

    on create
        SetLocation("awards.html")
        // The name lists and links use, and the series and track it belongs
        // to: its section and picture.
        SetShortTitle("EPIQ Awards")
        SetCardImage("/media/games/Animation2D.png")
        // For search engines and link previews, and what lists of pages say.
        SetDescription("Learn about the awards you can win at the Experience Programming in Quorum annual conference.")
        SetSummary("the EPIQ Award page.")
    end

    action Setup
        SetWebPageTitle("EPIQ Award - Quorum Programming Language")
        Title("EPIQ Award")
        Paragraph("This page describes the (nearly) annual EPIQ Award")
        EPIQAward()
    end

    private action EPIQAward
        Section("EPIQ Award")
        Paragraph("The EPIQ Award began in EPIQ 2014 as an honor for Sherry Hahn, an early member of the steering committee that helped establish the conference. It ran for five years, then stopped especially while EPIQ was online during the pandemic. It has started again in 2024 in honor of the first in-person version of EPIQ in several years.")
        Paragraph("While the first year of the award was chosen, in secret, by several members of the steering committee, all subsequent awards have been given by popular vote. This vote varies year to year based on the whims of the community. Some years it is a programming contest based on content for the year. Others it can be for different reasons, like a lesson or educational content.")
        Table("EPIQ Award Winners")
        TableHeader():Cell("Who"):Cell("Year"):Cell("Reason")
        TableRow():Cell("Amanda Storaasli, Donna Clemens, Leanna MacDonald"):Cell("2018"):Cell("Created tactile representations of street crossings.")
        TableRow():Cell("Ko Inamura, Steve Raparelli"):Cell("2018"):Cell("Created a 3D intersection traffic simulator.")
        TableRow():Cell("Jennifer Jesso and Tim Lockwood"):Cell("2017"):Cell("Creating the highest a maze game with speech and sound effects for nonvisual players (Jennifer) and elementary programming lessons with Quorum and Robots (Tim): These are a sequence of 12 unites of elementary (grades 3-6) computer science lessons with related Physical Science , Life Sciences , Mathematics, and Fine Arts goals and content.")
        TableRow():Cell("Sina Bahram, Sam Shaw, Steve Raparelli, and Ko Inamura"):Cell("2016"):Cell("Creating a 3D computer game for Sina, Sam, and Steve to find their friend Ko, who was mysteriously lost playing Pokemon Go.")
        TableRow():Cell("Tim Lockwood"):Cell("2015"):Cell("For an amazing collaborative musical performance between him and his LEGO Robot.")
        TableRow():Cell("Sherry Hahn"):Cell("2014"):Cell("Sherry was one of the co-creators of EPIQ and it would not exist today if it were not for her help.")
    end
end
