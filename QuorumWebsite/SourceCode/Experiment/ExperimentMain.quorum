use Lessons.SceneIntroduction2
use Lessons.SceneCreation2
use Lessons.SceneComponents2
use Lessons.SceneItems2
use Lessons.SceneNavigation2
use Lessons.SceneProperties2
use Lessons.SceneRunning2
use Lessons.SceneManipulation2
use Lessons.SceneTerrain2
use Lessons.TerrainMaterials2
use Lessons.SceneTerrainShape2
use Lessons.SceneTerrainGenerate2
use Lessons.TerrainGames2
use Lessons.ScenePalette2
use Libraries.Web.Page.QuorumPage
use Libraries.Web.Page.Standards.QuorumStandards
use Libraries.Web.QuorumSite
use Libraries.Web.Series.PageSeries
use Libraries.Web.Styles.QuorumSiteOptions
use Libraries.Web.VersionHelper

/*
    Builds the experiment's page with the new styling system, apart from
    the main website, writes it into html/, then serves it. To run it, set
    "Main" in Project/Project.qp to
    "/SourceCode/Experiment/ExperimentMain.quorum", run, then set it back
    to "/SourceCode/main.quorum". Stop the run to stop the server.
*/
class ExperimentMain
    constant integer PORT = 8080
    constant text SITE_FOLDER = "html"
    constant text STYLE_SHEET = "style/experiment.css"
    constant text ADDRESS = "https://quorumlanguage.com"
    constant text SITE_NAME = "Quorum Programming Language"
    constant text TITLE_ENDING = " - Quorum Programming Language"

    // The picture shown when a page without its own is shared, from the
    // top of the site: Quincy, 1200 by 630, the shape link previews use.
    constant text DEFAULT_SHARE_IMAGE = "media/userInterface/quorumAssets/bunnyShare.jpg"
    constant text DEFAULT_SHARE_IMAGE_DESCRIPTION = "Tech-savvy bunny named Quincy with glasses working on a laptop"

    // The real site's sitemap.xml lives at the top of html/, so the
    // experiment writes its own elsewhere and never replaces it.
    constant text SITEMAP = "experiment/sitemap.xml"
    constant text ROBOTS = "experiment/robots.txt"

    action Main
        // The global look, handed to every page before it's set up.
        QuorumSiteOptions options

        QuorumSite site
        site:SetFolder(SITE_FOLDER)

        // Pages name their files from the top of the site, such as
        // "media/scenes/..." for pictures and tables and
        // "sources/tutorials/scenes/..." for files shown as examples.
        site:SetRelativeFolder("")

        // The scripts' version queries, which only the site's VersionHelper
        // knows.
        VersionHelper versions
        site:SetScriptVersions(versions:GetLanguageVersionQuery(), versions:GetScriptVersionQuery(), versions:GetPrismVersionQuery(), versions:GetLoadVersionQuery())
        site:SetStyleSheetLocation(STYLE_SHEET)

        // Search and sharing: every page's canonical address and sharing
        // tags come from the site's address; tab titles get the ending.
        site:SetAddress(ADDRESS)
        site:SetSiteName(SITE_NAME)
        site:SetTitleEnding(TITLE_ENDING)
        site:SetDefaultShareImage(DEFAULT_SHARE_IMAGE, DEFAULT_SHARE_IMAGE_DESCRIPTION)
        site:SetSitemapLocation(SITEMAP)
        site:SetRobotsLocation(ROBOTS)

        // Pages the site builds itself (the standards report) use the same
        // look, and the site reports on the 2026 CSTA standards, at
        // standards/CSTA2026.html.
        site:SetStyleOptions(options)

        // Set to true to check every page for accessibility problems before
        // the site is written; the build stops and lists any it finds.
        site:SetAccessibilityChecks(false)

        QuorumStandards standards
        site:AddStandardsReport(standards:GetComputerScience2026())

        // The 14 scene lessons, in the order of the course. Each gets its
        // options, then the site, then is set up, so it can find the site's
        // files (such as its tables' data) while it's built.
        SceneIntroduction2 sceneIntroduction
        SceneCreation2 sceneCreation
        SceneComponents2 sceneComponents
        SceneItems2 sceneItems
        SceneNavigation2 sceneNavigation
        SceneProperties2 sceneProperties
        SceneRunning2 sceneRunning
        SceneManipulation2 sceneManipulation
        SceneTerrain2 sceneTerrain
        TerrainMaterials2 terrainMaterials
        SceneTerrainShape2 sceneTerrainShape
        SceneTerrainGenerate2 sceneTerrainGenerate
        TerrainGames2 terrainGames
        ScenePalette2 scenePalette
        Build(sceneIntroduction, options, site)
        Build(sceneCreation, options, site)
        Build(sceneComponents, options, site)
        Build(sceneItems, options, site)
        Build(sceneNavigation, options, site)
        Build(sceneProperties, options, site)
        Build(sceneRunning, options, site)
        Build(sceneManipulation, options, site)
        Build(sceneTerrain, options, site)
        Build(terrainMaterials, options, site)
        Build(sceneTerrainShape, options, site)
        Build(sceneTerrainGenerate, options, site)
        Build(terrainGames, options, site)
        Build(scenePalette, options, site)

        PageSeries scenes
        scenes:SetName("Scene Editing")
        scenes:SetKey("scenes")
        scenes:SetDescription("Make scenes in Quorum Studio's scene editor, use them from code, and build terrain.")
        scenes:SetOverviewLocation("experiment/Scenes/index.html")
        scenes:Add(sceneIntroduction)
        scenes:Add(sceneCreation)
        scenes:Add(sceneComponents)
        scenes:Add(sceneItems)
        scenes:Add(sceneNavigation)
        scenes:Add(sceneProperties)
        scenes:Add(sceneRunning)
        scenes:Add(sceneManipulation)
        scenes:Add(sceneTerrain)
        scenes:Add(terrainMaterials)
        scenes:Add(sceneTerrainShape)
        scenes:Add(sceneTerrainGenerate)
        scenes:Add(terrainGames)
        scenes:Add(scenePalette)
        site:AddSeries(scenes)

        // An example second course, only to show lessons in two courses:
        // try the introduction with ?course=example-game-worlds.
        PageSeries gameWorlds
        gameWorlds:SetName("Example Course: Building Game Worlds")
        gameWorlds:SetKey("example-game-worlds")
        gameWorlds:SetDescription("An example course for trying course navigation. Not a real course.")
        gameWorlds:SetOverviewLocation("experiment/Courses/game-worlds.html")
        gameWorlds:Add(sceneIntroduction)
        gameWorlds:Add(terrainGames)
        site:AddSeries(gameWorlds)

        // Lessons in two courses name their home: the one their navigation
        // follows when a reader arrives from search.
        sceneIntroduction:SetHomeSeries(scenes)
        terrainGames:SetHomeSeries(scenes)

        site:Write()
        //site:Serve(PORT)
    end

    // Hands a lesson the look and puts it on the site, which sets it up
    // when the site is written.
    private action Build(QuorumPage page, QuorumSiteOptions options, QuorumSite site)
        page:SetStyleOptions(options)
        site:AddPage(page)
    end
end
