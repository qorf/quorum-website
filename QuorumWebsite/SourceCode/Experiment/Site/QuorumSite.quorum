package Libraries.Web

use Libraries.Containers.Array
use Libraries.Containers.HashTable
use Libraries.Containers.Iterator
use Libraries.Data.Formats.JavaScriptObjectNotation
use Libraries.Web.WebSite
use Libraries.Web.Page.WebTag
use Libraries.Web.Page.RichText
use Libraries.Web.Page.Division
use Libraries.Web.Page.NavigationDivision
use Libraries.Web.Page.OrderedList
use Libraries.Web.Page.ListItem
use Libraries.Web.Page.Paragraph
use Libraries.Web.Page.UnorderedList
use Libraries.Web.Page.Link
use Libraries.Web.Page.Heading
use Libraries.Web.Page.MainContent
use Libraries.Web.Page.Span
use Libraries.Web.Page.Image
use Libraries.Web.Styles.WebTextStyle
use Libraries.Web.Styles.StyleSheetConstants
use Libraries.Web.Page.StrongText
use Libraries.Web.Page.WebPage
use Libraries.Web.Page.Script
use Libraries.Web.Page.Standards.Standard
use Libraries.Web.Page.Standards.StandardSet
use Libraries.Web.Page.Standards.StandardsTracker
use Libraries.Web.Page.Standards.StandardsReport
use Libraries.Web.Page.Standards.StandardsListEntry
use Libraries.Web.Page.QuorumLoginForm
use Libraries.Web.Page.QuorumNavigationBar
use Libraries.Web.Series.CourseOverview
use Libraries.Web.Series.PageSeries
use Libraries.Web.Series.PageSeriesEntry
use Libraries.Web.Styles.QuorumFrameLooks
use Libraries.Web.Styles.QuorumSiteOptions

/*
    QuorumSite is the Quorum website. It is a WebSite with what only this
    site needs: once every page is set up, it fills in the pages'
    standards lists and builds a report page for each set of standards it
    is asked to report on, so each report has a permanent address to
    share. Each series of pages is a course: it gets an overview page, and
    each of its lessons gets breadcrumbs and Back and Next links that keep
    a reader in the course they are following. It also describes lessons
    and courses to search engines (structured data).
    Everything general stays in WebSite.

    Attribute: Example
    QuorumSiteOptions options
    QuorumStandards standards
    QuorumSite site
    site:SetFolder("html")
    site:SetStyleOptions(options)
    site:AddStandardsReport(standards:GetComputerScience2026())
*/
class QuorumSite is WebSite
    // The one tracker for every page on the site (a shared class).
    StandardsTracker tracker

    // The sets of standards to write report pages for.
    Array<StandardSet> reportedSets
    WebTextEscaper escaper

    // Structured data, in the shared schema.org vocabulary.
    constant text SCHEMA_CONTEXT = "https://schema.org"
    constant text STRUCTURED_DATA_TYPE = "application/ld+json"
    constant text LEARNING_RESOURCE = "LearningResource"
    constant text LESSON = "Lesson"
    constant text ALIGNMENT = "AlignmentObject"
    constant text TEACHES = "teaches"
    constant text LANGUAGE = "en"

    // Course navigation. A link that keeps a reader in a course carries
    // the course's key in the address, as ?course=scenes.
    WebLocations locations
    constant text COURSE_PARAMETER = "course"
    constant text COURSE_DATA_ATTRIBUTE = "data-course"
    constant text HIDDEN_ATTRIBUTE = "hidden"
    constant text LABEL_ATTRIBUTE = "aria-label"
    constant text CURRENT_ATTRIBUTE = "aria-current"
    constant text CURRENT_PAGE = "page"
    constant text BREADCRUMB_LABEL = "Breadcrumb"
    constant text HOME_NAME = "Home"
    constant text HOME_ADDRESS = "/"
    constant text HIDDEN_FROM_READERS = "aria-hidden"
    constant text ARIA_TRUE = "true"
    constant text BREADCRUMB_SEPARATOR = "›"
    constant text FORWARD_MARK = " ›"
    constant text BACKWARD_MARK = "‹ "
    constant text LINE_SEPARATOR = " · "
    constant text UP_NEXT_IN = "Up next in "
    constant text END_OF = "End of "
    constant text BACK_TO = "Back to "
    constant text BACK = "Back: "
    constant text COURSE_OVERVIEW = "Course overview"
    constant text ALSO_PART_OF = "Also part of "
    constant text FOR_TEACHERS = "For teachers · "
    constant text SPECIALTIES = "Specialties"

    // Navigation regions on a page need different names, so the side
    // contents keep the course's name and the end of a lesson adds this.
    constant text NEXT_LABEL_ENDING = ": what's next"
    constant text EVERY_STANDARD = "Every standard, and the lessons that cover it"
    constant text DETAILS_SEPARATOR = " · "
    constant text ONLY_THIS_LESSON = "Only this lesson so far"
    constant text ALSO_IN = "Also in "
    constant text OTHER_LESSON = " other lesson"
    constant text OTHER_LESSONS = " other lessons"

    // The site's look (a shared class), for its course navigation.
    QuorumSiteOptions quorumOptions

    // Letting readers zoom in on a page's pictures. Each picture the
    // site marks gets wrapped, when the page loads, in a button named
    // "Zoom:" and its description; the button opens a dialog showing the
    // picture large with its description under it. The dialog takes
    // focus, closes with Escape, its Close button or a click, and gives
    // focus back to the button. With scripts off, pictures stay plain
    // pictures, with no button that does nothing.
    constant text ZOOM_ATTRIBUTE = "data-zoom"
    constant text ZOOM_SCRIPT = "document.addEventListener('DOMContentLoaded',function(){var pictures=document.querySelectorAll('img[data-zoom]');if(!pictures.length){return;}var box=document.createElement('dialog');box.id='zoomedImageContainer';box.setAttribute('aria-label','Zoomed picture');box.style.cssText='width:100%;height:100%;max-width:none;max-height:none;margin:0;padding:2rem;border:0;background:rgba(64,64,64,0.9);';var close=document.createElement('button');close.type='button';close.textContent='Close';close.style.cssText='align-self:flex-end;margin-bottom:1rem;padding:0.5rem 1rem;border-radius:0.75rem;background:#fff;font-weight:700;';var big=document.createElement('img');big.style.cssText='height:83%;object-fit:contain;margin-bottom:2rem;background:#f6f6f7;';var words=document.createElement('p');words.style.cssText='color:#fff;font-size:1.5rem;line-height:2rem;padding:1rem 1.5rem;';var inner=document.createElement('div');inner.style.cssText='display:flex;flex-direction:column;align-items:center;height:100%;';inner.append(close,big,words);box.appendChild(inner);document.body.appendChild(box);var opener=null;close.addEventListener('click',function(){box.close();});box.addEventListener('click',function(event){if(event.target!==close){box.close();}});box.addEventListener('close',function(){if(opener){opener.focus();}});pictures.forEach(function(picture){var button=document.createElement('button');button.type='button';button.setAttribute('aria-label','Zoom: '+picture.alt);button.style.cursor='zoom-in';picture.parentNode.insertBefore(button,picture);button.appendChild(picture);button.addEventListener('click',function(){big.src=picture.src;big.alt=picture.alt;words.textContent=picture.alt;opener=button;box.showModal();close.focus();});});});"

    // The frame around every page, as Lesson builds it for the main site,
    // with the frame's looks (a shared class) and the screen widths where
    // they change. The navigation bar and sign-in forms are still the
    // main site's, with its Tailwind classes.
    QuorumFrameLooks frame
    StyleSheetConstants constants
    // The version queries for the site's scripts (such as "?version=14.0.4"),
    // so browsers fetch a script again when it changes. The site's
    // VersionHelper knows them; whatever builds the site hands them over
    // with SetScriptVersions.
    text languageVersion = ""
    text scriptVersion = ""
    text highlighterVersion = ""
    text loadVersion = ""
    // The site's font, Montserrat, from Google Fonts, as output.css
    // imported it (style/google.css only declares Open Sans, which no
    // page uses).
    constant text FONTS_STYLE_SHEET = "https://fonts.googleapis.com/css2?family=Montserrat:wght@400;700&display=swap"
    constant text JQUERY_SCRIPT = "script/jquery-1.8.3.min.js"
    constant text LIBRARY_SCRIPT = "script/QuorumStandardLibrary.js"
    constant text SITE_SCRIPT = "script/script.js"
    constant text HIGHLIGHT_SCRIPT = "script/prism-quorum.js"
    constant text LOAD_SCRIPT = "script/load.js"
    constant text SCRIPTS_FOLDER = "script/"
    constant text ICON = "media/favicon.ico"
    constant text ROLE_ATTRIBUTE = "role"
    constant text MAIN_ROLE = "main"
    constant text MAIN_IDENTIFIER = "main"
    constant text MAIN_TAB_INDEX = "-1"
    constant text CONTENT_IDENTIFIER = "content"
    constant text COLUMNS_IDENTIFIER = "mainDiv"
    constant text SKIP_LINK_IDENTIFIER = "skipLink"
    constant text SKIP_LINK_WORDS = "Skip to Main Content"
    constant text ON_THIS_PAGE_WORDS = "On this page"
    constant text FOOTER_IDENTIFIER = "footer"
    constant text FOOTER_ROLE = "contentinfo"
    constant text FOOTER_NAME = "The Quorum Programming Language"
    constant text FOOTER_FUNDING = "Copyright © 2014-2025. Funding for Quorum comes largely from the National Science Foundation #0940521, #1440878, #1644491, #1640131, #1738259 and #1738252, #2023739, #2048356, #2106392, #2121993. Other contributions can be found on "
    constant text CONTRIBUTORS_WORDS = "the contributors page."
    constant text CONTRIBUTORS_ADDRESS = "/contributors.html"

    // Shows the navigation for the course named in the address (if the
    // page has it) and hides the rest; with no course named, or an
    // unknown one, the home course's navigation stays.
    constant text COURSE_CHOOSER_SCRIPT = "(function(){var c=new URLSearchParams(window.location.search).get('course');if(!c){return;}var all=document.querySelectorAll('[data-course]');var found=false;all.forEach(function(e){if(e.getAttribute('data-course')===c){found=true;}});if(!found){return;}all.forEach(function(e){e.hidden=e.getAttribute('data-course')!==c;});})();"

    /*
        Sets the version queries added to the addresses of the scripts the
        frame loads, so browsers fetch a script again when it changes.

        Attribute: Parameter language The query for the Quorum standard library's script.
        Attribute: Parameter script The query for the site's own script.
        Attribute: Parameter highlighter The query for the code highlighter's script.
        Attribute: Parameter load The query for the script that loads Quorum programs.

        Attribute: Example
        VersionHelper versions
        QuorumSite site
        site:SetScriptVersions(versions:GetLanguageVersionQuery(), versions:GetScriptVersionQuery(), versions:GetPrismVersionQuery(), versions:GetLoadVersionQuery())
    */
    action SetScriptVersions(text language, text script, text highlighter, text load)
        languageVersion = language
        scriptVersion = script
        highlighterVersion = highlighter
        loadVersion = load
    end

    /*
        Asks the site to build a report page for a set of standards: every
        standard in the set, with the pages that cover it. It goes at the
        set's report location, such as "standards/CSTA2026.html", and uses
        the site's style options.

        Attribute: Parameter set The set to report.
    */
    action AddStandardsReport(StandardSet set)
        reportedSets:Add(set)
    end

    /*
        Once every page is set up: fills in the pages' standards lists,
        then builds a report page for each set. WebSite calls this before
        building the stylesheet, so the reports are styled and written like
        any other page.
    */
    action FinishContent
        FillStandardsLists()
        integer i = 0
        repeat while i < reportedSets:GetSize()
            StandardSet set = reportedSets:Get(i)
            StandardsReport report
            report:SetLocation(set:GetReportLocation())
            report:SetStyleOptions(GetStyleOptions())
            report:SetLooks(quorumOptions:GetStandardsReport())
            report:SetOtherGroupsLabel(SPECIALTIES)
            AddPage(report)
            report:Build(set, tracker)
            i = i + 1
        end

        // An overview page for every course.
        Array<PageSeries> courses = GetSeriesList()
        i = 0
        repeat while i < courses:GetSize()
            PageSeries course = courses:Get(i)
            if not course:GetOverviewLocation():IsEmpty()
                CourseOverview overview
                overview:SetLocation(course:GetOverviewLocation())
                overview:SetStyleOptions(GetStyleOptions())
                AddPage(overview)
                overview:Build(course, tracker, me)
                if not GetAddress():IsEmpty()
                    AddCourseData(overview, course)
                end
            end
            i = i + 1
        end

        // Course navigation for every page in a course, and structured
        // data: breadcrumbs for pages in a course, and a description of
        // every lesson (every page that covers a standard). Plain pages
        // (the old site's) keep their own navigation and frame.
        Iterator<WebPage> allPages = GetPageIterator()
        repeat while allPages:HasNext()
            WebPage page = allPages:Next()
            Array<PageSeries> pageCourses = GetSeriesOf(page)
            if IsPlainPage(page)
                // Nothing added.
            elseif pageCourses:GetSize() > 0
                AddCourseNavigation(page, pageCourses, GetHomeSeries(page))
                if not GetAddress():IsEmpty()
                    AddBreadcrumbData(page, pageCourses)
                end
            end
            if tracker:GetRecorded(page):GetSize() > 0 and not IsPlainPage(page)
                AddStructuredData(page, pageCourses)
            end
        end

        // Last, the frame around every page, so the course navigation
        // above sits inside the page's content column.
        allPages = GetPageIterator()
        repeat while allPages:HasNext()
            WebPage framed = allPages:Next()
            if not IsPlainPage(framed)
                AddFrame(framed, GetSeriesOf(framed))
            end
        end
    end

    /*
        Adds structured data to a lesson's head: a schema.org
        LearningResource with its title, summary, address, language and
        level, and an alignment for each standard it covers, linked to the
        standard's report. Search engines and other tools read it; people
        don't see it.
    */
    private action AddStructuredData(WebPage page, Array<PageSeries> pageCourses)
        Array<Standard> recorded = tracker:GetRecorded(page)

        JavaScriptObjectNotation lesson
        lesson:SetObject()
        lesson:Add("@context", SCHEMA_CONTEXT)
        lesson:Add("@type", LEARNING_RESOURCE)
        lesson:Add("learningResourceType", LESSON)
        lesson:Add("name", escaper:EscapeForScript(page:GetTitleText()))
        text pageDescription = page:GetDescription()
        if not pageDescription:IsEmpty()
            lesson:Add("description", escaper:EscapeForScript(pageDescription))
        end
        if not GetAddress():IsEmpty()
            lesson:Add("url", escaper:EscapeForScript(GetPublicAddress(page:GetLocation())))
        end
        lesson:Add("inLanguage", LANGUAGE)
        lesson:Add("isAccessibleForFree", true)

        // The level comes from the first standard the lesson covers.
        lesson:Add("educationalLevel", escaper:EscapeForScript(recorded:Get(0):GetLevel()))

        JavaScriptObjectNotation alignments
        alignments:SetArray()
        HashTable<text, boolean> seen
        integer i = 0
        repeat while i < recorded:GetSize()
            Standard standard = recorded:Get(i)
            StandardSet set = standard:GetSet()
            text key = set:GetName() + " " + standard:GetIdentifier()
            if not seen:HasKey(key)
                seen:Set(key, true)
                JavaScriptObjectNotation alignment
                alignment:SetObject()
                alignment:Add("@type", ALIGNMENT)
                alignment:Add("alignmentType", TEACHES)
                alignment:Add("educationalFramework", escaper:EscapeForScript(set:GetName()))
                alignment:Add("targetName", escaper:EscapeForScript(standard:GetIdentifier()))
                alignment:Add("targetDescription", escaper:EscapeForScript(standard:GetText()))
                if not GetAddress():IsEmpty() and not set:GetReportLocation():IsEmpty()
                    alignment:Add("targetUrl", escaper:EscapeForScript(GetPublicAddress(set:GetReportLocation())))
                end
                alignments:Add(alignment)
            end
            i = i + 1
        end
        lesson:Add("educationalAlignment", alignments)

        // The courses this lesson is part of.
        if pageCourses:GetSize() > 0 and not GetAddress():IsEmpty()
            JavaScriptObjectNotation partOf
            partOf:SetArray()
            integer c = 0
            repeat while c < pageCourses:GetSize()
                PageSeries course = pageCourses:Get(c)
                JavaScriptObjectNotation courseData
                courseData:SetObject()
                courseData:Add("@type", "Course")
                courseData:Add("name", escaper:EscapeForScript(course:GetName()))
                courseData:Add("url", escaper:EscapeForScript(GetPublicAddress(course:GetOverviewLocation())))
                partOf:Add(courseData)
                c = c + 1
            end
            lesson:Add("isPartOf", partOf)
        end

        AddStructuredDataScript(page, lesson)
    end

    /*
        Returns the address of a page that keeps the reader in a course:
        the page's address with the course's key added, such as
        "/tutorials/Scenes/intro.html?course=scenes". Every link a course
        writes uses this, so following Next or a course's lesson list keeps
        the reader in that course.

        Attribute: Parameter location The page's location on the site.
        Attribute: Parameter course The course the reader is following.
        Attribute: Returns The address.
    */
    action GetCourseAddress(text location, PageSeries course) returns text
        return locations:FromSiteTop(location) + "?" + COURSE_PARAMETER + "=" + course:GetKey()
    end

    /*
        Adds a lesson's course navigation: breadcrumbs at the start, and
        Back, Next and "Also part of" at the end, one version for each
        course the lesson is in. Only the home course's version shows at
        first; a short script shows the version for the course named in
        the address instead, so a reader following another course stays in
        it. With scripts off, the home course's version stays, and works.
    */
    private action AddCourseNavigation(WebPage page, Array<PageSeries> courses, PageSeries home)
        Division opening
        Division closing
        integer i = 0
        repeat while i < courses:GetSize()
            PageSeries course = courses:Get(i)
            boolean shown = (course = home)
            opening:AddNestedTag(GetBreadcrumbs(page, course, shown))
            closing:AddNestedTag(GetCourseLinks(page, course, courses, shown))
            i = i + 1
        end
        page:PlaceAtStart(opening)
        page:PlaceAtEnd(closing)

        Script chooser
        chooser:SetCode(COURSE_CHOOSER_SCRIPT)
        page:PlaceAtEnd(chooser)
    end

    // Home › Course › Lesson, for one course, in one row (design B).
    private action GetBreadcrumbs(WebPage page, PageSeries course, boolean shown) returns NavigationDivision
        NavigationDivision navigation
        navigation:AddAttribute(LABEL_ATTRIBUTE, BREADCRUMB_LABEL)
        MarkForCourse(navigation, course, shown)
        OrderedList list
        page:SetLayout(list, quorumOptions:GetBreadcrumbs())
        page:SetStyle(list, quorumOptions:GetBreadcrumbList())
        navigation:AddNestedTag(list)

        list:AddNestedTag(GetBreadcrumb(page, HOME_NAME, HOME_ADDRESS))
        list:AddNestedTag(GetSeparator(page))
        list:AddNestedTag(GetBreadcrumb(page, course:GetName(), GetCourseAddress(course:GetOverviewLocation(), course)))
        list:AddNestedTag(GetSeparator(page))

        ListItem current
        current:AddAttribute(CURRENT_ATTRIBUTE, CURRENT_PAGE)
        page:SetStyle(current, quorumOptions:GetBreadcrumbCurrent())
        list:AddNestedTag(current)
        WriterFor(current, page):Text(page:GetTitleText())
        return navigation
    end

    // One step in the breadcrumbs: a link without an underline.
    private action GetBreadcrumb(WebPage page, text words, text address) returns ListItem
        ListItem item
        item:AddNestedTag(GetLink(page, words, address, quorumOptions:GetBreadcrumbLink()))
        return item
    end

    // The mark between two steps. It sits in its own item, hidden from
    // screen readers, which announce the list's steps themselves.
    private action GetSeparator(WebPage page) returns ListItem
        ListItem item
        item:AddAttribute(HIDDEN_FROM_READERS, ARIA_TRUE)
        page:SetStyle(item, quorumOptions:GetBreadcrumbSeparator())
        item:AddText(BREADCRUMB_SEPARATOR)
        return item
    end

    // A link with its own look, its words and address made safe.
    private action GetLink(WebPage page, text words, text address, WebTextStyle style) returns Link
        Link link
        link:SetAddress(escaper:EscapeAttribute(address))
        link:AddText(escaper:Escape(words))
        page:SetStyle(link, style)
        return link
    end

    // A mark, such as an arrow, that screen readers skip.
    private action GetMark(text mark) returns Span
        Span span
        span:AddAttribute(HIDDEN_FROM_READERS, ARIA_TRUE)
        span:AddText(mark)
        return span
    end

    /*
        The end of a lesson, for one course (design F): an "Up next" box
        with the next lesson's name and summary, then one line with a link
        back (the previous lesson, or the course's overview for its first
        lesson) and the other courses the lesson is in. On a course's last
        lesson, the box says the course is done and links its overview.
    */
    private action GetCourseLinks(WebPage page, PageSeries course, Array<PageSeries> courses, boolean shown) returns NavigationDivision
        NavigationDivision navigation
        navigation:AddAttribute(LABEL_ATTRIBUTE, escaper:EscapeAttribute(course:GetName() + NEXT_LABEL_ENDING))
        MarkForCourse(navigation, course, shown)
        Division column
        page:SetLayout(column, GetStyleOptions():GetStack())
        navigation:AddNestedTag(column)
        text overviewAddress = GetCourseAddress(course:GetOverviewLocation(), course)

        Division box
        page:SetStyle(box, quorumOptions:GetUpNext())
        column:AddNestedTag(box)
        Paragraph label
        page:SetStyle(label, quorumOptions:GetUpNextLabel())
        box:AddNestedTag(label)
        Paragraph nextLine
        box:AddNestedTag(nextLine)

        integer position = course:GetPosition(page:GetLocation())
        if position < course:GetSize() - 1
            PageSeriesEntry following = course:GetEntry(position + 1)
            label:AddText(escaper:Escape(UP_NEXT_IN + course:GetName()))
            Link next = GetLink(page, following:GetTitle(), GetCourseAddress(following:GetLocation(), course), quorumOptions:GetUpNextLink())
            next:AddNestedTag(GetMark(FORWARD_MARK))
            nextLine:AddNestedTag(next)
            text summary = following:GetDescription()
            if not summary:IsEmpty()
                Paragraph summaryLine
                page:SetStyle(summaryLine, quorumOptions:GetUpNextDescription())
                summaryLine:AddText(escaper:Escape(summary))
                box:AddNestedTag(summaryLine)
            end
        else
            label:AddText(escaper:Escape(END_OF + course:GetName()))
            Link overview = GetLink(page, COURSE_OVERVIEW, overviewAddress, quorumOptions:GetUpNextLink())
            overview:AddNestedTag(GetMark(FORWARD_MARK))
            nextLine:AddNestedTag(overview)
        end

        Paragraph line
        page:SetStyle(line, quorumOptions:GetCourseLine())
        column:AddNestedTag(line)
        line:AddNestedTag(GetMark(BACKWARD_MARK))
        RichText writer = WriterFor(line, page)
        if position > 0
            PageSeriesEntry previous = course:GetEntry(position - 1)
            writer:Text(BACK):Link(previous:GetTitle(), GetCourseAddress(previous:GetLocation(), course))
        else
            writer:Link(BACK_TO + course:GetName(), overviewAddress)
        end

        if courses:GetSize() > 1
            line:AddNestedTag(GetMark(LINE_SEPARATOR))
            writer:Text(ALSO_PART_OF)
            boolean first = true
            integer i = 0
            repeat while i < courses:GetSize()
                PageSeries other = courses:Get(i)
                if other not= course
                    if not first
                        writer:Text(", ")
                    end
                    writer:Link(other:GetName(), GetCourseAddress(other:GetOverviewLocation(), other))
                    first = false
                end
                i = i + 1
            end
        end
        return navigation
    end

    /*
        Fills in every page's standards list (design 2): a label naming
        the set, a grid of cards, one for each standard the page covers,
        and a link to the set's report. Each card links its standard to
        its place on the report.
    */
    private action FillStandardsLists
        Array<StandardsListEntry> lists = tracker:GetLists()
        integer i = 0
        repeat while i < lists:GetSize()
            StandardsListEntry entry = lists:Get(i)
            WebPage page = entry:GetPage()
            StandardSet set = entry:GetSet()
            WebTag container = entry:GetList()
            text reportAddress = locations:FromSiteTop(set:GetReportLocation())

            Paragraph label
            page:SetStyle(label, quorumOptions:GetStandardsLabel())
            label:AddText(escaper:Escape(FOR_TEACHERS + set:GetName()))
            container:AddNestedTag(label)

            Division cards
            page:SetLayout(cards, quorumOptions:GetStandardsGrid())
            container:AddNestedTag(cards)
            Array<Standard> covered = tracker:GetStandardsOn(page, set)
            integer j = 0
            repeat while j < covered:GetSize()
                cards:AddNestedTag(GetStandardCard(page, covered:Get(j), reportAddress))
                j = j + 1
            end

            Paragraph every
            Link everyLink = GetLink(page, EVERY_STANDARD, reportAddress, quorumOptions:GetStandardsLink())
            everyLink:AddNestedTag(GetMark(FORWARD_MARK))
            every:AddNestedTag(everyLink)
            container:AddNestedTag(every)
            i = i + 1
        end
    end

    // One standard's card: its identifier, linked to its place on the
    // report; its level and concept; its words; and how many other
    // lessons cover it.
    private action GetStandardCard(WebPage page, Standard standard, text reportAddress) returns Division
        Division card
        page:SetStyle(card, quorumOptions:GetStandardCard())

        Paragraph code
        code:AddNestedTag(GetLink(page, standard:GetIdentifier(), reportAddress + "#" + standard:GetIdentifier(), quorumOptions:GetStandardCode()))
        card:AddNestedTag(code)

        Paragraph details
        page:SetStyle(details, quorumOptions:GetStandardDetails())
        details:AddText(escaper:Escape(standard:GetLevel() + DETAILS_SEPARATOR + standard:GetConcept()))
        card:AddNestedTag(details)

        Paragraph words
        page:SetStyle(words, quorumOptions:GetStandardWords())
        words:AddText(escaper:Escape(standard:GetText()))
        card:AddNestedTag(words)

        integer others = tracker:GetPagesFor(standard):GetSize() - 1
        Paragraph coverage
        page:SetStyle(coverage, quorumOptions:GetStandardDetails())
        if others <= 0
            coverage:AddText(ONLY_THIS_LESSON)
        elseif others = 1
            coverage:AddText(ALSO_IN + others + OTHER_LESSON)
        else
            coverage:AddText(ALSO_IN + others + OTHER_LESSONS)
        end
        card:AddNestedTag(coverage)
        return card
    end

    // Marks navigation as belonging to a course, hidden unless it is the
    // course shown first.
    private action MarkForCourse(NavigationDivision navigation, PageSeries course, boolean shown)
        navigation:AddAttribute(COURSE_DATA_ATTRIBUTE, course:GetKey())
        if not shown
            navigation:AddAttribute(HIDDEN_ATTRIBUTE, HIDDEN_ATTRIBUTE)
        end
    end

    private action WriterFor(WebTag element, WebPage page) returns RichText
        RichText writer
        writer:SetTarget(element, page)
        return writer
    end

    /*
        Adds one BreadcrumbList to a page's structured data for each course
        it is in: Home, the course, the page. Search engines accept several
        trails for one page.
    */
    private action AddBreadcrumbData(WebPage page, Array<PageSeries> courses)
        integer i = 0
        repeat while i < courses:GetSize()
            PageSeries course = courses:Get(i)
            JavaScriptObjectNotation trail
            trail:SetObject()
            trail:Add("@context", SCHEMA_CONTEXT)
            trail:Add("@type", "BreadcrumbList")
            JavaScriptObjectNotation items
            items:SetArray()
            items:Add(GetTrailItem(1, HOME_NAME, GetPublicAddress("")))
            items:Add(GetTrailItem(2, course:GetName(), GetPublicAddress(course:GetOverviewLocation())))
            items:Add(GetTrailItem(3, page:GetTitleText(), GetPublicAddress(page:GetLocation())))
            trail:Add("itemListElement", items)
            AddStructuredDataScript(page, trail)
            i = i + 1
        end
    end

    private action GetTrailItem(integer position, text name, text address) returns JavaScriptObjectNotation
        JavaScriptObjectNotation item
        item:SetObject()
        item:Add("@type", "ListItem")
        item:Add("position", position)
        item:Add("name", escaper:EscapeForScript(name))
        item:Add("item", escaper:EscapeForScript(address))
        return item
    end

    /*
        Adds a Course to a course overview page's structured data: its
        name, description, address, provider, and its lessons in order.
    */
    private action AddCourseData(WebPage page, PageSeries course)
        JavaScriptObjectNotation data
        data:SetObject()
        data:Add("@context", SCHEMA_CONTEXT)
        data:Add("@type", "Course")
        data:Add("name", escaper:EscapeForScript(course:GetName()))
        if not course:GetDescription():IsEmpty()
            data:Add("description", escaper:EscapeForScript(course:GetDescription()))
        end
        data:Add("url", escaper:EscapeForScript(GetPublicAddress(course:GetOverviewLocation())))
        data:Add("isAccessibleForFree", true)

        JavaScriptObjectNotation provider
        provider:SetObject()
        provider:Add("@type", "Organization")
        provider:Add("name", escaper:EscapeForScript(GetSiteName()))
        provider:Add("url", escaper:EscapeForScript(GetAddress()))
        data:Add("provider", provider)

        JavaScriptObjectNotation lessons
        lessons:SetArray()
        integer i = 0
        repeat while i < course:GetSize()
            PageSeriesEntry entry = course:GetEntry(i)
            JavaScriptObjectNotation lesson
            lesson:SetObject()
            lesson:Add("@type", LEARNING_RESOURCE)
            lesson:Add("name", escaper:EscapeForScript(entry:GetTitle()))
            lesson:Add("url", escaper:EscapeForScript(GetPublicAddress(entry:GetLocation())))
            lessons:Add(lesson)
            i = i + 1
        end
        data:Add("hasPart", lessons)
        AddStructuredDataScript(page, data)
    end

    /*
        Builds the Quorum website's frame around a page's content, as
        Lesson does for the main site today: the scripts and fonts every
        page loads, a link to skip to the content, sign-in, the navigation
        bar, three columns (the course's contents, the page's content, and
        "On this page"), and the footer. Its looks come from
        QuorumFrameLooks and match Lesson's; the side columns appear only
        on wider screens. The navigation bar and sign-in forms are still
        the main site's.
    */
    private action AddFrame(WebPage page, Array<PageSeries> pageCourses)
        // What every page loads.
        page:AddStylesheet(FONTS_STYLE_SHEET)
        page:AddScript(locations:FromSiteTop(JQUERY_SCRIPT))
        page:AddScript(locations:FromSiteTop(LIBRARY_SCRIPT) + languageVersion)
        page:AddScript(locations:FromSiteTop(SITE_SCRIPT) + scriptVersion)
        page:AddScript(locations:FromSiteTop(HIGHLIGHT_SCRIPT) + highlighterVersion)
        Script locateFiles
        locateFiles:SetCode(GetLocateFilesScript())
        page:GetWebPageHeader():Add(locateFiles)
        page:AddScript(locations:FromSiteTop(LOAD_SCRIPT) + loadVersion)
        page:AddIcon(locations:FromSiteTop(ICON))

        // The page's content, with everything it already has (breadcrumbs,
        // course links), goes in the middle column.
        Division content
        content:SetIdentifier(CONTENT_IDENTIFIER)
        page:SetLayout(content, frame:GetContent())
        page:SetStyle(content, frame:GetContentBox())
        page:SetStyleFromWidth(content, constants:SMALL_SCREEN_WIDTH, frame:GetContentSmall())
        page:SetStyleFromWidth(content, constants:MEDIUM_SCREEN_WIDTH, frame:GetContentMedium())
        page:MoveContentInto(content)

        Division courseContents
        page:SetStyle(courseContents, frame:GetSideColumn())
        page:SetStyleFromWidth(courseContents, constants:SMALL_SCREEN_WIDTH, frame:GetSideColumnSmall())
        integer i = 0
        repeat while i < pageCourses:GetSize()
            PageSeries course = pageCourses:Get(i)
            boolean shown = (course = GetHomeSeries(page))
            courseContents:AddNestedTag(GetCourseContents(page, course, shown))
            i = i + 1
        end

        Division onThisPage
        page:SetStyle(onThisPage, frame:GetSideColumn())
        page:SetStyleFromWidth(onThisPage, constants:MEDIUM_SCREEN_WIDTH, frame:GetOnThisPageColumnMedium())
        onThisPage:AddNestedTag(GetOnThisPage(page))

        Division columns
        columns:SetIdentifier(COLUMNS_IDENTIFIER)
        page:SetLayout(columns, frame:GetColumns())
        columns:AddNestedTag(courseContents)
        columns:AddNestedTag(content)
        columns:AddNestedTag(onThisPage)

        MainContent main
        main:AddAttribute(ROLE_ATTRIBUTE, MAIN_ROLE)
        main:SetIdentifier(MAIN_IDENTIFIER)
        main:SetTabIndex(MAIN_TAB_INDEX)
        page:SetStyle(main, frame:GetMain())
        page:SetStyleFromWidth(main, constants:MEDIUM_SCREEN_WIDTH, frame:GetMainMedium())
        page:SetStyleFromWidth(main, constants:LARGE_SCREEN_WIDTH, frame:GetMainLarge())
        main:AddNestedTag(columns)

        Division outer
        page:SetLayout(outer, frame:GetOuter())
        page:SetStyle(outer, frame:GetOuterBox())
        outer:AddNestedTag(main)
        outer:AddNestedTag(GetFooter(page))

        Link skip
        page:SetStyle(skip, frame:GetSkipLink())
        page:SetStyleOnFocus(skip, frame:GetSkipLinkFocus())
        skip:SetIdentifier(SKIP_LINK_IDENTIFIER)
        skip:SetAddress("#" + CONTENT_IDENTIFIER)
        skip:AddText(SKIP_LINK_WORDS)

        QuorumLoginForm login
        QuorumNavigationBar navigation
        page:PlaceAtEnd(skip)
        page:PlaceAtEnd(login:Build(page))
        page:PlaceAtEnd(navigation:Build(page))
        page:PlaceAtEnd(outer)
        AddZoom(page)
    end

    /*
        The footer: the site's name, the copyright and funding, and a link
        to the contributors. It is the page's footer for screen readers
        (the contentinfo landmark), as PageFooter's footer element was.
    */
    private action GetFooter(WebPage page) returns Division
        Division footer
        footer:SetIdentifier(FOOTER_IDENTIFIER)
        footer:AddAttribute(ROLE_ATTRIBUTE, FOOTER_ROLE)
        page:SetStyle(footer, frame:GetFooter())
        page:SetStyleFromWidth(footer, constants:MEDIUM_SCREEN_WIDTH, frame:GetFooterMedium())

        StrongText name
        name:AddText(escaper:Escape(FOOTER_NAME))
        footer:AddNestedTag(name)
        Paragraph funding
        funding:AddText(escaper:Escape(FOOTER_FUNDING))
        Link contributors = GetLink(page, CONTRIBUTORS_WORDS, CONTRIBUTORS_ADDRESS, frame:GetFooterLink())
        funding:AddNestedTag(contributors)
        footer:AddNestedTag(funding)
        return footer
    end

    // Lets readers zoom in on the page's pictures, if it has any. Only
    // pictures with a description are marked: a decorative picture has
    // nothing to say when zoomed.
    private action AddZoom(WebPage page)
        Array<Image> pictures = page:GetImages()
        boolean any = false
        integer i = 0
        repeat while i < pictures:GetSize()
            Image picture = pictures:Get(i)
            if picture:GetAlternate() not= undefined
                if not picture:GetAlternate():GetValue():IsEmpty()
                    picture:AddAttribute(ZOOM_ATTRIBUTE, ARIA_TRUE)
                    any = true
                end
            end
            i = i + 1
        end
        if not any
            return now
        end

        Script zoomScript
        zoomScript:SetCode(ZOOM_SCRIPT)
        page:PlaceAtEnd(zoomScript)
    end

    // The left column for one course: its name, then its lessons, with
    // this page marked. Hidden unless it is the course shown first.
    private action GetCourseContents(WebPage page, PageSeries course, boolean shown) returns NavigationDivision
        NavigationDivision navigation
        navigation:AddAttribute(LABEL_ATTRIBUTE, course:GetName())
        MarkForCourse(navigation, course, shown)

        Paragraph name
        page:SetStyle(name, frame:GetContentsName())
        navigation:AddNestedTag(name)
        WriterFor(name, page):Link(course:GetName(), GetCourseAddress(course:GetOverviewLocation(), course))

        UnorderedList list
        page:SetLayout(list, frame:GetContentsList())
        navigation:AddNestedTag(list)
        integer i = 0
        repeat while i < course:GetSize()
            PageSeriesEntry entry = course:GetEntry(i)
            ListItem item
            page:SetStyle(item, frame:GetContentsItem())
            page:SetStyleOnHover(item, frame:GetContentsItemHover())
            list:AddNestedTag(item)
            Link link
            page:SetStyle(link, frame:GetContentsLink())
            link:SetAddress(escaper:EscapeAttribute(GetCourseAddress(entry:GetLocation(), course)))
            link:AddText(escaper:Escape(entry:GetTitle()))
            if entry:GetLocation() = page:GetLocation()
                page:SetStyle(link, frame:GetContentsCurrentLink())
                link:AddAttribute(CURRENT_ATTRIBUTE, CURRENT_PAGE)
            end
            item:AddNestedTag(link)
            i = i + 1
        end
        return navigation
    end

    // The right column: links to the page's sections and subsections.
    private action GetOnThisPage(WebPage page) returns NavigationDivision
        NavigationDivision navigation
        navigation:AddAttribute(LABEL_ATTRIBUTE, ON_THIS_PAGE_WORDS)

        Paragraph name
        page:SetStyle(name, frame:GetContentsName())
        name:AddText(ON_THIS_PAGE_WORDS)
        navigation:AddNestedTag(name)

        UnorderedList list
        page:SetLayout(list, frame:GetContentsList())
        navigation:AddNestedTag(list)
        Array<Heading> headings = page:GetHeadings()
        integer i = 0
        repeat while i < headings:GetSize()
            Heading heading = headings:Get(i)
            text words = page:GetHeadingText(heading)
            integer level = heading:GetScale()
            if not words:IsEmpty() and level >= 2 and level <= 3
                ListItem item
                if level = 3
                    page:SetStyle(item, frame:GetContentsIndentedItem())
                else
                    page:SetStyle(item, frame:GetContentsItem())
                end
                page:SetStyleOnHover(item, frame:GetContentsItemHover())
                list:AddNestedTag(item)
                Link link
                page:SetStyle(link, frame:GetContentsLink())
                link:SetAddress("#" + heading:GetIdentifier():GetValue())
                link:AddText(escaper:Escape(words))
                item:AddNestedTag(link)
            end
            i = i + 1
        end
        return navigation
    end

    // Tells the page's code where its data files are, as Lesson does.
    private action GetLocateFilesScript returns text
        text quote = ""
        quote = quote:GetDoubleQuote()
        return "var Module = {locateFile: function(path, prefix) {if (path.endsWith(" + quote + ".data" + quote + ")) return " + quote + locations:FromSiteTop(SCRIPTS_FOLDER) + quote + " + path; return prefix + path;}};"
    end

    private action AddStructuredDataScript(WebPage page, JavaScriptObjectNotation data)
        Script script
        script:SetGenerateType(false)
        script:SetType(STRUCTURED_DATA_TYPE)
        script:SetCode(data:ToText())
        page:GetWebPageHeader():Add(script)
    end
end
