package Libraries.Web.Page.Standards

use Libraries.Web.Page.WebPage2
use Libraries.Web.Page.WebTag

/*
    StandardsListEntry remembers one standards list waiting to be filled
    in: the page it is on, the list, and the set of standards it shows.
    The StandardsTracker keeps these and fills them in once every page is
    set up. People making pages don't use it directly.
*/
class StandardsListEntry
    WebPage2 page = undefined
    WebTag list = undefined
    StandardSet set = undefined

    /*
        Sets the page, the list and the set.

        Attribute: Parameter page The page the list is on.
        Attribute: Parameter list The list to fill in.
        Attribute: Parameter set The set of standards it shows.
    */
    action Setup(WebPage2 page, WebTag list, StandardSet set)
        me:page = page
        me:list = list
        me:set = set
    end

    action GetPage returns WebPage2
        return page
    end

    action GetList returns WebTag
        return list
    end

    action GetSet returns StandardSet
        return set
    end
end
