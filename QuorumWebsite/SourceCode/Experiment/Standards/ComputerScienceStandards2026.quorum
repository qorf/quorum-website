    on create
        SetName("2026 CSTA K–12 Computer Science Standards")
        SetAddress("https://csteachers.org/pk12standards/view/")
        SetReportLocation("standards/CSTA2026.html")

        Add(KINDERGARTEN_ALGORITHMIC_PROBLEM_SOLVING_1, "Carry out algorithms in daily activities.", "PK/Kindergarten", "Algorithms & Design", "Algorithmic Problem Solving")
        Add(GRADE_1_ALGORITHMIC_PROBLEM_SOLVING_1, "Decompose a problem or task into individual parts to develop an algorithm.", "Grade 1", "Algorithms & Design", "Algorithmic Problem Solving")
        Add(GRADE_2_ALGORITHMIC_PROBLEM_SOLVING_1, "Create an algorithm that includes sequence, events, and iteration to solve a problem or express an idea.", "Grade 2", "Algorithms & Design", "Algorithmic Problem Solving")
        Add(GRADE_3_ALGORITHMIC_PROBLEM_SOLVING_1, "Create an algorithm that includes a combination of sequence, events, iteration, and selection to solve a problem or express an idea.", "Grade 3", "Algorithms & Design", "Algorithmic Problem Solving")
        Add(GRADE_4_ALGORITHMIC_PROBLEM_SOLVING_1, "Create a written representation of an algorithm that includes a combination of sequence, events, iteration, and selection to solve a problem or express an idea.", "Grade 4", "Algorithms & Design", "Algorithmic Problem Solving")
        Add(GRADE_5_ALGORITHMIC_PROBLEM_SOLVING_1, "Create a visual representation of an algorithm that includes variables and a combination of sequence, events, iteration, and selection to solve a problem or express an idea.", "Grade 5", "Algorithms & Design", "Algorithmic Problem Solving")
        Add(MIDDLE_SCHOOL_ALGORITHMIC_PROBLEM_SOLVING_1, "Design an algorithm that includes variables of multiple data types to solve a problem or express an idea.", "Middle School", "Algorithms & Design", "Algorithmic Problem Solving")
        Add(MIDDLE_SCHOOL_ALGORITHMIC_PROBLEM_SOLVING_2, "Model a given algorithm with a flowchart or pseudocode that includes a combination of control structures and procedures.", "Middle School", "Algorithms & Design", "Algorithmic Problem Solving")
        Add(MIDDLE_SCHOOL_ALGORITHMIC_PROBLEM_SOLVING_3, "Verify the accuracy of an algorithm for given inputs.", "Middle School", "Algorithms & Design", "Algorithmic Problem Solving")
        Add(MIDDLE_SCHOOL_ALGORITHMIC_PROBLEM_SOLVING_4, "Justify whether a problem is best solved using procedural instructions, rule-based logic, data-driven methods, or a combination of these approaches.", "Middle School", "Algorithms & Design", "Algorithmic Problem Solving")
        Add(MIDDLE_SCHOOL_ALGORITHMIC_PROBLEM_SOLVING_5, "Use an AI tool to generate outputs that assist in solving a computational problem.", "Middle School", "Algorithms & Design", "Algorithmic Problem Solving")
        Add(HIGH_SCHOOL_ALGORITHMIC_PROBLEM_SOLVING_1, "Design an algorithm using appropriate data structures to solve a problem or express an idea.", "High School", "Algorithms & Design", "Algorithmic Problem Solving")
        Add(HIGH_SCHOOL_ALGORITHMIC_PROBLEM_SOLVING_2, "Optimize the design of an algorithm using procedural abstraction and control structures.", "High School", "Algorithms & Design", "Algorithmic Problem Solving")
        Add(HIGH_SCHOOL_ALGORITHMIC_PROBLEM_SOLVING_3, "Evaluate algorithms for efficiency, correctness, and clarity, using metrics or test cases.", "High School", "Algorithms & Design", "Algorithmic Problem Solving")
        Add(HIGH_SCHOOL_ALGORITHMIC_PROBLEM_SOLVING_4, "Describe the differences between deterministic and probabilistic algorithms.", "High School", "Algorithms & Design", "Algorithmic Problem Solving")
        Add(HIGH_SCHOOL_ALGORITHMIC_PROBLEM_SOLVING_5, "Evaluate AI-generated output to assess bias, accuracy, and potential harms.", "High School", "Algorithms & Design", "Algorithmic Problem Solving")
        Add(KINDERGARTEN_MACHINE_LEARNING_2, "Recognize attributes of objects to notice patterns and make decisions.", "PK/Kindergarten", "Algorithms & Design", "Machine Learning")
        Add(GRADE_1_MACHINE_LEARNING_2, "Recognize that AI systems are technologies that use patterns in data to make decisions or generate new things.", "Grade 1", "Algorithms & Design", "Machine Learning")
        Add(GRADE_2_MACHINE_LEARNING_2, "Examine how data is used to train a machine learning model.", "Grade 2", "Algorithms & Design", "Machine Learning")
        Add(GRADE_3_MACHINE_LEARNING_2, "Investigate how a machine learning model can change when new data is added to a training set.", "Grade 3", "Algorithms & Design", "Machine Learning")
        Add(GRADE_4_MACHINE_LEARNING_2, "Analyze relationships between the properties of training data and a machine learning model's output.", "Grade 4", "Algorithms & Design", "Machine Learning")
        Add(GRADE_5_MACHINE_LEARNING_2, "Train a machine learning model to make a classification or prediction.", "Grade 5", "Algorithms & Design", "Machine Learning")
        Add(MIDDLE_SCHOOL_MACHINE_LEARNING_6, "Hypothesize how a machine learning model generates classifications or predictions.", "Middle School", "Algorithms & Design", "Machine Learning")
        Add(MIDDLE_SCHOOL_MACHINE_LEARNING_7, "Investigate ways to improve the accuracy of a machine learning model and reduce bias by refining the quality of examples and nonexamples in the training data.", "Middle School", "Algorithms & Design", "Machine Learning")
        Add(MIDDLE_SCHOOL_MACHINE_LEARNING_8, "Evaluate the features and limitations of a machine learning model.", "Middle School", "Algorithms & Design", "Machine Learning")
        Add(HIGH_SCHOOL_MACHINE_LEARNING_6, "Justify the selection of a type of AI algorithm to accomplish a task.", "High School", "Algorithms & Design", "Machine Learning")
        Add(HIGH_SCHOOL_MACHINE_LEARNING_7, "Evaluate training data by examining its source, quality, representativeness, potential biases, and privacy implications.", "High School", "Algorithms & Design", "Machine Learning")
        Add(HIGH_SCHOOL_MACHINE_LEARNING_8, "Develop a machine learning model for a chosen task using appropriate data and tools.", "High School", "Algorithms & Design", "Machine Learning")
        Add(KINDERGARTEN_IMPACTS_OF_ALGORITHMS_AND_DESIGN_3, "Describe how people create algorithms to solve problems.", "PK/Kindergarten", "Algorithms & Design", "Impacts of Algorithms & Design")
        Add(GRADE_1_IMPACTS_OF_ALGORITHMS_AND_DESIGN_3, "Explain how a change to an algorithm leads to a different outcome.", "Grade 1", "Algorithms & Design", "Impacts of Algorithms & Design")
        Add(GRADE_2_IMPACTS_OF_ALGORITHMS_AND_DESIGN_3, "Describe how an algorithm might impact peers in varied situations.", "Grade 2", "Algorithms & Design", "Impacts of Algorithms & Design")
        Add(GRADE_3_IMPACTS_OF_ALGORITHMS_AND_DESIGN_3, "Compare how different algorithms may affect outcomes, situations, and people with a wide range of needs.", "Grade 3", "Algorithms & Design", "Impacts of Algorithms & Design")
        Add(GRADE_4_IMPACTS_OF_ALGORITHMS_AND_DESIGN_3, "Evaluate how different algorithms for solving the same problem produce outcomes that may benefit or disadvantage different groups of people.", "Grade 4", "Algorithms & Design", "Impacts of Algorithms & Design")
        Add(GRADE_5_IMPACTS_OF_ALGORITHMS_AND_DESIGN_3, "Articulate how human-centered design principles are incorporated into the development of a computing technology.", "Grade 5", "Algorithms & Design", "Impacts of Algorithms & Design")
        Add(MIDDLE_SCHOOL_IMPACTS_OF_ALGORITHMS_AND_DESIGN_9, "Evaluate which human-centered design principles are present or missing in an existing computing technology.", "Middle School", "Algorithms & Design", "Impacts of Algorithms & Design")
        Add(MIDDLE_SCHOOL_IMPACTS_OF_ALGORITHMS_AND_DESIGN_10, "Examine evidence of beneficial and harmful impacts, ethical issues, and biases of algorithms encountered in daily life.", "Middle School", "Algorithms & Design", "Impacts of Algorithms & Design")
        Add(MIDDLE_SCHOOL_IMPACTS_OF_ALGORITHMS_AND_DESIGN_11, "Modify an algorithm to address a specific societal impact, ethical issue, or bias.", "Middle School", "Algorithms & Design", "Impacts of Algorithms & Design")
        Add(HIGH_SCHOOL_IMPACTS_OF_ALGORITHMS_AND_DESIGN_9, "Design a computing technology using human-centered design principles.", "High School", "Algorithms & Design", "Impacts of Algorithms & Design")
        Add(HIGH_SCHOOL_IMPACTS_OF_ALGORITHMS_AND_DESIGN_10, "Evaluate the ethical implications, societal impacts, and potential biases of rule-based and data-driven algorithms.", "High School", "Algorithms & Design", "Impacts of Algorithms & Design")
        Add(HIGH_SCHOOL_IMPACTS_OF_ALGORITHMS_AND_DESIGN_11, "Articulate the values embedded in the design of an algorithmic system.", "High School", "Algorithms & Design", "Impacts of Algorithms & Design")
        Add(KINDERGARTEN_PROGRAM_DEVELOPMENT_4, "Create a sequence of commands to solve a problem or express an idea.", "PK/Kindergarten", "Programming", "Program Development")
        Add(GRADE_1_PROGRAM_DEVELOPMENT_4, "Create code from an algorithm that includes sequence to solve a problem or express an idea.", "Grade 1", "Programming", "Program Development")
        Add(GRADE_2_PROGRAM_DEVELOPMENT_4, "Create code from an algorithm that includes sequence, events, and iteration to solve a problem or express an idea.", "Grade 2", "Programming", "Program Development")
        Add(GRADE_3_PROGRAM_DEVELOPMENT_4, "Develop code from a student-created algorithm that includes a combination of sequence, events, iteration, and selection to solve a problem or express an idea.", "Grade 3", "Programming", "Program Development")
        Add(GRADE_3_PROGRAM_DEVELOPMENT_5, "Use constructive feedback to improve a program.", "Grade 3", "Programming", "Program Development")
        Add(GRADE_4_PROGRAM_DEVELOPMENT_4, "Compare different programming solutions to the same problem based on correctness and clarity.", "Grade 4", "Programming", "Program Development")
        Add(GRADE_4_PROGRAM_DEVELOPMENT_5, "Collaborate with a team by offering a meaningful contribution to creating a program.", "Grade 4", "Programming", "Program Development")
        Add(GRADE_5_PROGRAM_DEVELOPMENT_4, "Create a novel program by modifying or combining elements of existing programs.", "Grade 5", "Programming", "Program Development")
        Add(GRADE_5_PROGRAM_DEVELOPMENT_5, "Construct individual components of a program that are collaboratively assembled into a programming project.", "Grade 5", "Programming", "Program Development")
        Add(MIDDLE_SCHOOL_PROGRAM_DEVELOPMENT_12, "Use a procedure to structure code for clarity and reusability.", "Middle School", "Programming", "Program Development")
        Add(MIDDLE_SCHOOL_PROGRAM_DEVELOPMENT_13, "Use reference documentation in program development.", "Middle School", "Programming", "Program Development")
        Add(MIDDLE_SCHOOL_PROGRAM_DEVELOPMENT_14, "Justify the importance of attribution and intellectual property when developing computing technologies.", "Middle School", "Programming", "Program Development")
        Add(MIDDLE_SCHOOL_PROGRAM_DEVELOPMENT_15, "Develop a program utilizing inclusive collaboration practices.", "Middle School", "Programming", "Program Development")
        Add(HIGH_SCHOOL_PROGRAM_DEVELOPMENT_12, "Create a modular program that uses procedures, external libraries, or objects to improve reusability and readability.", "High School", "Programming", "Program Development")
        Add(HIGH_SCHOOL_PROGRAM_DEVELOPMENT_13, "Use documentation, libraries, application programming interfaces (APIs), and other tools in program development.", "High School", "Programming", "Program Development")
        Add(HIGH_SCHOOL_PROGRAM_DEVELOPMENT_14, "Apply appropriate attribution of intellectual property when developing a computing technology.", "High School", "Programming", "Program Development")
        Add(HIGH_SCHOOL_PROGRAM_DEVELOPMENT_15, "Collaborate on a programming project using a defined workflow that includes design documentation and clear task roles.", "High School", "Programming", "Program Development")
        Add(KINDERGARTEN_VARIABLES_AND_DATA_STORAGE_5, "Identify everyday gestures and symbols that represent information people use to make choices.", "PK/Kindergarten", "Programming", "Variables & Data Storage")
