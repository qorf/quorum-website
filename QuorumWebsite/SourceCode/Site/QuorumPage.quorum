package Libraries.Web.Page

use Libraries.Web.Quorum.BlockEditorLooks
use Libraries.Web.Quorum.FormLooks
use Libraries.Web.Quorum.QuorumSiteOptions
use Libraries.Web.Page.WebPage
use Libraries.System.File
use Libraries.Web.Page.Division
use Libraries.Web.Page.Span
use Libraries.Web.Page.OrderedList
use Libraries.Web.Page.Details
use Libraries.Web.Page.Summary
use Libraries.Web.Series.PageSeriesEntry
use Libraries.Web.Series.PageSeries
use Libraries.Web.Page.ListItem
use Libraries.Web.Page.Link
use Libraries.Web.Page.Heading
use Libraries.Web.Page.Image
use Libraries.Web.Page.Paragraph
use Libraries.Web.Page.Header
use Libraries.Web.Page.Script
use Libraries.Web.Page.Button
use Libraries.Web.Page.UnorderedList
use Libraries.Containers.Array
use Libraries.Web.Page.NavigationDivision
use Libraries.Web.Page.Label
use Libraries.Web.Page.Input
use Libraries.Web.Page.MathML
use Libraries.Web.Page.Standards.StandardSet
use Libraries.Web.Page.Standards.StandardsTracker
use Libraries.Web.Styles.StyleSheetConstants
use Libraries.Web.Styles.WebBoxStyle
use Libraries.Web.WebLocations
use Libraries.Web.WebTextEscaper
use Libraries.Web.Page.IDE
use Libraries.Web.Page.CodeForIDE
use Libraries.Web.VersionHelper

/*
    QuorumPage is a page on the Quorum website. It is a WebPage with what
    only this site needs: recording which standards a lesson covers, and
    listing them; teaching tips and discussion goals; live code editors;
    and math. Everything general stays in WebPage.

    Attribute: Example
    use Libraries.Web.Page.Standards.ComputerScienceStandards2026

    class MyLesson is QuorumPage
        QuorumStandards standards

        on create
            SetLocation("lessons/mine.html")
        end

        action Setup
            Title("My Lesson")
            ComputerScienceStandards2026 computerScience = standards:GetComputerScience2026()
            CoversStandard(computerScience, computerScience:HIGH_SCHOOL_PROGRAM_DEVELOPMENT_12)
            Section("Standards")
            StandardsList(computerScience)
        end
    end
*/
class QuorumPage is WebPage
    // The one tracker for every page on the site (a shared class).
    StandardsTracker tracker

    // The site's look (a shared class), for its own kinds of callout.
    QuorumSiteOptions quorumOptions

    // The list LessonList started, for LessonEntry.
    OrderedList lessonList = undefined

    // The name links and lists use for this page, if not its title.
    text shortTitle = ""

    // For the series and track pages: the name of the part of the site the
    // page belongs to, and its picture there.
    text sectionName = ""
    text cardImage = ""
    text cardDescription = ""

    // Until every old Lesson is converted (plan 13, phase 7): this page's
    // neighbors in its home series, so an old page beside it can walk
    // through it for its lesson index and its "Next Tutorial".
    WebPage previousOldPage = undefined
    WebPage nextOldPage = undefined

    // The grid ProblemSets started, for ProblemSet, and how many sets it
    // has so far (each card is labelled "Set 1", "Set 2", ...).
    Division problemSetGrid = undefined
    integer problemSetCount = 0
    constant text PROBLEM_SET_LABEL = "Set "
    constant text PROBLEM_SET_START = "Start "
    constant text PROBLEM_SET_ARROW = "→"
    VersionHelper versions
    StyleSheetConstants constants
    WebLocations locations
    WebTextEscaper escaper

    // Scripts a page loads once, only if it uses them.
    boolean editorScriptAdded = false
    boolean mathScriptAdded = false
    boolean chartsScriptAdded = false
    boolean slidesScriptAdded = false
    boolean blockEditorAdded = false
    boolean accessChartsAdded = false

    // The words column PictureBeside made last, which PictureBesideLink
    // adds to, and how many it made (so the picture's side alternates).
    Division pictureWordsColumn = undefined
    integer pictureRowCount = 0

    // The grid PictureGrid started, which GridPicture adds to.
    Division pictureGrid = undefined

    // The grid TopicCards started, which TopicCard adds to.
    Division topicGrid = undefined
    boolean topicScriptAdded = false

    // The banner's words column, its picture, and the row under its words
    // for tiles and links (made by the first).
    Division bannerColumn = undefined
    Image bannerPicture = undefined
    Division bannerActions = undefined
    // Whether the banner is a product banner (ProductBanner), whose tile
    // and link take the product look.
    boolean productBanner = false
    // Whether the banner is a hero banner (HeroBanner), whose tiles are
    // white pills.
    boolean heroBanner = false
    // The switcher Switcher started: its button bar and its panels.
    Division switcherButtons = undefined
    Division switcherPanels = undefined
    integer switcherCount = 0
    boolean switcherScriptAdded = false

    // The form being written (Form or Quiz, until EndForm), the quiz
    // script, and how many questions the quiz has so far.
    Form currentForm = undefined
    Division currentDialog = undefined
    boolean quizScriptAdded = false
    integer quizQuestions = 0
    Select quizSelect = undefined

    // The row of steps being written (Steps), and the block editor's
    // files after its main one (BlockEditorFile).
    OrderedList stepsList = undefined
    // The numbered rows being written (NumberedRows), and how many so far.
    OrderedList numberedRowsList = undefined
    integer numberedRowsCount = 0
    integer stepsCount = 0
    Array<text> blockEditorFileNames
    Array<text> blockEditorFileLocations
    boolean blockProjectMode = false
    // The notice strip NoticeStrip made last, which NoticeButton adds to.
    Division noticeActions = undefined
    // Whether CourseCards was started as FeatureCards (grey lower halves).
    boolean greyCardBodies = false

    // The grid Choices started, which Choice adds to.
    Division choiceGrid = undefined

    // The grid CourseCards started, the card CourseCard added last, and its
    // "Details", which CourseDetail adds to (made by the first detail).
    Division courseGrid = undefined
    Division courseBody = undefined
    Division courseDetails = undefined

    // The heading level of a track page's unit cards: 0 before the first,
    // then 2 (sections) or 3 (subsections), chosen by the first.
    integer unitCardLevel = 0
    integer editorCount = 0

    // The editor CodeEditorFromProject(title) started, and its files, which
    // EditorFileFromProject adds to.
    IDE currentEditor = undefined
    CodeForIDE currentEditorFiles = undefined

    constant text TEACHING_TIP = "Teaching Tip"
    constant text GOALS_LABEL = "By the end of this lesson, you can"
    constant text DISCUSSION_GOAL = "Discussion Goal"
    constant text EDITOR_IDENTIFIER_START = "editor-"
    constant text EDITOR_FILE_NAME = "Main.quorum"
    constant text EDITOR_SCRIPT_START = "script/widgets/widget-js/IDE-"
    constant text SCRIPT_ENDING = ".js"
    constant text MATH_SCRIPT = "script/load-mathjax.js"
    constant text CHARTS_SCRIPT = "script/quorumCharts.js"
    constant text SLIDES_SCRIPT = "script/slides.js"
    constant text SWITCHER_SCRIPT = "script/switcher.js"
    constant text QUIZ_SCRIPT = "script/quiz.js"
    constant text QUIZ_PROMPT = "Choose an option"
    // A dialog's close button: a cross, as the old dialogs had.
    constant text CLOSE_ICON = "html/media/userInterface/SVG/exit-cross.svg"
    // The arrow between steps (Step), from the project's icons, hidden
    // from screen readers.
    constant text STEP_ARROW_ICON = "stepArrow.svg"
    constant text BLOCK_EDITOR_SCRIPT = "script/blockEditor.js"
    constant text ACCESS_CHARTS_SCRIPT_START = "script/widgets/widget-js/AccessCharts-"
    constant text BLOCK_EDITOR_ICONS = "icons/"
    constant text PREVIOUS_SLIDE = "Previous Slide"
    constant text UNIT_LESSONS = "Lessons"
    constant text COURSE_DETAILS = "Details"
    constant text TOPIC_SCRIPT = "script/topicSearch.js"
    constant text TOPIC_SEARCH_IDENTIFIER = "topic-search"
    constant text TOPIC_CLEAR = "Clear"
    constant text TOPICS_LABEL = "Topics"
    constant text LESSON_SEPARATOR = " · "
    // The letters a heading's address keeps, as WebPage names headings
    // (a child class can't see its parent's constants).
    constant text ADDRESS_CHARACTERS = "abcdefghijklmnopqrstuvwxyz0123456789"
    constant text NEXT_SLIDE = "Next Slide"
    constant text EDITOR_CODE_ATTRIBUTE = "data-code-for-ide"

    // The code highlighter's JSON grammar, from the same release Lesson
    // uses, added to a page once if it shows JSON.
    constant text JSON_HIGHLIGHTER = "https://cdnjs.cloudflare.com/ajax/libs/prism/1.29.0/components/prism-json.min.js"
    constant text JSON = "json"
    boolean jsonScriptAdded = false

    /*
        Records that this page covers a standard. It writes nothing on the
        page; the site's tracker remembers it, and StandardsList shows it.
        Use the set's constants for identifiers, so a mistyped one fails
        to compile.

        Attribute: Parameter set The set the standard belongs to.
        Attribute: Parameter identifier The standard's identifier.
    */
    action CoversStandard(StandardSet set, text identifier)
        tracker:Record(me, set:GetStandard(identifier))
    end

    /*
        Adds the standards from one set that this page covers, for
        teachers: a label, a card for each standard (its identifier,
        linked to the set's report; its level and concept; its words; and
        how many other lessons cover it), and a link to every standard.
        The site fills it in once every page is set up, so it doesn't
        matter whether it comes before or after the CoversStandard calls.

        Attribute: Parameter set The set to list.
    */
    /*
        Starts the lesson's goals: a bulleted list in a box, labeled "By
        the end of this lesson, you can". Add each goal with ListItem,
        starting with what the reader will do, such as "Explain".

        Attribute: Example
        class MyLesson is QuorumPage
            action Setup
                Subsection("Goals")
                Goals()
                ListItem("Explain what a scene editor is.")
            end
        end
    */
    action Goals
        BulletList(GOALS_LABEL, quorumOptions:GetGoals(), quorumOptions:GetGoalsLabel())
    end

    /*
        Opens a teaching tip: advice for teachers, in a box with a dark
        blue label. Everything added after it goes inside, until the next
        part starts or EndCallout is called.

        Attribute: Example
        class MyLesson is QuorumPage
            action Setup
                Section("Engage")
                TeachingTip()
                Paragraph("Pairs work best for this activity.")
                EndCallout()
            end
        end
    */
    action TeachingTip
        Callout(TEACHING_TIP, quorumOptions:GetTeachingTipLabel())
    end

    /*
        Opens a discussion goal: what a class discussion should reach, in
        a box with a dark blue label, as teaching tips have. Everything added after it goes inside,
        until the next part starts or EndCallout is called.
    */
    action DiscussionGoal
        Callout(DISCUSSION_GOAL, quorumOptions:GetDiscussionGoalLabel())
    end

    /*
        Sets the part just started (a section, subsection and so on) apart
        as a card, with a border and room inside, such as one release in
        the release notes.

        Attribute: Example
        class MyPage is QuorumPage
            action Setup
                Section("2026")
                Subsection("Quorum 14.0")
                Card()
            end
        end
    */
    action Card
        SetStyle(GetCurrentPart(), quorumOptions:GetCard())
    end

    /*
        Sets a shorter name for the page, which its course's lists,
        breadcrumbs and "Up next" show; the page's heading stays its
        title. For a lesson titled "Hour 8: Loops" listed in its course
        as "Loops Online".

        Attribute: Parameter value The short name.
    */
    action SetShortTitle(text value)
        shortTitle = value
    end

    /*
        Returns the name links to this page show: its short title, if it
        has one, or else its title.

        Attribute: Returns The page's name for links.
    */
    action GetTitleText returns text
        if not shortTitle:IsEmpty()
            return shortTitle
        end
        return parent:WebPage:GetTitleText()
    end

    /*
        Sets the name of the part of the site this page belongs to, such as
        "Quorum Basics" or "Types and Variables". A series that starts with
        this page takes it as its name.

        Attribute: Parameter value The name.
    */
    action SetSectionName(text value)
        sectionName = value
    end

    /*
        Returns the name set with SetSectionName, or nothing.

        Attribute: Returns The name.
    */
    action GetSectionName returns text
        return sectionName
    end

    /*
        Sets the picture that stands for this page where pages are shown as
        cards, from the site's top, such as "/media/basics/actions.png". A
        series that starts with this page takes it as its picture.

        Attribute: Parameter location The picture's location.
    */
    action SetCardImage(text location)
        cardImage = location
    end

    /*
        Returns the picture set with SetCardImage, or nothing.

        Attribute: Returns The picture's location.
    */
    action GetCardImage returns text
        return cardImage
    end

    /*
        Sets the words a card for this page shows, such as the one-line
        summary of a unit on a course page whose first page this is.

        Attribute: Parameter value The words.
    */
    action SetCardDescription(text value)
        cardDescription = value
    end

    /*
        Returns the words set with SetCardDescription, or nothing.

        Attribute: Returns The words.
    */
    action GetCardDescription returns text
        return cardDescription
    end

    // Until every old Lesson is converted (plan 13, phase 7): the page
    // before and after this one in its home series, for the old pages.
    action SetPreviousOldPage(WebPage page)
        previousOldPage = page
    end

    action GetPreviousOldPage returns WebPage
        return previousOldPage
    end

    action SetNextOldPage(WebPage page)
        nextOldPage = page
    end

    action GetNextOldPage returns WebPage
        return nextOldPage
    end

    /*
        Starts the page with a banner: the page's title, with words and a
        picture beside it, in a white box with a yellow bar on its left, as
        the track pages have. The title is the page's title (as Title).

        Attribute: Parameter title The page's title.
        Attribute: Parameter words A sentence or two under the title.
        Attribute: Parameter picture The picture's location, from the top of the site.
        Attribute: Parameter pictureDescription What the picture shows, for readers who can't see it.

        Attribute: Example
        class MyTrack is QuorumPage
            action Setup
                Banner("Quorum Blocks Online Programming Track", "A professional development workshop ...", "media/userInterface/quorumAssets/BlocksOnline.png", "An image showing block language blocks in various sizes")
            end
        end
    */
    action Banner(text title, text words, text picture, text pictureDescription)
        Title(title)
        Header header = GetTitleHeader()
        SetStyle(header, quorumOptions:GetBanner())

        // Stacked on phones and tablets; from a large screen up, the picture
        // beside the words. (The page's middle column is narrow on a tablet,
        // beside "On this page". A row that may wrap can't be told not to
        // from a width, so the narrow layout is a stack, not a wrapping row.)
        Division row
        SetLayout(row, quorumOptions:GetPictureStack())
        SetLayoutFromWidth(row, constants:LARGE_SCREEN_WIDTH, quorumOptions:GetBannerLayoutWide())
        // The words in a column of their own, so BannerChoice and BannerLink
        // can add under them.
        Division column
        SetStyle(column, quorumOptions:GetPictureWords())
        SetLayout(column, quorumOptions:GetPictureStack())
        Paragraph paragraph
        SetStyle(paragraph, quorumOptions:GetBannerWords())
        paragraph:AddText(escaper:Escape(words))
        column:AddNestedTag(paragraph)
        row:AddNestedTag(column)

        Image image
        image:SetAddress(escaper:EscapeAttribute(locations:FromSiteTop(locations:Join(GetWebSite():GetRelativeFolder(), picture))))
        image:SetAlternate(escaper:EscapeAttribute(pictureDescription))
        SetStyle(image, quorumOptions:GetBannerPicture())
        row:AddNestedTag(image)
        header:AddNestedTag(row)
        bannerColumn = column
        bannerPicture = image
        bannerActions = undefined
        productBanner = false
        heroBanner = false
    end

    /*
        Starts the page with its title in a band of color across the
        window: the title and a sentence or two beside a picture, the
        picture on the left on a phone. Give the page UseEdgeToEdgeBanner (or
        UseFullBleedBanner) on the site, so the band spans the window.
        The title is the page's title (as Title).

        Attribute: Parameter title The page's title.
        Attribute: Parameter words A sentence or two beside the title.
        Attribute: Parameter picture The picture's location, from the top of the site.
        Attribute: Parameter pictureDescription What the picture shows, for readers who can't see it.
    */
    action ColorBanner(text title, text words, text picture, text pictureDescription)
        Title(title)
        Header header = GetTitleHeader()
        SetStyle(header, quorumOptions:GetColorBanner())
        SetStyleFromWidth(header, constants:LARGE_SCREEN_WIDTH, quorumOptions:GetColorBannerWide())
        Heading heading = GetLastHeading()
        SetStyle(heading, quorumOptions:GetColorBannerTitle())
        SetStyleFromWidth(heading, constants:MEDIUM_SCREEN_WIDTH, quorumOptions:GetColorBannerTitleWide())
        // The title goes in the words' column, beside the picture.
        header:Remove(heading)

        // On a phone the picture is on the left (the row shown reversed,
        // since the words come first in the page); from a medium screen,
        // on the right.
        Division row
        SetLayout(row, quorumOptions:GetColorBannerRowSmall())
        SetLayoutFromWidth(row, constants:MEDIUM_SCREEN_WIDTH, quorumOptions:GetColorBannerRow())
        Division column
        SetStyle(column, quorumOptions:GetColorBannerColumn())
        SetStyleFromWidth(column, constants:MEDIUM_SCREEN_WIDTH, quorumOptions:GetColorBannerColumnWide())
        SetLayout(column, quorumOptions:GetColorBannerStack())
        column:AddNestedTag(heading)
        Paragraph paragraph
        SetStyle(paragraph, quorumOptions:GetColorBannerWords())
        SetStyleFromWidth(paragraph, constants:MEDIUM_SCREEN_WIDTH, quorumOptions:GetColorBannerWordsWide())
        paragraph:AddText(escaper:Escape(words))
        column:AddNestedTag(paragraph)
        row:AddNestedTag(column)

        Image image
        image:SetAddress(escaper:EscapeAttribute(locations:FromSiteTop(locations:Join(GetWebSite():GetRelativeFolder(), picture))))
        image:SetAlternate(escaper:EscapeAttribute(pictureDescription))
        SetStyle(image, quorumOptions:GetColorBannerPicture())
        SetStyleFromWidth(image, constants:MEDIUM_SCREEN_WIDTH, quorumOptions:GetColorBannerPictureWide())
        row:AddNestedTag(image)
        header:AddNestedTag(row)
        bannerColumn = column
        bannerPicture = image
        bannerActions = undefined
        productBanner = false
        heroBanner = false
    end

    /*
        Adds a product banner, as the Download page has: a grey band with
        the title and words in a third of it and a large screenshot in the
        other two thirds, from a large screen up (stacked below that). Add
        a button and a link under the words with BannerChoice and
        BannerLink, which take the product look: a full-width button in the
        site's button blue and a bold underlined link.

        Attribute: Parameter title The page's title.
        Attribute: Parameter words The words under it.
        Attribute: Parameter picture The screenshot's location inside the relative folder.
        Attribute: Parameter pictureDescription What it shows.
    */
    action ProductBanner(text title, text words, text picture, text pictureDescription)
        Title(title)
        Header header = GetTitleHeader()
        SetStyle(header, quorumOptions:GetProductBanner())
        SetStyleFromWidth(header, constants:LARGE_SCREEN_WIDTH, quorumOptions:GetProductBannerWide())
        Heading heading = GetLastHeading()
        SetStyle(heading, quorumOptions:GetProductTitle())
        // The title goes in the words' column, as the old banner had it.
        header:Remove(heading)

        Division row
        SetLayout(row, quorumOptions:GetProductStack())
        SetLayoutFromWidth(row, constants:LARGE_SCREEN_WIDTH, quorumOptions:GetProductRow())
        Division column
        SetStyle(column, quorumOptions:GetProductWords())
        SetStyleFromWidth(column, constants:LARGE_SCREEN_WIDTH, quorumOptions:GetProductWordsWide())
        SetLayout(column, quorumOptions:GetProductStack())
        column:AddNestedTag(heading)
        Paragraph paragraph
        SetStyle(paragraph, quorumOptions:GetProductTagline())
        paragraph:AddText(escaper:Escape(words))
        column:AddNestedTag(paragraph)
        row:AddNestedTag(column)

        Image image
        image:SetAddress(escaper:EscapeAttribute(locations:FromSiteTop(locations:Join(GetWebSite():GetRelativeFolder(), picture))))
        image:SetAlternate(escaper:EscapeAttribute(pictureDescription))
        SetStyleFromWidth(image, constants:LARGE_SCREEN_WIDTH, quorumOptions:GetProductPictureWide())
        row:AddNestedTag(image)
        header:AddNestedTag(row)
        bannerColumn = column
        bannerPicture = image
        bannerActions = undefined
        productBanner = true
        heroBanner = false
    end

    /*
        Adds a hero banner, as the home page has: a light blue band with a
        logo beside the title, a line of words (written with the writer this
        returns, so it can hold a link), and a picture, side by side from a
        large screen up (stacked below that). Add buttons under the words
        with BannerChoice: white pills.

        Attribute: Parameter title The page's title, beside the logo.
        Attribute: Parameter logo The logo's location inside the relative folder.
        Attribute: Parameter logoDescription What the logo is.
        Attribute: Parameter picture The picture's location inside the relative folder.
        Attribute: Parameter pictureDescription What it shows.
        Attribute: Returns A writer for the words under the title.
    */
    action HeroBanner(text title, text logo, text logoDescription, text picture, text pictureDescription) returns RichText
        Title(title)
        Header header = GetTitleHeader()
        SetStyle(header, quorumOptions:GetHeroBanner())
        SetStyleFromWidth(header, constants:LARGE_SCREEN_WIDTH, quorumOptions:GetHeroBannerWide())
        Heading heading = GetLastHeading()
        SetStyle(heading, quorumOptions:GetHeroTitle())
        header:Remove(heading)

        Division row
        SetLayout(row, quorumOptions:GetProductStack())
        SetLayoutFromWidth(row, constants:LARGE_SCREEN_WIDTH, quorumOptions:GetProductRow())
        Division column
        SetLayout(column, quorumOptions:GetProductStack())
        Division logoRow
        SetLayout(logoRow, quorumOptions:GetHeroLogoRow())
        Image logoImage
        logoImage:SetAddress(escaper:EscapeAttribute(locations:FromSiteTop(locations:Join(GetWebSite():GetRelativeFolder(), logo))))
        logoImage:SetAlternate(escaper:EscapeAttribute(logoDescription))
        SetStyle(logoImage, quorumOptions:GetHeroLogo())
        logoRow:AddNestedTag(logoImage)
        logoRow:AddNestedTag(heading)
        column:AddNestedTag(logoRow)
        Paragraph paragraph
        SetStyle(paragraph, quorumOptions:GetHeroWordsBox())
        column:AddNestedTag(paragraph)
        row:AddNestedTag(column)

        Image image
        image:SetAddress(escaper:EscapeAttribute(locations:FromSiteTop(locations:Join(GetWebSite():GetRelativeFolder(), picture))))
        image:SetAlternate(escaper:EscapeAttribute(pictureDescription))
        SetStyle(image, quorumOptions:GetHeroPicture())
        row:AddNestedTag(image)
        header:AddNestedTag(row)
        bannerColumn = column
        bannerPicture = image
        bannerActions = undefined
        productBanner = false
        heroBanner = true
        return NewWriter(paragraph)
    end

    /*
        Starts a switcher, as the home page's "Accessible, Friendly,
        Proven": a bar of buttons, each showing one panel (a heading, its
        words and a picture). Its script makes the buttons tabs that the
        keyboard can move between; without it, every panel shows. Add each
        panel with SwitcherItem.
    */
    action Switcher
        if not switcherScriptAdded
            AddScript(locations:FromSiteTop(SWITCHER_SCRIPT))
            switcherScriptAdded = true
        end
        Division switcher
        switcher:AddAttribute("data-switcher", "")
        SetLayout(switcher, quorumOptions:GetSwitcherLayout())
        Division bar
        bar:AddAttribute("data-switcher-tabs", "")
        SetStyle(bar, quorumOptions:GetSwitcherBarBox())
        SetLayout(bar, quorumOptions:GetSwitcherBar())
        Division barRow
        SetLayout(barRow, quorumOptions:GetCenteredRow())
        barRow:AddNestedTag(bar)
        switcher:AddNestedTag(barRow)
        Division panels
        SetLayout(panels, quorumOptions:GetSwitcherLayout())
        switcher:AddNestedTag(panels)
        Include(switcher)
        switcherButtons = bar
        switcherPanels = panels
        switcherCount = 0
    end

    /*
        Adds a panel to the switcher Switcher started, and its button.

        Attribute: Parameter button The button's words, such as "Accessible".
        Attribute: Parameter title The panel's heading.
        Attribute: Parameter words The panel's words.
        Attribute: Parameter picture The panel's picture, inside the relative folder.
        Attribute: Parameter pictureDescription What the picture shows.
    */
    action SwitcherItem(text button, text title, text words, text picture, text pictureDescription)
        if switcherPanels = undefined
            alert("A switcher item needs a switcher. Start one with Switcher.")
        end
        switcherCount = switcherCount + 1
        Button tab
        tab:SetType("button")
        tab:AddAttribute("data-switcher-tab", "")
        tab:AddText(escaper:Escape(button))
        SetStyle(tab, quorumOptions:GetSwitcherButton())
        // The script marks the chosen tab with aria-selected.
        SetStyleWhenSelected(tab, quorumOptions:GetSwitcherButtonChosen())
        switcherButtons:AddNestedTag(tab)

        Division panel
        panel:AddAttribute("data-switcher-panel", "")
        SetLayout(panel, quorumOptions:GetPictureStack())
        SetLayoutFromWidth(panel, constants:SMALL_SCREEN_WIDTH, quorumOptions:GetPictureRow())
        Division info
        SetStyle(info, quorumOptions:GetSwitcherInfo())
        SetStyleFromWidth(info, constants:SMALL_SCREEN_WIDTH, quorumOptions:GetSwitcherInfoWide())
        SetLayout(info, quorumOptions:GetPictureStack())
        Heading heading
        heading:SetScale(2)
        SetStyle(heading, quorumOptions:GetSwitcherHeading())
        heading:AddText(escaper:Escape(title))
        info:AddNestedTag(heading)
        Paragraph paragraph
        paragraph:AddText(escaper:Escape(words))
        info:AddNestedTag(paragraph)
        Image image
        image:SetAddress(escaper:EscapeAttribute(locations:FromSiteTop(locations:Join(GetWebSite():GetRelativeFolder(), picture))))
        image:SetAlternate(escaper:EscapeAttribute(pictureDescription))
        SetStyle(image, quorumOptions:GetSwitcherPicture())
        // The second panel has its picture on the left, as the old page.
        Division centered
        SetLayout(centered, quorumOptions:GetCenteredRow())
        if switcherCount mod 2 = 0
            panel:AddNestedTag(image)
            panel:AddNestedTag(info)
        else
            panel:AddNestedTag(info)
            panel:AddNestedTag(image)
        end
        centered:AddNestedTag(panel)
        switcherPanels:AddNestedTag(centered)
    end

    /*
        Starts a section whose words are centered under a large heading,
        as the home page's sections: Section, in the home page's look.

        Attribute: Parameter title The section's heading.
    */
    action CenteredSection(text title)
        Section(title)
        SetStyle(GetLastHeading(), quorumOptions:GetHomeHeading())
        SetStyle(GetCurrentPart(), quorumOptions:GetHomeSection())
    end

    /*
        Adds words centered in a narrower column (three fifths of the width
        from a small screen up), as the home page's sections have. Returns a
        writer for them.

        Attribute: Parameter words The words.
        Attribute: Returns A writer for the paragraph.
    */
    action NarrowParagraph(text words) returns RichText
        Division row
        SetLayout(row, quorumOptions:GetCenteredRow())
        Paragraph paragraph
        SetStyle(paragraph, quorumOptions:GetNarrowWords())
        SetStyleFromWidth(paragraph, constants:SMALL_SCREEN_WIDTH, quorumOptions:GetNarrowWordsWide())
        row:AddNestedTag(paragraph)
        Include(row)
        return NewWriter(paragraph):Text(words)
    end

    /*
        Adds a centered link as an outlined pill, such as "Go to Access
        Charts".

        Attribute: Parameter words The link's words.
        Attribute: Parameter address Where it goes.
    */
    action OutlineButton(text words, text address)
        IncludeCenteredPill(words, address, quorumOptions:GetOutlinePill())
    end

    /*
        Adds a centered link as a black pill with white words, such as
        "Learn about EPIQ".

        Attribute: Parameter words The link's words.
        Attribute: Parameter address Where it goes.
    */
    action DarkButton(text words, text address)
        IncludeCenteredPill(words, address, quorumOptions:GetDarkPill())
    end

    // A writer for words in an element of a part this page builds itself.
    private action NewWriter(WebTag target) returns RichText
        RichText writer
        writer:SetTarget(target, me)
        return writer
    end

    private action IncludeCenteredPill(text words, text address, WebBoxStyle look)
        Division row
        SetLayout(row, quorumOptions:GetCenteredRow())
        Link link
        link:SetAddress(escaper:EscapeAttribute(address))
        link:AddText(escaper:Escape(words))
        SetStyle(link, look)
        row:AddNestedTag(link)
        Include(row)
    end

    /*
        Adds a notice strip, as the home page's Discord invitation: a
        rounded light blue box with a picture (from a medium screen up), a
        heading and words, and buttons on the right (NoticeButton).

        Attribute: Parameter picture The picture's location inside the relative folder.
        Attribute: Parameter pictureDescription What it shows.
        Attribute: Parameter title The strip's heading.
        Attribute: Parameter words Its words.
    */
    action NoticeStrip(text picture, text pictureDescription, text title, text words)
        Division strip
        SetStyle(strip, quorumOptions:GetNotice())
        SetLayout(strip, quorumOptions:GetPictureStack())
        SetLayoutFromWidth(strip, constants:MEDIUM_SCREEN_WIDTH, quorumOptions:GetPictureRow())
        Division left
        SetStyle(left, quorumOptions:GetNoticeWords())
        SetLayout(left, quorumOptions:GetHeroLogoRow())
        Image image
        image:SetAddress(escaper:EscapeAttribute(locations:FromSiteTop(locations:Join(GetWebSite():GetRelativeFolder(), picture))))
        image:SetAlternate(escaper:EscapeAttribute(pictureDescription))
        SetStyle(image, quorumOptions:GetNoticePicture())
        SetStyleFromWidth(image, constants:MEDIUM_SCREEN_WIDTH, quorumOptions:GetNoticePictureWide())
        left:AddNestedTag(image)
        Division column
        SetLayout(column, quorumOptions:GetPictureStack())
        // One level under the part it is in.
        integer level = 3
        if GetCurrentPart() = undefined
            level = 2
        end
        Heading heading
        heading:SetScale(level)
        SetStyle(heading, quorumOptions:GetNoticeHeading())
        heading:AddText(escaper:Escape(title))
        column:AddNestedTag(heading)
        Paragraph paragraph
        paragraph:AddText(escaper:Escape(words))
        column:AddNestedTag(paragraph)
        left:AddNestedTag(column)
        strip:AddNestedTag(left)
        Division actions
        SetLayout(actions, quorumOptions:GetBannerActions())
        strip:AddNestedTag(actions)
        Include(strip)
        noticeActions = actions
    end

    /*
        Adds a button to the notice strip NoticeStrip made last: an
        outlined pill, such as "Join Now".

        Attribute: Parameter words The button's words.
        Attribute: Parameter address Where it goes.
    */
    action NoticeButton(text words, text address)
        if noticeActions = undefined
            alert("A notice button needs a notice strip. Add one first with NoticeStrip.")
        end
        Link link
        link:SetAddress(escaper:EscapeAttribute(address))
        link:AddText(escaper:Escape(words))
        SetStyle(link, quorumOptions:GetOutlinePill())
        noticeActions:AddNestedTag(link)
    end

    /*
        Adds a feature card, as the Download page shows off a new feature:
        a black card with its name and words in white in a quarter of it
        and a large screenshot in the rest, from a large screen up (stacked
        below that).

        Attribute: Parameter title The feature's name (a heading).
        Attribute: Parameter words Its words.
        Attribute: Parameter picture The screenshot's location inside the relative folder.
        Attribute: Parameter pictureDescription What it shows.
    */
    action FeatureCard(text title, text words, text picture, text pictureDescription)
        Division card
        SetStyle(card, quorumOptions:GetFeatureCard())
        SetLayout(card, quorumOptions:GetPictureStack())
        SetLayoutFromWidth(card, constants:LARGE_SCREEN_WIDTH, quorumOptions:GetPictureRow())

        Division column
        SetStyle(column, quorumOptions:GetFeatureCardText())
        SetStyleFromWidth(column, constants:LARGE_SCREEN_WIDTH, quorumOptions:GetFeatureCardTextWide())
        SetLayout(column, quorumOptions:GetPictureStack())
        // One level under the part it is in, as CourseCard's heading.
        integer level = 3
        if GetCurrentPart() = undefined
            level = 2
        end
        Heading name
        name:SetScale(level)
        SetStyle(name, quorumOptions:GetFeatureCardHeading())
        name:AddText(escaper:Escape(title))
        column:AddNestedTag(name)
        Paragraph paragraph
        paragraph:AddText(escaper:Escape(words))
        column:AddNestedTag(paragraph)
        card:AddNestedTag(column)

        Image image
        image:SetAddress(escaper:EscapeAttribute(locations:FromSiteTop(locations:Join(GetWebSite():GetRelativeFolder(), picture))))
        image:SetAlternate(escaper:EscapeAttribute(pictureDescription))
        SetStyle(image, quorumOptions:GetFeatureCardPicture())
        SetStyleFromWidth(image, constants:LARGE_SCREEN_WIDTH, quorumOptions:GetFeatureCardPictureWide())
        card:AddNestedTag(image)
        Include(card)
    end

    /*
        Starts course cards with grey lower halves under their pictures, as
        the Download page's feature cards have. Add each with CourseCard.
    */
    action FeatureCards
        CourseCards()
        greyCardBodies = true
    end

    /*
        Makes the banner's picture wide (nearly half the banner) from a
        large screen up, for a screenshot that needs the room, as the
        Download page's has. Phones and tablets keep the usual size.
    */
    action WideBannerPicture
        if bannerPicture = undefined
            alert("A wide banner picture needs a banner. Add one first with Banner.")
        end
        SetStyleFromWidth(bannerPicture, constants:LARGE_SCREEN_WIDTH, quorumOptions:GetBannerPictureWide())
    end

    /*
        Adds a tile under the banner's words, such as "Download Quorum
        Studio", in the look Choice gives tiles.

        Attribute: Parameter words The tile's words.
        Attribute: Parameter address Where it goes.
        Attribute: Parameter icon An SVG icon's location inside the relative folder, or "" for none.
    */
    action BannerChoice(text words, text address, text icon)
        Link tile = NewChoiceTile(words, address, icon)
        if productBanner
            SetStyle(tile, quorumOptions:GetProductButton())
        elseif heroBanner
            SetStyle(tile, quorumOptions:GetHeroPill())
        end
        BannerActions():AddNestedTag(tile)
    end

    /*
        Adds a link under the banner's words, beside any tiles, such as
        "Release Notes".

        Attribute: Parameter words The link's words.
        Attribute: Parameter address Where it goes.
    */
    action BannerLink(text words, text address)
        Link link
        link:SetAddress(escaper:EscapeAttribute(address))
        link:AddText(escaper:Escape(words))
        if productBanner
            // Centered under the button, as the old banner had it (the text
            // styles have no centering, so a centered row holds it).
            SetStyle(link, quorumOptions:GetProductLink())
            Division row
            SetLayout(row, quorumOptions:GetProductLinkRow())
            row:AddNestedTag(link)
            BannerActions():AddNestedTag(row)
        else
            SetStyle(link, GetStyleOptions():GetLink())
            BannerActions():AddNestedTag(link)
        end
    end

    // The row under the banner's words that holds its tiles and links.
    private action BannerActions returns Division
        if bannerColumn = undefined
            alert("Banner tiles and links need a banner. Add one first with Banner.")
        end
        if bannerActions = undefined
            Division actions
            if productBanner or heroBanner
                SetLayout(actions, quorumOptions:GetProductStack())
            else
                SetLayout(actions, quorumOptions:GetBannerActions())
            end
            bannerColumn:AddNestedTag(actions)
            bannerActions = actions
        end
        return bannerActions
    end

    /*
        Starts the cards for a lesson's practice problem sets, such as its
        Parsons problems. Add each set with ProblemSet.

        Attribute: Example
        class MyLesson is QuorumPage
            action Setup
                Section("Engage")
                Subsection("Parsons Problems")
                ProblemSets()
                ProblemSet("Learn about output statements", "/problems/output/start.html")
                ProblemSet("Learn about say statements", "/problems/say/start.html")
            end
        end
    */
    action ProblemSets
        Division grid
        SetLayout(grid, quorumOptions:GetProblemSets())
        Include(grid)
        problemSetGrid = grid
        problemSetCount = 0
    end

    /*
        Adds a problem set to the cards ProblemSets started: a card,
        numbered in order ("Set 1"), with the set's name and "Start". The
        whole card is one link to the set.

        Attribute: Parameter words The set's name, such as "Learn about output statements".
        Attribute: Parameter address Where the set starts, such as "/problems/output/start.html".
    */
    action ProblemSet(text words, text address)
        if problemSetGrid = undefined
            alert("A problem set needs cards to go in. Start them with ProblemSets.")
        end
        problemSetCount = problemSetCount + 1

        Link card
        card:SetAddress(escaper:EscapeAttribute(address))
        SetLayout(card, quorumOptions:GetProblemSetCardLayout())
        SetStyle(card, quorumOptions:GetProblemSetCard())

        Span label
        SetStyle(label, quorumOptions:GetProblemSetLabel())
        // Each part ends with a space, so the link's name reads "Set 1 Learn
        // about ... Start" to screen readers, not "Set 1Learn about ...".
        label:AddText(escaper:Escape(PROBLEM_SET_LABEL + problemSetCount + " "))
        card:AddNestedTag(label)

        Span name
        SetStyle(name, quorumOptions:GetProblemSetName())
        name:AddText(escaper:Escape(words + " "))
        card:AddNestedTag(name)

        // "Start", with an arrow screen readers skip.
        Span start
        SetStyle(start, quorumOptions:GetProblemSetStart())
        start:AddText(escaper:Escape(PROBLEM_SET_START))
        Span arrow
        arrow:AddAttribute("aria-hidden", "true")
        arrow:AddText(PROBLEM_SET_ARROW)
        start:AddNestedTag(arrow)
        card:AddNestedTag(start)

        problemSetGrid:AddNestedTag(card)
    end

    /*
        Starts a numbered list of lessons, as a track page lists its
        course. Add each lesson with LessonEntry.

        Attribute: Example
        class MyTrack is QuorumPage
            action Setup
                Section("About the Course")
                LessonList()
                LessonEntry("Loops Online", "/tutorials/online/loops.html", "Learn about loops.")
            end
        end
    */
    action LessonList
        OrderedList list
        SetStyle(list, GetStyleOptions():GetNumberedList())
        SetLayout(list, quorumOptions:GetLessonList())
        Include(list)
        lessonList = list
    end

    /*
        Adds a lesson to the list LessonList started: its title, linked to
        it, above its description.

        Attribute: Parameter title The lesson's title.
        Attribute: Parameter address The lesson's address, such as "/tutorials/online/loops.html".
        Attribute: Parameter description What the lesson teaches, in a line.
    */
    action LessonEntry(text title, text address, text description)
        if lessonList = undefined
            alert("A lesson entry needs a list to go in. Start one with LessonList.")
        end
        ListItem item
        Paragraph name
        SetStyle(name, quorumOptions:GetLessonTitle())
        Link link
        link:SetAddress(escaper:EscapeAttribute(address))
        link:AddText(escaper:Escape(title))
        // The site's link look, as links in the text have, so it reads as
        // a link and not only as bold text.
        SetStyle(link, GetStyleOptions():GetLink())
        name:AddNestedTag(link)
        item:AddNestedTag(name)

        Paragraph words
        SetStyle(words, quorumOptions:GetLessonDescription())
        words:AddText(escaper:Escape(description))
        item:AddNestedTag(words)
        lessonList:AddNestedTag(item)
    end

    /*
        Adds a live code editor, where readers can change code and run it,
        with code from a file in the site's relative folder. The editor's
        script is added to the page once. It returns the editor, so a page
        can hide its display and keep only its output, with HideDisplay.

        Attribute: Parameter editorTitle The editor's title.
        Attribute: Parameter location The code's location inside the relative folder.
        Attribute: Returns The editor.

        Attribute: Example
        class MyLesson is QuorumPage
            action Setup
                Section("Try it")
                CodeEditor("Place a box", "scenes/Introduction/Box.quorum")
            end
        end
    */
    action CodeEditor(text editorTitle, text location) returns IDE
        if not GetWebSite():GetRelativeFile(location):Exists()
            alert("There's no code for the editor at " + location + ".")
        end
        CodeForIDE code
        // The code is read from the file and put in the page.
        code:AddFileUrl(EDITOR_FILE_NAME, GetWebSite():GetRelativeFile(location):GetPath())
        return AddEditor(editorTitle, code)
    end

    /*
        Adds a live code editor that starts with the code given, in a file
        named Main.quorum. Returns the editor, as CodeEditor does.

        Attribute: Parameter editorTitle The editor's title.
        Attribute: Parameter code The code the editor starts with.
        Attribute: Returns The editor.

        Attribute: Example
        class MyLesson is QuorumPage
            action Setup
                Section("Try it")
                CodeEditorWithCode("Activity: Try actions", "//Try creating a Main action"):HideDisplay()
            end
        end
    */
    action CodeEditorWithCode(text editorTitle, text code) returns IDE
        return CodeEditorWithCode(editorTitle, EDITOR_FILE_NAME, code)
    end

    /*
        Adds a live code editor that starts with the code given, in a file
        with the name given. Returns the editor, as CodeEditor does.

        Attribute: Parameter editorTitle The editor's title.
        Attribute: Parameter fileName The file's name, such as "Histogram.quorum".
        Attribute: Parameter code The code the editor starts with.
        Attribute: Returns The editor.
    */
    action CodeEditorWithCode(text editorTitle, text fileName, text code) returns IDE
        CodeForIDE files
        files:AddFileText(fileName, code)
        return AddEditor(editorTitle, files)
    end

    /*
        Adds a live code editor whose code is in a file outside the site's
        folder, by its path from the project folder, such as
        "examples/Charts/BC1.quorum", in a file with the name given. Locations
        stay inside the site everywhere else; this is for the few files kept
        elsewhere. Returns the editor, as CodeEditor does.

        Attribute: Parameter editorTitle The editor's title.
        Attribute: Parameter fileName The file's name in the editor, such as "BarChart.quorum".
        Attribute: Parameter path The code's path from the project folder.
        Attribute: Returns The editor.

        Attribute: Example
        class MyLesson is QuorumPage
            action Setup
                Section("Bar charts")
                CodeEditorFromProject("Making a Bar Chart", "BarChart.quorum", "examples/Charts/BC1.quorum")
            end
        end
    */
    action CodeEditorFromProject(text editorTitle, text fileName, text path) returns IDE
        IDE editor = CodeEditorFromProject(editorTitle)
        EditorFileFromProject(fileName, path)
        return editor
    end

    /*
        Starts a live code editor with several files, each outside the site's
        folder; add them with EditorFileFromProject, as rows follow Table.
        Returns the editor, as CodeEditor does.

        Attribute: Parameter editorTitle The editor's title.
        Attribute: Returns The editor.

        Attribute: Example
        class MyLesson is QuorumPage
            action Setup
                Section("Bogmort's Spellbook")
                CodeEditorFromProject("Bogmort's Spellbook")
                EditorFileFromProject("Main.quorum", "examples/Blocks/H13.quorum")
                EditorFileFromProject("Spellbook.quorum", "examples/Blocks/Spellbook.quorum")
            end
        end
    */
    action CodeEditorFromProject(text editorTitle) returns IDE
        CodeForIDE files
        IDE editor = AddEditor(editorTitle, files)
        currentEditor = editor
        currentEditorFiles = files
        return editor
    end

    /*
        Adds a file to the editor CodeEditorFromProject(title) started, from
        its path in the project folder, with the name it has in the editor.

        Attribute: Parameter fileName The file's name in the editor, such as "Spellbook.quorum".
        Attribute: Parameter path The code's path from the project folder.
    */
    action EditorFileFromProject(text fileName, text path)
        if currentEditor = undefined
            alert("An editor file needs an editor to go in. Start one with CodeEditorFromProject.")
        end
        File file
        file:SetPath(path)
        if not file:Exists()
            alert("There's no code for the editor at " + path + ".")
        end
        currentEditorFiles:AddFileUrl(fileName, path)
        currentEditor:RemoveAttribute(EDITOR_CODE_ATTRIBUTE)
        currentEditor:SetCodeForIDE(currentEditorFiles:GetJsonArray())
    end

    /*
        Loads the script that makes charts navigable, once. Chart calls it;
        a page whose editors draw charts calls it too.
    */
    action UseCharts
        if not chartsScriptAdded
            AddScript(locations:FromSiteTop(CHARTS_SCRIPT) + versions:GetChartsScriptVersionQuery())
            chartsScriptAdded = true
        end
    end

    /*
        Adds a chart Quorum exported as an SVG file, from a location in the
        site's relative folder, such as "media/tutorials/charts/gallery/barchart1.svg".
        The chart goes into the page itself, so readers can explore it with
        the keyboard and a screen reader; the charts script is added once.

        Attribute: Parameter location The chart's location inside the relative folder.

        Attribute: Example
        class MyLesson is QuorumPage
            action Setup
                Section("Bar charts")
                Chart("media/tutorials/charts/gallery/barchart1.svg")
            end
        end
    */
    action Chart(text location)
        File file = GetWebSite():GetRelativeFile(location)
        if not file:Exists()
            alert("There's no chart at " + location + ".")
        end
        UseCharts()
        Division chart
        SetStyle(chart, quorumOptions:GetChartBox())
        chart:AddText(file:Read())
        Include(chart)
    end

    /*
        Starts slides in the current section: the subsections that follow,
        each started with Slide, are shown one at a time, with Previous
        Slide, a button for each slide and Next Slide under them. Without
        the slides script, every slide shows, one after another, as
        ordinary subsections. The slides end where the section ends.

        Attribute: Example
        class MyLesson is QuorumPage
            action Setup
                Section("Learn About Variables")
                Slides()
                Slide("Variables")
                Paragraph("A variable is a container for information.")
                Slide("Creating Variables")
                Paragraph("Start with the variable's type.")
            end
        end
    */
    action Slides
        if not slidesScriptAdded
            AddScript(locations:FromSiteTop(SLIDES_SCRIPT))
            slidesScriptAdded = true
        end
        Division navigation
        navigation:AddAttribute("data-slides", "")
        navigation:AddAttribute("role", "group")
        navigation:AddAttribute("aria-label", "Slides")
        SetLayout(navigation, quorumOptions:GetSlidesNavigation())
        navigation:AddNestedTag(SlideButton(PREVIOUS_SLIDE, "data-slides-previous"))
        Division numbers
        numbers:AddAttribute("data-slides-numbers", "")
        SetLayout(numbers, quorumOptions:GetSlidesNavigation())
        navigation:AddNestedTag(numbers)
        navigation:AddNestedTag(SlideButton(NEXT_SLIDE, "data-slides-next"))
        Include(navigation)
    end

    /*
        Starts a slide, after Slides: a subsection with its heading.

        Attribute: Parameter heading The slide's heading.
        Attribute: Returns A writer for the slide's heading.
    */
    action Slide(text heading) returns RichText
        return Subsection(heading)
    end

    /*
        Adds a picture beside some words, in the current part: stacked on
        phones and tablets, side by side from a large screen up, the
        picture on the left, then on the right, then the left again, down
        the page. Add links under the words with PictureBesideLink.

        Attribute: Parameter picture The picture's location inside the relative folder.
        Attribute: Parameter pictureDescription What the picture shows, or "" if it is decoration.
        Attribute: Parameter words The words beside it, or "" for none.
    */
    action PictureBeside(text picture, text pictureDescription, text words)
        pictureRowCount = pictureRowCount + 1
        PictureRow(picture, pictureDescription, words, pictureRowCount mod 2 = 1, quorumOptions:GetPictureBesideWide())
    end

    /*
        Adds a feature: its words on the left and a large picture on the
        right (over half the row) from a large screen up, stacked on phones
        and tablets, as a page shows off a product's new feature. Add links under
        the words with PictureBesideLink.

        Attribute: Parameter picture The picture's location inside the relative folder.
        Attribute: Parameter pictureDescription What the picture shows, or "" if it is decoration.
        Attribute: Parameter words The words beside it, or "" for none.
    */
    action FeaturePicture(text picture, text pictureDescription, text words)
        PictureRow(picture, pictureDescription, words, false, quorumOptions:GetPictureFeatureWide())
    end

    // A picture beside words: the picture first (on the left) or last, at
    // a share of the row from a large screen up, stacked below that.
    private action PictureRow(text picture, text pictureDescription, text words, boolean pictureFirst, WebBoxStyle wide)
        Division row
        SetLayout(row, quorumOptions:GetPictureStack())
        SetLayoutFromWidth(row, constants:LARGE_SCREEN_WIDTH, quorumOptions:GetPictureRow())

        Image image
        image:SetAddress(escaper:EscapeAttribute(locations:FromSiteTop(locations:Join(GetWebSite():GetRelativeFolder(), picture))))
        image:SetAlternate(escaper:EscapeAttribute(pictureDescription))
        SetStyleFromWidth(image, constants:LARGE_SCREEN_WIDTH, wide)

        Division column
        SetStyle(column, quorumOptions:GetPictureWords())
        SetLayout(column, quorumOptions:GetPictureStack())
        if not words:IsEmpty()
            Paragraph paragraph
            paragraph:AddText(escaper:Escape(words))
            column:AddNestedTag(paragraph)
        end
        if pictureFirst
            row:AddNestedTag(image)
            row:AddNestedTag(column)
        else
            row:AddNestedTag(column)
            row:AddNestedTag(image)
        end
        Include(row)
        pictureWordsColumn = column
    end

    /*
        Adds a link under the words PictureBeside added last.

        Attribute: Parameter words The link's words.
        Attribute: Parameter address Where it goes.
    */
    action PictureBesideLink(text words, text address)
        if pictureWordsColumn = undefined
            alert("A link beside a picture needs one. Add it first with PictureBeside.")
        end
        Paragraph paragraph
        Link link
        link:SetAddress(escaper:EscapeAttribute(address))
        link:AddText(escaper:Escape(words))
        SetStyle(link, GetStyleOptions():GetLink())
        paragraph:AddNestedTag(link)
        pictureWordsColumn:AddNestedTag(paragraph)
    end

    /*
        Starts a grid of pictures, such as photos from an event: as many
        across as fit, one on a phone. Add each with GridPicture.
    */
    action PictureGrid
        Division grid
        SetLayout(grid, quorumOptions:GetCourseCards())
        Include(grid)
        pictureGrid = grid
    end

    /*
        Adds a picture to the grid PictureGrid started.

        Attribute: Parameter picture The picture's location inside the relative folder.
        Attribute: Parameter pictureDescription What the picture shows.
    */
    action GridPicture(text picture, text pictureDescription)
        if pictureGrid = undefined
            alert("A grid picture needs a grid. Start one with PictureGrid.")
        end
        Image image
        image:SetAddress(escaper:EscapeAttribute(locations:FromSiteTop(locations:Join(GetWebSite():GetRelativeFolder(), picture))))
        image:SetAlternate(escaper:EscapeAttribute(pictureDescription))
        SetStyle(image, quorumOptions:GetCourseCardPicture())
        pictureGrid:AddNestedTag(image)
    end

    /*
        Adds a question that opens to its answer, as a list of frequently
        asked questions has: built in, so keyboards and screen readers open
        it with no script.

        Attribute: Parameter questionWords The question.
        Attribute: Parameter answer The answer.
    */
    action Question(text questionWords, text answer)
        Details details
        SetStyle(details, quorumOptions:GetQuestion())
        Summary label
        label:AddText(escaper:Escape(questionWords))
        SetStyle(label, quorumOptions:GetUnitLessonsLabel())
        details:AddNestedTag(label)
        Paragraph paragraph
        paragraph:AddText(escaper:Escape(answer))
        details:AddNestedTag(paragraph)
        Include(details)
    end

    /*
        Adds the Access Charts widget, which makes accessible charts or
        downloads them as pictures: a place for it, which its script (added
        to the page once) fills.
    */
    action AccessChartsWidget
        if accessChartsAdded
            alert("A page can have one Access Charts widget: its place has a fixed id.")
        end
        accessChartsAdded = true
        AddScript(locations:FromSiteTop(ACCESS_CHARTS_SCRIPT_START + versions:GetWidgetVersion() + SCRIPT_ENDING))
        // The widget's script finds its place by its class, and draws inside
        // a box that is positioned, as the old page had it.
        Division box
        SetStyle(box, quorumOptions:GetAnchoredBox())
        Division widget
        widget:SetIdentifier("ac1")
        widget:SetClassAttribute("data11y-access-chart")
        box:Add(widget)
        Include(box)
    end

    /*
        Starts a form: the fields, words, buttons and messages added after
        it (FormWords, FormEntry, HiddenField, SubmitButton,
        ProblemMessage, FeedbackMessage) go in it, one under another,
        until EndForm. Its look is the site's (FormLooks).

        Attribute: Parameter identifier The form's id, which its scripts use, or "" for none.
        Attribute: Parameter formAction Where the form goes when sent, such as "javascript:resetPasswordClick()", or "" for none.
        Attribute: Returns The form, to add attributes to.

        Attribute: Example
        class MyPage is QuorumPage
            action Setup
                Title("Reset Password")
                Form("resetPasswordForm", "javascript:resetPasswordClick()")
                FormEntry("Password", "New Password", "passwordEnterInput", "password", "password")
                SubmitButton("Reset my Password", "submitFormButton", "Save New Password")
                EndForm()
            end
        end
    */
    action Form(text identifier, text formAction) returns Form
        if currentForm not= undefined
            alert("A form can't start inside another form. End the first with EndForm.")
        end
        Form form
        if not identifier:IsEmpty()
            form:SetIdentifier(identifier)
        end
        if not formAction:IsEmpty()
            form:AddAttribute("method", "post")
            form:AddAttribute("action", formAction)
            form:SetPost(true)
        end
        SetLayout(form, quorumOptions:GetForms():GetForm())
        Place(form)
        currentForm = form
        return form
    end

    /*
        Ends the form Form or Quiz started; what follows goes in the page
        again.
    */
    action EndForm
        if currentForm = undefined
            alert("EndForm needs a form. Start one with Form or Quiz.")
        end
        currentForm = undefined
    end

    /*
        Adds words to the form or dialog being written, such as what it is
        for.

        Attribute: Parameter words The words.
        Attribute: Returns The paragraph, to give an id or hide until a script shows it.
    */
    action FormWords(text words) returns Paragraph
        Paragraph paragraph
        paragraph:AddText(escaper:Escape(words))
        Place(paragraph)
        return paragraph
    end

    /*
        Adds a box to type in, to the form. Its title is what screen
        readers say it is; the placeholder shows in it until a reader
        types. It is marked wrong (red edge) while a script sets
        aria-invalid.

        Attribute: Parameter title What the box is for, said by screen readers, such as "Password".
        Attribute: Parameter placeholder The words in the empty box, such as "New Password".
        Attribute: Parameter identifier The box's id, which scripts use.
        Attribute: Parameter type The kind of box: "text", "password", "email" and the like.
        Attribute: Parameter name The name the form sends its value as.
        Attribute: Returns The box, to add attributes to, such as a check when it loses focus.
    */
    action FormEntry(text title, text placeholder, text identifier, text type, text name) returns Input
        Input entry
        entry:SetTitle(escaper:EscapeAttribute(title))
        entry:SetIdentifier(identifier)
        entry:SetPlaceHolder(escaper:EscapeAttribute(placeholder))
        entry:SetType(type)
        entry:SetName(name)
        SetEntryLook(entry)
        Division field
        SetLayout(field, quorumOptions:GetForms():GetField())
        field:AddNestedTag(entry)
        Place(field)
        return entry
    end

    /*
        Adds a value the form sends that readers don't see.

        Attribute: Parameter identifier Its id.
        Attribute: Parameter name The name the form sends it as.
        Attribute: Parameter value Its value.
    */
    action HiddenField(text identifier, text name, text value)
        Input hidden
        hidden:SetIdentifier(identifier)
        hidden:SetName(name)
        hidden:SetType("hidden")
        hidden:AddAttribute("value", value)
        Place(hidden)
    end

    /*
        Adds the button that sends the form.

        Attribute: Parameter words The button's words.
        Attribute: Parameter identifier Its id, or "" for none.
        Attribute: Parameter title What it does, said by screen readers.
        Attribute: Returns The button.
    */
    action SubmitButton(text words, text identifier, text title) returns Input
        Input button
        if not identifier:IsEmpty()
            button:SetIdentifier(identifier)
        end
        button:SetType("submit")
        button:SetDefaultValue(escaper:EscapeAttribute(words))
        button:SetTitle(escaper:EscapeAttribute(title))
        SetButtonLook(button)
        Division row
        SetLayout(row, quorumOptions:GetForms():GetButtons())
        row:AddNestedTag(button)
        Place(row)
        return button
    end

    /*
        Adds a message box for problems, hidden until a script shows it
        (script.js's alertMessageOn), with a heading and words the script
        fills in.

        Attribute: Parameter identifier Its id, such as "alertMessage"; its heading and words get this id with "Header" and "Text" after it.
    */
    action ProblemMessage(text identifier)
        Place(NewMessage(identifier, quorumOptions:GetForms():GetProblem()))
    end

    /*
        Adds a message box for information, hidden until a script shows it
        (script.js's feedbackMessageOn), with a heading and words the
        script fills in.

        Attribute: Parameter identifier Its id, such as "feedbackMessage"; its heading and words get this id with "Header" and "Text" after it.
    */
    action FeedbackMessage(text identifier)
        Place(NewMessage(identifier, quorumOptions:GetForms():GetFeedback()))
    end

    /*
        Starts a dialog a script opens, such as one to share or save a
        project: hidden until then, a shaded backdrop over the window with a
        white box in its middle, its title, and a close button in its
        corner. What is added after it (forms, words, buttons) goes in the
        box until EndDialog. The page's scripts show and hide it by its id,
        with the hidden attribute.

        Attribute: Parameter identifier The dialog's id, which its scripts use, such as "shareModal".
        Attribute: Parameter title The dialog's title.
        Attribute: Parameter titleIdentifier The title's id, which names the dialog for screen readers.
        Attribute: Parameter closeIdentifier The close button's id, or "" for none.
        Attribute: Parameter closeScript What the close button does, such as "hideShareModal()".
    */
    action Dialog(text identifier, text title, text titleIdentifier, text closeIdentifier, text closeScript)
        if currentDialog not= undefined
            alert("A dialog can't start inside another dialog. End the first with EndDialog.")
        end
        FormLooks looks = quorumOptions:GetForms()
        Division backdrop
        backdrop:SetIdentifier(identifier)
        backdrop:AddAttribute("hidden", "")
        SetStyle(backdrop, looks:GetBackdrop())
        SetLayout(backdrop, looks:GetBackdropLayout())
        Division box
        box:AddAttribute("role", "dialog")
        box:AddAttribute("aria-modal", "true")
        box:AddAttribute("aria-labelledby", titleIdentifier)
        SetStyle(box, looks:GetDialog())
        SetStyleFromWidth(box, constants:LARGE_SCREEN_WIDTH, looks:GetDialogWide())
        SetLayout(box, looks:GetDialogLayout())
        Paragraph heading
        heading:SetIdentifier(titleIdentifier)
        heading:AddText(escaper:Escape(title))
        SetStyle(heading, looks:GetDialogTitle())
        box:AddNestedTag(heading)
        Button close
        if not closeIdentifier:IsEmpty()
            close:SetIdentifier(closeIdentifier)
        end
        close:SetType("button")
        close:AddAttribute("aria-label", "Close")
        File icon
        icon:SetPath(CLOSE_ICON)
        close:AddText(icon:Read())
        close:SetOnClick(closeScript)
        SetStyle(close, looks:GetClose())
        SetStyleOnHover(close, looks:GetCloseHover())
        SetStyleOnKeyboardFocus(close, looks:GetButtonFocus())
        box:AddNestedTag(close)
        backdrop:AddNestedTag(box)
        Place(backdrop)
        currentDialog = box
    end

    /*
        Ends the dialog Dialog started; what follows goes in the page again.
    */
    action EndDialog
        if currentDialog = undefined
            alert("EndDialog needs a dialog. Start one with Dialog.")
        end
        currentDialog = undefined
    end

    /*
        Adds a box to type in with its label above it, to the form or
        dialog being written. It is marked wrong (red edge) while a script
        sets aria-invalid.

        Attribute: Parameter label The label's words, such as "Project Name: ".
        Attribute: Parameter identifier The box's id, which scripts use.
        Attribute: Parameter type The kind of box: "text", "password", "email" and the like.
        Attribute: Parameter name The name the form sends its value as.
        Attribute: Returns The box, to add attributes to.
    */
    action FormField(text label, text identifier, text type, text name) returns Input
        FormLooks looks = quorumOptions:GetForms()
        Division field
        SetLayout(field, looks:GetField())
        Label words
        words:AddAttribute("for", identifier)
        words:AddText(escaper:Escape(label))
        SetStyle(words, looks:GetLabelBox())
        field:AddNestedTag(words)
        Input entry
        entry:SetIdentifier(identifier)
        entry:SetType(type)
        entry:SetName(name)
        SetEntryLook(entry)
        field:AddNestedTag(entry)
        Place(field)
        return entry
    end

    /*
        Adds a checkbox with its label beside it, to the form or dialog
        being written.

        Attribute: Parameter label The label's words.
        Attribute: Parameter identifier The checkbox's id, which scripts use.
        Attribute: Returns The checkbox.
    */
    action FormCheckbox(text label, text identifier) returns Input
        Division row
        SetLayout(row, quorumOptions:GetForms():GetCheckboxRow())
        Input checkbox
        checkbox:SetType("checkbox")
        checkbox:SetIdentifier(identifier)
        row:AddNestedTag(checkbox)
        Label words
        words:AddAttribute("for", identifier)
        words:AddText(escaper:Escape(label))
        row:AddNestedTag(words)
        Place(row)
        return checkbox
    end

    /*
        Adds a button to the form or dialog being written, in the forms'
        look; faded with a "not allowed" pointer while it is disabled.

        Attribute: Parameter words The button's words.
        Attribute: Parameter identifier Its id, or "" for none.
        Attribute: Parameter type "button", or "submit" to send the form.
        Attribute: Returns The button, to set what it does.
    */
    action FormButton(text words, text identifier, text type) returns Button
        Button button
        if not identifier:IsEmpty()
            button:SetIdentifier(identifier)
        end
        button:SetType(type)
        button:AddText(escaper:Escape(words))
        SetButtonLook(button)
        SetStyleWhenDisabled(button, quorumOptions:GetForms():GetButtonDisabled())
        Place(button)
        return button
    end

    /*
        Starts a quiz: the questions added with QuizChoice, then the button
        QuizCheck adds, which checks them and ends the quiz. The quiz's
        script (script/quiz.js) marks each answer right or wrong, says the
        score, and remembers the reader's choices on their own computer.

        Attribute: Parameter key A short name, unique on the site, the choices are remembered under, such as "l4".
    */
    action Quiz(text key)
        if not quizScriptAdded
            AddScript(locations:FromSiteTop(QUIZ_SCRIPT))
            quizScriptAdded = true
        end
        Form quiz = Form("quiz-form", "")
        quiz:AddAttribute("data-quiz", escaper:EscapeAttribute(key))
        quizQuestions = 0
    end

    /*
        Adds a question with a list of choices to the quiz Quiz started;
        add its choices with QuizOption. The list starts at "Choose an
        option".

        Attribute: Parameter question The question, such as "1. What's the largest bill length?"
        Attribute: Parameter answer The right choice, exactly as QuizOption gives it.
    */
    action QuizChoice(text question, text answer)
        if currentForm = undefined
            alert("A quiz question needs a quiz. Start one with Quiz.")
        end
        FormLooks looks = quorumOptions:GetForms()
        quizQuestions = quizQuestions + 1
        text name = "q" + quizQuestions
        Division field
        SetLayout(field, looks:GetField())
        Paragraph words
        words:SetIdentifier(name + "-label")
        words:AddText(escaper:Escape(question))
        SetStyle(words, looks:GetQuestion())
        field:AddNestedTag(words)
        Paragraph line
        line:SetIdentifier(name + "-validation")
        line:AddAttribute("aria-live", "polite")
        SetStyle(line, looks:GetAnswerLine())
        field:AddNestedTag(line)
        Select choice
        choice:SetIdentifier(name)
        choice:AddAttribute("aria-labelledby", name + "-label")
        choice:AddAttribute("aria-describedby", name + "-validation")
        choice:AddAttribute("data-answer", escaper:EscapeAttribute(answer))
        SetEntryLook(choice)
        SetStyleWhenAttribute(choice, "data-state", "correct", looks:GetEntryRight())
        SetStyleWhenAttribute(choice, "data-state", "incorrect", looks:GetEntryWrong())
        Option prompt
        prompt:AddAttribute("value", "")
        prompt:SetSelected(true)
        prompt:SetDisabled(true)
        prompt:AddText(QUIZ_PROMPT)
        choice:Add(prompt)
        field:AddNestedTag(choice)
        currentForm:AddNestedTag(field)
        quizSelect = choice
    end

    /*
        Adds a choice to the quiz question QuizChoice added last.

        Attribute: Parameter words The choice, as readers see it and as the answer names it.
    */
    action QuizOption(text words)
        if quizSelect = undefined
            alert("A quiz option needs a question. Add one with QuizChoice.")
        end
        Option option
        option:AddAttribute("value", escaper:EscapeAttribute(words))
        option:AddText(escaper:Escape(words))
        quizSelect:Add(option)
    end

    /*
        Adds the button that checks the quiz's answers, and the line under
        it that says the score; it ends the quiz.

        Attribute: Parameter words The button's words, such as "Check Answers".
    */
    action QuizCheck(text words)
        if currentForm = undefined
            alert("A quiz's check needs a quiz. Start one with Quiz.")
        end
        Button checkButton
        checkButton:SetType("button")
        checkButton:AddAttribute("data-quiz-check", "")
        checkButton:AddText(escaper:Escape(words))
        SetButtonLook(checkButton)
        currentForm:AddNestedTag(checkButton)
        Division result
        result:SetIdentifier("result")
        result:AddAttribute("role", "region")
        result:AddAttribute("aria-live", "polite")
        SetStyle(result, quorumOptions:GetForms():GetResult())
        currentForm:AddNestedTag(result)
        quizSelect = undefined
        EndForm()
    end

    // Puts a part in the form being written, or the dialog, or else the
    // page.
    private action Place(WebTag tag)
        if currentForm not= undefined
            currentForm:AddNestedTag(tag)
        elseif currentDialog not= undefined
            currentDialog:AddNestedTag(tag)
        else
            Include(tag)
        end
    end

    // A box to type in or choose from: its edge, its focus ring, and its
    // red edge while marked wrong.
    private action SetEntryLook(WebTag entry)
        FormLooks looks = quorumOptions:GetForms()
        SetStyle(entry, looks:GetEntry())
        SetStyleOnKeyboardFocus(entry, looks:GetEntryFocus())
        SetStyleWhenInvalid(entry, looks:GetEntryWrong())
    end

    // A form's button: its look, its shadow under the pointer, and its
    // focus ring.
    private action SetButtonLook(WebTag button)
        FormLooks looks = quorumOptions:GetForms()
        SetStyle(button, looks:GetButton())
        SetStyleOnHover(button, looks:GetButtonHover())
        SetStyleOnKeyboardFocus(button, looks:GetButtonFocus())
    end

    // A message box a script shows: hidden, with a heading and words the
    // script fills in by their ids.
    private action NewMessage(text identifier, WebBoxStyle look) returns Division
        FormLooks looks = quorumOptions:GetForms()
        Division message
        message:SetIdentifier(identifier)
        message:AddAttribute("hidden", "")
        message:AddAttribute("aria-hidden", "true")
        message:AddAttribute("role", "status")
        SetStyle(message, look)
        SetLayout(message, looks:GetMessage())
        Paragraph heading
        heading:SetIdentifier(identifier + "Header")
        SetStyle(heading, looks:GetMessageHeading())
        message:AddNestedTag(heading)
        Paragraph words
        words:SetIdentifier(identifier + "Text")
        SetStyle(words, looks:GetMessageWords())
        message:AddNestedTag(words)
        return message
    end

    /*
        Starts a numbered list of rows, such as the problems in a set: a
        card with a row for each item (added with NumberedRow), its number,
        its title and a link to it at the right.
    */
    action NumberedRows
        OrderedList list
        SetStyle(list, quorumOptions:GetNumberedRows())
        Include(list)
        numberedRowsList = list
        numberedRowsCount = 0
    end

    /*
        Adds a row to the list NumberedRows started: its number, its title
        and a link at the right. Screen readers hear the link's words with
        the title after them ("Practice Making a Counter"), so each link
        says where it goes.

        Attribute: Parameter title The item's title.
        Attribute: Parameter address Where the link goes.
        Attribute: Parameter linkWords The link's words, such as "Practice".
    */
    action NumberedRow(text title, text address, text linkWords)
        if numberedRowsList = undefined
            alert("A numbered row needs a list. Start one with NumberedRows.")
        end
        numberedRowsCount = numberedRowsCount + 1
        ListItem item
        SetStyle(item, quorumOptions:GetNumberedRow())
        SetStyleWhenFirst(item, quorumOptions:GetNumberedRowFirst())
        SetLayout(item, quorumOptions:GetNumberedRowLayout())
        // The list is ordered for screen readers; the drawn number is for sight.
        Span numberMark
        numberMark:AddAttribute("aria-hidden", "true")
        numberMark:AddText("" + numberedRowsCount)
        SetStyle(numberMark, quorumOptions:GetStep())
        SetLayout(numberMark, quorumOptions:GetStepLayout())
        item:AddNestedTag(numberMark)
        Span words
        words:AddText(escaper:Escape(title))
        SetStyle(words, quorumOptions:GetNumberedRowTitle())
        item:AddNestedTag(words)
        Link link
        link:SetAddress(escaper:EscapeAttribute(address))
        link:AddAttribute("aria-label", escaper:EscapeAttribute(linkWords + " " + title))
        link:AddText(escaper:Escape(linkWords))
        SetStyle(link, quorumOptions:GetNumberedRowLink())
        SetStyleOnHover(link, quorumOptions:GetNumberedRowLinkHover())
        SetStyleOnKeyboardFocus(link, quorumOptions:GetForms():GetButtonFocus())
        item:AddNestedTag(link)
        numberedRowsList:AddNestedTag(item)
    end

    /*
        Starts a row of numbered steps, such as the problems in a set: a
        list of links, one for each step (added with Step), the current one
        filled in. On a narrow screen the row wraps.

        Attribute: Parameter label What the steps are, said by screen readers, such as "Problems".
    */
    action Steps(text label)
        NavigationDivision navigation
        navigation:AddAttribute("aria-label", escaper:EscapeAttribute(label))
        // A navigation can't take a style or layout, so the box is inside it.
        Division box
        SetStyle(box, quorumOptions:GetSteps())
        SetStyleFromWidth(box, constants:SMALL_SCREEN_WIDTH, quorumOptions:GetStepsWide())
        OrderedList list
        SetLayout(list, quorumOptions:GetStepsRow())
        box:AddNestedTag(list)
        navigation:AddNestedTag(box)
        Include(navigation)
        stepsList = list
        stepsCount = 0
    end

    /*
        Adds a step to the row Steps started: a link with the step's
        number, an arrow before it after the first.

        Attribute: Parameter stepNumber The step's number, as readers see it, such as "3".
        Attribute: Parameter title The step's name, shown when the pointer is over it, such as "absolute-value".
        Attribute: Parameter address Where the step's page is.
        Attribute: Parameter current True for the step of the page this is on.
    */
    action Step(text stepNumber, text title, text address, boolean current)
        if stepsList = undefined
            alert("A step needs a row of steps. Start one with Steps.")
        end
        ListItem item
        SetLayout(item, quorumOptions:GetStepItem())
        if stepsCount > 0
            item:AddText(ReadIcon(STEP_ARROW_ICON))
        end
        stepsCount = stepsCount + 1
        Link link
        link:SetAddress(escaper:EscapeAttribute(address))
        link:AddAttribute("title", escaper:EscapeAttribute(title))
        link:AddText(escaper:Escape(stepNumber))
        SetStyle(link, quorumOptions:GetStep())
        SetLayout(link, quorumOptions:GetStepLayout())
        SetStyleWhenCurrent(link, quorumOptions:GetStepCurrent())
        if current
            link:AddAttribute("aria-current", "step")
        end
        item:AddNestedTag(link)
        stepsList:AddNestedTag(item)
    end

    /*
        Adds another file to the next block editor, after its main file;
        call it before BlockEditor, once for each file.

        Attribute: Parameter fileName The file's name in the editor, such as "Shape.quorum".
        Attribute: Parameter location The file, from the project's folder.
    */
    action BlockEditorFile(text fileName, text location)
        blockEditorFileNames:Add(fileName)
        blockEditorFileLocations:Add(location)
    end

    /*
        Adds the block editor: a toolbar (Hide Tray, Zoom In, Zoom Out,
        Hotkeys, Fullscreen, More, Run, Stop), the blocks with the program's
        display beside them (when it has one), and the console under them,
        with a hotkeys dialog and a "More" menu. The editor's scripts are
        added to the page once; its look is the site's (BlockEditorLooks).
        Its code comes from a file in the project, such as an example.

        Attribute: Parameter fileName The code's file name in the editor, such as "Histogram.quorum".
        Attribute: Parameter location The code's file, from the project's folder, such as "examples/Charts/Histogram2.quorum".
        Attribute: Parameter palette The tray's file, such as "/palette/frontPage.xml".
        Attribute: Parameter showDisplay True to show the program's display beside the blocks when it runs.
        Attribute: Parameter fill True to fill the width of the part it is in.
    */
    action BlockEditor(text fileName, text location, text palette, boolean showDisplay, boolean fill)
        CodeForIDE code
        code:AddFileUrl(fileName, location)
        integer extra = 0
        repeat while extra < blockEditorFileNames:GetSize()
            code:AddFileUrl(blockEditorFileNames:Get(extra), blockEditorFileLocations:Get(extra))
            extra = extra + 1
        end
        blockEditorFileNames:Empty()
        blockEditorFileLocations:Empty()
        BuildBlockEditor(code:GetJsonArray(), palette, showDisplay, fill)
    end

    /*
        Adds the block editor for a reader's own project, which the server
        fills in: the same editor, filling the width it is in, with "Add
        File" and "Save Project" in its toolbar (Save Project opens the
        page's save dialog, script.js's blockShowSaveModal), and the
        editor started in project mode. Its tray is the editor's own.

        Attribute: Parameter codeJson The project's files, as CodeForIDE:GetJsonArray gives them.
        Attribute: Parameter showDisplay True to show the program's display beside the blocks when it runs.
    */
    action ProjectBlockEditor(text codeJson, boolean showDisplay)
        blockProjectMode = true
        BuildBlockEditor(codeJson, "", showDisplay, true)
    end

    // The block editor, from its files as JSON (BlockEditor and
    // ProjectBlockEditor).
    private action BuildBlockEditor(text codeJson, text palette, boolean showDisplay, boolean fill)
        if blockEditorAdded
            alert("A page can have one block editor: its parts have fixed ids the editor's scripts use.")
        end
        blockEditorAdded = true
        BlockEditorLooks looks = quorumOptions:GetBlockEditor()

        Division editor
        editor:SetIdentifier("BlockEditor")
        if fill
            SetStyle(editor, looks:GetFilledEditor())
        else
            SetStyle(editor, looks:GetEditor())
        end
        SetLayout(editor, looks:GetEditorLayout())
        editor:Add(BlockHelpDialog())

        Division toolbar
        SetStyle(toolbar, looks:GetToolbar())
        SetLayout(toolbar, looks:GetToolbarLayout())
        Division title
        SetStyle(title, looks:GetTitle())
        SetLayout(title, looks:GetTitleLayout())
        title:AddText(ReadIcon("quorumIcon.svg"))
        title:AddText("Blocks")
        toolbar:Add(title)

        Division buttons
        SetStyle(buttons, looks:GetButtons())
        SetLayout(buttons, looks:GetButtonsLayout())
        Button hideTray = BlockTool("Hide Tray", "eyeIcon.svg", "blockEditorTogglePalette()", "")
        hideTray:GetTag(1):SetIdentifier("HidePaletteContainer")
        buttons:Add(hideTray)
        buttons:Add(BlockTool("Zoom In", "zoomIn.svg", "blockEditorZoomIn()", ""))
        buttons:Add(BlockTool("Zoom Out", "zoomOut.svg", "blockEditorZoomOut()", ""))
        buttons:Add(BlockTool("Hotkeys", "helpIcon.svg", "showBlockHelpModal()", "blockHelpButton"))
        if blockProjectMode
            buttons:Add(BlockTool("Add File", "addFileIcon.svg", "window.BLOCK_EDITOR.AddNewFile('Class'+window.BLOCK_EDITOR.GetFileCount()+'.quorum')", ""))
            buttons:Add(BlockTool("Save Project", "saveIcon.svg", "blockShowSaveModal()", "saveBlockProjectButton"))
        end
        // Each with a second icon the script shows instead: Minimize in
        // fullscreen, an up arrow while the menu is open.
        Button fullscreen = BlockTool("Fullscreen", "fullscreenIcon.svg", "minimizeIcon.svg", "blockEditorFullscreen()", "blockEditorFullscreenButton")
        fullscreen:GetTag(2):SetIdentifier("blockFullscreenLabel")
        buttons:Add(fullscreen)
        Button more = BlockTool("More", "moreIcon.svg", "moreIconClose.svg", "blockEditorMoreToggle()", "blockEditorMoreButton")
        more:GetTag(2):SetIdentifier("blockMoreLabel")
        more:AddAttribute("aria-haspopup", "true")
        more:AddAttribute("aria-controls", "moreActionsMenu")
        more:AddAttribute("aria-expanded", "false")
        buttons:Add(more)
        buttons:Add(BlockMoreMenu())

        // While Run waits (disabled), its icon hides and the spinner shows.
        Button run
        run:SetIdentifier("blockRunButton")
        SetStyle(run, looks:GetRun())
        SetLayout(run, looks:GetRunLayout())
        SetStyleWhenDisabled(run, looks:GetUnavailable())
        run:AddAttribute("aria-label", "Run Program")
        Span runIcon
        runIcon:AddText(ReadIcon("runIcon.svg"))
        SetStyleInsideDisabled(runIcon, looks:GetHidden())
        run:AddNestedTag(runIcon)
        Span spinner
        spinner:AddText(ReadIcon("spinner.svg"))
        SetStyle(spinner, looks:GetSpinner())
        SetStyleInsideDisabled(spinner, looks:GetShown())
        run:AddNestedTag(spinner)
        run:AddText(" &nbsp;Run")
        run:SetOnClick("blockEditorRunCode('QuorumUIOutput','QuorumUIContainer')")
        buttons:Add(run)
        Button stop
        stop:SetIdentifier("blockStopButton")
        SetStyle(stop, looks:GetStop())
        SetLayout(stop, looks:GetRunLayout())
        SetStyleWhenDisabled(stop, looks:GetUnavailable())
        stop:AddAttribute("aria-label", "Stop Program")
        stop:AddText(ReadIcon("stopIcon.svg"))
        stop:AddText(" &nbsp;Stop")
        stop:SetOnClick("window.BLOCK_EDITOR.BlockEditorStop()")
        stop:SetDisabled(true)
        buttons:Add(stop)
        toolbar:Add(buttons)
        editor:Add(toolbar)

        Division area
        SetStyle(area, looks:GetArea())
        SetLayout(area, looks:GetAreaLayout())
        Division blocks
        blocks:SetIdentifier("BlockUIContainer")
        // The editor's scripts find the blocks by this class.
        blocks:SetClassAttribute("focusButton")
        SetStyle(blocks, looks:GetTray())
        if not palette:IsEmpty()
            blocks:AddAttribute("data-palette-for-ide", palette)
        end
        blocks:AddAttribute("data-code-for-ide", codeJson)
        area:Add(blocks)
        if showDisplay
            Division display
            display:SetIdentifier("QuorumUIContainer")
            SetStyle(display, looks:GetDisplay())
            SetStyleWhenEmpty(display, looks:GetHidden())
            area:Add(display)
        end
        editor:Add(area)

        Division console
        console:SetIdentifier("QuorumUIOutput")
        SetStyle(console, looks:GetConsole())
        console:AddAttribute("role", "log")
        console:AddAttribute("aria-label", "Console Output")
        console:SetTabIndex("0")
        editor:Add(console)

        AddBlockEditorScripts(editor)
        Include(editor)
    end

    // A toolbar button: its icon above its label.
    private action BlockTool(text label, text icon, text onClick, text identifier) returns Button
        return BlockTool(label, icon, "", onClick, identifier)
    end

    // A toolbar button with a second icon the script swaps in (such as
    // Minimize in fullscreen), both above its label.
    private action BlockTool(text label, text icon, text otherIcon, text onClick, text identifier) returns Button
        BlockEditorLooks looks = quorumOptions:GetBlockEditor()
        Button tool
        if not identifier:IsEmpty()
            tool:SetIdentifier(identifier)
        end
        SetStyle(tool, looks:GetTool())
        SetLayout(tool, looks:GetToolLayout())
        SetBlockButtonStates(tool)
        tool:AddAttribute("aria-label", label)
        tool:AddText(ReadIcon(icon))
        if not otherIcon:IsEmpty()
            tool:AddText(ReadIcon(otherIcon))
        end
        Division name
        SetStyle(name, looks:GetToolLabel())
        name:AddText(label)
        tool:AddNestedTag(name)
        tool:SetOnClick(onClick)
        return tool
    end

    // A toolbar button's or menu item's background under the pointer or
    // focus, and pressed.
    private action SetBlockButtonStates(Button button)
        BlockEditorLooks looks = quorumOptions:GetBlockEditor()
        SetStyleOnHover(button, looks:GetActive())
        SetStyleOnFocus(button, looks:GetActive())
        SetStyleWhenPressed(button, looks:GetPressed())
    end

    // An icon from the project's icons folder, as its SVG.
    private action ReadIcon(text name) returns text
        File file
        file:SetPath(BLOCK_EDITOR_ICONS + name)
        return file:Read()
    end

    // The hotkeys dialog, which script.js shows and hides.
    private action BlockHelpDialog returns Division
        BlockEditorLooks looks = quorumOptions:GetBlockEditor()
        Division center
        SetLayout(center, looks:GetDialogRow())
        Division dialog
        dialog:SetIdentifier("blockHelpModal")
        // Starts hidden; script.js shows it by removing the attribute.
        dialog:AddAttribute("hidden", "")
        SetStyle(dialog, looks:GetDialog())
        dialog:AddAttribute("aria-modal", "true")
        dialog:AddAttribute("aria-roledescription", "dialog")
        dialog:AddAttribute("aria-labelledby", "blockHotkeyTitle")
        dialog:AddAttribute("aria-hidden", "true")
        Division content
        content:SetIdentifier("blockHelpModalContent")
        SetStyle(content, looks:GetDialogContent())
        SetLayout(content, looks:GetDialogContentLayout())
        content:SetTabIndex("0")
        Button close
        close:SetTabIndex("0")
        SetStyle(close, looks:GetDialogClose())
        close:AddText("X")
        close:SetOnClick("hideBlockHelpModal()")
        content:Add(close)
        Division section
        SetLayout(section, looks:GetHotkeys())
        Paragraph title
        title:SetIdentifier("blockHotkeyTitle")
        SetStyle(title, looks:GetDialogTitle())
        title:AddText("Hotkey Shortcuts")
        section:Add(title)
        UnorderedList list
        SetLayout(list, looks:GetHotkeys())
        AddHotkey(list, "Move Blocks", "UP DOWN TAB", " or ")
        AddHotkey(list, "Run Program ", "ALT SHIFT R", " + ")
        AddHotkey(list, "Stop Program ", "ALT SHIFT S", " + ")
        AddHotkey(list, "Hide Tray ", "ALT SHIFT X", " + ")
        AddHotkey(list, "Zoom In ", "ALT +", " + ")
        AddHotkey(list, "Zoom Out ", "ALT -", " + ")
        AddHotkey(list, "Open Help ", "ALT SHIFT H", " + ")
        AddHotkey(list, "Navigate to Tray ", "ALT 1", " + ")
        AddHotkey(list, "Navigate to Blocks ", "ALT 2", " + ")
        AddHotkey(list, "Enter Navigation Mode ", "SHIFT ENTER", " + ")
        AddHotkey(list, "Switch to Next Tab ", "CTRL ]", " + ")
        AddHotkey(list, "Switch to Previous Tab", "CTRL [", " + ")
        section:Add(list)
        content:Add(section)
        dialog:Add(content)
        center:Add(dialog)
        return center
    end

    // A hotkey: its words, then its keys (separated by spaces), each in a
    // small box, with the separator between them. ALT is "OSSpecific": the
    // hotkey script turns it into the right key for the reader's system.
    private action AddHotkey(UnorderedList list, text words, text keys, text separator)
        BlockEditorLooks looks = quorumOptions:GetBlockEditor()
        ListItem item
        item:AddText(words)
        Array<text> keyNames = keys:Split(" ")
        integer i = 0
        repeat while i < keyNames:GetSize()
            if i > 0
                item:AddText(separator)
            end
            text keyName = keyNames:Get(i)
            Span key
            if keyName = "ALT"
                key:SetClassAttribute("OSSpecific")
            end
            SetStyle(key, looks:GetKey())
            key:AddText(keyName)
            item:AddNestedTag(key)
            i = i + 1
        end
        list:Add(item)
    end

    // The "More" menu, which script.js opens and closes.
    private action BlockMoreMenu returns Division
        Division menu
        menu:SetIdentifier("moreActionsMenu")
        // Starts hidden; script.js opens it by removing the attribute.
        menu:AddAttribute("hidden", "")
        SetStyle(menu, quorumOptions:GetBlockEditor():GetMenu())
        menu:Add(BlockMenuItem("freeformButton", "Convert to Freeform", "freeform"))
        menu:Add(BlockMenuItem("pickUpButton", "Pick Up Block", "pickUp"))
        menu:Add(BlockMenuItem("dropButton", "Drop Block", "drop"))
        menu:Add(BlockMenuItem("deleteButton", "Delete Block", "delete"))
        menu:Add(BlockMenuItem("moveUpButton", "Move Placeholder Up", "moveUp"))
        menu:Add(BlockMenuItem("moveDownButton", "Move Placeholder Down", "moveDown"))
        menu:Add(BlockMenuItem("undoButton", "Undo", "undo"))
        menu:Add(BlockMenuItem("redoButton", "Redo", "redo"))
        menu:Add(BlockMenuItem("cutButton", "Cut", "cut"))
        menu:Add(BlockMenuItem("copyButton", "Copy", "copy"))
        menu:Add(BlockMenuItem("pasteButton", "Paste", "paste"))
        return menu
    end

    private action BlockMenuItem(text identifier, text words, text command) returns Button
        Button item
        item:SetIdentifier(identifier)
        SetStyle(item, quorumOptions:GetBlockEditor():GetMenuItem())
        SetBlockButtonStates(item)
        item:AddText(words)
        item:SetOnClick("blockEditorMoreActions('" + command + "')")
        return item
    end

    // The editor's scripts, as BlockIDE added them: blockEditor.js, the
    // hotkey labels, the display's focus, the menu's focus, the jump to the
    // editor, and the start, written so it works whether load.js has run
    // or not.
    private action AddBlockEditorScripts(Division editor)
        // A reader's project starts the editor in project mode.
        text projectStart = ""
        if blockProjectMode
            projectStart = " BlockEditor.SetToProjectMode();"
        end
        Script module
        module:SetType("module")
        module:SetAddress(locations:FromSiteTop(BLOCK_EDITOR_SCRIPT) + versions:GetBlockEditorVersionQuery())
        editor:Add(module)
        editor:Add(InlineScript("
const elements = document.querySelectorAll('.OSSpecific');
let OSkey = 'UNKNOWN';
let macTabNextKey = ']';
let macTabPreviousKey = '[';
let userAgent = window.navigator.userAgent;

if (userAgent.indexOf('Win') != -1) {
  OSkey = 'ALT';
} else if (userAgent.indexOf('Mac') != -1) {
  OSkey = 'CTRL';
  let heading = document.getElementById('blockHotkeyTitle');
  heading.innerText = 'Hotkey Shortcuts (Mac)';
} else {
  OSkey = 'ALT';
}
elements.forEach(keySpan => {
  keySpan.innerHTML = OSkey;
});
"))
        editor:Add(InlineScript("
// observe the ui container for mutations
const observerUIContainer = document.getElementById('QuorumUIContainer');
const observerBlockContainer = document.getElementById('BlockUIContainer');
var observerFocused = false;
// check to see if canvas was added to the ui container
const callback = (mutationList) => {
  if(observerUIContainer.hasChildNodes()) {
    let list = observerUIContainer.getElementsByTagName('canvas');
    if (list.length != 0 && !observerFocused) {
      observerBlockContainer.display = 'none';
      observerBlockContainer.ariaHidden = 'true';
      let buttons = observerBlockContainer.getElementsByTagName('button');
      if(buttons.length > 0) buttons[0].tabIndex = 0;
      if (observerBlockContainer.contains(document.activeElement)) {
        observerUIContainer.getElementsByTagName('button')[0].focus();
        observerFocused = true;
      }
    }
  } else {
    observerBlockContainer.display = 'block';
    observerBlockContainer.ariaHidden = 'false';
    let buttons = observerBlockContainer.getElementsByTagName('button');
    if(buttons.length > 0) buttons[0].tabIndex = 0;
    observerFocused = false;
  }
};

const observer = new MutationObserver(callback);
observer.observe(observerUIContainer, {childList: true});
"))
        editor:Add(InlineScript("
  const container = document.getElementById('moreActionsMenu');
  const triggerButton = document.getElementById('moreButton');

  container.addEventListener('focusout', e => {
    if (e.relatedTarget === triggerButton) return;
    if (!container.contains(e.relatedTarget)) {
      blockEditorMoreToggle(false);
    }
  });

  container.addEventListener('keydown', e => {
    if (e.key === 'Escape') {
      blockEditorMoreToggle(false);
      triggerButton.focus();
    }
  });"))
        editor:Add(InlineScript("const blockContainer = document.getElementById('BlockUIContainer');

if (blockContainer) {
  let proxy = document.createElement('div');
  proxy.id = 'editor-shortcut-proxy';
  proxy.setAttribute('role', 'textbox');
  proxy.setAttribute('aria-label', 'Jump to editor');
  proxy.setAttribute('tabindex', '-1');
  proxy.classList.add('visually-hidden');

  proxy.addEventListener('focus', () => {
    const toggleBtn = blockContainer.querySelector('.focusButton');
    if (toggleBtn) {
      toggleBtn.click();
    } else {
      console.warn('.focusButton not found inside BlockUIContainer');
    }
  });

  blockContainer.appendChild(proxy);
} else {
  console.warn('BlockUIContainer not found — proxy element not created.');
}"))
        editor:Add(InlineScript("(function(){
  function start() {
    import('/" + BLOCK_EDITOR_SCRIPT + versions:GetBlockEditorVersionQuery() + "').then((BlockEditor) => {
      window.BLOCK_EDITOR = BlockEditor;
      function begin() {" + projectStart + " BlockEditor.Start(); }
      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', begin);
      } else {
        begin();
      }
    });
  }
  if (window.Module && window.Module.calledRun) {
    start();
  } else {
    window.Module = window.Module || {};
    var earlier = window.Module['onRuntimeInitialized'];
    window.Module['onRuntimeInitialized'] = function() {
      if (earlier) { earlier(); }
      start();
    };
  }
})();"))
    end

    private action InlineScript(text code) returns Script
        Script script
        script:SetCode(code)
        return script
    end

    /*
        Adds a search box for the topic map that follows it (TopicCards and
        TopicCard): as the reader types, only the tutorials whose name,
        description or lessons match stay shown, the matching words are
        marked, and a line says how many match. Without its script, the box
        does nothing and every tutorial stays shown, so the page's own find
        still reaches every lesson.

        Attribute: Parameter label What the box searches, such as "Search tutorials and lessons".
    */
    action TopicSearch(text label)
        if not topicScriptAdded
            AddScript(locations:FromSiteTop(TOPIC_SCRIPT))
            topicScriptAdded = true
        end
        Division search
        search:AddAttribute("role", "search")
        search:AddAttribute("data-topic-search", "")

        Label name
        name:SetElementId(TOPIC_SEARCH_IDENTIFIER)
        name:AddText(escaper:Escape(label))
        SetStyle(name, quorumOptions:GetTopicSearchLabel())
        search:AddNestedTag(name)

        Division row
        SetLayout(row, quorumOptions:GetTopicSearchRow())
        Input box
        box:SetType("search")
        box:SetIdentifier(TOPIC_SEARCH_IDENTIFIER)
        box:SetPlaceHolder(escaper:EscapeAttribute(label))
        box:SetAutocomplete(false)
        SetStyle(box, quorumOptions:GetTopicSearchBox())
        row:AddNestedTag(box)
        Button clear
        clear:SetType("button")
        clear:AddAttribute("data-topic-clear", "")
        clear:AddAttribute("hidden", "")
        clear:AddText(escaper:Escape(TOPIC_CLEAR))
        SetStyle(clear, quorumOptions:GetTopicChip())
        SetStyleOnHover(clear, quorumOptions:GetTopicChipActive())
        row:AddNestedTag(clear)
        search:AddNestedTag(row)

        Paragraph status
        status:AddAttribute("data-topic-status", "")
        status:AddAttribute("aria-live", "polite")
        SetStyle(status, quorumOptions:GetTopicStatus())
        search:AddNestedTag(status)
        Include(search)
    end

    /*
        Adds links to the topic map's groups, as a row of chips, each to the
        group's heading (written with Subsection, so its address is made
        from its words).

        Attribute: Parameter names The groups' names, in order.
    */
    action TopicJumps(Array<text> names)
        NavigationDivision jumps
        jumps:AddAttribute("aria-label", TOPICS_LABEL)
        // A navigation can't take a layout, so the chips go in a row inside
        // it: one line that scrolls sideways on a phone, wrapping from a
        // small screen up.
        Division row
        SetStyle(row, quorumOptions:GetTopicChipsBox())
        SetLayout(row, quorumOptions:GetTopicChips())
        SetLayoutFromWidth(row, constants:SMALL_SCREEN_WIDTH, quorumOptions:GetTopicChipsWrapping())
        jumps:AddNestedTag(row)
        integer i = 0
        repeat while i < names:GetSize()
            text name = names:Get(i)
            Link chip
            chip:SetAddress("#" + HeadingAddress(name))
            chip:AddText(escaper:Escape(name))
            SetStyle(chip, quorumOptions:GetTopicChip())
            SetStyleOnHover(chip, quorumOptions:GetTopicChipActive())
            SetStyleOnFocus(chip, quorumOptions:GetTopicChipActive())
            row:AddNestedTag(chip)
            i = i + 1
        end
        Include(jumps)
    end

    /*
        Starts a grid of tutorial cards in the topic map, two across on a
        wide screen, one on a phone. Add each with TopicCard.
    */
    action TopicCards
        Division grid
        grid:AddAttribute("data-topic-cards", "")
        SetLayout(grid, quorumOptions:GetTopicCards())
        Include(grid)
        topicGrid = grid
    end

    /*
        Adds a tutorial to the cards TopicCards started: its name (linked to
        its first lesson, with an address of its own, such as
        reference.html#charts), its description, and every lesson, each
        linked, so the page's find and the topic search reach them all.

        Attribute: Parameter unit The tutorial's series.
    */
    action TopicCard(PageSeries unit)
        if topicGrid = undefined
            alert("A tutorial card needs a grid to go in. Start one with TopicCards.")
        end
        Division card
        card:AddAttribute("data-topic-card", "")
        SetStyle(card, quorumOptions:GetTopicCard())
        SetLayout(card, quorumOptions:GetTopicCardLayout())

        text title = unit:GetName()
        Heading name
        name:SetScale(4)
        name:SetIdentifier(HeadingAddress(title))
        SetStyle(name, GetStyleOptions():GetHeading(4))
        Link link
        if unit:GetSize() > 0
            link:SetAddress(escaper:EscapeAttribute(locations:FromSiteTop(unit:GetEntry(0):GetLocation())))
        end
        link:AddText(escaper:Escape(title))
        SetStyle(link, GetStyleOptions():GetLink())
        name:AddNestedTag(link)
        card:AddNestedTag(name)

        text unitDescription = unit:GetDescription()
        if not unitDescription:IsEmpty()
            Paragraph words
            words:AddText(escaper:Escape(unitDescription))
            SetStyle(words, quorumOptions:GetTopicCardWords())
            card:AddNestedTag(words)
        end

        Paragraph lessons
        SetStyle(lessons, quorumOptions:GetTopicCardLessons())
        integer i = 0
        repeat while i < unit:GetSize()
            PageSeriesEntry entry = unit:GetEntry(i)
            if i > 0
                // The dot between lessons, which screen readers skip.
                Span separator
                separator:AddAttribute("aria-hidden", "true")
                separator:AddText(escaper:Escape(LESSON_SEPARATOR))
                lessons:AddNestedTag(separator)
            end
            Link lesson
            lesson:SetAddress(escaper:EscapeAttribute(locations:FromSiteTop(entry:GetLocation())))
            lesson:AddText(escaper:Escape(entry:GetTitle()))
            SetStyle(lesson, GetStyleOptions():GetLink())
            lessons:AddNestedTag(lesson)
            i = i + 1
        end
        card:AddNestedTag(lessons)
        topicGrid:AddNestedTag(card)
    end

    // A heading's address from its words, by WebPage's rule: lower case,
    // letters and digits kept, anything else one hyphen ("Graphics and
    // games" becomes "graphics-and-games").
    private action HeadingAddress(text words) returns text
        text address = ""
        text lowered = words:ToLowerCase()
        boolean lastWasHyphen = true
        integer i = 0
        repeat while i < lowered:GetSize()
            text character = lowered:GetCharacter(i)
            if ADDRESS_CHARACTERS:Contains(character)
                address = address + character
                lastWasHyphen = false
            elseif not lastWasHyphen
                address = address + "-"
                lastWasHyphen = true
            end
            i = i + 1
        end
        if address:EndsWith("-")
            address = address:GetSubtext(0, address:GetSize() - 1)
        end
        return address
    end

    /*
        Starts a grid of course cards, as the Learn page lists its courses:
        three across on a wide screen, one on a phone. Add each with
        CourseCard, and its details with CourseDetail.

        Attribute: Example
        class MyPage is QuorumPage
            action Setup
                Section("Quorum Courses")
                CourseCards()
                CourseCard("Core Track", "/lessons/core.html", "media/core.png", "The Core Track's page.", "Learn the basics.")
                CourseDetail("Grades: 6-12")
            end
        end
    */
    action CourseCards
        Division grid
        SetLayout(grid, quorumOptions:GetCourseCards())
        Include(grid)
        courseGrid = grid
        courseBody = undefined
        courseDetails = undefined
        greyCardBodies = false
    end

    /*
        Adds a course to the cards CourseCards started: its picture across
        the top, its name (a heading, linked to the course) and its
        description.

        Attribute: Parameter title The course's name.
        Attribute: Parameter address The course's page, such as "/lessons/core.html", or "" for a card with no link.
        Attribute: Parameter picture The picture's location inside the relative folder ("/media/..." works too), or "" for none.
        Attribute: Parameter pictureDescription What the picture shows.
        Attribute: Parameter cardDescription The course in a sentence or two, or "" for none.
    */
    action CourseCard(text title, text address, text picture, text pictureDescription, text cardDescription)
        if courseGrid = undefined
            alert("A course card needs a grid to go in. Start one with CourseCards.")
        end
        Division card
        SetStyle(card, quorumOptions:GetCourseCard())

        if not picture:IsEmpty()
            text location = picture
            if location:StartsWith("/")
                location = location:GetSubtext(1)
            end
            Image image
            image:SetAddress(escaper:EscapeAttribute(locations:FromSiteTop(locations:Join(GetWebSite():GetRelativeFolder(), location))))
            image:SetAlternate(escaper:EscapeAttribute(pictureDescription))
            SetStyle(image, quorumOptions:GetCourseCardPicture())
            card:AddNestedTag(image)
        end

        Division body
        if greyCardBodies
            SetStyle(body, quorumOptions:GetGreyCardBody())
        else
            SetStyle(body, quorumOptions:GetCourseCardBody())
        end
        SetLayout(body, quorumOptions:GetCourseCardLayout())
        // A card's heading is one level under the part it is in (h2 on a
        // page with no sections), so no heading level is skipped.
        integer level = 3
        if GetCurrentPart() = undefined
            level = 2
        end
        Heading name
        name:SetScale(level)
        SetStyle(name, GetStyleOptions():GetHeading(level))
        if address:IsEmpty()
            // A card about something with no page, such as a person.
            name:AddText(escaper:Escape(title))
        else
            Link link
            link:SetAddress(escaper:EscapeAttribute(address))
            link:AddText(escaper:Escape(title))
            SetStyle(link, GetStyleOptions():GetLink())
            name:AddNestedTag(link)
        end
        body:AddNestedTag(name)
        if not cardDescription:IsEmpty()
            Paragraph words
            words:AddText(escaper:Escape(cardDescription))
            body:AddNestedTag(words)
        end
        card:AddNestedTag(body)
        courseGrid:AddNestedTag(card)
        courseBody = body
        courseDetails = undefined
    end

    /*
        Adds a link at the bottom of the card CourseCard added last, such as
        "Send Report" when the card's words point to it.

        Attribute: Parameter words The link's words.
        Attribute: Parameter address Where it goes.
    */
    action CourseCardLink(text words, text address)
        if courseBody = undefined
            alert("A card link needs a card. Add one first with CourseCard.")
        end
        Paragraph paragraph
        Link link
        link:SetAddress(escaper:EscapeAttribute(address))
        link:AddText(escaper:Escape(words))
        SetStyle(link, GetStyleOptions():GetLink())
        paragraph:AddNestedTag(link)
        courseBody:AddNestedTag(paragraph)
    end

    /*
        Adds a line to the "Details" of the course CourseCard added last,
        such as "Grades: 6-12". The first line makes the "Details"
        disclosure, which opens to them all.

        Attribute: Parameter words The line.
    */
    action CourseDetail(text words)
        if courseBody = undefined
            alert("A course detail needs a course. Add one first with CourseCard.")
        end
        if courseDetails = undefined
            Details details
            Summary label
            label:AddText(escaper:Escape(COURSE_DETAILS))
            SetStyle(label, quorumOptions:GetUnitLessonsLabel())
            details:AddNestedTag(label)
            Division lines
            SetLayout(lines, quorumOptions:GetCourseCardLayout())
            details:AddNestedTag(lines)
            courseBody:AddNestedTag(details)
            courseDetails = lines
        end
        Paragraph line
        line:AddText(escaper:Escape(words))
        courseDetails:AddNestedTag(line)
    end

    /*
        Starts a row of choices: tiles, each a link with an icon and a few
        words, such as "Try Online" and "Try Offline". Add each with Choice.

        Attribute: Example
        class MyPage is QuorumPage
            action Setup
                Subsection("New to Quorum?")
                Paragraph("Try it online or offline.")
                Choices()
                Choice("Try Online", "/tutorials/online/starting.html", "media/userInterface/SVG/choice-online.svg")
                Choice("Practice Problems", "/problems.html", "media/userInterface/SVG/choice-practice.svg")
            end
        end
    */
    action Choices
        Division grid
        SetLayout(grid, quorumOptions:GetChoices())
        Include(grid)
        choiceGrid = grid
    end

    /*
        Adds a choice to the tiles Choices started: one link, its icon
        beside its words. The icon is decoration, so readers hear only the
        words.

        Attribute: Parameter words The choice's words, such as "Try Online".
        Attribute: Parameter address Where it goes, such as "/tutorials/online/starting.html".
        Attribute: Parameter icon An SVG icon's location inside the relative folder, or "" for none.
    */
    action Choice(text words, text address, text icon)
        if choiceGrid = undefined
            alert("A choice needs tiles to go in. Start them with Choices.")
        end
        choiceGrid:AddNestedTag(NewChoiceTile(words, address, icon))
    end

    // A choice tile: one link, its icon (decoration) beside its words.
    private action NewChoiceTile(text words, text address, text icon) returns Link
        Link tile
        tile:SetAddress(escaper:EscapeAttribute(address))
        SetLayout(tile, quorumOptions:GetChoiceTileLayout())
        SetStyle(tile, quorumOptions:GetChoiceTile())
        SetStyleOnHover(tile, quorumOptions:GetChoiceTileActive())
        SetStyleOnFocus(tile, quorumOptions:GetChoiceTileActive())
        if not icon:IsEmpty()
            File file = GetWebSite():GetRelativeFile(icon)
            if not file:Exists()
                alert("There's no icon at " + icon + ".")
            end
            Span picture
            picture:AddAttribute("aria-hidden", "true")
            picture:AddText(file:Read())
            tile:AddNestedTag(picture)
        end
        Span name
        name:AddText(escaper:Escape(words))
        tile:AddNestedTag(name)
        return tile
    end

    /*
        Adds a card for one unit of a track: its name, linked to the
        unit's first lesson, its description, and a "Lessons" disclosure
        that opens to its lessons, numbered and linked. Each card is its own
        part: a section, or a subsection when the page has already started
        a section (such as "About the Course"), so its heading is in the
        page's contents.

        Attribute: Parameter title The unit's name on the card.
        Attribute: Parameter unit The unit.

        Attribute: Example
        class MyTrack is QuorumPage
            Array<PageSeries> units = undefined

            action Setup
                Title("Core Track")
                integer i = 0
                repeat while i < units:GetSize()
                    PageSeries unit = units:Get(i)
                    UnitCard(unit:GetName(), unit)
                    i = i + 1
                end
            end
        end
    */
    action UnitCard(text title, PageSeries unit)
        UnitCard(title, unit, "")
    end

    /*
        Adds a card for one unit of a track, as UnitCard does, with a
        small picture beside its words. The picture is decoration: the
        card's name says what the unit is.

        Attribute: Parameter title The unit's name on the card.
        Attribute: Parameter unit The unit.
        Attribute: Parameter picture The picture's location inside the relative folder, or "" for none.
    */
    action UnitCard(text title, PageSeries unit, text picture)
        if unitCardLevel = 0
            if GetCurrentPart() = undefined
                unitCardLevel = 2
            else
                unitCardLevel = 3
            end
        end
        text address = ""
        if unit:GetSize() > 0
            address = locations:FromSiteTop(unit:GetEntry(0):GetLocation())
        end
        // The heading is written with plain words, so it is named and goes
        // in the page's contents, then its words become a link.
        if unitCardLevel = 2
            Section(title)
        else
            Subsection(title)
        end
        Heading heading = GetLastHeading()
        heading:Remove(heading:GetTag(0))
        Link headingLink
        headingLink:SetAddress(escaper:EscapeAttribute(address))
        headingLink:AddText(escaper:Escape(title))
        SetStyle(headingLink, GetStyleOptions():GetLink())
        heading:AddNestedTag(headingLink)
        Card()

        // The unit's words: its description, then its lessons, numbered
        // and linked, in a "Lessons" disclosure.
        Division words
        text unitDescription = unit:GetDescription()
        if not unitDescription:IsEmpty()
            Paragraph description
            description:AddText(escaper:Escape(unitDescription))
            words:AddNestedTag(description)
        end
        Details lessons
        Summary label
        label:AddText(escaper:Escape(UNIT_LESSONS + " (" + unit:GetSize() + ")"))
        SetStyle(label, quorumOptions:GetUnitLessonsLabel())
        lessons:AddNestedTag(label)
        OrderedList list
        SetStyle(list, GetStyleOptions():GetNumberedList())
        integer i = 0
        repeat while i < unit:GetSize()
            PageSeriesEntry entry = unit:GetEntry(i)
            ListItem item
            Link link
            link:SetAddress(escaper:EscapeAttribute(locations:FromSiteTop(entry:GetLocation())))
            link:AddText(escaper:Escape(entry:GetTitle()))
            SetStyle(link, GetStyleOptions():GetLink())
            item:AddNestedTag(link)
            list:AddNestedTag(item)
            i = i + 1
        end
        lessons:AddNestedTag(list)
        words:AddNestedTag(lessons)

        if picture:IsEmpty()
            Include(words)
        else
            // The picture beside the words, as the old cards had it; the
            // words narrow beside it on a small screen.
            text location = picture
            // A series' picture may be written from the site's top ("/media/...").
            if location:StartsWith("/")
                location = location:GetSubtext(1)
            end
            Image image
            image:SetAddress(escaper:EscapeAttribute(locations:FromSiteTop(locations:Join(GetWebSite():GetRelativeFolder(), location))))
            image:SetAlternate("")
            SetStyle(image, quorumOptions:GetUnitPicture())
            SetStyle(words, quorumOptions:GetUnitWords())
            Division row
            SetLayout(row, quorumOptions:GetUnitLayout())
            row:AddNestedTag(image)
            row:AddNestedTag(words)
            Include(row)
        end
    end

    /*
        Adds a picture from another website, at its full address, such as a
        sponsor's logo. (Image takes a location inside this site.)

        Attribute: Parameter address The picture's full address, such as "https://www.yourkit.com/images/yklogo.png".
        Attribute: Parameter imageDescription What the picture shows.
    */
    action OutsideImage(text address, text imageDescription)
        if imageDescription:IsEmpty()
            alert("The picture at " + address + " needs a description.")
        end
        Image picture
        picture:SetAddress(escaper:EscapeAttribute(address))
        picture:SetAlternate(escaper:EscapeAttribute(imageDescription))
        Include(picture)
    end

    /*
        Adds a tracking picture from another site, such as Code.org's
        Hour of Code counter: hidden, with nothing for readers, but still
        loaded, so the other site counts the visit.

        Attribute: Parameter address The picture's full address.
    */
    action TrackingImage(text address)
        Image picture
        picture:SetAddress(escaper:EscapeAttribute(address))
        picture:SetAlternate("")
        picture:AddAttribute("hidden", "")
        Include(picture)
    end

    // A slide navigation button, in the site's slide button look.
    private action SlideButton(text words, text marker) returns Button
        Button button
        button:SetType("button")
        button:AddAttribute(marker, "")
        button:AddText(escaper:Escape(words))
        SetStyle(button, quorumOptions:GetSlideButton())
        // The script copies these classes to each slide's button, and
        // marks the current one with aria-current.
        SetStyleWhenCurrent(button, quorumOptions:GetSlideButtonCurrent())
        SetStyleWhenDisabled(button, quorumOptions:GetSlideButtonUnavailable())
        return button
    end

    /*
        Adds working HTML from a file in the site's relative folder, such as
        buttons a lesson asks readers to try with a screen reader. The file's
        HTML goes into the page as it is, with its own scripts and styles.

        Attribute: Parameter location The file's location inside the relative folder.

        Attribute: Example
        class MyLesson is QuorumPage
            action Setup
                Section("Engage")
                Demonstration("media/Accessibility/IntroductionToARIA/ButtonDemo.html")
            end
        end
    */
    action Demonstration(text location)
        File file = GetWebSite():GetRelativeFile(location)
        if not file:Exists()
            alert("There's no demonstration at " + location + ".")
        end
        Division demonstration
        demonstration:AddText(file:Read())
        Include(demonstration)
    end

    // An editor with its files, its script added to the page once.
    private action AddEditor(text editorTitle, CodeForIDE code) returns IDE
        if not editorScriptAdded
            AddScript(locations:FromSiteTop(EDITOR_SCRIPT_START + versions:GetWidgetVersion() + SCRIPT_ENDING))
            editorScriptAdded = true
        end
        editorCount = editorCount + 1
        IDE editor
        editor:Init()
        editor:SetIdentifier(EDITOR_IDENTIFIER_START + editorCount)
        editor:SetLightTheme()
        editor:SetCodeForIDE(code:GetJsonArray())
        editor:SetIdeTitle(escaper:Escape(editorTitle))
        Include(editor)
        currentEditor = undefined
        return editor
    end

    /*
        Adds math, written in MathML in a file in the site's relative
        folder. The script that draws math is added to the page once.

        Attribute: Parameter location The file's location inside the relative folder.
    */
    action Math(text location)
        AddMath(GetWebSite():GetRelativeFile(location):GetPath())
    end

    /*
        Adds math from a MathML file outside the site's folder, by its path
        from the project folder, such as "examples/MathXML/Mean.xml". Locations
        stay inside the site everywhere else; this is for the few files kept
        elsewhere. Use Math for a file inside the site.

        Attribute: Parameter path The file's path from the project folder.

        Attribute: Example
        class MyLesson is QuorumPage
            action Setup
                Section("The mean")
                MathFromProject("examples/MathXML/Mean.xml")
            end
        end
    */
    action MathFromProject(text path)
        File file
        file:SetPath(path)
        if not file:Exists()
            alert("There's no math at " + path + ".")
        end
        AddMath(path)
    end

    // Math from a file's path, its script added to the page once.
    private action AddMath(text path)
        if not mathScriptAdded
            AddScript(locations:FromSiteTop(MATH_SCRIPT))
            mathScriptAdded = true
        end
        MathML math
        math:AddSource(path)
        Include(math)
    end

    /*
        Adds a JSON file from the site's relative folder, shown exactly as
        written, with JSON highlighting. The highlighter's JSON grammar is
        added to the page once.

        Attribute: Parameter location The file's location inside the relative folder.

        Attribute: Example
        class MyLesson is QuorumPage
            action Setup
                Section("The scene file")
                JsonExampleFromFile("sources/tutorials/scenes/SceneFile.json")
            end
        end
    */
    action JsonExampleFromFile(text location)
        // Deferred, so it runs after the highlighter itself, which the
        // site's frame adds later, and before the highlighter colors the
        // page.
        if not jsonScriptAdded
            Script grammar = AddScript(JSON_HIGHLIGHTER)
            grammar:SetDefer(true)
            jsonScriptAdded = true
        end
        CodeExampleFromFile(location, JSON)
    end

    action StandardsList(StandardSet set)
        Division cards
        Include(cards)
        tracker:AddList(me, cards, set)
    end
end
