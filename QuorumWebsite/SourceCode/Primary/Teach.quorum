use Libraries.Web.Page.QuorumPage

/*
    Getting Social.
    Converted from the old Lesson page by plan 13's generator: the same
    words, now without Tailwind.
*/
class Teach is QuorumPage

    on create
        SetLocation("teach.html")
        // The name lists and links use, and the series and track it belongs
        // to: its section and picture.
        SetShortTitle("Teach")
        // For search engines and link previews, and what lists of pages say.
        SetDescription("Learn about how to teach the Quorum programming language for free in your classroom using our professional and standards based curriculum.")
        SetSummary("how to get setup for teaching Quorum in the classroom.")
    end

    action Setup
        SetWebPageTitle("Getting Social - Quorum Programming Language")
        Title("Getting Social")
        Paragraph("Connect with others using Quorum")
        ProfessionalDevelopment()
        MailingListAndFacebook()
        AccessCSForAll()
        CurriculumOverview()
        PartnerWithUs()
    end

    private action ProfessionalDevelopment
        Section("Professional Development")
        Paragraph("Every year, we hold professional development for teachers to train in the field of computer science. We call this the Experience Programming in Quorum conference (EPIQ).")
        Paragraph():Link("Learn more", "/epiq.html")
    end

    private action MailingListAndFacebook
        Section("Mailing List and Facebook")
        Paragraph("Join the mailing list, Facebook page, or otherwise learn about our community.")
        Paragraph():Link("Learn more", "/community.html")
    end

    private action AccessCSForAll
        Section("AccessCSForAll")
        Paragraph("Learn about the AccessCSForAll program, a collaboration between the University of Washington and the University of Nevada, Las Vegas that works to make programming more accessible to people with disabilities.")
        Paragraph():Link("Learn more", "https://www.washington.edu/accesscomputing/accesscsforall")
    end

    private action CurriculumOverview
        Section("Curriculum Overview")
        Paragraph("Learn at a high level about the Quorum curriculum, the kinds of activities we offer to do in the classroom, and more.")
        Paragraph():Link("Learn more", "/lessons/overview.html")
    end

    private action PartnerWithUs
        Section("Partner with Us")
        Paragraph("The Quorum project is not just a language, involving more than 30 school districts and a diverse network of teachers across the globe. If you would like to become an official Quorum partner, get in touch!")
        Paragraph():Link("Learn more", "/partners.html")
    end
end
