use Libraries.Web.Page.QuorumPage

/*
    The Access Charts page (plan 13 phase 5D): a banner, then the Access
    Charts widget.
*/
class AccessChartsPage is QuorumPage
    on create
        SetLocation("widgets/accessCharts.html")
        SetDescription("Sample the libraries and features available out of the box in the Quorum programming language.")
    end

    action Setup
        SetWebPageTitle("Quorum Reference Pages - Quorum Programming Language")
        Banner("Access Charts", "A widget for generating accessible charts or downloading them as images.", "media/userInterface/referencePageBunny.png", "Quincy the Rabbit stacking bricks saying 'classes', 'forms', 'Data frame', 'Actions', 'syntax'")
        AccessChartsWidget()
    end
end
