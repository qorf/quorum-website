use Libraries.Web.Page.QuorumPage

/*
    The home page (plan 13 phase 5C), as close to its old look as possible
    (the user, 2026-11-01): a light blue hero band across the window, the
    "Accessible, Friendly, Proven" switcher, Data Science with the block
    editor, the Discord strip, and professional development with photos.
    Its old headings were h1 three times; they are h2 now, in the old size.
*/
class Index is QuorumPage
    on create
        SetLocation("index.html")
    end

    action Setup
        SetWebPageTitle("The Quorum Programming Language")
        HeroBanner("Quorum", "media/userInterface/SVG/blackQuorumLogo.svg", "Quorum Logo", "media/userInterface/quorumAssets/bunnyMain.png", "Tech-savvy bunny named Quincy with glasses working on a laptop"):Text("The World's "):Link("First Evidence Oriented", "/evidence.html"):Text(" Programming Language")
        BannerChoice("Try it Online", "/problems/output/start.html", "")
        BannerChoice("EPIQ 2026", "/epiq.html", "")

        Switcher()
        SwitcherItem("Accessible", "Born Accessible", "Quorum is conscious about its user base and focuses on making the language intuitive for individuals with disabilities.", "media/userInterface/quorumAssets/accessibility.png", "Thoughtful bunny pondering symbols")
        SwitcherItem("Friendly", "User Friendly", "Quorum is designed using simple words that are easy to interpret", "media/userInterface/quorumAssets/friendly.png", "Person admiring a radiant bespectacled bunny")
        SwitcherItem("Proven", "Evidence Based", "Quorum's design uses studies that experts have checked about how people behave. It changes over time if there is new data.", "media/userInterface/quorumAssets/proven.png", "Surprised bunny with glasses reading a note")

        CenteredSection("Data Science made simple")
        NarrowParagraph("Quorum allows you to ease into the world of data science. You can create charts, clean up your data, and conduct descriptive statistical tests. Play around with the chart, you can even interact with it!")
        BlockEditor("Histogram.quorum", "examples/Charts/Histogram2.quorum", "/palette/frontPage.xml", true, true)
        NarrowParagraph("Quorum's chart creator has the ability to turn any chart accessible. Try it out today!")
        OutlineButton("Go to Access Charts", "/widgets/accessCharts.html")
        NoticeStrip("media/userInterface/quorumAssets/carrotMegaphone.png", "Megaphone made out of a carrot", "Join the Community Discord", "Get Quorum support and help advocate accessibility standards!")
        NoticeButton("Join Now", "https://discord.gg/6yTVQq4")

        CenteredSection("Engage in Professional Development")
        Paragraph("Every summer the Quorum team hosts a conference to teach professionals and educators about Quorum and the latest developments for accessible programming. This event is open to the public and is free. Learn how to program and become a catalyst in helping push for computer science access for all!")
        PictureGrid()
        GridPicture("media/userInterface/quorumAssets/home-community1.png", "Woman in wheelchair using a laptop")
        GridPicture("media/userInterface/quorumAssets/home-community2.png", "Two young men working on laptops at a table")
        GridPicture("media/userInterface/quorumAssets/home-community3.png", "Instructor guiding a group of adults around a table with laptops")
        GridPicture("media/userInterface/quorumAssets/home-community4.png", "Instructor guiding students using laptops in a classroom")
        Paragraph("Quorum Language is more than just a language. It’s an on-going project in an effort to give access to programming for all individuals. In this community, you will meet teachers, developers, researchers, designers, and scholars who working together to make a difference. In this diverse community, you are welcome to ask for help or participate in the many on-going projects!")
        DarkButton("Learn about EPIQ", "/epiq.html")
    end
end
