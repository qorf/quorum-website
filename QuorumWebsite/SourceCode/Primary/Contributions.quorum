use Libraries.Web.Page.QuorumPage

/*
    Contributors.
    Converted from the old Lesson page by plan 13's generator: the same
    words, now without Tailwind.
*/
class Contributions is QuorumPage

    on create
        SetLocation("contributors.html")
        // The name lists and links use, and the series and track it belongs
        // to: its section and picture.
        SetShortTitle("Contributions")
        // For search engines and link previews, and what lists of pages say.
        SetDescription("This page describes contributions from various organizations on the quorum project.")
        SetSummary("A list of contributors")
    end

    action Setup
        SetWebPageTitle("Contributors - Quorum Programming Language")
        Title("Contributors")
        Paragraph("Inventing these tools is not magic. Thank you so much to the community!")
        TechnicalContributions()
        FundedBy()
        OpenSourceLicenses()
    end

    private action TechnicalContributions
        Section("Technical Contributions")
        Paragraph("We would like to thank these open source devs for inspiring us so much:")
        BulletList()
        ListItem():Link("ANTLR", "https://www.antlr.org/")
        ListItem():Link("Box2D", "https://box2d.org/")
        ListItem():Link("Bullet", "https://github.com/bulletphysics/bullet3")
        ListItem():Link("GLFW", "https://www.glfw.org/")
        ListItem():Link("LibGDX", "https://libgdx.badlogicgames.com/")
        ListItem():Link("LWJGL", "https://www.lwjgl.org/")
        ListItem():Link("OpenAL", "https://www.openal.org/")
        ListItem():Link("OpenGL", "https://www.opengl.org/")
    end

    private action FundedBy
        Section("Funded by")
        Paragraph("Open Source does not exist without funding. These folks helped:")
        BulletList()
        ListItem():Link("The National Science Foundation", "https://www.nsf.gov/")
        ListItem():Link("Delta Gamma", "https://www.deltagamma.org/")
        ListItem():Link("The American Printing House for the Blind", "https://www.aph.org/")
        ListItem():Link("Readers Digest Partners for Sight", "https://partnersforsight.org/")
        ListItem():Link("Infosys Pathfinders", "https://pathfinders.onwingspan.com/web/en/login")
        ListItem():Link("University of Nevada, Las Vegas", "https://www.unlv.edu/")
        ListItem():Link("University of Washington", "https://www.washington.edu/")
        ListItem():Link("Google Foundation", "https://www.google.org/")
        ListItem():Link("Quorum Outreach and Research Foundation", "https://qorf.org/")
    end

    private action OpenSourceLicenses
        Section("Open Source Licenses")
        Paragraph("Some companies have provided us open source licenses to use their great products. Thanks!")
        BulletList()
        ListItem():Link("Bitbucket", "https://bitbucket.org")
        ListItem():Link("Yourkit", "https://bitbucket.org")
        ListItem():Link("Code.org", "https://code.org")
        OutsideImage("https://www.yourkit.com/images/yklogo.png", "The yourkit logo image.")
        Paragraph("YourKit supports open source projects with its full-featured Java Profiler. YourKit, LLC is the creator of "):Link("YourKit Java Profiler", "https://www.yourkit.com/java/profiler/index.jsp"):Text(" and "):Link("YourKit .NET Profiler", "https://www.yourkit.com/.net/profiler/index.jsp"):Text(", innovative and intelligent tools for profiling Java and .NET applications.")
    end
end
