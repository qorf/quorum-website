use Libraries.Web.Page.QuorumPage

/*
    The Bugs page (plan 13 phase 5B): a banner, the six places to report
    bugs as cards (each name links to where to report), then other issues.
*/
class Bugs is QuorumPage
    on create
        SetLocation("bugs.html")
        SetDescription("Contribute bug reports to the Quorum programming language project.")
    end

    action Setup
        SetWebPageTitle("Quorum Bugs - Quorum Programming Language")
        Banner("Need Help? We got you", "This page has links to many pages that are available for getting help. You can also send bug reports to the team", "media/userInterface/quorumAssets/UP AND UP 1.png", "Quincy the Rabbit jumping up on a bar graph")
        Section("Bug Reports")
        Paragraph("Quorum Programming Language has a lot of moving parts to it, therefore we are constantly working to provide the best experience to our users. If you see something that can be improved or might be a bug, feel free to contact us.")
        CourseCards()
        CourseCard("Quorum Bugs", "https://github.com/qorf/quorum-language/issues", "media/userInterface/quorumAssets/quorumCardIcon.png", "Quorum Language", "If you see any issues while running Quorum, send bug reports on Quorum language here by clicking the button below.")
        CourseCardLink("Send Report", "https://github.com/qorf/quorum-language/issues")
        CourseCard("Quorum Studio Bugs", "https://github.com/qorf/quorum-studio/issues", "media/userInterface/quorumAssets/quorumStudioCard.png", "Quorum Studio", "If you see any issues while using Quorum Studio, send bug reports on Quorum Studio here by clicking the button below.")
        CourseCardLink("Send Report", "https://github.com/qorf/quorum-studio/issues")
        CourseCard("Website Bugs", "https://github.com/qorf/quorum-website/issues", "media/userInterface/quorumAssets/quorumWebsiteCard.png", "Website Bugs", "If you see any issues while navigating the website, send bug reports on Quorum Website here by clicking the button below.")
        CourseCardLink("Send Report", "https://github.com/qorf/quorum-website/issues")
        CourseCard("Widgets Bugs", "https://github.com/qorf/CSP-Widgets/issues", "media/userInterface/quorumAssets/quorumWidgetsCard.png", "Quorum Widgets", "If you see any issues while using CSP widgets, send bug reports on these widgets here by clicking the button below.")
        CourseCardLink("Send Report", "https://github.com/qorf/CSP-Widgets/issues")
        CourseCard("Quorum Curriculum", "https://github.com/qorf/curriculum/issues", "media/userInterface/quorumAssets/quorumCurriculumCard.png", "Curriculum Bugs", "If you see any issues or out of date content, send bug reports on the Quorum content by clicking the button below.")
        CourseCardLink("Send Report", "https://github.com/qorf/curriculum/issues")
        CourseCard("Quorum Web Server", "https://github.com/qorf/quorum-server/issues", "media/userInterface/quorumAssets/quorumWebServerCard.png", "Web Server Bugs", "If you see any server problems, send bug reports on the Quorum Web Server by clicking the button below.")
        CourseCardLink("Send Report", "https://github.com/qorf/quorum-server/issues")
        Section("Other Issues? Contact Us")
        Paragraph("If you have a question or issue not related to the above categories, please contact "):Link("Quorum Forum", "https://groups.google.com/g/quorum-language"):Text(", and let us know how we can help!")
        NumberedList()
        ListItem("Login to a google account")
        ListItem("Select the "):DoubleQuote():Text("Ask to join group"):DoubleQuote():Text(" button")
    end
end
