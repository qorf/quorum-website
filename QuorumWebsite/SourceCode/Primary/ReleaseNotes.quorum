use Libraries.Web.Page.QuorumPage

/*
    The release notes: every release of Quorum and Quorum Studio, newest
    first, grouped by year. Each release is a card, and "On this page"
    lists the years and their releases. The words are the release notes
    as first written.
*/
class ReleaseNotes is QuorumPage
    on create
        SetLocation("release.html")
    end

    action Setup
        SetWebPageTitle("Release Notes - Quorum Programming Language")
        SetDescription("Read about how the Quorum programming language has changed over time.")

        Title("Quorum Release Notes")
        Paragraph("We post changes to Quorum here")

        Section("2026")
        Quorum14_0()

        Section("2025")
        QuorumStudio7_3()
        QuorumStudio7_2()
        QuorumStudio7_1()
        QuorumStudio7_0()

        Section("2024")
        QuorumStudio6_3()
        QuorumStudio6_2()
        QuorumStudio6_1()
        QuorumStudio6()

        Section("2023")
        QuorumStudio5_1()
        QuorumStudio5_0_4()
        QuorumStudio5_0_3()
        QuorumStudio5_0_2()
        QuorumStudio5_0_1()
        QuorumStudio5_0()
        QuorumStudio4_6()

        Section("2022")
        QuorumStudio4_5()
        QuorumStudio4_0()
        QuorumStudio3_5()

        Section("2021")
        QuorumStudio3_0_1()
        QuorumStudio3_0()

        Section("2020")
        QuorumStudio2_3()
        QuorumStudio2_2()
        QuorumStudio2_1()
        QuorumStudio2_0()
        Quorum8_0()

        Section("2019")
        QuorumStudio1_0()
        Quorum7_5()
        Quorum7_0()

        Section("2018")
        Quorum6_0_5()
        Quorum6_0_1()
        Quorum6_0()
        QuorumPatches()

        Section("2017")
        Quorum5_0_13()
        Quorum5_0_11()
        Quorum5_0()
        Quorum4_0_6()

        Section("2016")
        Quorum4_0_5()
        Quorum4_0_4()
        Quorum4_0()

        Section("2015")
        Quorum3_0()
        Quorum3_0_2()
        Quorum3_0_3()
        Quorum3_0_4()
        Quorum3_0_5()
        Quorum3_0_6()

        Section("2013")
        Quorum2_1()
        Quorum2_0_1()
