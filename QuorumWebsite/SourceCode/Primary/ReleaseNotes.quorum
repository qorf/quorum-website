    private action Quorum3_0_5
        Subsection("Quorum 3.0 Update 41 July 8th, 2015")
        Card()
        Paragraph("This update is deployed to NetBeans only, but not as a separate zip file on the release servers.")

        BulletList()
        ListItem("Fixed a bug with scaling in the game engine.")
        ListItem("Fixed a bug with code completion showing the wrong documentation.")
        ListItem("Fixed a bug with Lego Robot files not properly being sent over to the robot on Windows.")
