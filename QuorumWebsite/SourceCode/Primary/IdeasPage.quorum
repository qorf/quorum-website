use Libraries.Web.Page.QuorumPage

/*
    Google Summer of Code Ideas Page.
    Converted from the old Lesson page by plan 13's generator: the same
    words, now without Tailwind.
*/
class IdeasPage is QuorumPage

    on create
        SetLocation("ideas.html")
        // The name lists and links use, and the series and track it belongs
        // to: its section and picture.
        SetShortTitle("Google Summer of Code Ideas Page")
        SetCardImage("/media/basics/actions.png")
        // For search engines and link previews, and what lists of pages say.
        SetDescription("Some possible ideas for Google Summer of Code applicants.")
        SetSummary("ideas for the Google Summer of Code.")
    end

    action Setup
        SetWebPageTitle("Ideas Page Google Summer of Code - Quorum Programming Language")
        Title("Google Summer of Code Ideas Page")
        Paragraph("These are some ideas for projects, but others are welcome.")
        IdeasFor2018()
    end

    private action IdeasFor2018
        Section("Ideas for 2018")
        Paragraph("Applicants can pitch any project, but here are several ideas related to the upcoming Quorum 6 release:")
        BulletList()
        ListItem("Accessible game editing tools using the Quorum Game Engine")
        ListItem("Accessible GUI libraries for Quorum")
        ListItem("2D or 3D accessible game using the Quorum Game Engine")
        ListItem("Mobile projects based on Android")
        ListItem("Other ideas are welcome")
    end
end
