use Libraries.Web.Page.QuorumPage
use Libraries.System.File
use Libraries.Data.Formats.JavaScriptObjectNotation

/*
    The Learn page: a banner, "Using Quorum" with its "New to Quorum?"
    choices (design C, plan 13 phase 5), the courses as a grid of cards
    (design A), each with its details, and an editor to try Quorum. The
    courses come from html/json/courses.json.
*/
class Learn is QuorumPage
    // A double quote, for code that holds one.
    text dq = ""

    constant text COURSES_FILE = "json/courses.json"

    on create
        SetLocation("learn.html")
        SetDescription("Learn the Quorum programming language in tracks dedicated to audio or visual games, robotics, or through core computer science principles.")
    end

    action Setup
        dq = dq:GetDoubleQuote()
        SetWebPageTitle("Learn Quorum - Quorum Programming Language")
        Banner("Learn Something New in Quorum", "Create advanced programs, understand data like a pro, and help make programming easy for everyone, regardless of your age.", "media/userInterface/quorumAssets/learnHeader.png", "Two cartoon rabbits wearing glasses. The rabbit on the left is holding a game controller, while the rabbit on the right is holding up a paper with a pie chart on it.")
        UsingQuorum()
        Courses()
        NotSureWhereToStart()
    end

    private action UsingQuorum
        Section("Using Quorum")
        Paragraph("If you want to use Quorum offline, "):Link("install it first.", "/download.html")
        Subsection("New to Quorum?")
        Card()
        Paragraph("Quorum is awesome for beginners and pros. Try it online for learning or solving practice problems and offline for larger projects")
        Choices()
        Choice("Try Online", "/tutorials/online/starting.html", "media/userInterface/SVG/choice-online.svg")
        Choice("Practice Problems", "/problems.html", "media/userInterface/SVG/choice-practice.svg")
        Choice("Try Offline", "/tutorials/blocks/gettingStartedBlocks.html", "media/userInterface/SVG/choice-offline.svg")
    end

    // Each group of courses ("Quorum Courses", "Hour of Code", "Legacy
    // Courses"): its heading, its line, and a card for each course.
    private action Courses
        File file = GetWebSite():GetRelativeFile(COURSES_FILE)
        JavaScriptObjectNotation notation
        notation:Read(file:Read())
        // As the old page read it: an array's key, then the array itself.
        JavaScriptObjectNotation sections = notation:GetObject("sections")
        JavaScriptObjectNotation groups = sections:Get(0)
        integer i = 0
        repeat while i < groups:GetSize()
            JavaScriptObjectNotation group = groups:Get(i)
            text name = group:GetValue("name")
            Section(name)
            Paragraph(GroupDescription(name))
            CourseCards()
            JavaScriptObjectNotation coursesKey = group:GetObject("courses")
            JavaScriptObjectNotation courses = coursesKey:Get(0)
            integer j = 0
            repeat while j < courses:GetSize()
                Course(courses:Get(j))
                j = j + 1
            end
            i = i + 1
        end
    end

    // The line under each group's heading, as the old page had it.
    private action GroupDescription(text name) returns text
        if name = "Quorum Courses"
            return "Each track provides curriculum that can be freely used in the classroom."
        elseif name = "Hour of Code"
            return "Hour of code is to provide supplemental courses for learners in a short amount of time."
        end
        return "These are legacy courses that are no longer maintained and may not be up-to date with the the latest versions of  Quorum. Feel free to use these courses but you may run into possible bugs using these references. "
    end

    // A course's card, then its details: what the old "Preview" showed.
    private action Course(JavaScriptObjectNotation course)
        JavaScriptObjectNotation card = course:GetObject("courseCard")
        CourseCard(course:GetValue("title"), course:GetValue("courseUrl"), card:GetValue("image"), card:GetValue("imageAltText"), card:GetValue("description"))

        JavaScriptObjectNotation preview = course:GetObject("preview")
        CourseDetail(preview:GetValue("description"))
        CourseDetail("Grades: " + preview:GetValue("grades"))
        CourseDetail("Completion Time: " + preview:GetValue("timeToComplete"))

        JavaScriptObjectNotation topicsKey = preview:GetObject("Topics")
        JavaScriptObjectNotation topics = topicsKey:GetArray()
        text topicWords = ""
        integer i = 0
        repeat while i < topics:GetSize()
            JavaScriptObjectNotation topic = topics:Get(i)
            if i > 0
                topicWords = topicWords + ", "
            end
            topicWords = topicWords + topic:GetText()
            i = i + 1
        end
        CourseDetail("Topics: " + topicWords)

        // The old page marked each device with a check or a cross, with no
        // words for readers who can't see them; here the words say it.
        JavaScriptObjectNotation devices = preview:GetObject("compatibility")
        text worksOn = ""
        text notOn = ""
        i = 0
        repeat while i < devices:GetSize()
            JavaScriptObjectNotation device = devices:Get(i)
            if device:GetBoolean()
                worksOn = AddToList(worksOn, device:GetKey())
            else
                notOn = AddToList(notOn, device:GetKey())
            end
            i = i + 1
        end
        if not worksOn:IsEmpty()
            CourseDetail("Works on: " + worksOn)
        end
        if not notOn:IsEmpty()
            CourseDetail("Doesn't work on: " + notOn)
        end
    end

    private action AddToList(text list, text item) returns text
        if list:IsEmpty()
            return item
        end
        return list + ", " + item
    end

    private action NotSureWhereToStart
        Section("Not Sure Where to Start?")
        Paragraph("Play around with the Quorum IDE and get a feel for the language. Start by typing output " + dq + "Hello World!" + dq + " into the text editor and see what you can do. There is so much that you can learn when using Quorum.")
        CodeEditorWithCode("Try Quorum", "output " + dq + "Hello World" + dq)
    end
end
