use Libraries.Web.Page.QuorumPage

/*
    Download the Quorum Studio Beta.
    Converted from the old Lesson page by plan 13's generator: the same
    words, now without Tailwind.
*/
class DownloadStudioBeta is QuorumPage

    on create
        SetLocation("downloadstudiobeta.html")
        // The name lists and links use, and the series and track it belongs
        // to: its section and picture.
        // For search engines and link previews, and what lists of pages say.
    end

    action Setup
        SetWebPageTitle("Quorum Studio Beta Download - Quorum Programming Language")
        Title("Download the Quorum Studio Beta")
        Paragraph():Link("Click here to download the Quorum Studio Beta for Windows. You must be logged in to download.", "/downloadStudioBeta.php")
    end
end
