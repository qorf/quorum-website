use Libraries.Web.Page.QuorumPage
use Libraries.Web.Page.TableRowWriter

/*
    The Download page (plan 13 phase 5B), as close to its old look as the
    site's styles allow (the user, 2026-11-01): across the whole width, a
    grey product banner with the download button, the new feature as a
    black card, the features as cards with grey lower halves, then the
    download tables.
*/
class Download is QuorumPage
    // The table row being written, when its cells hold more than words.
    TableRowWriter row = undefined

    on create
        SetLocation("download.html")
    end

    action Setup
        SetWebPageTitle("Download - Quorum Programming Language")
        ProductBanner("Get Quorum Studio", "Build powerful programs with Quorum’s development environment", "media/userInterface/quorumAssets/quorumStudio2.png", "Quorum Studio with an app loaded")
        BannerChoice("Download Quorum Studio", "/download.html#quorum-studio-8-0-2", "")
        BannerLink("Release Notes", "/release.html")
        Section("New Features")
        FeatureCard("Introducing Blocks", "Did you know blocks can help you learn to program? Quorum now supports blocks and it's still accessible", "media/userInterface/quorumAssets/introducingBlocks.png", "Reference Page")
        Section("Features")
        Paragraph("Quorum Studio provides a host of features for learning to program, writing code, and building apps to do whatever you can imagine.")
        FeatureCards()
        CourseCard("Create Meaningful Programs", "", "media/userInterface/quorumAssets/createMeaningfulPrograms.png", "Create Meaningful Programs", "Create and run Quorum programs that cater to any type of programmer: novice to advanced users.")
        CourseCard("Programming Assistance", "", "media/userInterface/quorumAssets/programmingAssistance.png", "Programming Assistance", "Inside of Quorum Studio, there are many features to help you ease into learning how to program including hints and code completion.")
        CourseCard("Cross Compatibility", "", "media/userInterface/quorumAssets/crossCompatibility.png", "Cross Compatibility", "Free to use on any device. You can send and run Quorum programs through Android or iOS devices")
        Section("Quorum Studio 8.0.2")
        Paragraph("Download this version if you prefer an environment to write your code in. The Quorum team uses this version. For most users, we highly recommend using the Quorum + Quorum Studio development environment. It includes a variety of features to let you run, debug, or otherwise write code in Quorum.")
        Paragraph("If you want to be kept up to date with all the recent changes head to the "):Link("Release Notes", "/release.html"):Text(" page to see what improvements and additions are being made to Quorum Studio and the Quorum language.")
        Table("Quorum Studio Downloads (Recommended)")
        TableHeader():Cell("Platform"):Cell("Downloadable Package"):Cell("Size")
        row = TableRow()
        row:Cell():Text("Windows (Environment)")
        row:Cell():Link("Download", "https://github.com/qorf/quorum-studio/releases/latest/download/Quorum-Studio-Windows.exe")
        row:Cell():Text("362 MB")
        row = TableRow()
        row:Cell():Text("Mac Intel (Environment)")
        row:Cell():Link("Download", "https://github.com/qorf/quorum-studio/releases/latest/download/Quorum-Studio-Mac-Intel.pkg")
        row:Cell():Text("556 MB")
        row = TableRow()
        row:Cell():Text("Mac ARM (Environment)")
        row:Cell():Link("Download", "https://github.com/qorf/quorum-studio/releases/latest/download/Quorum-Studio-Mac-ARM.pkg")
        row:Cell():Text("567 MB")
        Section("Quorum Language 14.0.0")
        Paragraph("Download this version if you prefer to use your own source code editor. Because no editor is provided in this version, it is harder to learn.")
        Table("Quorum Language Downloads")
        TableHeader():Cell("Platform"):Cell("Downloadable Zip"):Cell("Size")
        row = TableRow()
        row:Cell():Text("Console (PC or Mac)")
        row:Cell():Link("Download", "https://github.com/qorf/quorum-language/releases/latest/download/Quorum.zip")
        row:Cell():Text("160.53 MB")
        Section("Other Downloads")
        Paragraph("Below includes downloads for source code or the optional LEGO toolkits for the EV3.")
        Table("Other Downloads")
        TableHeader():Cell("Platform"):Cell("Downloadable Package"):Cell("Size")
        row = TableRow()
        row:Cell():Text("Quorum Source Code")
        row:Cell():Link("Learn More", "https://github.com/qorf/quorum-language")
        row:Cell():Text("-")
        row = TableRow()
        row:Cell():Text("LEGO™ Robotics")
        row:Cell():Link("Download", "https://sourceforge.net/projects/quorum/files/Quorum%206.0/Robots%201.3.zip/download")
        row:Cell():Text("44.7 MB")
    end
end
