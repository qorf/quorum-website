use Libraries.Web.Page.QuorumPage

/*
    Quorum Partners.
    Converted from the old Lesson page by plan 13's generator: the same
    words, now without Tailwind.
*/
class Partners is QuorumPage

    on create
        SetLocation("partners.html")
        // The name lists and links use, and the series and track it belongs
        // to: its section and picture.
        SetShortTitle("Partners")
        // For search engines and link previews, and what lists of pages say.
        SetDescription("Learn how to partner with us by using the Quorum programming language in your classroom or company.")
        SetSummary("how to become a Quorum partner.")
    end

    action Setup
        SetWebPageTitle("Become a Quorum Partner - Quorum Programming Language")
        Title("Quorum Partners")
        Paragraph("Become a Quorum Partner")
        PartnershipProgram()
        WhatDoWeGetInReturn()
    end

    private action PartnershipProgram
        Section("Partnership Program")
        Paragraph("Quorum has a partnership program, run through the Quorum Outreach and Research Foundation. QORF is a private foundation that provides services to organizations. Companies or foundations that wish to partner should get in touch, but schools can join at no cost if they provide the following")
        BulletList()
        ListItem():Strong("Partnership Letter "):Text(": A letter from the administration at your institution declaring the partnership. We can provide a form letter that will work.")
        ListItem():Strong("Yearly usage Data "):Text(": An agreement to provide us anonymized data on how Quorum is being used in the classroom once per year through a standardized survey. This includes information on the number of students and teachers using Quorum, including demographics, for our own records.")
        Subsection("Become a Partner")
        Paragraph("Contact us to become a partner on the Quorum project. Schools, companies, or other foundations are welcome to apply.")
        Paragraph():Link("Learn more", "mailto:stefika@gmail.com?Subject=Become%20a%20Quorum%20Partner")
    end

    private action WhatDoWeGetInReturn
        Section("What do we get in return?")
        BulletList()
        ListItem():Strong("Professional Development "):Text(": Prioritized support for teacher professional development through EPIQ or other means")
        ListItem():Strong("Real-time support "):Text(": Prioritized real-time support for teachers that need help in the classroom")
        ListItem():Strong("Quorum grants "):Text(": Access to apply for mini-grants through QORF to support Quorum-related activities in the classroom. Funding is limited to a calls for proposals for any given year and is awarded on a competitive basis.")
    end
end
