use Libraries.Web.Page.QuorumPage

/*
    The Community page (plan 13 phase 5B): a banner, then pictures beside
    words, and the contact tiles.
*/
class Community is QuorumPage
    on create
        SetLocation("community.html")
        SetDescription("Learn about or connect with others using the Quorum programming language in the classroom and beyond.")
    end

    action Setup
        SetWebPageTitle("Learn Quorum - Quorum Programming Language")
        Banner("Getting Social", "Want to join the community? Connect with others using Quorum’s social platforms", "media/userInterface/quorumAssets/social.png", "Quincy the Rabbit and Quinn the Rabbit talking about Quorum")
        Section("Engage in Professional Development")
        PictureBeside("media/userInterface/quorumAssets/gallery-quorum.png", "", "Every year, we hold professional development for teachers to train in the field of computer science. We call this the Experience Programming in Quorum conference (EPIQ). Find out how you can get involved!")
        PictureBesideLink("Learn more about EPIQ", "/epiq.html")
        Section("Introducing Lego Spike Compatibility")
        PictureBeside("media/userInterface/quorumAssets/smol-bunny.png", "Quorum studio bunny logo", "The latest Quorum patch allows you to use Lego Spike")
        PictureBesideLink("Release Notes", "/release.html")
        PictureBesideLink("Download", "/download.html")
        Section("Partnership with AccessCSForAll")
        Paragraph("Learn about the AccessCSForAll program, a collaboration between the University of Washington and the University of Nevada, Las Vegas that works to make programming more accessible to people with disabilities.")
        Paragraph():Link("Learn more", "https://www.washington.edu/accesscomputing/accesscsforall")
        Section("Talk to Us")
        Paragraph("Connect with Quorum professionals all across the nation! Join the Discord to talk to Quorum professionals and teachers using Quorum in the classroom. Join the email list for updates regarding Quorum software. Check out our help page if you find any bugs and would like to submit a report to the Quorum team.")
        Choices()
        Choice("Discord", "https://discord.gg/6yTVQq4", "media/userInterface/SVG/choice-discord.svg")
        Choice("Email List", "https://groups.google.com/g/quorum-language", "media/userInterface/SVG/choice-mail.svg")
        Choice("Help", "/bugs.html", "media/userInterface/SVG/choice-help.svg")
    end
end
