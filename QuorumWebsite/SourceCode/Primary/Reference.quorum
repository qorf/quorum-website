use Libraries.Web.Page.QuorumPage
use Libraries.Web.Series.PageSeries
use Libraries.Containers.Array

/*
    The Reference page (plan 13 phase 5, design C2 + C3, V1): a banner,
    Getting Started, then every tutorial in a topic map: a search box, links
    to the topic groups, and each group's tutorials as cards listing every
    lesson, so the search and the page's own find reach them all. Then
    Spotlight and For Developers.
*/
class Reference is QuorumPage
    // The tutorials, from the builder, in its order.
    Array<PageSeries> units = undefined

    // The topic groups, in order; GroupFor puts each tutorial in one.
    Array<text> groupNames

    constant text LANGUAGE = "The language"
    constant text GRAPHICS = "Graphics"
    constant text PHYSICS = "Physics"
    constant text SOUND = "Sound"
    constant text INTERFACES = "Interfaces and input"
    constant text DATA = "Working with data"
    constant text STATISTICS = "Statistical testing and visualization"
    constant text STORAGE = "Storage and networks"
    constant text DEVICES = "Devices"
    constant text TOOLS = "Quorum Studio tools"

    on create
        SetLocation("reference.html")
        SetDescription("Sample the libraries and features available out of the box in the Quorum programming language.")
        groupNames:Add(LANGUAGE)
        groupNames:Add(GRAPHICS)
        groupNames:Add(PHYSICS)
        groupNames:Add(SOUND)
        groupNames:Add(INTERFACES)
        groupNames:Add(DATA)
        groupNames:Add(STATISTICS)
        groupNames:Add(STORAGE)
        groupNames:Add(DEVICES)
        groupNames:Add(TOOLS)
    end

    action SetTrackSeries(Array<PageSeries> trackUnits)
        units = trackUnits
    end

    action Setup
        SetWebPageTitle("Quorum Reference Pages - Quorum Programming Language")
        Banner("Quorum Reference Page", "Discover and learn Quorum easily with our helpful guide. It's got all you need to know about coding, from the basics to the advanced tricks, all in one spot", "media/userInterface/referencePageBunny.png", "Quincy the Rabbit stacking bricks saying 'classes', 'forms', 'Data frame', 'Actions', 'syntax'")
        GettingStarted()
        Tutorials()
        Spotlight()
        ForDevelopers()
    end

    private action GettingStarted
        Section("Getting Started")
        Paragraph("Learning Quorum is as easy as counting 1, 2, 3! This guide is for complete beginners learning to get into programming and have chosen Quorum as their first language to learn. You will learn how to download Quorum Studio and how to navigate through the code editor, learn the essential syntax of the language, and go through a walkthrough on how to make a simple quiz game!")
        Subsection("Program using Blocks")
        Card()
        Paragraph("Learn how to program using Quorum. You will go through the basics of programming foundations and try the nifty features such as Data Science tools as you learn how to program.")
        Choices()
        Choice("Get Started", "/tutorials/blocks/gettingStartedBlocks.html", "")
    end

    private action Tutorials
        Section("Tutorials")
        Paragraph("These tutorials are provided for prospective learners looking to program in Quorum Language. These tutorials will teach you the basic concepts about a topic, but are not meant to be treated as a full learning course. To view the current courses, you can refer to the following Learn page.")
        TopicSearch("Search tutorials and lessons")
        TopicJumps(groupNames)
        integer g = 0
        repeat while g < groupNames:GetSize()
            text group = groupNames:Get(g)
            Subsection(group)
            TopicCards()
            integer i = 0
            repeat while i < units:GetSize()
                PageSeries unit = units:Get(i)
                if GroupFor(unit:GetName()) = group
                    TopicCard(unit)
                end
                i = i + 1
            end
            g = g + 1
        end
    end

    // The group a tutorial goes in, by its series' name: ten groups by
    // meaning, each small (the user, 2026-10-31).
    private action GroupFor(text name) returns text
        if name = "Quorum Basics" or name = "Libraries and Structures"
            return LANGUAGE
        elseif name = "2D Graphics" or name = "3D Graphics" or name = "Other Graphics"
            return GRAPHICS
        elseif name = "Game Physics"
            return PHYSICS
        elseif name = "Audio"
            return SOUND
        elseif name = "User Interfaces" or name = "User Interaction and Events"
            return INTERFACES
        elseif name = "Data Science" or name = "Data Transformations" or name = "Filtering Data"
            return DATA
        elseif name = "Descriptive Statistics" or name = "Charts" or name = "Statistical Tests"
            return STATISTICS
        elseif name = "Reading and Writing JavaScript Object Notation (JSON) Data" or name = "Databases" or name = "Network"
            return STORAGE
        elseif name = "Mobile" or name = "LEGO™ Robots"
            return DEVICES
        elseif name = "Scene Editing" or name = "Teams"
            return TOOLS
        end
        alert("The tutorial " + name + " has no topic group on the Reference page. Add it to GroupFor.")
        return ""
    end

    private action Spotlight
        Section("Spotlight")
        Paragraph("Check out these Quorum projects to see advanced work of programs written in Quorum. Want your work to get featured on the Quorum Spotlight? Submit your project by pressing the following link.")
        CourseCards()
        CourseCard("Quorum Platformer", "https://github.com/qorf/example-games", "media/userInterface/quorumAssets/quorumPlatformer.png", "Reference Page", "These tutorials introduce the Quorum programming language and basic programming concepts.")
        CourseCard("Space Shooter", "https://github.com/qorf/example-games", "media/userInterface/quorumAssets/spaceShooter.png", "Reference Page", "These tutorials cover the more advanced features of the Quorum programming language.")
        CourseCard("Ball Breaker", "https://github.com/qorf/example-games", "media/userInterface/quorumAssets/ballBreaker.png", "Reference Page", "These tutorials cover the more advanced features of the Quorum programming language.")
    end

    private action ForDevelopers
        Section("For Developers")
        Paragraph("For advanced Quorum programmers, advance your skills and actively work to build out the language or test features prior to release. ")
        CourseCards()
        CourseCard("Become a Contributer", "https://github.com/qorf", "media/userInterface/contribute.png", "Reference Page", "Quorum is an open source language. If you would like to contribute to help build the language or develop something unique using Quorum")
        CourseCard("Overriding the Standard Library", "https://github.com/qorf/quorum-language", "", "", "To access bleeding edge libraries not yet released publicly, you can override your version")
    end
end
