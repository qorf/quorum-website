use Libraries.Web.Page.QuorumPage
use Libraries.Web.Series.PageSeries
use Libraries.Containers.Array

/*
    The Reference page (redesigned 2026-11-02, design "A + tree 2";
    Plans/Website/ReferenceRedesign.md): a short banner and a sentence,
    then every tutorial in a topic browser: a search over every lesson; a
    tree of the topic groups, Start here first; the chosen group's topics
    as tiles; and the chosen topic's lessons. (Spotlight and For
    Developers were removed, the user, 2026-11-02.)
*/
class Reference is QuorumPage
    // The tutorials, from the builder, in its order.
    Array<PageSeries> units = undefined

    // The topic groups, in order; GroupFor puts each tutorial in one.
    Array<text> groupNames

    constant text LANGUAGE = "The language"
    constant text GRAPHICS = "Graphics"
    constant text PHYSICS = "Physics"
    constant text SOUND = "Sound"
    constant text INTERFACES = "Interfaces and input"
    constant text DATA = "Working with data"
    constant text STATISTICS = "Statistics and charts"
    constant text STORAGE = "Storage and networks"
    constant text DEVICES = "Devices"
    constant text TOOLS = "Quorum Studio tools"

    // Start here: the Quorum Blocks Online course, found by its series' key.
    constant text START_HERE = "Start here"
    constant text START_SERIES = "quorum-blocks-online"
    constant text START_NAME = "Quorum Blocks Online"
    constant text START_ICON = "puzzle"

    on create
        SetLocation("reference.html")
        SetDescription("Sample the libraries and features available out of the box in the Quorum programming language.")
        groupNames:Add(LANGUAGE)
        groupNames:Add(GRAPHICS)
        groupNames:Add(PHYSICS)
        groupNames:Add(SOUND)
        groupNames:Add(INTERFACES)
        groupNames:Add(DATA)
        groupNames:Add(STATISTICS)
        groupNames:Add(STORAGE)
        groupNames:Add(DEVICES)
        groupNames:Add(TOOLS)
    end

    action SetTrackSeries(Array<PageSeries> trackUnits)
        units = trackUnits
    end

    action Setup
        SetWebPageTitle("Quorum Reference Pages - Quorum Programming Language")
        ColorBanner("Quorum Reference Page", "Discover and learn Quorum easily with our helpful guide. It's got all you need to know about coding, from the basics to the advanced tricks, all in one spot", "media/userInterface/referencePageBunny.png", "Quincy the Rabbit stacking bricks saying 'classes', 'forms', 'Data frame', 'Actions', 'syntax'")
        Paragraph("Each topic teaches one part of Quorum in short tutorials; search them all, or pick a topic. For full courses, see the "):Link("Learn page", "/learn.html"):Text(".")
        TopicBrowser("Search tutorials and lessons")
        StartHere()
        Tutorials()
        EndTopicBrowser()
    end

    // Start here: the Quorum Blocks Online course.
    private action StartHere
        TopicGroup(START_HERE, "New to programming? Start with Quorum Blocks Online, 14 short lessons you can do right in your browser.")
        PageSeries start = FindSeries(START_SERIES)
        if start = undefined
            alert("The reference page's Start here needs the series " + START_SERIES + ".")
        end
        TopicSeries(start, START_NAME, START_ICON)
    end

    // Each group, and its tutorials in the builder's order.
    private action Tutorials
        integer g = 0
        repeat while g < groupNames:GetSize()
            text group = groupNames:Get(g)
            TopicGroup(group, "")
            integer i = 0
            repeat while i < units:GetSize()
                PageSeries unit = units:Get(i)
                text unitName = unit:GetName()
                if GroupFor(unitName) = group
                    TopicSeries(unit, ShortName(unitName), IconFor(unitName))
                end
                i = i + 1
            end
            g = g + 1
        end
    end

    // A series on the site, by its key.
    private action FindSeries(text key) returns PageSeries
        Array<PageSeries> all = GetWebSite():GetSeriesList()
        integer i = 0
        repeat while i < all:GetSize()
            PageSeries series = all:Get(i)
            if series:GetKey() = key
                return series
            end
            i = i + 1
        end
        return undefined
    end

    // The group a tutorial goes in, by its series' name: ten groups by
    // meaning, each small (the user, 2026-10-31).
    private action GroupFor(text name) returns text
        if name = "Quorum Basics" or name = "Libraries and Structures"
            return LANGUAGE
        elseif name = "2D Graphics" or name = "3D Graphics" or name = "Other Graphics"
            return GRAPHICS
        elseif name = "Game Physics"
            return PHYSICS
        elseif name = "Audio"
            return SOUND
        elseif name = "User Interfaces" or name = "User Interaction and Events"
            return INTERFACES
        elseif name = "Data Science" or name = "Data Transformations" or name = "Filtering Data"
            return DATA
        elseif name = "Descriptive Statistics" or name = "Charts" or name = "Statistical Tests"
            return STATISTICS
        elseif name = "Reading and Writing JavaScript Object Notation (JSON) Data" or name = "Databases" or name = "Network"
            return STORAGE
        elseif name = "Mobile" or name = "LEGO™ Robots"
            return DEVICES
        elseif name = "Scene Editing" or name = "Teams"
            return TOOLS
        end
        alert("The tutorial " + name + " has no topic group on the Reference page. Add it to GroupFor.")
        return ""
    end

    // A tutorial's name in the tree and on its tile: the long ones
    // shortened (the user, 2026-11-02); its heading keeps the full name.
    private action ShortName(text name) returns text
        if name = "User Interaction and Events"
            return "Events"
        elseif name = "Reading and Writing JavaScript Object Notation (JSON) Data"
            return "JSON Data"
        end
        return name
    end

    // A tutorial's icon, in icons/topics/ (approved 2026-11-02).
    private action IconFor(text name) returns text
        if name = "Quorum Basics"
            return "code"
        elseif name = "Libraries and Structures"
            return "books"
        elseif name = "2D Graphics"
            return "brush"
        elseif name = "3D Graphics"
            return "cube"
        elseif name = "Other Graphics"
            return "stack-2"
        elseif name = "Game Physics"
            return "ball-bowling"
        elseif name = "Audio"
            return "volume"
        elseif name = "User Interaction and Events"
            return "click"
        elseif name = "User Interfaces"
            return "layout"
        elseif name = "Data Science"
            return "table"
        elseif name = "Data Transformations"
            return "transform"
        elseif name = "Filtering Data"
            return "filter"
        elseif name = "Descriptive Statistics"
            return "math-avg"
        elseif name = "Charts"
            return "chart-bar"
        elseif name = "Statistical Tests"
            return "scale"
        elseif name = "Reading and Writing JavaScript Object Notation (JSON) Data"
            return "braces"
        elseif name = "Databases"
            return "database"
        elseif name = "Network"
            return "world-www"
        elseif name = "LEGO™ Robots"
            return "robot"
        elseif name = "Mobile"
            return "device-mobile"
        elseif name = "Scene Editing"
            return "cube-3d-sphere"
        elseif name = "Teams"
            return "users"
        end
        alert("The tutorial " + name + " has no icon on the Reference page. Add it to IconFor.")
        return ""
    end
end
