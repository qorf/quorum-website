use Libraries.Game.Game
use Libraries.Interface.Item3D
use Libraries.Interface.Events.KeyboardListener
use Libraries.Interface.Events.KeyboardEvent

class Main is Game, KeyboardListener
    Item3D player = undefined

    action Main
        UseVulkan(true)
        StartGame()
    end

    action CreateGame
        LoadScene("Scenes/Scene.qs")

        player = FindItem3DByName("Cube")
        if player = undefined
            output "The scene has no item named Cube."
        else
            AddKeyboardListener(me)
            output "Found Cube. The arrow keys move it. Page Up and Page Down raise and lower it."
        end
    end

    action Update(number seconds)
    end

    action PressedKey(KeyboardEvent event)
        // How far, in units, one key press moves the cube. A cube from the
        // palette is 1 unit wide.
        number amount = 1

        if event:keyCode = event:LEFT
            player:Move(-amount, 0, 0)
        elseif event:keyCode = event:RIGHT
            player:Move(amount, 0, 0)
        elseif event:keyCode = event:UP
            player:Move(0, 0, amount)
        elseif event:keyCode = event:DOWN
            player:Move(0, 0, -amount)
        elseif event:keyCode = event:PAGE_UP
            player:Move(0, amount, 0)
        elseif event:keyCode = event:PAGE_DOWN
            player:Move(0, -amount, 0)
        end
    end
end
