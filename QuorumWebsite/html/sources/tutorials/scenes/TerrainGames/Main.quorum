use Libraries.Game.Game
use Libraries.Game.InputMonitor
use Libraries.Game.Scenes.SceneController
use Libraries.Interface.Events.KeyboardEvent
use Libraries.Interface.Item3D

class Main is Game
    SceneController car = undefined
    InputMonitor monitor
    KeyboardEvent keys

    action Main
        UseVulkan(true)
        StartGame()
    end

    action CreateGame
        LoadScene("Scenes/Scene.qs")
        car = GetSceneController("Car")
        if car = undefined
            output "The scene has no model named Car with a Vehicle controller."
        end
    end

    action Update(number seconds)
        if car = undefined
            return now
        end
        // R, or falling off the edge, puts the car back where it was placed.
        Item3D body = car:GetBody()
        if monitor:IsKeyPressed(keys:R) or body:GetY() < car:GetStartPosition():GetY() - 30
            car:Reset()
        end
    end
end
