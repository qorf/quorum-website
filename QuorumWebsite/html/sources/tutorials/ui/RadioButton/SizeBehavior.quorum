use Libraries.Interface.Forms.FormBehavior
use Libraries.Interface.Forms.Page
use Libraries.Interface.Forms.Grouping
use Libraries.Interface.Events.BehaviorEvent
use Libraries.Interface.Controls.ToggleButton
use Libraries.Game.Graphics.Label

class SizeBehavior is FormBehavior
    action Run(BehaviorEvent event)
        Page page = GetPage()
        Grouping sizes = page:GetGrouping("Pizza size")
        Label result = page:GetLabel("Result")
        if sizes = undefined or result = undefined
            return now
        end

        ToggleButton choice = sizes:GetSelectedButton()
        if choice = undefined
            result:SetText("Please pick a size first.")
        else
            result:SetText("You picked " + choice:GetName() + ".")
        end
    end
end
