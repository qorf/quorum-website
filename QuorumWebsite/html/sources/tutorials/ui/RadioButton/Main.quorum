use Libraries.Interface.Forms.Form
use Libraries.Interface.Forms.Page
use Libraries.Interface.Forms.Grouping
use Libraries.Interface.Controls.RadioButton
use Libraries.Interface.Controls.Button

Form form
Page page = form:GetMainPage()
page:SetTitle("Order a Pizza")

page:AddLabel("Pick a size:")
Grouping sizes = page:AddGrouping("Pizza size")
sizes:SetDescription("Pick one size. Use the arrow keys to change it.")
sizes:AddRadioButton("Small")
RadioButton medium = sizes:AddRadioButton("Medium")
sizes:AddRadioButton("Large")
medium:SetToggleState(true)

Button order = page:AddButton("Choose size")
order:SetDescription("Shows the size you picked.")
page:AddLabel("Result", "You haven't chosen yet.")

SizeBehavior behavior
order:SetBehavior(behavior)

form:Display()
