use Libraries.Game.Game
use Libraries.Game.InputSet
use Libraries.Game.InputTable
use Libraries.Interface.Events.KeyboardEvent
use Libraries.Game.Graphics.Drawable
use Libraries.Game.Graphics.Color
use Libraries.Interface.Item

class Main is Game
    KeyboardEvent keys
    Color color
    Drawable square
    Drawable circle

    action Main
        StartGame()
    end

    action CreateGame
        square:LoadFilledRectangle(100, 100, color:Orange())
        square:SetName("Orange square")
        square:SetDescription("Press Space to hear which shape has the focus.")
        square:SetAccessibilityCode(square:parent:Item:ITEM)
        square:SetFocusable(true)
        square:SetPosition(200, 250)
        Add(square)

        circle:LoadFilledCircle(50, color:Purple())
        circle:SetName("Purple circle")
        circle:SetDescription("Press Space to hear which shape has the focus.")
        circle:SetAccessibilityCode(circle:parent:Item:ITEM)
        circle:SetFocusable(true)
        circle:SetPosition(500, 250)
        Add(circle)

        // Tab and Shift+Tab move between the two shapes.
        square:SetNextFocus(circle)
        square:SetPreviousFocus(circle)
        circle:SetNextFocus(square)
        circle:SetPreviousFocus(square)
        SetFocus(square)

        // Run OutputBehavior whenever Space is pressed.
        InputSet spaceSet
        spaceSet:SetKeyboardInput(keys:SPACE)

        InputTable defaultTable = GetDefaultInputTable()
        OutputBehavior outputBehavior
        defaultTable:Add(spaceSet, outputBehavior)
    end
end
