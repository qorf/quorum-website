use Libraries.Interface.Behaviors.Behavior
use Libraries.Interface.Events.BehaviorEvent
use Libraries.Interface.Item
use Libraries.Interface.Item2D

class RotationBehavior is Behavior
    action Run(BehaviorEvent event)
        Item item = event:GetItem()

        if item = undefined
            output "Nothing turned, because no item has the focus."
        elseif item is Item2D
            // A Drawable is a kind of Item2D, which can turn.
            Item2D item2D = cast(Item2D, item)
            item2D:Rotate(45)
            output item2D:GetName() + " turned to " + item2D:GetRotation() + " degrees."
        end
    end
end
