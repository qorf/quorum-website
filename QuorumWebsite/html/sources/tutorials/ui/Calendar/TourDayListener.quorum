use Libraries.Interface.Events.CalendarListener
use Libraries.Interface.Events.CalendarChangedEvent
use Libraries.Game.Graphics.Label
use Libraries.System.CalendarDate

class TourDayListener is CalendarListener
    Label report = undefined

    action SetReport(Label label)
        report = label
    end

    action CalendarChanged(CalendarChangedEvent event)
        CalendarDate chosen = event:GetNewDate()
        if chosen = undefined
            report:SetText("No day chosen yet.")
        else
            report:SetText("Your tour is on " + chosen:ToSpokenText() + ".")
        end
    end
end
