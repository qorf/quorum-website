use Libraries.System.CalendarDate

CalendarDate day
boolean valid = day:SetDate(2027, 2, 30)
if not valid
    output "There is no February 30."
end

valid = day:SetDate(2027, 3, 12)
output day:ToText()
output day:ToSpokenText()

CalendarDate today
today:SetToToday()
output "That is " + today:DaysUntil(day) + " days from today."
