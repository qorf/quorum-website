use Libraries.Interface.Forms.Form
use Libraries.Interface.Forms.Page
use Libraries.Interface.Controls.DateField
use Libraries.Interface.Controls.Button
use Libraries.System.CalendarDate

Form form
Page page = form:GetMainPage()
page:SetTitle("Science Fair")

page:AddLabel("Due date label", "Project due date")
DateField due = page:AddDateField("Project due date")

CalendarDate fairDay
boolean valid = fairDay:SetDate(2027, 3, 12)
due:SetDate(fairDay)

Button checkButton = page:AddButton("Count the days")
checkButton:SetDescription("Shows how many days are left until the due date.")

DaysLeftBehavior behavior
checkButton:SetBehavior(behavior)

form:Display()
