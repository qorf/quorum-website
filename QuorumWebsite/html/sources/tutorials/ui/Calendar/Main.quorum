use Libraries.Interface.Forms.Form
use Libraries.Interface.Forms.Page
use Libraries.Interface.Controls.Calendar
use Libraries.Game.Graphics.Label
use Libraries.System.CalendarDate

Form form
Page page = form:GetMainPage()
page:SetTitle("Book a Tour")

page:AddLabel("Help", "Choose a day in the next 30 days.")
Calendar tourDay = page:AddCalendar("Tour day")

CalendarDate first
first:SetToToday()
CalendarDate last = first:Copy()
last:AddDays(30)
tourDay:SetMinimumDate(first)
tourDay:SetMaximumDate(last)

Label report = page:AddLabel("Report", "No day chosen yet.")

TourDayListener listener
listener:SetReport(report)
tourDay:AddCalendarListener(listener)

form:Display()
