use Libraries.Interface.Forms.Form
use Libraries.Interface.Forms.Page
use Libraries.Interface.Controls.Button
use Libraries.Interface.Controls.Spreadsheet

class Main is Form
    action Main
        Display()
    end

    action CreateGame
        Page page = GetMainPage()
        page:SetTitle("Club Survey")

        Button clean = page:AddButton("Clean Up")
        clean:SetDescription("Removes extra spaces, writes clubs in small letters, and changes ninth to 9")
        Button save = page:AddButton("Save")
        save:SetDescription("Saves the survey to Survey.csv. In a browser, the file is downloaded")

        text survey = "Name,Grade,Club
Ana,9,Chess
Ben,ninth,chess
Cai, 10,Robotics
Dee,10,robotics 
Eli,,Art
Fay,11,ART"

        Spreadsheet sheet = page:AddSpreadsheet("Club survey")
        sheet:LoadFromCommaSeparatedValue(survey)
        sheet:SetDescription("Practice survey answers. One row for each student, with a name, a grade and a club.")

        CleanBehavior cleaner
        clean:SetBehavior(cleaner)

        SaveBehavior saver
        save:SetBehavior(saver)

        parent:Form:CreateGame()
    end
end
