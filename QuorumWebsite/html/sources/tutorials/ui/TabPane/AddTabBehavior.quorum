use Libraries.Game.Graphics.Label
use Libraries.Interface.Behaviors.Behavior
use Libraries.Interface.Controls.Tab
use Libraries.Interface.Controls.TabPane
use Libraries.Interface.Events.BehaviorEvent

class AddTabBehavior is Behavior
    TabPane pane = undefined
    integer count = 0

    action Run(BehaviorEvent event)
        if pane = undefined
            return now
        end

        count = count + 1

        Label label
        label:SetText("This is note number " + count + ".")
        label:SetFocusable(true)

        Tab tab
        tab:SetName("Note " + count)
        tab:SetDescription("A note made while the program was running")
        tab:SetRelatedItem(label)

        pane:Add(tab)
        pane:Select(tab)
    end

    action SetTabPane(TabPane newPane)
        pane = newPane
    end
end
