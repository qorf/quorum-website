use Libraries.Interface.Forms.Form
use Libraries.Interface.Forms.Page
use Libraries.Interface.Controls.TabPane
use Libraries.Interface.Controls.Tab
use Libraries.Interface.Controls.Button
use Libraries.Game.Graphics.Label

class Main
    action Main
        Form form
        Page page = form:GetMainPage()
        page:SetTitle("Study Planner")

        TabPane pane
        pane:SetName("Subjects")
        pane:SetDescription("A Notes tab and one tab for each subject")
        pane:SetPercentageWidth(0.8)
        pane:SetPercentageHeight(0)
        pane:SetPixelHeight(300)

        TabLogger logger
        pane:AddTabChangeListener(logger)

        AddTabBehavior addBehavior
        addBehavior:SetTabPane(pane)

        Button addButton
        addButton:SetName("Add a note tab")
        addButton:SetDescription("Adds a new tab to the end of the tab pane")
        addButton:SetBehavior(addBehavior)

        Tab notesTab
        notesTab:SetName("Notes")
        notesTab:SetDescription("Add new note tabs here")
        notesTab:SetRelatedItem(addButton)
        notesTab:DisplayCloseButton(false)
        pane:Add(notesTab)

        pane:Add(MakeTab("Math", "Finish the practice problems."))
        pane:Add(MakeTab("Science", "Read the chapter on plants."))
        pane:Add(MakeTab("History", "Pick a topic for the project."))

        page:Add(pane)
        form:Display()
    end

    action MakeTab(text name, text reminder) returns Tab
        Label label
        label:SetText(reminder)
        label:SetFocusable(true)

        Tab tab
        tab:SetName(name)
        tab:SetDescription("Reminders for " + name)
        tab:SetRelatedItem(label)
        return tab
    end
end
