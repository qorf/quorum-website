use Libraries.Interface.Forms.Form
use Libraries.Interface.Forms.Page
use Libraries.Interface.Controls.TextField
use Libraries.Interface.Controls.Checkbox
use Libraries.Interface.Controls.Button

Form form
Page page = form:GetMainPage()

// Labels added after this line are not in the Tab order.
page:SetSkipLabelsInFocus(true)

page:SetTitle("Join the Chess Club")

page:AddLabel("First name")
TextField firstName = page:AddTextField("First name")
firstName:SetDescription("Type your first name.")

page:AddLabel("Last name")
TextField lastName = page:AddTextField("Last name")
lastName:SetDescription("Type your last name.")

Checkbox reminders = page:AddCheckbox("Send me meeting reminders")
reminders:SetDescription("Check this to get a reminder before each meeting.")

Button join = page:AddButton("Join")
join:SetDescription("Sends your name to the club.")

form:Display()
