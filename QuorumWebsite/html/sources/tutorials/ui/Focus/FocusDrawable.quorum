use Libraries.Game.Graphics.Drawable
use Libraries.Game.Graphics.Color
use Libraries.Interface.Events.FocusEvent

class FocusDrawable is Drawable
    on create
        // Shapes are not focusable, or known to screen readers, by default.
        SetFocusable(true)
        SetAccessibilityCode(parent:Item:ITEM)
    end

    action GainedFocus(FocusEvent event)
        Color color
        SetColor(color:Green())
        SetScaleFromCenter(1.25)
        output GetName() + " has the focus."
    end

    action LostFocus(FocusEvent event)
        Color color
        SetColor(color:Red())
        SetScaleFromCenter(1.0)
    end
end
