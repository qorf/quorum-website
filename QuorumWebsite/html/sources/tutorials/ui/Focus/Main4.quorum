use Libraries.Game.Game
use Libraries.Game.Graphics.Color

class Main is Game
    action Main
        StartGame()
    end

    action CreateGame
        Color color
        FocusDrawable square
        FocusDrawable circle
        FocusDrawable triangle

        square:LoadFilledRectangle(80, 80, color:Red())
        circle:LoadFilledCircle(40, color:Red())
        triangle:LoadFilledTriangle(0, 0, 40, 80, 80, 0, color:Red())

        square:SetPosition(150, 250)
        circle:SetPosition(350, 250)
        triangle:SetPosition(550, 250)

        square:SetName("Square")
        square:SetDescription("A red square. It turns green when it has the focus.")
        circle:SetName("Circle")
        circle:SetDescription("A red circle. It turns green when it has the focus.")
        triangle:SetName("Triangle")
        triangle:SetDescription("A red triangle. It turns green when it has the focus.")

        square:SetNextFocus(circle)
        circle:SetNextFocus(triangle)
        triangle:SetNextFocus(square)
        square:SetPreviousFocus(triangle)
        circle:SetPreviousFocus(square)
        triangle:SetPreviousFocus(circle)

        Add(square)
        Add(circle)
        Add(triangle)

        square:Focus()
    end

    action Update(number seconds)
    end
end
