use Libraries.Interface.Forms.Form
use Libraries.Interface.Forms.Page
use Libraries.Interface.Forms.Grouping
use Libraries.Interface.Controls.Button

Form form
Page page = form:GetMainPage()
page:SetTitle("Contents")

Grouping chapters = page:AddGrouping("Chapters")
chapters:SetColumns(2)

// Rows fill from left to right, so the first row holds
// Chapters 1 and 3, and the second row holds Chapters 2 and 4.
Button chapterOne = chapters:AddButton("Chapter 1: Forms")
Button chapterThree = chapters:AddButton("Chapter 3: Behaviors")
Button chapterTwo = chapters:AddButton("Chapter 2: Pages")
Button chapterFour = chapters:AddButton("Chapter 4: Focus")

Button close = page:AddButton("Close")
close:SetDescription("Closes the table of contents.")

// Work out the default order now, so it can be changed.
page:CalculateDefaultFocusOrdering()

// Read down each column: 1, 2, 3, 4, then Close.
chapterOne:SetNextFocus(chapterTwo)
chapterTwo:SetPreviousFocus(chapterOne)
chapterTwo:SetNextFocus(chapterThree)
chapterThree:SetPreviousFocus(chapterTwo)
chapterThree:SetNextFocus(chapterFour)
chapterFour:SetPreviousFocus(chapterThree)
chapterFour:SetNextFocus(close)
close:SetPreviousFocus(chapterFour)

form:Display()
