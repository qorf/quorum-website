use Libraries.Game.Game
use Libraries.Interface.Controls.Button
use Libraries.Interface.Layouts.FlowLayout

class Main is Game
    action Main
        StartGame()
    end

    action CreateGame
        FlowLayout layout
        SetLayout(layout)

        Button newButton
        newButton:SetName("New")
        newButton:SetDescription("Starts a new drawing.")

        Button openButton
        openButton:SetName("Open")
        openButton:SetDescription("Opens a saved drawing.")

        Button saveButton
        saveButton:SetName("Save")
        saveButton:SetDescription("Saves this drawing.")

        // Tab order: New, Open, Save, then back to New.
        newButton:SetNextFocus(openButton)
        openButton:SetNextFocus(saveButton)
        saveButton:SetNextFocus(newButton)

        // Shift+Tab order: the same loop, backwards.
        newButton:SetPreviousFocus(saveButton)
        openButton:SetPreviousFocus(newButton)
        saveButton:SetPreviousFocus(openButton)

        FocusReporter reporter
        newButton:AddFocusListener(reporter)
        openButton:AddFocusListener(reporter)
        saveButton:AddFocusListener(reporter)

        Add(newButton)
        Add(openButton)
        Add(saveButton)

        newButton:Focus()
    end

    action Update(number seconds)
    end
end
