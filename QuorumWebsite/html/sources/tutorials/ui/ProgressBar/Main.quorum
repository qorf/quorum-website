use Libraries.Interface.Forms.Form
use Libraries.Interface.Forms.Page
use Libraries.Interface.Controls.ProgressBar

Form form
Page page = form:GetMainPage()
page:SetTitle("Downloads")

page:AddLabel("Song download")
ProgressBar download = page:AddProgressBar("Song download")
download:SetDescription("Shows how much of the song has downloaded")
download:SetValue(40)

form:Display()
