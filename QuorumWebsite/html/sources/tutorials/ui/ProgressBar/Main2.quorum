use Libraries.Interface.Forms.Form
use Libraries.Interface.Forms.Page
use Libraries.Interface.Forms.FormBehavior
use Libraries.Interface.Events.BehaviorEvent
use Libraries.Interface.Controls.Button
use Libraries.Interface.Controls.ProgressBar

class Main is FormBehavior
    action Main
        Form form
        Page page = form:GetMainPage()
        page:SetTitle("Next Level")

        page:AddLabel("Level loading")
        ProgressBar bar = page:AddProgressBar("Level loading")
        bar:SetDescription("Shows how much of the next level has loaded")

        Button start = page:AddButton("Start Loading")
        start:SetDescription("Starts loading the next level")
        start:SetBehavior(me)

        form:Display()
    end

    action Run(BehaviorEvent event)
        Page page = GetPage()
        ProgressBar bar = page:GetProgressBar("Level loading")

        if bar:GetValue() > bar:GetMinimum() and bar:GetValue() < bar:GetMaximum()
            return now
        end

        bar:SetValue(bar:GetMinimum())
        FillBehavior fill
        fill:SetProgressBar(bar)
        bar:AddBehavior(fill)
    end
end
