use Libraries.Interface.Behaviors.Behavior
use Libraries.Interface.Controls.ProgressBar

class FillBehavior is Behavior
    ProgressBar bar = undefined
    number timePassed = 0

    action SetProgressBar(ProgressBar bar)
        me:bar = bar
    end

    action Update(number seconds)
        timePassed = timePassed + seconds
        if timePassed >= 1
            timePassed = 0
            bar:SetValue(bar:GetValue() + 10)
        end
    end

    action IsFinished returns boolean
        return bar:GetValue() >= bar:GetMaximum()
    end
end
