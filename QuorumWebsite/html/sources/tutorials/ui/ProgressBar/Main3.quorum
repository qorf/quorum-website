use Libraries.Interface.Forms.Form
use Libraries.Interface.Forms.Page
use Libraries.Interface.Forms.FormBehavior
use Libraries.Interface.Events.BehaviorEvent
use Libraries.Interface.Controls.Button
use Libraries.Interface.Controls.ProgressBar

class Main is FormBehavior
    action Main
        Form form
        Page page = form:GetMainPage()
        page:SetTitle("Quiz")

        page:AddLabel("Questions answered")
        ProgressBar quiz = page:AddProgressBar("Questions answered", 0, 5)
        quiz:SetDescription("Shows how many of the 5 questions are done")

        Button next = page:AddButton("Next Question")
        next:SetDescription("Moves the quiz progress bar forward by one")
        next:SetBehavior(me)

        form:Display()
    end

    action Run(BehaviorEvent event)
        Page page = GetPage()
        ProgressBar quiz = page:GetProgressBar("Questions answered")

        number amount = quiz:GetValue() + 1
        if amount > quiz:GetMaximum()
            amount = quiz:GetMinimum()
        end
        quiz:SetValue(amount)
        output "Question " + amount + " of " + quiz:GetMaximum()
    end
end
