use Libraries.Interface.Behaviors.Behavior
use Libraries.Interface.Controls.TextField
use Libraries.Interface.Events.BehaviorEvent

class ChangeTextBehavior is Behavior
    TextField field = undefined
    text mode = ""

    action Run(BehaviorEvent event)
        if field = undefined
            return now
        end

        text value = field:GetText()
        if mode = "upper"
            field:SetText(value:ToUpperCase())
        elseif mode = "lower"
            field:SetText(value:ToLowerCase())
        elseif mode = "clear"
            field:SetText("")
        end
        output "The text is now: " + field:GetText()
    end

    action SetTextField(TextField newField)
        field = newField
    end

    action SetMode(text newMode)
        mode = newMode
    end
end
