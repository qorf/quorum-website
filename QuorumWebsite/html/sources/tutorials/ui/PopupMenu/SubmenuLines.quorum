        PopupMenu menu
        menu:SetName("Text options")

        MenuItem caseMenu
        caseMenu:SetName("Change case")
        menu:Add(caseMenu)
        caseMenu:Add(MakeCommand("Uppercase", "upper", field))
        caseMenu:Add(MakeCommand("Lowercase", "lower", field))

        menu:Add(MakeCommand("Clear", "clear", field))
