use Libraries.Interface.Behaviors.Behavior
use Libraries.Interface.Controls.Control
use Libraries.Interface.Controls.PopupMenu
use Libraries.Interface.Events.BehaviorEvent

class OpenMenuBehavior is Behavior
    PopupMenu menu = undefined
    Control anchor = undefined

    action Run(BehaviorEvent event)
        if menu not= undefined and anchor not= undefined
            menu:OpenAt(anchor:GetGlobalX(), anchor:GetGlobalY())
        end
    end

    action SetMenu(PopupMenu newMenu)
        menu = newMenu
    end

    action SetAnchor(Control newAnchor)
        anchor = newAnchor
    end
end
