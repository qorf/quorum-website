use Libraries.Interface.Forms.Form
use Libraries.Interface.Forms.Page
use Libraries.Game.Graphics.Label
use Libraries.Interface.Controls.Button
use Libraries.Interface.Controls.ToolBar

class Main
    Label message = undefined

    action Main
        Form form
        Page page = form:GetMainPage()

        ToolBar tools
        tools:SetName("Animal sounds")
        tools:SetDescription("Use the left and right arrow keys to move between the buttons")
        page:Add(tools)

        message = page:AddLabel("Message", "Press a button on the toolbar.")

        tools:Add(MakeButton("Dog", "Woof!"))
        tools:Add(MakeButton("Cat", "Meow!"))
        tools:Add(MakeButton("Cow", "Moo!"))
        tools:Add(MakeButton("Duck", "Quack!"))

        form:Display()
    end

    action MakeButton(text name, text sound) returns Button
        OutputBehavior behavior
        behavior:SetLabel(message)
        behavior:SetMessage(sound)

        Button button
        button:SetName(name)
        button:SetDescription("Shows what the " + name + " says")
        button:SetBehavior(behavior)
        return button
    end
end
