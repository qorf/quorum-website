use Libraries.Interface.Forms.Form
use Libraries.Interface.Forms.Page
use Libraries.Game.Graphics.Label
use Libraries.Interface.Controls.Button
use Libraries.Interface.Controls.MenuBar
use Libraries.Interface.Controls.MenuItem
use Libraries.Interface.Controls.ToolBar

class Main
    MenuBar bar
    ToolBar tools
    Label message = undefined

    action Main
        Form form
        Page page = form:GetMainPage()

        bar:SetName("Main menu")
        page:Add(bar)

        tools:SetName("Animal sounds")
        tools:SetDescription("Use the left and right arrow keys to move between the buttons")
        page:Add(tools)

        message = page:AddLabel("Message", "Choose an animal from the menu or the toolbar.")

        MenuItem animals
        animals:SetName("Animals")
        animals:SetMnemonic("a")
        bar:Add(animals)

        AddCommand(animals, "Dog", "Woof!")
        AddCommand(animals, "Cat", "Meow!")
        AddCommand(animals, "Cow", "Moo!")
        AddCommand(animals, "Duck", "Quack!")

        form:Display()
    end

    action AddCommand(MenuItem menu, text name, text sound)
        OutputBehavior behavior
        behavior:SetLabel(message)
        behavior:SetMessage(sound)

        MenuItem item
        item:SetName(name)
        item:SetBehavior(behavior)
        menu:Add(item)

        Button button
        button:SetName(name)
        button:SetDescription("Shows what the " + name + " says")
        button:SetBehavior(behavior)
        tools:Add(button)
    end
end
