use Libraries.Interface.Behaviors.Behavior
use Libraries.Interface.Events.BehaviorEvent
use Libraries.Interface.Controls.FileChooser
use Libraries.Interface.Controls.FileFilter
use Libraries.System.File

class OpenFileBehavior is Behavior
    action Run(BehaviorEvent event)
        FileChooser chooser
        FileFilter filter
        filter:Add("txt")
        filter:SetAcceptAll(false)

        File file = chooser:OpenFileDialog(filter)

        if file = undefined
            output "No file was opened."
        else
            output "You opened " + file:GetFileName()
            output "Its full path is " + file:GetAbsolutePath()
            output "It says: " + file:Read()
        end
    end
end
