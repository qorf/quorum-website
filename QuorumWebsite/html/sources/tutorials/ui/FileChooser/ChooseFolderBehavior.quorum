use Libraries.Interface.Behaviors.Behavior
use Libraries.Interface.Events.BehaviorEvent
use Libraries.Interface.Controls.FileChooser
use Libraries.System.File
use Libraries.Containers.Array

class ChooseFolderBehavior is Behavior
    action Run(BehaviorEvent event)
        FileChooser chooser
        File start
        File folder = chooser:ChooseFolderDialog(start)

        if folder = undefined
            output "No folder was chosen."
        else
            output "You chose " + folder:GetAbsolutePath()
            Array<File> contents = folder:GetDirectoryListing()
            output "It holds " + contents:GetSize() + " files and folders."
        end
    end
end
