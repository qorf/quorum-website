use Libraries.Interface.Forms.Form
use Libraries.Interface.Forms.Page
use Libraries.Interface.Controls.Button

Form form
Page page = form:GetMainPage()

page:AddLabel("Intro", "Each button opens one of your computer's file windows. Results appear in the output window.")

Button open = page:AddButton("Open File")
open:SetDescription("Opens a text file and shows what it says")
OpenFileBehavior openBehavior
open:SetBehavior(openBehavior)

Button save = page:AddButton("Save File")
save:SetDescription("Saves a short message to a text file")
SaveFileBehavior saveBehavior
save:SetBehavior(saveBehavior)

Button folder = page:AddButton("Choose Folder")
folder:SetDescription("Picks a folder and counts what is in it")
ChooseFolderBehavior folderBehavior
folder:SetBehavior(folderBehavior)

form:Display()
