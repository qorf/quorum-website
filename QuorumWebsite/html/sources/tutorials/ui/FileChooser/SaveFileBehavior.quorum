use Libraries.Interface.Behaviors.Behavior
use Libraries.Interface.Events.BehaviorEvent
use Libraries.Interface.Controls.FileChooser
use Libraries.Interface.Controls.FileFilter
use Libraries.System.File

class SaveFileBehavior is Behavior
    action Run(BehaviorEvent event)
        FileChooser chooser
        FileFilter filter
        filter:Add("txt")
        filter:SetAcceptAll(false)

        File file = chooser:SaveFileDialog(filter)

        if file = undefined
            output "Nothing was saved."
        else
            if file:Exists()
                output "Replacing " + file:GetFileName()
            end
            file:Write("Hello from my Quorum program!")
            output "Saved to " + file:GetAbsolutePath()
        end
    end
end
