use Libraries.Containers.Array
use Libraries.Game.Graphics.Label
use Libraries.Interface.Behaviors.Behavior
use Libraries.Interface.Controls.MenuItem
use Libraries.Interface.Events.BehaviorEvent

class OutputBehavior is Behavior
    Label label = undefined
    text message = ""

    action Run(BehaviorEvent event)
        if label not= undefined
            label:SetText(message)
        end
        output message

        if event:GetItem() is MenuItem
            MenuItem item = cast(MenuItem, event:GetItem())
            Array<MenuItem> path = item:GetMenuPath()
            text route = ""
            integer i = 0
            repeat while i < path:GetSize()
                if i > 0
                    route = route + " > "
                end
                route = route + path:Get(i):GetName()
                i = i + 1
            end
            output "You chose " + route
        end
    end

    action SetLabel(Label newLabel)
        label = newLabel
    end

    action SetMessage(text newMessage)
        message = newMessage
    end
end
