use Libraries.Interface.Forms.Form
use Libraries.Interface.Forms.Page
use Libraries.Game.Graphics.Label
use Libraries.Game.InputSet
use Libraries.Interface.Events.KeyboardEvent
use Libraries.Interface.Controls.MenuBar
use Libraries.Interface.Controls.MenuItem

class Main is Form
    Label message = undefined
    MenuItem dog = undefined

    action Main
        Page page = GetMainPage()

        MenuBar bar
        bar:SetName("Main menu")
        bar:SetDescription("Use the arrow keys to open the Animals and Help menus")
        page:Add(bar)

        message = page:AddLabel("Message", "Choose an animal from the Animals menu.")

        MenuItem animals
        animals:SetName("Animals")
        animals:SetMnemonic("a")
        bar:Add(animals)

        MenuItem pets
        pets:SetName("Pets")
        animals:Add(pets)
        dog = MakeCommand("Dog", "Woof!")
        pets:Add(dog)
        pets:Add(MakeCommand("Cat", "Meow!"))

        MenuItem farm
        farm:SetName("Farm")
        animals:Add(farm)
        farm:Add(MakeCommand("Cow", "Moo!"))
        farm:Add(MakeCommand("Duck", "Quack!"))

        MenuItem help
        help:SetName("Help")
        help:SetMnemonic("h")
        bar:Add(help)
        help:Add(MakeCommand("About", "This program shows how menus work."))

        Display()
    end

    action CreateGame
        parent:Form:CreateGame()

        KeyboardEvent keys
        InputSet dogKeys
        dogKeys:SetKeyboardInput(keys:D)
        dogKeys:AddModifier(dogKeys:CONTROL)
        dog:SetShortcut(dogKeys)
    end

    action MakeCommand(text name, text sound) returns MenuItem
        OutputBehavior behavior
        behavior:SetLabel(message)
        behavior:SetMessage(sound)

        MenuItem item
        item:SetName(name)
        item:SetBehavior(behavior)
        return item
    end
end
