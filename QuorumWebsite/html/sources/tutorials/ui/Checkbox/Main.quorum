use Libraries.Interface.Forms.Form
use Libraries.Interface.Forms.Page
use Libraries.Interface.Controls.Checkbox
use Libraries.Interface.Controls.Button

Form form
Page page = form:GetMainPage()
page:SetTitle("Build a Pizza")

Checkbox cheese = page:AddCheckbox("Extra cheese")
cheese:SetDescription("Adds extra cheese to your pizza.")

Checkbox mushrooms = page:AddCheckbox("Mushrooms")
mushrooms:SetDescription("Adds mushrooms to your pizza.")

Checkbox peppers = page:AddCheckbox("Peppers")
peppers:SetDescription("Adds green peppers to your pizza.")

Button order = page:AddButton("Place order")
order:SetDescription("Shows the toppings you picked.")
page:AddLabel("Order", "You haven't ordered yet.")

OrderBehavior behavior
order:SetBehavior(behavior)

form:Display()
