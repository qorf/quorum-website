use Libraries.Interface.Forms.Form
use Libraries.Interface.Forms.Page
use Libraries.Interface.Controls.Checkbox

Form form
Page page = form:GetMainPage()
page:SetTitle("Settings")

Checkbox newsletter = page:AddCheckbox("Send me the newsletter")
newsletter:SetDescription("You will get one email each week.")

ReportBehavior behavior
newsletter:SetBehavior(behavior)
newsletter:SetToggleState(true)

form:Display()
