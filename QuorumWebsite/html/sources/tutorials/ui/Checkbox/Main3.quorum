use Libraries.Interface.Forms.Form
use Libraries.Interface.Forms.Page
use Libraries.Interface.Forms.Grouping
use Libraries.Interface.Controls.Checkbox

Form form
Page page = form:GetMainPage()
page:SetTitle("Build a Pizza")

Grouping toppings = page:AddGrouping("Toppings")
toppings:SetTitle("Toppings")
Checkbox cheese = toppings:AddCheckbox("Extra cheese")
cheese:SetDescription("Adds extra cheese to your pizza.")
Checkbox mushrooms = toppings:AddCheckbox("Mushrooms")
mushrooms:SetDescription("Adds mushrooms to your pizza.")

form:Display()
