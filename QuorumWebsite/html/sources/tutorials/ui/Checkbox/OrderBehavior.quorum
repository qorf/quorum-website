use Libraries.Interface.Forms.FormBehavior
use Libraries.Interface.Forms.Page
use Libraries.Interface.Events.BehaviorEvent
use Libraries.Interface.Controls.Checkbox
use Libraries.Game.Graphics.Label

class OrderBehavior is FormBehavior
    action Run(BehaviorEvent event)
        Page page = GetPage()
        text toppings = ""
        toppings = toppings + ToppingIfChecked(page, "Extra cheese")
        toppings = toppings + ToppingIfChecked(page, "Mushrooms")
        toppings = toppings + ToppingIfChecked(page, "Peppers")

        Label order = page:GetLabel("Order")
        if toppings = ""
            order:SetText("You ordered a plain pizza.")
        else
            order:SetText("Your pizza has:" + toppings)
        end
    end

    action ToppingIfChecked(Page page, text name) returns text
        Checkbox box = page:GetCheckbox(name)
        if box = undefined
            return ""
        end
        if box:GetToggleState()
            return " " + name
        end
        return ""
    end
end
