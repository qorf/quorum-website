use Libraries.Interface.Events.ComboBoxListener
use Libraries.Interface.Events.ComboBoxChangedEvent
use Libraries.Game.Graphics.Label

class SizeListener is ComboBoxListener
    Label summary = undefined

    action SetLabel(Label newLabel)
        summary = newLabel
    end

    action ComboBoxChanged(ComboBoxChangedEvent event)
        if summary = undefined
            return now
        end

        if event:GetNewIndex() = -1
            summary:SetText(event:GetText() + " is not one of the sizes.")
        else
            summary:SetText("Your size: " + event:GetText())
        end
    end
end
