use Libraries.Interface.Forms.Form
use Libraries.Interface.Forms.Page
use Libraries.Interface.Controls.ComboBox
use Libraries.Interface.Controls.Button
use Libraries.Containers.Array

Form form
Page page = form:GetMainPage()
page:SetTitle("Order a T-Shirt")

Array<text> sizes
sizes:Add("Small")
sizes:Add("Medium")
sizes:Add("Large")
sizes:Add("Extra large")

page:AddLabel("Size")
ComboBox sizeBox = page:AddComboBox("Size", sizes)
sizeBox:SetDescription("The size of your shirt.")
sizeBox:SetPlaceholder("Choose a size")

page:AddLabel("Color")
ComboBox colorBox = page:AddComboBox("Color")
colorBox:SetDescription("The color of your shirt.")
colorBox:Add("Black")
colorBox:Add("Blue")
colorBox:Add("Gray")
colorBox:Add("Green")
colorBox:Add("White")
colorBox:Select(0)

Button order = page:AddButton("Place order")
order:SetDescription("Shows the shirt you picked.")

OrderBehavior behavior
order:SetBehavior(behavior)

form:Display()
