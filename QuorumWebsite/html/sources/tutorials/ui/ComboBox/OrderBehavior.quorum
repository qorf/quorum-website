use Libraries.Interface.Forms.FormBehavior
use Libraries.Interface.Forms.Page
use Libraries.Interface.Events.BehaviorEvent
use Libraries.Interface.Controls.ComboBox

class OrderBehavior is FormBehavior
    action Run(BehaviorEvent event)
        Page page = GetPage()
        ComboBox sizeBox = page:GetComboBox("Size")
        ComboBox colorBox = page:GetComboBox("Color")
        if sizeBox = undefined
            return now
        end
        if colorBox = undefined
            return now
        end

        if sizeBox:GetSelectedIndex() = -1
            output "Please choose a size from the list."
        elseif colorBox:GetSelectedIndex() = -1
            output "Please choose a color from the list."
        else
            output "You ordered a " + colorBox:GetSelectedItem() + " shirt, size " + sizeBox:GetSelectedItem() + "."
        end
    end
end
