use Libraries.Interface.Forms.Form
use Libraries.Interface.Forms.Page
use Libraries.Interface.Controls.TextBox

Form form
Page page = form:GetMainPage()
page:SetTitle("Note Copier")

page:AddLabel("Source notes:")
TextBox source = page:AddTextBox("Source notes")
source:SetDescription("Type or paste text here, then select part of it to copy.")
source:SetText("Select some of this text, then press Copy selection.")
source:SetLayoutRows(6)

page:AddLabel("Copied notes:")
TextBox target = page:AddTextBox("Copied notes")
target:SetDescription("Text you copy from the source notes appears here.")
target:SetLayoutRows(6)

form:Display()
