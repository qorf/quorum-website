use Libraries.Interface.Forms.FormBehavior
use Libraries.Interface.Forms.Page
use Libraries.Interface.Events.BehaviorEvent
use Libraries.Interface.Controls.TextBox
use Libraries.Interface.Controls.TextField

class GoToLineBehavior is FormBehavior
    action Run(BehaviorEvent event)
        Page page = GetPage()
        TextBox source = page:GetTextBox("Source notes")
        TextField lineField = page:GetTextField("Line number")
        if source = undefined
            return now
        end
        if lineField = undefined
            return now
        end
        text typed = lineField:GetText()
        integer line = typed:ParseInteger() - 1
        if line >= 0 and line < source:GetLineCount()
            source:SetCaretPositionToLine(line)
        end
    end
end
