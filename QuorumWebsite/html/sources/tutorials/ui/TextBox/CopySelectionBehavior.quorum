use Libraries.Interface.Forms.FormBehavior
use Libraries.Interface.Forms.Page
use Libraries.Interface.Events.BehaviorEvent
use Libraries.Interface.Controls.TextBox
use Libraries.Interface.Selections.TextBoxSelection

class CopySelectionBehavior is FormBehavior
    action Run(BehaviorEvent event)
        Page page = GetPage()
        TextBox source = page:GetTextBox("Source notes")
        TextBox target = page:GetTextBox("Copied notes")
        if source = undefined or target = undefined
            return now
        end

        TextBoxSelection selection = source:GetSelection()
        if selection:IsEmpty()
            output "Select some text in the source notes first."
        else
            target:AppendToText(selection:GetText())
        end
    end
end
