use Libraries.Interface.Forms.Form
use Libraries.Interface.Forms.Page
use Libraries.Interface.Forms.Grouping
use Libraries.Interface.Controls.TextBox
use Libraries.Interface.Controls.TextField
use Libraries.Interface.Controls.Button
use Libraries.Interface.Controls.Gutter
use Libraries.Interface.Controls.LineNumberGutter

Form form
Page page = form:GetMainPage()
page:SetTitle("Note Copier")

page:AddLabel("Source notes:")
TextBox source = page:AddTextBox("Source notes")
source:SetDescription("Type or paste text here, then select part of it to copy.")
source:SetText("Select some of this text, then press Copy selection.")
source:SetLayoutRows(6)
LineNumberGutter gutter
source:Add(cast(Gutter, gutter))
GoToLineListener lineListener
gutter:AddGutterListener(lineListener)

page:AddLabel("Line number:")
TextField lineField = page:AddTextField("Line number")
lineField:SetDescription("Type a line number, then press Go to line.")
Button goToLine = page:AddButton("Go to line")
GoToLineBehavior goBehavior
goToLine:SetBehavior(goBehavior)

page:AddLabel("Copied notes:")
TextBox target = page:AddTextBox("Copied notes")
target:SetDescription("Text you copy from the source notes appears here.")
target:SetLayoutRows(6)

Grouping buttons = page:AddGrouping("Note buttons")

Button copy = buttons:AddButton("Copy selection")
copy:SetDescription("Adds the selected source text to the copied notes.")
CopySelectionBehavior copyBehavior
copy:SetBehavior(copyBehavior)

Button mark = buttons:AddButton("Mark selection")
mark:SetDescription("Colors and underlines the selected source text.")
StyleBehavior styleBehavior
mark:SetBehavior(styleBehavior)

Button clear = buttons:AddButton("Clear")
clear:SetDescription("Empties the copied notes.")
ClearBehavior clearBehavior
clear:SetBehavior(clearBehavior)

Button show = buttons:AddButton("Show text")
show:SetDescription("Outputs the copied notes and counts their lines.")
ShowBehavior showBehavior
show:SetBehavior(showBehavior)

form:Display()
