use Libraries.Interface.Forms.Form
use Libraries.Interface.Forms.Page
use Libraries.Interface.Forms.FormBehavior
use Libraries.Interface.Events.BehaviorEvent
use Libraries.Interface.Controls.Button
use Libraries.Interface.Item

class Main is FormBehavior
    action Main
        Form form

        Page home = form:GetMainPage()
        home:SetTitle("Park Guide")
        home:AddLabel("Welcome", "Welcome to the park. Where would you like to go?")
        Button trailsButton = home:AddButton("Trails")
        trailsButton:SetBehavior(me)
        Button hoursButton = home:AddButton("Opening hours")
        hoursButton:SetBehavior(me)

        Page trails = form:AddPage("Trails")
        trails:SetTitle("Trails")
        trails:AddLabel("Lake trail", "Lake Trail: 2 miles, flat")
        trails:AddLabel("Hill trail", "Hill Trail: 4 miles, steep")
        Button backFromTrails = trails:AddButton("Back to Home")
        backFromTrails:SetBehavior(me)

        Page hours = form:AddPage("Hours")
        hours:SetTitle("Opening hours")
        hours:AddLabel("Daily hours", "Open every day from 8 to 6")
        Button backFromHours = hours:AddButton("Back to Home")
        backFromHours:SetBehavior(me)

        form:Display()
    end

    action Run(BehaviorEvent event)
        Form form = GetForm()
        Item pressed = event:GetItem()
        text name = pressed:GetName()

        if name = "Trails"
            form:SetPage("Trails")
        elseif name = "Opening hours"
            form:SetPage("Hours")
        else
            form:SetPage("Main")
        end
    end
end
