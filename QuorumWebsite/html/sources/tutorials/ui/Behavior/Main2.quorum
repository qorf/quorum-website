use Libraries.Interface.Forms.Form
use Libraries.Interface.Forms.Page
use Libraries.Interface.Forms.FormBehavior
use Libraries.Interface.Events.BehaviorEvent
use Libraries.Interface.Controls.Button
use Libraries.Game.Graphics.Label

class Main is FormBehavior
    integer presses = 0

    action Main
        Form form
        Page page = form:GetMainPage()
        page:SetTitle("Press Counter")

        Button press = page:AddButton("Press me")
        press:SetDescription("Adds one to the count")
        press:SetBehavior(me)

        page:AddLabel("Count", "You haven't pressed the button yet.")

        form:Display()
    end

    action Run(BehaviorEvent event)
        presses = presses + 1
        Page page = GetPage()
        Label count = page:GetLabel("Count")
        count:SetText("You pressed the button " + presses + " times.")
    end
end
