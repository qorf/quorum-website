use Libraries.Interface.Behaviors.Behavior
use Libraries.Interface.Events.BehaviorEvent
use Libraries.Game.Graphics.Label

class CountdownBehavior is Behavior
    Label label = undefined
    number timer = 0
    integer secondsShown = 0

    action Run(BehaviorEvent event)
        label = cast(Label, event:GetItem())
        label:SetText("Seconds left: 5")
    end

    action Update(number seconds)
        timer = timer + seconds
        if label not= undefined and timer >= secondsShown + 1
            secondsShown = secondsShown + 1
            label:SetText("Seconds left: " + (5 - secondsShown))
        end
    end

    action IsFinished returns boolean
        return timer >= 5
    end

    action Dispose
        if label not= undefined
            label:SetText("Time is up!")
        end
    end
end
