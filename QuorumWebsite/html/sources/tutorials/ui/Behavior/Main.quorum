use Libraries.Interface.Forms.Form
use Libraries.Interface.Forms.Page
use Libraries.Interface.Controls.Button

Form form
Page page = form:GetMainPage()
page:SetTitle("Behaviors")

Button hello = page:AddButton("Hello")
hello:SetDescription("Says which button you pressed")

Button goodbye = page:AddButton("Goodbye")
goodbye:SetDescription("Says which button you pressed")

OutputBehavior behavior
hello:SetBehavior(behavior)
goodbye:SetBehavior(behavior)

form:Display()
