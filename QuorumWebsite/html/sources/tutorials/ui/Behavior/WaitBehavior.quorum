use Libraries.Interface.Behaviors.TimedBehavior
use Libraries.Interface.Events.BehaviorEvent
use Libraries.Game.Graphics.Label

class WaitBehavior is TimedBehavior
    Label label = undefined

    on create
        SetTimer(3)
    end

    action Run(BehaviorEvent event)
        label = cast(Label, event:GetItem())
        label:SetText("Wait for it...")
    end

    action Dispose
        if label not= undefined
            label:SetText("Time is up!")
        end
    end
end
