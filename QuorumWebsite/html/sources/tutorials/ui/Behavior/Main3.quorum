use Libraries.Interface.Forms.Form
use Libraries.Interface.Forms.Page
use Libraries.Interface.Forms.FormBehavior
use Libraries.Interface.Events.BehaviorEvent
use Libraries.Interface.Controls.Button
use Libraries.Game.Graphics.Label

class Main is FormBehavior
    action Main
        Form form
        Page page = form:GetMainPage()
        page:SetTitle("Countdown")

        Button start = page:AddButton("Start")
        start:SetDescription("Counts down from 5 seconds")
        start:SetBehavior(me)

        page:AddLabel("Timer", "Press Start to begin.")

        form:Display()
    end

    action Run(BehaviorEvent event)
        Page page = GetPage()
        Label timer = page:GetLabel("Timer")
        if timer not= undefined
            CountdownBehavior countdown
            timer:AddBehavior(countdown)
        end
    end
end
