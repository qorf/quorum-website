// Start from the normal button options, then change two colors.
InterfaceOptions warning = options:CopyInterfaceOptions(options:BUTTON)
warning:SetBackgroundColor(color:Maroon())
warning:SetFontColor(color:White())
options:SetInterfaceOptions("Warning", warning)

Button deleteButton
deleteButton:SetSize(200, 100)
deleteButton:SetName("Delete saved game")
deleteButton:SetDescription("Deletes your saved game. This cannot be undone.")
deleteButton:SetInterfaceOptionsKey("Warning")
panel:Add(deleteButton)
