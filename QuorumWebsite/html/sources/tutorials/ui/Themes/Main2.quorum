use Libraries.Interface.Forms.Form
use Libraries.Interface.Forms.Page
use Libraries.Interface.Forms.FormBehavior
use Libraries.Interface.Events.BehaviorEvent
use Libraries.Interface.Controls.Button
use Libraries.Game.Graphics.Label

class Main is FormBehavior
    boolean darkMode = false

    action Main
        Form form
        Page page = form:GetMainPage()
        page:SetTitle("Theme Switcher")

        page:AddLabel("Status", "This program is in light mode.")

        Button switchButton = page:AddButton("Switch between light and dark mode")
        switchButton:SetDescription("Changes the colors of every control in this program.")
        switchButton:SetBehavior(me)

        form:Display()
    end

    action Run(BehaviorEvent event)
        Form form = GetForm()
        Page page = GetPage()
        Label status = page:GetLabel("Status")

        if darkMode
            form:SetToLightMode()
            status:SetText("This program is in light mode.")
        else
            form:SetToDarkMode()
            status:SetText("This program is in dark mode.")
        end
        darkMode = not darkMode
    end
end
