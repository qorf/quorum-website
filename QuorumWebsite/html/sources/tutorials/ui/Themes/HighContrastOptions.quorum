use Libraries.Game.Graphics.Color
use Libraries.Interface.Options.DarkModeOptions

class HighContrastOptions is DarkModeOptions
    on create
        Color color
        SetButtonBackgroundColor(color:Black())
        SetButtonFontColor(color:White())
        SetButtonBorderColor(color:White())
        SetButtonBorderThickness(2)

        // When a button has the focus, make it very easy to see.
        SetButtonFocusColor(color:Yellow())
        SetButtonFocusFontColor(color:Black())
        SetButtonFocusBorderColor(color:Yellow())
    end
end
