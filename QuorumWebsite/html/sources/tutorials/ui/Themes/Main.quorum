use Libraries.Interface.Forms.Form
use Libraries.Interface.Forms.Page
use Libraries.Interface.Controls.Button
use Libraries.Interface.Controls.Checkbox
use Libraries.Interface.Controls.TextField

Form form
form:SetToDarkMode()

Page page = form:GetMainPage()
page:SetTitle("Club Settings")

page:AddLabel("Nickname")
TextField nickname = page:AddTextField("Nickname")
nickname:SetDescription("The name other club members see.")

Checkbox reminders = page:AddCheckbox("Send me reminders")
reminders:SetDescription("Check this box to get a reminder before each meeting.")

Button save = page:AddButton("Save")
save:SetDescription("Saves your settings.")

form:Display()
