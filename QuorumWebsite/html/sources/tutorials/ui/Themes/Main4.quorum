use Libraries.Game.Game
use Libraries.Game.Graphics.Color
use Libraries.Interface.Controls.Control
use Libraries.Interface.Controls.Button
use Libraries.Interface.Layouts.FlowLayout
use Libraries.Interface.Options.InterfaceOptions

class Main is Game
    Color color

    action Main
        StartGame()
    end

    action CreateGame
        // Change the theme first, so every button below uses it.
        InterfaceOptions options = GetInterfaceOptions()
        options:SetButtonBackgroundColor(color:Navy())
        options:SetButtonFontColor(color:White())
        options:SetButtonBorderThickness(2)

        Control panel
        FlowLayout panelLayout
        panel:SetLayout(panelLayout)
        panel:SetPosition(300, 300)

        Button play
        play:SetSize(200, 100)
        play:SetName("Play")
        play:SetDescription("Starts a new game.")
        panel:Add(play)

        Button quit
        quit:SetSize(200, 100)
        quit:SetName("Quit")
        quit:SetDescription("Closes the game.")
        panel:Add(quit)

        Add(panel)

        // In a game, you set the Tab order yourself.
        play:SetNextFocus(quit)
        quit:SetPreviousFocus(play)
        quit:SetNextFocus(play)
        play:SetPreviousFocus(quit)
        SetFocus(play)
    end
end
