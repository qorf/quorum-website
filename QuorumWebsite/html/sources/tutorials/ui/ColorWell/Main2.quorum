use Libraries.Interface.Forms.Form
use Libraries.Interface.Forms.Page
use Libraries.Interface.Controls.ColorWell
use Libraries.Game.Graphics.Color
use Libraries.Game.Graphics.Label

Form form
Page page = form:GetMainPage()
page:SetTitle("Team Colors")

Color blue
blue:SetHexColor("#2F5BBB")
page:AddLabel("Jersey label", "Jersey color")
ColorWell jersey = page:AddColorWell("Jersey color", blue)

Label report = page:AddLabel("Report", "No changes yet.")

ColorReportListener listener
listener:SetReport(report)
jersey:AddColorWellListener(listener)

form:Display()
