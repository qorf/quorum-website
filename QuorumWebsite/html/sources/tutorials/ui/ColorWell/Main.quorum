use Libraries.Interface.Forms.Form
use Libraries.Interface.Forms.Page
use Libraries.Interface.Controls.ColorWell
use Libraries.Interface.Controls.Button
use Libraries.Game.Graphics.Color

Form form
Page page = form:GetMainPage()
page:SetTitle("Poster Colors")

Color palette

page:AddLabel("Background label", "Background color")
ColorWell background = page:AddColorWell("Background color", palette:Navy())

page:AddLabel("Text label", "Text color")
ColorWell lettering = page:AddColorWell("Text color", palette:White())

Button checkButton = page:AddButton("Check colors")
checkButton:SetDescription("Shows the colors you picked and whether the text is easy to read.")

CheckColorsBehavior behavior
checkButton:SetBehavior(behavior)

form:Display()
