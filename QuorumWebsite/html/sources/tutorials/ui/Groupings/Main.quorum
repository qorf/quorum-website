use Libraries.Interface.Forms.Form
use Libraries.Interface.Forms.Page
use Libraries.Interface.Forms.FormBehavior
use Libraries.Interface.Forms.Grouping
use Libraries.Interface.Events.BehaviorEvent
use Libraries.Interface.Controls.Button
use Libraries.Game.Graphics.Label

class Main is FormBehavior
    action Main
        Form form
        Page page = form:GetMainPage()
        page:SetTitle("Pick a Color")

        Grouping colors = page:AddGrouping("Colors")

        Button red = colors:AddButton("Red")
        red:SetDescription("Choose red")
        red:SetBehavior(me)

        Button green = colors:AddButton("Green")
        green:SetDescription("Choose green")
        green:SetBehavior(me)

        Button blue = colors:AddButton("Blue")
        blue:SetDescription("Choose blue")
        blue:SetBehavior(me)

        page:AddLabel("Choice", "You haven't picked a color yet.")

        form:Display()
    end

    action Run(BehaviorEvent event)
        Button pressed = cast(Button, event:GetItem())
        Page page = GetPage()
        Label choice = page:GetLabel("Choice")
        choice:SetText("You picked " + pressed:GetName() + ".")
    end
end
