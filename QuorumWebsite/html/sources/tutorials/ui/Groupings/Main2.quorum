use Libraries.Interface.Forms.Form
use Libraries.Interface.Forms.Page
use Libraries.Interface.Forms.Grouping
use Libraries.Interface.Controls.TextField

Form form
Page page = form:GetMainPage()

page:AddBanner("Pet Sitter", "Tell us about your pet")

Grouping pet = page:AddGrouping("Your pet")
pet:SetTitle("Your pet")
pet:AddLabel("Pet name prompt", "Pet's name")
pet:AddTextField("Pet's name")
pet:AddLabel("Kind prompt", "Kind of animal")
TextField kind = pet:AddTextField("Kind of animal")
kind:SetDescription("For example, cat, dog or rabbit")

Grouping care = page:AddGrouping("Care")
care:SetTitle("Care")
care:AddLabel("Food prompt", "Food")
care:AddTextField("Food")
care:AddLabel("Medicine prompt", "Medicine, if any")
TextField medicine = care:AddTextField("Medicine")
medicine:SetDescription("Optional. Leave it empty if your pet takes no medicine")

Grouping buttons = page:AddGrouping("Buttons")
buttons:AddButton("Back")
buttons:AddButton("Next")
buttons:PositionFromBottom()
buttons:SetLeadingButtonCount(1)

form:Display()
