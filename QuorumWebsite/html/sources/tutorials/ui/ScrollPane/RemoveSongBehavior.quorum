use Libraries.Interface.Forms.FormBehavior
use Libraries.Interface.Forms.FormScrollPane
use Libraries.Interface.Forms.Page
use Libraries.Interface.Events.BehaviorEvent
use Libraries.Interface.Item2D
use Libraries.Containers.Array

class RemoveSongBehavior is FormBehavior
    FormScrollPane songs = undefined

    action SetSongs(FormScrollPane pane)
        songs = pane
    end

    action Run(BehaviorEvent event)
        if songs = undefined
            return now
        end

        Array<Item2D> items = songs:GetScrollRegionItems()
        if items:IsEmpty()
            output "The playlist is empty."
            return now
        end

        Item2D removed = songs:Remove(0)
        output "Removed " + removed:GetName()

        Page page = GetPage()
        page:CalculateDefaultFocusOrdering()
    end
end
