use Libraries.Interface.Forms.Form
use Libraries.Interface.Forms.Page
use Libraries.Interface.Forms.FormScrollPane
use Libraries.Interface.Controls.Button

Form form
Page page = form:GetMainPage()
page:SetTitle("Playlist")

FormScrollPane songs
songs:SetName("Song list")
songs:SetPixelHeight(250)

OutputNameBehavior behavior
integer counter = 1
repeat while counter <= 20
    Button song
    song:SetName("Song " + counter)
    song:SetDescription("Plays song number " + counter + ".")
    song:SetHorizontalLayoutMode(song:parent:Control:FILL)
    song:SetBehavior(behavior)
    songs:Add(song)
    counter = counter + 1
end
page:Add(songs)

AddSongBehavior addBehavior
addBehavior:SetSongs(songs, behavior)
Button addButton = page:AddButton("Add a song at the top")
addButton:SetBehavior(addBehavior)

RemoveSongBehavior removeBehavior
removeBehavior:SetSongs(songs)
Button removeButton = page:AddButton("Remove the top song")
removeButton:SetBehavior(removeBehavior)

form:Display()
