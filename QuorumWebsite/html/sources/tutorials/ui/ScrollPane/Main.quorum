use Libraries.Interface.Forms.Form
use Libraries.Interface.Forms.Page
use Libraries.Interface.Controls.Button

Form form
Page page = form:GetMainPage()
page:SetTitle("All Songs")

OutputNameBehavior behavior
integer counter = 1
repeat while counter <= 30
    Button song = page:AddButton("Song " + counter)
    song:SetDescription("Plays song number " + counter + ".")
    song:SetBehavior(behavior)
    counter = counter + 1
end

form:Display()
