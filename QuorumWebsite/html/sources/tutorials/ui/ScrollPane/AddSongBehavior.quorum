use Libraries.Interface.Forms.FormBehavior
use Libraries.Interface.Forms.FormScrollPane
use Libraries.Interface.Forms.Page
use Libraries.Interface.Events.BehaviorEvent
use Libraries.Interface.Behaviors.Behavior
use Libraries.Interface.Controls.Button
use Libraries.Interface.Controls.Control

class AddSongBehavior is FormBehavior
    FormScrollPane songs = undefined
    Behavior playBehavior = undefined
    integer count = 0

    action SetSongs(FormScrollPane pane, Behavior play)
        songs = pane
        playBehavior = play
    end

    action Run(BehaviorEvent event)
        if songs = undefined
            return now
        end

        count = count + 1
        Button song
        song:SetName("New song " + count)
        song:SetDescription("A song added while the program was running.")
        song:SetHorizontalLayoutMode(song:parent:Control:FILL)
        song:SetBehavior(playBehavior)
        songs:Add(0, song)

        Page page = GetPage()
        page:CalculateDefaultFocusOrdering()
        song:Focus()
    end
end
