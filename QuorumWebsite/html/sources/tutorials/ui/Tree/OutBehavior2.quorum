use Libraries.Interface.Behaviors.Behavior
use Libraries.Interface.Events.BehaviorEvent
use Libraries.Interface.Controls.TreeItem
use Libraries.Containers.Array

class OutBehavior is Behavior
    action Run(BehaviorEvent event)
        TreeItem item = cast(TreeItem, event:GetItem())
        Array<TreeItem> path = item:GetTreePath()

        text message = ""
        integer counter = 0
        repeat while counter < path:GetSize()
            TreeItem pathItem = path:Get(counter)
            if counter > 0
                message = message + ", then "
            end
            message = message + pathItem:GetName()
            counter = counter + 1
        end

        output message
    end
end
