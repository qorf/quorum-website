use Libraries.Interface.Forms.Form
use Libraries.Interface.Forms.Page
use Libraries.Interface.Controls.Icon
use Libraries.Interface.Controls.Tree
use Libraries.Interface.Controls.TreeItem
use Libraries.Game.Graphics.Color

class Main is Form
    OutBehavior outBehavior

    action Main
        Display()
    end

    action CreateGame
        Page page = GetMainPage()
        page:SetTitle("Colors")

        Tree tree = page:AddTree("Colors")
        tree:SetDescription("Colors and their shades. Open a color to see its shades.")

        Color color
        TreeItem red = MakeItem("Red", color:Red())
        TreeItem pink = MakeItem("Pink", color:Pink())
        TreeItem blue = MakeItem("Blue", color:Blue())
        TreeItem cyan = MakeItem("Cyan", color:Cyan())
        TreeItem purple = MakeItem("Purple", color:Purple())
        TreeItem darkPurple = MakeItem("Dark Purple", color:CustomColor(0.25, 0, 0.25, 1))
        TreeItem lightPurple = MakeItem("Light Purple", color:CustomColor(0.75, 0, 0.75, 1))
        TreeItem green = MakeItem("Green", color:Green())

        tree:Add(red)
        tree:Add(blue)
        tree:Add(green)

        red:Add(pink)
        blue:Add(cyan)
        blue:Add(purple)
        purple:Add(darkPurple)
        purple:Add(lightPurple)

        parent:Form:CreateGame()
    end

    action MakeItem(text name, Color shade) returns TreeItem
        Icon icon
        icon:LoadFilledCircle(32, shade)

        TreeItem item
        item:SetName(name)
        item:SetIcon(icon)
        item:SetIconColor(shade)
        item:SetBehavior(outBehavior)
        return item
    end
end
