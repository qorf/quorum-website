use Libraries.Interface.Forms.Form
use Libraries.Interface.Forms.Page
use Libraries.Interface.Controls.Tree
use Libraries.Interface.Controls.TreeItem

class Main
    OutBehavior outBehavior

    action Main
        Form form
        Page page = form:GetMainPage()
        page:SetTitle("Colors")

        Tree tree = page:AddTree("Colors")
        tree:SetDescription("Colors and their shades. Open a color to see its shades.")

        TreeItem red = MakeItem("Red")
        TreeItem pink = MakeItem("Pink")
        TreeItem blue = MakeItem("Blue")
        TreeItem cyan = MakeItem("Cyan")
        TreeItem purple = MakeItem("Purple")
        TreeItem darkPurple = MakeItem("Dark Purple")
        TreeItem lightPurple = MakeItem("Light Purple")
        TreeItem green = MakeItem("Green")

        tree:Add(red)
        tree:Add(blue)
        tree:Add(green)

        red:Add(pink)
        blue:Add(cyan)
        blue:Add(purple)
        purple:Add(darkPurple)
        purple:Add(lightPurple)

        form:Display()
    end

    action MakeItem(text name) returns TreeItem
        TreeItem item
        item:SetName(name)
        item:SetBehavior(outBehavior)
        return item
    end
end
