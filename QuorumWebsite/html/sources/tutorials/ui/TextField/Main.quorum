use Libraries.Interface.Forms.Form
use Libraries.Interface.Forms.Page
use Libraries.Interface.Controls.TextField
use Libraries.Interface.Controls.Button

Form form
Page page = form:GetMainPage()
page:SetTitle("Greeter")

page:AddLabel("First name:")
TextField name = page:AddTextField("Your first name")
name:SetDescription("Type your first name, then press Say hello.")

Button hello = page:AddButton("Say hello")
page:AddLabel("Greeting", "No greeting yet.")

HelloBehavior behavior
hello:SetBehavior(behavior)

form:Display()
