use Libraries.Interface.Events.TextChangeListener
use Libraries.Interface.Events.TextChangeEvent
use Libraries.Interface.Controls.Control
use Libraries.Interface.Controls.TextField
use Libraries.Game.Graphics.Label

class CountListener is TextChangeListener
    Label label = undefined
    integer limit = 12

    action SetLabel(Label label)
        me:label = label
    end

    action TextChanged(TextChangeEvent event)
        Control control = event:GetControl()
        if label not= undefined and control is TextField
            TextField field = cast(TextField, control)
            integer size = field:GetSize()
            if size > limit
                label:SetText("Characters: " + size + " of " + limit + ". That is too long.")
            else
                label:SetText("Characters: " + size + " of " + limit)
            end
        end
    end
end
