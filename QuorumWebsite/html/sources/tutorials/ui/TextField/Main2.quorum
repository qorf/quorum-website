use Libraries.Interface.Forms.Form
use Libraries.Interface.Forms.Page
use Libraries.Interface.Controls.TextField
use Libraries.Game.Graphics.Label

Form form
Page page = form:GetMainPage()
page:SetTitle("Pick a Nickname")

page:AddLabel("Nickname:")
TextField nickname = page:AddTextField("Nickname")
nickname:SetDescription("Up to 12 characters.")
Label count = page:AddLabel("Character count", "Characters: 0 of 12")

CountListener listener
listener:SetLabel(count)
nickname:AddTextChangeListener(listener)

form:Display()
