use Libraries.Interface.Forms.FormBehavior
use Libraries.Interface.Forms.Page
use Libraries.Interface.Events.BehaviorEvent
use Libraries.Interface.Controls.TextField
use Libraries.Game.Graphics.Label

class NameBehavior is FormBehavior
    action Run(BehaviorEvent event)
        Page page = GetPage()
        TextField field = page:GetTextField("Full name")
        Label result = page:GetLabel("Name result")
        text name = field:GetText():Trim()

        if name:Contains("-")
            result:SetText("Names can't have a hyphen.")
        elseif name:Contains("'")
            result:SetText("Names can't have an apostrophe.")
        elseif name:Contains(" ") = false
            result:SetText("Please type a first name and a last name.")
        else
            result:SetText("Thank you, " + name + ".")
        end
    end
end
