use Libraries.Interface.Forms.FormBehavior
use Libraries.Interface.Forms.Page
use Libraries.Interface.Events.BehaviorEvent
use Libraries.Interface.Controls.TextField
use Libraries.Game.Graphics.Label

class HelloBehavior is FormBehavior
    action Run(BehaviorEvent event)
        Page page = GetPage()
        TextField field = page:GetTextField("Your first name")
        Label greeting = page:GetLabel("Greeting")
        if field = undefined or greeting = undefined
            return now
        end

        text name = field:GetText():Trim()
        if name = ""
            greeting:SetText("Please type your first name first.")
        else
            greeting:SetText("Hello, " + name + "!")
            field:Empty()
        end
    end
end
