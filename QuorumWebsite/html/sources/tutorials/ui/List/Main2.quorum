use Libraries.Interface.Forms.Form
use Libraries.Interface.Forms.Page
use Libraries.Interface.Forms.FormBehavior
use Libraries.Interface.Events.BehaviorEvent
use Libraries.Interface.Controls.Button
use Libraries.Interface.Controls.List
use Libraries.Interface.Controls.ListItem

class Main is FormBehavior
    action Main
        Form form
        Page page = form:GetMainPage()
        page:SetTitle("Shopping")

        List shoppingList = page:AddList("Shopping list")
        shoppingList:SetDescription("Things to buy at the store")
        shoppingList:Add("Milk")
        shoppingList:Add("Eggs")
        shoppingList:Add("Ham")
        shoppingList:Add("Cheese")
        shoppingList:Select(0)

        ListBehavior behavior
        shoppingList:SetItemActivationBehavior(behavior)

        Button change = page:AddButton("Change List")
        change:SetDescription("Adds Bread to the top of the list and removes Ham")
        change:SetBehavior(me)

        form:Display()
    end

    action Run(BehaviorEvent event)
        Page page = GetPage()
        List shoppingList = page:GetList("Shopping list")

        shoppingList:Add(0, "Bread")
        ListItem removed = shoppingList:Remove("Ham")

        text first = shoppingList:Get(0)
        integer count = shoppingList:GetSize()
        output "The first item is " + first + ". There are " + count + " items."

        shoppingList:Select(0)
    end
end
