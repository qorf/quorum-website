use Libraries.Interface.Forms.Form
use Libraries.Interface.Forms.Page
use Libraries.Interface.Controls.List

Form form
Page page = form:GetMainPage()
page:SetTitle("Shopping")

List shoppingList = page:AddList("Shopping list")
shoppingList:SetDescription("Things to buy at the store")

shoppingList:Add("Milk")
shoppingList:Add("Eggs")
shoppingList:Add("Ham")
shoppingList:Add("Cheese")
shoppingList:Select(0)

form:Display()
