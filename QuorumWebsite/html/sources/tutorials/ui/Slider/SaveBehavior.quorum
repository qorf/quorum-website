use Libraries.Interface.Forms.FormBehavior
use Libraries.Interface.Forms.Page
use Libraries.Interface.Events.BehaviorEvent
use Libraries.Interface.Controls.Slider
use Libraries.Interface.Controls.SliderField

class SaveBehavior is FormBehavior
    action Run(BehaviorEvent event)
        Page page = GetPage()

        Slider brightness = page:GetSlider("Brightness")
        if brightness not= undefined
            output "Brightness: " + brightness:GetNumberText()
            if brightness:GetValue() < 20
                output "That is quite dark."
            end
        end

        SliderField temperature = page:GetSliderField("Temperature")
        if temperature not= undefined
            Slider temperatureSlider = temperature:GetSlider()
            output "Temperature: " + temperatureSlider:GetNumberText() + " degrees"
        end
    end
end
