use Libraries.Interface.Forms.Form
use Libraries.Interface.Forms.Page
use Libraries.Interface.Controls.Slider
use Libraries.Game.Graphics.Label

Form form
Page page = form:GetMainPage()
page:SetTitle("Music Player")

page:AddLabel("Volume")
Slider volume = page:AddSlider("Volume")
volume:SetDescription("How loud the music plays.")
volume:SetValue(50)

Label summary = page:AddLabel("Summary", "Volume: 50")

VolumeListener listener
listener:SetLabel(summary)
volume:AddSliderListener(listener)

form:Display()
