use Libraries.Interface.Forms.Form
use Libraries.Interface.Forms.Page
use Libraries.Interface.Controls.Slider
use Libraries.Interface.Controls.SliderField
use Libraries.Interface.Controls.Button

Form form
Page page = form:GetMainPage()
page:SetTitle("Room Settings")

page:AddLabel("Brightness")
Slider brightness = page:AddSlider("Brightness")
brightness:SetDescription("How bright the lights are, from 0 to 100.")
brightness:SetValue(60)

page:AddLabel("Temperature")
SliderField temperature = page:AddSliderField("Temperature", 60, 80, 0.5)
temperature:SetUnits("degrees")
temperature:GetSlider():SetDescription("The room temperature, from 60 to 80 degrees.")
temperature:GetField():SetDescription("The room temperature, from 60 to 80 degrees.")
temperature:SetValue(70)

Button save = page:AddButton("Save")
save:SetDescription("Shows the settings you chose.")

SaveBehavior behavior
save:SetBehavior(behavior)

form:Display()
