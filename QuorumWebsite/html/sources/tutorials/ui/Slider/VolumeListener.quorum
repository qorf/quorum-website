use Libraries.Interface.Events.SliderListener
use Libraries.Interface.Events.SliderChangedEvent
use Libraries.Interface.Controls.Slider
use Libraries.Game.Graphics.Label

class VolumeListener is SliderListener
    Label summary = undefined

    action SetLabel(Label newLabel)
        summary = newLabel
    end

    action SliderChanged(SliderChangedEvent event)
        Slider slider = event:GetSlider()
        if summary not= undefined
            summary:SetText("Volume: " + slider:GetNumberText())
        end
        if event:IsFinal()
            output "The volume is set to " + slider:GetNumberText()
        end
    end
end
