use Libraries.Interface.Forms.Form
use Libraries.Interface.Forms.Page
use Libraries.Interface.Controls.Button

Form form
Page page = form:GetMainPage()

HelpDialog help
help:Setup()

ShowDialogBehavior showHelp
showHelp:SetDialog(help)

page:AddLabel("Intro", "Press the Help button to learn how this app works.")
Button button = page:AddButton("Help")
button:SetDescription("Opens the help dialog")
button:SetBehavior(showHelp)

form:Display()
