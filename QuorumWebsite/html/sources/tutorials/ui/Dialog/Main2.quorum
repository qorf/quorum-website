use Libraries.Interface.Forms.Form
use Libraries.Interface.Forms.Page
use Libraries.Interface.Controls.Button

Form form
Page page = form:GetMainPage()

WelcomeDialog welcome
welcome:Setup()

ShowDialogBehavior showWelcome
showWelcome:SetDialog(welcome)

page:AddLabel("Intro", "New here? Press the Welcome button.")
Button button = page:AddButton("Welcome")
button:SetDescription("Opens the welcome dialog")
button:SetBehavior(showWelcome)

form:Display()
