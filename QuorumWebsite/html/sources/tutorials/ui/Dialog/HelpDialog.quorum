use Libraries.Interface.Controls.Dialog
use Libraries.Interface.Controls.Button
use Libraries.Interface.Forms.Page
use Libraries.Interface.Behaviors.Controls.DialogHideBehavior

class HelpDialog is Dialog
    DialogHideBehavior closeBehavior

    action Setup
        SetName("Help")
        SetDescription("Explains how to use the app")
        SetModal(true)
        SetPixelWidth(400)
        SetPixelHeight(180)

        closeBehavior:SetDialog(me)
        SetBehavior(closeBehavior)

        Page page = InitializeDefaultPage()
        page:AddLabel("Help text", "Press Tab to move between controls. Press Space to press a button.")
        Button closeButton = page:AddButton("Close")
        closeButton:SetDescription("Closes the help dialog")
        closeButton:SetBehavior(closeBehavior)
    end

    action OnShow
        GetDefaultPage():GetFirstFocusableItem():Focus()
    end

    action OnHide
        output "The help dialog closed."
    end
end
